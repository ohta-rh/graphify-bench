{
  "name": "graphify-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "bench:pilot": "tsx bench/matrix.ts --profile pilot",
    "bench:full": "tsx bench/matrix.ts --profile full",
    "bench:collect": "tsx bench/collect.ts",
    "bench:grade": "tsx bench/grade.ts",
    "bench:analyze": "tsx bench/analyze.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:analyze:combined": "tsx bench/analyze.ts --runs results/runs,results/ext/runs --tasks tasks/tasks.json,tasks/tasks-ext.json --out results/combined",
    "bench:report:combined": "tsx bench/report.ts --runs results/runs,results/ext/runs --tasks tasks/tasks.json,tasks/tasks-ext.json --out results/combined",
    "bench:analyze:structural": "tsx bench/analyze.ts --runs results/runs,results/ext/runs,results/structural/runs --tasks tasks/tasks.json,tasks/tasks-ext.json --out results/structural --feature-usage --compare graphify-strict:baseline,graphify-strict:graphify,graphify:baseline-nosub,baseline-nosub:baseline,haiku-graphify:haiku-baseline",
    "bench:report:structural": "tsx bench/report.ts --runs results/runs,results/ext/runs,results/structural/runs --tasks tasks/tasks.json,tasks/tasks-ext.json --out results/structural --feature-usage --compare graphify-strict:baseline,graphify-strict:graphify,graphify:baseline-nosub,baseline-nosub:baseline,haiku-graphify:haiku-baseline",
    "keys:derive": "tsx scripts/derive-keys.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@types/node": "25.9.5",
    "ts-morph": "28.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}

+import { assertOrgScope } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import { findReferenceOrg } from "@/server/repositories/reference-repository";
+import type { Actor } from "@/types/member";
+import type { UserId } from "@/types/common";
+import { requireFound } from "./_support";
+
+export async function assertReferenceScope(
+  actor: Actor,
+  kind: "issue" | "comment" | "label",
+  id: string,
+): Promise<void> {
+  const orgId = requireFound(await findReferenceOrg(kind, id), kind, id);
+  assertOrgScope(actor, orgId);
+}
+
+export async function assertCurrentMember(actor: Actor, userId: UserId | null | undefined): Promise<void> {
+  if (userId == null) return;
+  const member = await memberRepo.findMember(actor.orgId, userId);
+  requireFound(member?.status === "active" && member.archivedAt === null ? member : null, "Member", userId);
+}

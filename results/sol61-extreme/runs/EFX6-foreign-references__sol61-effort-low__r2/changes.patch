+import { eq } from "drizzle-orm";
+import { comments, getDb, issues, labels } from "@/server/db";
+import type { OrgId } from "@/types/common";
+
+/** Ownership-only lookup used to distinguish foreign references from missing ones. */
+export async function findReferenceOrg(
+  kind: "issue" | "comment" | "label",
+  id: string,
+): Promise<OrgId | null> {
+  const table = { issue: issues, comment: comments, label: labels }[kind];
+  const row = getDb().select({ orgId: table.orgId }).from(table)
+    .where(eq(table.id, id)).get();
+  return row ? row.orgId as OrgId : null;
+}

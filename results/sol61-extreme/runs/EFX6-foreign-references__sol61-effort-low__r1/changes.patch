+import { eq } from "drizzle-orm";
+import { assertOrgScope } from "@/lib/tenant";
+import { getDb, labels, issues, comments } from "@/server/db";
+import * as memberRepo from "@/server/repositories/member-repository";
+import { NotFoundError, requireFound } from "./_support";
+import type { Actor } from "@/types/member";
+import type { CommentId, IssueId, LabelId, ProjectId, UserId, OrgId } from "@/types/common";
+
+// Resolve only reference metadata before checking scope; no foreign content is returned.
+export async function requireLabels(actor: Actor, ids: readonly LabelId[]): Promise<void> {
+  for (const id of new Set(ids)) {
+    const row = requireFound(getDb().select({ orgId: labels.orgId }).from(labels).where(eq(labels.id, id)).get(), "Label", id);
+    assertOrgScope(actor, row.orgId as OrgId);
+  }
+}
+
+export async function requireParentIssue(actor: Actor, id: IssueId, projectId: ProjectId): Promise<void> {
+  const row = requireFound(getDb().select({ orgId: issues.orgId, projectId: issues.projectId, archivedAt: issues.archivedAt }).from(issues).where(eq(issues.id, id)).get(), "Issue", id);
+  assertOrgScope(actor, row.orgId as OrgId);
+  if (row.archivedAt !== null || row.projectId !== projectId) throw new NotFoundError("Issue", id);
+}
+
+export async function requireReplyTarget(actor: Actor, id: CommentId, issueId: IssueId): Promise<void> {
+  const row = requireFound(getDb().select({ orgId: comments.orgId, issueId: comments.issueId, parentId: comments.parentId, archivedAt: comments.archivedAt }).from(comments).where(eq(comments.id, id)).get(), "Comment", id);
+  assertOrgScope(actor, row.orgId as OrgId);
+  if (row.archivedAt !== null || row.issueId !== issueId || row.parentId !== null) throw new NotFoundError("Comment", id);
+}
+
+export async function requireCurrentMember(actor: Actor, id: UserId | null | undefined): Promise<void> {
+  if (id == null) return;
+  const member = await memberRepo.findMember(actor.orgId, id);
+  if (!member || member.archivedAt !== null || member.status !== "active") throw new NotFoundError("Member", id);
+}

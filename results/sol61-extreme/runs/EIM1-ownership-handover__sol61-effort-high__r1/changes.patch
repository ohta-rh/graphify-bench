+import { and, eq, isNull, or } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toMember, toOrganization } from "./_mappers";
+import type { OwnershipHandoverRow } from "@/server/db";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Member, Role } from "@/types/member";
+import type { Organization, OwnershipHandover, OwnershipHandoverStatus } from "@/types/organization";
+
+function toHandover(row: OwnershipHandoverRow): OwnershipHandover {
+  return {
+    ...row,
+    orgId: row.orgId as OrgId,
+    fromUserId: row.fromUserId as UserId,
+    toUserId: row.toUserId as UserId,
+    expiresAt: toIsoTimestamp(row.expiresAt),
+    createdAt: toIsoTimestamp(row.createdAt),
+    resolvedAt: row.resolvedAt === null ? null : toIsoTimestamp(row.resolvedAt),
+  };
+}
+
+/** All handover reads and writes are synchronous inside a SQLite transaction. */
+export function transaction<T>(work: () => T): T {
+  return getDb().transaction(work, { behavior: "immediate" });
+}
+
+export function findOrganization(orgId: OrgId): Organization | null {
+  const row = getDb().select().from(organizations).where(eq(organizations.id, orgId)).get();
+  return row ? toOrganization(row) : null;
+}
+
+export function findActiveMember(orgId: OrgId, userId: UserId): Member | null {
+  const row = getDb().select().from(members).where(and(
+    eq(members.orgId, orgId),
+    eq(members.userId, userId),
+    eq(members.status, "active"),
+    isNull(members.archivedAt),
+  )).get();
+  return row ? toMember(row) : null;
+}
+
+/** Includes lapsed rows so the recipient can distinguish expiry from absence. */
+export function findUnresolved(orgId: OrgId): OwnershipHandover | null {
+  const row = getDb().select().from(ownershipHandovers).where(and(
+    eq(ownershipHandovers.orgId, orgId),
+    eq(ownershipHandovers.status, "pending"),
+  )).get();
+  return row ? toHandover(row) : null;
+}
+
+export function insert(
+  orgId: OrgId,
+  fromUserId: UserId,
+  toUserId: UserId,
+  createdAt: IsoTimestamp,
+): OwnershipHandover {
+  const expiresAt = toIsoTimestamp(new Date(Date.parse(createdAt) + 7 * 24 * 60 * 60 * 1000));
+  const row = getDb().insert(ownershipHandovers).values({
+    id: newId(), orgId, fromUserId, toUserId, createdAt, expiresAt,
+    status: "pending", resolvedAt: null,
+  }).returning().get();
+  return toHandover(row);
+}
+
+export function resolve(
+  handover: OwnershipHandover,
+  status: Exclude<OwnershipHandoverStatus, "pending">,
+  resolvedAt: IsoTimestamp,
+): OwnershipHandover {
+  const row = getDb().update(ownershipHandovers).set({ status, resolvedAt }).where(and(
+    eq(ownershipHandovers.orgId, handover.orgId),
+    eq(ownershipHandovers.id, handover.id),
+    eq(ownershipHandovers.status, "pending"),
+  )).returning().get();
+  if (!row) throw new Error("Ownership handover is no longer pending");
+  return toHandover(row);
+}
+
+export function setRole(member: Member, role: Role, at: IsoTimestamp): void {
+  getDb().update(members).set({ role, updatedAt: at }).where(and(
+    eq(members.orgId, member.orgId), eq(members.id, member.id),
+  )).run();
+}
+
+export function setOwner(orgId: OrgId, ownerId: UserId, at: IsoTimestamp): Organization {
+  const row = getDb().update(organizations).set({ ownerId, updatedAt: at })
+    .where(eq(organizations.id, orgId)).returning().get();
+  return toOrganization(row);
+}
+
+/** Called in the same transaction as membership removal. */
+export function cancelForMember(orgId: OrgId, userId: UserId, at: IsoTimestamp): void {
+  getDb().update(ownershipHandovers).set({ status: "canceled", resolvedAt: at }).where(and(
+    eq(ownershipHandovers.orgId, orgId),
+    eq(ownershipHandovers.status, "pending"),
+    or(eq(ownershipHandovers.fromUserId, userId), eq(ownershipHandovers.toUserId, userId)),
+  )).run();
+}

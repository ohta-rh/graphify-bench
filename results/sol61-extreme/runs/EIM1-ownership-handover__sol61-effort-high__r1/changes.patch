+export async function initiateOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+  toUserId: UserId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const handover = handoverRepo.transaction(() => {
+    const org = requireFound(handoverRepo.findOrganization(orgId), "Organization", orgId);
+    assertRecordedOwner(actor, org, "org:update");
+    requireFound(handoverRepo.findActiveMember(orgId, actor.userId), "Member", actor.userId);
+    assertCan({ ...actor, role: "owner" }, "org:update", orgResource(orgId));
+    if (toUserId === org.ownerId) throw new OwnershipHandoverError("self");
+    requireFound(handoverRepo.findActiveMember(orgId, toUserId), "Member", toUserId);
+
+    const now = toIsoTimestamp(new Date());
+    const pending = handoverRepo.findUnresolved(orgId);
+    if (pending) {
+      if (now < pending.expiresAt) throw new OwnershipHandoverError("pending_exists");
+      handoverRepo.resolve(pending, "expired", pending.expiresAt);
+    }
+    return handoverRepo.insert(orgId, actor.userId, toUserId, now);
+  });
+
+  await notify(orgId, "ownership_handover", [toUserId], {
+    title: "You have been offered workspace ownership",
+    body: "Accept the offer to become the workspace owner. This offer expires in seven days.",
+    href: "/settings/members",
+    actorId: actor.userId,
+  });
+  return handover;
+}
+
+/** A lapsed offer remains untouched when someone tries to act on it. */
+function recipientHandover(actor: Actor, orgId: OrgId): OwnershipHandover {
+  const handover = handoverRepo.findUnresolved(orgId);
+  if (!handover || handover.toUserId !== actor.userId) {
+    throw new OwnershipHandoverError("nothing_pending");
+  }
+  if (Date.now() >= Date.parse(handover.expiresAt)) {
+    throw new OwnershipHandoverError("expired");
+  }
+  return handover;
+}
+
+export async function acceptOwnershipHandover(actor: Actor, orgId: OrgId): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+  const changes: TaskflowEventMap["member.role_changed"][] = [];
+  const result = handoverRepo.transaction(() => {
+    const handover = recipientHandover(actor, orgId);
+    const org = requireFound(handoverRepo.findOrganization(orgId), "Organization", orgId);
+    const nextOwner = requireFound(handoverRepo.findActiveMember(orgId, actor.userId), "Member", actor.userId);
+    const previousOwner = requireFound(handoverRepo.findActiveMember(orgId, handover.fromUserId), "Member", handover.fromUserId);
+    assertRecordedOwner({ ...actor, userId: handover.fromUserId }, org, "org:update");
+
+    const stamp = toIsoTimestamp(new Date());
+    // Promote first so even inside the transaction the last owner is retained.
+    if (nextOwner.role !== "owner") {
+      handoverRepo.setRole(nextOwner, "owner", stamp);
+      changes.push({ ...actorEnvelope(actor), memberId: nextOwner.id, from: nextOwner.role, to: "owner" });
+    }
+    const organization = handoverRepo.setOwner(orgId, actor.userId, stamp);
+    if (previousOwner.role === "owner") {
+      handoverRepo.setRole(previousOwner, "admin", stamp);
+      changes.push({ ...actorEnvelope(actor), memberId: previousOwner.id, from: "owner", to: "admin" });
+    }
+    handoverRepo.resolve(handover, "accepted", stamp);
+    return { organization, handover };
+  });
+
+  for (const change of changes) await emit("member.role_changed", change);
+  await emit("organization.ownership_transferred", {
+    ...actorEnvelope(actor), fromUserId: result.handover.fromUserId, toUserId: result.handover.toUserId,
+  });
+  return result.organization;
+}
+
+export async function declineOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.transaction(() => {
+    const handover = recipientHandover(actor, orgId);
+    return handoverRepo.resolve(handover, "declined", toIsoTimestamp(new Date()));
+  });
+}
+
+export async function cancelOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.transaction(() => {
+    const org = requireFound(handoverRepo.findOrganization(orgId), "Organization", orgId);
+    assertRecordedOwner(actor, org, "org:update");
+    assertCan({ ...actor, role: "owner" }, "org:update", orgResource(orgId));
+    const handover = handoverRepo.findUnresolved(orgId);
+    if (!handover || handover.fromUserId !== actor.userId || Date.now() >= Date.parse(handover.expiresAt)) {
+      throw new OwnershipHandoverError("nothing_pending");
+    }
+    return handoverRepo.resolve(handover, "canceled", toIsoTimestamp(new Date()));
+  });
+}
+
+export async function getPendingOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:read", orgResource(orgId));
+  const handover = handoverRepo.findUnresolved(orgId);
+  return handover && Date.now() < Date.parse(handover.expiresAt) ? handover : null;
 }

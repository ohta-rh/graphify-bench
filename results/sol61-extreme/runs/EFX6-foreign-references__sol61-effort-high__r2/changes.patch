+import { eq } from "drizzle-orm";
+import { comments, getDb, issues, labels, projects } from "@/server/db";
+import type { OrgId } from "@/types/common";
+
+const referenceTables = { Issue: issues, Comment: comments, Label: labels, Project: projects };
+export type ReferenceEntity = keyof typeof referenceTables;
+
+/**
+ * Ownership-only lookup for a failed scoped reference lookup. This deliberately
+ * reads no resource data: services use it to distinguish a foreign reference
+ * from a missing one, without exposing another workspace's resource.
+ */
+export async function findReferenceOrgId(
+  entity: ReferenceEntity,
+  id: string,
+): Promise<OrgId | null> {
+  const table = referenceTables[entity];
+  const row = getDb()
+    .select({ orgId: table.orgId })
+    .from(table)
+    .where(eq(table.id, id))
+    .get();
+  return row ? row.orgId as OrgId : null;
+}

@@ -0,0 +1,36 @@
+import { isLive } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import { findReferenceOrgId, type ReferenceEntity } from "@/server/repositories/reference-repository";
+import type { TenantScoped, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import { NotFoundError } from "./_support";
+
+export async function requireScopedReference<T extends TenantScoped>(
+  actor: Actor,
+  row: T | null,
+  entity: ReferenceEntity,
+  id: string,
+): Promise<T> {
+  if (row === null) {
+    const orgId = await findReferenceOrgId(entity, id);
+    if (orgId !== null) assertOrgScope(actor, orgId);
+    throw new NotFoundError(entity, id);
+  }
+  assertOrgScope(actor, row.orgId);
+  return row;
+}
+
+/** User ids are global; only an active membership in this workspace counts. */
+export async function requireCurrentMember(
+  actor: Actor,
+  userId: UserId | null | undefined,
+): Promise<void> {
+  if (userId === null || userId === undefined) return;
+  const member = await memberRepo.findMember(actor.orgId, userId);
+  if (member === null) throw new NotFoundError("Member", userId);
+  assertOrgScope(actor, member.orgId);
+  if (!isLive(member) || member.status !== "active") {
+    throw new NotFoundError("Member", userId);
+  }
+}

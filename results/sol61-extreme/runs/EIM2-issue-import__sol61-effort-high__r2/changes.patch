+    const org = requireFound(
+      await orgRepo.findOrgById(parsed.orgId), "Organization", parsed.orgId,
+    );
+    const assertQuota = (used: number) => {
+      if (wouldExceedLimit(org.plan, "issuesPerProject", used, parsed.rows.length)) {
+        throw new Error(`Plan ${org.plan} allows no more issues in project ${project.key}`);
+      }
+    };
+    assertQuota(await issueRepo.countIssues(parsed.orgId, parsed.projectId));

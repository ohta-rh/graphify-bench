+import { PermissionDeniedError } from "@/lib/permissions";
+import { consumeRateLimit, resetRateLimits } from "@/lib/rate-limit";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { importIssueRowSchema, importIssuesSchema } from "@/schemas/issue-import";
+import { activityEvents, getDb, issueImports, members, notifications, webhookDeliveries } from "@/server/db";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as labelRepo from "@/server/repositories/label-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import * as webhookRepo from "@/server/repositories/webhook-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { registerEventHandlers, unregisterEventHandlers } from "@/server/services/event-registry";
+import { createIssue, importIssues } from "@/server/services/issue-service";
+import { search } from "@/server/services/search-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { ImportIssuesInput } from "@/schemas/issue-import";
+import type { ProjectId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+const detach: Unsubscribe[] = [];
+
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+beforeEach(() => { resetRateLimits(); });
+afterEach(() => {
+  unregisterEventHandlers();
+  for (const off of detach.splice(0)) off();
+  vi.useRealTimers();
+});
+afterAll(() => { cleanup(); });
+
+function upload(tenant: Tenant, rows: unknown[], importKey = "upload-1234"): ImportIssuesInput {
+  return importIssuesSchema.parse({
+    orgId: tenant.org.id, projectId: tenant.project.id, importKey, rows,
+  });
+}
+
+async function expectEmpty(tenant: Tenant): Promise<void> {
+  expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id, { includeArchived: true })).toBe(0);
+  expect(await labelRepo.listLabels(tenant.org.id)).toEqual([]);
+  expect(getDb().select().from(issueImports).where(eq(issueImports.orgId, tenant.org.id)).all()).toEqual([]);
+}
+
+describe("issue import", () => {
+  it("applies row defaults and validates the whole batch", async () => {
+    expect(importIssueRowSchema.parse({ title: "New issue" })).toEqual({
+      title: "New issue", description: null, status: "backlog", priority: "none",
+      assigneeEmail: null, labels: [], dueAt: null,
+    });
+    const tenant = await createTenant("import-validation");
+    const input = upload(tenant, [{ title: "Valid issue", labels: ["new label"] }]);
+    input.rows.push({ ...input.rows[0], title: "x" });
+    await expect(importIssues(tenant.actors.member, input)).rejects.toThrow();
+    await expectEmpty(tenant);
+    expect(importIssuesSchema.safeParse({ ...input, rows: [] }).success).toBe(false);
+    expect(importIssuesSchema.safeParse({ ...input, rows: Array(501).fill(input.rows[0]) }).success).toBe(false);
+    expect(importIssueRowSchema.safeParse({ title: "Valid", labels: Array(21).fill("a") }).success).toBe(false);
+  });
+
+  it("preserves row fields and order, including numbers previously used by archived issues", async () => {
+    const tenant = await createTenant("import-order");
+    const archived = await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, 42);
+    await issueRepo.archiveIssue(tenant.org.id, archived.id);
+    const dueAt = "2030-04-05T16:00:00.000Z";
+    const result = await importIssues(tenant.actors.member, upload(tenant, [
+      { title: "First imported", description: "Exact description", status: "done", priority: "urgent", dueAt },
+      { title: "Second imported", status: "in_review", priority: "high" },
+    ]));
+    expect(result.replayed).toBe(false);
+    expect(result.issues.map((issue) => issue.number)).toEqual([43, 44]);
+    expect(result.issues[0]).toMatchObject({
+      title: "First imported", description: "Exact description", status: "done", priority: "urgent", dueAt,
+      authorId: tenant.userIds.member, parentId: null, estimate: null,
+    });
+    expect(result.issues[1]).toMatchObject({ title: "Second imported", status: "in_review", priority: "high" });
+    const next = await createIssue(tenant.actors.member, issueInput(tenant.org.id, tenant.project.id));
+    expect(next.number).toBe(45);
+  });
+
+  it("resolves only active workspace members and exactly named workspace labels", async () => {
+    const tenant = await createTenant("import-resolution");
+    const other = await createTenant("import-other");
+    const removed = await memberRepo.findMember(tenant.org.id, tenant.userIds.admin);
+    await memberRepo.archiveMember(tenant.org.id, removed!.id);
+    getDb().update(members).set({ status: "invited" }).where(eq(members.userId, tenant.userIds.viewer)).run();
+    const ownLabel = await labelRepo.insertLabel({ orgId: tenant.org.id, name: "Bug", color: "#112233", description: "Existing" });
+    const otherLabel = await labelRepo.insertLabel({ orgId: other.org.id, name: "Bug", color: "#abcdef", description: null });
+    const result = await importIssues(tenant.actors.member, upload(tenant, [
+      { title: "Active assignee", assigneeEmail: "OWNER@IMPORT-RESOLUTION.TEST", labels: ["Bug", "bug", "New", "New"] },
+      { title: "Removed assignee", assigneeEmail: "admin@import-resolution.test", labels: ["New"] },
+      { title: "Invited assignee", assigneeEmail: "viewer@import-resolution.test" },
+      { title: "Foreign assignee", assigneeEmail: "owner@import-other.test" },
+      { title: "Unknown assignee", assigneeEmail: "unknown@example.test" },
+    ]));
+    expect(result.issues.map((issue) => issue.assigneeId)).toEqual([tenant.userIds.owner, null, null, null, null]);
+    const labels = await labelRepo.listLabels(tenant.org.id);
+    expect(labels).toHaveLength(3);
+    expect(labels.find((label) => label.name === "New")).toMatchObject({ color: "#94a3b8", description: null });
+    expect(result.issues[0].labelIds).toHaveLength(3);
+    expect(result.issues[0].labelIds).toContain(ownLabel.id);
+    expect(result.issues[0].labelIds).not.toContain(otherLabel.id);
+    expect(result.issues[1].labelIds).toEqual([labels.find((label) => label.name === "New")!.id]);
+    const stored = await issueRepo.findIssueById(tenant.org.id, result.issues[0].id);
+    expect(new Set(stored!.labelIds)).toEqual(new Set(result.issues[0].labelIds));
+  });
+
+  it("refuses unauthorized, foreign, missing and archived projects without writing", async () => {
+    const tenant = await createTenant("import-access");
+    const other = await createTenant("import-access-other");
+    const input = upload(tenant, [{ title: "Access denied", labels: ["Should not exist"] }]);
+    await expect(importIssues(tenant.actors.viewer, input)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(importIssues(tenant.actors.member, { ...input, orgId: other.org.id })).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(importIssues(tenant.actors.member, { ...input, projectId: other.project.id })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(importIssues(tenant.actors.member, { ...input, projectId: newId() as ProjectId })).rejects.toBeInstanceOf(NotFoundError);
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(importIssues(tenant.actors.member, input)).rejects.toBeInstanceOf(AlreadyArchivedError);
+    await expectEmpty(tenant);
+  });
+
+  it("uses the single-create quota and counting rules for the whole batch, preserving refused keys", async () => {
+    const tenant = await createTenant("import-quota", "free");
+    for (let number = 1; number <= 99; number++) {
+      await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, number);
+    }
+    const archived = await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, 100);
+    await issueRepo.archiveIssue(tenant.org.id, archived.id);
+    const input = upload(tenant, [{ title: "Over quota", labels: ["No label"] }, { title: "Extra row" }]);
+    const error = `Plan free allows no more issues in project ${tenant.project.key}`;
+    await expect(importIssues(tenant.actors.member, input)).rejects.toThrow(error);
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(99);
+    expect(await labelRepo.listLabels(tenant.org.id)).toEqual([]);
+    expect(issueRepo.findIssueImport(tenant.org.id, input.importKey)).toBeNull();
+    const result = await importIssues(tenant.actors.member, { ...input, rows: [input.rows[0]] });
+    expect(result.replayed).toBe(false);
+    expect(result.issues[0].number).toBe(101);
+    await expect(createIssue(tenant.actors.member, issueInput(tenant.org.id, tenant.project.id))).rejects.toThrow(error);
+  });
+
+  it("spends one rate token per row atomically, and replays even with an empty allowance", async () => {
+    vi.useFakeTimers();
+    const tenant = await createTenant("import-rate", "free");
+    await consumeRateLimit(tenant.org.id, "issue:create", 55);
+    const input = upload(tenant, Array.from({ length: 6 }, (_, i) => ({ title: `Row ${i}`, labels: ["No label"] })));
+    await expect(importIssues(tenant.actors.member, input)).rejects.toThrow(/rate limit/i);
+    await expectEmpty(tenant);
+    const result = await importIssues(tenant.actors.member, { ...input, rows: input.rows.slice(0, 5) });
+    expect(result.replayed).toBe(false);
+    expect((await consumeRateLimit(tenant.org.id, "issue:create")).allowed).toBe(false);
+    expect(await importIssues(tenant.actors.member, input)).toEqual({ ...result, replayed: true });
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(5);
+  });
+
+  it("rolls back labels, issues and the key if a later insert fails", async () => {
+    const tenant = await createTenant("import-rollback");
+    const input = upload(tenant, [{ title: "First row", labels: ["New"] }, { title: "Second row", labels: ["Another"] }]);
+    getDb().$client.exec("CREATE TRIGGER refuse_second_issue BEFORE INSERT ON issues WHEN NEW.number = 2 BEGIN SELECT RAISE(ABORT, 'insert failure'); END");
+    try {
+      await expect(importIssues(tenant.actors.member, input)).rejects.toThrow("insert failure");
+      await expectEmpty(tenant);
+    } finally {
+      getDb().$client.exec("DROP TRIGGER refuse_second_issue");
+    }
+    const retry = await importIssues(tenant.actors.member, input);
+    expect(retry.replayed).toBe(false);
+    expect(retry.issues.map((issue) => issue.number)).toEqual([1, 2]);
+  });
+
+  it("keeps keys scoped to the workspace and treats different keys as new uploads", async () => {
+    const tenant = await createTenant("import-keys");
+    const other = await createTenant("import-keys-other");
+    const first = await importIssues(tenant.actors.member, upload(tenant, [{ title: "Original title" }]));
+    const replay = await importIssues(tenant.actors.member, upload(tenant, [{ title: "Changed title", labels: ["Unused"] }]));
+    expect(replay).toEqual({ ...first, replayed: true });
+    expect(await labelRepo.listLabels(tenant.org.id)).toEqual([]);
+    const distinct = await importIssues(tenant.actors.member, upload(tenant, [{ title: "Original title" }], "upload-5678"));
+    const foreign = await importIssues(other.actors.member, upload(other, [{ title: "Original title" }]));
+    expect(distinct.replayed).toBe(false);
+    expect(foreign.replayed).toBe(false);
+    expect(new Set([first.issues[0].id, distinct.issues[0].id, foreign.issues[0].id]).size).toBe(3);
+  });
+
+  it("handles concurrent retries as one import and spends their rate allowance once", async () => {
+    vi.useFakeTimers();
+    const tenant = await createTenant("import-concurrent", "free");
+    const input = upload(tenant, Array.from({ length: 5 }, (_, i) => ({ title: `Row ${i}` })));
+    const results = await Promise.all([importIssues(tenant.actors.member, input), importIssues(tenant.actors.member, input)]);
+    expect(results.map((result) => result.replayed)).toEqual([false, true]);
+    expect(results[1].issues).toEqual(results[0].issues);
+    expect((await consumeRateLimit(tenant.org.id, "issue:create", 55)).allowed).toBe(true);
+    expect((await consumeRateLimit(tenant.org.id, "issue:create")).allowed).toBe(false);
+  });
+
+  it("announces one batch through the startup handlers, indexing, metering and auditing without notifications or webhooks", async () => {
+    const tenant = await createTenant("import-handlers");
+    registerEventHandlers();
+    await createIssue(tenant.actors.member, issueInput(tenant.org.id, tenant.project.id));
+    await webhookRepo.insertEndpoint({ orgId: tenant.org.id, url: "https://example.test/hook", eventTypes: ["issue.created", "issue.status_changed"] }, "secret");
+    const before = await usageRepo.getUsage(tenant.org.id);
+    const created: unknown[] = [];
+    const imported: unknown[] = [];
+    const errors: unknown[] = [];
+    detach.push(subscribe("issue.created", (payload) => { created.push(payload); }));
+    detach.push(subscribe("issues.imported", (payload) => { imported.push(payload); }));
+    detach.push(onHandlerError((_, error) => { errors.push(error); }));
+    const input = upload(tenant, [
+      { title: "Searchable import first", description: "Description search term", assigneeEmail: "admin@import-handlers.test" },
+      { title: "Searchable import second", assigneeEmail: "owner@import-handlers.test" },
+    ]);
+    const result = await importIssues(tenant.actors.member, input);
+    await importIssues(tenant.actors.member, input);
+    expect(errors).toEqual([]);
+    expect(created).toEqual([]);
+    expect(imported).toHaveLength(1);
+    expect(imported[0]).toMatchObject({ orgId: tenant.org.id, actorId: tenant.userIds.member,
+      projectId: tenant.project.id, importKey: input.importKey, issueIds: result.issues.map((issue) => issue.id) });
+    const hits = await search(tenant.actors.member, { orgId: tenant.org.id, q: "Searchable import", kinds: ["issue"], limit: 25, cursor: null });
+    expect(new Set(hits.items.map((hit) => hit.id))).toEqual(new Set(result.issues.map((issue) => issue.id)));
+    const usage = await usageRepo.getUsage(tenant.org.id);
+    expect(usage.issuesUsed).toBe(before.issuesUsed + 2);
+    expect((await usageRepo.recomputeUsage(tenant.org.id)).issuesUsed).toBe(usage.issuesUsed);
+    const audit = getDb().select().from(activityEvents).where(eq(activityEvents.orgId, tenant.org.id)).all();
+    expect(audit.filter((row) => row.action === "issue.created")).toHaveLength(1);
+    const imports = audit.filter((row) => row.action === "issues.imported");
+    expect(imports).toHaveLength(1);
+    expect(imports[0]).toMatchObject({ actorId: tenant.userIds.member, subjectKind: "project",
+      subjectId: tenant.project.id, projectId: tenant.project.id });
+    expect(JSON.parse(imports[0].metadata)).toEqual({ count: 2, importKey: input.importKey });
+    expect(getDb().select().from(notifications).where(eq(notifications.orgId, tenant.org.id)).all()).toEqual([]);
+    expect(getDb().select().from(webhookDeliveries).where(eq(webhookDeliveries.orgId, tenant.org.id)).all()).toEqual([]);
+  });
+
+  it("replays the persisted first result after reloading the service and database modules", async () => {
+    const tenant = await createTenant("import-restart");
+    const input = upload(tenant, [{ title: "Persisted first", labels: ["Persisted"] }, { title: "Persisted second" }]);
+    const first = await importIssues(tenant.actors.member, input);
+    await issueRepo.updateIssue({ orgId: tenant.org.id, issueId: first.issues[0].id, title: "Edited later" });
+    vi.resetModules();
+    const restarted = await import("@/server/services/issue-service");
+    const replay = await restarted.importIssues(tenant.actors.member, { ...input, rows: [{ ...input.rows[0], title: "Another upload" }] });
+    expect(replay).toEqual({ ...first, replayed: true });
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(2);
+  });
+});

+export function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): IssueImportResult | null {
+  const row = getDb().select().from(issueImports).where(
+    and(orgPredicate(issueImports.orgId, orgId), eq(issueImports.importKey, importKey)),
+  ).get();
+  return row ? {
+    importKey: row.importKey,
+    projectId: row.projectId as ProjectId,
+    issues: row.issues,
+    replayed: true,
+  } : null;
+}
+
+/** Synchronous SQLite transaction: labels, issues and the replay record commit together. */
+export function insertIssueImport(
+  input: ImportIssuesInput,
+  authorId: UserId,
+  assertQuota: (used: number) => void,
+): IssueImportResult {
+  const db = getDb();
+  return db.transaction(() => {
+    const replay = findIssueImport(input.orgId, input.importKey);
+    if (replay) return replay;
+
+    // Recheck inside the transaction in case another writer filled the project.
+    assertQuota(countProjectIssues(input.orgId, input.projectId));
+    const firstNumber = nextProjectIssueNumber(input.orgId, input.projectId);
+    const activeMembers = db.select({ email: users.email, userId: users.id })
+      .from(members).innerJoin(users, eq(users.id, members.userId))
+      .where(and(
+        orgPredicate(members.orgId, input.orgId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      )).all();
+    const assignees = new Map(activeMembers.map((member) => [
+      member.email.toLowerCase(), member.userId as UserId,
+    ]));
+    const existingLabels = db.select().from(labels)
+      .where(orgPredicate(labels.orgId, input.orgId)).all();
+    const labelIds = new Map(existingLabels.map((label) => [label.name, label.id as LabelId]));
+    const stamp = toIsoTimestamp(new Date());
+
+    const imported = input.rows.map((row, index) => {
+      const rowLabelIds = [...new Set(row.labels)].map((name) => {
+        const existingId = labelIds.get(name);
+        if (existingId) return existingId;
+        const labelId = newId() as LabelId;
+        db.insert(labels).values({
+          id: labelId, orgId: input.orgId, name,
+          description: null, createdAt: stamp, updatedAt: stamp,
+        }).run();
+        labelIds.set(name, labelId);
+        return labelId;
+      });
+      return insertIssueRow({
+        orgId: input.orgId,
+        projectId: input.projectId,
+        title: row.title,
+        description: row.description,
+        status: row.status,
+        priority: row.priority,
+        dueAt: row.dueAt,
+        assigneeId: row.assigneeEmail === null
+          ? null : assignees.get(row.assigneeEmail.toLowerCase()) ?? null,
+        parentId: null,
+        estimate: null,
+        labelIds: rowLabelIds,
+      }, authorId, firstNumber + index);
+    });
+
+    db.insert(issueImports).values({
+      orgId: input.orgId, projectId: input.projectId,
+      importKey: input.importKey, issues: imported,
+    }).run();
+    return {
+      importKey: input.importKey, projectId: input.projectId,
+      issues: imported, replayed: false,
+    };

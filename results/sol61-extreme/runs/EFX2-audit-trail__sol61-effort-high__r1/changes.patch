+/** Reads every page with the same range and the repository's stable keyset order. */
+export async function listActivityForExport(
+  actor: Actor,
+  input: ExportActivityInput,
+): Promise<readonly ActivityEvent[]> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "activity:export", activityResource(input.orgId));
+  const range = exportActivitySchema.parse(input);
+  const events: ActivityEvent[] = [];
+  let cursor: string | null = null;
+
+  do {
+    const page = await activityRepo.listActivity({
+      orgId: range.orgId,
+      since: range.since,
+      until: range.until,
+      limit: 100,
+      cursor,
+    });
+    events.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+
+  return events;
+}
+
+/** Older comment events can resolve their project through a tenant-scoped issue lookup. */
+async function recordComment(
+  action: "comment.created" | "comment.updated" | "comment.deleted",
+  payload: TaskflowEventMap["comment.updated"],
+): Promise<void> {
+  const projectId = payload.projectId ??
+    (await issueRepo.findIssueById(payload.orgId, payload.issueId))?.projectId ?? null;
+  const verb = action === "comment.created" ? "Commented on" :
+    action === "comment.updated" ? "Edited comment on" : "Deleted comment on";
+  await record(payload.orgId, action, {
+    actorId: payload.actorId,
+    occurredAt: payload.occurredAt,
+    subjectKind: "comment",
+    subjectId: payload.commentId,
+    projectId,
+    summary: `${verb} issue ${payload.issueId}`,
+    metadata: { issueId: payload.issueId },
+  });
+}

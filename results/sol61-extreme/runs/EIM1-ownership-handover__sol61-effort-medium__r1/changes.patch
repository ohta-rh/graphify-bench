+  it("atomically transfers to a viewer, publishes role changes and audit, and moves billing and join alerts", async () => {
+    const t = await createTenant("handover-accept");
+    const roles: TaskflowEventMap["member.role_changed"][] = [];
+    const transfers: TaskflowEventMap["organization.ownership_transferred"][] = [];
+    const offs = [registerActivityListeners(), subscribe("member.role_changed", (e) => { roles.push(e); }),
+      subscribe("organization.ownership_transferred", (e) => { transfers.push(e); })];
+    try {
+      const offer = await orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.viewer);
+      expect(new Date(offer.expiresAt).getTime() - new Date(offer.createdAt).getTime()).toBe(days);
+      expect(offer).toMatchObject({ status: "pending", resolvedAt: null });
+      const notifications = await notificationRepo.listNotifications({ orgId: t.org.id, recipientId: t.userIds.viewer, unreadOnly: false, limit: 100, cursor: null });
+      expect(notifications.items.map((n) => n.kind)).toEqual(["ownership_handover"]);
+      const org = await orgService.acceptOwnershipHandover(t.actors.viewer, t.org.id);
+      expect(org.ownerId).toBe(t.userIds.viewer);
+      expect(await resolveActor(t.userIds.viewer, t.org.id)).toMatchObject({ role: "owner" });
+      expect(await resolveActor(t.userIds.owner, t.org.id)).toMatchObject({ role: "admin" });
+      expect(roles.map((e) => [e.from, e.to, e.actorId])).toEqual([
+        ["viewer", "owner", t.userIds.viewer], ["owner", "admin", t.userIds.viewer],
+      ]);
+      expect(transfers).toHaveLength(1);
+      expect(transfers[0]).toMatchObject({ fromUserId: t.userIds.owner, toUserId: t.userIds.viewer, actorId: t.userIds.viewer });
+      const audit = await activityRepo.listActivity({ orgId: t.org.id, action: ["organization.ownership_transferred"], limit: 100, cursor: null });
+      expect(audit.items[0]).toMatchObject({ subjectKind: "organization", subjectId: t.org.id,
+        actorId: t.userIds.viewer, metadata: { fromUserId: t.userIds.owner, toUserId: t.userIds.viewer } });
+      expect(await orgService.getPendingOwnershipHandover(t.actors.member, t.org.id)).toBeNull();
+      await expect(orgService.acceptOwnershipHandover(t.actors.viewer, t.org.id)).rejects.toMatchObject({ reason: "nothing_pending" });
+      // Actors may have been minted before acceptance; recorded ownership remains authoritative.
+      await expect(changePlan(t.actors.owner, { orgId: t.org.id, plan: "enterprise", interval: "monthly" })).rejects.toBeInstanceOf(PermissionDeniedError);
+      await changePlan(t.actors.viewer, { orgId: t.org.id, plan: "enterprise", interval: "monthly" });
+      const member = (await memberRepo.findMember(t.org.id, t.userIds.member))!;
+      await emit("member.joined", { orgId: t.org.id, actorId: member.userId, occurredAt: toIsoTimestamp(new Date()), memberId: member.id, userId: member.userId, role: member.role });
+      const newAlerts = await notificationRepo.listNotifications({ orgId: t.org.id, recipientId: t.userIds.viewer, kind: ["member_joined"], unreadOnly: false, limit: 100, cursor: null });
+      const oldAlerts = await notificationRepo.listNotifications({ orgId: t.org.id, recipientId: t.userIds.owner, kind: ["member_joined"], unreadOnly: false, limit: 100, cursor: null });
+      expect(newAlerts.items).toHaveLength(1);
+      expect(oldAlerts.items).toHaveLength(0);
+      const oldOwner = (await memberRepo.findMember(t.org.id, t.userIds.owner))!;
+      await removeMember((await resolveActor(t.userIds.viewer, t.org.id))!, { orgId: t.org.id, memberId: oldOwner.id });
+    } finally { offs.forEach((off) => off()); }
+  });
+
+  it("requires recorded ownership and active same-workspace recipients", async () => {
+    const t = await createTenant("handover-guards");
+    const other = await createTenant("handover-other");
+    const member = (await memberRepo.findMember(t.org.id, t.userIds.admin))!;
+    await memberRepo.updateMemberRole(t.org.id, member.id, "owner");
+    const secondOwner = (await resolveActor(member.userId, t.org.id))!;
+    await expect(orgService.initiateOwnershipHandover(secondOwner, t.org.id, t.userIds.member)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(orgService.cancelOwnershipHandover(secondOwner, t.org.id)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.owner)).rejects.toMatchObject({ reason: "self" });
+    await expect(orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, other.userIds.member)).rejects.toBeInstanceOf(NotFoundError);
+    const removed = (await memberRepo.findMember(t.org.id, t.userIds.viewer))!;
+    await removeMember(t.actors.owner, { orgId: t.org.id, memberId: removed.id });
+    await expect(orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, removed.userId)).rejects.toBeInstanceOf(NotFoundError);
+    await orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.member);
+    await expect(orgService.initiateOwnershipHandover(t.actors.owner, t.org.id, member.userId)).rejects.toMatchObject({ reason: "pending_exists" });
+    for (const operation of [orgService.acceptOwnershipHandover, orgService.declineOwnershipHandover, orgService.cancelOwnershipHandover, orgService.getPendingOwnershipHandover]) {
+      await expect(operation(other.actors.owner, t.org.id)).rejects.toBeInstanceOf(TenantScopeError);
+    }

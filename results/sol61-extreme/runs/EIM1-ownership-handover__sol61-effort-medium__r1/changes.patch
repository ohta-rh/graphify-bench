+import { and, eq, isNull, or } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toMember, toOrganization } from "./_mappers";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import type { OwnershipHandover, OwnershipHandoverStatus } from "@/types/organization";
+
+function toHandover(row: typeof ownershipHandovers.$inferSelect): OwnershipHandover {
+  return {
+    ...row,
+    orgId: row.orgId as OrgId,
+    fromUserId: row.fromUserId as UserId,
+    toUserId: row.toUserId as UserId,
+    createdAt: toIsoTimestamp(row.createdAt),
+    expiresAt: toIsoTimestamp(row.expiresAt),
+    resolvedAt: row.resolvedAt === null ? null : toIsoTimestamp(row.resolvedAt),
+  };
+}
+
+/** Keep validation and mutation synchronous inside a SQLite transaction. */
+export function transaction<T>(work: () => T): T {
+  return getDb().transaction(work);
+}
+
+export function findOrganization(orgId: OrgId) {
+  const row = getDb().select().from(organizations).where(eq(organizations.id, orgId)).get();
+  return row ? toOrganization(row) : null;
+}
+
+export function findActiveMember(orgId: OrgId, userId: UserId) {
+  const row = getDb().select().from(members).where(and(
+    eq(members.orgId, orgId), eq(members.userId, userId),
+    eq(members.status, "active"), isNull(members.archivedAt),
+  )).get();
+  return row ? toMember(row) : null;
+}
+
+/** Includes lapsed rows so accept/decline can distinguish expired offers. */
+export function findUnresolved(orgId: OrgId): OwnershipHandover | null {
+  const row = getDb().select().from(ownershipHandovers).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+  )).get();
+  return row ? toHandover(row) : null;
+}
+
+export function insert(orgId: OrgId, fromUserId: UserId, toUserId: UserId, now: Date): OwnershipHandover {
+  return toHandover(getDb().insert(ownershipHandovers).values({
+    id: newId(), orgId, fromUserId, toUserId, status: "pending",
+    createdAt: toIsoTimestamp(now),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000)),
+    resolvedAt: null,
+  }).returning().get());
+}
+
+export function resolve(offer: OwnershipHandover, status: OwnershipHandoverStatus, at: IsoTimestamp): OwnershipHandover {
+  return toHandover(getDb().update(ownershipHandovers).set({ status, resolvedAt: at })
+    .where(and(eq(ownershipHandovers.orgId, offer.orgId), eq(ownershipHandovers.id, offer.id)))
+    .returning().get());
+}
+
+export function setRole(orgId: OrgId, userId: UserId, role: Role, at: IsoTimestamp): void {
+  getDb().update(members).set({ role, updatedAt: at }).where(and(
+    eq(members.orgId, orgId), eq(members.userId, userId), isNull(members.archivedAt),
+  )).run();
+}
+
+export function setOwner(orgId: OrgId, ownerId: UserId, at: IsoTimestamp) {
+  return toOrganization(getDb().update(organizations).set({ ownerId, updatedAt: at })
+    .where(eq(organizations.id, orgId)).returning().get());
+}
+
+export function cancelForMember(orgId: OrgId, userId: UserId, at: IsoTimestamp): void {
+  getDb().update(ownershipHandovers).set({ status: "canceled", resolvedAt: at }).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+    or(eq(ownershipHandovers.fromUserId, userId), eq(ownershipHandovers.toUserId, userId)),
+  )).run();
+}

+}
+
+function isOpen(offer: OwnershipHandover, now: Date): boolean {
+  return now.getTime() < new Date(offer.expiresAt).getTime();
+}
+
+export async function initiateOwnershipHandover(
+  actor: Actor, orgId: OrgId, toUserId: UserId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const offer = handoverRepo.transaction(() => {
+    const org = handoverOrganization(actor, orgId);
+    assertRecordedOwner(actor, org.ownerId, "org:update");
+    requireFound(handoverRepo.findActiveMember(orgId, actor.userId), "Member", actor.userId);
+    if (toUserId === org.ownerId) throw new OwnershipHandoverError("self");
+    requireFound(handoverRepo.findActiveMember(orgId, toUserId), "Member", toUserId);
+    const now = new Date();
+    const pending = handoverRepo.findUnresolved(orgId);
+    if (pending) {
+      if (isOpen(pending, now)) throw new OwnershipHandoverError("pending_exists");
+      handoverRepo.resolve(pending, "expired", pending.expiresAt);
+    }
+    return handoverRepo.insert(orgId, actor.userId, toUserId, now);
+  });
+  await notify(orgId, "ownership_handover", [toUserId], {
+    title: "Workspace ownership offered to you",
+    body: "Accept this offer within seven days to become the workspace owner.",
+    href: "/settings/members", actorId: actor.userId,
+  });
+  return offer;
+}
+
+/** Expired offers remain unchanged when acted on. */
+function offeredHandover(actor: Actor, orgId: OrgId, now: Date): OwnershipHandover {
+  const pending = handoverRepo.findUnresolved(orgId);
+  if (!pending || pending.toUserId !== actor.userId) {
+    throw new OwnershipHandoverError("nothing_pending");
+  }
+  if (!isOpen(pending, now)) throw new OwnershipHandoverError("expired");
+  return pending;
+}
+
+export async function acceptOwnershipHandover(actor: Actor, orgId: OrgId): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+  const result = handoverRepo.transaction(() => {
+    handoverOrganization(actor, orgId);
+    const now = new Date();
+    const offer = offeredHandover(actor, orgId, now);
+    const toMember = requireFound(handoverRepo.findActiveMember(orgId, offer.toUserId), "Member", offer.toUserId);
+    const fromMember = requireFound(handoverRepo.findActiveMember(orgId, offer.fromUserId), "Member", offer.fromUserId);
+    const at = toIsoTimestamp(now);
+    // Promote first, then demote, without invoking manual role-change guards.
+    if (toMember.role !== "owner") handoverRepo.setRole(orgId, toMember.userId, "owner", at);
+    const organization = handoverRepo.setOwner(orgId, toMember.userId, at);
+    if (fromMember.role === "owner") handoverRepo.setRole(orgId, fromMember.userId, "admin", at);
+    handoverRepo.resolve(offer, "accepted", at);
+    return { organization, offer, toMember, fromMember };
+  });
+  if (result.toMember.role !== "owner") {
+    await emit("member.role_changed", {
+      ...actorEnvelope(actor), memberId: result.toMember.id, from: result.toMember.role, to: "owner",
+    });
+  }
+  if (result.fromMember.role === "owner") {
+    await emit("member.role_changed", {
+      ...actorEnvelope(actor), memberId: result.fromMember.id, from: "owner", to: "admin",
+    });
+  }
+  await emit("organization.ownership_transferred", {
+    ...actorEnvelope(actor), fromUserId: result.offer.fromUserId, toUserId: result.offer.toUserId,
+  });

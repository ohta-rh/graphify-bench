+  return handoverRepo.transaction(() => {
+    handoverOrganization(actor, orgId);
+    const now = new Date();
+    const offer = offeredHandover(actor, orgId, now);
+    return handoverRepo.resolve(offer, "declined", toIsoTimestamp(now));
+  });
+}
+
+export async function cancelOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.transaction(() => {
+    const org = handoverOrganization(actor, orgId);
+    assertRecordedOwner(actor, org.ownerId, "org:update");
+    const now = new Date();
+    const offer = handoverRepo.findUnresolved(orgId);
+    if (!offer || !isOpen(offer, now)) throw new OwnershipHandoverError("nothing_pending");
+    return handoverRepo.resolve(offer, "canceled", toIsoTimestamp(now));
+  });
+}
+
+export async function getPendingOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover | null> {
+  handoverOrganization(actor, orgId);

@@ -0,0 +1,38 @@
+import type { Subscription, WorkspaceLockReason } from "@/types/billing";
+import type { OrgId } from "@/types/common";
+
+export class WorkspaceLockedError extends Error {
+  readonly code = "plan_limit_exceeded" as const;
+
+  constructor(
+    readonly orgId: OrgId,
+    readonly reason: WorkspaceLockReason,
+  ) {
+    super(`This workspace is read-only (${reason}). Choose a plan in billing to resume editing.`);
+    this.name = "WorkspaceLockedError";
+  }
+}
+
+/** Evaluate the stored subscription at the time of the operation. */
+export function lockReasonFor(
+  subscription: Subscription | null,
+  now: Date = new Date(),
+): WorkspaceLockReason | null {
+  if (subscription === null) return null;
+
+  switch (subscription.status) {
+    case "active":
+      return null;
+    case "past_due":
+      return "past_due";
+    case "trialing":
+      return now.getTime() >= new Date(subscription.currentPeriodEnd).getTime()
+        ? "trial_ended"
+        : null;
+    case "canceled":
+      return subscription.cancelAt === null ||
+        now.getTime() >= new Date(subscription.cancelAt).getTime()
+        ? "canceled"
+        : null;
+  }
+}

+import { describe, expect, it } from "vitest";
+import { lockReasonFor, WorkspaceLockedError } from "@/lib/billing-lock";
+import { isDomainError, toAppError } from "@/lib/errors";
+import type { Subscription } from "@/types/billing";
+import { toIsoTimestamp, type SubscriptionId } from "@/types/common";
+import { ORG_A } from "../helpers/factories";
+
+const end = toIsoTimestamp("2026-06-01T00:00:00.000Z");
+const subscription: Subscription = {
+  id: "subscription" as SubscriptionId,
+  orgId: ORG_A,
+  plan: "growth",
+  interval: "monthly",
+  status: "active",
+  seats: 1,
+  currentPeriodStart: toIsoTimestamp("2026-05-01T00:00:00.000Z"),
+  currentPeriodEnd: end,
+  cancelAt: null,
+  createdAt: end,
+  updatedAt: end,
+};
+
+describe("workspace lock rules", () => {
+  it("allows missing and active subscriptions regardless of period dates", () => {
+    expect(lockReasonFor(null, new Date(end))).toBeNull();
+    expect(lockReasonFor(subscription, new Date(end))).toBeNull();
+    expect(lockReasonFor({ ...subscription, cancelAt: end }, new Date(end))).toBeNull();
+  });
+
+  it("locks past-due subscriptions regardless of the period end", () => {
+    expect(lockReasonFor({ ...subscription, status: "past_due" }, new Date("2026-05-01"))).toBe("past_due");
+  });
+
+  it.each([
+    ["trialing", "trial_ended"],
+    ["canceled", "canceled"],
+  ] as const)("locks %s subscriptions exactly at the relevant date", (status, reason) => {
+    const row = { ...subscription, status, cancelAt: end };
+    const boundary = new Date(end).getTime();
+    expect(lockReasonFor(row, new Date(boundary - 1))).toBeNull();
+    expect(lockReasonFor(row, new Date(boundary))).toBe(reason);
+    expect(lockReasonFor(row, new Date(boundary + 1))).toBe(reason);
+  });
+
+  it("uses cancelAt independently of the period end", () => {
+    const row = { ...subscription, status: "canceled" as const, cancelAt: toIsoTimestamp("2026-07-01") };
+    expect(lockReasonFor(row, new Date(end))).toBeNull();
+    expect(lockReasonFor({ ...row, cancelAt: null }, new Date(end))).toBe("canceled");
+  });
+
+  it("translates the lock into a domain error with its reason", () => {
+    const error = new WorkspaceLockedError(ORG_A, "trial_ended");
+    expect(error.name).toBe("WorkspaceLockedError");
+    expect(isDomainError(error)).toBe(true);
+    expect(toAppError(error)).toMatchObject({
+      code: "plan_limit_exceeded",
+      meta: { reason: "trial_ended" },
+    });
+  });
+});

+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+/** Includes counters and reactive tables as well as the member-facing rows. */
+function snapshot() {
+  const sqlite = getDb().$client;
+  const tables = sqlite.prepare("SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name").all() as { name: string }[];
+  return tables.map(({ name }) => ({
+    name,
+    rows: sqlite.prepare(`SELECT * FROM "${name.replaceAll('"', '""')}" ORDER BY rowid`).all(),
+  }));
+}
+
+describe("locked workspace services", () => {
+  it("refuses every member write without changing any rows or publishing events", async () => {
+    const tenant = await createTenant("locked-writes");
+    const orgId = tenant.org.id;
+    const actor = tenant.actors.owner;
+    const issue = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    const commentInput = { orgId, issueId: issue.id, body: "Original", parentId: null, mentionedUserIds: [] };
+    const comment = await commentService.createComment(actor, commentInput);
+    const label = await labelService.createLabel(actor, { orgId, name: "Original", color: "#123456", description: null });
+    const attachmentInput = { orgId, issueId: issue.id, filename: "file.txt", contentType: "text/plain", sizeBytes: 10 };
+    const attachment = await attachmentService.addAttachment(actor, attachmentInput);
+    const endpointInput = { orgId, url: "https://example.com/hook", eventTypes: ["issue.created" as const] };
+    const endpoint = await webhookService.createWebhook(actor, endpointInput);
+    const token = "pending-lock-token";
+    const invitation = await invitationRepo.insertInvitation(orgId, { orgId, email: "invitee@lock.test", role: "member", expiresInDays: 14 }, actor.userId, hashToken(token));
+    const user = await userRepo.insertUser({ email: "invitee@lock.test", name: "Invitee", passwordHash: "seed" });
+    const member = (await memberRepo.findMember(orgId, tenant.userIds.member))!;
+    getDb().update(subscriptions).set({ status: "past_due" }).where(eq(subscriptions.orgId, orgId)).run();
+
+    const writes: (() => Promise<unknown>)[] = [
+      () => issueService.createIssue(actor, issueInput(orgId, tenant.project.id)),
+      () => issueService.updateIssue(actor, { orgId, issueId: issue.id, title: "Changed" }),
+      () => issueService.changeIssueStatus(actor, { orgId, issueId: issue.id, status: "done" }),
+      () => issueService.changeIssueStatus(actor, { orgId, issueId: issue.id, status: issue.status }),
+      () => issueService.moveIssue(actor, { orgId, issueId: issue.id, toStatus: "todo", toIndex: 0 }),
+      () => issueService.assignIssue(actor, { orgId, issueId: issue.id, assigneeId: tenant.userIds.member }),
+      () => issueService.assignIssue(actor, { orgId, issueId: issue.id, assigneeId: null }),
+      () => issueService.archiveIssue(actor, orgId, issue.id),
+      () => commentService.createComment(actor, commentInput),
+      () => commentService.updateComment(actor, { orgId, commentId: comment.id, body: "Changed" }),
+      () => commentService.deleteComment(actor, { orgId, commentId: comment.id }),
+      () => projectService.createProject(actor, { orgId, name: "New project", slug: "new-project", key: "NEW", description: null, visibility: "org", leadId: null, color: "#123456", targetDate: null }),
+      () => projectService.updateProject(actor, { orgId, projectId: tenant.project.id, name: "Changed" }),
+      () => projectService.archiveProject(actor, { orgId, projectId: tenant.project.id, archiveIssues: true }),
+      () => projectService.restoreProject(actor, orgId, tenant.project.id),
+      () => labelService.createLabel(actor, { orgId, name: "New", color: "#123456", description: null }),
+      () => labelService.updateLabel(actor, { orgId, labelId: label.id, name: "Changed" }),
+      () => labelService.deleteLabel(actor, orgId, label.id),
+      () => attachmentService.addAttachment(actor, attachmentInput),
+      () => attachmentService.removeAttachment(actor, { orgId, attachmentId: attachment.id }),
+      () => memberService.updateMemberRole(actor, { orgId, memberId: member.id, role: "admin" }),
+      () => memberService.removeMember(actor, { orgId, memberId: member.id }),
+      () => invitationService.inviteMember(actor, { orgId, email: "new@lock.test", role: "member" }),
+      () => invitationService.inviteMembers(actor, { orgId, invites: [{ email: "bulk@lock.test", role: "member" }] }),
+      () => invitationService.revokeInvitation(actor, invitation.id),
+      () => invitationService.resendInvitation(actor, invitation.id),
+      () => invitationService.acceptInvitation(user.id, { token }),
+      () => orgService.updateOrganization(actor, { orgId, name: "Changed" }),
+      () => flagService.toggleFlag(actor, { orgId, flag: "kanban_board", enabled: false }),
+      () => webhookService.createWebhook(actor, endpointInput),
+      () => webhookService.updateWebhook(actor, { orgId, webhookId: endpoint.id as WebhookId, enabled: false }),
+      () => webhookService.deleteWebhook(actor, { orgId, webhookId: endpoint.id as WebhookId }),
+    ];
+    const before = snapshot();
+    const emitted = vi.spyOn(eventBus, "emit");
+    try {
+      for (const write of writes) {
+        await expect(write()).rejects.toBeInstanceOf(WorkspaceLockedError);
+        expect(snapshot()).toEqual(before);
+      }
+      expect(emitted).not.toHaveBeenCalled();
+    } finally {
+      emitted.mockRestore();
+    }
+    await expect(memberRepo.findMember(orgId, user.id)).resolves.toBeNull();
+    await expect(invitationRepo.findInvitationByTokenHash(hashToken(token))).resolves.toMatchObject({ acceptedAt: null, revokedAt: null });
+    await expect(issueService.getIssue(tenant.actors.viewer, orgId, issue.id)).resolves.toMatchObject({ issue });
+    await expect(orgService.getOrganizationSummary(tenant.actors.viewer, orgId)).resolves.toMatchObject({ lockReason: "past_due" });
+    await expect(billingService.getBillingSummary(actor, orgId)).resolves.toMatchObject({ lockReason: "past_due" });
+    await expect(issueService.createIssue(tenant.actors.viewer, issueInput(orgId, tenant.project.id))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(issueService.updateIssue({ ...actor, orgId: ORG_B }, { orgId, issueId: issue.id, title: "Changed" })).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(invitationService.acceptInvitation(user.id, { token: "invalid-token" })).rejects.toThrow("Invitation token was not found");
+    await invitationRepo.revokeInvitation(orgId, invitation.id);
+    await expect(invitationService.acceptInvitation(user.id, { token })).rejects.toThrow("That invitation has been revoked");
+  });
+
+  it("checks dates from stored state and unlocks after a successful plan change", async () => {
+    const tenant = await createTenant("lock-boundary");
+    const orgId = tenant.org.id;
+    const end = toIsoTimestamp("2026-06-01T00:00:00.000Z");
+    getDb().update(subscriptions).set({ status: "trialing", currentPeriodEnd: end }).where(eq(subscriptions.orgId, orgId)).run();
+    await expect(billingService.assertWorkspaceWritable(orgId, new Date(new Date(end).getTime() - 1))).resolves.toBeUndefined();
+    await expect(billingService.assertWorkspaceWritable(orgId, new Date(end))).rejects.toMatchObject({ reason: "trial_ended", orgId });
+    await billingService.changePlan(tenant.actors.owner, { orgId, plan: "growth", interval: "monthly" });
+    await expect(billingService.assertWorkspaceWritable(orgId)).resolves.toBeUndefined();
+    await subscriptionRepo.cancelSubscription(orgId, toIsoTimestamp("2100-01-01"));
+    await expect(billingService.assertWorkspaceWritable(orgId)).resolves.toBeUndefined();
+    await expect(billingService.assertWorkspaceWritable(orgId, new Date("2100-01-01"))).rejects.toMatchObject({ reason: "canceled" });
+    getDb().delete(subscriptions).where(eq(subscriptions.orgId, orgId)).run();
+    await expect(billingService.assertWorkspaceWritable(orgId)).resolves.toBeUndefined();
+  });
+
+  it("allows notification fan-out, personal housekeeping, billing and workspace deletion", async () => {
+    const tenant = await createTenant("lock-exceptions");
+    const orgId = tenant.org.id;
+    getDb().update(subscriptions).set({ status: "past_due" }).where(eq(subscriptions.orgId, orgId)).run();
+    const [notification] = await notificationService.notify(orgId, "issue_overdue", [tenant.userIds.viewer], { title: "Overdue", body: "Still running", href: "/issues", actorId: null });
+    await expect(notificationService.markRead(tenant.actors.viewer, { orgId, notificationId: notification.id })).resolves.toMatchObject({ id: notification.id });
+    await expect(notificationService.updatePreference(tenant.actors.viewer, { orgId, userId: tenant.userIds.viewer, kind: "issue_overdue", inApp: true, email: false, digestOnly: false })).resolves.toMatchObject({ email: false });
+    await expect(billingService.updateSeats(tenant.actors.owner, { orgId, seats: 5 })).resolves.toMatchObject({ seats: 5 });
+    await expect(billingService.cancelSubscription(tenant.actors.owner, { orgId, cancelImmediately: true })).resolves.toMatchObject({ status: "canceled" });
+    await expect(orgService.deleteOrganization(tenant.actors.owner, { orgId, confirmSlug: tenant.org.slug })).resolves.toMatchObject({ id: orgId });
+  });
+
+  it("lets the trial-expiry job unlock trials that fit free and keeps other trials locked", async () => {
+    const tenant = await createTenant("trial-lock-job");
+    const fit = await orgService.createOrganization(tenant.userIds.owner, { name: "Fits free", slug: "trial-fits", plan: "growth" });
+    const oversized = await orgService.createOrganization(tenant.userIds.owner, { name: "Too much storage", slug: "trial-storage", plan: "growth" });
+    await usageRepo.incrementUsage(oversized.id, { storageMbUsed: 101 });
+    await usageRepo.recomputeUsage(tenant.org.id);
+    const now = new Date();
+    const ended = toIsoTimestamp(new Date(now.getTime() - 1));
+    for (const orgId of [fit.id, oversized.id, tenant.org.id]) {
+      getDb().update(subscriptions).set({ currentPeriodEnd: ended }).where(eq(subscriptions.orgId, orgId)).run();
+      await expect(billingService.assertWorkspaceWritable(orgId, now)).rejects.toMatchObject({ reason: "trial_ended" });
+    }
+    await runTrialExpiryJob(now);
+    await expect(subscriptionRepo.findSubscription(fit.id)).resolves.toMatchObject({ plan: "free", status: "active" });
+    await expect(billingService.assertWorkspaceWritable(fit.id, now)).resolves.toBeUndefined();
+    for (const orgId of [oversized.id, tenant.org.id]) {
+      await expect(subscriptionRepo.findSubscription(orgId)).resolves.toMatchObject({ plan: "growth", status: "trialing" });
+      await expect(billingService.assertWorkspaceWritable(orgId, now)).rejects.toMatchObject({ reason: "trial_ended" });
+    }
+  });
+});

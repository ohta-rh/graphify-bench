+export async function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): Promise<IssueImportResult | null> {
+  const row = getDb()
+    .select()
+    .from(issueImports)
+    .where(and(orgPredicate(issueImports.orgId, orgId), eq(issueImports.importKey, importKey)))
+    .get();
+  return row ? {
+    importKey: row.importKey,
+    projectId: row.projectId as ProjectId,
+    issues: row.issues,
+    replayed: true,
+  } : null;
+}
+
+/** Labels, issues, their joins and the replay record commit together. */
+export async function insertIssueImport(
+  input: ImportIssuesInput,
+  authorId: UserId,
+): Promise<IssueImportResult> {
+  const db = getDb();
+  return db.transaction(() => {
+    const activeMembers = db
+      .select({ email: users.email, userId: members.userId })
+      .from(members)
+      .innerJoin(users, eq(users.id, members.userId))
+      .where(and(
+        orgPredicate(members.orgId, input.orgId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      ))
+      .all();
+    const assignees = new Map(activeMembers.map(({ email, userId }) => [email.toLowerCase(), userId as UserId]));
+    const existingLabels = db.select().from(labels)
+      .where(orgPredicate(labels.orgId, input.orgId)).all();
+    const labelIds = new Map(existingLabels.map((label) => [label.name, label.id as LabelId]));
+    const highest = db.select({ value: sql<number | null>`max(${issues.number})` })
+      .from(issues)
+      .where(and(orgPredicate(issues.orgId, input.orgId), eq(issues.projectId, input.projectId)))
+      .get();
+    const firstNumber = (highest?.value ?? 0) + 1;
+
+    const imported = input.rows.map((row, index) => {
+      const rowLabelIds = [...new Set(row.labels)].map((name) => {
+        const existing = labelIds.get(name);
+        if (existing) return existing;
+        const label = db.insert(labels).values({ id: newId(), orgId: input.orgId, name, description: null })
+          .returning().get();
+        const id = label.id as LabelId;
+        labelIds.set(name, id);
+        return id;
+      });
+      return insertIssueRow({
+        orgId: input.orgId,
+        projectId: input.projectId,
+        title: row.title,
+        description: row.description,
+        status: row.status,
+        priority: row.priority,
+        dueAt: row.dueAt,
+        assigneeId: row.assigneeEmail === null ? null : assignees.get(row.assigneeEmail.toLowerCase()) ?? null,
+        parentId: null,
+        estimate: null,
+        labelIds: rowLabelIds,
+      }, authorId, firstNumber + index);
+    });
+
+    db.insert(issueImports).values({
+      orgId: input.orgId,
+      importKey: input.importKey,
+      projectId: input.projectId,
+      issues: imported,
+    }).run();
+    return { importKey: input.importKey, projectId: input.projectId, issues: imported, replayed: false };
+  });
 }
 

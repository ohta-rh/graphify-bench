+export async function initiateOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+  toUserId: UserId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const handover = handoverRepo.transaction(() => {
+    assertRecordedOwner(actor, orgId);
+    if (toUserId === actor.userId) throw new OwnershipHandoverError("self");
+    requireFound(handoverRepo.findActiveMember(orgId, toUserId), "Member", toUserId);
+
+    const at = toIsoTimestamp(new Date());
+    const pending = handoverRepo.findUnresolved(orgId);
+    if (pending && pending.expiresAt > at) throw new OwnershipHandoverError("pending_exists");
+    handoverRepo.expireLapsed(orgId, at);
+    return handoverRepo.insertHandover(orgId, actor.userId, toUserId, at);
+  });
+
+  await notify(orgId, "ownership_handover", [toUserId], {
+    title: "You were offered workspace ownership",
+    body: "Accept this offer within seven days to become the workspace owner.",
+    href: "/settings/members",
+    actorId: actor.userId,
+  });
+  return handover;
+}
+
+export async function acceptOwnershipHandover(actor: Actor, orgId: OrgId): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+  const result = handoverRepo.transaction(() => {
+    const at = toIsoTimestamp(new Date());
+    const handover = requireRecipientOffer(actor, orgId, at);
+    const nextOwner = requireFound(handoverRepo.findActiveMember(orgId, handover.toUserId), "Member", handover.toUserId);
+    const previousOwner = requireFound(handoverRepo.findActiveMember(orgId, handover.fromUserId), "Member", handover.fromUserId);
+
+    // Promote first, so even inside the transaction the last owner is retained.
+    if (nextOwner.role !== "owner") handoverRepo.setMemberRole(orgId, nextOwner.id, "owner", at);
+    const organization = handoverRepo.setOwner(orgId, nextOwner.userId, at);
+    if (previousOwner.role === "owner") handoverRepo.setMemberRole(orgId, previousOwner.id, "admin", at);
+    handoverRepo.resolveHandover(orgId, handover.id, "accepted", at);
+    return { organization, handover, nextOwner, previousOwner };
+  });
+
+  const eventEnvelope = actorEnvelope(actor);
+  if (result.nextOwner.role !== "owner") {
+    await emit("member.role_changed", {
+      ...eventEnvelope, memberId: result.nextOwner.id, from: result.nextOwner.role, to: "owner",
+    });
+  }
+  if (result.previousOwner.role === "owner") {
+    await emit("member.role_changed", {
+      ...eventEnvelope, memberId: result.previousOwner.id, from: "owner", to: "admin",
+    });
+  }
+  await emit("organization.ownership_transferred", {
+    ...eventEnvelope, fromUserId: result.handover.fromUserId, toUserId: result.handover.toUserId,
+  });
+  return result.organization;
+}
+
+export async function declineOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.transaction(() => {
+    const at = toIsoTimestamp(new Date());
+    const handover = requireRecipientOffer(actor, orgId, at);
+    return handoverRepo.resolveHandover(orgId, handover.id, "declined", at);
+  });
+}
+
+export async function cancelOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.transaction(() => {
+    assertRecordedOwner(actor, orgId);
+    const at = toIsoTimestamp(new Date());
+    const handover = handoverRepo.findUnresolved(orgId);
+    if (!handover || handover.expiresAt <= at) throw new OwnershipHandoverError("nothing_pending");
+    return handoverRepo.resolveHandover(orgId, handover.id, "canceled", at);
+  });
+}
+
+export async function getPendingOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:read", orgResource(orgId));
+  const handover = handoverRepo.findUnresolved(orgId);
+  return handover && handover.expiresAt > toIsoTimestamp(new Date()) ? handover : null;
+}
+
+function assertRecordedOwner(actor: Actor, orgId: OrgId): void {
+  const org = requireFound(handoverRepo.findOrganization(orgId), "Organization", orgId);
+  assertCan(actor, "org:transfer_ownership", { kind: "organization", orgId, ownerId: org.ownerId });
+  requireFound(handoverRepo.findActiveMember(orgId, actor.userId), "Member", actor.userId);
+}
+
+function requireRecipientOffer(actor: Actor, orgId: OrgId, at: string): OwnershipHandover {
+  const handover = handoverRepo.findUnresolved(orgId);
+  if (!handover || handover.toUserId !== actor.userId) throw new OwnershipHandoverError("nothing_pending");
+  if (handover.expiresAt <= at) throw new OwnershipHandoverError("expired");
+  return handover;
 }

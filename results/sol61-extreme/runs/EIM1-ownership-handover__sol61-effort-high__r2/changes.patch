+import { and, eq, gt, isNull, lte, or } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import type { IsoTimestamp, MemberId, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import type { OwnershipHandoverStatus } from "@/types/organization";
+import { toMember, toOrganization, toOwnershipHandover } from "./_mappers";
+
+/** All handover checks and writes run synchronously within one SQLite transaction. */
+export function transaction<T>(operation: () => T): T {
+  return getDb().transaction(operation, { behavior: "immediate" });
+}
+
+export function findOrganization(orgId: OrgId) {
+  const row = getDb().select().from(organizations).where(eq(organizations.id, orgId)).get();
+  return row ? toOrganization(row) : null;
+}
+
+export function findActiveMember(orgId: OrgId, userId: UserId) {
+  const row = getDb().select().from(members).where(and(
+    eq(members.orgId, orgId), eq(members.userId, userId),
+    eq(members.status, "active"), isNull(members.archivedAt),
+  )).get();
+  return row ? toMember(row) : null;
+}
+
+/** Includes a lapsed pending row so the recipient can receive the expired refusal. */
+export function findUnresolved(orgId: OrgId) {
+  const row = getDb().select().from(ownershipHandovers).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+  )).get();
+  return row ? toOwnershipHandover(row) : null;
+}
+
+export function expireLapsed(orgId: OrgId, at: IsoTimestamp): void {
+  getDb().update(ownershipHandovers).set({
+    status: "expired", resolvedAt: ownershipHandovers.expiresAt,
+  }).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+    lte(ownershipHandovers.expiresAt, at),
+  )).run();
+}
+
+export function insertHandover(orgId: OrgId, fromUserId: UserId, toUserId: UserId, at: IsoTimestamp) {
+  const row = getDb().insert(ownershipHandovers).values({
+    id: newId(), orgId, fromUserId, toUserId, status: "pending",
+    createdAt: at, expiresAt: new Date(Date.parse(at) + 7 * 24 * 60 * 60 * 1000).toISOString(),
+    resolvedAt: null,
+  }).returning().get();
+  return toOwnershipHandover(row);
+}
+
+export function resolveHandover(orgId: OrgId, id: string, status: OwnershipHandoverStatus, at: IsoTimestamp) {
+  const row = getDb().update(ownershipHandovers).set({ status, resolvedAt: at }).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.id, id),
+    eq(ownershipHandovers.status, "pending"),
+  )).returning().get();
+  return toOwnershipHandover(row);
+}
+
+export function setOwner(orgId: OrgId, ownerId: UserId, at: IsoTimestamp) {
+  const row = getDb().update(organizations).set({ ownerId, updatedAt: at })
+    .where(eq(organizations.id, orgId)).returning().get();
+  return toOrganization(row);
+}
+
+export function setMemberRole(orgId: OrgId, memberId: MemberId, role: Role, at: IsoTimestamp): void {
+  getDb().update(members).set({ role, updatedAt: at }).where(and(
+    eq(members.orgId, orgId), eq(members.id, memberId),
+  )).run();

+      }
+      expect(seen).not.toHaveBeenCalled();
+      expect(await memberRepo.listMembers({ orgId: tenant.org.id, limit: 100, cursor: null })).toEqual(before);
+    } finally { for (const off of offs) off(); }
+  });

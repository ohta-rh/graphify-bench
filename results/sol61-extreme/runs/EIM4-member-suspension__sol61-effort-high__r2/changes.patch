+      await expect(memberService.reinstateMember(tenant.actors.admin, input)).rejects.toBeInstanceOf(NotFoundError);
+    } finally { for (const off of offs) off(); }
+  });
+
+  it("refuses invalid scope, missing or removed members, self and higher roles without events", async () => {
+    const tenant = await createTenant("suspension-guards");
+    const other = await createTenant("suspension-other");
+    const member = await target(tenant, "member");
+    const owner = await target(tenant, "owner");
+    const viewer = await target(tenant, "viewer");
+    await memberService.removeMember(tenant.actors.owner, viewer);
+    const seen = vi.fn();
+    const offs = [subscribe("member.suspended", seen), subscribe("member.reinstated", seen)];
+    const before = await memberRepo.listMembers({ orgId: tenant.org.id, limit: 100, cursor: null });
+    try {
+      for (const change of [memberService.suspendMember, memberService.reinstateMember]) {

+      expect(await memberService.suspendMember(tenant.actors.admin, input)).toEqual(after);
+      expect(suspended).toHaveBeenCalledTimes(1);
+      expect(suspended.mock.calls[0][0]).toMatchObject({ ...input, actorId: tenant.userIds.admin, userId: tenant.userIds.member });
+      expect(await memberService.resolveActor(tenant.userIds.member, tenant.org.id)).toBeNull();
+      expect(await resolveActorForOrg(principal, tenant.org.slug)).toBeNull();
+      expect(await orgRepo.listOrgsForUser(tenant.userIds.member)).toEqual([]);
+      expect(await memberRepo.countActiveMembers(tenant.org.id)).toBe(4);
+      expect((await usageRepo.recomputeUsage(tenant.org.id)).seatsUsed).toBe(4);
+      expect((await getOrganizationSummary(tenant.actors.owner, tenant.org.id)).memberCount).toBe(4);
+      const listed = await memberService.listMembers(tenant.actors.owner, { orgId: tenant.org.id, limit: 100, cursor: null });
+      expect(listed.items.find((row) => row.id === input.memberId)?.status).toBe("suspended");
+
+      const active = await memberService.reinstateMember(tenant.actors.admin, input);
+      expect(active.status).toBe("active");
+      expect(await memberService.reinstateMember(tenant.actors.admin, input)).toEqual(active);
+      expect(reinstated).toHaveBeenCalledTimes(1);
+      expect(await memberService.resolveActor(tenant.userIds.member, tenant.org.id)).toEqual(tenant.actors.member);
+      expect(await resolveActorForOrg(principal, tenant.org.slug)).toEqual(tenant.actors.member);
+      expect((await orgRepo.listOrgsForUser(tenant.userIds.member)).map((org) => org.id)).toEqual([tenant.org.id]);

+    const payload = { actorId: tenant.userIds.admin, title: "Update", body: "Update", href: "/issues" };
+    const [old] = await notify(tenant.org.id, "comment_created", [tenant.userIds.member], payload);
+    await preferenceRepo.upsertPreference({ orgId: tenant.org.id, userId: tenant.userIds.member, kind: "comment_created", inApp: true, email: true, digestOnly: true });
+    await memberService.suspendMember(tenant.actors.admin, input);
+    expect(await notify(tenant.org.id, "comment_created", [tenant.userIds.member], payload)).toEqual([]);
+    await emit("issue.overdue", { orgId: tenant.org.id, actorId: null, occurredAt: old.createdAt, issueId: issue.id, projectId: issue.projectId, assigneeId: tenant.userIds.member, dueAt: old.createdAt });
+    const seen = vi.fn();

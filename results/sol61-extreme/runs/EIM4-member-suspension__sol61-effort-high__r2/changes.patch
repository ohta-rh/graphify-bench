+      expect((await issueService.assignIssue(tenant.actors.admin, { orgId: tenant.org.id, issueId: existing.id, assigneeId: tenant.userIds.viewer })).assigneeId).toBe(tenant.userIds.viewer);
+      await memberService.reinstateMember(tenant.actors.admin, input);
+      expect((await issueService.assignIssue(tenant.actors.admin, { orgId: tenant.org.id, issueId: existing.id, assigneeId: tenant.userIds.member })).assigneeId).toBe(tenant.userIds.member);
+    } finally { for (const off of offs) off(); }
+  });

+        await expect(change(tenant.actors.admin, { orgId: tenant.org.id, memberId: "missing" as MemberId })).rejects.toBeInstanceOf(NotFoundError);
+        await expect(change(tenant.actors.admin, { orgId: tenant.org.id, memberId: (await target(other, "member")).memberId })).rejects.toBeInstanceOf(NotFoundError);
+        await expect(change(tenant.actors.admin, viewer)).rejects.toBeInstanceOf(NotFoundError);
+        await expect(change(tenant.actors.viewer, member)).rejects.toBeInstanceOf(PermissionDeniedError);
+        await expect(change(tenant.actors.owner, owner)).rejects.toThrow(/yourself/);

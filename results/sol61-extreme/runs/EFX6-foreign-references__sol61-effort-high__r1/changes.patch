+import { isLive } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as labelRepo from "@/server/repositories/label-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import { findReferenceOrgId } from "@/server/repositories/reference-repository";
+import { requireFound } from "./_support";
+import type { ReferenceEntity } from "@/server/repositories/reference-repository";
+import type { LabelId, TenantScoped, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+
+/** Check ownership before testing whether a reference is otherwise usable. */
+export async function requireScopedReference<T extends TenantScoped>(
+  actor: Actor,
+  row: T | null,
+  entity: ReferenceEntity,
+  id: string,
+): Promise<T> {
+  if (row) {
+    assertOrgScope(actor, row.orgId);
+  } else {
+    const orgId = await findReferenceOrgId(entity, id);
+    if (orgId !== null) assertOrgScope(actor, orgId);
+  }
+  return requireFound(row, entity, id);
+}
+
+export async function requireCurrentMember(
+  actor: Actor,
+  userId: UserId,
+): Promise<void> {
+  const member = requireFound(
+    await memberRepo.findMember(actor.orgId, userId),
+    "Member",
+    userId,
+  );
+  assertOrgScope(actor, member.orgId);
+  requireFound(
+    isLive(member) && member.status === "active" ? member : null,
+    "Member",
+    userId,
+  );
+}
+
+/** Validate the entire label set before the issue or its joins are changed. */
+export async function requireLabels(
+  actor: Actor,
+  labelIds: readonly LabelId[],
+): Promise<LabelId[]> {
+  const ids = [...new Set(labelIds)];
+  for (const id of ids) {
+    await requireScopedReference(
+      actor,
+      await labelRepo.findLabelById(actor.orgId, id),
+      "Label",
+      id,
+    );
+  }
+  return ids;
+}

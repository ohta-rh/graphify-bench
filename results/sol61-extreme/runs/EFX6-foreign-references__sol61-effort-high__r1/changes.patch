+import { eq } from "drizzle-orm";
+import { comments, getDb, issues, labels, projects } from "@/server/db";
+import type { OrgId } from "@/types/common";
+
+const referenceTables = {
+  Comment: comments,
+  Issue: issues,
+  Label: labels,
+  Project: projects,
+};
+
+export type ReferenceEntity = keyof typeof referenceTables;
+
+/**
+ * Ownership-only probe after a scoped lookup misses. It never returns another
+ * tenant's resource, but lets the service distinguish a scope violation from
+ * a nonexistent reference. Archived rows still have an owner.
+ */
+export async function findReferenceOrgId(
+  entity: ReferenceEntity,
+  id: string,
+): Promise<OrgId | null> {
+  const table = referenceTables[entity];
+  const row = getDb()
+    .select({ orgId: table.orgId })
+    .from(table)
+    .where(eq(table.id, id))
+    .get();
+  return row ? (row.orgId as OrgId) : null;
+}

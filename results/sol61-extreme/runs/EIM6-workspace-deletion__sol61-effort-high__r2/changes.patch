+export async function restoreOrganization(
+  userId: UserId,
+  orgId: OrgId,
+): Promise<Organization> {
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  if (
+    org.archivedAt !== null &&
+    Date.now() >= new Date(org.archivedAt).getTime() +
+      DELETED_WORKSPACE_RETENTION_DAYS * 24 * 60 * 60 * 1000
+  ) {
+    throw new NotFoundError("Organization", orgId);
+  }
+
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member) {
+    throw new NotFoundError("Organization", orgId);
+  }
+  assertCan({ userId, orgId, role: member.role }, "org:restore", orgResource(orgId));

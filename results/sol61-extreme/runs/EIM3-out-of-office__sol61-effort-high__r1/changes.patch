+import { and, eq } from "drizzle-orm";
+import { getDb, memberAbsences } from "@/server/db";
+import type { SetAbsenceInput } from "@/schemas/member";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { MemberAbsence } from "@/types/member";
+import { toMemberAbsence } from "./_mappers";
+import { orgPredicate } from "./base-repository";
+import { findMember } from "./member-repository";
+
+export async function findAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  const row = getDb()
+    .select()
+    .from(memberAbsences)
+    .where(and(orgPredicate(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .get();
+  return row ? toMemberAbsence(row) : null;
+}
+
+export async function upsertAbsence(input: SetAbsenceInput): Promise<MemberAbsence> {
+  const row = getDb()
+    .insert(memberAbsences)
+    .values(input)
+    .onConflictDoUpdate({
+      target: [memberAbsences.orgId, memberAbsences.userId],
+      set: {
+        delegateUserId: input.delegateUserId,
+        startsAt: input.startsAt,
+        endsAt: input.endsAt,
+        note: input.note,
+      },
+    })
+    .returning()
+    .get();
+  return toMemberAbsence(row);
+}
+
+export async function deleteAbsence(orgId: OrgId, userId: UserId): Promise<void> {
+  getDb()
+    .delete(memberAbsences)
+    .where(and(orgPredicate(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .run();
+}
+
+/** Resolves just one hop, at the action's instant, and only to a live member. */
+export async function findActiveDelegate(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<UserId | null> {
+  const absence = await findAbsence(orgId, userId);
+  if (!absence || absence.delegateUserId === null) return null;
+
+  const instant = new Date(at).getTime();
+  if (!(new Date(absence.startsAt).getTime() <= instant && instant < new Date(absence.endsAt).getTime())) {
+    return null;
+  }
+
+  const member = await findMember(orgId, userId);
+  const delegate = await findMember(orgId, absence.delegateUserId);
+  return member?.status === "active" && delegate?.status === "active"
+    ? delegate.userId
+    : null;
+}

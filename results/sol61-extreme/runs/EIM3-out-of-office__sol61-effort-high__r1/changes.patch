+      await expect(setAbsence(actor, absenceInput({ userId: tenant.userIds.owner })))
+        .rejects.toBeInstanceOf(PermissionDeniedError);
+      await expect(clearAbsence(actor, tenant.org.id, tenant.userIds.owner))
+        .rejects.toBeInstanceOf(PermissionDeniedError);
+    }
+    await setAbsence(tenant.actors.admin, absenceInput({ userId: tenant.userIds.owner }));
+    await clearAbsence(tenant.actors.admin, tenant.org.id, tenant.userIds.owner);
+  });
+
+  it("enforces tenant scope on every operation and requires active members and delegates", async () => {
+    const other = await createTenant(`absence-other-${sequence}`);
+    await expect(setAbsence(tenant.actors.owner, absenceInput({ orgId: other.org.id })))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(clearAbsence(tenant.actors.owner, other.org.id, tenant.userIds.member))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(getAbsence(tenant.actors.owner, other.org.id, tenant.userIds.member))
+      .rejects.toBeInstanceOf(TenantScopeError);
+
+    const member = await memberRepo.findMember(tenant.org.id, tenant.userIds.viewer);
+    await removeMember(tenant.actors.owner, { orgId: tenant.org.id, memberId: member!.id });
+    const admin = await memberRepo.findMember(tenant.org.id, tenant.userIds.admin);
+    getDb().update(members).set({ status: "suspended" }).where(eq(members.id, admin!.id)).run();
+    for (const invalid of [other.userIds.member, tenant.userIds.viewer, tenant.userIds.admin]) {
+      await expect(setAbsence(tenant.actors.owner, absenceInput({ userId: invalid })))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(setAbsence(tenant.actors.member, absenceInput({ delegateUserId: invalid })))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(getAbsence(tenant.actors.owner, tenant.org.id, invalid))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(clearAbsence(tenant.actors.owner, tenant.org.id, invalid))
+        .rejects.toBeInstanceOf(NotFoundError);
+    }
+  });
+
+  it.each([
+    ["before start", new Date(START).getTime() - 1, false],
+    ["at start", new Date(START).getTime(), true],
+    ["before end", new Date(END).getTime() - 1, true],
+    ["at end", new Date(END).getTime(), false],
+  ])("redirects creation and reassignment only while away: %s", async (_label, instant, redirected) => {
+    await setAbsence(tenant.actors.member, absenceInput());
+    vi.setSystemTime(instant);
+    const expected = redirected ? tenant.userIds.admin : tenant.userIds.member;
+    const assignedEvents: TaskflowEventMap["issue.assigned"][] = [];
+    const off = subscribe("issue.assigned", (event) => { assignedEvents.push(event); });
+    try {
+      const issue = await createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id, {
+        assigneeId: tenant.userIds.member,
+      }));
+      expect(issue.assigneeId).toBe(expected);
+      const assigned = await assignIssue(tenant.actors.owner, {
+        orgId: tenant.org.id,
+        issueId: issue.id,
+        assigneeId: tenant.userIds.member,
+      });
+      expect(assigned.assigneeId).toBe(expected);
+      expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.assigneeId).toBe(expected);
+      expect(assignedEvents.map((event) => event.assigneeId)).toEqual([expected, expected]);
+      const audit = await activityRepo.listActivityForSubject(tenant.org.id, "issue", issue.id);
+      expect(audit.filter((row) => row.action === "issue.assigned").map((row) => row.summary))
+        .toEqual([`Assigned to ${expected}`, `Assigned to ${expected}`]);
+      expect(await alerts(expected, "issue_assigned")).toHaveLength(2);
+      expect(await alerts(redirected ? tenant.userIds.member : tenant.userIds.admin, "issue_assigned"))
+        .toHaveLength(0);
+      vi.setSystemTime(new Date(END));
+      expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.assigneeId).toBe(expected);
+    } finally {
+      off();
+    }
+  });
+
+  it("preserves self-assignment, never chains delegation, and alerts normally without a delegate", async () => {

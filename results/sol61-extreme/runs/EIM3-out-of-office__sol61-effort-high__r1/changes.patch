+    }));
+    await setAbsence(tenant.actors.member, absenceInput());
+    await setAbsence(tenant.actors.admin, absenceInput({ userId: tenant.userIds.admin, delegateUserId: tenant.userIds.viewer }));
+    await usageRepo.recomputeUsage(tenant.org.id);
+    resetOverdueTracking();
+    vi.setSystemTime(new Date(END));

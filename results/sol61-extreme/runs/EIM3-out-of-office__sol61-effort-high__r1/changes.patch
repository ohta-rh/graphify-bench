+    const issue = await createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id, {
+      assigneeId: tenant.userIds.viewer,
+    }));
+    await expect(updateIssue(delegateActor, { orgId: tenant.org.id, issueId: issue.id, title: "Delegate edit" }))
+      .resolves.toMatchObject({ title: "Delegate edit" });
+    await expect(updateIssue(tenant.actors.viewer, { orgId: tenant.org.id, issueId: issue.id, title: "Absent edit" }))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+  });
+
+  it("redirects overdue alerts at sweep time without changing ownership or sweep deduplication", async () => {
+    const issue = await createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id, {
+      assigneeId: tenant.userIds.member,

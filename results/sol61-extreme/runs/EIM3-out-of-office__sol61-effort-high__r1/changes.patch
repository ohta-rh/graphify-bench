+import { eq } from "drizzle-orm";
+
+const START = toIsoTimestamp("2026-06-01T00:00:00.000Z");
+const END = toIsoTimestamp("2026-06-02T00:00:00.000Z");
+let cleanup: () => void;
+let tenant: Tenant;
+let sequence = 0;
+const detachers: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachers.push(registerActivityListeners());
+});
+
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(new Date(START));
+  tenant = await createTenant(`absence-${++sequence}`);
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+afterAll(() => {
+  for (const off of detachers) off();
+  cleanup();
+});
+
+function absenceInput(overrides: Partial<Parameters<typeof setAbsence>[1]> = {}) {
+  return {
+    orgId: tenant.org.id,
+    userId: tenant.userIds.member,
+    delegateUserId: tenant.userIds.admin,
+    startsAt: START,
+    endsAt: END,
+    note: "On leave",
+    ...overrides,
+  };
+}
+
+async function alerts(userId: UserId, kind: NotificationKind) {
+  return (await listNotifications(tenant.actors.owner, {
+    orgId: tenant.org.id,
+    recipientId: userId,
+    kind: [kind],
+    unreadOnly: false,
+    limit: 100,
+    cursor: null,
+  })).items;
+}
+
+describe("member absences", () => {
+  it("persists, replaces, reads scheduled absences, expires, and clears idempotently", async () => {
+    const input = absenceInput();
+    vi.setSystemTime(new Date(new Date(START).getTime() - 1));
+    expect(await setAbsence(tenant.actors.member, input)).toEqual(input);
+    expect(await absenceRepo.findAbsence(input.orgId, input.userId)).toEqual(input);
+    expect(await getAbsence(tenant.actors.viewer, input.orgId, input.userId)).toEqual(input);
+    const replacement = absenceInput({ delegateUserId: null, note: null });
+    expect(await setAbsence(tenant.actors.member, replacement)).toEqual(replacement);
+    expect(await getAbsence(tenant.actors.owner, input.orgId, input.userId)).toEqual(replacement);
+    vi.setSystemTime(new Date(END));
+    expect(await getAbsence(tenant.actors.member, input.orgId, input.userId)).toBeNull();
+    await clearAbsence(tenant.actors.member, input.orgId, input.userId);
+    await clearAbsence(tenant.actors.member, input.orgId, input.userId);
+    expect(await absenceRepo.findAbsence(input.orgId, input.userId)).toBeNull();
+  });
+
+  it("uses schema defaults and rejects long notes, invalid intervals, and self-delegation", async () => {
+    const { note: _note, delegateUserId: _delegate, ...required } = absenceInput();
+    const parsed = setAbsenceSchema.parse(required);
+    expect(parsed.note).toBeNull();
+    expect(parsed.delegateUserId).toBeNull();
+    expect(await setAbsence(tenant.actors.member, parsed)).toEqual(parsed);
+    for (const invalid of [
+      { endsAt: START },
+      { endsAt: toIsoTimestamp("2026-05-31T00:00:00.000Z") },
+      { delegateUserId: tenant.userIds.member },
+      { note: "x".repeat(201) },
+    ]) {
+      await expect(setAbsence(tenant.actors.member, absenceInput(invalid))).rejects.toThrow();
+    }
+    expect(await getAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.member)).toEqual(parsed);
+  });
+
+  it("allows anyone to manage their own absence, and requires role-change rights for others", async () => {
+    await setAbsence(tenant.actors.viewer, absenceInput({ userId: tenant.userIds.viewer }));
+    await clearAbsence(tenant.actors.viewer, tenant.org.id, tenant.userIds.viewer);

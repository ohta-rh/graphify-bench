+    expect(taken.assigneeId).toBe(tenant.userIds.member);
+    expect(await alerts(tenant.userIds.viewer, "issue_assigned")).toHaveLength(0);
+    await setAbsence(tenant.actors.member, absenceInput({ delegateUserId: null }));
+    const ordinary = await createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id, {
+      assigneeId: tenant.userIds.member,
+    }));
+    expect(ordinary.assigneeId).toBe(tenant.userIds.member);
+    expect(await alerts(tenant.userIds.member, "issue_assigned")).toHaveLength(1);
+  });
+
+  it("grants assignee permissions to the stored delegate", async () => {
+    await setAbsence(tenant.actors.viewer, absenceInput({
+      userId: tenant.userIds.viewer,
+      delegateUserId: tenant.userIds.admin,

+
+/** Walk the stable timestamp/id cursor until every matching row is collected. */
+export async function listActivityForExport(
+  actor: Actor,
+  input: ExportActivityInput,
+): Promise<readonly ActivityEvent[]> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "activity:export", activityResource(input.orgId));
+  activityRepo.assertActivityRange(input.since, input.until);
+  const events: ActivityEvent[] = [];
+  let cursor: string | null = null;
+  do {
+    const page: Page<ActivityEvent> = await activityRepo.listActivity({
+      orgId: input.orgId,
+      since: input.since,
+      until: input.until,
+      limit: 100,
+      cursor,
+    });
+    events.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+  return events;
 }

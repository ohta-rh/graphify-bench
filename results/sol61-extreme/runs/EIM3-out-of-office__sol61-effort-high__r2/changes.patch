+import type { IsoTimestamp, MemberId, OrgId, Page, UserId } from "@/types/common";
+import type { Actor, Member, MemberAbsence, MemberWithUser, Role } from "@/types/member";
 
 /** How many members are scanned when counting the remaining owners. */
 const OWNER_SCAN_LIMIT = 100;
+
+async function requireActiveMember(orgId: OrgId, userId: UserId): Promise<Member> {
+  const member = await memberRepo.findMember(orgId, userId);
+  return requireFound(member?.status === "active" ? member : null, "Member", userId);
+}
+
+export async function setAbsence(
+  actor: Actor,
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+  const member = await requireActiveMember(input.orgId, input.userId);
+  if (actor.userId !== input.userId) {
+    assertCan(actor, "member:update_role", memberResource(member));
+  }
+
+  const parsed = setAbsenceSchema.parse(input);
+  if (Date.parse(parsed.endsAt) <= Date.parse(parsed.startsAt)) {
+    throw new Error("Absence end must be after its start");
+  }
+  if (parsed.delegateUserId !== null) {
+    await requireActiveMember(parsed.orgId, parsed.delegateUserId);
+    if (parsed.delegateUserId === parsed.userId) {
+      throw new Error("A member cannot delegate to themselves");
+    }
+  }
+  return absenceRepo.upsertAbsence(parsed);
+}
+
+export async function clearAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,
+): Promise<void> {
+  assertOrgScope(actor, orgId);
+  const member = await requireActiveMember(orgId, userId);
+  if (actor.userId !== userId) {
+    assertCan(actor, "member:update_role", memberResource(member));
+  }
+  await absenceRepo.deleteAbsence(orgId, userId);
+}
+
+export async function getAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  assertOrgScope(actor, orgId);
+  const member = await requireActiveMember(orgId, userId);
+  assertCan(actor, "member:read", memberResource(member));
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  return absence && Date.now() < Date.parse(absence.endsAt) ? absence : null;
+}
+
+/** Resolves one delegation at the action's instant; delegates are never followed recursively. */
+export async function getActiveDelegate(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<UserId | null> {
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  const instant = Date.parse(at);
+  if (
+    !absence?.delegateUserId ||
+    instant < Date.parse(absence.startsAt) ||
+    instant >= Date.parse(absence.endsAt)
+  ) {
+    return null;
+  }
+  const member = await memberRepo.findMember(orgId, userId);
+  const delegate = await memberRepo.findMember(orgId, absence.delegateUserId);
+  return member?.status === "active" && delegate?.status === "active"
+    ? absence.delegateUserId
+    : null;
+}
 

+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+const START = toIsoTimestamp(new Date("2026-06-01T00:00:00.000Z"));
+const END = toIsoTimestamp(new Date("2026-06-02T00:00:00.000Z"));
+let cleanup: () => void;
+let sequence = 0;
+const detachers: Unsubscribe[] = [];
+
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date(START));
+});
+afterEach(() => {
+  while (detachers.length) detachers.pop()?.();
+  vi.useRealTimers();
+});
+afterAll(() => { cleanup(); });
+
+function tenant() {
+  return createTenant(`absence-${++sequence}`);
+}
+
+function absence(t: Tenant, overrides: Partial<SetAbsenceInput> = {}): SetAbsenceInput {
+  return {
+    orgId: t.org.id,
+    userId: t.userIds.member,
+    delegateUserId: t.userIds.admin,
+    startsAt: START,
+    endsAt: END,
+    note: "On holiday",
+    ...overrides,
+  };
+}
+
+async function notifications(t: Tenant, userId: UserId, kind: NotificationKind) {
+  return (await notificationRepo.listNotifications({
+    orgId: t.org.id, recipientId: userId, kind: [kind],
+    unreadOnly: false, limit: 100, cursor: null,
+  })).items;
+}
+
+describe("member absences", () => {
+  it("persists, replaces and clears absences, returning scheduled absences until the end", async () => {
+    const t = await tenant();
+    vi.setSystemTime(new Date(Date.parse(START) - 1));
+    const input = absence(t);
+    expect(await memberService.setAbsence(t.actors.member, input)).toEqual(input);
+    expect(await absenceRepo.findAbsence(t.org.id, t.userIds.member)).toEqual(input);
+    expect(await memberService.getAbsence(t.actors.viewer, t.org.id, t.userIds.member)).toEqual(input);
+
+    const replacement = absence(t, { delegateUserId: null, note: null });
+    expect(await memberService.setAbsence(t.actors.member, replacement)).toEqual(replacement);
+    vi.setSystemTime(new Date(END));
+    expect(await memberService.getAbsence(t.actors.owner, t.org.id, t.userIds.member)).toBeNull();
+    await memberService.clearAbsence(t.actors.member, t.org.id, t.userIds.member);
+    await memberService.clearAbsence(t.actors.member, t.org.id, t.userIds.member);
+    expect(await absenceRepo.findAbsence(t.org.id, t.userIds.member)).toBeNull();
+  });
+
+  it("applies schema defaults and rejects invalid intervals, self delegation and long notes", async () => {
+    const t = await tenant();
+    const parsed = setAbsenceSchema.parse({
+      orgId: t.org.id, userId: t.userIds.member, startsAt: START, endsAt: END,
+    });
+    expect(parsed.delegateUserId).toBeNull();
+    expect(parsed.note).toBeNull();
+    await expect(memberService.setAbsence(t.actors.member, parsed)).resolves.toEqual(parsed);
+    for (const overrides of [
+      { endsAt: START },
+      { endsAt: toIsoTimestamp(new Date(Date.parse(START) - 1)) },
+      { delegateUserId: t.userIds.member },
+      { note: "x".repeat(201) },
+    ]) {
+      await expect(memberService.setAbsence(t.actors.member, absence(t, overrides))).rejects.toThrow();
+    }
+    expect(await memberService.getAbsence(t.actors.member, t.org.id, t.userIds.member)).toEqual(parsed);
+  });
+
+  it("allows self service for viewers and role managers to change anyone's absence", async () => {
+    const t = await tenant();
+    await memberService.setAbsence(t.actors.viewer, absence(t, { userId: t.userIds.viewer }));
+    await memberService.clearAbsence(t.actors.viewer, t.org.id, t.userIds.viewer);
+    await expect(memberService.setAbsence(t.actors.member, absence(t, {
+      userId: t.userIds.viewer,
+    }))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(memberService.clearAbsence(t.actors.viewer, t.org.id, t.userIds.member))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await memberService.setAbsence(t.actors.admin, absence(t));
+    await memberService.clearAbsence(t.actors.admin, t.org.id, t.userIds.member);
+  });
+
+  it("rejects every operation across the actor's workspace", async () => {
+    const t = await tenant();
+    const other = await tenant();
+    await expect(memberService.setAbsence(other.actors.owner, absence(t)))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(memberService.clearAbsence(other.actors.owner, t.org.id, t.userIds.member))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(memberService.getAbsence(other.actors.owner, t.org.id, t.userIds.member))
+      .rejects.toBeInstanceOf(TenantScopeError);
+  });
+
+  it("rejects foreign and removed members and delegates with NotFoundError", async () => {
+    const t = await tenant();
+    const other = await tenant();
+    const removed = await memberRepo.findMember(t.org.id, t.userIds.viewer);
+    if (!removed) throw new Error("Missing fixture member");
+    await memberService.removeMember(t.actors.owner, { orgId: t.org.id, memberId: removed.id });
+    for (const userId of [other.userIds.member, t.userIds.viewer]) {
+      await expect(memberService.setAbsence(t.actors.owner, absence(t, { userId })))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(memberService.setAbsence(t.actors.owner, absence(t, { delegateUserId: userId })))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(memberService.getAbsence(t.actors.owner, t.org.id, userId))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(memberService.clearAbsence(t.actors.owner, t.org.id, userId))
+        .rejects.toBeInstanceOf(NotFoundError);
+    }
+  });
+
+  it("removes the member's absence and drops delegations only in that workspace", async () => {
+    const t = await tenant();
+    const other = await tenant();
+    await memberRepo.insertMember(other.org.id, t.userIds.admin, "admin", null);
+    await memberRepo.insertMember(other.org.id, t.userIds.member, "member", null);
+    await memberService.setAbsence(t.actors.member, absence(t));
+    await memberService.setAbsence(t.actors.admin, absence(t, {
+      userId: t.userIds.admin, delegateUserId: null,
+    }));
+    const otherAbsence = absence(t, { orgId: other.org.id });
+    await memberService.setAbsence(other.actors.owner, otherAbsence);
+    const delegate = await memberRepo.findMember(t.org.id, t.userIds.admin);
+    if (!delegate) throw new Error("Missing fixture member");
+    await memberService.removeMember(t.actors.owner, { orgId: t.org.id, memberId: delegate.id });
+    expect(await absenceRepo.findAbsence(t.org.id, t.userIds.admin)).toBeNull();
+    expect(await memberService.getAbsence(t.actors.owner, t.org.id, t.userIds.member))
+      .toEqual(absence(t, { delegateUserId: null }));
+    expect(await memberService.getAbsence(other.actors.viewer, other.org.id, t.userIds.member))
+      .toEqual(otherAbsence);
+  });
+
+  it.each([
+    [Date.parse(START) - 1, false],
+    [Date.parse(START), true],
+    [Date.parse(END) - 1, true],
+    [Date.parse(END), false],
+  ])("routes assignments and creation at instant %s (away: %s)", async (at, away) => {
+    const t = await tenant();
+    await memberService.setAbsence(t.actors.member, absence(t));
+    vi.setSystemTime(at);
+    const expected = away ? t.userIds.admin : t.userIds.member;
+    const created = await issueService.createIssue(t.actors.owner,
+      issueInput(t.org.id, t.project.id, { assigneeId: t.userIds.member }));
+    expect(created.assigneeId).toBe(expected);
+    const assigned = await issueService.assignIssue(t.actors.owner, {
+      orgId: t.org.id, issueId: created.id, assigneeId: t.userIds.member,
+    });
+    expect(assigned.assigneeId).toBe(expected);
+    expect((await issueRepo.findIssueById(t.org.id, created.id))?.assigneeId).toBe(expected);
+    expect(await notifications(t, expected, "issue_assigned")).toHaveLength(2);
+    expect(await notifications(t, away ? t.userIds.member : t.userIds.admin, "issue_assigned"))
+      .toHaveLength(0);
+  });
+
+  it("does not chain delegations or redirect self assignments, and preserves existing issues", async () => {
+    const t = await tenant();
+    const original = await issueService.createIssue(t.actors.owner,
+      issueInput(t.org.id, t.project.id, { assigneeId: t.userIds.member }));
+    await memberService.setAbsence(t.actors.member, absence(t));
+    await memberService.setAbsence(t.actors.admin, absence(t, {
+      userId: t.userIds.admin, delegateUserId: t.userIds.viewer,
+    }));
+    expect((await issueRepo.findIssueById(t.org.id, original.id))?.assigneeId).toBe(t.userIds.member);
+    const redirected = await issueService.createIssue(t.actors.owner,
+      issueInput(t.org.id, t.project.id, { assigneeId: t.userIds.member }));
+    expect(redirected.assigneeId).toBe(t.userIds.admin);
+    const self = await issueService.createIssue(t.actors.member,
+      issueInput(t.org.id, t.project.id, { assigneeId: t.userIds.member }));
+    expect(self.assigneeId).toBe(t.userIds.member);
+    expect((await issueService.assignIssue(t.actors.member, {
+      orgId: t.org.id, issueId: redirected.id, assigneeId: t.userIds.member,
+    })).assigneeId).toBe(t.userIds.member);
+    const stays = await issueService.assignIssue(t.actors.owner, {
+      orgId: t.org.id, issueId: redirected.id, assigneeId: t.userIds.member,
+    });
+    vi.setSystemTime(new Date(END));
+    expect((await issueRepo.findIssueById(t.org.id, stays.id))?.assigneeId).toBe(t.userIds.admin);
+  });
+
+  it("uses the delegate in events, audit and assignee permissions", async () => {
+    const t = await tenant();
+    await memberService.setAbsence(t.actors.member, absence(t, { delegateUserId: t.userIds.viewer }));
+    detachers.push(registerActivityListeners());
+    const event = vi.fn();
+    detachers.push(subscribe("issue.assigned", event));
+    const issue = await issueService.createIssue(t.actors.owner, issueInput(t.org.id, t.project.id));
+    await issueService.assignIssue(t.actors.owner, {
+      orgId: t.org.id, issueId: issue.id, assigneeId: t.userIds.member,
+    });
+    expect(event).toHaveBeenCalledWith(expect.objectContaining({ assigneeId: t.userIds.viewer }));
+    const audit = await activityRepo.listActivity({ orgId: t.org.id, action: ["issue.assigned"],
+      limit: 25, cursor: null });
+    expect(audit.items[0]?.summary).toBe(`Assigned to ${t.userIds.viewer}`);
+    await expect(issueService.updateIssue(t.actors.viewer, {
+      orgId: t.org.id, issueId: issue.id, title: "Delegate can edit this",
+    })).resolves.toMatchObject({ title: "Delegate can edit this" });
+  });
+
+  it("keeps assignments and alerts unchanged without a delegate and in other workspaces", async () => {
+    const t = await tenant();
+    const other = await tenant();
+    await memberRepo.insertMember(other.org.id, t.userIds.member, "member", null);
+    await memberService.setAbsence(t.actors.member, absence(t));
+    const foreign = await issueService.createIssue(other.actors.owner,
+      issueInput(other.org.id, other.project.id, { assigneeId: t.userIds.member }));
+    expect(foreign.assigneeId).toBe(t.userIds.member);
+    await memberService.setAbsence(t.actors.member, absence(t, { delegateUserId: null }));
+    const issue = await issueService.createIssue(t.actors.owner,
+      issueInput(t.org.id, t.project.id, { assigneeId: t.userIds.member }));
+    expect(issue.assigneeId).toBe(t.userIds.member);
+    expect(await notifications(t, t.userIds.member, "issue_assigned")).toHaveLength(1);
+  });
+
+  it("routes overdue alerts at the sweep's instant while leaving its event and issue unchanged", async () => {
+    const t = await tenant();
+    await memberService.setAbsence(t.actors.member, absence(t));
+    const issue = await issueService.createIssue(t.actors.member,

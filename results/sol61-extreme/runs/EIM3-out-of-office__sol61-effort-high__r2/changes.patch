+    await usageRepo.recomputeUsage(t.org.id);
+    resetOverdueTracking();
+    const event = vi.fn();
+    detachers.push(subscribe("issue.overdue", event));
+    vi.setSystemTime(new Date(END));
+    await runOverdueIssueJob(new Date(START));
+    expect(event).toHaveBeenCalledWith(expect.objectContaining({ assigneeId: t.userIds.member }));
+    expect(await notifications(t, t.userIds.admin, "issue_overdue")).toHaveLength(1);
+    expect(await notifications(t, t.userIds.member, "issue_overdue")).toHaveLength(0);

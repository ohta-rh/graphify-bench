+
+/** Consume the invite and admit its recipient together, preserving membership history. */
+export async function acceptInvitationMembership(
+  orgId: OrgId,
+  invitationId: InvitationId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<{ member: Member; joined: boolean }> {
+  return getDb().transaction((tx) => {
+    const invitation = tx.select().from(invitations)
+      .where(and(orgPredicate(invitations.orgId, orgId), eq(invitations.id, invitationId)))
+      .get();
+    if (!invitation) throw new Error(`Invitation ${invitationId} not found`);
+    if (invitation.revokedAt !== null) throw new Error("That invitation has been revoked");
+    if (invitation.acceptedAt !== null) throw new Error("That invitation has already been accepted");
+    if (invitation.expiresAt <= at) throw new Error("That invitation has expired");
+
+    const existing = tx.select().from(members)
+      .where(and(orgPredicate(members.orgId, orgId), eq(members.userId, userId)))
+      .get();
+    const joined = !existing || existing.archivedAt !== null || existing.status !== "active";
+
+    const admission = {
+      role: invitation.role,
+      invitedBy: invitation.invitedBy,
+      status: "active" as const,
+      archivedAt: null,
+      joinedAt: at,
+      updatedAt: at,
+    };
+    const row = existing
+      ? joined
+        ? tx.update(members).set(admission)
+          .where(and(orgPredicate(members.orgId, orgId), eq(members.id, existing.id)))
+          .returning().get()
+        : existing
+      : tx.insert(members).values({
+        id: newId(), orgId, userId, ...admission, lastSeenAt: null, createdAt: at,
+      }).returning().get();
+    if (!row) throw new Error(`Membership for ${userId} could not be admitted`);
+
+    tx.update(invitations).set({ acceptedAt: at, updatedAt: at })
+      .where(and(orgPredicate(invitations.orgId, orgId), eq(invitations.id, invitationId)))
+      .run();
+
+    return { member: toMember(row), joined };
+  });
 }
 

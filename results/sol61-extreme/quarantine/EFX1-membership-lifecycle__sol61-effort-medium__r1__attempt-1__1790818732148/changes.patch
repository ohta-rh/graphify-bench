+/** Restore an archived membership without changing its identity or audit history. */
+export async function restoreMember(
+  orgId: OrgId,
+  userId: UserId,
+  role: Role,
+  invitedBy: UserId,
+): Promise<Member | null> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb().update(members)
+    .set({ archivedAt: null, status: "active", role, invitedBy, joinedAt: stamp, updatedAt: stamp })
+    .where(and(orgPredicate(members.orgId, orgId), eq(members.userId, userId), sql`${members.archivedAt} is not null`))
+    .returning().get();
+  return row ? toMember(row) : null;
+}
+
+export async function findMemberByEmail(orgId: OrgId, email: string): Promise<Member | null> {
+  const row = getDb().select({ member: members }).from(members)
+    .innerJoin(users, eq(users.id, members.userId))
+    .where(and(orgPredicate(members.orgId, orgId), liveMemberPredicate(),
+      sql`lower(${users.email}) = ${email.toLowerCase()}`)).get();
+  return row ? toMember(row.member) : null;
 }

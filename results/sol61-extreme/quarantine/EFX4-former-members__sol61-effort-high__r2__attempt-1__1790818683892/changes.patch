+/** Consume the token and admit its recipient in a single transaction. */
+export async function acceptInvitationForUser(
+  orgId: OrgId,
+  invitationId: InvitationId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<{ member: Member; joined: boolean }> {
+  return getDb().transaction((tx) => {
+    const invitation = tx.update(invitations)
+      .set({ acceptedAt: at, updatedAt: at })
+      .where(and(
+        orgPredicate(invitations.orgId, orgId),
+        eq(invitations.id, invitationId),
+        isNull(invitations.acceptedAt),
+        isNull(invitations.revokedAt),
+        gt(invitations.expiresAt, at),
+      ))
+      .returning()
+      .get();
+    if (!invitation) throw new Error("That invitation is no longer available");
+
+    const scope = and(orgPredicate(members.orgId, orgId), eq(members.userId, userId));
+    const existing = tx.select().from(members).where(scope).get();
+    if (existing && isActiveMember(toMember(existing))) {
+      return { member: toMember(existing), joined: false };
+    }
+
+    const patch = {
+      role: invitation.role,
+      invitedBy: invitation.invitedBy,
+      status: "active" as const,
+      archivedAt: null,
+      joinedAt: at,
+      updatedAt: at,
+    };
+    const row = existing
+      ? tx.update(members).set(patch).where(scope).returning().get()!
+      : tx.insert(members).values({
+          ...patch,
+          id: newId(),
+          orgId,
+          userId,
+          lastSeenAt: null,
+          createdAt: at,
+        }).returning().get();
+
+    return { member: toMember(row), joined: true };
+  });
 }
 

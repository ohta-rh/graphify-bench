+import * as absenceRepo from "@/server/repositories/member-absence-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import type { OrgId, UserId } from "@/types/common";
+
+/** Resolve one hop at the action's instant; scheduled absences do not apply. */
+export async function activeDelegate(
+  orgId: OrgId,
+  userId: UserId,
+  at: Date,
+): Promise<UserId | null> {
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  if (
+    !absence?.delegateUserId ||
+    at.getTime() < Date.parse(absence.startsAt) ||
+    at.getTime() >= Date.parse(absence.endsAt)
+  ) return null;
+
+  const member = await memberRepo.findMember(orgId, userId);
+  const delegate = await memberRepo.findMember(orgId, absence.delegateUserId);
+  return member?.status === "active" && delegate?.status === "active"
+    ? delegate.userId
+    : null;
+}

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { TenantScopeError } from "@/lib/tenant";
+import { setAbsenceSchema } from "@/schemas/member";
+import { toIsoTimestamp } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { NotificationKind } from "@/types/notification";
+import type { TaskflowEventMap } from "@/types/event";
+import * as absenceRepo from "@/server/repositories/member-absence-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as preferenceRepo from "@/server/repositories/notification-preference-repository";
+import { NotFoundError } from "@/server/services/_support";
+import * as memberService from "@/server/services/member-service";
+import * as issueService from "@/server/services/issue-service";
+import { createComment } from "@/server/services/comment-service";
+import { listNotifications } from "@/server/services/notification-service";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import { runOverdueIssueJob, resetOverdueTracking } from "@/server/jobs/overdue-issue-job";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+const START = toIsoTimestamp("2026-10-01T09:00:00Z");
+const END = toIsoTimestamp("2026-10-02T09:00:00Z");
+let cleanup: () => void;
+let tenant: Tenant;
+let sequence = 0;
+
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(new Date(START));
+  tenant = await createTenant(`absence-${++sequence}`);
+  resetOverdueTracking();
+});
+afterEach(() => { vi.useRealTimers(); });
+afterAll(() => { cleanup(); });
+
+function input(overrides: Partial<ReturnType<typeof setAbsenceSchema.parse>> = {}) {
+  return {
+    orgId: tenant.org.id,
+    userId: tenant.userIds.member,
+    delegateUserId: tenant.userIds.viewer,
+    startsAt: START,
+    endsAt: END,
+    note: "On leave",
+    ...overrides,
+  };
+}
+
+async function alerts(actor: Actor, kind: NotificationKind) {
+  return (await listNotifications(actor, {
+    orgId: actor.orgId, recipientId: actor.userId, kind: [kind],
+    unreadOnly: false, limit: 100, cursor: null,
+  })).items;
+}
+
+describe("member absences", () => {
+  it("persists, replaces, reads scheduled absences, expires at the end and clears idempotently", async () => {
+    vi.setSystemTime(new Date(Date.parse(START) - 1));
+    const stored = await memberService.setAbsence(tenant.actors.member, input());
+    expect(stored).toEqual(input());
+    expect(await absenceRepo.findAbsence(tenant.org.id, tenant.userIds.member)).toEqual(stored);
+    expect(await memberService.getAbsence(tenant.actors.viewer, tenant.org.id, tenant.userIds.member)).toEqual(stored);
+    const replacement = input({ delegateUserId: null, note: null });
+    expect(await memberService.setAbsence(tenant.actors.member, replacement)).toEqual(replacement);
+    vi.setSystemTime(new Date(END));
+    expect(await memberService.getAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.member)).toBeNull();
+    await memberService.clearAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.member);
+    await memberService.clearAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.member);
+    expect(await absenceRepo.findAbsence(tenant.org.id, tenant.userIds.member)).toBeNull();
+  });
+
+  it("allows self service for every role and management for actors who can change roles", async () => {
+    await memberService.setAbsence(tenant.actors.viewer, input({ userId: tenant.userIds.viewer, delegateUserId: null }));
+    await expect(memberService.setAbsence(tenant.actors.member, input({ userId: tenant.userIds.admin })))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(memberService.clearAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.viewer))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await memberService.setAbsence(tenant.actors.admin, input());
+    await memberService.clearAbsence(tenant.actors.admin, tenant.org.id, tenant.userIds.member);
+  });
+
+  it("validates the interval, note, delegate and active membership", async () => {
+    for (const endsAt of [START, toIsoTimestamp("2026-09-30T09:00:00Z")]) {
+      await expect(memberService.setAbsence(tenant.actors.member, input({ endsAt }))).rejects.toThrow(/end/);
+    }
+    await expect(memberService.setAbsence(tenant.actors.member, input({ delegateUserId: tenant.userIds.member })))
+      .rejects.toThrow(/themselves/);
+    await expect(memberService.setAbsence(tenant.actors.member, input({ note: "x".repeat(201) }))).rejects.toThrow();
+    const other = await createTenant("absence-outsider");
+    await expect(memberService.setAbsence(tenant.actors.member, input({ delegateUserId: other.userIds.member })))
+      .rejects.toBeInstanceOf(NotFoundError);
+    const member = await memberRepo.findMember(tenant.org.id, tenant.userIds.viewer);
+    await memberService.removeMember(tenant.actors.admin, { orgId: tenant.org.id, memberId: member!.id });
+    await expect(memberService.setAbsence(tenant.actors.member, input())) .rejects.toBeInstanceOf(NotFoundError);
+    for (const userId of [tenant.userIds.viewer, other.userIds.member]) {
+      await expect(memberService.getAbsence(tenant.actors.admin, tenant.org.id, userId)).rejects.toBeInstanceOf(NotFoundError);
+      await expect(memberService.clearAbsence(tenant.actors.admin, tenant.org.id, userId)).rejects.toBeInstanceOf(NotFoundError);
+      await expect(memberService.setAbsence(tenant.actors.admin, input({ userId, delegateUserId: null })))
+        .rejects.toBeInstanceOf(NotFoundError);
+    }
+  });
+
+  it("rejects cross-workspace operations and keeps the same user's workspaces independent", async () => {
+    const other = await createTenant("absence-other");
+    for (const operation of [
+      () => memberService.setAbsence(tenant.actors.member, input({ orgId: other.org.id })),
+      () => memberService.getAbsence(tenant.actors.member, other.org.id, tenant.userIds.member),
+      () => memberService.clearAbsence(tenant.actors.member, other.org.id, tenant.userIds.member),
+    ]) await expect(operation()).rejects.toBeInstanceOf(TenantScopeError);
+    await memberRepo.insertMember(other.org.id, tenant.userIds.member, "member", null);
+    await memberService.setAbsence(tenant.actors.member, input());
+    expect(await memberService.getAbsence(other.actors.viewer, other.org.id, tenant.userIds.member)).toBeNull();
+    const issue = await issueService.createIssue(other.actors.owner,
+      issueInput(other.org.id, other.project.id, { assigneeId: tenant.userIds.member }));
+    expect(issue.assigneeId).toBe(tenant.userIds.member);
+  });
+
+  it("redirects assignment storage, events, audit, alerts and ownership permissions without chaining", async () => {
+    await memberService.setAbsence(tenant.actors.member, input());
+    await memberService.setAbsence(tenant.actors.viewer,
+      input({ userId: tenant.userIds.viewer, delegateUserId: tenant.userIds.admin }));
+    const issue = await issueService.createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id));
+    const seen: TaskflowEventMap["issue.assigned"][] = [];
+    const off = subscribe("issue.assigned", (payload) => { seen.push(payload); });
+    const detachAudit = registerActivityListeners();
+    try {
+      const assigned = await issueService.assignIssue(tenant.actors.owner, {
+        orgId: tenant.org.id, issueId: issue.id, assigneeId: tenant.userIds.member,
+      });
+      expect(assigned.assigneeId).toBe(tenant.userIds.viewer);
+      expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.assigneeId).toBe(tenant.userIds.viewer);
+      expect(seen).toHaveLength(1);
+      expect(seen[0]).toMatchObject({ assigneeId: tenant.userIds.viewer, previousAssigneeId: null });
+      expect(await alerts(tenant.actors.member, "issue_assigned")).toHaveLength(0);
+      expect(await alerts(tenant.actors.viewer, "issue_assigned")).toHaveLength(1);
+      expect(await alerts(tenant.actors.admin, "issue_assigned")).toHaveLength(0);
+      const audit = await listActivity(tenant.actors.owner, {
+        orgId: tenant.org.id, action: ["issue.assigned"], limit: 100, cursor: null,
+      });
+      expect(audit.items[0].summary).toBe(`Assigned to ${tenant.userIds.viewer}`);
+      await issueService.updateIssue(tenant.actors.viewer, { orgId: tenant.org.id, issueId: issue.id, title: "Delegate can edit" });
+    } finally { off(); detachAudit(); }
+  });
+
+  it("redirects creation, preserves self assignments, and leaves existing issues in place after expiry", async () => {
+    await memberService.setAbsence(tenant.actors.member, input());
+    const created = await issueService.createIssue(tenant.actors.owner,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member }));
+    expect(created.assigneeId).toBe(tenant.userIds.viewer);
+    expect(await alerts(tenant.actors.viewer, "issue_assigned")).toHaveLength(1);
+    expect(await alerts(tenant.actors.member, "issue_assigned")).toHaveLength(0);
+    const self = await issueService.createIssue(tenant.actors.member,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member }));
+    expect(self.assigneeId).toBe(tenant.userIds.member);
+    expect((await issueService.assignIssue(tenant.actors.member, {
+      orgId: tenant.org.id, issueId: created.id, assigneeId: tenant.userIds.member,
+    })).assigneeId).toBe(tenant.userIds.member);
+    vi.setSystemTime(new Date(END));
+    expect((await issueRepo.findIssueById(tenant.org.id, self.id))?.assigneeId).toBe(tenant.userIds.member);
+  });
+
+  it.each([
+    ["before the start", -1, false],
+    ["at the start", 0, true],
+    ["just before the end", Date.parse(END) - Date.parse(START) - 1, true],
+    ["at the end", Date.parse(END) - Date.parse(START), false],
+  ])("checks absence bounds %s for assignment", async (_label, offset, away) => {
+    await memberService.setAbsence(tenant.actors.member, input());
+    vi.setSystemTime(new Date(Date.parse(START) + offset));
+    const issue = await issueService.createIssue(tenant.actors.owner,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member }));
+    expect(issue.assigneeId).toBe(away ? tenant.userIds.viewer : tenant.userIds.member);
+  });
+
+  it("routes overdue alerts using the sweep instant without changing the issue", async () => {
+    const issue = await issueService.createIssue(tenant.actors.owner,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member, dueAt: "2026-09-30T09:00:00Z" }));
+    await memberService.setAbsence(tenant.actors.member, input());
+    vi.setSystemTime(new Date(END));
+    await runOverdueIssueJob(new Date(START));
+    expect(await alerts(tenant.actors.member, "issue_overdue")).toHaveLength(0);
+    expect(await alerts(tenant.actors.viewer, "issue_overdue")).toHaveLength(1);
+    expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.assigneeId).toBe(tenant.userIds.member);
+    resetOverdueTracking();
+    await runOverdueIssueJob(new Date(END));
+    expect(await alerts(tenant.actors.member, "issue_overdue")).toHaveLength(1);
+  });
+
+  it("adds one delegate mention alert, honors preferences, excludes authors and does not chain", async () => {
+    await memberService.setAbsence(tenant.actors.member, input());
+    await memberService.setAbsence(tenant.actors.viewer,
+      input({ userId: tenant.userIds.viewer, delegateUserId: tenant.userIds.admin }));
+    await preferenceRepo.upsertPreference({
+      orgId: tenant.org.id, userId: tenant.userIds.viewer, kind: "comment_mention",
+      inApp: true, email: false, digestOnly: false,
+    });
+    const issue = await issueService.createIssue(tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id));
+    const comment = (actor: Actor, mentionedUserIds = [tenant.userIds.member]) => createComment(actor, {
+      orgId: tenant.org.id, issueId: issue.id, body: "Please review", parentId: null, mentionedUserIds,
+    });
+    await comment(tenant.actors.owner);
+    expect(await alerts(tenant.actors.member, "comment_mention")).toHaveLength(1);
+    expect(await alerts(tenant.actors.admin, "comment_mention")).toHaveLength(0);
+    expect((await alerts(tenant.actors.viewer, "comment_mention"))[0].channels).toEqual(["in_app"]);
+    await comment(tenant.actors.owner, [tenant.userIds.member, tenant.userIds.viewer]);
+    expect(await alerts(tenant.actors.viewer, "comment_mention")).toHaveLength(2);
+    await comment(tenant.actors.viewer);
+    expect(await alerts(tenant.actors.viewer, "comment_mention")).toHaveLength(2);
+    await comment(tenant.actors.member);
+    expect(await alerts(tenant.actors.member, "comment_mention")).toHaveLength(3);
+    vi.setSystemTime(new Date(END));
+    await comment(tenant.actors.owner);
+    expect(await alerts(tenant.actors.viewer, "comment_mention")).toHaveLength(3);
+  });
+
+  it("deletes a removed member's absence and drops their delegations without removing the absence", async () => {
+    await memberService.setAbsence(tenant.actors.member, input());
+    await memberService.setAbsence(tenant.actors.viewer,
+      input({ userId: tenant.userIds.viewer, delegateUserId: tenant.userIds.admin }));
+    const delegate = await memberRepo.findMember(tenant.org.id, tenant.userIds.viewer);
+    await memberService.removeMember(tenant.actors.admin, { orgId: tenant.org.id, memberId: delegate!.id });
+    expect(await absenceRepo.findAbsence(tenant.org.id, tenant.userIds.viewer)).toBeNull();
+    expect(await memberService.getAbsence(tenant.actors.member, tenant.org.id, tenant.userIds.member))
+      .toEqual(input({ delegateUserId: null }));
+    const issue = await issueService.createIssue(tenant.actors.owner,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member }));
+    expect(issue.assigneeId).toBe(tenant.userIds.member);
+    expect(await alerts(tenant.actors.member, "issue_assigned")).toHaveLength(1);
+  });
+});

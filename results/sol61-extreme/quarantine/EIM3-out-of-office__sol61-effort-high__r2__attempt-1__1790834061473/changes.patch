+import { and, eq } from "drizzle-orm";
+import { getDb, memberAbsences } from "@/server/db";
+import { orgPredicate } from "./base-repository";
+import type { SetAbsenceInput } from "@/schemas/member";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { MemberAbsence } from "@/types/member";
+
+function toAbsence(row: typeof memberAbsences.$inferSelect): MemberAbsence {
+  return {
+    orgId: row.orgId as OrgId,
+    userId: row.userId as UserId,
+    delegateUserId: row.delegateUserId as UserId | null,
+    startsAt: row.startsAt as IsoTimestamp,
+    endsAt: row.endsAt as IsoTimestamp,
+    note: row.note,
+  };
+}
+
+export async function findAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  const row = getDb()
+    .select()
+    .from(memberAbsences)
+    .where(and(orgPredicate(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .get();
+  return row ? toAbsence(row) : null;
+}
+
+export async function upsertAbsence(input: SetAbsenceInput): Promise<MemberAbsence> {
+  const row = getDb()
+    .insert(memberAbsences)
+    .values(input)
+    .onConflictDoUpdate({
+      target: [memberAbsences.orgId, memberAbsences.userId],
+      set: {
+        delegateUserId: input.delegateUserId,
+        startsAt: input.startsAt,
+        endsAt: input.endsAt,
+        note: input.note,
+      },
+    })
+    .returning()
+    .get();
+  return toAbsence(row);
+}
+
+export async function clearAbsence(orgId: OrgId, userId: UserId): Promise<void> {
+  getDb()
+    .delete(memberAbsences)
+    .where(and(orgPredicate(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .run();
+}

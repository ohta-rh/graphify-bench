@@ -0,0 +1,30 @@
+import { eq } from "drizzle-orm";
+import { comments, getDb, issues, labels, projects } from "@/server/db";
+import type { OrgId } from "@/types/common";
+
+const referenceTables = {
+  Comment: comments,
+  Issue: issues,
+  Label: labels,
+  Project: projects,
+};
+
+export type ReferenceKind = keyof typeof referenceTables;
+
+/**
+ * Ownership-only probe for mutation references. Unlike a resource read, this
+ * must distinguish a foreign id from a missing id. It returns no resource
+ * data; callers must check the owner before performing a scoped read.
+ */
+export async function findReferenceOrgId(
+  kind: ReferenceKind,
+  id: string,
+): Promise<OrgId | null> {
+  const table = referenceTables[kind];
+  const row = getDb()
+    .select({ orgId: table.orgId })
+    .from(table)
+    .where(eq(table.id, id))
+    .get();
+  return row ? (row.orgId as OrgId) : null;
+}

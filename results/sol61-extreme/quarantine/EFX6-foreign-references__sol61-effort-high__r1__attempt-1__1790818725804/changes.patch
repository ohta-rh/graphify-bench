+import { assertOrgScope } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import {
+  findReferenceOrgId,
+  type ReferenceKind,
+} from "@/server/repositories/reference-repository";
+import type { LabelId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import { NotFoundError, requireFound } from "./_support";
+
+export async function assertReferenceScope(
+  actor: Actor,
+  kind: ReferenceKind,
+  id: string,
+): Promise<void> {
+  const orgId = requireFound(await findReferenceOrgId(kind, id), kind, id);
+  assertOrgScope(actor, orgId);
+}
+
+export async function assertLabelsInScope(
+  actor: Actor,
+  labelIds: readonly LabelId[],
+): Promise<void> {
+  for (const id of new Set(labelIds)) {
+    await assertReferenceScope(actor, "Label", id);
+  }
+}
+
+export async function assertCurrentMember(
+  actor: Actor,
+  userId: UserId | null | undefined,
+): Promise<void> {
+  if (userId == null) return;
+  const member = requireFound(
+    await memberRepo.findMember(actor.orgId, userId),
+    "Member",
+    userId,
+  );
+  assertOrgScope(actor, member.orgId);
+  if (member.archivedAt !== null || member.status !== "active") {
+    throw new NotFoundError("Member", userId);
+  }
+}

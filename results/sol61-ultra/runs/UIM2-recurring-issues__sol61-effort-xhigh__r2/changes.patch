+import { createLogger } from "@/lib/logger";
+import { can } from "@/lib/permissions";
+import { isArchived } from "@/lib/soft-delete";
+import { createIssueSchema } from "@/schemas/issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringIssueRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource } from "@/server/services/_support";
+import { createIssue } from "@/server/services/issue-service";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+const logger = createLogger("recurring-issue-job");
+
+// The application has one worker process. Serialize overlapping sweeps so
+// each one reads the previous sweep's persisted occurrence before creating.
+let previousRun: Promise<void> = Promise.resolve();
+
+function latestOccurrence(rule: RecurringIssue, now: Date): string | null {
+  // Read the calendar day in the rule's zone; Intl applies its DST rules.
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: rule.timezone,
+    calendar: "gregory",
+    numberingSystem: "latn",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: string) => parts.find((entry) => entry.type === type)!.value;
+  let day = `${part("year").padStart(4, "0")}-${part("month")}-${part("day")}`;
+  if (rule.cadence === "weekly") {
+    // UTC is used only for calendar arithmetic, never for the zone's midnight.
+    const date = new Date(`${day}T00:00:00.000Z`);
+    const weekday = date.getUTCDay() || 7;
+    const daysBack = (weekday - rule.weekday! + 7) % 7;
+    date.setUTCDate(date.getUTCDate() - daysBack);
+    day = date.toISOString().slice(0, 10);
+  }
+  return day >= rule.startsOn ? day : null;
+}
+
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  const run = previousRun.then(() => runSweep(now));
+  previousRun = run.then(() => undefined, () => undefined);
+  return run;
+}
+
+async function runSweep(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    const rules = await recurringIssueRepo.listActiveRecurringIssuesForJob();
+    for (const rule of rules) {
+      try {
+        const occurrence = latestOccurrence(rule, now);
+        if (occurrence === null || (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn)) {
+          continue;
+        }
+
+        const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+        if (!project || isArchived(project)) continue;
+
+        const creator = await memberRepo.findMember(rule.orgId, rule.createdBy);
+        const actor: Actor | null = creator?.status === "active"
+          ? { orgId: rule.orgId, userId: creator.userId, role: creator.role }
+          : null;
+        if (!actor || !can(actor, "issue:create", projectResource(project))) {
+          await recurringIssueRepo.setRecurringIssuePaused(rule.orgId, rule.id, true);
+          continue;
+        }
+
+        const assignee = rule.assigneeId === null
+          ? null
+          : await memberRepo.findMember(rule.orgId, rule.assigneeId);
+        await createIssue(actor, createIssueSchema.parse({
+          orgId: rule.orgId,
+          projectId: rule.projectId,
+          title: `${rule.title} (${occurrence})`,
+          status: "backlog",
+          priority: rule.priority,
+          assigneeId: assignee?.status === "active" ? assignee.userId : null,
+        }));
+        result.processed += 1;
+        await recurringIssueRepo.setLastOccurrenceOn(rule.orgId, rule.id, occurrence);
+      } catch (error) {
+        result.failed += 1;
+        logger.error("recurring issue failed", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  });
+}

@@ -0,0 +1,102 @@
+import { and, asc, count, eq, sql } from "drizzle-orm";
+import type { z } from "zod";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import type { RecurringIssueRow } from "@/server/db/schema/recurring-issues";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import { orgPredicate } from "./base-repository";
+
+function toRecurringIssue(row: RecurringIssueRow): RecurringIssue {
+  return {
+    ...row,
+    orgId: row.orgId as OrgId,
+    projectId: row.projectId as ProjectId,
+    assigneeId: row.assigneeId as UserId | null,
+    createdBy: row.createdBy as UserId,
+    createdAt: toIsoTimestamp(row.createdAt),
+    updatedAt: toIsoTimestamp(row.updatedAt),
+  };
+}
+
+export async function findRecurringIssueById(
+  orgId: OrgId,
+  recurringIssueId: string,
+): Promise<RecurringIssue | null> {
+  const row = getDb().select().from(recurringIssues).where(and(
+    orgPredicate(recurringIssues.orgId, orgId),
+    eq(recurringIssues.id, recurringIssueId),
+  )).get();
+  return row ? toRecurringIssue(row) : null;
+}
+
+export async function listRecurringIssues(orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    // SQLite rowid preserves insertion order even when timestamps tie.
+    .orderBy(asc(recurringIssues.createdAt), asc(sql`rowid`))
+    .all().map(toRecurringIssue);
+}
+
+/** Global sweep is reserved for the background job; user reads stay scoped. */
+export async function listActiveRecurringIssuesForJob(): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues)
+    .where(eq(recurringIssues.paused, false))
+    .orderBy(asc(sql`rowid`)).all().map(toRecurringIssue);
+}
+
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  return getDb().select({ value: count() }).from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId)).get()?.value ?? 0;
+}
+
+export async function insertRecurringIssue(
+  input: z.output<typeof createRecurringIssueSchema>,
+  createdBy: UserId,
+  limit: number,
+): Promise<RecurringIssue> {
+  // Count and insert together so simultaneous requests cannot exceed the cap.
+  return getDb().transaction((tx) => {
+    const used = tx.select({ value: count() }).from(recurringIssues)
+      .where(orgPredicate(recurringIssues.orgId, input.orgId)).get()?.value ?? 0;
+    if (used + 1 > limit) throw new Error("Recurring issue quota exceeded");
+
+    const stamp = toIsoTimestamp(new Date());
+    const row = tx.insert(recurringIssues).values({
+      ...input,
+      id: newId(),
+      lastOccurrenceOn: null,
+      paused: false,
+      createdBy,
+      createdAt: stamp,
+      updatedAt: stamp,
+    }).returning().get();
+    return toRecurringIssue(row);
+  });
+}
+
+export async function setRecurringIssuePaused(
+  orgId: OrgId,
+  recurringIssueId: string,
+  paused: boolean,
+): Promise<RecurringIssue> {
+  const row = getDb().update(recurringIssues)
+    .set({ paused, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, recurringIssueId)))
+    .returning().get();
+  if (!row) throw new Error(`Recurring issue ${recurringIssueId} not found`);
+  return toRecurringIssue(row);
+}
+
+export async function setLastOccurrenceOn(
+  orgId: OrgId,
+  recurringIssueId: string,
+  occurrenceOn: string,
+): Promise<void> {
+  getDb().update(recurringIssues)
+    .set({ lastOccurrenceOn: occurrenceOn, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, recurringIssueId)))
+    .run();
+}

@@ -0,0 +1,97 @@
+import { emit, subscribe } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { newId } from "@/lib/id";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import * as tokenRepo from "@/server/repositories/api-token-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { toIsoTimestamp } from "@/types/common";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Actor } from "@/types/member";
+import { actorEnvelope, orgResource, requireFound } from "./_support";
+import { resolveActor } from "./member-service";
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  if (parsed.scope === "write") {
+    assertCan(actor, "api_token:create_write", orgResource(parsed.orgId));
+  }
+  const now = new Date();
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await tokenRepo.insertApiToken({
+    id: newId(),
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * 86_400_000)),
+    lastUsedAt: null,
+    revokedAt: null,
+    createdAt: toIsoTimestamp(now),
+  }, hashToken(token));
+  await emit("api_token.created", { ...actorEnvelope(actor), tokenId: apiToken.id });
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) {
+    assertCan(actor, "api_token:manage_others", orgResource(orgId));
+  }
+  return tokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(actor: Actor, orgId: OrgId, tokenId: string): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const current = requireFound(await tokenRepo.findApiToken(orgId, tokenId), "API token", tokenId);
+  if (current.userId !== actor.userId) {
+    assertCan(actor, "api_token:manage_others", orgResource(orgId));
+  }
+  if (current.revokedAt !== null) return current;
+  const revoked = await tokenRepo.revokeApiToken(orgId, tokenId, toIsoTimestamp(new Date()));
+  if (!revoked) {
+    return requireFound(await tokenRepo.findApiToken(orgId, tokenId), "API token", tokenId);
+  }
+  await emit("api_token.revoked", { ...actorEnvelope(actor), tokenId });
+  return revoked;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const apiToken = await tokenRepo.findApiTokenByHash(hashToken(token));
+  if (!apiToken || apiToken.revokedAt !== null || new Date(apiToken.expiresAt).getTime() <= Date.now()) return null;
+  const org = await orgRepo.findOrgById(apiToken.orgId);
+  if (!org || org.archivedAt !== null) return null;
+  const actor = await resolveActor(apiToken.userId, apiToken.orgId);
+  if (!actor) return null;
+  const touched = await tokenRepo.touchApiToken(apiToken.orgId, apiToken.id, toIsoTimestamp(new Date()));
+  if (!touched) return null;
+  return { userId: actor.userId, orgId: actor.orgId, role: apiToken.scope === "read" ? "viewer" : actor.role };
+}
+
+/** Removal revokes even expired tokens, using the remover's event envelope. */
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const revoked = await tokenRepo.revokeUserApiTokens(payload.orgId, payload.userId, payload.occurredAt);
+    for (const apiToken of revoked) {
+      await emit("api_token.revoked", {
+        orgId: payload.orgId,
+        actorId: payload.actorId,
+        occurredAt: payload.occurredAt,
+        tokenId: apiToken.id,
+      });
+    }
+  });
+}

+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { apiTokens, getDb } from "@/server/db";
+import type { ApiTokenRow } from "@/server/db";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { brandId, brandStamp } from "./_mappers";
+
+/** Explicit projection keeps the stored digest out of every domain value. */
+function toApiToken(row: ApiTokenRow): ApiToken {
+  return {
+    id: row.id,
+    orgId: brandId<OrgId>(row.orgId),
+    userId: brandId<UserId>(row.userId),
+    name: row.name,
+    scope: row.scope,
+    prefix: row.prefix,
+    expiresAt: brandStamp(row.expiresAt),
+    lastUsedAt: row.lastUsedAt === null ? null : brandStamp(row.lastUsedAt),
+    revokedAt: row.revokedAt === null ? null : brandStamp(row.revokedAt),
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+export async function insertApiToken(
+  token: ApiToken,
+  tokenHash: string,
+): Promise<ApiToken> {
+  // Count and insert share a write transaction, including across processes.
+  return getDb().transaction((tx) => {
+    const usable = tx.select({ value: count() }).from(apiTokens).where(and(
+      orgPredicate(apiTokens.orgId, token.orgId),
+      eq(apiTokens.userId, token.userId),
+      isNull(apiTokens.revokedAt),
+      gt(apiTokens.expiresAt, token.createdAt),
+    )).get();
+    if ((usable?.value ?? 0) >= 5) throw new Error("API token limit reached");
+    return toApiToken(tx.insert(apiTokens).values({ ...token, tokenHash }).returning().get());
+  }, { behavior: "immediate" });
+}
+
+export async function listApiTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(
+    orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId),
+  )).orderBy(desc(apiTokens.createdAt), desc(apiTokens.id)).all().map(toApiToken);
+}
+
+export async function findApiToken(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(
+    orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, id),
+  )).get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Global lookup is only for authentication before the tenant is known. */
+export async function findApiTokenByHash(tokenHash: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(eq(apiTokens.tokenHash, tokenHash)).get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Returns only newly revoked tokens so callers publish each fact once. */
+export async function revokeApiToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at }).where(and(
+    orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt),
+  )).returning().get();
+  return row ? toApiToken(row) : null;
+}
+
+export async function revokeUserApiTokens(orgId: OrgId, userId: UserId, at: IsoTimestamp): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at }).where(and(
+    orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt),
+  )).returning().all().map(toApiToken);
+}
+
+export async function touchApiToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<boolean> {
+  const row = getDb().update(apiTokens).set({ lastUsedAt: at }).where(and(
+    orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, id),
+    isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, at),
+  )).returning({ id: apiTokens.id }).get();
+  return row !== undefined;
+}

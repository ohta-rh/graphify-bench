+async function reindexSubject(
+  orgId: OrgId,
+  kind: SearchSubjectKind,
+  subjectId: string,
+): Promise<void> {
+  switch (kind) {
+    case "issue": {
+      const issue = await issueRepo.findIssueById(orgId, subjectId as IssueId);
+      if (issue) await indexIssue(orgId, issue);
+      else await searchRepo.deleteIssueSearchDocuments(orgId, subjectId as IssueId);
+      break;
+    }
+    case "comment": {
+      const comment = await commentRepo.findCommentById(orgId, subjectId as CommentId);
+      if (comment) await indexComment(orgId, comment);
+      else await removeFromIndex(orgId, kind, subjectId);
+      break;
+    }
+    case "project": {
+      const project = await projectRepo.findProjectById(orgId, subjectId as ProjectId);
+      if (project) await indexProject(orgId, project);
+      else await searchRepo.deleteProjectSearchDocuments(orgId, subjectId as ProjectId);
+      break;
+    }
+  }
+}
+
+/** Restore the searchable descendants without changing any archive markers. */
+async function reindexProjectContents(orgId: OrgId, projectId: ProjectId): Promise<void> {
+  let issueCursor: string | null = null;
+  do {
+    const issues = await issueRepo.listIssues({
+      orgId,
+      projectId,
+      includeArchived: true,
+      limit: 100,
+      cursor: issueCursor,
+    });
+    for (const issue of issues.items) {
+      await indexIssue(orgId, issue);
+      let commentCursor: string | null = null;
+      do {
+        const comments = await commentRepo.listComments({
+          orgId,
+          issueId: issue.id,
+          includeArchived: true,
+          limit: 100,
+          cursor: commentCursor,
+        });
+        for (const comment of comments.items) await indexComment(orgId, comment);
+        commentCursor = comments.nextCursor;
+      } while (commentCursor !== null);
+    }
+    issueCursor = issues.nextCursor;
+  } while (issueCursor !== null);
 }
 

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { eq } from "drizzle-orm";
+import { ZodError } from "zod";
+import { hashToken } from "@/lib/hash";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as tokens from "@/server/services/api-token-service";
+import { NotFoundError } from "@/server/services/_support";
+import { registerEventHandlers, unregisterEventHandlers } from "@/server/services/event-registry";
+import { removeMember } from "@/server/services/member-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, useTemporaryDatabase } from "./_support/fixtures";
+import type { Tenant } from "./_support/fixtures";
+
+let cleanup: () => void;
+let tenant: Tenant;
+let sequence = 0;
+const NOW = new Date("2026-06-01T12:00:00.000Z");
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  registerEventHandlers();
+});
+
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(NOW);
+  tenant = await createTenant(`api-token-${++sequence}`);
+});
+
+afterEach(() => vi.useRealTimers());
+
+afterAll(() => {
+  unregisterEventHandlers();
+  cleanup();
+});
+
+function input() {
+  return { orgId: tenant.org.id, name: "  CI  ", scope: "read" as const, expiresInDays: 1 };
+}
+
+async function audit() {
+  return activityRepo.listActivity(activityFilterSchema.parse({
+    orgId: tenant.org.id,
+    subjectKind: "api_token",
+    action: ["api_token.created", "api_token.revoked"],
+    limit: 100,
+  }));
+}
+
+describe("personal API tokens", () => {
+  it("returns a secret once, stores its hash, and publishes a safe audit record", async () => {
+    const { token, apiToken } = await tokens.createApiToken(tenant.actors.viewer, input());
+    expect(token).toMatch(/^tfk_[A-Za-z0-9_-]+$/);
+    expect(apiToken).toEqual({
+      id: expect.any(String),
+      orgId: tenant.org.id,
+      userId: tenant.userIds.viewer,
+      name: "CI",
+      scope: "read",
+      prefix: token.slice(0, 12),
+      expiresAt: new Date(NOW.getTime() + DAY_MS).toISOString(),
+      createdAt: NOW.toISOString(),
+      lastUsedAt: null,
+      revokedAt: null,
+    });
+    const stored = getDb().select().from(apiTokens).where(eq(apiTokens.id, apiToken.id)).get();
+    expect(stored?.tokenHash).toBe(hashToken(token));
+    expect(JSON.stringify(stored)).not.toContain(token);
+    const listed = await tokens.listApiTokens(tenant.actors.viewer, tenant.org.id);
+    expect(listed).toEqual([apiToken]);
+    expect(JSON.stringify(listed)).not.toContain(hashToken(token));
+    const events = await audit();
+    expect(events.items).toHaveLength(1);
+    expect(events.items[0]).toMatchObject({
+      action: "api_token.created", actorId: tenant.userIds.viewer,
+      subjectKind: "api_token", subjectId: apiToken.id,
+    });
+    expect(JSON.stringify(events)).not.toContain(token);
+    expect(JSON.stringify(events)).not.toContain(hashToken(token));
+  });
+
+  it("validates before storing and enforces tenant and role permissions", async () => {
+    for (const invalid of [
+      { name: " " }, { name: "x".repeat(81) }, { expiresInDays: 0 },
+      { expiresInDays: 366 }, { expiresInDays: 1.5 },
+    ]) {
+      await expect(tokens.createApiToken(tenant.actors.member, { ...input(), ...invalid }))
+        .rejects.toBeInstanceOf(ZodError);
+    }
+    await expect(tokens.createApiToken(tenant.actors.viewer, { ...input(), scope: "write" }))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    const other = await createTenant(`api-token-foreign-${sequence}`);
+    await expect(tokens.createApiToken(tenant.actors.owner, { ...input(), orgId: other.org.id }))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    expect(await tokens.listApiTokens(tenant.actors.member, tenant.org.id)).toHaveLength(0);
+    expect((await audit()).items).toHaveLength(0);
+
+    const made = await tokens.createApiToken(tenant.actors.member, input());
+    await expect(tokens.listApiTokens(tenant.actors.viewer, tenant.org.id, tenant.userIds.member))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    expect(await tokens.listApiTokens(tenant.actors.admin, tenant.org.id, tenant.userIds.member))
+      .toEqual([made.apiToken]);
+    await expect(tokens.listApiTokens(tenant.actors.owner, other.org.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(tokens.revokeApiToken(tenant.actors.owner, other.org.id, made.apiToken.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(tokens.revokeApiToken(other.actors.owner, other.org.id, made.apiToken.id))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await expect(tokens.revokeApiToken(tenant.actors.viewer, tenant.org.id, made.apiToken.id))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+  });
+
+  it("atomically caps usable tokens per user and lists expired and revoked history newest first", async () => {
+    const attempts = await Promise.allSettled(Array.from({ length: 6 }, (_, i) =>
+      tokens.createApiToken(tenant.actors.member, { ...input(), name: `token ${i}` }),
+    ));
+    expect(attempts.filter((result) => result.status === "fulfilled")).toHaveLength(5);
+    expect(attempts.filter((result) => result.status === "rejected")).toHaveLength(1);
+    const before = await tokens.listApiTokens(tenant.actors.member, tenant.org.id);
+    expect(before.map((token) => token.name)).toEqual(["token 4", "token 3", "token 2", "token 1", "token 0"]);
+    await tokens.createApiToken(tenant.actors.viewer, input());
+    await tokens.revokeApiToken(tenant.actors.member, tenant.org.id, before[0].id);
+    await tokens.createApiToken(tenant.actors.member, input());
+    vi.setSystemTime(new Date(NOW.getTime() + DAY_MS));
+    await tokens.createApiToken(tenant.actors.member, { ...input(), name: "newest" });
+    const after = await tokens.listApiTokens(tenant.actors.member, tenant.org.id);
+    expect(after).toHaveLength(7);
+    expect(after[0].name).toBe("newest");
+    expect(after.find((token) => token.id === before[0].id)?.revokedAt).not.toBeNull();
+  });
+
+  it("uses the current member role for writes, restricts reads, and expires at the exact boundary", async () => {
+    const read = await tokens.createApiToken(tenant.actors.member, input());
+    const write = await tokens.createApiToken(tenant.actors.member, { ...input(), scope: "write" });
+    const member = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    vi.setSystemTime(new Date(NOW.getTime() + 1000));
+    await memberRepo.updateMemberRole(tenant.org.id, member.id, "admin");
+    expect(await tokens.authenticateApiToken(read.token)).toEqual({ ...tenant.actors.member, role: "viewer" });
+    expect(await tokens.authenticateApiToken(write.token)).toEqual({ ...tenant.actors.member, role: "admin" });
+    await memberRepo.updateMemberRole(tenant.org.id, member.id, "viewer");
+    expect(await tokens.authenticateApiToken(write.token)).toEqual({ ...tenant.actors.member, role: "viewer" });
+    const lastUsedAt = new Date().toISOString();
+    vi.setSystemTime(new Date(NOW.getTime() + DAY_MS));
+    expect(await tokens.authenticateApiToken(read.token)).toBeNull();
+    expect(await tokens.authenticateApiToken("unknown")).toBeNull();
+    const listed = await tokens.listApiTokens(tenant.actors.member, tenant.org.id);
+    expect(listed.every((token) => token.lastUsedAt === lastUsedAt)).toBe(true);
+  });
+
+  it("revokes idempotently and audits the person who performed the revocation", async () => {
+    const made = await tokens.createApiToken(tenant.actors.member, input());
+    const revoked = await tokens.revokeApiToken(tenant.actors.admin, tenant.org.id, made.apiToken.id);
+    vi.setSystemTime(new Date(NOW.getTime() + 1000));
+    expect(await tokens.revokeApiToken(tenant.actors.member, tenant.org.id, made.apiToken.id)).toEqual(revoked);
+    expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    const events = (await audit()).items.filter((event) => event.action === "api_token.revoked");
+    expect(events).toHaveLength(1);
+    expect(events[0]).toMatchObject({ actorId: tenant.userIds.admin, subjectId: made.apiToken.id });
+    expect(revoked.revokedAt).toBe(NOW.toISOString());
+    expect(revoked.lastUsedAt).toBeNull();
+  });
+
+  it("fails without writing for suspended members and deleted organizations", async () => {
+    const made = await tokens.createApiToken(tenant.actors.member, input());
+    const member = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    getDb().update(members).set({ status: "suspended" }).where(eq(members.id, member.id)).run();
+    expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    getDb().update(members).set({ status: "active", archivedAt: NOW.toISOString() })
+      .where(eq(members.id, member.id)).run();
+    expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    getDb().update(members).set({ archivedAt: null }).where(eq(members.id, member.id)).run();
+    getDb().update(organizations).set({ archivedAt: NOW.toISOString() })
+      .where(eq(organizations.id, tenant.org.id)).run();
+    expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    getDb().delete(organizations).where(eq(organizations.id, tenant.org.id)).run();
+    expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    expect((await tokens.listApiTokens(tenant.actors.member, tenant.org.id))[0].lastUsedAt).toBeNull();
+  });
+
+  it("revokes active and expired tokens on removal, preserving earlier revocations and other tenants", async () => {
+    const expired = await tokens.createApiToken(tenant.actors.member, input());
+    const active = await tokens.createApiToken(tenant.actors.member, { ...input(), expiresInDays: 2 });
+    const prior = await tokens.createApiToken(tenant.actors.member, input());
+    await tokens.revokeApiToken(tenant.actors.member, tenant.org.id, prior.apiToken.id);
+    const other = await createTenant(`api-token-membership-${sequence}`);
+    await memberRepo.insertMember(other.org.id, tenant.userIds.member, "member", null);
+    const otherActor = { ...tenant.actors.member, orgId: other.org.id };
+    const otherToken = await tokens.createApiToken(otherActor, { ...input(), orgId: other.org.id, expiresInDays: 2 });
+    vi.setSystemTime(new Date(NOW.getTime() + DAY_MS));
+    const removedAt = toIsoTimestamp(new Date());
+    const member = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    await removeMember(tenant.actors.admin, { orgId: tenant.org.id, memberId: member.id });
+    const listed = await tokens.listApiTokens(tenant.actors.admin, tenant.org.id, tenant.userIds.member);
+    expect(listed.find((token) => token.id === prior.apiToken.id)?.revokedAt).toBe(NOW.toISOString());
+    for (const made of [expired, active]) {
+      expect(listed.find((token) => token.id === made.apiToken.id)?.revokedAt).toBe(removedAt);
+      expect(await tokens.authenticateApiToken(made.token)).toBeNull();
+    }
+    expect(await tokens.authenticateApiToken(otherToken.token)).toEqual({ ...otherActor, role: "viewer" });
+    const revocations = (await audit()).items.filter((event) => event.action === "api_token.revoked");
+    expect(revocations).toHaveLength(3);
+    expect(revocations.filter((event) => event.actorId === tenant.userIds.admin)).toHaveLength(2);
+  });
+});

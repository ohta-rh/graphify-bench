+import type { IsoTimestamp, OrgId, UserId } from "./common";
+
+export type ApiTokenScope = "read" | "write";
+
+/** Public token metadata. Secrets and their hashes stay outside this type. */
+export interface ApiToken {
+  id: string;
+  orgId: OrgId;
+  userId: UserId;
+  name: string;
+  scope: ApiTokenScope;
+  prefix: string;
+  expiresAt: IsoTimestamp;
+  lastUsedAt: IsoTimestamp | null;
+  revokedAt: IsoTimestamp | null;
+  createdAt: IsoTimestamp;
+}

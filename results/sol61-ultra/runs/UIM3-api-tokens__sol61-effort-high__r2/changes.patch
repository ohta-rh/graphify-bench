+import { emit } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { newId } from "@/lib/id";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import type { ApiToken } from "@/types/api-token";
+import { toIsoTimestamp } from "@/types/common";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { PermissionAction } from "@/types/permission";
+import { orgResource, requireFound } from "./_support";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  assertTokenPermission(actor, parsed.scope === "write" ? "api_token:create_write" : "api_token:create");
+
+  const now = new Date();
+  const createdAt = toIsoTimestamp(now);
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await apiTokenRepo.insertApiToken({
+    id: newId(),
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * DAY_MS)),
+    lastUsedAt: null,
+    revokedAt: null,
+    createdAt,
+  }, hashToken(token));
+
+  await emit("api_token.created", {
+    orgId: apiToken.orgId,
+    actorId: actor.userId,
+    occurredAt: createdAt,
+    tokenId: apiToken.id,
+  });
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) assertTokenPermission(actor, "api_token:manage_others");
+  return apiTokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const current = requireFound(await apiTokenRepo.findApiToken(orgId, tokenId), "API token", tokenId);
+  if (current.userId !== actor.userId) assertTokenPermission(actor, "api_token:manage_others");
+
+  const now = toIsoTimestamp(new Date());
+  const result = requireFound(await apiTokenRepo.revokeApiToken(orgId, tokenId, now), "API token", tokenId);
+  if (result.revoked) {
+    await emit("api_token.revoked", {
+      orgId,
+      actorId: actor.userId,
+      occurredAt: now,
+      tokenId,
+    });
+  }
+  return result.apiToken;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const result = await apiTokenRepo.useApiToken(hashToken(token), toIsoTimestamp(new Date()));
+  if (!result) return null;
+  return {
+    userId: result.apiToken.userId,
+    orgId: result.apiToken.orgId,
+    role: result.apiToken.scope === "read" ? "viewer" : result.role,
+  };
+}
+
+function assertTokenPermission(actor: Actor, action: PermissionAction): void {
+  // Personal credentials are bounded by the member's role, including for staff.
+  assertCan({ userId: actor.userId, orgId: actor.orgId, role: actor.role }, action, orgResource(actor.orgId));
+}

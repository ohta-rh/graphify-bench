+import { emit, subscribe } from "@/lib/event-bus";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import type { Unsubscribe } from "@/types/event";
+
+/** Removal revokes every outstanding credential, with the remover as audit actor. */
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const revoked = await apiTokenRepo.revokeUserApiTokens(
+      payload.orgId,
+      payload.userId,
+      payload.occurredAt,
+    );
+    for (const apiToken of revoked) {
+      await emit("api_token.revoked", {
+        orgId: payload.orgId,
+        actorId: payload.actorId,
+        occurredAt: payload.occurredAt,
+        tokenId: apiToken.id,
+      });
+    }
+  });
+}

@@ -0,0 +1,132 @@
+import { and, count, desc, eq, gt, isNull, sql } from "drizzle-orm";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import { toApiToken } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+
+const MAX_USABLE_TOKENS = 5;
+
+/** Count and insert share a write transaction so concurrent creates cannot exceed the cap. */
+export async function insertApiToken(
+  apiToken: ApiToken,
+  tokenHash: string,
+): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const used = tx
+      .select({ value: count() })
+      .from(apiTokens)
+      .where(and(
+        orgPredicate(apiTokens.orgId, apiToken.orgId),
+        eq(apiTokens.userId, apiToken.userId),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, apiToken.createdAt),
+      ))
+      .get();
+
+    if ((used?.value ?? 0) >= MAX_USABLE_TOKENS) {
+      throw new Error("A user may hold at most 5 usable API tokens per organization");
+    }
+
+    const row = tx.insert(apiTokens)
+      .values({ ...apiToken, tokenHash })
+      .returning()
+      .get();
+    return toApiToken(row);
+  }, { behavior: "immediate" });
+}
+
+export async function listApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), sql`${apiTokens}.rowid desc`)
+    .all()
+    .map(toApiToken);
+}
+
+export async function findApiToken(
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Returns whether this call changed the row, so repeat revokes emit no event. */
+export async function revokeApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  revokedAt: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; revoked: boolean } | null> {
+  return getDb().transaction((tx) => {
+    const predicate = and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId));
+    const changed = tx.update(apiTokens)
+      .set({ revokedAt })
+      .where(and(predicate, isNull(apiTokens.revokedAt)))
+      .returning()
+      .get();
+    if (changed) return { apiToken: toApiToken(changed), revoked: true };
+
+    const current = tx.select().from(apiTokens).where(predicate).get();
+    return current ? { apiToken: toApiToken(current), revoked: false } : null;
+  }, { behavior: "immediate" });
+}
+
+/** Expired tokens are revoked too; only previously revoked rows are excluded. */
+export async function revokeUserApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+  revokedAt: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens)
+    .set({ revokedAt })
+    .where(and(
+      orgPredicate(apiTokens.orgId, orgId),
+      eq(apiTokens.userId, userId),
+      isNull(apiTokens.revokedAt),
+    ))
+    .returning()
+    .all()
+    .map(toApiToken);
+}
+
+/** Membership checks and last-use writes share a transaction; failed auth writes nothing. */
+export async function useApiToken(
+  tokenHash: string,
+  now: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; role: Role } | null> {
+  return getDb().transaction((tx) => {
+    const row = tx.select({ token: apiTokens, role: members.role })
+      .from(apiTokens)
+      .innerJoin(members, and(
+        eq(members.orgId, apiTokens.orgId),
+        eq(members.userId, apiTokens.userId),
+      ))
+      .innerJoin(organizations, eq(organizations.id, apiTokens.orgId))
+      .where(and(
+        eq(apiTokens.tokenHash, tokenHash),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, now),
+        eq(members.status, "active"),
+        livePredicate(members.archivedAt, {}),
+        livePredicate(organizations.archivedAt, {}),
+      ))
+      .get();
+    if (!row) return null;
+
+    const apiToken = toApiToken(row.token);
+    tx.update(apiTokens).set({ lastUsedAt: now })
+      .where(and(
+        orgPredicate(apiTokens.orgId, apiToken.orgId),
+        eq(apiTokens.id, apiToken.id),
+      ))
+      .run();
+    return { apiToken: { ...apiToken, lastUsedAt: now }, role: row.role };
+  }, { behavior: "immediate" });
+}

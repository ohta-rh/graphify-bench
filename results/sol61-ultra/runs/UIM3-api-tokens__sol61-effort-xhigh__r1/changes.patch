+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as apiTokenService from "@/server/services/api-token-service";
+import { registerEventHandlers, unregisterEventHandlers } from "@/server/services/event-registry";
+import * as memberService from "@/server/services/member-service";
+import * as organizationService from "@/server/services/organization-service";
+import { NotFoundError } from "@/server/services/_support";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { IsoTimestamp } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Actor } from "@/types/member";
+import type { Tenant } from "../server/_support/fixtures";
+
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+const START = new Date("2030-01-01T00:00:00.000Z");
+const DAY = 24 * 60 * 60 * 1000;
+let cleanup: () => void;
+let tenant: Tenant;
+let sequence = 0;
+let handlerErrors: unknown[];
+const detachers: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+});
+
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(START);
+  tenant = await createTenant(`api-tokens-${++sequence}`);
+  handlerErrors = [];
+  detachers.push(onHandlerError((_type, error) => handlerErrors.push(error)));
+  registerEventHandlers();
+});
+
+afterEach(() => {
+  unregisterEventHandlers();
+  while (detachers.length) detachers.pop()?.();
+  vi.useRealTimers();
+  expect(handlerErrors).toEqual([]);
+});
+
+afterAll(() => cleanup());
+
+function create(actor: Actor = tenant.actors.member, overrides: Partial<CreateApiTokenInput> = {}) {
+  return apiTokenService.createApiToken(actor, {
+    orgId: actor.orgId,
+    name: "CI",
+    scope: "read",
+    expiresInDays: 1,
+    ...overrides,
+  });
+}
+
+function tokenAudit(tokenId: string) {
+  return activityRepo.listActivityForSubject(tenant.org.id, "api_token", tokenId);
+}
+
+describe("personal API tokens", () => {
+  it("returns the secret once, persists only its hash, and audits public facts", async () => {
+    const seen: unknown[] = [];
+    detachers.push(subscribe("api_token.created", (payload) => { seen.push(payload); }));
+    const { token, apiToken } = await create(tenant.actors.viewer, {
+      name: "  build pipeline  ",
+      expiresInDays: 365,
+    });
+
+    expect(token).toMatch(/^tfk_[A-Za-z0-9_-]+$/);
+    expect(apiToken).toEqual({
+      id: expect.any(String),
+      orgId: tenant.org.id,
+      userId: tenant.userIds.viewer,
+      name: "build pipeline",
+      scope: "read",
+      prefix: token.slice(0, 12),
+      createdAt: START.toISOString(),
+      expiresAt: new Date(START.getTime() + 365 * DAY).toISOString(),
+      lastUsedAt: null,
+      revokedAt: null,
+    });
+    const stored = getDb().select().from(apiTokens).where(eq(apiTokens.id, apiToken.id)).get();
+    expect(stored?.tokenHash).toBe(hashToken(token));
+    expect(JSON.stringify(stored)).not.toContain(token);
+    expect(await apiTokenService.listApiTokens(tenant.actors.viewer, tenant.org.id)).toEqual([apiToken]);
+    expect(JSON.stringify(apiToken)).not.toContain(hashToken(token));
+
+    expect(seen).toHaveLength(1);
+    expect(seen[0]).toMatchObject({ tokenId: apiToken.id, actorId: tenant.userIds.viewer });
+    const audit = await tokenAudit(apiToken.id);
+    expect(audit).toHaveLength(1);
+    expect(audit[0]).toMatchObject({
+      action: "api_token.created",
+      actorId: tenant.userIds.viewer,
+      subjectKind: "api_token",
+      subjectId: apiToken.id,
+    });
+    for (const value of [seen, audit]) {
+      expect(JSON.stringify(value)).not.toContain(token);
+      expect(JSON.stringify(value)).not.toContain(hashToken(token));
+    }
+    const filter = activityFilterSchema.parse({
+      orgId: tenant.org.id,
+      action: ["api_token.created", "api_token.revoked"],
+      subjectKind: "api_token",
+    });
+    expect((await activityRepo.listActivity(filter)).items).toEqual(audit);
+  });
+
+  it("rejects invalid input with ZodError without storage or events", async () => {
+    const invalid: Record<string, unknown>[] = [
+      { name: "   " }, { name: "x".repeat(81) }, { scope: "admin" },
+      { expiresInDays: 0 }, { expiresInDays: 366 }, { expiresInDays: 1.5 },
+      { expiresInDays: "1" }, { orgId: "invalid" },
+    ];
+    const seen: unknown[] = [];
+    detachers.push(subscribe("api_token.created", (payload) => { seen.push(payload); }));
+    for (const overrides of invalid) {
+      await expect(create(tenant.actors.member, overrides as Partial<CreateApiTokenInput>))
+        .rejects.toBeInstanceOf(ZodError);
+    }
+    expect(await apiTokenService.listApiTokens(tenant.actors.member, tenant.org.id)).toEqual([]);
+    expect(seen).toEqual([]);
+  });
+
+  it("enforces tenant, write-scope, and token ownership permissions", async () => {
+    const other = await createTenant(`api-other-${++sequence}`);
+    await expect(create(tenant.actors.viewer, { scope: "write" }))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(create(tenant.actors.viewer, { orgId: other.org.id }))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    const { apiToken } = await create(tenant.actors.viewer);
+    await expect(apiTokenService.listApiTokens(tenant.actors.member, tenant.org.id, tenant.userIds.viewer))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    for (const actor of [tenant.actors.admin, tenant.actors.owner]) {
+      expect(await apiTokenService.listApiTokens(actor, tenant.org.id, tenant.userIds.viewer)).toEqual([apiToken]);
+    }
+    await expect(apiTokenService.listApiTokens(tenant.actors.owner, other.org.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(apiTokenService.revokeApiToken(tenant.actors.member, tenant.org.id, apiToken.id))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(apiTokenService.revokeApiToken(tenant.actors.owner, other.org.id, apiToken.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(apiTokenService.revokeApiToken(other.actors.owner, other.org.id, apiToken.id))
+      .rejects.toBeInstanceOf(NotFoundError);
+    const revoked = await apiTokenService.revokeApiToken(tenant.actors.admin, tenant.org.id, apiToken.id);
+    expect(revoked.revokedAt).toBe(START.toISOString());
+    expect((await tokenAudit(apiToken.id)).find((row) => row.action === "api_token.revoked")?.actorId)
+      .toBe(tenant.userIds.admin);
+    for (const actor of [tenant.actors.member, tenant.actors.admin, tenant.actors.owner]) {
+      expect((await create(actor, { scope: "write" })).apiToken.scope).toBe("write");
+    }
+  });
+
+  it("enforces a concurrent usable-token quota separately per user", async () => {
+    const attempts = await Promise.allSettled(Array.from({ length: 6 }, (_, i) => create(undefined, { name: `CI ${i}` })));
+    expect(attempts.filter((result) => result.status === "fulfilled")).toHaveLength(5);
+    expect(attempts.filter((result) => result.status === "rejected")).toHaveLength(1);
+    const original = await apiTokenService.listApiTokens(tenant.actors.member, tenant.org.id);
+    expect(original).toHaveLength(5);
+    expect(original.map((row) => row.name)).toEqual(["CI 4", "CI 3", "CI 2", "CI 1", "CI 0"]);
+    expect((await create(tenant.actors.viewer)).apiToken.userId).toBe(tenant.userIds.viewer);
+
+    await apiTokenService.revokeApiToken(tenant.actors.member, tenant.org.id, original[0].id);
+    await create(undefined, { name: "Replacement" });
+    expect(await apiTokenService.listApiTokens(tenant.actors.member, tenant.org.id)).toHaveLength(6);
+    vi.setSystemTime(new Date(START.getTime() + DAY));
+    await create(undefined, { name: "After expiry" });
+    const all = await apiTokenService.listApiTokens(tenant.actors.member, tenant.org.id);
+    expect(all).toHaveLength(7);
+    expect(all[0].name).toBe("After expiry");
+    expect(all.filter((row) => row.revokedAt !== null)).toHaveLength(1);
+  });
+
+  it("uses current membership roles, limits reads, and stops at exact expiry", async () => {
+    const read = await create(tenant.actors.owner);
+    const write = await create(tenant.actors.member, { scope: "write" });
+    vi.setSystemTime(new Date(START.getTime() + 1000));
+    expect(await apiTokenService.authenticateApiToken(read.token)).toEqual({ ...tenant.actors.owner, role: "viewer" });
+    expect(await apiTokenService.authenticateApiToken(write.token)).toEqual(tenant.actors.member);
+    const member = await memberRepo.findMember(tenant.org.id, tenant.userIds.member);

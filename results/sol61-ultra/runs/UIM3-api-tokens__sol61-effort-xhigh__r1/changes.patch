+import { toIsoTimestamp } from "@/types/common";
+import { envelope, requireFound } from "./_support";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { PermissionAction } from "@/types/permission";
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  assertTokenPermission(
+    actor,
+    parsed.scope === "write" ? "api_token:create_write" : "api_token:create_read",
+    actor.userId,
+  );
+
+  const now = new Date();
+  const createdAt = toIsoTimestamp(now);
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await apiTokenRepo.insertApiToken({
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * 24 * 60 * 60 * 1000)),
+    lastUsedAt: null,
+    revokedAt: null,
+    createdAt,
+  }, hashToken(token));
+
+  await emit("api_token.created", {
+    ...envelope(apiToken.orgId, actor.userId),
+    occurredAt: createdAt,
+    tokenId: apiToken.id,
+    userId: apiToken.userId,
+  });
+
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  assertTokenPermission(actor, "api_token:read", userId);
+  return apiTokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const current = requireFound(
+    await apiTokenRepo.findApiTokenById(orgId, tokenId),
+    "API token",
+    tokenId,
+  );
+  assertTokenPermission(actor, "api_token:revoke", current.userId);
+  if (current.revokedAt !== null) return current;
+
+  const now = toIsoTimestamp(new Date());
+  const revoked = await apiTokenRepo.revokeApiToken(orgId, tokenId, now);
+  if (!revoked) {
+    // A concurrent revocation won; preserve its timestamp and audit event.
+    return requireFound(await apiTokenRepo.findApiTokenById(orgId, tokenId), "API token", tokenId);
+  }
+
+  await emit("api_token.revoked", {
+    ...envelope(orgId, actor.userId),
+    occurredAt: now,
+    tokenId: revoked.id,
+    userId: revoked.userId,
+  });
+  return revoked;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const result = await apiTokenRepo.useApiToken(hashToken(token), toIsoTimestamp(new Date()));
+  if (!result) return null;
+
+  return {
+    userId: result.apiToken.userId,
+    orgId: result.apiToken.orgId,
+    role: result.apiToken.scope === "read" ? "viewer" : result.role,
+  };
+}
+
+function assertTokenPermission(actor: Actor, action: PermissionAction, userId: UserId): void {
+  // Personal tokens delegate membership privileges, without a staff bypass.
+  assertCan({ userId: actor.userId, orgId: actor.orgId, role: actor.role }, action, {
+    kind: "api_token",
+    orgId: actor.orgId,
+    userId,
+  });
+}

+/**
+ * Purges the entire expired set in one transaction. Subqueries avoid both
+ * listing limits and SQLite's limit on the number of bound issue ids.
+ */
+export async function purgeArchivedIssuesBefore(
+  orgId: OrgId,
+  cutoff: IsoTimestamp,
+): Promise<number> {
+  return getDb().transaction((tx) => {
+    const expired = and(
+      orgPredicate(issues.orgId, orgId),
+      isNotNull(issues.archivedAt),
+      lte(issues.archivedAt, cutoff),
+    );
+    const expiredIds = tx.select({ id: issues.id }).from(issues).where(expired);
+
+    const numbers = tx
+      .select({
+        projectId: issues.projectId,
+        lastNumber: sql<number>`max(${issues.number})`,
+      })
+      .from(issues)
+      .where(expired)
+      .groupBy(issues.projectId)
+      .all();
+
+    if (numbers.length === 0) return 0;
+
+    for (const number of numbers) {
+      tx.insert(issueNumberCounters)
+        .values({ orgId, ...number })
+        .onConflictDoUpdate({
+          target: [issueNumberCounters.orgId, issueNumberCounters.projectId],
+          set: {
+            lastNumber: sql`max(${issueNumberCounters.lastNumber}, ${number.lastNumber})`,
+          },
+        })
+        .run();
+    }
+
+    const expiredAttachments = and(
+      orgPredicate(attachments.orgId, orgId),
+      inArray(attachments.issueId, expiredIds),
+    );
+    const storage = tx
+      .select({
+        value: sql<number | null>`sum((${attachments.sizeBytes} + ${BYTES_PER_MB - 1}) / ${BYTES_PER_MB})`,
+      })
+      .from(attachments)
+      .where(expiredAttachments)
+      .get();
+
+    const expiredComments = and(
+      orgPredicate(comments.orgId, orgId),
+      inArray(comments.issueId, expiredIds),
+    );
+    const commentIds = tx
+      .select({ id: comments.id })
+      .from(comments)
+      .where(expiredComments);
+
+    tx.delete(searchIndex)
+      .where(
+        and(
+          orgPredicate(searchIndex.orgId, orgId),
+          or(
+            and(
+              eq(searchIndex.subjectKind, "issue"),
+              inArray(searchIndex.subjectId, expiredIds),
+            ),
+            and(
+              eq(searchIndex.subjectKind, "comment"),
+              inArray(searchIndex.subjectId, commentIds),
+            ),
+          ),
+        ),
+      )
+      .run();
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          inArray(issueLabels.issueId, expiredIds),
+        ),
+      )
+      .run();
+    tx.delete(comments).where(expiredComments).run();
+    tx.delete(attachments).where(expiredAttachments).run();
+    tx.update(organizationUsage)
+      .set({
+        storageMbUsed: sql`${organizationUsage.storageMbUsed} - ${storage?.value ?? 0}`,
+        measuredAt: toIsoTimestamp(new Date()),
+      })
+      .where(eq(organizationUsage.orgId, orgId))
+      .run();
+
+    return tx.delete(issues).where(expired).run().changes;
+  });
+}

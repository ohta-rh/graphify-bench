+
+function archiveAt(issueId: IssueId, at: Date) {
+  getDb().update(issues)
+    .set({ archivedAt: toIsoTimestamp(at) })
+    .where(and(eq(issues.orgId, tenant.org.id), eq(issues.id, issueId)))
+    .run();
+}

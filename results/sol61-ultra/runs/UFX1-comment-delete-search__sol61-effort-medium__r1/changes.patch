+
+/** Remove every comment document belonging to this issue, including replies. */
+export async function deleteIssueCommentDocuments(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        inArray(
+          searchIndex.subjectId,
+          db.select({ id: comments.id })
+            .from(comments)
+            .where(
+              and(
+                orgPredicate(comments.orgId, orgId),
+                eq(comments.issueId, issueId),
+              ),
+            ),
+        ),
+      ),
+    )
+    .run();
+}
+
+/** Discard stale documents before rebuilding one workspace's live content. */
+export async function clearSearchDocuments(orgId: OrgId): Promise<void> {
+  getDb()
+    .delete(searchIndex)
+    .where(orgPredicate(searchIndex.orgId, orgId))
     .run();
 }
 

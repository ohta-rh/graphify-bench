+import { createLogger } from "@/lib/logger";
+import { can } from "@/lib/permissions";
+import { createIssueSchema } from "@/schemas/issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource } from "@/server/services/_support";
+import { createIssue } from "@/server/services/issue-service";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+const logger = createLogger("recurring-issue-job");
+
+function latestOccurrence(rule: RecurringIssue, now: Date): string | null {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: rule.timezone,
+    calendar: "iso8601",
+    numberingSystem: "latn",
+    year: "numeric", month: "2-digit", day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: string) => parts.find((p) => p.type === type)!.value;
+  const today = `${part("year").padStart(4, "0")}-${part("month")}-${part("day")}`;
+  let occurrence = today;
+  if (rule.cadence === "weekly") {
+    // UTC is used only for arithmetic on calendar dates, never for zone boundaries.
+    const date = new Date(`${today}T00:00:00.000Z`);
+    const weekday = date.getUTCDay() || 7;
+    date.setUTCDate(date.getUTCDate() - (weekday - rule.weekday! + 7) % 7);
+    occurrence = date.toISOString().slice(0, 10);
+  }
+  return occurrence >= rule.startsOn ? occurrence : null;
+}
+
+// The app has one writer process. Serialize sweeps so overlapping runs cannot
+// both create an issue before the first advances lastOccurrenceOn.
+let previousRun: Promise<unknown> = Promise.resolve();
+
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  const clock = new Date(now.getTime());
+  const run = previousRun.then(() => runJob("recurring-issues", async (result) => {
+    const rules = await recurringRepo.listUnpausedRecurringIssues();
+    for (const rule of rules) {
+      try {
+        const occurrence = latestOccurrence(rule, clock);
+        if (occurrence === null ||
+            (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn)) continue;
+
+        const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+        if (!project || project.archivedAt !== null) continue;
+
+        const creator = await memberRepo.findMember(rule.orgId, rule.createdBy);
+        const actor: Actor | null = creator?.status === "active"
+          ? { orgId: rule.orgId, userId: creator.userId, role: creator.role }
+          : null;
+        if (!actor || !can(actor, "issue:create", projectResource(project))) {
+          await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+
+        const assignee = rule.assigneeId === null ? null
+          : await memberRepo.findMember(rule.orgId, rule.assigneeId);
+        await createIssue(actor, createIssueSchema.parse({
+          orgId: rule.orgId,
+          projectId: rule.projectId,
+          title: `${rule.title} (${occurrence})`,
+          status: "backlog",
+          priority: rule.priority,
+          assigneeId: assignee?.status === "active" ? assignee.userId : null,
+        }));
+        result.processed += 1;
+        await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { lastOccurrenceOn: occurrence });
+      } catch (error) {
+        result.failed += 1;
+        logger.error("failed to file recurring issue", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  }));
+  previousRun = run.catch(() => undefined);
+  return run;
+}

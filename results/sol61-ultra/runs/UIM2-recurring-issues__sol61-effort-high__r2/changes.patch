@@ -0,0 +1,164 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { ZodError } from "zod";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import { getDb, recurringIssues } from "@/server/db";
+import { drain, enqueue, resetQueue } from "@/server/jobs/queue";
+import { runRecurringIssueJob } from "@/server/jobs/recurring-issue-job";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { createRecurringIssue, listRecurringIssues, setRecurringIssuePaused } from "@/server/services/recurring-issue-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+beforeEach(() => { getDb().delete(recurringIssues).run(); resetQueue(); });
+afterAll(() => { cleanup(); });
+
+function input(tenant: Tenant) {
+  return {
+    orgId: tenant.org.id,
+    projectId: tenant.project.id,
+    title: "Daily triage",
+    cadence: "daily" as const,
+    timezone: "UTC",
+    startsOn: "2026-03-01",
+  };
+}
+
+describe("recurring issues", () => {
+  it("validates calendar dates, zones and cadence before storing anything", async () => {
+    const tenant = await createTenant("recurring-validation");
+    for (const patch of [
+      { startsOn: "2026-02-30" }, { startsOn: "2026-2-01" },
+      { startsOn: "2025-02-29" }, { timezone: "Unknown/Zone" },
+      { cadence: "weekly" as const }, { weekday: 1 },
+    ]) {
+      await expect(createRecurringIssue(tenant.actors.member, { ...input(tenant), ...patch }))
+        .rejects.toBeInstanceOf(ZodError);
+    }
+    expect(createRecurringIssueSchema.safeParse({ ...input(tenant), startsOn: "2024-02-29" }).success).toBe(true);
+    expect(await listRecurringIssues(tenant.actors.viewer, tenant.org.id)).toEqual([]);
+  });
+
+  it("enforces tenant scope, project state, permissions and active assignees", async () => {
+    const tenant = await createTenant("recurring-scope");
+    const other = await createTenant("recurring-other");
+    await expect(createRecurringIssue(tenant.actors.member, input(other))).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(createRecurringIssue(tenant.actors.member, { ...input(tenant), projectId: other.project.id }))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await expect(createRecurringIssue(tenant.actors.viewer, input(tenant))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(createRecurringIssue(tenant.actors.member, { ...input(tenant), assigneeId: other.userIds.member }))
+      .rejects.toThrow();
+    const rule = await createRecurringIssue(tenant.actors.member, input(tenant));
+    expect(rule).toMatchObject({ paused: false, lastOccurrenceOn: null, createdBy: tenant.userIds.member, priority: "none", assigneeId: null });
+    await expect(setRecurringIssuePaused(other.actors.member, { orgId: other.org.id, recurringIssueId: rule.id, paused: true }))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await expect(setRecurringIssuePaused(tenant.actors.viewer, { orgId: tenant.org.id, recurringIssueId: rule.id, paused: true }))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(listRecurringIssues(tenant.actors.member, other.org.id)).rejects.toBeInstanceOf(TenantScopeError);
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(createRecurringIssue(tenant.actors.member, input(tenant))).rejects.toBeInstanceOf(AlreadyArchivedError);
+  });
+
+  it("counts paused rules toward the quota and preserves creation order", async () => {
+    const free = await createTenant("recurring-free", "free");
+    await expect(createRecurringIssue(free.actors.member, input(free))).rejects.toThrow();
+    const tenant = await createTenant("recurring-starter", "starter");
+    const rules = [];
+    for (let i = 0; i < 3; i++) {
+      const rule = await createRecurringIssue(tenant.actors.member, input(tenant));
+      rules.push(rule.id);
+      await setRecurringIssuePaused(tenant.actors.member, { orgId: tenant.org.id, recurringIssueId: rule.id, paused: true });
+    }
+    await expect(createRecurringIssue(tenant.actors.member, input(tenant))).rejects.toThrow();
+    expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id)).map((rule) => rule.id)).toEqual(rules);
+  });
+
+  it("uses local midnight across DST, skips missed days, and emits ordinary issue events", async () => {
+    const tenant = await createTenant("recurring-dst");
+    const rule = await createRecurringIssue(tenant.actors.member, {
+      ...input(tenant), timezone: "America/New_York", assigneeId: tenant.userIds.admin, priority: "high",
+    });
+    const seen: unknown[] = [];
+    const off = subscribe("issue.created", (event) => { seen.push(event); });
+    try {
+      expect((await runRecurringIssueJob(new Date("2026-03-08T04:59:59Z"))).processed).toBe(1);
+      expect((await runRecurringIssueJob(new Date("2026-03-08T05:00:00Z"))).processed).toBe(1);
+      expect((await runRecurringIssueJob(new Date("2026-03-09T03:59:59Z"))).processed).toBe(0);
+      const results = await Promise.all([
+        runRecurringIssueJob(new Date("2026-03-09T04:00:00Z")),
+        runRecurringIssueJob(new Date("2026-03-09T04:00:00Z")),
+      ]);
+      expect(results.map((result) => result.processed)).toEqual([1, 0]);
+      expect(seen).toHaveLength(3);
+      expect(seen[2]).toMatchObject({ actorId: tenant.userIds.member, title: "Daily triage (2026-03-09)" });
+      const issues = await issueRepo.listIssues({ orgId: tenant.org.id, limit: 100 });
+      expect(issues.items.map((issue) => issue.title).sort()).toEqual([
+        "Daily triage (2026-03-07)", "Daily triage (2026-03-08)", "Daily triage (2026-03-09)",
+      ]);
+      expect(issues.items[0]).toMatchObject({ status: "backlog", priority: "high", assigneeId: tenant.userIds.admin, description: null, dueAt: null, labelIds: [] });
+      expect((await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id))?.lastOccurrenceOn).toBe("2026-03-09");
+    } finally { off(); }
+  });
+
+  it("waits for the first weekly occurrence and chooses the latest eligible weekday", async () => {
+    const tenant = await createTenant("recurring-weekly");
+    const rule = await createRecurringIssue(tenant.actors.member, {
+      ...input(tenant), cadence: "weekly", weekday: 1, timezone: "Asia/Tokyo", startsOn: "2026-03-03",
+    });
+    expect((await runRecurringIssueJob(new Date("2026-03-08T14:59:59Z"))).processed).toBe(0);
+    expect((await runRecurringIssueJob(new Date("2026-03-08T15:00:00Z"))).processed).toBe(1);
+    expect((await runRecurringIssueJob(new Date("2026-03-25T12:00:00Z"))).processed).toBe(1);
+    expect((await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id))?.lastOccurrenceOn).toBe("2026-03-23");
+  });
+
+  it("leaves archived projects untouched and pauses creators who lose access", async () => {
+    const tenant = await createTenant("recurring-access");
+    const rule = await createRecurringIssue(tenant.actors.member, input(tenant));
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await runRecurringIssueJob(new Date("2026-03-05T12:00:00Z"));
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toEqual(rule);
+    await projectRepo.restoreProject(tenant.org.id, tenant.project.id);
+    const creator = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    await memberRepo.updateMemberRole(tenant.org.id, creator.id, "viewer");
+    expect((await runRecurringIssueJob(new Date("2026-03-06T12:00:00Z"))).processed).toBe(0);
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toMatchObject({ paused: true, lastOccurrenceOn: null });
+  });
+
+  it("retries quota refusals, drops inactive assignees, and isolates rule failures", async () => {
+    const blocked = await createTenant("recurring-blocked", "starter");
+    const rule = await createRecurringIssue(blocked.actors.member, input(blocked));
+    for (let i = 1; i <= 1000; i++) {
+      await issueRepo.insertIssue(issueInput(blocked.org.id, blocked.project.id), blocked.userIds.member, i);
+    }
+    const healthy = await createTenant("recurring-healthy");
+    await createRecurringIssue(healthy.actors.member, { ...input(healthy), assigneeId: healthy.userIds.admin });
+    const assignee = (await memberRepo.findMember(healthy.org.id, healthy.userIds.admin))!;
+    await memberRepo.archiveMember(healthy.org.id, assignee.id);
+    const now = new Date("2026-03-05T12:00:00Z");
+    expect(await runRecurringIssueJob(now)).toMatchObject({ processed: 1, failed: 1 });
+    expect(await recurringRepo.findRecurringIssueById(blocked.org.id, rule.id)).toEqual(rule);
+    const healthyIssues = await issueRepo.listIssues({ orgId: healthy.org.id, limit: 100 });
+    expect(healthyIssues.items[0].assigneeId).toBeNull();
+    const issues = await issueRepo.listIssues({ orgId: blocked.org.id, limit: 1 });
+    await issueRepo.archiveIssue(blocked.org.id, issues.items[0].id);
+    expect((await runRecurringIssueJob(now)).processed).toBe(1);
+  });
+
+  it("dispatches queued recurring-issues jobs with the current time", async () => {
+    const tenant = await createTenant("recurring-queue");
+    const rule = await createRecurringIssue(tenant.actors.member, { ...input(tenant), startsOn: "2020-01-01" });
+    enqueue({ id: "recurring-test", kind: "recurring-issues", runAt: toIsoTimestamp(new Date(0)), attempts: 0, payload: {} });
+    expect(await drain()).toBe(1);
+    expect((await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id))?.lastOccurrenceOn).toBe(new Date().toISOString().slice(0, 10));
+  });
+});

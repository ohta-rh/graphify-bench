+import type { IsoTimestamp, OrgId, ProjectId, UserId } from "./common";
+import type { IssuePriority } from "./issue";
+
+export type RecurrenceCadence = "daily" | "weekly";
+
+export interface RecurringIssue {
+  id: string;
+  orgId: OrgId;
+  projectId: ProjectId;
+  title: string;
+  priority: IssuePriority;
+  assigneeId: UserId | null;
+  cadence: RecurrenceCadence;
+  weekday: number | null;
+  timezone: string;
+  startsOn: string;
+  lastOccurrenceOn: string | null;
+  paused: boolean;
+  createdBy: UserId;
+  createdAt: IsoTimestamp;
+  updatedAt: IsoTimestamp;
+}
diff -ruN --exclude=node_modules --exclude=.next --exclude=.git /private/tmp/bench-scratch/75f218e2-8e3c-45b8-9509-52dd59c2e5b5/tests/services/recurring-issue-service.test.ts /private/tmp/bench-scratch/3e48091f-0719-4687-a277-02b7877c5af1/tests/services/recurring-issue-service.test.ts
--- /private/tmp/bench-scratch/75f218e2-8e3c-45b8-9509-52dd59c2e5b5/tests/services/recurring-issue-service.test.ts	1970-01-01 09:00:00

+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+
+import { organizationSettingsSchema, updateOrganizationSchema } from "@/schemas/organization";
+import { getDb } from "@/server/db";
+import { runMigrations } from "@/server/db/migrate";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { updateOrganization } from "@/server/services/organization-service";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+describe("workspace time zone settings", () => {
+  it("defaults new workspaces and settings to UTC", async () => {
+    const tenant = await createTenant("zone-default");
+    expect(tenant.org.settings.timeZone).toBe("UTC");
+    expect(organizationSettingsSchema.parse({}).timeZone).toBe("UTC");
+    expect(organizationSettingsSchema.parse({ timeZone: "Asia/Tokyo" }).timeZone).toBe("Asia/Tokyo");
+    expect(organizationSettingsSchema.safeParse({ timeZone: "Unknown/Zone" }).success).toBe(false);
+  });
+
+  it("persists the zone through service updates and all organization reads", async () => {
+    const tenant = await createTenant("zone-readback");
+    const updated = await updateOrganization(tenant.actors.owner, {
+      orgId: tenant.org.id,
+      settings: { timeZone: "Asia/Tokyo", requireTwoFactor: true, enabledFlagOverrides: ["csv_export"] },
+    });
+    expect(updated.settings.timeZone).toBe("Asia/Tokyo");
+    expect((await orgRepo.findOrgById(tenant.org.id))?.settings.timeZone).toBe("Asia/Tokyo");
+    expect((await orgRepo.findOrgBySlug(tenant.org.slug))?.settings.timeZone).toBe("Asia/Tokyo");
+    expect((await orgRepo.listOrgsForUser(tenant.userIds.owner))[0].settings.timeZone).toBe("Asia/Tokyo");
+
+    const patch = updateOrganizationSchema.parse({ orgId: tenant.org.id, settings: { digestHourUtc: 10 } });
+    expect(patch.settings).toEqual({ digestHourUtc: 10 });
+    expect((await updateOrganization(tenant.actors.owner, patch)).settings).toEqual({ ...updated.settings, digestHourUtc: 10 });
+  });
+
+  it("rejects invalid zones atomically in repository and service updates", async () => {
+    const tenant = await createTenant("zone-invalid");
+    const patch = { orgId: tenant.org.id, name: "Must not change", settings: { timeZone: "Unknown/Zone" } };
+    await expect(orgRepo.updateOrg(tenant.org.id, patch)).rejects.toThrow(RangeError);
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(tenant.org);
+    await expect(updateOrganization(tenant.actors.owner, patch)).rejects.toThrow(RangeError);
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(tenant.org);
+    expect(getDb().$client.prepare("SELECT count(*) AS count FROM activity_events WHERE org_id = ?")
+      .get(tenant.org.id)).toEqual({ count: 0 });
+  });
+
+  it("adds UTC to existing workspace rows and remains safe to migrate again", async () => {
+    const tenant = await createTenant("zone-migration");
+    getDb().$client.exec("ALTER TABLE organizations DROP COLUMN time_zone");
+    await runMigrations(process.env.TASKFLOW_DB_PATH);
+    expect((await orgRepo.findOrgById(tenant.org.id))?.settings.timeZone).toBe("UTC");
+    await orgRepo.updateOrg(tenant.org.id, { orgId: tenant.org.id, settings: { timeZone: "Asia/Tokyo" } });
+    await runMigrations(process.env.TASKFLOW_DB_PATH);
+    expect((await orgRepo.findOrgById(tenant.org.id))?.settings.timeZone).toBe("Asia/Tokyo");
+  });
+});

+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { runCleanupArchivedJob } from "@/server/jobs/cleanup-archived-job";
+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+describe("local calendar retention", () => {
+  it.each([
+    ["utc", "UTC", "2026-06-01T12:00:00.000Z", "2026-05-02T00:00:00.000Z"],
+    ["tokyo", "Asia/Tokyo", "2026-06-01T16:00:00.000Z", "2026-05-02T15:00:00.000Z"],
+    ["spring", "America/New_York", "2026-03-20T18:00:00.000Z", "2026-02-18T05:00:00.000Z"],
+    ["fall", "America/New_York", "2026-11-20T18:00:00.000Z", "2026-10-21T04:00:00.000Z"],
+  ])("uses midnight 30 local dates ago for %s", async (slug, timeZone, now, cutoff) => {
+    const tenant = await createTenant(`retention-${slug}`, "free");
+    await orgRepo.updateOrg(tenant.org.id, { orgId: tenant.org.id, settings: { timeZone } });
+    await usageRepo.recomputeUsage(tenant.org.id);
+
+    vi.useFakeTimers();
+    try {
+      for (const [index, offset] of [-1, 0, 1].entries()) {
+        const at = new Date(new Date(cutoff).getTime() + offset);
+        vi.setSystemTime(at);
+        const issue = await issueRepo.insertIssue(
+          issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, index + 1,
+        );
+        await issueRepo.archiveIssue(tenant.org.id, issue.id);
+        await searchRepo.upsertSearchDocument(tenant.org.id, "issue", issue.id, "Archived issue", tenant.project.id);
+        await activityRepo.insertActivity({
+          orgId: tenant.org.id,
+          action: "issue.archived",
+          actorId: null,
+          subjectKind: "issue",
+          subjectId: issue.id,
+          projectId: tenant.project.id,
+          summary: "Archived issue",
+          metadata: {},
+          occurredAt: toIsoTimestamp(at),
+        });
+      }
+    } finally {
+      vi.useRealTimers();
+    }
+
+    await runCleanupArchivedJob(new Date(now));
+
+    expect(await searchRepo.countIndexed(tenant.org.id)).toBe(1);
+    const events = await activityRepo.listActivity({ orgId: tenant.org.id, limit: 25, cursor: null });
+    expect(events.items.map((event) => event.occurredAt)).toEqual([
+      toIsoTimestamp(new Date(new Date(cutoff).getTime() + 1)), cutoff,
+    ]);
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id, { includeArchived: true })).toBe(3);
+  });
+});

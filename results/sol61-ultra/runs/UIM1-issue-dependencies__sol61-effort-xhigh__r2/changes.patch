+async function notifyUnblockedIssues(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+  actorId: UserId | null,
+): Promise<void> {
+  // A project archive can close several blockers of the same issue at once.
+  const candidates = new Map<IssueId, Issue>();
+  for (const blockerId of blockerIds) {
+    for (const issue of await dependencyRepo.listBlockedIssues(orgId, blockerId)) {
+      candidates.set(issue.id, issue);
+    }
+  }
+
+  for (const issue of candidates.values()) {
+    if (issue.assigneeId === null) continue;
+    const openBlockers = await dependencyRepo.listOpenBlockerIds(orgId, issue.id);
+    if (openBlockers.length > 0) continue;
+
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Your issue is unblocked",
+      body: `${issue.title} has no open blockers left`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
+}
+
+/** Registered and detached with the app's other event-handler groups. */
+export function registerIssueDependencyListeners(): Unsubscribe {
+  const offs = [
+    subscribe("issue.status_changed", async (payload) => {
+      if (
+        CLOSED_ISSUE_STATUSES.includes(payload.from) ||
+        !CLOSED_ISSUE_STATUSES.includes(payload.to)
+      ) return;
+      await notifyUnblockedIssues(payload.orgId, [payload.issueId], payload.actorId);
+    }),
+    subscribe("issue.archived", async (payload) => {
+      const blocker = await issueRepo.findIssueById(payload.orgId, payload.issueId);
+      if (!blocker || CLOSED_ISSUE_STATUSES.includes(blocker.status)) return;
+      await notifyUnblockedIssues(payload.orgId, [payload.issueId], payload.actorId);
+    }),
+    subscribe("project.archived", async (payload) => {
+      const openBeforeArchive: IssueId[] = [];
+      for (const issueId of payload.archivedIssueIds ?? []) {
+        const blocker = await issueRepo.findIssueById(payload.orgId, issueId);
+        if (blocker && !CLOSED_ISSUE_STATUSES.includes(blocker.status)) {
+          openBeforeArchive.push(issueId);
+        }
+      }
+      await notifyUnblockedIssues(payload.orgId, openBeforeArchive, payload.actorId);
+    }),
+  ];
+  return () => {
+    for (const off of offs) off();
+  };
 }
 

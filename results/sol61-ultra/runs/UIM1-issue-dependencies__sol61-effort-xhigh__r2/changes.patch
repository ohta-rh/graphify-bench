@@ -0,0 +1,167 @@
+import { and, asc, eq, notInArray, sql } from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { toIssue } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import { listLabelsForIssues } from "./label-repository";
+import type { IssueDependencyRow, IssueRow } from "@/server/db";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+function toDependency(row: IssueDependencyRow): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: toIsoTimestamp(row.createdAt),
+  };
+}
+
+/** Cycle detection and insertion share a transaction so competing adds cannot form a cycle. */
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const existing = tx
+      .select()
+      .from(issueDependencies)
+      .where(
+        and(
+          orgPredicate(issueDependencies.orgId, orgId),
+          eq(issueDependencies.issueId, issueId),
+          eq(issueDependencies.blockerId, blockerId),
+        ),
+      )
+      .get();
+    if (existing) return toDependency(existing);
+
+    // Follow every link, including links to closed or archived issues.
+    // UNION deduplicates visits, so shared branches are only explored once.
+    const cycle = tx.get<{ id: string }>(sql`
+      WITH RECURSIVE blockers(id) AS (
+        SELECT ${blockerId}
+        UNION
+        SELECT dependency.blocker_id
+        FROM issue_dependencies AS dependency
+        INNER JOIN blockers ON dependency.issue_id = blockers.id
+        WHERE dependency.org_id = ${orgId}
+      )
+      SELECT id FROM blockers WHERE id = ${issueId} LIMIT 1
+    `);
+    if (cycle) throw new Error("An issue dependency cannot create a cycle");
+
+    const row = tx
+      .insert(issueDependencies)
+      .values({
+        orgId,
+        issueId,
+        blockerId,
+        createdBy,
+        createdAt: toIsoTimestamp(new Date()),
+      })
+      .returning()
+      .get();
+    return toDependency(row);
+  });
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const result = getDb()
+    .delete(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .run();
+  return result.changes > 0;
+}
+
+async function hydrateIssues(
+  orgId: OrgId,
+  rows: readonly IssueRow[],
+): Promise<readonly Issue[]> {
+  const labels = await listLabelsForIssues(
+    orgId,
+    rows.map((row) => row.id as IssueId),
+  );
+  return rows.map((row) =>
+    toIssue(row, (labels[row.id] ?? []).map((label) => label.id)),
+  );
+}
+
+export async function listBlockerIssues(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.blockerId))
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        orgPredicate(issues.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        livePredicate(issues.archivedAt, {}),
+      ),
+    )
+    .orderBy(asc(issues.number), asc(issues.id))
+    .all();
+  return hydrateIssues(orgId, rows.map((row) => row.issue));
+}
+
+export async function listOpenBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb()
+    .select({ id: issues.id })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.blockerId))
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        orgPredicate(issues.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        livePredicate(issues.archivedAt, {}),
+        notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+      ),
+    )
+    .orderBy(asc(issues.number), asc(issues.id))
+    .all()
+    .map((row) => row.id as IssueId);
+}
+
+export async function listBlockedIssues(
+  orgId: OrgId,
+  blockerId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.issueId))
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        orgPredicate(issues.orgId, orgId),
+        eq(issueDependencies.blockerId, blockerId),
+        livePredicate(issues.archivedAt, {}),
+        notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+      ),
+    )
+    .orderBy(asc(issues.number), asc(issues.id))
+    .all();
+  return hydrateIssues(orgId, rows.map((row) => row.issue));
+}

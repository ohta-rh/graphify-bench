+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { ZodError } from "zod";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import { runRecurringIssueJob } from "@/server/jobs/recurring-issue-job";
+import { drain, enqueue, resetQueue } from "@/server/jobs/queue";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { createRecurringIssue, listRecurringIssues, setRecurringIssuePaused } from "@/server/services/recurring-issue-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+import type { CreateRecurringIssueInput } from "@/schemas/recurring-issue";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { resetQueue(); cleanup(); });
+
+function input(tenant: Tenant, overrides: Partial<CreateRecurringIssueInput> = {}): CreateRecurringIssueInput {
+  return {
+    orgId: tenant.org.id,
+    projectId: tenant.project.id,
+    title: "Daily triage",
+    cadence: "daily",
+    timezone: "UTC",
+    startsOn: "2026-03-01",
+    ...overrides,
+  };
+}
+
+describe("recurring issues", () => {
+  it("validates real dates, zones, cadence and defaults before storing", async () => {
+    const tenant = await createTenant("rec-validation");
+    for (const overrides of [
+      { startsOn: "2026-02-30" }, { startsOn: "2025-02-29" },
+      { startsOn: "2026-2-01" }, { timezone: "Mars/Olympus" },
+      { timezone: "+01:00" }, { cadence: "weekly" as const }, { weekday: 1 },
+    ]) {
+      await expect(createRecurringIssue(tenant.actors.member, input(tenant, overrides))).rejects.toBeInstanceOf(ZodError);
+    }
+    expect(await listRecurringIssues(tenant.actors.viewer, tenant.org.id)).toEqual([]);
+    expect(createRecurringIssueSchema.parse(input(tenant, { startsOn: "2024-02-29" }))).toMatchObject({
+      assigneeId: null, priority: "none", weekday: null,
+    });
+  });
+
+  it("enforces scope, permissions, project state and active assignees", async () => {
+    const tenant = await createTenant("rec-guards");
+    const other = await createTenant("rec-other");
+    await expect(createRecurringIssue(tenant.actors.member, input(other))).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(createRecurringIssue(tenant.actors.viewer, input(tenant))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(createRecurringIssue(tenant.actors.member, input(tenant, { projectId: other.project.id }))).rejects.toBeInstanceOf(NotFoundError);
+    await expect(createRecurringIssue(tenant.actors.member, input(tenant, { assigneeId: other.userIds.member }))).rejects.toThrow();
+
+    const rule = await createRecurringIssue(tenant.actors.member, input(tenant));
+    expect(rule).toMatchObject({ lastOccurrenceOn: null, paused: false, createdBy: tenant.userIds.member });
+    await expect(setRecurringIssuePaused(tenant.actors.viewer, { orgId: tenant.org.id, recurringIssueId: rule.id, paused: true })).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(setRecurringIssuePaused(other.actors.member, { orgId: other.org.id, recurringIssueId: rule.id, paused: true })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(listRecurringIssues(other.actors.member, tenant.org.id)).rejects.toBeInstanceOf(TenantScopeError);
+    await setRecurringIssuePaused(tenant.actors.member, { orgId: tenant.org.id, recurringIssueId: rule.id, paused: true });
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(createRecurringIssue(tenant.actors.member, input(tenant))).rejects.toBeInstanceOf(AlreadyArchivedError);
+  });
+
+  it("counts paused rules toward quotas and keeps insertion order", async () => {
+    const free = await createTenant("rec-free", "free");
+    await expect(createRecurringIssue(free.actors.member, input(free))).rejects.toThrow();
+    const tenant = await createTenant("rec-starter", "starter");
+    const first = await createRecurringIssue(tenant.actors.member, input(tenant));
+    await setRecurringIssuePaused(tenant.actors.member, { orgId: tenant.org.id, recurringIssueId: first.id, paused: true });
+    const results = await Promise.allSettled(Array.from({ length: 3 }, () => createRecurringIssue(tenant.actors.member, input(tenant))));
+    expect(results.filter((result) => result.status === "fulfilled")).toHaveLength(2);
+    expect(results.filter((result) => result.status === "rejected")).toHaveLength(1);
+    const rules = await listRecurringIssues(tenant.actors.viewer, tenant.org.id);
+    expect(rules).toHaveLength(3);
+    expect(rules[0].id).toBe(first.id);
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+  });
+
+  it("uses local calendar days across DST, skips missed days, and emits normal issue events", async () => {
+    const tenant = await createTenant("rec-dst");
+    const rule = await createRecurringIssue(tenant.actors.member, input(tenant, {
+      timezone: "America/New_York", startsOn: "2026-03-08", assigneeId: tenant.userIds.admin, priority: "high",
+    }));
+    await runRecurringIssueJob(new Date("2026-03-08T04:59:59Z"));
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(0);
+    const events: unknown[] = [];
+    const off = subscribe("issue.created", (event) => { if (event.orgId === tenant.org.id) events.push(event); });
+    try {
+      await Promise.all([
+        runRecurringIssueJob(new Date("2026-03-08T05:00:00Z")),
+        runRecurringIssueJob(new Date("2026-03-08T05:00:00Z")),
+      ]);
+      await runRecurringIssueJob(new Date("2026-03-09T03:59:59Z"));
+      expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(1);
+      await runRecurringIssueJob(new Date("2026-03-12T04:00:00Z"));
+      expect(events).toHaveLength(2);
+      expect(events[0]).toMatchObject({ actorId: tenant.userIds.member, title: "Daily triage (2026-03-08)" });
+      const page = await issueRepo.listIssues({ orgId: tenant.org.id, projectId: tenant.project.id, cursor: null, limit: 20 });
+      expect(page.items).toHaveLength(2);
+      expect(page.items.find((issue) => issue.number === 2)).toMatchObject({
+        title: "Daily triage (2026-03-12)", status: "backlog", priority: "high", assigneeId: tenant.userIds.admin,
+        authorId: tenant.userIds.member, description: null, dueAt: null, labelIds: [],
+      });
+      expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id))[0]).toMatchObject({ id: rule.id, lastOccurrenceOn: "2026-03-12" });
+    } finally { off(); }
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+  });
+
+  it("waits for weekly starts and resumes archived projects at the latest occurrence", async () => {
+    const tenant = await createTenant("rec-weekly");
+    await createRecurringIssue(tenant.actors.member, input(tenant, { cadence: "weekly", weekday: 1, startsOn: "2026-03-03", timezone: "Asia/Tokyo" }));
+    await runRecurringIssueJob(new Date("2026-03-08T14:59:59Z"));
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(0);
+    await runRecurringIssueJob(new Date("2026-03-08T15:00:00Z"));
+    const before = (await listRecurringIssues(tenant.actors.viewer, tenant.org.id))[0];
+    expect(before.lastOccurrenceOn).toBe("2026-03-09");
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await runRecurringIssueJob(new Date("2026-04-01T00:00:00Z"));
+    expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id))[0]).toEqual(before);
+    await projectRepo.restoreProject(tenant.org.id, tenant.project.id);
+    await runRecurringIssueJob(new Date("2026-04-01T00:00:00Z"));
+    expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id))[0].lastOccurrenceOn).toBe("2026-03-30");
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+  });
+
+  it("unassigns departed assignees and pauses creators who lose access", async () => {
+    const tenant = await createTenant("rec-members");
+    await createRecurringIssue(tenant.actors.member, input(tenant, { assigneeId: tenant.userIds.admin }));
+    const assignee = (await memberRepo.findMember(tenant.org.id, tenant.userIds.admin))!;
+    await memberRepo.archiveMember(tenant.org.id, assignee.id);
+    await runRecurringIssueJob(new Date("2026-03-05T00:00:00Z"));
+    const issue = await issueRepo.findIssueByNumber(tenant.org.id, tenant.project.id, 1);
+    expect(issue?.assigneeId).toBeNull();
+    const creator = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    await memberRepo.updateMemberRole(tenant.org.id, creator.id, "viewer");
+    await runRecurringIssueJob(new Date("2026-03-06T00:00:00Z"));
+    expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id))[0]).toMatchObject({ paused: true, lastOccurrenceOn: "2026-03-05" });
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(1);
+  });
+
+  it("keeps quota failures unchanged, processes other rules, and retries via the queue", async () => {
+    const tenant = await createTenant("rec-retry");
+    const rule = await createRecurringIssue(tenant.actors.member, input(tenant));
+    const good = await createTenant("rec-good");
+    await createRecurringIssue(good.actors.member, input(good));
+    // The normal issue service reads the org plan, including after a downgrade.
+    const { getDb, organizations } = await import("@/server/db");
+    const { eq } = await import("drizzle-orm");

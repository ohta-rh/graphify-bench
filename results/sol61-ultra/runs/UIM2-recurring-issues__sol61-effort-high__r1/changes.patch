+import { index, integer, sqliteTable, text } from "drizzle-orm/sqlite-core";
+import { idColumn, tenantColumns, timestampColumns } from "./_shared";
+
+export const recurringIssues = sqliteTable(
+  "recurring_issues",
+  {
+    id: idColumn(),
+    ...tenantColumns,
+    projectId: text("project_id").notNull(),
+    title: text("title").notNull(),
+    priority: text("priority", { enum: ["none", "low", "medium", "high", "urgent"] })
+      .notNull()
+      .default("none"),
+    assigneeId: text("assignee_id"),
+    cadence: text("cadence", { enum: ["daily", "weekly"] }).notNull(),
+    weekday: integer("weekday"),
+    timezone: text("timezone").notNull(),
+    startsOn: text("starts_on").notNull(),
+    lastOccurrenceOn: text("last_occurrence_on"),
+    paused: integer("paused", { mode: "boolean" }).notNull().default(false),
+    createdBy: text("created_by").notNull(),
+    ...timestampColumns,
+  },
+  (table) => [
+    index("recurring_issues_org_idx").on(table.orgId),
+    index("recurring_issues_paused_idx").on(table.paused),
+  ],
+);
+
+export type RecurringIssueRow = typeof recurringIssues.$inferSelect;
+export type NewRecurringIssueRow = typeof recurringIssues.$inferInsert;

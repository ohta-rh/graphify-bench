+    livePredicate(projects.archivedAt, {}),
+  ));
+  const liveIssues = db.select({ id: issues.id }).from(issues).where(and(
+    orgPredicate(issues.orgId, orgId),
+    livePredicate(issues.archivedAt, {}),
+    inArray(issues.projectId, liveProjects),
+  ));
+  const liveComments = db.select({ id: comments.id }).from(comments).where(and(
+    orgPredicate(comments.orgId, orgId),
+    livePredicate(comments.archivedAt, {}),
+    inArray(comments.issueId, liveIssues),
+  ));
+  return or(
+    and(eq(searchIndex.subjectKind, "project"), inArray(searchIndex.subjectId, liveProjects)),
+    and(eq(searchIndex.subjectKind, "issue"), inArray(searchIndex.subjectId, liveIssues)),
+    and(eq(searchIndex.subjectKind, "comment"), inArray(searchIndex.subjectId, liveComments)),
+  );

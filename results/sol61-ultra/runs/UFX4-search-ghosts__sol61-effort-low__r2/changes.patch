+/** Check the source hierarchy, including tenant ownership at every level. */
+function searchable(orgId: OrgId, kind: SearchSubjectKind | typeof searchIndex.subjectKind,
+  subjectId: string | typeof searchIndex.subjectId) {
+  return sql`(
+    (${kind} = 'project' AND EXISTS (
+      SELECT 1 FROM projects p WHERE p.id = ${subjectId}
+      AND p.org_id = ${orgId} AND p.archived_at IS NULL
+    )) OR (${kind} = 'issue' AND EXISTS (
+      SELECT 1 FROM issues i JOIN projects p ON p.id = i.project_id AND p.org_id = i.org_id
+      WHERE i.id = ${subjectId} AND i.org_id = ${orgId}
+      AND i.archived_at IS NULL AND p.archived_at IS NULL
+    )) OR (${kind} = 'comment' AND EXISTS (
+      SELECT 1 FROM comments c JOIN issues i ON i.id = c.issue_id AND i.org_id = c.org_id
+      JOIN projects p ON p.id = i.project_id AND p.org_id = i.org_id
+      WHERE c.id = ${subjectId} AND c.org_id = ${orgId}
+      AND c.archived_at IS NULL AND i.archived_at IS NULL AND p.archived_at IS NULL
+    ))
+  )`;
+}
+
+export async function clearSearchIndex(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();
+}
+
+export async function pruneSearchIndex(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    sql`NOT ${searchable(orgId, searchIndex.subjectKind, searchIndex.subjectId)}`,
+  )).run();
+}

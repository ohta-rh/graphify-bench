@@ -0,0 +1,57 @@
+import { and, asc, count, eq, sql } from "drizzle-orm";
+import type { z } from "zod";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import type { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import type { RecurringIssueRow } from "@/server/db/schema/recurring-issues";
+import { toIsoTimestamp, type OrgId, type ProjectId, type UserId, type IsoTimestamp } from "@/types/common";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import { orgPredicate } from "./base-repository";
+
+function toRecurringIssue(row: RecurringIssueRow): RecurringIssue {
+  return { ...row, orgId: row.orgId as OrgId, projectId: row.projectId as ProjectId,
+    assigneeId: row.assigneeId as UserId | null, createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IsoTimestamp, updatedAt: row.updatedAt as IsoTimestamp };
+}
+
+export async function listRecurringIssues(orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(orgPredicate(recurringIssues.orgId, orgId))
+    .orderBy(sql`rowid`).all().map(toRecurringIssue);
+}
+
+export async function findRecurringIssueById(orgId: OrgId, id: string): Promise<RecurringIssue | null> {
+  const row = getDb().select().from(recurringIssues)
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).get();
+  return row ? toRecurringIssue(row) : null;
+}
+
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  return getDb().select({ value: count() }).from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId)).get()?.value ?? 0;
+}
+
+export async function insertRecurringIssue(input: z.output<typeof createRecurringIssueSchema>, createdBy: UserId, limit: number): Promise<RecurringIssue> {
+  // Keep the count and insert together so concurrent creates cannot exceed the cap.
+  return getDb().transaction((tx) => {
+    const used = tx.select({ value: count() }).from(recurringIssues)
+      .where(orgPredicate(recurringIssues.orgId, input.orgId)).get()?.value ?? 0;
+    if (used + 1 > limit) throw new Error("Recurring issue quota exceeded");
+    const stamp = toIsoTimestamp(new Date());
+    const row = tx.insert(recurringIssues).values({ ...input, id: newId(), createdBy,
+      lastOccurrenceOn: null, paused: false, createdAt: stamp, updatedAt: stamp }).returning().get();
+    return toRecurringIssue(row);
+  });
+}
+
+export async function updateRecurringIssue(orgId: OrgId, id: string, patch: Partial<Pick<RecurringIssue, "paused" | "lastOccurrenceOn">>): Promise<RecurringIssue> {
+  const row = getDb().update(recurringIssues).set({ ...patch, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).returning().get();
+  if (!row) throw new Error(`Recurring issue ${id} not found`);
+  return toRecurringIssue(row);
+}
+
+/** Cross-tenant sweep reserved for the background worker. */
+export async function listUnpausedRecurringIssues(): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(eq(recurringIssues.paused, false))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id)).all().map(toRecurringIssue);

+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import Database from "better-sqlite3";
+import { expect, it } from "vitest";
+import { runMigrations } from "@/server/db/migrate";
+
+it("upgrades existing notifications and preserves project mutes across migrations and connections", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "taskflow-mute-migration-"));
+  const path = join(dir, "taskflow.db");
+  try {
+    const legacy = new Database(path);
+    try {
+      legacy.exec(`
+        CREATE TABLE notifications (
+          id TEXT PRIMARY KEY NOT NULL,
+          org_id TEXT NOT NULL,
+          recipient_id TEXT NOT NULL,
+          kind TEXT NOT NULL,
+          title TEXT NOT NULL,
+          body TEXT NOT NULL,
+          href TEXT NOT NULL,
+          actor_id TEXT,
+          read_at TEXT,
+          channels TEXT NOT NULL DEFAULT '["in_app"]',
+          created_at TEXT NOT NULL,
+          updated_at TEXT NOT NULL
+        );
+        INSERT INTO notifications (id, org_id, recipient_id, kind, title, body, href, created_at, updated_at)
+          VALUES ('old', 'org', 'user', 'member_joined', 'Welcome', 'Welcome', '/', '2026-06-01', '2026-06-01');
+      `);
+    } finally {
+      legacy.close();
+    }
+    await runMigrations(path);
+    const upgraded = new Database(path);
+    try {
+      expect(upgraded.prepare("SELECT id, project_id FROM notifications").all()).toEqual([
+        { id: "old", project_id: null },
+      ]);
+      upgraded.prepare("INSERT INTO project_mutes (org_id, user_id, project_id) VALUES (?, ?, ?)").run("org", "user", "project");
+      upgraded.prepare("UPDATE notifications SET project_id = ? WHERE id = ?").run("project", "old");
+    } finally {
+      upgraded.close();
+    }
+    await runMigrations(path);
+    const reopened = new Database(path);
+    try {
+      expect(reopened.prepare("SELECT project_id FROM notifications WHERE id = 'old'").get()).toEqual({ project_id: "project" });
+      expect(reopened.prepare("SELECT * FROM project_mutes").all()).toEqual([
+        { org_id: "org", user_id: "user", project_id: "project" },
+      ]);
+    } finally {
+      reopened.close();
+    }
+  } finally {
+    rmSync(dir, { recursive: true, force: true });
+  }
+});

@@ -0,0 +1,59 @@
+import { subscribe } from "@/lib/event-bus";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { notify } from "./notification-service";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Issue } from "@/types/issue";
+
+async function notifyUnblocked(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+  actorId: UserId | null,
+): Promise<void> {
+  const blockedIssues = new Map<IssueId, Issue>();
+  for (const blockerId of blockerIds) {
+    for (const issue of await dependencyRepo.listBlockedIssues(orgId, blockerId)) {
+      blockedIssues.set(issue.id, issue);
+    }
+  }
+  for (const issue of blockedIssues.values()) {
+    if (issue.assigneeId === null) continue;
+    if ((await dependencyRepo.listOpenBlockerIds(orgId, issue.id)).length > 0) continue;
+
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Your issue is unblocked",
+      body: `${issue.title} has no open blockers left`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
+}
+
+export function registerIssueDependencyListeners(): Unsubscribe {
+  const offs = [
+    subscribe("issue.status_changed", async (payload) => {
+      if (CLOSED_ISSUE_STATUSES.includes(payload.from)) return;
+      if (!CLOSED_ISSUE_STATUSES.includes(payload.to)) return;
+      await notifyUnblocked(payload.orgId, [payload.issueId], payload.actorId);
+    }),
+    subscribe("issue.archived", async (payload) => {
+      // Archiving preserves status, so the stored status tells us whether
+      // the blocker was already closed before this archive operation.
+      const issue = await issueRepo.findIssueById(payload.orgId, payload.issueId);
+      if (!issue || CLOSED_ISSUE_STATUSES.includes(issue.status)) return;
+      await notifyUnblocked(payload.orgId, [payload.issueId], payload.actorId);
+    }),
+    subscribe("project.archived", async (payload) => {
+      await notifyUnblocked(
+        payload.orgId,
+        payload.archivedOpenIssueIds ?? [],
+        payload.actorId,
+      );
+    }),
+  ];
+  return () => {
+    for (const off of offs) off();
+  };
+}

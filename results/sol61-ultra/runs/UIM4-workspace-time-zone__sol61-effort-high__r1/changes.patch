+import Database from "better-sqlite3";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("./_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("./_support/doubles/misc")).loggerModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { organizationSettingsSchema, updateOrganizationSchema } from "@/schemas/organization";
+import { runMigrations } from "@/server/db/migrate";
+import { runCleanupArchivedJob } from "@/server/jobs/cleanup-archived-job";
+import { resetOverdueTracking, runOverdueIssueJob } from "@/server/jobs/overdue-issue-job";
+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import * as orgService from "@/server/services/organization-service";
+import * as projectService from "@/server/services/project-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "./_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+afterEach(() => { vi.restoreAllMocks(); vi.useRealTimers(); });
+
+describe("workspace clocks", () => {
+  it("defaults settings to UTC and validates zone names", () => {
+    expect(organizationSettingsSchema.parse({}).timeZone).toBe("UTC");
+    expect(organizationSettingsSchema.parse({ timeZone: "Asia/Tokyo" }).timeZone).toBe("Asia/Tokyo");
+    expect(organizationSettingsSchema.safeParse({ timeZone: "Unknown/Zone" }).success).toBe(false);
+  });
+
+  it("migrates existing organizations to UTC, repeatedly without losing settings", async () => {
+    const directory = mkdtempSync(join(tmpdir(), "taskflow-clock-"));
+    const path = join(directory, "old.db");
+    try {
+      await runMigrations(path);
+      const sqlite = new Database(path);
+      try {
+        sqlite.exec("ALTER TABLE organizations DROP COLUMN time_zone");
+        sqlite.prepare(`INSERT INTO organizations
+          (id, name, slug, owner_id, digest_hour_utc, created_at, updated_at)
+          VALUES ('old', 'Old workspace', 'old', 'owner', 11, '2026-01-01', '2026-01-01')`).run();
+        await runMigrations(path);
+        await runMigrations(path);
+        expect(sqlite.prepare("SELECT time_zone, digest_hour_utc FROM organizations WHERE id = 'old'").get())
+          .toEqual({ time_zone: "UTC", digest_hour_utc: 11 });
+      } finally { sqlite.close(); }
+    } finally { rmSync(directory, { recursive: true, force: true }); }
+  });
+
+  it("persists the time zone through repository and service reads and rejects invalid updates atomically", async () => {
+    const tenant = await createTenant("clock-settings");
+    expect(tenant.org.settings.timeZone).toBe("UTC");
+    const updated = await orgService.updateOrganization(tenant.actors.owner, {
+      orgId: tenant.org.id, settings: { timeZone: "Asia/Tokyo", digestHourUtc: 16 },
+    });

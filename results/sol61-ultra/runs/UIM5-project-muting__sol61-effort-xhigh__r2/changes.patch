+      orgId, projectId, kind: "project",
+    }));
+    expect(await listMutedProjectIds(member, orgId)).toEqual([projectId]);
+    expect(await listMutedProjectIds(tenant.actors.owner, orgId)).toEqual([]);
+
+    await unmuteProject(member, orgId, projectId);
+    await unmuteProject(member, orgId, projectId);

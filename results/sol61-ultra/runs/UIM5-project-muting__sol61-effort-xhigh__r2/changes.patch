+describe("personal project mutes", () => {
+  it("changes only the actor's mutes and is idempotent", async () => {
+    const tenant = await createTenant("mute-personal");
+    const { id: orgId } = tenant.org;
+    const { id: projectId } = tenant.project;
+    const member = tenant.actors.member;
+    const viewer = tenant.actors.viewer;
+    const canSpy = vi.spyOn(permissions, "assertCan");
+
+    await muteProject(member, orgId, projectId);
+    await muteProject(member, orgId, projectId);
+    await muteProject(viewer, orgId, projectId);

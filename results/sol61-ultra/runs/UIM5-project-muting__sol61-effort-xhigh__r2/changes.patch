+    const tenant = await createTenant(`mute-guards-${changeMute.name}`);
+    const other = await createTenant(`mute-guards-other-${changeMute.name}`);
+    const actor = tenant.actors.member;
+
+    await expect(changeMute(actor, other.org.id, other.project.id)).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(listMutedProjectIds(actor, other.org.id)).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(changeMute(actor, tenant.org.id, other.project.id)).rejects.toBeInstanceOf(NotFoundError);
+    await expect(changeMute(actor, tenant.org.id, "missing" as ProjectId)).rejects.toBeInstanceOf(NotFoundError);
+
+    const denied = new permissions.PermissionDeniedError("project:read", {
+      action: "project:read", resourceKind: "project", allowed: false, reason: "denied_by_role",
+    });
+    vi.spyOn(permissions, "assertCan").mockImplementationOnce(() => { throw denied; });
+    await expect(changeMute(actor, tenant.org.id, tenant.project.id)).rejects.toBe(denied);
+    expect(await listMutedProjectIds(actor, tenant.org.id)).toEqual([]);
+  });
+
+  it.each<NotificationKind>(["issue_assigned", "comment_mention", "issue_overdue"])(
+    "keeps %s only in the preferred channels other than email", async (kind) => {
+      const tenant = await createTenant(`mute-personal-${kind}`);
+      const recipientId = tenant.userIds.member;
+      await muteProject(tenant.actors.member, tenant.org.id, tenant.project.id);
+      const projectPayload = { ...payload, projectId: tenant.project.id };
+
+      const defaults = await notify(tenant.org.id, kind, [recipientId], projectPayload);
+      expect(defaults).toHaveLength(1);
+      expect(defaults[0].channels).toEqual(["in_app"]);
+      expect(defaults[0].projectId).toBe(tenant.project.id);
+
+      for (const digestOnly of [false, true]) {
+        await preferenceRepo.upsertPreference({
+          orgId: tenant.org.id, userId: recipientId, kind,
+          inApp: false, email: true, digestOnly,

@@ -0,0 +1,170 @@
+import { and, count, desc, eq, gt, isNull, sql } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import { toApiToken } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+
+const MAX_USABLE_TOKENS = 5;
+
+/** The quota check and insert share a write transaction, including across processes. */
+export async function insertApiToken(
+  input: Omit<ApiToken, "id" | "lastUsedAt" | "revokedAt">,
+  tokenHash: string,
+): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const used = tx
+      .select({ value: count() })
+      .from(apiTokens)
+      .where(
+        and(
+          orgPredicate(apiTokens.orgId, input.orgId),
+          eq(apiTokens.userId, input.userId),
+          isNull(apiTokens.revokedAt),
+          gt(apiTokens.expiresAt, input.createdAt),
+        ),
+      )
+      .get();
+
+    if ((used?.value ?? 0) >= MAX_USABLE_TOKENS) {
+      throw new Error("A user may have at most 5 usable API tokens per organization");
+    }
+
+    const row = tx
+      .insert(apiTokens)
+      .values({
+        ...input,
+        id: newId(),
+        tokenHash,
+        lastUsedAt: null,
+        revokedAt: null,
+      })
+      .returning()
+      .get();
+
+    return toApiToken(row);
+  }, { behavior: "immediate" });
+}
+
+export async function listApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  const rows = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(sql`${apiTokens}.rowid`))
+    .all();
+
+  return rows.map(toApiToken);
+}
+
+export async function findApiTokenById(
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+
+  return row ? toApiToken(row) : null;
+}
+
+/** Returns only a newly revoked token, so competing calls cannot audit it twice. */
+export async function revokeApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .get();
+
+  return row ? toApiToken(row) : null;
+}
+
+/** Membership removal also revokes expired tokens, preserving prior revocations. */
+export async function revokeApiTokensForUser(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  const rows = getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.userId, userId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .all();
+
+  return rows.map(toApiToken);
+}
+
+/**
+ * The hash is the credential for this unscoped lookup. Validate all stored
+ * state and touch lastUsedAt in one transaction, so failed calls write nothing.
+ */
+export async function useApiToken(
+  tokenHash: string,
+  at: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; role: Role } | null> {
+  return getDb().transaction((tx) => {
+    const row = tx
+      .select({ apiToken: apiTokens, role: members.role })
+      .from(apiTokens)
+      .innerJoin(
+        members,
+        and(eq(members.orgId, apiTokens.orgId), eq(members.userId, apiTokens.userId)),
+      )
+      .innerJoin(organizations, eq(organizations.id, apiTokens.orgId))
+      .where(
+        and(
+          eq(apiTokens.tokenHash, tokenHash),
+          isNull(apiTokens.revokedAt),
+          gt(apiTokens.expiresAt, at),
+          eq(members.status, "active"),
+          livePredicate(members.archivedAt, {}),
+          livePredicate(organizations.archivedAt, {}),
+        ),
+      )
+      .get();
+
+    if (!row) return null;
+
+    const apiToken = toApiToken(row.apiToken);
+
+    tx.update(apiTokens)
+      .set({ lastUsedAt: at })
+      .where(
+        and(
+          orgPredicate(apiTokens.orgId, apiToken.orgId),
+          eq(apiTokens.id, apiToken.id),
+        ),
+      )
+      .run();
+
+    return {
+      apiToken: { ...apiToken, lastUsedAt: at },
+      role: row.role,
+    };
+  }, { behavior: "immediate" });
+}

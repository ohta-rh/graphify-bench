+import { emit } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { actorEnvelope, requireFound } from "./_support";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/** The raw credential is returned only here; storage and events carry metadata. */
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  assertCan(
+    actor,
+    parsed.scope === "read" ? "api_token:create_read" : "api_token:create_write",
+    { kind: "api_token", orgId: parsed.orgId, userId: actor.userId },
+  );
+
+  const now = new Date();
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await apiTokenRepo.insertApiToken({
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    createdAt: toIsoTimestamp(now),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * MS_PER_DAY)),
+  }, hashToken(token));
+
+  await emit("api_token.created", {
+    ...actorEnvelope(actor),
+    tokenId: apiToken.id,
+  });
+
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "api_token:list", { kind: "api_token", orgId, userId });
+  return apiTokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const apiToken = requireFound(
+    await apiTokenRepo.findApiTokenById(orgId, tokenId),
+    "API token",
+    tokenId,
+  );
+  assertCan(actor, "api_token:revoke", {
+    kind: "api_token",
+    orgId,
+    userId: apiToken.userId,
+  });
+
+  if (apiToken.revokedAt !== null) return apiToken;
+
+  const revoked = await apiTokenRepo.revokeApiToken(orgId, tokenId, toIsoTimestamp(new Date()));
+  if (!revoked) {
+    return requireFound(
+      await apiTokenRepo.findApiTokenById(orgId, tokenId),
+      "API token",
+      tokenId,
+    );
+  }
+
+  await emit("api_token.revoked", {
+    ...actorEnvelope(actor),
+    tokenId: revoked.id,
+  });
+
+  return revoked;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const authenticated = await apiTokenRepo.useApiToken(hashToken(token), toIsoTimestamp(new Date()));
+  if (!authenticated) return null;
+
+  const { apiToken, role } = authenticated;
+  return {
+    userId: apiToken.userId,
+    orgId: apiToken.orgId,
+    role: apiToken.scope === "read" ? "viewer" : role,
+  };
+}

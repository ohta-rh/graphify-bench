+import { index, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";
+import { idColumn, nowIso, tenantColumns } from "./_shared";
+
+export const apiTokens = sqliteTable(
+  "api_tokens",
+  {
+    id: idColumn(),
+    ...tenantColumns,
+    userId: text("user_id").notNull(),
+    name: text("name").notNull(),
+    scope: text("scope", { enum: ["read", "write"] }).notNull(),
+    prefix: text("prefix").notNull(),
+    tokenHash: text("token_hash").notNull(),
+    expiresAt: text("expires_at").notNull(),
+    lastUsedAt: text("last_used_at"),
+    revokedAt: text("revoked_at"),
+    createdAt: text("created_at").notNull().$defaultFn(nowIso),
+  },
+  (table) => [
+    uniqueIndex("api_tokens_hash_idx").on(table.tokenHash),
+    index("api_tokens_org_user_idx").on(table.orgId, table.userId),
+  ],
+);
+
+export type ApiTokenRow = typeof apiTokens.$inferSelect;
+export type NewApiTokenRow = typeof apiTokens.$inferInsert;

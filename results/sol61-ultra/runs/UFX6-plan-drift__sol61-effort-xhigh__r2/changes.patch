+import { consumeRateLimit as consumeBucket } from "@/lib/rate-limit";
+import { findOrgById } from "@/server/repositories/organization-repository";
+import type { RateLimitVerdict } from "@/lib/rate-limit";
+import type { OrgId } from "@/types/common";
+
+/** Workspace buckets always use the current plan, without a process-local plan cache. */
+export async function consumeRateLimit(
+  orgId: OrgId,
+  bucketKey: string,
+  cost = 1,
+): Promise<RateLimitVerdict> {
+  const org = await findOrgById(orgId);
+  return consumeBucket(orgId, bucketKey, cost, org?.plan ?? "free");
+}

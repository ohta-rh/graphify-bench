@@ -0,0 +1,38 @@
+import { subscribe } from "@/lib/event-bus";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { notify } from "./notification-service";
+
+async function notifyUnblocked(orgId: OrgId, blockerId: IssueId, actorId: UserId | null): Promise<void> {
+  const dependents = await dependencyRepo.listDependentIssues(orgId, blockerId);
+  for (const issue of dependents) {
+    if (CLOSED_ISSUE_STATUSES.includes(issue.status) || issue.assigneeId === null) continue;
+    const blockers = await dependencyRepo.listBlockerIssues(orgId, issue.id);
+    if (blockers.some((blocker) => !CLOSED_ISSUE_STATUSES.includes(blocker.status))) continue;
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Your issue is unblocked",
+      body: `${issue.title} has no open blockers left`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
+}
+
+export function registerIssueDependencyListeners(): Unsubscribe {
+  const offs = [
+    subscribe("issue.status_changed", async (payload) => {
+      if (CLOSED_ISSUE_STATUSES.includes(payload.from) || !CLOSED_ISSUE_STATUSES.includes(payload.to)) return;
+      await notifyUnblocked(payload.orgId, payload.issueId, payload.actorId);
+    }),
+    subscribe("issue.archived", async (payload) => {
+      // Archiving preserves status, so it tells us whether this blocker was open.
+      const blocker = await issueRepo.findIssueById(payload.orgId, payload.issueId);
+      if (!blocker || CLOSED_ISSUE_STATUSES.includes(blocker.status)) return;
+      await notifyUnblocked(payload.orgId, payload.issueId, payload.actorId);
+    }),
+  ];
+  return () => { for (const off of offs) off(); };
+}

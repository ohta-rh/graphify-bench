@@ -0,0 +1,70 @@
+import { and, eq, isNull } from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import { toIssue, toIssueDependency } from "./_mappers";
+import { orgPredicate } from "./base-repository";
+import { listLabelsForIssues } from "./label-repository";
+
+/** Traversal and insertion run together so competing adds cannot form a cycle. */
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const links = tx.select().from(issueDependencies)
+      .where(orgPredicate(issueDependencies.orgId, orgId)).all();
+    const existing = links.find((link) => link.issueId === issueId && link.blockerId === blockerId);
+    if (existing) return toIssueDependency(existing);
+
+    const pending: string[] = [blockerId];
+    const visited = new Set<string>();
+    const blockers = new Map<string, string[]>();
+    for (const link of links) {
+      const ids = blockers.get(link.issueId) ?? [];
+      ids.push(link.blockerId);
+      blockers.set(link.issueId, ids);
+    }
+    while (pending.length > 0) {
+      const id = pending.pop()!;
+      if (id === issueId) throw new Error("Issue dependencies cannot form a cycle");
+      if (visited.has(id)) continue;
+      visited.add(id);
+      pending.push(...(blockers.get(id) ?? []));
+    }
+
+    return toIssueDependency(tx.insert(issueDependencies).values({
+      orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()),
+    }).returning().get());
+  });
+}
+
+export async function deleteDependency(
+  orgId: OrgId, issueId: IssueId, blockerId: IssueId,
+): Promise<boolean> {
+  return getDb().delete(issueDependencies).where(and(
+    orgPredicate(issueDependencies.orgId, orgId),
+    eq(issueDependencies.issueId, issueId),
+    eq(issueDependencies.blockerId, blockerId),
+  )).run().changes > 0;
+}
+
+export async function listBlockerIssues(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ issue: issues }).from(issueDependencies)
+    .innerJoin(issues, and(eq(issues.id, issueDependencies.blockerId), eq(issues.orgId, issueDependencies.orgId)))
+    .where(and(orgPredicate(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), isNull(issues.archivedAt)))
+    .orderBy(issues.number).all();
+  const labels = await listLabelsForIssues(orgId, rows.map(({ issue }) => issue.id as IssueId));
+  return rows.map(({ issue }) => toIssue(issue, (labels[issue.id] ?? []).map((label) => label.id)));
+}
+
+export async function listDependentIssues(orgId: OrgId, blockerId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ issue: issues }).from(issueDependencies)
+    .innerJoin(issues, and(eq(issues.id, issueDependencies.issueId), eq(issues.orgId, issueDependencies.orgId)))
+    .where(and(orgPredicate(issueDependencies.orgId, orgId), eq(issueDependencies.blockerId, blockerId), isNull(issues.archivedAt)))
+    .all();
+  return rows.map(({ issue }) => toIssue(issue));
+}

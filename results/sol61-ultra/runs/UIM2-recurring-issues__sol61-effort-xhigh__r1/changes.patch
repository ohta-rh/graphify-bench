+import { z } from "zod";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+import { issuePrioritySchema } from "./issue";
+
+export const createRecurringIssueSchema = z
+  .object({
+    orgId: orgIdSchema,
+    projectId: projectIdSchema,
+    title: z.string().min(3).max(180),
+    priority: issuePrioritySchema.default("none"),
+    assigneeId: userIdSchema.nullable().default(null),
+    cadence: z.enum(["daily", "weekly"]),
+    weekday: z.number().int().min(1).max(7).nullable().default(null),
+    timezone: z.string().refine((timezone) => {
+      // Intl also accepts numeric offsets in some runtimes; those are not
+      // IANA zones and do not carry daylight-saving rules.
+      if (/^[+-]/.test(timezone)) return false;
+      try {
+        new Intl.DateTimeFormat("en", { timeZone: timezone });
+        return true;
+      } catch {
+        return false;
+      }
+    }, "must be a known IANA time zone"),
+    startsOn: z.iso.date(),
+  })
+  .superRefine((input, ctx) => {
+    if (input.cadence === "weekly" && input.weekday === null) {
+      ctx.addIssue({
+        code: "custom",
+        path: ["weekday"],
+        message: "weekly recurrence requires a weekday",
+      });
+    }
+    if (input.cadence === "daily" && input.weekday !== null) {
+      ctx.addIssue({
+        code: "custom",
+        path: ["weekday"],
+        message: "daily recurrence must not have a weekday",
+      });
+    }
+  });
+
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;

+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { ZodError } from "zod";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { UNLIMITED, getLimit } from "@/config/plan-limits";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { checkLimit } from "@/server/services/billing-service";
+import { createRecurringIssue, listRecurringIssues, setRecurringIssuePaused } from "@/server/services/recurring-issue-service";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+const ruleInput = (tenant: Tenant) => ({
+  orgId: tenant.org.id,
+  projectId: tenant.project.id,
+  title: "Daily triage",
+  cadence: "daily" as const,
+  timezone: "UTC",
+  startsOn: "2026-03-05",
+});
+
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+describe("recurring issue service", () => {
+  it("validates before storing anything and persists the creator and defaults", async () => {
+    const tenant = await createTenant("recurring-validation");
+    await expect(createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), startsOn: "2026-02-30",
+    })).rejects.toBeInstanceOf(ZodError);
+    expect(await recurringRepo.countRecurringIssues(tenant.org.id)).toBe(0);
+    const rule = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    expect(rule).toMatchObject({
+      createdBy: tenant.userIds.member,
+      lastOccurrenceOn: null,
+      paused: false,
+      priority: "none",
+      assigneeId: null,
+      weekday: null,
+    });
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toEqual(rule);
+  });
+
+  it("enforces tenant scope, project existence, archive state and permissions", async () => {
+    const tenant = await createTenant("recurring-gates");
+    const other = await createTenant("recurring-other");
+    await expect(createRecurringIssue(tenant.actors.member, ruleInput(other)))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), projectId: other.project.id,
+    })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(createRecurringIssue(tenant.actors.viewer, ruleInput(tenant)))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(createRecurringIssue(tenant.actors.member, ruleInput(tenant)))
+      .rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await recurringRepo.countRecurringIssues(tenant.org.id)).toBe(0);
+  });
+
+  it("requires an active assignee in the same organization", async () => {
+    const tenant = await createTenant("recurring-assignee");
+    const other = await createTenant("recurring-assignee-other");
+    await expect(createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), assigneeId: other.userIds.member,
+    })).rejects.toThrow();
+    const member = await memberRepo.findMember(tenant.org.id, tenant.userIds.viewer);
+    await memberRepo.archiveMember(tenant.org.id, member!.id);
+    await expect(createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), assigneeId: tenant.userIds.viewer,
+    })).rejects.toThrow();
+    expect(await createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), assigneeId: tenant.userIds.admin,
+    })).toMatchObject({ assigneeId: tenant.userIds.admin });
+  });
+
+  it.each(["free", "starter", "growth"] as const)("caps all %s rules, including paused ones", async (plan) => {
+    const tenant = await createTenant(`recurring-quota-${plan}`, plan);
+    const limit = getLimit(plan, "recurringIssues");
+    expect(limit).toBe({ free: 0, starter: 3, growth: 25 }[plan]);
+    for (let index = 0; index < limit; index += 1) {
+      const rule = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+      await setRecurringIssuePaused(tenant.actors.member, {
+        orgId: tenant.org.id, recurringIssueId: rule.id, paused: true,
+      });
+    }
+    await expect(createRecurringIssue(tenant.actors.member, ruleInput(tenant))).rejects.toThrow();
+    expect(await recurringRepo.countRecurringIssues(tenant.org.id)).toBe(limit);
+    expect(await checkLimit(tenant.org.id, "recurringIssues")).toMatchObject({
+      limit, used: limit, exceeded: true,
+    });
+  });
+
+  it("keeps enterprise unlimited and guards the last slot during simultaneous creates", async () => {
+    expect(getLimit("enterprise", "recurringIssues")).toBe(UNLIMITED);
+    const tenant = await createTenant("recurring-concurrent", "starter");
+    await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    const results = await Promise.allSettled([
+      createRecurringIssue(tenant.actors.member, ruleInput(tenant)),
+      createRecurringIssue(tenant.actors.member, ruleInput(tenant)),
+    ]);
+    expect(results.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    expect(await recurringRepo.countRecurringIssues(tenant.org.id)).toBe(3);
+  });
+
+  it("lists in creation order and scopes pause and list operations", async () => {
+    const tenant = await createTenant("recurring-list");
+    const other = await createTenant("recurring-list-other");
+    const first = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    const second = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    const pauseInput = { orgId: tenant.org.id, recurringIssueId: first.id, paused: true };
+    await expect(setRecurringIssuePaused(tenant.actors.viewer, pauseInput))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(setRecurringIssuePaused(other.actors.member, pauseInput))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(setRecurringIssuePaused(other.actors.member, {
+      ...pauseInput, orgId: other.org.id,
+    })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(listRecurringIssues(other.actors.viewer, tenant.org.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await setRecurringIssuePaused(tenant.actors.member, pauseInput);
+    expect((await listRecurringIssues(tenant.actors.viewer, tenant.org.id)).map((rule) => rule.id))
+      .toEqual([first.id, second.id]);
+    await setRecurringIssuePaused(tenant.actors.member, { ...pauseInput, paused: false });
+    expect((await recurringRepo.findRecurringIssueById(tenant.org.id, first.id))?.paused).toBe(false);
+  });
+});

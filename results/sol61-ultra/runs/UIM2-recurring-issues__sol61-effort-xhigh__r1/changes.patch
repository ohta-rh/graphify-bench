+  weekday: number | null;
+  timezone: string;
+  startsOn: string;
+  lastOccurrenceOn: string | null;
+  paused: boolean;
+  createdBy: UserId;
+  createdAt: IsoTimestamp;
+  updatedAt: IsoTimestamp;
+}

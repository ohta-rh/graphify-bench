+import { describe, expect, it } from "vitest";
+import { idFactory } from "@/lib/id";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+
+const nextId = idFactory(53);
+const input = {
+  orgId: nextId(),
+  projectId: nextId(),
+  title: "Daily triage",
+  cadence: "daily" as const,
+  timezone: "UTC",
+  startsOn: "2026-03-05",
+};
+
+describe("recurring issue input", () => {
+  it("applies defaults and accepts real leap days and IANA aliases", () => {
+    expect(createRecurringIssueSchema.parse(input)).toMatchObject({
+      priority: "none", assigneeId: null, weekday: null,
+    });
+    expect(createRecurringIssueSchema.safeParse({
+      ...input, startsOn: "2024-02-29", timezone: "US/Eastern",
+    }).success).toBe(true);
+  });
+
+  it.each([
+    { cadence: "weekly" },
+    { cadence: "daily", weekday: 1 },
+    { cadence: "weekly", weekday: 0 },
+    { cadence: "weekly", weekday: 8 },
+    { cadence: "weekly", weekday: 2.5 },
+    { startsOn: "2026-02-30" },
+    { startsOn: "2026-02-29" },
+    { startsOn: "1900-02-29" },
+    { startsOn: "2026-04-31" },
+    { startsOn: "2026-3-05" },
+    { startsOn: "2026-03-05T00:00:00Z" },
+    { timezone: "Mars/Olympus" },
+    { timezone: "+01:00" },
+    { timezone: "" },
+    { orgId: "bad-id" },
+    { projectId: "bad-id" },
+    { assigneeId: "bad-id" },
+    { title: "ab" },
+    { title: "a".repeat(181) },
+  ])("rejects invalid fields: %j", (patch) => {
+    expect(createRecurringIssueSchema.safeParse({ ...input, ...patch }).success).toBe(false);
+  });
+
+  it.each([1, 7])("accepts ISO weekday %i for weekly rules", (weekday) => {
+    expect(createRecurringIssueSchema.safeParse({
+      ...input, cadence: "weekly", weekday,
+    }).success).toBe(true);
+  });
+});

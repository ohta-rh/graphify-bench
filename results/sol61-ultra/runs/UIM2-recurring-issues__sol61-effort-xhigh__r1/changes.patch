+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { eq } from "drizzle-orm";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { getDb, members, recurringIssues } from "@/server/db";
+import { drain, enqueue, resetQueue } from "@/server/jobs/queue";
+import { runRecurringIssueJob } from "@/server/jobs/recurring-issue-job";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { createRecurringIssue, setRecurringIssuePaused } from "@/server/services/recurring-issue-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+import type { Issue } from "@/types/issue";
+
+const NOW = new Date("2026-03-05T12:00:00Z");
+const ruleInput = (tenant: Tenant) => ({
+  orgId: tenant.org.id,
+  projectId: tenant.project.id,
+  title: "Daily triage",
+  cadence: "daily" as const,
+  timezone: "UTC",
+  startsOn: "2026-03-05",
+});
+const issuesFor = async (tenant: Tenant) => (await issueRepo.listIssues({
+  orgId: tenant.org.id, projectId: tenant.project.id, limit: 100,
+})).items;
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+beforeEach(() => { getDb().delete(recurringIssues).run(); });
+afterEach(() => { resetQueue(); vi.useRealTimers(); });
+afterAll(() => { cleanup(); });
+
+describe("recurring issue job", () => {
+  it("creates ordinary issues for every organization with creator attribution and events", async () => {
+    const tenant = await createTenant("recurring-job-create");
+    const other = await createTenant("recurring-job-create-other");
+    const rule = await createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), priority: "high", assigneeId: tenant.userIds.viewer,
+    });
+    await createRecurringIssue(other.actors.owner, ruleInput(other));
+    const seen: unknown[] = [];
+    const off = subscribe("issue.created", (event) => { seen.push(event); });
+    try {
+      const result = await runRecurringIssueJob(NOW);
+      expect(result).toMatchObject({ kind: "recurring-issues", processed: 2, failed: 0 });
+      const issues = await issuesFor(tenant);
+      expect(issues).toHaveLength(1);
+      expect(issues[0]).toMatchObject({
+        orgId: tenant.org.id, projectId: tenant.project.id,
+        title: "Daily triage (2026-03-05)", authorId: tenant.userIds.member,
+        status: "backlog", priority: "high", assigneeId: tenant.userIds.viewer,
+        description: null, dueAt: null, parentId: null, estimate: null, labelIds: [],
+      });
+      expect(seen).toContainEqual(expect.objectContaining({
+        orgId: tenant.org.id, actorId: tenant.userIds.member, issueId: issues[0].id,
+      }));
+      expect((await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id))?.lastOccurrenceOn)
+        .toBe("2026-03-05");
+      expect(await issuesFor(other)).toHaveLength(1);
+    } finally { off(); }
+  });
+
+  it("uses only the latest occurrence, persists deduplication and ignores backward clocks", async () => {
+    const tenant = await createTenant("recurring-job-latest");
+    await createRecurringIssue(tenant.actors.member, { ...ruleInput(tenant), startsOn: "2020-01-01" });
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(1);
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(0);
+    expect((await runRecurringIssueJob(new Date("2026-03-04T12:00:00Z"))).processed).toBe(0);
+    expect((await runRecurringIssueJob(new Date("2026-04-01T12:00:00Z"))).processed).toBe(1);
+    expect((await issuesFor(tenant)).map((issue) => issue.title).sort()).toEqual([
+      "Daily triage (2026-03-05)", "Daily triage (2026-04-01)",
+    ]);
+  });
+
+  it.each([
+    ["tokyo", "Asia/Tokyo", "2026-03-05", "2026-03-04T15:00:00Z"],
+    ["kiritimati", "Pacific/Kiritimati", "2026-03-05", "2026-03-04T10:00:00Z"],
+    ["spring", "America/Los_Angeles", "2026-03-09", "2026-03-09T07:00:00Z"],
+    ["fall", "America/Los_Angeles", "2026-11-02", "2026-11-02T08:00:00Z"],
+  ])("waits until local midnight in %s", async (slug, timezone, startsOn, midnight) => {
+    const tenant = await createTenant(`recurring-midnight-${slug}`);
+    await createRecurringIssue(tenant.actors.member, { ...ruleInput(tenant), timezone, startsOn });
+    const now = new Date(midnight);
+    expect((await runRecurringIssueJob(new Date(now.getTime() - 1))).processed).toBe(0);
+    expect((await runRecurringIssueJob(now)).processed).toBe(1);
+    expect((await issuesFor(tenant))[0].title).toBe(`Daily triage (${startsOn})`);
+  });
+
+  it.each([
+    ["spring", "2026-03-08", "2026-03-08T08:00:00Z", "2026-03-09T07:00:00Z"],
+    ["fall", "2026-11-01", "2026-11-01T07:00:00Z", "2026-11-02T08:00:00Z"],
+  ])("advances on the %s daylight-saving day", async (slug, startsOn, first, second) => {
+    const tenant = await createTenant(`recurring-dst-${slug}`);
+    await createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), timezone: "America/Los_Angeles", startsOn,
+    });
+    expect((await runRecurringIssueJob(new Date(first))).processed).toBe(1);
+    expect((await runRecurringIssueJob(new Date(new Date(second).getTime() - 1))).processed).toBe(0);
+    expect((await runRecurringIssueJob(new Date(second))).processed).toBe(1);
+  });
+
+  it("finds the latest ISO weekday on or after startsOn without backfilling", async () => {
+    const tenant = await createTenant("recurring-job-weekly");
+    await createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), cadence: "weekly", weekday: 1, startsOn: "2026-03-03",
+    });
+    expect((await runRecurringIssueJob(new Date("2026-03-08T23:59:59Z"))).processed).toBe(0);
+    expect((await runRecurringIssueJob(new Date("2026-03-09T00:00:00Z"))).processed).toBe(1);
+    expect((await runRecurringIssueJob(new Date("2026-03-26T12:00:00Z"))).processed).toBe(1);
+    expect((await issuesFor(tenant)).map((issue) => issue.title).sort()).toEqual([
+      "Daily triage (2026-03-09)", "Daily triage (2026-03-23)",
+    ]);
+  });
+
+  it("uses 7 for Sunday and leaves paused or future rules unchanged", async () => {
+    const tenant = await createTenant("recurring-job-sunday");
+    await createRecurringIssue(tenant.actors.member, {
+      ...ruleInput(tenant), cadence: "weekly", weekday: 7,
+    });
+    await createRecurringIssue(tenant.actors.member, { ...ruleInput(tenant), startsOn: "2030-01-01" });
+    const paused = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    await setRecurringIssuePaused(tenant.actors.member, {
+      orgId: tenant.org.id, recurringIssueId: paused.id, paused: true,
+    });
+    const before = await recurringRepo.listRecurringIssues(tenant.org.id);
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(0);
+    expect(await recurringRepo.listRecurringIssues(tenant.org.id)).toEqual(before);
+    expect((await runRecurringIssueJob(new Date("2026-03-08T00:00:00Z"))).processed).toBe(1);
+    expect((await issuesFor(tenant))[0].title).toBe("Daily triage (2026-03-08)");
+  });
+
+  it("skips archived projects unchanged, then files the latest day after restoration", async () => {
+    const tenant = await createTenant("recurring-job-archive");
+    const rule = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(0);
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toEqual(rule);
+    await projectRepo.restoreProject(tenant.org.id, tenant.project.id);
+    expect((await runRecurringIssueJob(new Date("2026-03-20T12:00:00Z"))).processed).toBe(1);
+    expect((await issuesFor(tenant))[0].title).toBe("Daily triage (2026-03-20)");
+  });
+
+  it.each(["removed", "suspended", "viewer"])("pauses rules whose creator is %s", async (state) => {
+    const tenant = await createTenant(`recurring-job-creator-${state}`);
+    const rule = await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    const member = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    if (state === "removed") await memberRepo.archiveMember(tenant.org.id, member.id);
+    if (state === "suspended") getDb().update(members).set({ status: "suspended" }).where(eq(members.id, member.id)).run();
+    if (state === "viewer") await memberRepo.updateMemberRole(tenant.org.id, member.id, "viewer");
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(0);
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toMatchObject({
+      paused: true, lastOccurrenceOn: null,
+    });
+    expect(await issuesFor(tenant)).toHaveLength(0);
+  });
+
+  it("unassigns removed assignees without changing the rule", async () => {
+    const tenant = await createTenant("recurring-job-assignee");
+    const rule = await createRecurringIssue(tenant.actors.owner, {
+      ...ruleInput(tenant), assigneeId: tenant.userIds.member,
+    });
+    const assignee = (await memberRepo.findMember(tenant.org.id, tenant.userIds.member))!;
+    await memberRepo.archiveMember(tenant.org.id, assignee.id);
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(1);
+    expect((await issuesFor(tenant))[0].assigneeId).toBeNull();
+    expect(await recurringRepo.findRecurringIssueById(tenant.org.id, rule.id)).toMatchObject({
+      paused: false, assigneeId: tenant.userIds.member,
+    });
+  });
+
+  it("leaves quota refusals unchanged, continues other rules, and retries later", async () => {
+    const full = await createTenant("recurring-job-quota", "starter");
+    let last: Issue | undefined;
+    for (let number = 1; number <= 1_000; number += 1) {
+      last = await issueRepo.insertIssue(issueInput(full.org.id, full.project.id), full.userIds.member, number);
+    }
+    const rule = await createRecurringIssue(full.actors.member, ruleInput(full));
+    const healthy = await createTenant("recurring-job-healthy");
+    await createRecurringIssue(healthy.actors.member, ruleInput(healthy));
+    expect(await runRecurringIssueJob(NOW)).toMatchObject({ processed: 1, failed: 1 });
+    expect(await recurringRepo.findRecurringIssueById(full.org.id, rule.id)).toEqual(rule);
+    expect(await issuesFor(healthy)).toHaveLength(1);
+    await issueRepo.archiveIssue(full.org.id, last!.id);
+    expect((await runRecurringIssueJob(NOW)).processed).toBe(1);
+    expect(await recurringRepo.findRecurringIssueById(full.org.id, rule.id)).toMatchObject({
+      lastOccurrenceOn: "2026-03-05", paused: false,
+    });
+  });
+
+  it("deduplicates overlapping sweeps and dispatches through the queue with the current time", async () => {
+    const tenant = await createTenant("recurring-job-queue");
+    await createRecurringIssue(tenant.actors.member, ruleInput(tenant));
+    const results = await Promise.all([runRecurringIssueJob(NOW), runRecurringIssueJob(NOW)]);
+    expect(results.reduce((sum, result) => sum + result.processed, 0)).toBe(1);
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.setSystemTime(new Date("2026-03-06T12:00:00Z"));
+    enqueue({
+      id: "recurring-issues:now", kind: "recurring-issues",
+      runAt: toIsoTimestamp(NOW), attempts: 0, payload: {},
+    });
+    expect(await drain()).toBe(1);
+    expect((await issuesFor(tenant)).map((issue) => issue.title).sort()).toEqual([
+      "Daily triage (2026-03-05)", "Daily triage (2026-03-06)",
+    ]);
+  });
+});

+import { createLogger } from "@/lib/logger";
+import { can, PermissionDeniedError } from "@/lib/permissions";
+import { isArchived } from "@/lib/soft-delete";
+import { createIssueSchema } from "@/schemas/issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource, requireFound } from "@/server/services/_support";
+import { createIssue } from "@/server/services/issue-service";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+
+const logger = createLogger("recurring-issue-job");
+// The app has one job process. Serialize overlapping sweeps so each reads the
+// occurrence markers committed by the previous one before creating issues.
+let previousRun: Promise<void> = Promise.resolve();
+
+/** UTC is used only as a container for civil-date arithmetic, never to
+ * measure a local day's length: those days can have 23 or 25 hours. */
+function latestOccurrence(rule: RecurringIssue, now: Date): string | null {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: rule.timezone,
+    calendar: "iso8601",
+    numberingSystem: "latn",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: string) => parts.find((value) => value.type === type)!.value;
+  const today = `${part("year").padStart(4, "0")}-${part("month")}-${part("day")}`;
+  if (today < rule.startsOn) return null;
+
+  let occurrence = today;
+  if (rule.cadence === "weekly") {
+    if (rule.weekday === null) return null;
+    const date = new Date(`${today}T00:00:00.000Z`);
+    const weekday = date.getUTCDay() || 7;
+    date.setUTCDate(date.getUTCDate() - (weekday - rule.weekday + 7) % 7);
+    occurrence = date.toISOString().slice(0, 10);
+  }
+  return occurrence >= rule.startsOn ? occurrence : null;
+}
+
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  const run = previousRun.then(() => runJob("recurring-issues", async (result) => {
+    const rules = await recurringRepo.listUnpausedRecurringIssues();
+    for (const rule of rules) {
+      try {
+        const occurrence = latestOccurrence(rule, now);
+        if (occurrence === null ||
+            (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn)) {
+          continue;
+        }
+
+        const project = requireFound(
+          await projectRepo.findProjectById(rule.orgId, rule.projectId),
+          "Project", rule.projectId,
+        );
+        if (isArchived(project)) continue;
+
+        const creator = await memberRepo.findMember(rule.orgId, rule.createdBy);
+        if (!creator || creator.status !== "active") {
+          await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+        const actor: Actor = {
+          orgId: rule.orgId,
+          userId: creator.userId,
+          role: creator.role,
+        };
+        if (!can(actor, "issue:create", projectResource(project))) {
+          await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+
+        const assignee = rule.assigneeId === null ? null :
+          await memberRepo.findMember(rule.orgId, rule.assigneeId);
+        await createIssue(actor, createIssueSchema.parse({
+          orgId: rule.orgId,
+          projectId: rule.projectId,
+          title: `${rule.title} (${occurrence})`,
+          priority: rule.priority,
+          assigneeId: assignee?.status === "active" ? assignee.userId : null,
+        }));
+        result.processed += 1;
+        await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, {
+          lastOccurrenceOn: occurrence,
+        });
+      } catch (error) {
+        // A permission failure at the normal creation gate also disables the
+        // rule. Quota and other transient refusals leave it available to retry.
+        if (error instanceof PermissionDeniedError) {
+          try {
+            await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { paused: true });
+          } catch (pauseError) {
+            logger.error("failed to pause recurring issue", {
+              recurringIssueId: rule.id,
+              reason: pauseError instanceof Error ? pauseError.message : String(pauseError),
+            });
+          }
+        }
+        result.failed += 1;
+        logger.error("failed to file recurring issue", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  }));
+  previousRun = run.then(() => undefined, () => undefined);
+  return run;
+}

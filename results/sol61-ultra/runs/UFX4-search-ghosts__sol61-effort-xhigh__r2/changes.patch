+function documents(orgId: OrgId) {
+  return getDb().select().from(searchIndex).where(eq(searchIndex.orgId, orgId)).all();
+}
+
+function documentKeys(orgId: OrgId) {
+  return documents(orgId).map((row) => `${row.subjectKind}:${row.subjectId}`).sort();
+}

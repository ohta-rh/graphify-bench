@@ -0,0 +1,17 @@
+import { emit, subscribe } from "@/lib/event-bus";
+import * as tokenRepo from "@/server/repositories/api-token-repository";
+import type { Unsubscribe } from "@/types/event";
+
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const revoked = await tokenRepo.revokeUserApiTokens(
+      payload.orgId, payload.userId, payload.occurredAt,
+    );
+    await Promise.all(revoked.map((apiToken) => emit("api_token.revoked", {
+      orgId: payload.orgId,
+      actorId: payload.actorId,
+      occurredAt: payload.occurredAt,
+      apiTokenId: apiToken.id,
+    })));
+  });
+}

+import { emit } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import * as tokenRepo from "@/server/repositories/api-token-repository";
+import type { ApiToken } from "@/types/api-token";
+import { toIsoTimestamp } from "@/types/common";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import { actorEnvelope, requireFound } from "./_support";
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  assertCan(actor, parsed.scope === "read" ? "api_token:create_read" : "api_token:create_write", {
+    kind: "api_token", orgId: parsed.orgId, userId: actor.userId,
+  });
+
+  const now = new Date();
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await tokenRepo.insertApiToken({
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * MS_PER_DAY)),
+    lastUsedAt: null,
+    revokedAt: null,
+    createdAt: toIsoTimestamp(now),
+  }, hashToken(token));
+
+  await emit("api_token.created", { ...actorEnvelope(actor), apiTokenId: apiToken.id });
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "api_token:read", { kind: "api_token", orgId, userId });
+  return tokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const current = requireFound(await tokenRepo.findApiToken(orgId, tokenId), "API token", tokenId);
+  assertCan(actor, "api_token:revoke", { kind: "api_token", orgId, userId: current.userId });
+  if (current.revokedAt !== null) return current;
+
+  const revoked = await tokenRepo.revokeApiToken(orgId, tokenId, toIsoTimestamp(new Date()));
+  if (!revoked) {
+    return requireFound(await tokenRepo.findApiToken(orgId, tokenId), "API token", tokenId);
+  }
+  await emit("api_token.revoked", { ...actorEnvelope(actor), apiTokenId: revoked.id });
+  return revoked;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const result = await tokenRepo.useApiToken(hashToken(token), toIsoTimestamp(new Date()));
+  if (!result) return null;
+  const { apiToken, memberRole } = result;
+  return {
+    userId: apiToken.userId,
+    orgId: apiToken.orgId,
+    role: apiToken.scope === "read" ? "viewer" : memberRole,
+  };
+}

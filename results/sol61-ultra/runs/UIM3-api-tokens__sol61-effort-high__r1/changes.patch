@@ -0,0 +1,142 @@
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import type { ApiTokenRow } from "@/server/db/schema/api-tokens";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import { brandId, brandStamp } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+
+/** Explicit projection keeps the stored hash out of all returned metadata. */
+function toApiToken(row: ApiTokenRow): ApiToken {
+  return {
+    id: row.id,
+    orgId: brandId<OrgId>(row.orgId),
+    userId: brandId<UserId>(row.userId),
+    name: row.name,
+    scope: row.scope,
+    prefix: row.prefix,
+    expiresAt: brandStamp(row.expiresAt),
+    lastUsedAt: row.lastUsedAt === null ? null : brandStamp(row.lastUsedAt),
+    revokedAt: row.revokedAt === null ? null : brandStamp(row.revokedAt),
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+/** Count and insert are synchronous within one transaction, including concurrent callers. */
+export async function insertApiToken(
+  input: Omit<ApiToken, "id">,
+  tokenHash: string,
+): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const usable = tx
+      .select({ value: count() })
+      .from(apiTokens)
+      .where(and(
+        orgPredicate(apiTokens.orgId, input.orgId),
+        eq(apiTokens.userId, input.userId),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, input.createdAt),
+      ))
+      .get();
+
+    if ((usable?.value ?? 0) >= 5) {
+      throw new Error("A user may have at most 5 usable API tokens per organization");
+    }
+
+    const row = tx.insert(apiTokens)
+      .values({ ...input, id: newId(), tokenHash })
+      .returning().get();
+    return toApiToken(row);
+  });
+}
+
+export async function listApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id))
+    .all().map(toApiToken);
+}
+
+export async function findApiToken(orgId: OrgId, tokenId: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Only the caller that actually changes the row receives it for auditing. */
+export async function revokeApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at })
+    .where(and(
+      orgPredicate(apiTokens.orgId, orgId),
+      eq(apiTokens.id, tokenId),
+      isNull(apiTokens.revokedAt),
+    ))
+    .returning().get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Expiration is deliberately irrelevant when a membership is removed. */
+export async function revokeUserApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at })
+    .where(and(
+      orgPredicate(apiTokens.orgId, orgId),
+      eq(apiTokens.userId, userId),
+      isNull(apiTokens.revokedAt),
+    ))
+    .returning().all().map(toApiToken);
+}
+
+/**
+ * Authentication is the sole lookup without an org supplied by the caller.
+ * The hash identifies its tenant; live membership and organization checks and
+ * the successful-use timestamp are applied together in one transaction.
+ */
+export async function useApiToken(
+  tokenHash: string,
+  at: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; memberRole: Role } | null> {
+  return getDb().transaction((tx) => {
+    const row = tx.select({ token: apiTokens, memberRole: members.role })
+      .from(apiTokens)
+      .innerJoin(members, and(
+        eq(members.orgId, apiTokens.orgId),
+        eq(members.userId, apiTokens.userId),
+      ))
+      .innerJoin(organizations, eq(organizations.id, apiTokens.orgId))
+      .where(and(
+        eq(apiTokens.tokenHash, tokenHash),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, at),
+        eq(members.status, "active"),
+        livePredicate(members.archivedAt, {}),
+        livePredicate(organizations.archivedAt, {}),
+      ))
+      .get();
+    if (!row) return null;
+
+    tx.update(apiTokens).set({ lastUsedAt: at })
+      .where(and(
+        orgPredicate(apiTokens.orgId, brandId<OrgId>(row.token.orgId)),
+        eq(apiTokens.id, row.token.id),
+      ))
+      .run();
+    return {
+      apiToken: toApiToken({ ...row.token, lastUsedAt: at }),
+      memberRole: row.memberRole,
+    };
+  });
+}

+it("upgrades existing notifications and persists project mutes across repeated migrations", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "taskflow-migration-"));
+  const path = join(dir, "taskflow.db");
+  const sqlite = new Database(path);
+  try {
+    sqlite.exec(`
+      CREATE TABLE notifications (
+        id TEXT PRIMARY KEY NOT NULL, org_id TEXT NOT NULL,
+        recipient_id TEXT NOT NULL, kind TEXT NOT NULL, title TEXT NOT NULL,
+        body TEXT NOT NULL, href TEXT NOT NULL, actor_id TEXT, read_at TEXT,
+        channels TEXT NOT NULL DEFAULT '["in_app"]',
+        created_at TEXT NOT NULL, updated_at TEXT NOT NULL
+      );
+      INSERT INTO notifications (id, org_id, recipient_id, kind, title, body, href, created_at, updated_at)
+      VALUES ('notification', 'org', 'user', 'member_joined', 'Welcome', 'Welcome', '/members', '2026-06-01', '2026-06-01');
+    `);
+    await runMigrations(path);
+    sqlite.prepare("INSERT INTO project_mutes (org_id, user_id, project_id) VALUES (?, ?, ?)")
+      .run("org", "user", "project");
+    await runMigrations(path);
+
+    expect(sqlite.prepare("SELECT id, project_id, read_at FROM notifications").all()).toEqual([
+      { id: "notification", project_id: null, read_at: null },
+    ]);
+    expect(sqlite.prepare("SELECT * FROM project_mutes").all()).toEqual([
+      { org_id: "org", user_id: "user", project_id: "project" },
+    ]);
+    expect(() => sqlite.prepare("INSERT INTO project_mutes (org_id, user_id, project_id) VALUES (?, ?, ?)")
+      .run("org", "user", "project")).toThrow();
+  } finally {
+    sqlite.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});

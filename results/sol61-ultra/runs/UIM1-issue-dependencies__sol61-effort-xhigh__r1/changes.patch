+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { eq } from "drizzle-orm";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { updateNotificationPreferenceSchema } from "@/schemas/notification";
+import { getDb, issueDependencies, notifications } from "@/server/db";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { registerEventHandlers, unregisterEventHandlers } from "@/server/services/event-registry";
+import { addBlocker, IssueBlockedError, listBlockers, removeBlocker } from "@/server/services/issue-dependency-service";
+import * as issueService from "@/server/services/issue-service";
+import { updatePreference } from "@/server/services/notification-service";
+import { archiveProject } from "@/server/services/project-service";
+import type { CreateIssueInput } from "@/schemas/issue";
+import type { IssueId } from "@/types/common";
+import type { Issue } from "@/types/issue";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+let tenant: Tenant;
+let other: Tenant;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  tenant = await createTenant("dependencies");
+  other = await createTenant("other-dependencies");
+  registerEventHandlers();
+});
+
+afterAll(() => {
+  unregisterEventHandlers();
+  cleanup();
+});
+
+function createIssue(overrides: Partial<CreateIssueInput> = {}): Promise<Issue> {
+  return issueService.createIssue(tenant.actors.member, {
+    ...issueInput(tenant.org.id, tenant.project.id),
+    ...overrides,
+  });
+}
+
+function link(issue: Issue, blocker: Issue) {
+  return { orgId: tenant.org.id, issueId: issue.id, blockerId: blocker.id };
+}
+
+function unblockedNotifications(issue: Issue) {
+  return getDb().select().from(notifications)
+    .where(eq(notifications.kind, "issue_unblocked")).all()
+    .filter((row) => row.href === `/issues/${issue.id}`);
+}
+
+function setStatus(issue: Issue, status: Issue["status"]) {
+  return issueService.changeIssueStatus(tenant.actors.member, {
+    orgId: tenant.org.id, issueId: issue.id, status,
+  });
+}
+
+describe("issue dependencies", () => {
+  it("persists a unique link with the original author and timestamp", async () => {
+    const issue = await createIssue();
+    const blocker = await createIssue();
+    const input = link(issue, blocker);
+    const dependency = await addBlocker(tenant.actors.member, input);
+    expect(dependency).toMatchObject({ ...input, createdBy: tenant.userIds.member });
+    expect(new Date(dependency.createdAt).toISOString()).toBe(dependency.createdAt);
+    expect(await addBlocker(tenant.actors.owner, input)).toEqual(dependency);
+    expect(await listBlockers(tenant.actors.viewer, tenant.org.id, issue.id))
+      .toEqual([blocker]);
+    expect(await removeBlocker(tenant.actors.member, input)).toBe(true);
+    expect(await removeBlocker(tenant.actors.member, input)).toBe(false);
+  });
+
+  it("requires the blocked issue's edit permission, including ownership", async () => {
+    const issue = await createIssue();
+    const blocker = await createIssue({ assigneeId: tenant.userIds.viewer });
+    await expect(addBlocker(tenant.actors.viewer, link(issue, blocker)))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await addBlocker(tenant.actors.member, link(issue, blocker));
+    await expect(removeBlocker(tenant.actors.viewer, link(issue, blocker)))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    expect(await listBlockers(tenant.actors.viewer, tenant.org.id, issue.id)).toHaveLength(1);
+    const owned = await createIssue({ assigneeId: tenant.userIds.viewer });
+    await addBlocker(tenant.actors.viewer, link(owned, blocker));
+    expect(await removeBlocker(tenant.actors.viewer, link(owned, blocker))).toBe(true);
+  });
+
+  it("rejects foreign scope and missing or foreign rows without storing links", async () => {
+    const issue = await createIssue();
+    const foreign = await issueService.createIssue(other.actors.member,
+      issueInput(other.org.id, other.project.id));
+    const unknown = "missing-issue" as IssueId;
+    const before = getDb().select().from(issueDependencies).all();
+    await expect(addBlocker(other.actors.owner, link(issue, issue)))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(removeBlocker(other.actors.owner, link(issue, issue)))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(listBlockers(other.actors.owner, tenant.org.id, issue.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    for (const id of [foreign.id, unknown]) {
+      await expect(addBlocker(tenant.actors.member, { ...link(issue, issue), blockerId: id }))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(addBlocker(tenant.actors.member, { ...link(issue, issue), issueId: id }))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(removeBlocker(tenant.actors.member, { ...link(issue, issue), issueId: id }))
+        .rejects.toBeInstanceOf(NotFoundError);
+      await expect(listBlockers(tenant.actors.member, tenant.org.id, id))
+        .rejects.toBeInstanceOf(NotFoundError);
+      expect(await removeBlocker(tenant.actors.member, { ...link(issue, issue), blockerId: id }))
+        .toBe(false);
+    }
+    expect(getDb().select().from(issueDependencies).all()).toEqual(before);
+  });
+
+  it("rejects self links and cycles of any length without partial writes", async () => {
+    const [a, b, c, d] = [await createIssue(), await createIssue(), await createIssue(), await createIssue()];
+    await expect(addBlocker(tenant.actors.member, link(a, a))).rejects.toThrow();
+    await addBlocker(tenant.actors.member, link(a, b));
+    await expect(addBlocker(tenant.actors.member, link(b, a))).rejects.toThrow();
+    await addBlocker(tenant.actors.member, link(b, c));
+    await addBlocker(tenant.actors.member, link(c, d));
+    await setStatus(b, "canceled");
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, c.id);
+    await expect(addBlocker(tenant.actors.member, link(d, a))).rejects.toThrow();
+    expect(await listBlockers(tenant.actors.member, tenant.org.id, d.id)).toEqual([]);
+  });
+
+  it("rejects archived endpoints and lists live blockers by issue number", async () => {
+    const first = await createIssue({ status: "done" });
+    const second = await createIssue();
+    const archived = await createIssue();
+    const issue = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, second));
+    await addBlocker(tenant.actors.member, link(issue, archived));
+    await addBlocker(tenant.actors.member, link(issue, first));
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, archived.id);
+    expect((await listBlockers(tenant.actors.member, tenant.org.id, issue.id)).map((row) => row.id))
+      .toEqual([first.id, second.id]);
+    await expect(addBlocker(tenant.actors.member, link(issue, archived)))
+      .rejects.toBeInstanceOf(AlreadyArchivedError);
+    await expect(addBlocker(tenant.actors.member, link(archived, issue)))
+      .rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await removeBlocker(tenant.actors.member, link(issue, archived))).toBe(true);
+  });
+
+  it("gates completion and board moves before writes or status events", async () => {
+    const issue = await createIssue();
+    const open = await createIssue();
+    const second = await createIssue();
+    const closed = await createIssue({ status: "canceled" });
+    const archived = await createIssue();
+    for (const blocker of [open, second, closed, archived]) {
+      await addBlocker(tenant.actors.member, link(issue, blocker));
+    }
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, archived.id);
+    const received = vi.fn();
+    const off = subscribe("issue.status_changed", received);
+    try {
+      for (const complete of [
+        () => setStatus(issue, "done"),
+        () => issueService.moveIssue(tenant.actors.member, {
+          orgId: tenant.org.id, issueId: issue.id, toStatus: "done", toIndex: 0,
+        }),
+      ]) {
+        const error = await complete().catch((error: unknown) => error);
+        expect(error).toBeInstanceOf(IssueBlockedError);
+        expect(error).toMatchObject({ code: "conflict", blockerIds: [open.id, second.id] });
+        expect(await issueRepo.findIssueById(tenant.org.id, issue.id)).toEqual(issue);
+      }
+      expect(received).not.toHaveBeenCalled();
+    } finally {
+      off();
+    }
+    for (const status of ["todo", "in_progress", "in_review", "canceled", "backlog"] as const) {
+      expect((await setStatus(issue, status)).status).toBe(status);
+    }
+    await setStatus(open, "done");
+    await setStatus(second, "canceled");
+    expect((await setStatus(issue, "done")).status).toBe("done");
+  });
+
+  it("notifies on the last open blocker, and again after reopening", async () => {
+    const issue = await createIssue({ assigneeId: tenant.userIds.admin });
+    const first = await createIssue();
+    const last = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, first));
+    await addBlocker(tenant.actors.member, link(issue, last));
+    registerEventHandlers();
+    await setStatus(first, "done");
+    expect(unblockedNotifications(issue)).toHaveLength(0);
+    await setStatus(last, "canceled");
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    expect(unblockedNotifications(issue)[0]).toMatchObject({
+      recipientId: tenant.userIds.admin, actorId: tenant.userIds.member,
+      href: `/issues/${issue.id}`,
+    });
+    await setStatus(last, "done");
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    await setStatus(last, "todo");
+    await setStatus(last, "done");
+    expect(unblockedNotifications(issue)).toHaveLength(2);
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, last.id);
+    expect(unblockedNotifications(issue)).toHaveLength(2);
+  });
+
+  it("notifies when an open blocker is archived, and never on link removal", async () => {
+    const issue = await createIssue({ assigneeId: tenant.userIds.admin });
+    const blocker = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, blocker));
+    await issueService.archiveIssue(tenant.actors.owner, tenant.org.id, blocker.id);
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    expect(unblockedNotifications(issue)[0].actorId).toBe(tenant.userIds.owner);
+    const next = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, next));
+    await removeBlocker(tenant.actors.member, link(issue, next));
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    expect((await setStatus(issue, "done")).status).toBe("done");
+  });
+
+  it("honors mute preferences and suppresses the actor's own notification", async () => {
+    const issue = await createIssue({ assigneeId: tenant.userIds.viewer });
+    const selfAssigned = await createIssue({ assigneeId: tenant.userIds.member });
+    const blocker = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, blocker));
+    await addBlocker(tenant.actors.member, link(selfAssigned, blocker));
+    const preference = updateNotificationPreferenceSchema.parse({
+      orgId: tenant.org.id, userId: tenant.userIds.viewer, kind: "issue_unblocked",
+      inApp: false, email: false, digestOnly: false,
+    });
+    await updatePreference(tenant.actors.viewer, preference);
+    await setStatus(blocker, "done");
+    expect(unblockedNotifications(issue)).toHaveLength(0);
+    expect(unblockedNotifications(selfAssigned)).toHaveLength(0);
+    await updatePreference(tenant.actors.viewer, { ...preference, inApp: true });
+    await setStatus(blocker, "backlog");
+    await setStatus(blocker, "canceled");
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    expect(JSON.parse(unblockedNotifications(issue)[0].channels)).toEqual(["in_app"]);
+  });
+
+  it("does not notify archived, closed or unassigned blocked issues", async () => {
+    const blocker = await createIssue();
+    const targets = [
+      await createIssue(),
+      await createIssue({ status: "done", assigneeId: tenant.userIds.admin }),
+      await createIssue({ status: "canceled", assigneeId: tenant.userIds.admin }),
+      await createIssue({ assigneeId: tenant.userIds.admin }),
+    ];
+    for (const issue of targets) await addBlocker(tenant.actors.member, link(issue, blocker));
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, targets[3].id);
+    await setStatus(blocker, "done");
+    for (const issue of targets) expect(unblockedNotifications(issue)).toHaveLength(0);
+  });
+
+  it("reattaches through the normal event registry without duplicate delivery", async () => {
+    unregisterEventHandlers();
+    registerEventHandlers();
+    registerEventHandlers();
+    const issue = await createIssue({ assigneeId: tenant.userIds.admin });
+    const blocker = await createIssue();
+    await addBlocker(tenant.actors.member, link(issue, blocker));
+    await setStatus(blocker, "done");
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+  });
+
+  it("unblocks across projects once when a cascade archives several blockers", async () => {
+    const project = await projectRepo.insertProject({
+      orgId: tenant.org.id, name: "Blocker project", slug: "blockers", key: "BLOCK",
+      description: null, visibility: "org", leadId: null, color: "#6366f1", targetDate: null,
+    });
+    const issue = await createIssue({ assigneeId: tenant.userIds.admin });
+    const first = await createIssue({ projectId: project.id });
+    const second = await createIssue({ projectId: project.id });
+    await addBlocker(tenant.actors.member, link(issue, first));
+    await addBlocker(tenant.actors.member, link(issue, second));
+    await archiveProject(tenant.actors.owner, {
+      orgId: tenant.org.id, projectId: project.id, archiveIssues: true,
+    });
+    expect(unblockedNotifications(issue)).toHaveLength(1);
+    expect(unblockedNotifications(issue)[0].actorId).toBe(tenant.userIds.owner);
+  });
+});

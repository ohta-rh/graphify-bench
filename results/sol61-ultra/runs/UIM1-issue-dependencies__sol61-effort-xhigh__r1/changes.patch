+import { index, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";
+import { nowIso, tenantColumns } from "./_shared";
+
+export const issueDependencies = sqliteTable(
+  "issue_dependencies",
+  {
+    ...tenantColumns,
+    issueId: text("issue_id").notNull(),
+    blockerId: text("blocker_id").notNull(),
+    createdBy: text("created_by").notNull(),
+    createdAt: text("created_at").notNull().$defaultFn(nowIso),
+  },
+  (table) => [
+    uniqueIndex("issue_dependencies_pk").on(
+      table.orgId,
+      table.issueId,
+      table.blockerId,
+    ),
+    index("issue_dependencies_org_blocker_idx").on(table.orgId, table.blockerId),
+  ],
+);
+
+export type IssueDependencyRow = typeof issueDependencies.$inferSelect;

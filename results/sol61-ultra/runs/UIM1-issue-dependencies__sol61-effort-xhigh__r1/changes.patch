@@ -0,0 +1,136 @@
+import { and, asc, eq, inArray, notInArray, sql } from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { toIsoTimestamp } from "@/types/common";
+import { brandId, toIssue, toIssueDependency } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import { listLabelsForIssues } from "./label-repository";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+/** Cycle detection and insertion share a synchronous SQLite transaction. */
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const existing = tx
+      .select()
+      .from(issueDependencies)
+      .where(and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ))
+      .get();
+    if (existing) return toIssueDependency(existing);
+
+    // Follow every link, including links through closed or archived issues.
+    // UNION makes traversal terminate even if legacy data contains a cycle.
+    const cycle = tx.get<{ id: string }>(sql`
+      WITH RECURSIVE blockers(id) AS (
+        SELECT blocker_id FROM issue_dependencies
+        WHERE org_id = ${orgId} AND issue_id = ${blockerId}
+        UNION
+        SELECT dependency.blocker_id FROM issue_dependencies AS dependency
+        INNER JOIN blockers ON dependency.issue_id = blockers.id
+        WHERE dependency.org_id = ${orgId}
+      )
+      SELECT id FROM blockers WHERE id = ${issueId} LIMIT 1
+    `);
+    if (issueId === blockerId || cycle) {
+      throw new Error("An issue dependency cannot create a cycle");
+    }
+
+    const row = tx
+      .insert(issueDependencies)
+      .values({ orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()) })
+      .returning()
+      .get();
+    return toIssueDependency(row);
+  });
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const result = getDb()
+    .delete(issueDependencies)
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      eq(issueDependencies.blockerId, blockerId),
+    ))
+    .run();
+  return result.changes > 0;
+}
+
+export async function listBlockerIssues(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.blockerId))
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      orgPredicate(issues.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      livePredicate(issues.archivedAt, {}),
+    ))
+    .orderBy(asc(issues.number), asc(issues.id))
+    .all();
+  const labels = await listLabelsForIssues(
+    orgId,
+    rows.map(({ issue }) => brandId<IssueId>(issue.id)),
+  );
+  return rows.map(({ issue }) =>
+    toIssue(issue, (labels[issue.id] ?? []).map((label) => label.id)),
+  );
+}
+
+export async function listOpenBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  const rows = getDb()
+    .select({ id: issues.id })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.blockerId))
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      orgPredicate(issues.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+    ))
+    .orderBy(asc(issues.number), asc(issues.id))
+    .all();
+  return rows.map(({ id }) => brandId<IssueId>(id));
+}
+
+/** A batch lookup also deduplicates issues affected by several closed blockers. */
+export async function listBlockedIssues(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+): Promise<readonly Issue[]> {
+  if (blockerIds.length === 0) return [];
+  const rows = getDb()
+    .selectDistinct({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(issues, eq(issues.id, issueDependencies.issueId))
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      orgPredicate(issues.orgId, orgId),
+      inArray(issueDependencies.blockerId, [...blockerIds]),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+    ))
+    .all();
+  return rows.map(({ issue }) => toIssue(issue));
+}

+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { apiTokens, getDb } from "@/server/db";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+// Explicit projection: neither the digest nor the secret crosses this boundary.
+const publicColumns = {
+  id: apiTokens.id,
+  orgId: apiTokens.orgId,
+  userId: apiTokens.userId,
+  name: apiTokens.name,
+  scope: apiTokens.scope,
+  prefix: apiTokens.prefix,
+  expiresAt: apiTokens.expiresAt,
+  lastUsedAt: apiTokens.lastUsedAt,
+  revokedAt: apiTokens.revokedAt,
+  createdAt: apiTokens.createdAt,
+};
+
+export async function insertApiToken(
+  apiToken: ApiToken,
+  tokenHash: string,
+): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const usable = tx.select({ value: count() }).from(apiTokens).where(and(
+      eq(apiTokens.orgId, apiToken.orgId),
+      eq(apiTokens.userId, apiToken.userId),
+      isNull(apiTokens.revokedAt),
+      gt(apiTokens.expiresAt, apiToken.createdAt),
+    )).get();
+    if ((usable?.value ?? 0) >= 5) throw new Error("At most five usable API tokens are allowed");
+    return tx.insert(apiTokens).values({ ...apiToken, tokenHash })
+      .returning(publicColumns).get() as ApiToken;
+  });
+}
+
+export async function listApiTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select(publicColumns).from(apiTokens)
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id)).all() as ApiToken[];
+}
+
+export async function findApiToken(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  return getDb().select(publicColumns).from(apiTokens)
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id))).get() as ApiToken | undefined ?? null;
+}
+
+/** The hash is a global authentication credential; no tenant is known yet. */
+export async function findApiTokenByHash(tokenHash: string): Promise<ApiToken | null> {
+  return getDb().select(publicColumns).from(apiTokens)
+    .where(eq(apiTokens.tokenHash, tokenHash)).get() as ApiToken | undefined ?? null;
+}
+
+/** Only the caller that changes the row receives it and publishes a fact. */
+export async function revokeApiToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<ApiToken | null> {
+  return getDb().update(apiTokens).set({ revokedAt: at })
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt)))
+    .returning(publicColumns).get() as ApiToken | undefined ?? null;
+}
+
+export async function revokeUserApiTokens(orgId: OrgId, userId: UserId, at: IsoTimestamp): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at })
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt)))
+    .returning(publicColumns).all() as ApiToken[];
+}
+
+export async function touchApiToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<boolean> {
+  const row = getDb().update(apiTokens).set({ lastUsedAt: at })
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, at)))
+    .returning({ id: apiTokens.id }).get();
+  return row !== undefined;
+}

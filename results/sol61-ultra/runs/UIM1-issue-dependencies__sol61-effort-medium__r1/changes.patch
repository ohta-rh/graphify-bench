+import { and, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import { findIssueById } from "./issue-repository";
+
+function toDependency(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IssueDependency["createdAt"],
+  };
+}
+
+/** Cycle detection and insertion run together without yielding to another writer. */
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const links = tx.select().from(issueDependencies)
+      .where(eq(issueDependencies.orgId, orgId)).all();
+    const existing = links.find((link) => link.issueId === issueId && link.blockerId === blockerId);
+    if (existing) return toDependency(existing);
+
+    const edges = new Map<string, string[]>();
+    for (const link of links) {
+      const blockers = edges.get(link.issueId) ?? [];
+      blockers.push(link.blockerId);
+      edges.set(link.issueId, blockers);
+    }
+    const pending: string[] = [blockerId];
+    const visited = new Set<string>();
+    while (pending.length > 0) {
+      const id = pending.pop()!;
+      if (id === issueId) throw new Error("Issue dependencies cannot contain a cycle");
+      if (visited.has(id)) continue;
+      visited.add(id);
+      pending.push(...(edges.get(id) ?? []));
+    }
+
+    return toDependency(tx.insert(issueDependencies).values({
+      orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()),
+    }).returning().get());
+  });
+}
+
+export async function deleteDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId): Promise<boolean> {
+  return getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId),
+    eq(issueDependencies.issueId, issueId),
+    eq(issueDependencies.blockerId, blockerId),
+  )).run().changes > 0;
+}
+
+export async function listBlockerIssues(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const links = getDb().select().from(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId),
+  )).all();
+  const blockers = await Promise.all(links.map((link) => findIssueById(orgId, link.blockerId as IssueId)));
+  return blockers.filter((issue): issue is Issue => issue !== null && issue.archivedAt === null)
+    .sort((a, b) => a.number - b.number);
+}
+
+export async function listOpenBlockerIds(orgId: OrgId, issueId: IssueId): Promise<readonly IssueId[]> {
+  return (await listBlockerIssues(orgId, issueId))
+    .filter((issue) => issue.status !== "done" && issue.status !== "canceled")
+    .map((issue) => issue.id);
+}
+
+export async function listBlockedIssueIds(orgId: OrgId, blockerId: IssueId): Promise<readonly IssueId[]> {
+  return getDb().select({ issueId: issueDependencies.issueId }).from(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.blockerId, blockerId),
+  )).all().map((row) => row.issueId as IssueId);
+}

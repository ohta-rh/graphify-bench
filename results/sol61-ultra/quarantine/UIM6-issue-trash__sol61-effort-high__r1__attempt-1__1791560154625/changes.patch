+import { and, eq } from "drizzle-orm";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/logger", async () => (await import("./_support/doubles/misc")).loggerModule);
+
+import { getPlanLimits } from "@/config/plan-limits";
+import { toAppError } from "@/lib/errors";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { RestoreRefusedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { comments, getDb, issueLabels, issues } from "@/server/db";
+import { runCleanupArchivedJob } from "@/server/jobs/cleanup-archived-job";
+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as attachmentRepo from "@/server/repositories/attachment-repository";
+import * as commentRepo from "@/server/repositories/comment-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as labelRepo from "@/server/repositories/label-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { registerActivityListeners } from "@/server/services/activity-service";
+import { addAttachment } from "@/server/services/attachment-service";
+import * as issueService from "@/server/services/issue-service";
+import { indexComment, indexIssue, registerSearchListeners } from "@/server/services/search-service";
+import { registerUsageListeners } from "@/server/services/usage-service";
+import { toIsoTimestamp } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Issue } from "@/types/issue";
+import type { Actor } from "@/types/member";
+import { createTenant, issueInput, useTemporaryDatabase } from "./_support/fixtures";
+import type { Tenant } from "./_support/fixtures";
+
+const NOW = new Date("2026-06-01T12:34:56.789Z");
+const DAY = 24 * 60 * 60 * 1000;
+let cleanup: () => void;
+let tenant: Tenant;
+const offs: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(NOW);
+  cleanup = await useTemporaryDatabase();
+  tenant = await createTenant("trash");
+});
+
+afterEach(() => {
+  while (offs.length) offs.pop()?.();
+});
+
+afterAll(() => {
+  cleanup();
+  vi.useRealTimers();
+});
+
+function setArchivedAt(issue: Issue, when: Date) {
+  getDb().update(issues).set({ archivedAt: toIsoTimestamp(when) })
+    .where(and(eq(issues.orgId, issue.orgId), eq(issues.id, issue.id))).run();
+}
+
+async function expectRefused(actor: Actor, issue: Issue, reason: RestoreRefusedError["reason"]) {
+  const before = await issueRepo.findIssueById(issue.orgId, issue.id);
+  const seen: unknown[] = [];
+  const off = subscribe("issue.restored", (payload) => { seen.push(payload); });
+  try {
+    const error: unknown = await issueService.restoreIssue(actor, issue.orgId, issue.id)
+      .catch((caught: unknown) => caught);
+    expect(error).toBeInstanceOf(RestoreRefusedError);
+    expect(error).toMatchObject({ code: "conflict", reason });
+    expect(toAppError(error)).toMatchObject({ code: "conflict", meta: { reason } });
+    expect(await issueRepo.findIssueById(issue.orgId, issue.id)).toEqual(before);
+    expect(seen).toEqual([]);
+  } finally {
+    off();
+  }
+}
+
+describe("restoring issues", () => {
+  it("checks scope, existence and permission before restore refusals", async () => {
+    const issue = await issueService.createIssue(tenant.actors.member, issueInput(tenant.org.id, tenant.project.id));
+    const other = await createTenant("trash-other");
+    await expect(issueService.restoreIssue(other.actors.owner, tenant.org.id, issue.id))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(issueService.restoreIssue(other.actors.owner, other.org.id, issue.id))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await expect(issueService.restoreIssue(tenant.actors.viewer, tenant.org.id, issue.id))
+      .rejects.toBeInstanceOf(PermissionDeniedError);
+    await expectRefused(tenant.actors.member, issue, "not_archived");
+  });
+
+  it.each(["author", "assignee"] as const)("allows a viewer who is the %s to restore", async (ownership) => {
+    const issue = await issueRepo.insertIssue(
+      issueInput(tenant.org.id, tenant.project.id, {
+        assigneeId: ownership === "assignee" ? tenant.userIds.viewer : null,
+      }),
+      ownership === "author" ? tenant.userIds.viewer : tenant.userIds.member,
+      await issueRepo.nextIssueNumber(tenant.org.id, tenant.project.id),
+    );
+    await issueRepo.archiveIssue(tenant.org.id, issue.id);
+    const restored = await issueService.restoreIssue(tenant.actors.viewer, tenant.org.id, issue.id);
+    expect(restored).toMatchObject({ archivedAt: null, number: issue.number });
+  });
+
+  it.each(["free", "starter", "growth", "enterprise"] as const)("uses the %s plan's exact retention boundary", async (plan) => {
+    const org = await createTenant(`trash-boundary-${plan}`, plan);
+    const issue = await issueService.createIssue(org.actors.member, issueInput(org.org.id, org.project.id));
+    const cutoff = NOW.getTime() - getPlanLimits(plan).retentionDays * DAY;
+    setArchivedAt(issue, new Date(cutoff + 1));
+    expect((await issueService.restoreIssue(org.actors.member, org.org.id, issue.id)).archivedAt).toBeNull();
+    setArchivedAt(issue, new Date(cutoff));
+    await expectRefused(org.actors.member, issue, "expired");
+    setArchivedAt(issue, new Date(cutoff - 1));
+    await expectRefused(org.actors.member, issue, "expired");
+  });
+
+  it("refuses a restore into an archived project", async () => {
+    const org = await createTenant("trash-project");
+    const issue = await issueService.createIssue(org.actors.member, issueInput(org.org.id, org.project.id));
+    await issueRepo.archiveIssue(org.org.id, issue.id);
+    await projectRepo.archiveProject(org.org.id, org.project.id);
+    await expectRefused(org.actors.member, issue, "project_archived");
+  });
+
+  it("counts only live issues against the same project quota as creation", async () => {
+    const org = await createTenant("trash-quota", "free");
+    const seeded: Issue[] = [];
+    const limit = getPlanLimits(org.org.plan).issuesPerProject;
+    for (let number = 1; number <= limit + 1; number += 1) {
+      seeded.push(await issueRepo.insertIssue(issueInput(org.org.id, org.project.id), org.userIds.member, number));
+    }
+    const target = seeded[limit]!;
+    await issueRepo.archiveIssue(org.org.id, target.id);
+    await expectRefused(org.actors.member, target, "quota");
+    await issueRepo.archiveIssue(org.org.id, seeded[0]!.id);
+    expect((await issueService.restoreIssue(org.actors.member, org.org.id, target.id)).number).toBe(target.number);
+  });
+
+  it("publishes the restored event and updates usage, search and the audit log", async () => {
+    const org = await createTenant("trash-events");
+    offs.push(registerUsageListeners(), registerSearchListeners(), registerActivityListeners());
+    const issue = await issueService.createIssue(org.actors.member,
+      issueInput(org.org.id, org.project.id, { title: "searchable trash" }));
+    await issueService.archiveIssue(org.actors.member, org.org.id, issue.id);
+    expect((await usageRepo.getUsage(org.org.id)).issuesUsed).toBe(0);
+    expect(await searchRepo.countIndexed(org.org.id)).toBe(0);
+    const seen: unknown[] = [];
+    offs.push(subscribe("issue.restored", (payload) => { seen.push(payload); }));
+    const restored = await issueService.restoreIssue(org.actors.member, org.org.id, issue.id);
+    expect(restored).toMatchObject({ archivedAt: null, number: issue.number });
+    expect(seen).toEqual([{
+      orgId: org.org.id, actorId: org.userIds.member, occurredAt: NOW.toISOString(),
+      issueId: issue.id, projectId: org.project.id,
+    }]);
+    expect((await usageRepo.getUsage(org.org.id)).issuesUsed).toBe(1);
+    expect(await searchRepo.countIndexed(org.org.id)).toBe(1);
+    expect(await activityRepo.listActivityForSubject(org.org.id, "issue", issue.id))
+      .toEqual(expect.arrayContaining([expect.objectContaining({ action: "issue.restored", actorId: org.userIds.member })]));
+  });
+});
+
+describe("purging expired issues", () => {
+  it("walks every page and project, deletes dependents, returns storage and reserves numbers", async () => {
+    const org = await createTenant("trash-purge", "free");
+    const second = await projectRepo.insertProject({
+      orgId: org.org.id, name: "Second", slug: "second", key: "SEC",
+      description: null, visibility: "org", leadId: null, color: "#6366f1", targetDate: null,
+    });
+    const cutoff = new Date(NOW.getTime() - getPlanLimits(org.org.plan).retentionDays * DAY);
+    const expired: Issue[] = [];
+    for (let number = 1; number <= 221; number += 1) {
+      const project = number <= 110 ? org.project : second;
+      const issue = await issueRepo.insertIssue(issueInput(org.org.id, project.id), org.userIds.member, number);
+      if (number > 105 && number < 221) {
+        setArchivedAt(issue, cutoff);
+        expired.push(issue);
+      } else if (number === 221) {
+        setArchivedAt(issue, new Date(cutoff.getTime() + 1));
+      }
+    }
+    const target = expired.at(-1)!;
+    const survivor = (await issueRepo.listIssues({ orgId: org.org.id, limit: 1, cursor: null })).items[0]!;
+    const label = await labelRepo.insertLabel({ orgId: org.org.id, name: "trash-label", color: "#ffffff", description: null });
+    getDb().insert(issueLabels).values({ orgId: org.org.id, issueId: target.id, labelId: label.id }).run();
+    for (const archived of [false, true]) {
+      const comment = await commentRepo.insertComment({
+        orgId: org.org.id, issueId: target.id, body: "purge-comment", parentId: null, mentionedUserIds: [],
+      }, org.userIds.member);
+      await indexComment(org.org.id, comment);
+      if (archived) getDb().update(comments).set({ archivedAt: toIsoTimestamp(NOW) }).where(eq(comments.id, comment.id)).run();
+    }
+    await indexIssue(org.org.id, target);
+    await indexIssue(org.org.id, survivor);
+    for (const [issueId, sizeBytes] of [[target.id, 1], [target.id, 1024 * 1024 + 1], [survivor.id, 1], [survivor.id, 1]] as const) {
+      await addAttachment(org.actors.member, {
+        orgId: org.org.id, issueId, sizeBytes, filename: "file.txt", contentType: "text/plain",
+      });
+    }
+    const before = await usageRepo.recomputeUsage(org.org.id);
+    expect(before.storageMbUsed).toBe(5);
+    const result = await runCleanupArchivedJob(NOW);
+    expect(result.failed).toBe(0);
+    for (const issue of expired) expect(await issueRepo.findIssueById(org.org.id, issue.id)).toBeNull();
+    expect((await issueRepo.listIssues({ orgId: org.org.id, limit: 100, cursor: null, includeArchived: true })).total).toBe(106);
+    expect(await attachmentRepo.listAttachments(org.org.id, target.id)).toEqual([]);
+    expect(await commentRepo.listComments({ orgId: org.org.id, issueId: target.id, limit: 100, cursor: null, includeArchived: true })).toMatchObject({ total: 0 });
+    expect(getDb().select().from(issueLabels).where(eq(issueLabels.issueId, target.id)).all()).toEqual([]);
+    expect(await labelRepo.listLabelsForIssues(org.org.id, [target.id])).toEqual({});
+    expect(await searchRepo.countIndexed(org.org.id)).toBe(1);
+    const after = await usageRepo.getUsage(org.org.id);
+    expect(after.issuesUsed).toBe(before.issuesUsed);
+    expect(after.storageMbUsed).toBe(2);
+    expect((await usageRepo.recomputeUsage(org.org.id)).storageMbUsed).toBe(after.storageMbUsed);
+    await expect(issueService.restoreIssue(org.actors.member, org.org.id, target.id)).rejects.toBeInstanceOf(NotFoundError);
+    const created = await issueService.createIssue(org.actors.member, issueInput(org.org.id, second.id));
+    expect(created.number).toBe(222);
+    // The highest number in the first project was purged too.
+    expect(await issueRepo.nextIssueNumber(org.org.id, org.project.id)).toBe(111);
+    await runCleanupArchivedJob(NOW);
+    expect((await usageRepo.getUsage(org.org.id)).storageMbUsed).toBe(2);
+  });
+
+  it("keeps the number when every issue in a project is purged", async () => {
+    const org = await createTenant("trash-empty", "free");
+    const issue = await issueRepo.insertIssue(issueInput(org.org.id, org.project.id), org.userIds.member, 17);
+    setArchivedAt(issue, new Date(NOW.getTime() - getPlanLimits(org.org.plan).retentionDays * DAY));
+    await usageRepo.recomputeUsage(org.org.id);
+    await runCleanupArchivedJob(NOW);
+    expect(await issueRepo.findIssueById(org.org.id, issue.id)).toBeNull();
+    expect((await issueService.createIssue(org.actors.member, issueInput(org.org.id, org.project.id))).number).toBe(18);
+  });
+});

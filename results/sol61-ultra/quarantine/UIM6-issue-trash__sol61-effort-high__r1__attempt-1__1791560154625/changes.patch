+
+/** Deletes an expired issue and its dependents atomically, without an archive event. */
+export async function purgeExpiredIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+  cutoff: IsoTimestamp,
+): Promise<boolean> {
+  return getDb().transaction((tx) => {
+    // Recheck expiration inside the transaction in case the issue was restored
+    // after the sweep fetched its page.
+    const issue = tx
+      .select()
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.id, issueId),
+          lte(issues.archivedAt, cutoff),
+        ),
+      )
+      .get();
+    if (!issue) return false;
+
+    tx.insert(issueNumberHighWater)
+      .values({ orgId, projectId: issue.projectId, number: issue.number })
+      .onConflictDoUpdate({
+        target: [issueNumberHighWater.orgId, issueNumberHighWater.projectId],
+        set: { number: sql`max(${issueNumberHighWater.number}, ${issue.number})` },
+      })
+      .run();
+
+    const commentFilter = and(
+      orgPredicate(comments.orgId, orgId),
+      eq(comments.issueId, issueId),
+    );
+    tx.delete(searchIndex)
+      .where(
+        and(
+          orgPredicate(searchIndex.orgId, orgId),
+          or(
+            and(eq(searchIndex.subjectKind, "issue"), eq(searchIndex.subjectId, issueId)),
+            and(
+              eq(searchIndex.subjectKind, "comment"),
+              inArray(
+                searchIndex.subjectId,
+                tx.select({ id: comments.id }).from(comments).where(commentFilter),
+              ),
+            ),
+          ),
+        ),
+      )
+      .run();
+
+    const attachmentFilter = and(
+      orgPredicate(attachments.orgId, orgId),
+      eq(attachments.issueId, issueId),
+    );
+    const storageMb = tx
+      .select({ sizeBytes: attachments.sizeBytes })
+      .from(attachments)
+      .where(attachmentFilter)
+      .all()
+      .reduce((total, attachment) => total + Math.ceil(attachment.sizeBytes / (1024 * 1024)), 0);
+
+    tx.delete(attachments).where(attachmentFilter).run();
+    tx.delete(comments).where(commentFilter).run();
+    tx.delete(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, orgId), eq(issueLabels.issueId, issueId)))
+      .run();
+    tx.delete(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .run();
+
+    if (storageMb > 0) {
+      tx.update(organizationUsage)
+        .set({
+          storageMbUsed: sql`${organizationUsage.storageMbUsed} - ${storageMb}`,
+          measuredAt: toIsoTimestamp(new Date()),
+        })
+        .where(orgPredicate(organizationUsage.orgId, orgId))
+        .run();
+    }
+
+    return true;
+  });
 }
 

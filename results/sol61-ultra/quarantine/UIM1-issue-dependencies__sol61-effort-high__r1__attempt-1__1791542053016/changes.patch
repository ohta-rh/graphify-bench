@@ -0,0 +1,137 @@
+import { and, eq, inArray, notInArray, sql } from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import type { IssueId, OrgId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import { brandId, toIssue, toIssueDependency } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import { listLabelsForIssues } from "./label-repository";
+
+/** Cycle detection and insertion share a transaction, without an async gap. */
+export async function insertDependency(
+  input: IssueDependency,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const existing = tx
+      .select()
+      .from(issueDependencies)
+      .where(and(
+        orgPredicate(issueDependencies.orgId, input.orgId),
+        eq(issueDependencies.issueId, input.issueId),
+        eq(issueDependencies.blockerId, input.blockerId),
+      ))
+      .get();
+    if (existing) return toIssueDependency(existing);
+
+    // Follow every link, including closed and archived blockers. A dependency
+    // graph must remain acyclic even when its issues are later reopened.
+    const cycle = tx.get<{ id: string }>(sql`
+      WITH RECURSIVE chain(id) AS (
+        SELECT ${input.blockerId}
+        UNION
+        SELECT dependency.blocker_id
+        FROM issue_dependencies AS dependency
+        JOIN chain ON dependency.issue_id = chain.id
+        WHERE dependency.org_id = ${input.orgId}
+      )
+      SELECT id FROM chain WHERE id = ${input.issueId} LIMIT 1
+    `);
+    if (cycle) throw new Error("Issue dependencies cannot contain a cycle");
+
+    const row = tx.insert(issueDependencies).values(input).returning().get();
+    return toIssueDependency(row);
+  });
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const result = getDb()
+    .delete(issueDependencies)
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      eq(issueDependencies.blockerId, blockerId),
+    ))
+    .run();
+  return result.changes > 0;
+}
+
+export async function listBlockerIssues(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(issues, and(
+      eq(issues.id, issueDependencies.blockerId),
+      eq(issues.orgId, issueDependencies.orgId),
+    ))
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      livePredicate(issues.archivedAt, {}),
+    ))
+    .orderBy(issues.number, issues.id)
+    .all();
+  const labels = await listLabelsForIssues(
+    orgId,
+    rows.map(({ issue }) => brandId<IssueId>(issue.id)),
+  );
+  return rows.map(({ issue }) => toIssue(
+    issue,
+    (labels[issue.id] ?? []).map((label) => label.id),
+  ));
+}
+
+export async function listOpenBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb()
+    .select({ id: issues.id })
+    .from(issueDependencies)
+    .innerJoin(issues, and(
+      eq(issues.id, issueDependencies.blockerId),
+      eq(issues.orgId, issueDependencies.orgId),
+    ))
+    .where(and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+    ))
+    .orderBy(issues.number, issues.id)
+    .all()
+    .map((row) => brandId<IssueId>(row.id));
+}
+
+/** Distinct, live, open issues affected by one closure or an archive cascade. */
+export async function listBlockedIssues(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+): Promise<readonly Issue[]> {
+  if (blockerIds.length === 0) return [];
+  const db = getDb();
+  return db
+    .select()
+    .from(issues)
+    .where(and(
+      orgPredicate(issues.orgId, orgId),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+      inArray(issues.id, db
+        .select({ id: issueDependencies.issueId })
+        .from(issueDependencies)
+        .where(and(
+          orgPredicate(issueDependencies.orgId, orgId),
+          inArray(issueDependencies.blockerId, [...blockerIds]),
+        ))),
+    ))
+    .orderBy(issues.number, issues.id)
+    .all()
+    .map((row) => toIssue(row));
+}

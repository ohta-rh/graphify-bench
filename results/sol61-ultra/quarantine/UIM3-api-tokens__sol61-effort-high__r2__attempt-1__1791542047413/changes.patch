+import { and, count, desc, eq, gt, isNull, sql } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import type { ApiTokenRow } from "@/server/db/schema/api-tokens";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import { orgPredicate } from "./base-repository";
+
+/** Explicit projection: secret hashes never leave this repository. */
+function toApiToken(row: ApiTokenRow): ApiToken {
+  return {
+    id: row.id,
+    orgId: row.orgId as OrgId,
+    userId: row.userId as UserId,
+    name: row.name,
+    scope: row.scope,
+    prefix: row.prefix,
+    expiresAt: row.expiresAt as IsoTimestamp,
+    lastUsedAt: row.lastUsedAt as IsoTimestamp | null,
+    revokedAt: row.revokedAt as IsoTimestamp | null,
+    createdAt: row.createdAt as IsoTimestamp,
+  };
+}
+
+/** Check and insert share a synchronous transaction so concurrent creates cannot exceed the quota. */
+export async function insertApiToken(
+  input: Omit<ApiToken, "id" | "lastUsedAt" | "revokedAt">,
+  tokenHash: string,
+): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const usable = tx.select({ value: count() }).from(apiTokens).where(and(
+      orgPredicate(apiTokens.orgId, input.orgId),
+      eq(apiTokens.userId, input.userId),
+      isNull(apiTokens.revokedAt),
+      gt(apiTokens.expiresAt, input.createdAt),
+    )).get();
+
+    if ((usable?.value ?? 0) >= 5) {
+      throw new Error("A user may have at most five usable API tokens per organization");
+    }
+
+    const row = tx.insert(apiTokens).values({
+      ...input,
+      id: newId(),
+      tokenHash,
+      lastUsedAt: null,
+      revokedAt: null,
+    }).returning().get();
+    return toApiToken(row);
+  }, { behavior: "immediate" });
+}
+
+export async function listApiTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(
+    orgPredicate(apiTokens.orgId, orgId),
+    eq(apiTokens.userId, userId),
+  )).orderBy(desc(apiTokens.createdAt), desc(sql`rowid`)).all().map(toApiToken);
+}
+
+export async function findApiToken(orgId: OrgId, tokenId: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(
+    orgPredicate(apiTokens.orgId, orgId),
+    eq(apiTokens.id, tokenId),
+  )).get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Null means no state transition; callers must not emit another revocation. */
+export async function revokeApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at }).where(and(
+    orgPredicate(apiTokens.orgId, orgId),
+    eq(apiTokens.id, tokenId),
+    isNull(apiTokens.revokedAt),
+  )).returning().get();
+  return row ? toApiToken(row) : null;
+}
+
+/** Includes expired tokens; removal permanently revokes every remaining credential. */
+export async function revokeApiTokensForUser(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at }).where(and(
+    orgPredicate(apiTokens.orgId, orgId),
+    eq(apiTokens.userId, userId),
+    isNull(apiTokens.revokedAt),
+  )).returning().all().map(toApiToken);
+}
+
+/** Resolve current membership and touch usage atomically, only for a usable credential. */
+export async function authenticateApiTokenHash(tokenHash: string, at: IsoTimestamp): Promise<Actor | null> {
+  return getDb().transaction((tx) => {
+    const row = tx.select({ token: apiTokens, role: members.role })
+      .from(apiTokens)
+      .innerJoin(members, and(eq(members.orgId, apiTokens.orgId), eq(members.userId, apiTokens.userId)))
+      .innerJoin(organizations, eq(organizations.id, apiTokens.orgId))
+      .where(and(
+        eq(apiTokens.tokenHash, tokenHash),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, at),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+        isNull(organizations.archivedAt),
+      )).get();
+    if (!row) return null;
+
+    tx.update(apiTokens).set({ lastUsedAt: at }).where(eq(apiTokens.id, row.token.id)).run();
+    return {
+      userId: row.token.userId as UserId,
+      orgId: row.token.orgId as OrgId,
+      role: row.token.scope === "read" ? "viewer" : row.role,
+    };
+  }, { behavior: "immediate" });
+}

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { isDomainError, toAppError } from "@/lib/errors";
+import { onHandlerError, subscribe } from "@/lib/event-bus";
+import { MilestoneStateError } from "@/lib/milestones";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { createIssueSchema } from "@/schemas/issue";
+import { createMilestoneSchema } from "@/schemas/milestone";
+import { updateNotificationPreferenceSchema } from "@/schemas/notification";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import { NotFoundError } from "@/server/services/_support";
+import * as issueService from "@/server/services/issue-service";
+import * as milestones from "@/server/services/milestone-service";
+import { listNotifications, updatePreference } from "@/server/services/notification-service";
+import { toIsoTimestamp } from "@/types/common";
+import { ISSUE_STATUSES } from "@/types/issue";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+import type { MilestoneId, ProjectId } from "@/types/common";
+import type { TaskflowEventMap, TaskflowEventType, Unsubscribe } from "@/types/event";
+
+let cleanup: () => void;
+let detachActivity: Unsubscribe;
+let tenant: Tenant;
+let sequence = 0;
+const detachers: Unsubscribe[] = [];
+const missingId = "01HZZZMMMMMMMMMMMMMMMMMMMM" as MilestoneId;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachActivity = registerActivityListeners();
+});
+
+beforeEach(async () => {
+  tenant = await createTenant(`milestones-${++sequence}`);
+});
+
+afterEach(() => {
+  while (detachers.length) detachers.pop()?.();
+  vi.useRealTimers();
+});
+
+afterAll(() => {
+  detachActivity();
+  cleanup();
+});
+
+function create(name: string, targetDate: string | null = null, projectId = tenant.project.id) {
+  return milestones.createMilestone(tenant.actors.member, createMilestoneSchema.parse({
+    orgId: tenant.org.id, projectId, name, targetDate,
+  }));
+}
+
+function close(milestoneId: MilestoneId, moveOpenIssuesTo: MilestoneId | null = null) {
+  return milestones.closeMilestone(tenant.actors.member, {
+    orgId: tenant.org.id, milestoneId, moveOpenIssuesTo,
+  });
+}
+
+function capture<K extends TaskflowEventType>(type: K): TaskflowEventMap[K][] {
+  const seen: TaskflowEventMap[K][] = [];
+  detachers.push(subscribe(type, (payload) => { seen.push(payload); }));
+  return seen;
+}
+
+async function anotherProject(): Promise<ProjectId> {
+  const project = await projectRepo.insertProject({
+    orgId: tenant.org.id, name: "Other", slug: "other", key: "OTH",
+    description: null, visibility: "org", leadId: null, color: "#6366f1", targetDate: null,
+  });
+  return project.id;
+}
+
+describe("milestone lifecycle", () => {
+  it("persists edits and publishes each lifecycle event and audit row once", async () => {
+    const created = capture("milestone.created");
+    const closed = capture("milestone.closed");
+    const reopened = capture("milestone.reopened");
+    const errors: unknown[] = [];
+    detachers.push(onHandlerError((_type, error) => { errors.push(error); }));
+
+    const milestone = await create("Launch", "2026-01-01T00:00:00Z");
+    expect(milestone.closedAt).toBeNull();
+    await milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: milestone.id, name: "Release", targetDate: null,
+    });
+    expect((await milestones.getMilestone(tenant.actors.viewer, tenant.org.id, milestone.id)).milestone)
+      .toMatchObject({ name: "Release", targetDate: null });
+    await close(milestone.id);
+    await milestones.reopenMilestone(tenant.actors.member, tenant.org.id, milestone.id);
+
+    expect(created).toHaveLength(1);
+    expect(closed).toHaveLength(1);
+    expect(reopened).toHaveLength(1);
+    for (const event of [created[0], closed[0], reopened[0]]) {
+      expect(event).toMatchObject({ milestoneId: milestone.id, projectId: tenant.project.id, actorId: tenant.userIds.member });
+    }
+    const audit = await listActivity(tenant.actors.member, activityFilterSchema.parse({
+      orgId: tenant.org.id, subjectKind: "milestone",
+      action: ["milestone.created", "milestone.closed", "milestone.reopened"],
+    }));
+    expect(audit.items).toHaveLength(3);
+    expect(new Set(audit.items.map((row) => row.action)).size).toBe(3);
+    for (const row of audit.items) {
+      expect(row).toMatchObject({ subjectId: milestone.id, subjectKind: "milestone", projectId: tenant.project.id, actorId: tenant.userIds.member });
+    }
+    expect(errors).toEqual([]);
+  });
+
+  it("reserves normalized names across open and closed milestones, scoped to the project", async () => {
+    const first = await create("  Launch  ");
+    await expect(create("lAuNcH")).rejects.toMatchObject({ reason: "name_taken" });
+    await close(first.id);
+    await expect(create(" LAUNCH ")).rejects.toBeInstanceOf(MilestoneStateError);
+    const second = await create("Next");
+    await expect(milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: second.id, name: "launch", targetDate: toIsoTimestamp("2020-01-01"),
+    })).rejects.toMatchObject({ reason: "name_taken" });
+    expect((await milestones.getMilestone(tenant.actors.viewer, tenant.org.id, second.id)).milestone)
+      .toMatchObject({ name: "Next", targetDate: null });
+    await expect(create(" launch ", null, await anotherProject())).resolves.toBeDefined();
+    await expect(milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: first.id, name: "LAUNCH",
+    })).resolves.toMatchObject({ name: "LAUNCH" });
+  });
+
+  it("enforces the cap on creation and reopening, counting only open milestones", async () => {
+    const first = await create("First");
+    await close(first.id);
+    const open = [];
+    for (let i = 0; i < MAX_OPEN_MILESTONES_PER_PROJECT; i++) open.push(await create(`Open ${i}`));
+    await expect(create("Too many")).rejects.toMatchObject({ reason: "too_many_open" });
+    await expect(milestones.reopenMilestone(tenant.actors.member, tenant.org.id, first.id))
+      .rejects.toMatchObject({ reason: "too_many_open" });
+    await close(open[0].id);
+    await expect(milestones.reopenMilestone(tenant.actors.member, tenant.org.id, first.id))
+      .resolves.toMatchObject({ closedAt: null });
+    await expect(close(open[0].id)).rejects.toMatchObject({ reason: "closed" });
+    await expect(milestones.reopenMilestone(tenant.actors.member, tenant.org.id, first.id))
+      .rejects.toMatchObject({ reason: "already_open" });
+    await expect(create("Elsewhere", null, await anotherProject())).resolves.toBeDefined();
+  });
+
+  it("refuses repeated state transitions even when calls overlap", async () => {
+    const milestone = await create("Concurrent");
+    const closed = capture("milestone.closed");
+    const closes = await Promise.allSettled([close(milestone.id), close(milestone.id)]);
+    expect(closes.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    expect(closed).toHaveLength(1);
+    const reopened = capture("milestone.reopened");
+    const reopens = await Promise.allSettled([
+      milestones.reopenMilestone(tenant.actors.member, tenant.org.id, milestone.id),
+      milestones.reopenMilestone(tenant.actors.member, tenant.org.id, milestone.id),
+    ]);
+    expect(reopens.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    expect(reopened).toHaveLength(1);
+  });
+
+  it("maps every milestone state error to a domain conflict", () => {
+    for (const reason of ["closed", "already_open", "too_many_open", "name_taken"] as const) {
+      const error = new MilestoneStateError(reason);
+      expect(error.code).toBe("conflict");
+      expect(isDomainError(error)).toBe(true);
+      expect(toAppError(error)).toMatchObject({ code: "conflict", meta: { reason } });
+    }
+  });
+});
+
+describe("milestone progress and ordering", () => {
+  it("counts all live issues beyond a page and uses a strict call-time overdue check", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-01-02T00:00:00Z"));
+    const milestone = await create("Progress", "2026-01-02T00:00:00Z");
+    for (let i = 0; i < 105; i++) {
+      await issueService.createIssue(tenant.actors.member, {
+        ...issueInput(tenant.org.id, tenant.project.id), milestoneId: milestone.id,
+        status: i < 50 ? "done" : i < 100 ? "canceled" : "todo",
+      });
+    }
+    const archived = await issueService.createIssue(tenant.actors.member, {
+      ...issueInput(tenant.org.id, tenant.project.id), milestoneId: milestone.id,
+    });
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, archived.id);
+    expect(await milestones.getMilestone(tenant.actors.viewer, tenant.org.id, milestone.id))
+      .toMatchObject({ progress: { total: 105, open: 5, closed: 100 }, overdue: false });
+    vi.setSystemTime(new Date("2026-01-02T00:00:00.001Z"));
+    expect((await milestones.getMilestone(tenant.actors.viewer, tenant.org.id, milestone.id)).overdue).toBe(true);
+    await milestones.updateMilestone(tenant.actors.member, { orgId: tenant.org.id, milestoneId: milestone.id, targetDate: null });

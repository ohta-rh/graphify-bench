@@ -0,0 +1,165 @@
+import { and, count, eq, inArray, isNull, ne, notInArray, sql } from "drizzle-orm";
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { newId } from "@/lib/id";
+import { MilestoneStateError } from "@/lib/milestones";
+import { getDb, issues, milestones } from "@/server/db";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { toMilestone } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import type { CreateMilestoneInput, UpdateMilestoneInput } from "@/schemas/milestone";
+import type { IsoTimestamp, IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Milestone, MilestoneProgress } from "@/types/milestone";
+
+const normalizeName = (name: string): string => name.trim().toLowerCase();
+
+export function findMilestoneById(
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Milestone | null {
+  const row = getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.id, milestoneId),
+  )).get();
+  return row ? toMilestone(row) : null;
+}
+
+export function listMilestones(orgId: OrgId, projectId: ProjectId): readonly Milestone[] {
+  return getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.projectId, projectId),
+  )).all().map(toMilestone).sort((a, b) => {
+    const state = Number(a.closedAt !== null) - Number(b.closedAt !== null);
+    if (state !== 0) return state;
+    if (a.targetDate === null && b.targetDate !== null) return 1;
+    if (a.targetDate !== null && b.targetDate === null) return -1;
+    const date = a.targetDate !== null && b.targetDate !== null
+      ? Date.parse(a.targetDate) - Date.parse(b.targetDate)
+      : 0;
+    return date || Date.parse(a.createdAt) - Date.parse(b.createdAt) || a.id.localeCompare(b.id);
+  });
+}
+
+/** These checks and their writes share a transaction, including the quota read. */
+function assertRoom(orgId: OrgId, projectId: ProjectId): void {
+  const used = getDb().select({ value: count() }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.projectId, projectId),
+    isNull(milestones.closedAt),
+  )).get()?.value ?? 0;
+  if (used >= MAX_OPEN_MILESTONES_PER_PROJECT) {
+    throw new MilestoneStateError("too_many_open");
+  }
+}
+
+function assertNameAvailable(
+  orgId: OrgId,
+  projectId: ProjectId,
+  name: string,
+  exceptId?: MilestoneId,
+): void {
+  const taken = getDb().select({ id: milestones.id }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.projectId, projectId),
+    eq(milestones.normalizedName, normalizeName(name)),
+    exceptId === undefined ? undefined : ne(milestones.id, exceptId),
+  )).get();
+  if (taken) throw new MilestoneStateError("name_taken");
+}
+
+export function insertMilestone(input: CreateMilestoneInput, now: IsoTimestamp): Milestone {
+  return getDb().transaction((tx) => {
+    assertNameAvailable(input.orgId, input.projectId, input.name);
+    assertRoom(input.orgId, input.projectId);
+    return toMilestone(tx.insert(milestones).values({
+      id: newId(),
+      orgId: input.orgId,
+      projectId: input.projectId,
+      name: input.name,
+      normalizedName: normalizeName(input.name),
+      targetDate: input.targetDate,
+      closedAt: null,
+      createdAt: now,
+      updatedAt: now,
+    }).returning().get());
+  });
+}
+
+export function updateMilestone(
+  milestone: Milestone,
+  input: UpdateMilestoneInput,
+  now: IsoTimestamp,
+): Milestone {
+  return getDb().transaction((tx) => {
+    if (input.name !== undefined) {
+      assertNameAvailable(milestone.orgId, milestone.projectId, input.name, milestone.id);
+    }
+    return toMilestone(tx.update(milestones).set({
+      ...(input.name === undefined ? {} : {
+        name: input.name,
+        normalizedName: normalizeName(input.name),
+      }),
+      ...(input.targetDate === undefined ? {} : { targetDate: input.targetDate }),
+      updatedAt: now,
+    }).where(and(
+      orgPredicate(milestones.orgId, milestone.orgId),
+      eq(milestones.id, milestone.id),
+    )).returning().get());
+  });
+}
+
+export function closeMilestone(
+  milestone: Milestone,
+  moveTo: MilestoneId | null,
+  now: IsoTimestamp,
+): { milestone: Milestone; movedIssueIds: readonly IssueId[] } {
+  return getDb().transaction((tx) => {
+    if (findMilestoneById(milestone.orgId, milestone.id)?.closedAt !== null) {
+      throw new MilestoneStateError("closed");
+    }
+    const moved = tx.update(issues).set({ milestoneId: moveTo, updatedAt: now }).where(and(
+      orgPredicate(issues.orgId, milestone.orgId),
+      eq(issues.projectId, milestone.projectId),
+      eq(issues.milestoneId, milestone.id),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+    )).returning({ id: issues.id }).all();
+
+    const closed = tx.update(milestones).set({ closedAt: now, updatedAt: now }).where(and(
+      orgPredicate(milestones.orgId, milestone.orgId),
+      eq(milestones.id, milestone.id),
+    )).returning().get();
+    return {
+      milestone: toMilestone(closed),
+      movedIssueIds: moved.map((issue) => issue.id as IssueId),
+    };
+  });
+}
+
+export function reopenMilestone(milestone: Milestone, now: IsoTimestamp): Milestone {
+  return getDb().transaction((tx) => {
+    if (findMilestoneById(milestone.orgId, milestone.id)?.closedAt === null) {
+      throw new MilestoneStateError("already_open");
+    }
+    assertRoom(milestone.orgId, milestone.projectId);
+    return toMilestone(tx.update(milestones).set({ closedAt: null, updatedAt: now }).where(and(
+      orgPredicate(milestones.orgId, milestone.orgId),
+      eq(milestones.id, milestone.id),
+    )).returning().get());
+  });
+}
+
+/** Aggregate directly over all live issues; list pagination never limits progress. */
+export function getMilestoneProgress(milestone: Milestone): MilestoneProgress {
+  const row = getDb().select({
+    total: count(),
+    closed: sql<number>`coalesce(sum(case when ${inArray(issues.status, [...CLOSED_ISSUE_STATUSES])} then 1 else 0 end), 0)`,
+  }).from(issues).where(and(
+    orgPredicate(issues.orgId, milestone.orgId),
+    eq(issues.projectId, milestone.projectId),
+    eq(issues.milestoneId, milestone.id),
+    livePredicate(issues.archivedAt, {}),
+  )).get();
+  const total = row?.total ?? 0;
+  const closed = row?.closed ?? 0;
+  return { total, open: total - closed, closed };
+}

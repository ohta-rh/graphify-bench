@@ -0,0 +1,134 @@
+import { emit } from "@/lib/event-bus";
+import { MilestoneStateError } from "@/lib/milestones";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as milestoneRepo from "@/server/repositories/milestone-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { requireOpenMilestone } from "./_milestone-support";
+import { actorEnvelope, NotFoundError, projectResource, requireFound } from "./_support";
+import type { CloseMilestoneInput, CreateMilestoneInput, UpdateMilestoneInput } from "@/schemas/milestone";
+import type { IsoTimestamp, IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { Milestone, MilestoneWithProgress } from "@/types/milestone";
+
+async function requireProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+  write: boolean,
+): Promise<void> {
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId), "Project", projectId,
+  );
+  assertCan(actor, write ? "project:update" : "project:read", projectResource(project));
+  if (write) assertNotArchived("Project", project.id, project);
+}
+
+async function requireMilestone(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+  write: boolean,
+): Promise<Milestone> {
+  const milestone = requireFound(
+    milestoneRepo.findMilestoneById(orgId, milestoneId), "Milestone", milestoneId,
+  );
+  await requireProject(actor, orgId, milestone.projectId, write);
+  // Read after the asynchronous project guard so state checks use the current row.
+  return requireFound(
+    milestoneRepo.findMilestoneById(orgId, milestoneId), "Milestone", milestoneId,
+  );
+}
+
+export async function createMilestone(actor: Actor, input: CreateMilestoneInput): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  await requireProject(actor, input.orgId, input.projectId, true);
+  const milestone = milestoneRepo.insertMilestone(input, now);
+  await emit("milestone.created", {
+    ...actorEnvelope(actor), occurredAt: now,
+    milestoneId: milestone.id, projectId: milestone.projectId,
+  });
+  return milestone;
+}
+
+export async function updateMilestone(actor: Actor, input: UpdateMilestoneInput): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  const milestone = await requireMilestone(actor, input.orgId, input.milestoneId, true);
+  return milestoneRepo.updateMilestone(milestone, input, now);
+}
+
+export async function closeMilestone(
+  actor: Actor,
+  input: CloseMilestoneInput,
+): Promise<{ milestone: Milestone; movedIssueIds: readonly IssueId[] }> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  const milestone = await requireMilestone(actor, input.orgId, input.milestoneId, true);
+  if (milestone.closedAt !== null) throw new MilestoneStateError("closed");
+  if (input.moveOpenIssuesTo !== null) {
+    if (input.moveOpenIssuesTo === milestone.id) {
+      throw new NotFoundError("Milestone", input.moveOpenIssuesTo);
+    }
+    requireOpenMilestone(input.orgId, milestone.projectId, input.moveOpenIssuesTo);
+  }
+  const result = milestoneRepo.closeMilestone(milestone, input.moveOpenIssuesTo, now);
+  await emit("milestone.closed", {
+    ...actorEnvelope(actor), occurredAt: now,
+    milestoneId: milestone.id, projectId: milestone.projectId,
+    movedToMilestoneId: input.moveOpenIssuesTo, movedIssueIds: result.movedIssueIds,
+  });
+  return result;
+}
+
+export async function reopenMilestone(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, orgId);
+  const before = await requireMilestone(actor, orgId, milestoneId, true);
+  if (before.closedAt === null) throw new MilestoneStateError("already_open");
+  const milestone = milestoneRepo.reopenMilestone(before, now);
+  await emit("milestone.reopened", {
+    ...actorEnvelope(actor), occurredAt: now,
+    milestoneId: milestone.id, projectId: milestone.projectId,
+  });
+  return milestone;
+}
+
+function withProgress(milestone: Milestone, now: IsoTimestamp): MilestoneWithProgress {
+  const progress = milestoneRepo.getMilestoneProgress(milestone);
+  return {
+    milestone,
+    progress,
+    overdue: milestone.closedAt === null && milestone.targetDate !== null &&
+      Date.parse(milestone.targetDate) < Date.parse(now) && progress.open > 0,
+  };
+}
+
+export async function listMilestones(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<readonly MilestoneWithProgress[]> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, orgId);
+  await requireProject(actor, orgId, projectId, false);
+  return milestoneRepo.listMilestones(orgId, projectId).map((milestone) => withProgress(milestone, now));
+}
+
+export async function getMilestone(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<MilestoneWithProgress> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, orgId);
+  const milestone = await requireMilestone(actor, orgId, milestoneId, false);
+  return withProgress(milestone, now);
+}

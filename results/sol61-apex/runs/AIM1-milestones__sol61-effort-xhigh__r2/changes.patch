+import { MilestoneStateError } from "@/lib/milestones";
+import * as milestoneRepo from "@/server/repositories/milestone-repository";
+import { NotFoundError, requireFound } from "./_support";
+import type { MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Milestone } from "@/types/milestone";
+
+/** A foreign-project milestone is indistinguishable from a missing one. */
+export function requireOpenMilestone(
+  orgId: OrgId,
+  projectId: ProjectId,
+  milestoneId: MilestoneId,
+): Milestone {
+  const milestone = requireFound(
+    milestoneRepo.findMilestoneById(orgId, milestoneId),
+    "Milestone",
+    milestoneId,
+  );
+  if (milestone.projectId !== projectId) {
+    throw new NotFoundError("Milestone", milestoneId);
+  }
+  if (milestone.closedAt !== null) throw new MilestoneStateError("closed");
+  return milestone;
+}

@@ -0,0 +1,20 @@
+import { getLimit } from "@/config/plan-limits";
+import { emit } from "@/lib/event-bus";
+import { actorEnvelope } from "./_support";
+import type { LimitedResource, PlanId } from "@/types/billing";
+import type { Actor } from "@/types/member";
+
+/** Called only at the point where a write is refused for lack of capacity. */
+export async function reportPlanLimit(
+  actor: Actor,
+  plan: PlanId,
+  resource: LimitedResource,
+  used: number,
+): Promise<void> {
+  await emit("billing.limit_exceeded", {
+    ...actorEnvelope(actor),
+    resource,
+    limit: getLimit(plan, resource),
+    used,
+  });
+}

@@ -0,0 +1,19 @@
+import { issuePath, projectPath } from "@/lib/url";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { requireFound } from "./_support";
+import type { IssueId, OrgId, ProjectId } from "@/types/common";
+
+export async function issueHref(orgId: OrgId, issueId: IssueId): Promise<string> {
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  const project = requireFound(await projectRepo.findProjectById(orgId, issue.projectId), "Project", issue.projectId);
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  return issuePath(org.slug, project.slug, issue.number);
+}
+
+export async function projectHref(orgId: OrgId, projectId: ProjectId): Promise<string> {
+  const project = requireFound(await projectRepo.findProjectById(orgId, projectId), "Project", projectId);
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  return projectPath(org.slug, project.slug);
+}

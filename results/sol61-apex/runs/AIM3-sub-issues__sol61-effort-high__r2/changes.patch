+  const after = await issueRepo.setIssueParent(input.orgId, issue.id, input.parentId, hierarchy => {
+    const current = requireFound(hierarchy.find(row => row.id === issue.id), "Issue", issue.id);
+    assertCan(actor, "issue:update", issueResource(current));
+    assertNotArchived("Issue", current.id, current);
+    assertParentPlacement(hierarchy, input.parentId, current.id);
+  });
+  if (issue.parentId === after.parentId) return after;
+  await emit("issue.updated", {
+    ...actorEnvelope(actor),
+    issueId: after.id,
+    projectId: after.projectId,
+    changedFields: ["parentId"],
+  });
+  return after;
+}
+
+export async function listSubIssues(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  assertOrgScope(actor, orgId);
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  assertCan(actor, "issue:read", issueResource(issue));
+  return issueRepo.listSubIssues(orgId, issueId);
+}
+
+export async function getIssueRollup(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<IssueRollup> {
+  assertOrgScope(actor, orgId);
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  assertCan(actor, "issue:read", issueResource(issue));
+  return issueRepo.getIssueRollup(orgId, issueId);
 }
 

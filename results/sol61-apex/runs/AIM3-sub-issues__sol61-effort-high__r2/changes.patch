+ * UNION also makes reads finite if older data contains a cycle. */
+function subtreeIds(orgId: OrgId, issueId: IssueId): SQL {
+  return sql`(with recursive subtree(id) as (
+    select id from issues where org_id = ${orgId} and id = ${issueId}
+    union
+    select child.id from issues child
+    join subtree parent on child.parent_id = parent.id
+    where child.org_id = ${orgId}

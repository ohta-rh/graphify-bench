+/** Validate both the destination and the deepest node that travels with it. */
+function assertParentPlacement(
+  hierarchy: readonly Issue[],
+  parentId: IssueId | null,
+  issueId?: IssueId,
+): void {
+  if (issueId === undefined && parentId === null) return;
+  const byId = new Map(hierarchy.map(issue => [issue.id, issue]));
+  let parent = parentId === null ? null : requireFound(byId.get(parentId), "Issue", parentId);
+  if (parent !== null) assertNotArchived("Issue", parent.id, parent);

+  const children = new Map<IssueId, IssueId[]>();
+  for (const descendant of hierarchy) {
+    if (descendant.parentId !== null) {
+      const siblings = children.get(descendant.parentId) ?? [];
+      siblings.push(descendant.id);
+      children.set(descendant.parentId, siblings);
+    }

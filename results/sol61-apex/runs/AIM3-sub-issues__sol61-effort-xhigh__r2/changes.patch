+export class IssueHierarchyError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(
+    readonly issueId: string,
+    readonly reason: "cycle" | "too_deep",
+  ) {
+    super(
+      reason === "cycle"
+        ? `Issue ${issueId} cannot be placed under itself or a descendant.`
+        : `Issue ${issueId} would exceed the maximum sub-issue depth.`,
+    );
+    this.name = "IssueHierarchyError";
+  }
+}

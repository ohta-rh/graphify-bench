@@ -0,0 +1,165 @@
+import { and, asc, count, eq, isNotNull, isNull, ne, notInArray, sql } from "drizzle-orm";
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { newId } from "@/lib/id";
+import { MilestoneStateError } from "@/lib/milestones";
+import { getDb, issues, milestones } from "@/server/db";
+import { NotFoundError, requireFound } from "@/server/services/_support";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { toMilestone } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import type { CloseMilestoneInput, CreateMilestoneInput, UpdateMilestoneInput } from "@/schemas/milestone";
+import type { IsoTimestamp, IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Milestone, MilestoneProgress } from "@/types/milestone";
+
+export function findMilestoneById(orgId: OrgId, milestoneId: MilestoneId): Milestone | null {
+  const row = getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.id, milestoneId),
+  )).get();
+  return row ? toMilestone(row) : null;
+}
+
+/** A cross-project id is deliberately indistinguishable from a missing id. */
+export function requireOpenMilestone(
+  orgId: OrgId,
+  projectId: ProjectId,
+  milestoneId: MilestoneId,
+): Milestone {
+  const milestone = findMilestoneById(orgId, milestoneId);
+  if (!milestone || milestone.projectId !== projectId) {
+    throw new NotFoundError("Milestone", milestoneId);
+  }
+  if (milestone.closedAt !== null) throw new MilestoneStateError("closed");
+  return milestone;
+}
+
+function assertNameAvailable(orgId: OrgId, projectId: ProjectId, name: string, exceptId?: MilestoneId): void {
+  const taken = getDb().select({ id: milestones.id }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.projectId, projectId),
+    eq(milestones.normalizedName, name.trim().toLowerCase()),
+    exceptId === undefined ? undefined : ne(milestones.id, exceptId),
+  )).get();
+  if (taken) throw new MilestoneStateError("name_taken");
+}
+
+function assertOpenCapacity(orgId: OrgId, projectId: ProjectId): void {
+  const row = getDb().select({ value: count() }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId),
+    eq(milestones.projectId, projectId),
+    isNull(milestones.closedAt),
+  )).get();
+  if ((row?.value ?? 0) >= MAX_OPEN_MILESTONES_PER_PROJECT) {
+    throw new MilestoneStateError("too_many_open");
+  }
+}
+
+export function insertMilestone(input: CreateMilestoneInput, now: IsoTimestamp): Milestone {
+  return getDb().transaction((tx) => {
+    assertNameAvailable(input.orgId, input.projectId, input.name);
+    assertOpenCapacity(input.orgId, input.projectId);
+    const row = tx.insert(milestones).values({
+      id: newId(),
+      orgId: input.orgId,
+      projectId: input.projectId,
+      name: input.name,
+      normalizedName: input.name.trim().toLowerCase(),
+      targetDate: input.targetDate,
+      closedAt: null,
+      createdAt: now,
+      updatedAt: now,
+    }).returning().get();
+    return toMilestone(row);
+  });
+}
+
+export function updateMilestone(input: UpdateMilestoneInput, now: IsoTimestamp): Milestone {
+  return getDb().transaction((tx) => {
+    const milestone = requireFound(findMilestoneById(input.orgId, input.milestoneId), "Milestone", input.milestoneId);
+    if (input.name !== undefined) {
+      assertNameAvailable(input.orgId, milestone.projectId, input.name, milestone.id);
+    }
+    const row = tx.update(milestones).set({
+      ...(input.name === undefined ? {} : {
+        name: input.name,
+        normalizedName: input.name.trim().toLowerCase(),
+      }),
+      ...(input.targetDate === undefined ? {} : {
+        targetDate: input.targetDate,
+      }),
+      updatedAt: now,
+    }).where(and(orgPredicate(milestones.orgId, input.orgId), eq(milestones.id, input.milestoneId))).returning().get();
+    return toMilestone(row);
+  });
+}
+
+export function reopenMilestone(orgId: OrgId, milestoneId: MilestoneId, now: IsoTimestamp): Milestone {
+  return getDb().transaction((tx) => {
+    const milestone = requireFound(findMilestoneById(orgId, milestoneId), "Milestone", milestoneId);
+    if (milestone.closedAt === null) throw new MilestoneStateError("already_open");
+    assertOpenCapacity(orgId, milestone.projectId);
+    return toMilestone(tx.update(milestones).set({ closedAt: null, updatedAt: now })
+      .where(and(orgPredicate(milestones.orgId, orgId), eq(milestones.id, milestoneId)))
+      .returning().get());
+  });
+}
+
+/** Validation, issue movement and closing commit together before any events. */
+export function closeMilestone(input: CloseMilestoneInput, now: IsoTimestamp): {
+  milestone: Milestone;
+  movedIssueIds: readonly IssueId[];
+} {
+  return getDb().transaction((tx) => {
+    const milestone = requireFound(findMilestoneById(input.orgId, input.milestoneId), "Milestone", input.milestoneId);
+    if (milestone.closedAt !== null) throw new MilestoneStateError("closed");
+    if (input.moveOpenIssuesTo !== null) {
+      if (input.moveOpenIssuesTo === milestone.id) {
+        throw new NotFoundError("Milestone", input.moveOpenIssuesTo);
+      }
+      requireOpenMilestone(input.orgId, milestone.projectId, input.moveOpenIssuesTo);
+    }
+
+    const moved = tx.update(issues).set({
+      milestoneId: input.moveOpenIssuesTo,
+      updatedAt: now,
+    }).where(and(
+      orgPredicate(issues.orgId, input.orgId),
+      eq(issues.projectId, milestone.projectId),
+      eq(issues.milestoneId, milestone.id),
+      livePredicate(issues.archivedAt, {}),
+      notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+    )).returning({ id: issues.id }).all();
+
+    const closed = tx.update(milestones).set({ closedAt: now, updatedAt: now })
+      .where(and(orgPredicate(milestones.orgId, input.orgId), eq(milestones.id, milestone.id)))
+      .returning().get();
+    return {
+      milestone: toMilestone(closed),
+      movedIssueIds: moved.map((row) => row.id as IssueId),
+    };
+  });
+}
+
+export function listMilestones(orgId: OrgId, projectId: ProjectId): readonly Milestone[] {
+  return getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.projectId, projectId),
+  )).orderBy(
+    asc(isNotNull(milestones.closedAt)),
+    asc(isNull(milestones.targetDate)),
+    asc(sql`julianday(${milestones.targetDate})`),
+    asc(milestones.createdAt),
+    asc(milestones.id),
+  ).all().map(toMilestone);
+}
+
+/** Aggregate every live issue; progress is independent of list pagination. */
+export function getMilestoneProgress(orgId: OrgId, milestoneId: MilestoneId): MilestoneProgress {
+  const counts = getDb().select({ status: issues.status, value: count() }).from(issues).where(and(
+    orgPredicate(issues.orgId, orgId),
+    eq(issues.milestoneId, milestoneId),
+    livePredicate(issues.archivedAt, {}),
+  )).groupBy(issues.status).all();
+  const total = counts.reduce((sum, row) => sum + row.value, 0);
+  const closed = counts.reduce((sum, row) => sum + (CLOSED_ISSUE_STATUSES.includes(row.status) ? row.value : 0), 0);
+  return { total, open: total - closed, closed };
+}

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { subscribe } from "@/lib/event-bus";
+import { isDomainError, toAppError } from "@/lib/errors";
+import { MilestoneStateError } from "@/lib/milestones";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { createIssueSchema } from "@/schemas/issue";
+import { closeMilestoneSchema, createMilestoneSchema, setIssueMilestoneSchema, updateMilestoneSchema } from "@/schemas/milestone";
+import { updateNotificationPreferenceSchema } from "@/schemas/notification";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as preferenceRepo from "@/server/repositories/notification-preference-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { NotFoundError } from "@/server/services/_support";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import * as issueService from "@/server/services/issue-service";
+import * as milestoneService from "@/server/services/milestone-service";
+import { listNotifications } from "@/server/services/notification-service";
+import { toIsoTimestamp } from "@/types/common";
+import type { MilestoneId, UserId } from "@/types/common";
+import type { TaskflowEventMap, TaskflowEventType, Unsubscribe } from "@/types/event";
+import type { IssueStatus } from "@/types/issue";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+let detachActivity: Unsubscribe;
+let tenant: Tenant;
+let sequence = 0;
+const detachers: Unsubscribe[] = [];
+const missing = "00000000000000000000000000" as MilestoneId;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachActivity = registerActivityListeners();
+});
+
+beforeEach(async () => {
+  tenant = await createTenant(`milestones-${++sequence}`);
+});
+
+afterEach(() => {
+  for (const off of detachers.splice(0)) off();
+  vi.useRealTimers();
+});
+
+afterAll(() => {
+  detachActivity();
+  cleanup();
+});
+
+function capture<K extends TaskflowEventType>(type: K): TaskflowEventMap[K][] {
+  const seen: TaskflowEventMap[K][] = [];
+  detachers.push(subscribe(type, (payload) => { seen.push(payload); }));
+  return seen;
+}
+
+function milestone(name: string, targetDate: string | null = null, projectId = tenant.project.id) {
+  return milestoneService.createMilestone(tenant.actors.member, createMilestoneSchema.parse({
+    orgId: tenant.org.id, projectId, name, targetDate,
+  }));
+}
+
+function issue(milestoneId: MilestoneId | null, status: IssueStatus = "backlog", assigneeId: UserId | null = null) {
+  return issueService.createIssue(tenant.actors.member, {
+    ...issueInput(tenant.org.id, tenant.project.id), milestoneId, status, assigneeId,
+  });
+}
+
+function close(milestoneId: MilestoneId, moveOpenIssuesTo: MilestoneId | null = null) {
+  return milestoneService.closeMilestone(tenant.actors.member, {
+    orgId: tenant.org.id, milestoneId, moveOpenIssuesTo,
+  });
+}
+
+describe("milestones", () => {
+  it("parses defaults and maps state conflicts", () => {
+    const input = { orgId: tenant.org.id, projectId: tenant.project.id, name: "Launch" };
+    expect(createMilestoneSchema.parse(input).targetDate).toBeNull();
+    expect(closeMilestoneSchema.parse({ orgId: tenant.org.id, milestoneId: missing }).moveOpenIssuesTo).toBeNull();
+    expect(createIssueSchema.parse({ ...issueInput(tenant.org.id, tenant.project.id), milestoneId: undefined }).milestoneId).toBeNull();
+    expect(updateMilestoneSchema.safeParse({ orgId: tenant.org.id, milestoneId: missing, name: "" }).success).toBe(false);
+    expect(setIssueMilestoneSchema.safeParse({ orgId: tenant.org.id, issueId: missing }).success).toBe(false);
+    for (const reason of ["closed", "already_open", "too_many_open", "name_taken"] as const) {
+      const error = new MilestoneStateError(reason);
+      expect(isDomainError(error)).toBe(true);
+      expect(toAppError(error)).toMatchObject({ code: "conflict", meta: { reason } });
+    }
+  });
+
+  it("persists names and dates, including clearing the date and editing closed milestones", async () => {
+    const created = await milestone("Launch", "2026-06-01T00:00:00.000Z");
+    expect(created.closedAt).toBeNull();
+    expect(created).toMatchObject({ orgId: tenant.org.id, projectId: tenant.project.id, name: "Launch" });
+    await close(created.id);
+    const updated = await milestoneService.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: created.id, name: "Release", targetDate: null,
+    });
+    expect(updated).toMatchObject({ name: "Release", targetDate: null });
+    expect(updated.closedAt).not.toBeNull();
+    expect((await milestoneService.getMilestone(tenant.actors.viewer, tenant.org.id, created.id)).milestone).toEqual(updated);
+  });
+
+  it("reserves normalized names across open and closed milestones but allows them in another project", async () => {
+    const first = await milestone("  Launch  ");
+    const second = await milestone("Beta");
+    await close(first.id);
+    await expect(milestone("LAUNCH")).rejects.toMatchObject({ reason: "name_taken" });
+    await expect(milestoneService.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: second.id, name: " launch ",
+    })).rejects.toMatchObject({ reason: "name_taken" });
+    expect((await milestoneService.getMilestone(tenant.actors.viewer, tenant.org.id, second.id)).milestone.name).toBe("Beta");
+    const otherProject = await projectRepo.insertProject({ ...tenant.project, slug: "other", key: "OTH" });
+    await expect(milestone("launch", null, otherProject.id)).resolves.toMatchObject({ name: "launch" });
+    await expect(milestoneService.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: first.id, name: "LAUNCH",
+    })).resolves.toMatchObject({ name: "LAUNCH" });
+  });
+
+  it("enforces the open cap for creates and reopens, including concurrent creates", async () => {
+    const closed = await milestone("Previous");
+    await close(closed.id);
+    const results = await Promise.allSettled(Array.from({ length: MAX_OPEN_MILESTONES_PER_PROJECT + 1 }, (_, index) => milestone(`M${index}`)));
+    expect(results.filter((result) => result.status === "fulfilled")).toHaveLength(MAX_OPEN_MILESTONES_PER_PROJECT);
+    expect(results.filter((result) => result.status === "rejected")).toMatchObject([{ reason: { reason: "too_many_open" } }]);
+    await expect(milestoneService.reopenMilestone(tenant.actors.member, tenant.org.id, closed.id)).rejects.toMatchObject({ reason: "too_many_open" });
+    const open = await milestoneService.listMilestones(tenant.actors.viewer, tenant.org.id, tenant.project.id);
+    await close(open[0].milestone.id);
+    await expect(milestoneService.reopenMilestone(tenant.actors.member, tenant.org.id, closed.id)).resolves.toMatchObject({ closedAt: null });
+  });
+
+  it("allows viewers to read while requiring project:update for every milestone write", async () => {
+    const created = await milestone("Launch");
+    const actor = tenant.actors.viewer;
+    const orgId = tenant.org.id;
+    const milestoneId = created.id;
+    for (const operation of [
+      () => milestoneService.createMilestone(actor, { orgId, projectId: tenant.project.id, name: "Other", targetDate: null }),
+      () => milestoneService.updateMilestone(actor, { orgId, milestoneId, name: "Renamed" }),
+      () => milestoneService.closeMilestone(actor, { orgId, milestoneId, moveOpenIssuesTo: null }),
+      () => milestoneService.reopenMilestone(actor, orgId, milestoneId),
+    ]) await expect(operation()).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(milestoneService.listMilestones(actor, orgId, tenant.project.id)).resolves.toHaveLength(1);
+    await expect(milestoneService.getMilestone(actor, orgId, milestoneId)).resolves.toMatchObject({ progress: { total: 0, open: 0, closed: 0 }, overdue: false });
+  });
+
+  it("checks tenant scope first for every operation and hides foreign project and milestone ids", async () => {
+    const other = await createTenant(`foreign-${sequence}`);
+    const foreign = await milestoneService.createMilestone(other.actors.member, {
+      orgId: other.org.id, projectId: other.project.id, name: "Foreign", targetDate: null,
+    });
+    const own = await milestone("Own");
+    const ownIssue = await issue(own.id);
+    const actor = tenant.actors.member;
+    for (const operation of [
+      () => milestoneService.createMilestone(actor, { orgId: other.org.id, projectId: tenant.project.id, name: "Scope", targetDate: null }),
+      () => milestoneService.updateMilestone(actor, { orgId: other.org.id, milestoneId: own.id }),
+      () => milestoneService.closeMilestone(actor, { orgId: other.org.id, milestoneId: own.id, moveOpenIssuesTo: null }),
+      () => milestoneService.reopenMilestone(actor, other.org.id, own.id),
+      () => milestoneService.getMilestone(actor, other.org.id, own.id),
+      () => milestoneService.listMilestones(actor, other.org.id, tenant.project.id),
+      () => issueService.setIssueMilestone(actor, { orgId: other.org.id, issueId: ownIssue.id, milestoneId: null }),
+    ]) await expect(operation()).rejects.toBeInstanceOf(TenantScopeError);
+    for (const milestoneId of [foreign.id, missing]) {
+      const orgId = tenant.org.id;
+      for (const operation of [
+        () => milestoneService.updateMilestone(actor, { orgId, milestoneId }),
+        () => milestoneService.closeMilestone(actor, { orgId, milestoneId, moveOpenIssuesTo: null }),
+        () => milestoneService.reopenMilestone(actor, orgId, milestoneId),
+        () => milestoneService.getMilestone(actor, orgId, milestoneId),
+        () => issueService.setIssueMilestone(actor, { orgId, issueId: ownIssue.id, milestoneId }),
+      ]) await expect(operation()).rejects.toBeInstanceOf(NotFoundError);

+export class MilestoneStateError extends Error {
+  readonly code = "conflict";
+
+  constructor(
+    readonly reason: "closed" | "already_open" | "too_many_open" | "name_taken",
+  ) {
+    const messages = {
+      closed: "This milestone is closed.",
+      already_open: "This milestone is already open.",
+      too_many_open: "This project has too many open milestones.",
+      name_taken: "This project already has a milestone with that name.",
+    };
+    super(messages[reason]);
+    this.name = "MilestoneStateError";
+  }
+}

--- /private/tmp/bench-scratch/5d4b38d1-5c2f-4c61-b085-521f7705abb5/src/server/jobs/billing-renewal-job.ts	1970-01-01 09:00:00
+++ /private/tmp/bench-scratch/965bfadd-dce4-47a9-9356-096a9e66e0b3/src/server/jobs/billing-renewal-job.ts	2026-10-14 22:40:09
@@ -0,0 +1,57 @@
+import { billingPeriodEnd } from "@/lib/billing-period";
+import { emit } from "@/lib/event-bus";
+import * as subscriptionRepo from "@/server/repositories/subscription-repository";
+import { periodCharge, publishInvoice } from "@/server/services/billing-service";
+import { toIsoTimestamp } from "@/types/common";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+export async function runBillingRenewalJob(now: Date): Promise<JobResult> {
+  return runJob("billing-renewal", async (result) => {
+    const stamp = toIsoTimestamp(now);
+    const due = await subscriptionRepo.listSubscriptionsDue(stamp);
+
+    for (const candidate of due) {
+      // Read again inside each transaction: overlapping runs cannot renew the
+      // same period, and subsequent periods use the seats currently subscribed.
+      while (true) {
+        const change = subscriptionRepo.updateSubscription(candidate.orgId, now, (current) => {
+          if (current.status === "canceled") {
+            if (current.cancelAt === null || current.cancelAt > stamp) return null;
+            return {
+              patch: {
+                plan: "free",
+                status: "active",
+                interval: "monthly",
+                cancelAt: null,
+                currentPeriodStart: current.cancelAt,
+                currentPeriodEnd: billingPeriodEnd(current.cancelAt, "monthly"),
+              },
+            };
+          }
+          if (current.status !== "active" || current.currentPeriodEnd > stamp) return null;
+          return {
+            patch: {
+              currentPeriodStart: current.currentPeriodEnd,
+              currentPeriodEnd: billingPeriodEnd(current.currentPeriodEnd, current.interval),
+            },
+            amountCents: periodCharge(current.plan, current.seats, current.interval),
+          };
+        });
+        if (change === null) break;
+
+        if (change.invoice) await publishInvoice(change.invoice, now);
+        if (change.previous.status === "canceled") {
+          await emit("billing.plan_changed", {
+            orgId: candidate.orgId,
+            actorId: null,
+            occurredAt: stamp,
+            from: change.previous.plan,
+            to: "free",
+          });
+        }
+        result.processed += 1;
+      }
+    }
+  });
+}

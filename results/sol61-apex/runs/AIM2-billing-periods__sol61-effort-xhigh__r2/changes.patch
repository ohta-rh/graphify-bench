@@ -0,0 +1,35 @@
+import type { BillingInterval } from "@/types/billing";
+import { toIsoTimestamp } from "@/types/common";
+import type { IsoTimestamp } from "@/types/common";
+
+const MS_PER_DAY = 24 * 60 * 60 * 1_000;
+
+/** Calendar arithmetic in UTC, preserving the time and carrying clamped days forward. */
+export function billingPeriodEnd(
+  start: Date | IsoTimestamp,
+  interval: BillingInterval,
+): IsoTimestamp {
+  const end = new Date(start);
+  const day = end.getUTCDate();
+  end.setUTCDate(1);
+  end.setUTCMonth(end.getUTCMonth() + (interval === "annual" ? 12 : 1));
+  const lastDay = new Date(end);
+  lastDay.setUTCMonth(lastDay.getUTCMonth() + 1, 0);
+  end.setUTCDate(Math.min(day, lastDay.getUTCDate()));
+  return toIsoTimestamp(end);
+}
+
+export function prorateCharge(
+  fullAmountCents: number,
+  periodStart: IsoTimestamp,
+  periodEnd: IsoTimestamp,
+  now: Date,
+): number {
+  const end = new Date(periodEnd).getTime();
+  const days = Math.max(
+    1,
+    Math.round((end - new Date(periodStart).getTime()) / MS_PER_DAY),
+  );
+  const daysLeft = Math.max(0, Math.ceil((end - now.getTime()) / MS_PER_DAY));
+  return Math.floor((Math.max(0, fullAmountCents) * daysLeft) / days);
+}

+/** Walk the ancestors before checking depth, so a cycle is always a cycle. */
+async function assertPlacement(
+  issueId: IssueId | null,
+  parent: Issue | null,
+  subtreeHeight: number,
+): Promise<void> {
+  const subjectId = issueId ?? parent!.id;
+  const seen = new Set<string>(issueId === null ? [] : [issueId]);
+  let depth = 0;
+  let ancestor = parent;
+  while (ancestor !== null) {
+    if (seen.has(ancestor.id)) {
+      throw new IssueHierarchyError(subjectId, "cycle");
+    }
+    seen.add(ancestor.id);
+    depth += 1;
+    if (ancestor.parentId === null) break;
+    const next = await issueRepo.findIssueById(ancestor.orgId, ancestor.parentId);
+    ancestor = requireFound(
+      next?.projectId === ancestor.projectId ? next : null,
+      "Issue",
+      ancestor.parentId,
+    );
+  }
+  if (depth + subtreeHeight > MAX_SUB_ISSUE_DEPTH) {
+    throw new IssueHierarchyError(subjectId, "too_deep");
+  }

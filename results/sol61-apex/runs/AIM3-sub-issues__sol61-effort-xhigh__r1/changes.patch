+import * as service from "@/server/services/issue-service";
+import { listNotifications, updatePreference } from "@/server/services/notification-service";
+import { registerSearchListeners } from "@/server/services/search-service";
+import { registerUsageListeners } from "@/server/services/usage-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+import type { CreateIssueInput } from "@/schemas/issue";
+import type { IssueId } from "@/types/common";
+import type { Issue, IssueStatus } from "@/types/issue";
+
+let cleanup: () => void;
+let tenant: Tenant;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  tenant = await createTenant("hierarchy");
+});
+afterAll(() => cleanup());
+
+function create(overrides: Partial<CreateIssueInput> = {}): Promise<Issue> {
+  return service.createIssue(tenant.actors.member, {
+    ...issueInput(tenant.org.id, tenant.project.id),
+    ...overrides,
+  });
+}
+
+function place(issue: Issue, parent: Issue | null) {
+  return service.setIssueParent(tenant.actors.member, {
+    orgId: tenant.org.id,
+    issueId: issue.id,
+    parentId: parent?.id ?? null,
+  });
+}
+
+function status(issue: Issue, value: IssueStatus) {
+  return service.changeIssueStatus(tenant.actors.member, {
+    orgId: tenant.org.id,
+    issueId: issue.id,
+    status: value,
+  });
+}
+
+async function notices(parent: Issue) {
+  const page = await listNotifications(tenant.actors.owner, {
+    orgId: tenant.org.id,
+    recipientId: parent.assigneeId!,
+    kind: ["sub_issues_completed"],
+    unreadOnly: false,
+    limit: 100,
+    cursor: null,
+  });
+  return page.items.filter((row) => row.href === `/issues/${parent.id}`);
+}
+
+describe("issue hierarchies", () => {
+  it("creates, moves and detaches subtrees, announcing only parentId", async () => {
+    const first = await create();
+    const second = await create();
+    const child = await create({ parentId: first.id });
+    const grandchild = await create({ parentId: child.id });
+    const received: unknown[] = [];
+    const off = subscribe("issue.updated", (payload) => { received.push(payload); });
+    try {
+      expect((await place(child, second)).parentId).toBe(second.id);
+      expect(await issueRepo.findIssueById(tenant.org.id, grandchild.id)).toMatchObject({ parentId: child.id });
+      expect(await service.getIssueRollup(tenant.actors.viewer, tenant.org.id, first.id)).toEqual({ total: 0, open: 0, closed: 0 });
+      expect(await service.getIssueRollup(tenant.actors.viewer, tenant.org.id, second.id)).toEqual({ total: 2, open: 2, closed: 0 });
+      expect((await place(child, null)).parentId).toBeNull();
+      expect(received).toEqual([
+        expect.objectContaining({ issueId: child.id, changedFields: ["parentId"] }),
+        expect.objectContaining({ issueId: child.id, changedFields: ["parentId"] }),
+      ]);
+      expect(setIssueParentSchema.parse({ orgId: tenant.org.id, issueId: child.id, parentId: null }).parentId).toBeNull();
+    } finally { off(); }
+  });
+
+  it("rejects self and descendant cycles and judges a move by the deepest descendant", async () => {
+    const root = await create();
+    let deepest = root;
+    for (let depth = 1; depth <= MAX_SUB_ISSUE_DEPTH; depth += 1) {
+      deepest = await create({ parentId: deepest.id });
+    }
+    const target = await create();
+    const before = await issueRepo.findIssueById(tenant.org.id, root.id);
+    const received: unknown[] = [];
+    const off = subscribe("issue.updated", (payload) => { received.push(payload); });
+    try {
+      for (const parent of [root, deepest]) {
+        await expect(place(root, parent)).rejects.toMatchObject({ issueId: root.id, reason: "cycle", code: "conflict" });
+      }
+      await expect(place(root, target)).rejects.toMatchObject({ reason: "too_deep" });
+      await expect(create({ parentId: deepest.id })).rejects.toBeInstanceOf(IssueHierarchyError);
+      expect(await issueRepo.findIssueById(tenant.org.id, root.id)).toEqual(before);
+      expect(received).toHaveLength(0);
+      await place(deepest, null);
+      await place(deepest, target);
+    } finally { off(); }
+  });
+
+  it("hides parents from other projects and workspaces and refuses archived parents before creation", async () => {
+    const other = await createTenant("hierarchy-other");
+    const foreign = await service.createIssue(other.actors.member, issueInput(other.org.id, other.project.id));
+    const project = await projectRepo.insertProject({ ...tenant.project, slug: "other", key: "OTHER" });
+    const otherProject = await create({ projectId: project.id });
+    const archived = await create();
+    await service.archiveIssue(tenant.actors.member, tenant.org.id, archived.id);
+    const child = await create();
+    const before = await issueRepo.countIssues(tenant.org.id, tenant.project.id, { includeArchived: true });
+    const received: unknown[] = [];
+    const off = subscribe("issue.created", (payload) => { received.push(payload); });
+    try {
+      for (const parent of [foreign, otherProject]) {
+        await expect(place(child, parent)).rejects.toBeInstanceOf(NotFoundError);
+        await expect(create({ parentId: parent.id })).rejects.toBeInstanceOf(NotFoundError);
+      }
+      await expect(place(child, archived)).rejects.toBeInstanceOf(AlreadyArchivedError);
+      await expect(create({ parentId: archived.id })).rejects.toBeInstanceOf(AlreadyArchivedError);
+      expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id, { includeArchived: true })).toBe(before);
+      expect(received).toHaveLength(0);
+      expect(await issueRepo.findIssueById(tenant.org.id, child.id)).toEqual(child);
+    } finally { off(); }
+  });
+
+  it("applies tenant, existence, edit, ownership and archive guards", async () => {
+    const root = await create();
+    const child = await create();
+    const other = await createTenant("hierarchy-guards");
+    const missing = "00000000000000000000000000" as IssueId;
+    for (const read of [service.listSubIssues, service.getIssueRollup]) {
+      await expect(read(other.actors.owner, tenant.org.id, root.id)).rejects.toBeInstanceOf(TenantScopeError);
+      await expect(read(other.actors.owner, other.org.id, root.id)).rejects.toBeInstanceOf(NotFoundError);
+      await expect(read(tenant.actors.viewer, tenant.org.id, missing)).rejects.toBeInstanceOf(NotFoundError);
+      await expect(read({ ...tenant.actors.viewer, role: "invalid" as never }, tenant.org.id, root.id)).rejects.toBeInstanceOf(PermissionDeniedError);
+    }
+    const input = { orgId: tenant.org.id, issueId: child.id, parentId: root.id };
+    await expect(service.setIssueParent(other.actors.owner, input)).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(service.setIssueParent(other.actors.owner, { ...input, orgId: other.org.id })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(service.setIssueParent(tenant.actors.viewer, input)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(service.setIssueParent({ ...tenant.actors.member, role: "viewer" }, input)).resolves.toMatchObject({ parentId: root.id });
+    await service.archiveIssue(tenant.actors.member, tenant.org.id, child.id);
+    await expect(place(child, null)).rejects.toBeInstanceOf(AlreadyArchivedError);
+  });
+
+  it("lists only live direct children, ordered by creation time and issue number, and counts all descendants", async () => {
+    const root = await create();
+    const first = await create({ parentId: root.id });
+    const second = await create({ parentId: root.id, status: "done" });
+    await create({ parentId: second.id, status: "canceled" });
+    const hidden = await create({ parentId: root.id });
+    await issueRepo.archiveIssue(tenant.org.id, hidden.id);
+    getDb().update(issues).set({ createdAt: "2020-01-01T00:00:00.000Z" }).where(eq(issues.id, first.id)).run();
+    getDb().update(issues).set({ createdAt: "2020-01-01T00:00:00.000Z" }).where(eq(issues.id, second.id)).run();
+    expect((await service.listSubIssues(tenant.actors.viewer, tenant.org.id, root.id)).map((row) => row.id)).toEqual([first.id, second.id]);
+    expect(await service.getIssueRollup(tenant.actors.viewer, tenant.org.id, root.id)).toEqual({ total: 3, open: 1, closed: 2 });
+    getDb().update(issues).set({ createdAt: "2019-01-01T00:00:00.000Z" }).where(eq(issues.id, second.id)).run();
+    expect((await service.listSubIssues(tenant.actors.viewer, tenant.org.id, root.id)).map((row) => row.id)).toEqual([second.id, first.id]);
+  });
+
+  it("counts and archives more than a page, preserving archived nodes and emitting events for usage and search", async () => {
+    const root = await create();
+    const children: Issue[] = [];
+    for (let index = 0; index < 105; index += 1) {
+      children.push(await issueRepo.insertIssue({
+        ...issueInput(tenant.org.id, tenant.project.id),
+        parentId: root.id,
+        status: index % 2 === 0 ? "done" : "todo",
+      }, tenant.userIds.member, await issueRepo.nextIssueNumber(tenant.org.id, tenant.project.id)));
+    }
+    const hidden = children[0];
+    const belowHidden = await create({ parentId: hidden.id });
+    await issueRepo.archiveIssue(tenant.org.id, hidden.id);
+    const preserved = await issueRepo.findIssueById(tenant.org.id, hidden.id);
+    expect(await service.getIssueRollup(tenant.actors.viewer, tenant.org.id, root.id)).toEqual({ total: 105, open: 53, closed: 52 });
+    expect(await service.listSubIssues(tenant.actors.viewer, tenant.org.id, root.id)).toHaveLength(104);
+    const live = [root, ...children.slice(1), belowHidden];
+    for (const issue of live) {
+      await searchRepo.upsertSearchDocument(tenant.org.id, "issue", issue.id, issue.title, issue.projectId);
+    }
+    const usage = await usageRepo.recomputeUsage(tenant.org.id);
+    const searchCount = await searchRepo.countIndexed(tenant.org.id);
+    const received: IssueId[] = [];
+    const off = subscribe("issue.archived", (payload) => { received.push(payload.issueId); });
+    const offUsage = registerUsageListeners();
+    const offSearch = registerSearchListeners();
+    try {
+      await service.archiveIssue(tenant.actors.member, tenant.org.id, root.id);
+      expect(new Set(received)).toEqual(new Set(live.map((row) => row.id)));
+      expect(received).toHaveLength(live.length);
+      for (const issue of live) {
+        expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.archivedAt).not.toBeNull();
+      }
+      expect(await issueRepo.findIssueById(tenant.org.id, hidden.id)).toEqual(preserved);
+      expect((await usageRepo.getUsage(tenant.org.id)).issuesUsed).toBe(usage.issuesUsed - live.length);
+      expect(await searchRepo.countIndexed(tenant.org.id)).toBe(searchCount - live.length);
+    } finally { off(); offUsage(); offSearch(); }
+  });
+
+  it("notifies only the direct parent's assignee when the last open descendant closes, again after reopening", async () => {
+    const root = await create({ assigneeId: tenant.userIds.admin });
+    const child = await create({ parentId: root.id, assigneeId: tenant.userIds.admin });
+    const grandchild = await create({ parentId: child.id });
+    const sibling = await create({ parentId: root.id });
+    await status(child, "done");
+    expect(await notices(root)).toHaveLength(0);
+    await status(grandchild, "canceled");
+    expect(await notices(child)).toHaveLength(1);
+    expect(await notices(root)).toHaveLength(0);
+    await status(sibling, "done");
+    expect(await notices(root)).toHaveLength(1);
+    await status(sibling, "canceled");
+    await status(sibling, "canceled");
+    expect(await notices(root)).toHaveLength(1);
+    await status(sibling, "todo");
+    expect(await notices(root)).toHaveLength(1);
+    await status(sibling, "done");
+    expect(await notices(root)).toHaveLength(2);
+  });
+
+  it("does not notify for moves, and archives open subtrees without notifying archived parents", async () => {
+    const root = await create({ assigneeId: tenant.userIds.admin });
+    const child = await create({ parentId: root.id, assigneeId: tenant.userIds.admin });
+    await create({ parentId: child.id });
+    await place(child, null);
+    expect(await notices(root)).toHaveLength(0);
+    await place(child, root);
+    await service.archiveIssue(tenant.actors.member, tenant.org.id, child.id);
+    expect(await notices(root)).toHaveLength(1);
+    expect(await notices(child)).toHaveLength(0);
+    expect((await issueRepo.findIssueById(tenant.org.id, root.id))?.archivedAt).toBeNull();
+    await expect(service.archiveIssue(tenant.actors.member, tenant.org.id, child.id)).rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await notices(root)).toHaveLength(1);
+  });
+
+  it("honours preferences for the new kind and excludes self and unassigned parents", async () => {
+    await updatePreference(tenant.actors.admin, updateNotificationPreferenceSchema.parse({
+      orgId: tenant.org.id,
+      userId: tenant.userIds.admin,
+      kind: "sub_issues_completed",
+      inApp: true,
+      email: false,
+      digestOnly: false,
+    }));
+    const root = await create({ assigneeId: tenant.userIds.admin });
+    const child = await create({ parentId: root.id });
+    await status(child, "done");
+    expect((await notices(root))[0]?.channels).toEqual(["in_app"]);
+    await updatePreference(tenant.actors.admin, {
+      orgId: tenant.org.id, userId: tenant.userIds.admin, kind: "sub_issues_completed",
+      inApp: false, email: false, digestOnly: false,
+    });
+    await status(child, "todo");
+    await status(child, "done");
+    expect(await notices(root)).toHaveLength(1);
+    const self = await create({ assigneeId: tenant.userIds.member });
+    await status(await create({ parentId: self.id }), "done");
+    expect(await notices(self)).toHaveLength(0);
+    const unassigned = await create();
+    const received: unknown[] = [];
+    const off = subscribe("issue.sub_issues_completed", (payload) => { received.push(payload); });
+    try {
+      await status(await create({ parentId: unassigned.id }), "done");
+      expect(received).toHaveLength(0);
+    } finally { off(); }
+  });
+});

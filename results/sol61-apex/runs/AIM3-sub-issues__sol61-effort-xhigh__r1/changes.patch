+
+function subtreeHeight(issueId: IssueId, descendants: readonly Issue[]): number {
+  const children = new Map<IssueId, IssueId[]>();
+  for (const issue of descendants) {
+    if (issue.parentId === null) continue;
+    const siblings = children.get(issue.parentId) ?? [];
+    siblings.push(issue.id);
+    children.set(issue.parentId, siblings);
+  }
+  const pending = [{ id: issueId, depth: 0 }];
+  const seen = new Set<IssueId>();
+  let height = 0;
+  while (pending.length > 0) {
+    const current = pending.pop()!;
+    if (seen.has(current.id)) throw new IssueHierarchyError(issueId, "cycle");

+function issueSubtreeIds(orgId: OrgId, issueId: IssueId): SQL {
+  return sql`(
+    with recursive subtree(id, project_id) as (
+      select ${issues.id}, ${issues.projectId} from ${issues}
+      where ${orgPredicate(issues.orgId, orgId)} and ${eq(issues.id, issueId)}
+      union
+      select child.id, child.project_id from issues as child
+      join subtree on child.parent_id = subtree.id
+      where child.org_id = ${orgId} and child.project_id = subtree.project_id
+    )
+    select id from subtree

+
+/** Reserve issue prefixes even after a project has been archived. */
+export function uniqueProjectKey(input: string, taken: Iterable<string>): string {
+  const base = input.slice(0, 4);
+  const used = new Set(taken);
+  if (!used.has(base)) return base;
+
+  for (let suffix = 2; suffix < 1_000; suffix += 1) {
+    const number = String(suffix);
+    const candidate = `${base.slice(0, 4 - number.length)}${number}`;
+    if (!used.has(candidate)) return candidate;
+  }
+  throw new Error(`Exhausted unique project keys for ${base}`);
+}

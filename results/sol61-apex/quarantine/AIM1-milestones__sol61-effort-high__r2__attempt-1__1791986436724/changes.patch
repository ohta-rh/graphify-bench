@@ -0,0 +1,125 @@
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { emit } from "@/lib/event-bus";
+import { MilestoneStateError } from "@/lib/milestones";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as milestoneRepo from "@/server/repositories/milestone-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { requireOpenMilestone } from "./_milestone-support";
+import { actorEnvelope, NotFoundError, projectResource, requireFound } from "./_support";
+import type { CreateMilestoneInput, UpdateMilestoneInput, CloseMilestoneInput } from "@/schemas/milestone";
+import type { IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { Milestone, MilestoneWithProgress } from "@/types/milestone";
+
+async function requireProject(actor: Actor, orgId: OrgId, projectId: ProjectId, write: boolean) {
+  const project = requireFound(await projectRepo.findProjectById(orgId, projectId), "Project", projectId);
+  assertCan(actor, write ? "project:update" : "project:read", projectResource(project));
+  if (write) assertNotArchived("Project", project.id, project);
+  return project;
+}
+
+function requireMilestone(orgId: OrgId, milestoneId: MilestoneId): Milestone {
+  return requireFound(milestoneRepo.findMilestoneById(orgId, milestoneId), "Milestone", milestoneId);
+}
+
+function assertRoom(orgId: OrgId, projectId: ProjectId): void {
+  if (milestoneRepo.countOpenMilestones(orgId, projectId) >= MAX_OPEN_MILESTONES_PER_PROJECT) {
+    throw new MilestoneStateError("too_many_open");
+  }
+}
+
+function assertNameAvailable(orgId: OrgId, projectId: ProjectId, name: string, exceptId?: MilestoneId): void {
+  if (milestoneRepo.isNameTaken(orgId, projectId, name, exceptId)) {
+    throw new MilestoneStateError("name_taken");
+  }
+}
+
+export async function createMilestone(actor: Actor, input: CreateMilestoneInput): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  await requireProject(actor, input.orgId, input.projectId, true);
+  const milestone = milestoneRepo.transaction(() => {
+    assertNameAvailable(input.orgId, input.projectId, input.name);
+    assertRoom(input.orgId, input.projectId);
+    return milestoneRepo.insertMilestone(input, now);
+  });
+  await emit("milestone.created", { ...actorEnvelope(actor), occurredAt: now, milestoneId: milestone.id, projectId: milestone.projectId });
+  return milestone;
+}
+
+export async function updateMilestone(actor: Actor, input: UpdateMilestoneInput): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  const milestone = requireMilestone(input.orgId, input.milestoneId);
+  await requireProject(actor, input.orgId, milestone.projectId, true);
+  return milestoneRepo.transaction(() => {
+    if (input.name !== undefined) assertNameAvailable(input.orgId, milestone.projectId, input.name, milestone.id);
+    return milestoneRepo.updateMilestone(input, now);
+  });
+}
+
+export async function closeMilestone(
+  actor: Actor, input: CloseMilestoneInput,
+): Promise<{ milestone: Milestone; movedIssueIds: readonly IssueId[] }> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, input.orgId);
+  const before = requireMilestone(input.orgId, input.milestoneId);
+  await requireProject(actor, input.orgId, before.projectId, true);
+  const target = input.moveOpenIssuesTo ?? null;
+  const result = milestoneRepo.transaction(() => {
+    requireOpenMilestone(input.orgId, before.projectId, before.id);
+    if (target !== null) {
+      if (target === before.id) throw new NotFoundError("Milestone", target);
+      requireOpenMilestone(input.orgId, before.projectId, target);
+    }
+    const movedIssueIds = milestoneRepo.moveOpenIssues(input.orgId, before.projectId, before.id, target, now);
+    const milestone = milestoneRepo.setClosedAt(input.orgId, before.id, now, now);
+    return { milestone, movedIssueIds };
+  });
+  await emit("milestone.closed", {
+    ...actorEnvelope(actor), occurredAt: now, milestoneId: result.milestone.id,
+    projectId: result.milestone.projectId, movedToMilestoneId: target, movedIssueIds: result.movedIssueIds,
+  });
+  return result;
+}
+
+export async function reopenMilestone(actor: Actor, orgId: OrgId, milestoneId: MilestoneId): Promise<Milestone> {
+  const now = toIsoTimestamp(new Date());
+  assertOrgScope(actor, orgId);
+  const before = requireMilestone(orgId, milestoneId);
+  await requireProject(actor, orgId, before.projectId, true);
+  const milestone = milestoneRepo.transaction(() => {
+    if (requireMilestone(orgId, milestoneId).closedAt === null) throw new MilestoneStateError("already_open");
+    assertRoom(orgId, before.projectId);
+    return milestoneRepo.setClosedAt(orgId, milestoneId, null, now);
+  });
+  await emit("milestone.reopened", { ...actorEnvelope(actor), occurredAt: now, milestoneId, projectId: milestone.projectId });
+  return milestone;
+}
+
+function withProgress(milestone: Milestone, now: number): MilestoneWithProgress {
+  const progress = milestoneRepo.getProgress(milestone);
+  return {
+    milestone, progress,
+    overdue: milestone.closedAt === null && milestone.targetDate !== null &&
+      Date.parse(milestone.targetDate) < now && progress.open > 0,
+  };
+}
+
+export async function listMilestones(actor: Actor, orgId: OrgId, projectId: ProjectId): Promise<readonly MilestoneWithProgress[]> {
+  const now = Date.now();
+  assertOrgScope(actor, orgId);
+  await requireProject(actor, orgId, projectId, false);
+  return milestoneRepo.listMilestones(orgId, projectId).map((milestone) => withProgress(milestone, now));
+}
+
+export async function getMilestone(actor: Actor, orgId: OrgId, milestoneId: MilestoneId): Promise<MilestoneWithProgress> {
+  const now = Date.now();
+  assertOrgScope(actor, orgId);
+  const milestone = requireMilestone(orgId, milestoneId);
+  await requireProject(actor, orgId, milestone.projectId, false);
+  return withProgress(milestone, now);
+}

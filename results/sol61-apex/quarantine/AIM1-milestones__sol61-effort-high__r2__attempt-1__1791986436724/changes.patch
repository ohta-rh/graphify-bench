+
+export const createMilestoneSchema = z.object({
+  orgId: orgIdSchema,
+  projectId: projectIdSchema,
+  name: z.string().min(1).max(80),
+  targetDate: isoTimestampSchema.nullable().default(null),
+});
+
+export const updateMilestoneSchema = z.object({
+  orgId: orgIdSchema,
+  milestoneId: milestoneIdSchema,
+  name: z.string().min(1).max(80).optional(),
+  targetDate: isoTimestampSchema.nullable().optional(),
+});
+
+export const closeMilestoneSchema = z.object({
+  orgId: orgIdSchema,
+  milestoneId: milestoneIdSchema,
+  moveOpenIssuesTo: milestoneIdSchema.nullable().default(null),
+});
+
+export const setIssueMilestoneSchema = z.object({
+  orgId: orgIdSchema,
+  issueId: issueIdSchema,
+  milestoneId: milestoneIdSchema.nullable(),
+});
+
+export type CreateMilestoneInput = z.infer<typeof createMilestoneSchema>;
+export type UpdateMilestoneInput = z.infer<typeof updateMilestoneSchema>;
+export type CloseMilestoneInput = z.infer<typeof closeMilestoneSchema>;
+export type SetIssueMilestoneInput = z.infer<typeof setIssueMilestoneSchema>;

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { isDomainError, toAppError } from "@/lib/errors";
+import { onHandlerError, subscribe } from "@/lib/event-bus";
+import { MilestoneStateError } from "@/lib/milestones";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { createIssueSchema } from "@/schemas/issue";
+import {
+  closeMilestoneSchema,
+  createMilestoneSchema,
+  setIssueMilestoneSchema,
+  updateMilestoneSchema,
+} from "@/schemas/milestone";
+import { activityFilterSchema } from "@/schemas/activity";
+import { updateNotificationPreferenceSchema } from "@/schemas/notification";
+import * as activityRepo from "@/server/repositories/activity-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { registerActivityListeners } from "@/server/services/activity-service";
+import * as issueService from "@/server/services/issue-service";
+import * as milestones from "@/server/services/milestone-service";
+import { listNotifications, updatePreference } from "@/server/services/notification-service";
+import { NotFoundError } from "@/server/services/_support";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueId, MilestoneId } from "@/types/common";
+import type { IssueStatus } from "@/types/issue";
+import type { TaskflowEventMap, Unsubscribe } from "@/types/event";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+let detachAudit: Unsubscribe;
+let tenant: Tenant;
+let serial = 0;
+const detachers: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachAudit = registerActivityListeners();
+});
+beforeEach(async () => {
+  tenant = await createTenant(`milestones-${++serial}`);
+});
+afterEach(() => {
+  vi.useRealTimers();
+  while (detachers.length) detachers.pop()?.();
+});
+afterAll(() => {
+  detachAudit();
+  cleanup();
+});
+
+function create(name: string, targetDate: string | null = null, scope = tenant) {
+  return milestones.createMilestone(scope.actors.member, createMilestoneSchema.parse({
+    orgId: scope.org.id, projectId: scope.project.id, name, targetDate,
+  }));
+}
+function close(milestoneId: MilestoneId, moveOpenIssuesTo: MilestoneId | null = null) {
+  return milestones.closeMilestone(tenant.actors.member, {
+    orgId: tenant.org.id, milestoneId, moveOpenIssuesTo,
+  });
+}
+function read(milestoneId: MilestoneId) {
+  return milestones.getMilestone(tenant.actors.viewer, tenant.org.id, milestoneId);
+}
+function addIssue(milestoneId: MilestoneId | null, status: IssueStatus = "todo", assigneeId = tenant.userIds.admin) {
+  return issueService.createIssue(tenant.actors.member, createIssueSchema.parse({
+    ...issueInput(tenant.org.id, tenant.project.id), milestoneId, status, assigneeId,
+  }));
+}
+function set(issueId: IssueId, milestoneId: MilestoneId | null) {
+  return issueService.setIssueMilestone(tenant.actors.member, { orgId: tenant.org.id, issueId, milestoneId });
+}
+
+const missing = "01HZZZMMMMMMMMMMMMMMMMMMMM" as MilestoneId;
+
+describe("milestones", () => {
+  it("persists creation and edits, including a cleared target date and a closed milestone rename", async () => {
+    const first = await create("Launch", "2026-01-01T00:00:00.000Z");
+    expect(first).toMatchObject({ orgId: tenant.org.id, projectId: tenant.project.id, closedAt: null });
+    const changed = await milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: first.id, name: "Release", targetDate: null,
+    });
+    expect(changed.name).toBe("Release");
+    expect(changed.targetDate).toBeNull();
+    expect((await read(first.id)).milestone).toEqual(changed);
+    await close(first.id);
+    const renamed = await milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: first.id, name: "Shipped",
+    });
+    expect(renamed.closedAt).not.toBeNull();
+    expect(renamed.name).toBe("Shipped");
+  });
+
+  it("reserves names across open and closed milestones using case and whitespace normalization", async () => {
+    const first = await create(" Launch ");
+    const other = await create("Another");
+    await expect(create("LAUNCH")).rejects.toMatchObject({ reason: "name_taken" });
+    await close(first.id);
+    await expect(create(" launch ")).rejects.toMatchObject({ reason: "name_taken" });
+    await expect(milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: other.id, name: "LaUnCh",
+    })).rejects.toMatchObject({ reason: "name_taken" });
+    expect((await read(other.id)).milestone.name).toBe("Another");
+    await milestones.updateMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, milestoneId: first.id, name: "launch",
+    });
+    const anotherTenant = await createTenant(`same-name-${serial}`);
+    expect((await create("launch", null, anotherTenant)).name).toBe("launch");
+    const secondProject = await projectRepo.insertProject({
+      ...tenant.project, name: "Second", slug: "second", key: "SEC",
+    });
+    expect((await milestones.createMilestone(tenant.actors.member, {
+      orgId: tenant.org.id, projectId: secondProject.id, name: "launch", targetDate: null,
+    })).name).toBe("launch");
+  });
+
+  it("enforces the cap on creation and reopening, including simultaneous calls", async () => {
+    const results = await Promise.allSettled(Array.from({ length: MAX_OPEN_MILESTONES_PER_PROJECT + 1 }, (_, i) => create(`M${i}`)));
+    const created = results.flatMap((result) => result.status === "fulfilled" ? [result.value] : []);
+    expect(created).toHaveLength(MAX_OPEN_MILESTONES_PER_PROJECT);
+    expect(results.filter((result) => result.status === "rejected")).toEqual([
+      expect.objectContaining({ reason: expect.objectContaining({ reason: "too_many_open" }) }),
+    ]);
+    await close(created[0].id);
+    await create("Replacement");
+    await expect(milestones.reopenMilestone(tenant.actors.member, tenant.org.id, created[0].id)).rejects.toMatchObject({ reason: "too_many_open" });
+    await close(created[1].id);
+    const reopened = await milestones.reopenMilestone(tenant.actors.member, tenant.org.id, created[0].id);
+    expect(reopened.closedAt).toBeNull();
+    await expect(milestones.reopenMilestone(tenant.actors.member, tenant.org.id, reopened.id)).rejects.toMatchObject({ reason: "already_open" });
+  });
+
+  it("assigns at creation, changes and clears a milestone, preserving other issue fields and labels", async () => {
+    const a = await create("A");
+    const b = await create("B");
+    const issue = await addIssue(a.id);
+    expect(issue.milestoneId).toBe(a.id);
+    const moved = await set(issue.id, b.id);
+    expect(moved).toMatchObject({ id: issue.id, title: issue.title, status: issue.status, milestoneId: b.id, labelIds: issue.labelIds });
+    expect(await issueRepo.findIssueById(tenant.org.id, issue.id)).toEqual(moved);
+    expect((await set(issue.id, null)).milestoneId).toBeNull();
+  });
+
+  it("rejects absent, cross-project, cross-workspace and closed destinations without creating or moving an issue", async () => {
+    const source = await create("Source");
+    const closed = await create("Closed");
+    await close(closed.id);
+    const other = await createTenant(`foreign-${serial}`);
+    const foreign = await create("Foreign", null, other);
+    const project = await projectRepo.insertProject({ ...tenant.project, name: "Other", slug: "other", key: "OTH" });
+    const crossProject = await milestones.createMilestone(tenant.actors.member, { orgId: tenant.org.id, projectId: project.id, name: "Other", targetDate: null });
+    const issue = await addIssue(source.id);
+    const announcements: unknown[] = [];
+    detachers.push(subscribe("issue.created", (event) => { announcements.push(event); }));
+    const count = await issueRepo.countIssues(tenant.org.id, tenant.project.id);
+    for (const id of [missing, foreign.id, crossProject.id, closed.id]) {
+      const error = id === closed.id ? MilestoneStateError : NotFoundError;
+      await expect(addIssue(id)).rejects.toBeInstanceOf(error);
+      await expect(set(issue.id, id)).rejects.toBeInstanceOf(error);
+    }
+    expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(count);
+    expect(announcements).toEqual([]);
+    expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.milestoneId).toBe(source.id);
+  });
+
+  it("counts all live issues and moves only open live ones when closed", async () => {
+    const a = await create("A", "2020-01-01T00:00:00.000Z");
+    const b = await create("B");
+    const openIds: IssueId[] = [];
+    for (let i = 0; i < 105; i++) openIds.push((await addIssue(a.id)).id);
+    const done = await addIssue(a.id, "done");
+    const canceled = await addIssue(a.id, "canceled");
+    const archived = await addIssue(a.id);
+    await issueService.archiveIssue(tenant.actors.member, tenant.org.id, archived.id);
+    expect(await read(a.id)).toMatchObject({ progress: { total: 107, open: 105, closed: 2 }, overdue: true });
+    const result = await close(a.id, b.id);
+    expect(new Set(result.movedIssueIds)).toEqual(new Set(openIds));
+    expect(result.milestone.closedAt).not.toBeNull();
+    for (const id of [done.id, canceled.id, archived.id]) {
+      expect((await issueRepo.findIssueById(tenant.org.id, id))?.milestoneId).toBe(a.id);
+    }
+    expect(await read(a.id)).toMatchObject({ progress: { total: 2, open: 0, closed: 2 }, overdue: false });
+    expect((await read(b.id)).progress).toEqual({ total: 105, open: 105, closed: 0 });
+    await close(b.id);
+    for (const id of openIds) expect((await issueRepo.findIssueById(tenant.org.id, id))?.milestoneId).toBeNull();
+  });
+
+  it("leaves everything unchanged and emits nothing for an invalid close", async () => {
+    const a = await create("A");
+    const b = await create("B");
+    await close(b.id);
+    const issue = await addIssue(a.id);
+    const other = await createTenant(`bad-close-${serial}`);
+    const foreign = await create("Foreign", null, other);
+    const project = await projectRepo.insertProject({ ...tenant.project, name: "Other", slug: "other", key: "OTH" });
+    const crossProject = await milestones.createMilestone(tenant.actors.member, { orgId: tenant.org.id, projectId: project.id, name: "Other", targetDate: null });
+    const events: unknown[] = [];
+    detachers.push(subscribe("milestone.closed", (event) => { events.push(event); }));
+    for (const target of [a.id, b.id, missing, foreign.id, crossProject.id]) {
+      await expect(close(a.id, target)).rejects.toBeInstanceOf(target === b.id ? MilestoneStateError : NotFoundError);
+      expect((await read(a.id)).milestone).toEqual(a);
+      expect(await issueRepo.findIssueById(tenant.org.id, issue.id)).toEqual(issue);
+    }
+    expect(events).toEqual([]);
+    await close(a.id);
+    await expect(close(a.id)).rejects.toMatchObject({ reason: "closed" });
+    await expect(set(issue.id, a.id)).rejects.toMatchObject({ reason: "closed" });
+  });
+
+  it("checks overdue against the moment of the call, strictly, with open issues required", async () => {
+    vi.useFakeTimers();
+    const now = "2026-06-01T00:00:00.000Z";
+    vi.setSystemTime(new Date(now));

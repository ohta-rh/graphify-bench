@@ -0,0 +1,103 @@
+import { and, count, eq, isNull, notInArray } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, issues, milestones } from "@/server/db";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { brandId, toMilestone } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import type { CreateMilestoneInput, UpdateMilestoneInput } from "@/schemas/milestone";
+import type { IsoTimestamp, IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Milestone, MilestoneProgress } from "@/types/milestone";
+
+/** All work in the callback is synchronous, including the guard reads. */
+export function transaction<T>(work: () => T): T {
+  return getDb().transaction(work);
+}
+
+export function findMilestoneById(orgId: OrgId, milestoneId: MilestoneId): Milestone | null {
+  const row = getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.id, milestoneId),
+  )).get();
+  return row ? toMilestone(row) : null;
+}
+
+export function listMilestones(orgId: OrgId, projectId: ProjectId): readonly Milestone[] {
+  return getDb().select().from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.projectId, projectId),
+  )).all().map(toMilestone).sort((a, b) =>
+    Number(a.closedAt !== null) - Number(b.closedAt !== null) ||
+    (a.targetDate === null ? Infinity : Date.parse(a.targetDate)) -
+      (b.targetDate === null ? Infinity : Date.parse(b.targetDate)) ||
+    Date.parse(a.createdAt) - Date.parse(b.createdAt),
+  );
+}
+
+export function countOpenMilestones(orgId: OrgId, projectId: ProjectId): number {
+  return getDb().select({ value: count() }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.projectId, projectId),
+    isNull(milestones.closedAt),
+  )).get()?.value ?? 0;
+}
+
+export function isNameTaken(
+  orgId: OrgId, projectId: ProjectId, name: string, exceptId?: MilestoneId,
+): boolean {
+  const row = getDb().select({ id: milestones.id }).from(milestones).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.projectId, projectId),
+    eq(milestones.normalizedName, name.trim().toLowerCase()),
+  )).get();
+  return row !== undefined && row.id !== exceptId;
+}
+
+export function insertMilestone(input: CreateMilestoneInput, now: IsoTimestamp): Milestone {
+  return toMilestone(getDb().insert(milestones).values({
+    id: newId(), orgId: input.orgId, projectId: input.projectId,
+    name: input.name, normalizedName: input.name.trim().toLowerCase(),
+    targetDate: input.targetDate, closedAt: null, createdAt: now, updatedAt: now,
+  }).returning().get());
+}
+
+export function updateMilestone(input: UpdateMilestoneInput, now: IsoTimestamp): Milestone {
+  return toMilestone(getDb().update(milestones).set({
+    ...(input.name === undefined ? {} : {
+      name: input.name, normalizedName: input.name.trim().toLowerCase(),
+    }),
+    ...(input.targetDate === undefined ? {} : { targetDate: input.targetDate }),
+    updatedAt: now,
+  }).where(and(
+    orgPredicate(milestones.orgId, input.orgId), eq(milestones.id, input.milestoneId),
+  )).returning().get());
+}
+
+export function setClosedAt(
+  orgId: OrgId, milestoneId: MilestoneId, closedAt: IsoTimestamp | null, now: IsoTimestamp,
+): Milestone {
+  return toMilestone(getDb().update(milestones).set({ closedAt, updatedAt: now }).where(and(
+    orgPredicate(milestones.orgId, orgId), eq(milestones.id, milestoneId),
+  )).returning().get());
+}
+
+/** Bulk update has no pagination limit and leaves closed/archived issues attached. */
+export function moveOpenIssues(
+  orgId: OrgId, projectId: ProjectId, milestoneId: MilestoneId,
+  target: MilestoneId | null, now: IsoTimestamp,
+): readonly IssueId[] {
+  return getDb().update(issues).set({ milestoneId: target, updatedAt: now }).where(and(
+    orgPredicate(issues.orgId, orgId), eq(issues.projectId, projectId),
+    eq(issues.milestoneId, milestoneId), livePredicate(issues.archivedAt, {}),
+    notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+  )).returning({ id: issues.id }).all().map((row) => brandId<IssueId>(row.id));
+}
+
+export function getProgress(milestone: Milestone): MilestoneProgress {
+  const counts = getDb().select({ status: issues.status, value: count() }).from(issues).where(and(
+    orgPredicate(issues.orgId, milestone.orgId), eq(issues.projectId, milestone.projectId),
+    eq(issues.milestoneId, milestone.id), livePredicate(issues.archivedAt, {}),
+  )).groupBy(issues.status).all();
+  let open = 0;
+  let closed = 0;
+  for (const row of counts) {
+    if (CLOSED_ISSUE_STATUSES.includes(row.status)) closed += row.value;
+    else open += row.value;
+  }
+  return { total: open + closed, open, closed };
+}

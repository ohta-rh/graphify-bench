@@ -0,0 +1,22 @@
+import { assertOrgScope } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as referenceRepo from "@/server/repositories/reference-repository";
+import { NotFoundError } from "./_support";
+import type { LabelId, OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+
+export async function requireReferenceScope(actor: Actor, kind: "issue" | "comment" | "label" | "project", id: string): Promise<void> {
+  const orgId = await referenceRepo.findReferenceOrg(kind, id);
+  if (orgId === null) throw new NotFoundError(kind, id);
+  assertOrgScope(actor, orgId);
+}
+
+export async function requireMember(orgId: OrgId, userId: UserId | null | undefined): Promise<void> {
+  if (userId == null) return;
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", userId);
+}
+
+export async function requireLabels(actor: Actor, labelIds: readonly LabelId[]): Promise<void> {
+  for (const id of new Set(labelIds)) await requireReferenceScope(actor, "label", id);
+}

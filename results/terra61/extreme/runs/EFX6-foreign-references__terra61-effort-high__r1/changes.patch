+/** Resolve only the owning workspace for references whose id was not scoped. */
+import { eq } from "drizzle-orm";
+import { comments, getDb, issues, labels, projects } from "@/server/db";
+import type { OrgId } from "@/types/common";
+
+export async function findReferenceOrg(
+  kind: "issue" | "comment" | "label" | "project",
+  id: string,
+): Promise<OrgId | null> {
+  const table = kind === "issue" ? issues : kind === "comment" ? comments : kind === "label" ? labels : projects;
+  const row = getDb().select({ orgId: table.orgId }).from(table).where(eq(table.id, id)).get();
+  return (row?.orgId as OrgId | undefined) ?? null;
+}

+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { eq } from "drizzle-orm";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { lockReasonFor, WorkspaceLockedError } from "@/lib/billing-lock";
+import { toAppError } from "@/lib/errors";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { getDb, subscriptions } from "@/server/db";
+import * as subscriptionRepo from "@/server/repositories/subscription-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as billingService from "@/server/services/billing-service";
+import * as issueService from "@/server/services/issue-service";
+import { getOrganizationSummary } from "@/server/services/organization-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+describe("workspace billing lock", () => {
+  it("uses the subscription status and exact expiration boundaries", async () => {
+    const tenant = await createTenant("lock-boundaries");
+    const subscription = (await subscriptionRepo.findSubscription(tenant.org.id))!;
+    const end = new Date(subscription.currentPeriodEnd);
+    const before = new Date(end.getTime() - 1);
+    expect(lockReasonFor(null, end)).toBeNull();

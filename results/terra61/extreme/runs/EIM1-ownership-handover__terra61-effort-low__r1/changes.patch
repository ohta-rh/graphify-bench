+  if (changes.to.role !== "owner") await emit("member.role_changed", { ...actorEnvelope(actor), memberId: changes.to.id as MemberId, from: changes.to.role, to: "owner" });
+  if (changes.from.role === "owner") await emit("member.role_changed", { ...actorEnvelope(actor), memberId: changes.from.id as MemberId, from: "owner", to: "admin" });
+  await emit("organization.ownership_transferred", { ...actorEnvelope(actor), fromUserId: offer.fromUserId as UserId, toUserId: offer.toUserId as UserId });
+  return requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
 }

+/** Validate references before any mutation or event is produced. */
+export async function requireActiveMember(orgId: OrgId, userId: UserId | null | undefined): Promise<void> {
+  if (userId == null) return;
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", userId);
+}
+
+export async function requireLabels(orgId: OrgId, ids: readonly LabelId[] | undefined): Promise<void> {
+  if (!ids || ids.length === 0) return;
+  const labels = await labelRepo.listLabels(orgId);
+  const available = new Set(labels.map((label) => label.id));
+  for (const id of ids) if (!available.has(id)) throw new NotFoundError("Label", id);
 }

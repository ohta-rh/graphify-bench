+      .set({ usedAt: stamp, updatedAt: stamp })
+      .where(and(eq(passwordResetTokens.id, id), eq(passwordResetTokens.userId, userId), isNull(passwordResetTokens.usedAt), gt(passwordResetTokens.expiresAt, stamp)))

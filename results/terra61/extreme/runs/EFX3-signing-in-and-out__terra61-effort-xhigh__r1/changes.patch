+/** Atomically consume a live token, change its owner's password and revoke sessions. */
+export async function completeReset(tokenHash: string, passwordHash: string): Promise<UserId | null> {
+  const stamp = toIsoTimestamp(new Date());
+  return getDb().transaction((tx) => {
+    const row = tx.update(passwordResetTokens)
+      .set({ usedAt: stamp, updatedAt: stamp })
+      .where(and(
+        eq(passwordResetTokens.tokenHash, tokenHash),
+        isNull(passwordResetTokens.usedAt),
+        gt(passwordResetTokens.expiresAt, stamp),
+      ))
+      .returning({ userId: passwordResetTokens.userId })
+      .get();
+    if (!row) return null;
+    tx.update(users).set({ passwordHash, updatedAt: stamp })
+      .where(eq(users.id, row.userId)).run();
+    tx.delete(sessions).where(eq(sessions.userId, row.userId)).run();
+    return brandId<UserId>(row.userId);
+  });
 }
 
 /** Single use: consuming a token is what stops a reset link being replayed. */

+async function changeSuspension(
+  actor: Actor,
+  input: { orgId: OrgId; memberId: MemberId },
+  status: "active" | "suspended",
+): Promise<Member> {
+  assertOrgScope(actor, input.orgId);
+  const found = await memberRepo.findMemberById(input.orgId, input.memberId);
+  const member = requireFound(found && found.archivedAt === null ? found : null, "Member", input.memberId);
+  assertCan(actor, "member:remove", memberResource(member));
+  if (member.userId === actor.userId) throw new Error("Cannot change your own suspension");
+  if (!hasRoleAtLeast(actor.role, member.role)) throw new Error("Cannot change the suspension of a member with a higher role");
+  if (member.status === status) return member;
+  if (status === "suspended") await assertLastOwnerRetained(input.orgId, input.memberId, "member");
+
+  const updated = await memberRepo.updateMemberStatus(input.orgId, input.memberId, status);
+  await emit(status === "suspended" ? "member.suspended" : "member.reinstated", {
+    ...actorEnvelope(actor), memberId: updated.id, userId: updated.userId,
+  });
+  return updated;
+}
+

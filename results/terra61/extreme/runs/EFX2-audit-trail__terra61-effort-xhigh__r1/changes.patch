+/** Walk every page using the repository's stable timestamp and id cursor. */
+export async function listAllActivity(
+  orgId: OrgId,
+  since: IsoTimestamp,
+  until: IsoTimestamp,
+): Promise<ActivityEvent[]> {
+  if (Date.parse(since) > Date.parse(until)) throw new Error("Activity range ends before it starts");
+  const items: ActivityEvent[] = [];
+  let cursor: string | null = null;
+  do {
+    const page: Page<ActivityEvent> = await activityRepo.listActivity({ orgId, since, until, limit: 100, cursor });
+    items.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+  return items;
+}

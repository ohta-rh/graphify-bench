+/** Resolve a missing scoped reference without treating a foreign row as local. */
+export function missingReference(
+  actor: Actor,
+  kind: "issue" | "comment" | "label" | "project",
+  id: string,
+): never {
+  const owner = findReferenceOrg(kind, id);
+  if (owner !== null) assertOrgScope(actor, owner);
+  throw new NotFoundError(kind[0]!.toUpperCase() + kind.slice(1), id);
+}
+
+export async function requireActiveMember(orgId: OrgId, userId: UserId | null | undefined): Promise<void> {
+  if (userId == null) return;
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", userId);
 }
 

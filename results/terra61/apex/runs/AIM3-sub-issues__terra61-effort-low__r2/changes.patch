+
+/** All project issues, including archived nodes, for hierarchy traversal. */
+export async function listProjectHierarchy(orgId: OrgId, projectId: ProjectId): Promise<readonly Issue[]> {
+  const rows = getDb().select().from(issues).where(and(
+    orgPredicate(issues.orgId, orgId), eq(issues.projectId, projectId),
+  )).orderBy(issues.createdAt, issues.number).all();
+  const labels = await listLabelsForIssues(orgId, rows.map(row => row.id as IssueId));
+  return rows.map(row => toIssue(row, (labels[row.id] ?? []).map(label => label.id)));
+}
+
+export async function setParent(orgId: OrgId, issueId: IssueId, parentId: IssueId | null): Promise<Issue> {
+  getDb().update(issues).set({ parentId, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId))).run();
+  const issue = await findIssueById(orgId, issueId);
+  if (!issue) throw new Error(`Issue ${issueId} not found`);
+  return issue;
+}

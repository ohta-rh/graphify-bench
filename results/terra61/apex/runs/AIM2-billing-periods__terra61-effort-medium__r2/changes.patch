@@ -0,0 +1,37 @@
+import { getPlanLimits } from "@/config/plan-limits";
+import { emit } from "@/lib/event-bus";
+import { newId } from "@/lib/id";
+import * as invoiceRepo from "@/server/repositories/invoice-repository";
+import { toIsoTimestamp } from "@/types/common";
+import type { BillingInterval, PlanId, Subscription } from "@/types/billing";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+export function periodEnd(start: Date, interval: BillingInterval): Date {
+  const end = new Date(start);
+  const day = end.getUTCDate();
+  end.setUTCDate(1);
+  end.setUTCMonth(end.getUTCMonth() + (interval === "annual" ? 12 : 1));
+  const lastDay = new Date(Date.UTC(end.getUTCFullYear(), end.getUTCMonth() + 1, 0)).getUTCDate();
+  end.setUTCDate(Math.min(day, lastDay));
+  return end;
+}
+
+export function fullCharge(plan: PlanId, seats: number, interval: BillingInterval): number {
+  return getPlanLimits(plan).priceCentsPerSeatMonthly * seats * (interval === "annual" ? 12 : 1);
+}
+
+export function prorate(amount: number, subscription: Subscription, now: Date): number {
+  const day = 86_400_000;
+  const end = new Date(subscription.currentPeriodEnd).getTime();
+  const days = Math.max(1, Math.round((end - new Date(subscription.currentPeriodStart).getTime()) / day));
+  const remaining = Math.max(0, Math.ceil((end - now.getTime()) / day));
+  return Math.floor(amount * remaining / days);
+}
+
+export async function issueInvoice(orgId: OrgId, amountCents: number, start: IsoTimestamp, end: IsoTimestamp, now: Date, actorId: UserId | null): Promise<void> {
+  if (amountCents <= 0) return;
+  const invoice = await invoiceRepo.insertInvoice(orgId, {
+    orgId, number: newId(), amountCents, currency: "usd", periodStart: start, periodEnd: end, paidAt: null,
+  });
+  await emit("billing.invoice_issued", { orgId, actorId, occurredAt: toIsoTimestamp(now), invoiceId: invoice.id, invoiceNumber: invoice.number, amountCents, periodStart: start, periodEnd: end });
+}

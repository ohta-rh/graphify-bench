+++ /private/tmp/bench-scratch/ceb943de-88e9-4325-a8a8-0adcbaa5c059/src/server/jobs/billing-renewal-job.ts	2026-10-29 08:52:11
@@ -0,0 +1,39 @@
+import { emit } from "@/lib/event-bus";
+import * as subscriptions from "@/server/repositories/subscription-repository";
+import { fullCharge, issueInvoice, periodEnd } from "@/server/services/billing-invoices";
+import { toIsoTimestamp } from "@/types/common";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+export async function runBillingRenewalJob(now: Date): Promise<JobResult> {
+  return runJob("billing-renewal", async (result) => {
+    for (const subscription of await subscriptions.listBillingSubscriptions()) {
+      if (subscription.status === "canceled") {
+        if (!subscription.cancelAt || new Date(subscription.cancelAt).getTime() > now.getTime()) continue;
+        let start = subscription.cancelAt;
+        let end = toIsoTimestamp(periodEnd(new Date(start), "monthly"));
+        while (new Date(end).getTime() <= now.getTime()) {
+          start = end;
+          end = toIsoTimestamp(periodEnd(new Date(start), "monthly"));
+        }
+        await subscriptions.setBillingSubscription(subscription.orgId, {
+          plan: "free", interval: "monthly", status: "active", cancelAt: null,
+          currentPeriodStart: start, currentPeriodEnd: end,
+        });
+        await emit("billing.plan_changed", { orgId: subscription.orgId, actorId: null, occurredAt: toIsoTimestamp(now), from: subscription.plan, to: "free" });
+        result.processed++;
+      } else if (subscription.status === "active") {
+        let end = subscription.currentPeriodEnd;
+        while (new Date(end).getTime() <= now.getTime()) {
+          const start = end;
+          end = toIsoTimestamp(periodEnd(new Date(start), subscription.interval));
+          await subscriptions.setBillingSubscription(subscription.orgId, { currentPeriodStart: start, currentPeriodEnd: end });
+          if (subscription.plan !== "free") {
+            await issueInvoice(subscription.orgId, fullCharge(subscription.plan, subscription.seats, subscription.interval), start, end, now, null);
+          }
+          result.processed++;
+        }
+      }
+    }
+  });
+}

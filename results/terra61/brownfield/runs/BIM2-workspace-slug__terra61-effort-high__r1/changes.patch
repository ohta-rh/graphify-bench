+
+/** Atomically check availability, retire the old URL and change the current URL. */
+export async function renameOrgSlug(orgId: OrgId, slug: string): Promise<{ organization: Organization; from: string } | null> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const current = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+    if (!current) throw new Error(`Organization ${orgId} not found`);
+    if (current.slug === slug) return null;
+    const occupied = tx.select().from(organizations).where(eq(organizations.slug, slug)).get();
+    const held = tx.select().from(retiredOrganizationSlugs).where(and(
+      eq(retiredOrganizationSlugs.slug, slug),
+      ne(retiredOrganizationSlugs.orgId, orgId),
+      gt(retiredOrganizationSlugs.retiredAt, holdCutoff()),
+    )).get();
+    if (occupied || held) throw new InvalidSlugError(slug, "is already taken");
+    const stamp = toIsoTimestamp(new Date());
+    tx.delete(retiredOrganizationSlugs).where(eq(retiredOrganizationSlugs.slug, slug)).run();
+    tx.insert(retiredOrganizationSlugs).values({ slug: current.slug, orgId, retiredAt: stamp })
+      .onConflictDoUpdate({ target: retiredOrganizationSlugs.slug, set: { orgId, retiredAt: stamp } }).run();
+    const updated = tx.update(organizations).set({ slug, updatedAt: stamp })
+      .where(eq(organizations.id, orgId)).returning().get();
+    return { organization: toOrganization(updated), from: current.slug };
+  });
 }

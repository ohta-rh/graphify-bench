+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import { subscribe } from "@/lib/event-bus";
+import { getDb, organizations } from "@/server/db";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import { registerActivityListeners, listActivity } from "@/server/services/activity-service";
+import { cloneProject } from "@/server/services/project-service";
+import { registerSearchListeners } from "@/server/services/search-service";
+import { registerUsageListeners } from "@/server/services/usage-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+describe("project cloning", () => {
+  it("copies all live issues in number order, resets progress and updates listeners", async () => {
+    const tenant = await createTenant("clone-many", "growth");
+    getDb().update(organizations).set({ defaultIssueStatus: "todo" }).where(eq(organizations.id, tenant.org.id)).run();
+    for (let n = 1; n <= 102; n++) {
+      const issue = await issueRepo.insertIssue({
+        ...issueInput(tenant.org.id, tenant.project.id, { title: `Clone subject ${n}`, assigneeId: tenant.userIds.admin }),
+        status: "done", priority: "high", estimate: 3,
+      }, tenant.userIds.owner, n);
+      if (n === 2) await issueRepo.archiveIssue(tenant.org.id, issue.id);
+    }
+    await usageRepo.recomputeUsage(tenant.org.id);
+    const events: string[] = [];
+    const offs = [
+      registerActivityListeners(), registerSearchListeners(), registerUsageListeners(),
+      subscribe("project.cloned", () => { events.push("clone"); }),
+      subscribe("project.created", () => { events.push("project"); }),
+      subscribe("issue.created", () => { events.push("issue"); }),
+    ];
+    try {
+      const project = await cloneProject(tenant.actors.member, {
+        orgId: tenant.org.id, projectId: tenant.project.id, name: "Copy", slug: "platform", key: "COPY", includeIssues: true,
+      });
+      expect(project.slug).toBe("platform-2");
+      expect(events).toEqual(["clone"]);
+      expect(await issueRepo.countIssues(tenant.org.id, project.id)).toBe(101);
+      const first = await issueRepo.findIssueByNumber(tenant.org.id, project.id, 1);
+      const second = await issueRepo.findIssueByNumber(tenant.org.id, project.id, 2);
+      const last = await issueRepo.findIssueByNumber(tenant.org.id, project.id, 101);
+      expect(first).toMatchObject({ title: "Clone subject 1", status: "todo", priority: "high", estimate: 3, assigneeId: null, authorId: tenant.userIds.member, startedAt: null, completedAt: null, parentId: null });
+      expect(second?.title).toBe("Clone subject 3");
+      expect(last?.title).toBe("Clone subject 102");
+      expect(await issueRepo.nextIssueNumber(tenant.org.id, project.id)).toBe(102);
+      const indexed = await searchRepo.searchDocuments({ orgId: tenant.org.id, q: "Clone subject", projectId: project.id, kinds: [], limit: 100, cursor: null });
+      expect(indexed.total).toBe(101);
+      expect(await usageRepo.getUsage(tenant.org.id)).toMatchObject({ projectsUsed: 2, issuesUsed: 202 });
+      const audit = await listActivity(tenant.actors.admin, { orgId: tenant.org.id, action: ["project.cloned"], limit: 100, cursor: null });
+      expect(audit.items).toHaveLength(1);
+      expect(audit.items[0]).toMatchObject({ actorId: tenant.userIds.member, subjectKind: "project", subjectId: project.id, projectId: project.id, metadata: { sourceProjectId: tenant.project.id, issuesCopied: 101 } });
+    } finally { offs.forEach((off) => off()); }
+  });
+
+  it("rejects an oversized batch without writing a project or issues", async () => {
+    const tenant = await createTenant("clone-quota", "free");
+    for (let n = 1; n <= 101; n++) {
+      await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, n);
+    }
+    await expect(cloneProject(tenant.actors.member, {
+      orgId: tenant.org.id, projectId: tenant.project.id, name: "Copy", slug: "copy", key: "COPY", includeIssues: true,
+    })).rejects.toThrow(/no more issues/);
+    expect(await projectRepo.countProjects(tenant.org.id)).toBe(1);
+    expect(await projectRepo.findProjectBySlug(tenant.org.id, "copy")).toBeNull();
+  });
+});

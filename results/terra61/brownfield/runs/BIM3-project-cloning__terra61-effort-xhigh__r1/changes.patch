+
+/** Creates the project and its fresh issue copies as one atomic batch. */
+export async function cloneProjectBatch(
+  input: CloneProjectInput,
+  source: Project,
+  authorId: UserId,
+  plan: PlanId,
+  defaultStatus: IssueStatus,
+): Promise<{ project: Project; issuesCopied: number }> {
+  return getDb().transaction((tx) => {
+    const used = tx.select({ value: count() }).from(projects).where(and(
+      orgPredicate(projects.orgId, input.orgId), isNull(projects.archivedAt),
+    )).get()?.value ?? 0;
+    if (wouldExceedLimit(plan, "projects", used)) {
+      throw new Error(`Plan ${plan} allows ${used} projects; upgrade to add another`);
+    }
+
+    const sourceIssues = input.includeIssues
+      ? tx.select().from(issues).where(and(
+          orgPredicate(issues.orgId, input.orgId),
+          eq(issues.projectId, source.id),
+          isNull(issues.archivedAt),
+        )).orderBy(asc(issues.number)).all()
+      : [];
+    if (wouldExceedLimit(plan, "issuesPerProject", 0, sourceIssues.length)) {
+      throw new Error(`Plan ${plan} allows no more issues in project ${input.key}`);
+    }
+
+    const taken = tx.select({ slug: projects.slug }).from(projects)
+      .where(orgPredicate(projects.orgId, input.orgId)).all();
+    const stamp = toIsoTimestamp(new Date());
+    const row = tx.insert(projects).values({
+      id: newId(), orgId: input.orgId, name: input.name,
+      slug: uniqueSlug(input.slug, taken.map((item) => item.slug)), key: input.key,
+      description: source.description, visibility: source.visibility,
+      status: "active", leadId: source.leadId, color: source.color,
+      startsAt: null, targetDate: null, createdAt: stamp, updatedAt: stamp,
+    }).returning().get();
+
+    for (const [index, issue] of sourceIssues.entries()) {
+      const id = newId();
+      tx.insert(issues).values({
+        id, orgId: input.orgId, projectId: row.id, number: index + 1,
+        title: issue.title, description: issue.description, status: defaultStatus,
+        priority: issue.priority, authorId, assigneeId: null, parentId: null,
+        estimate: issue.estimate, dueAt: issue.dueAt, startedAt: null,
+        completedAt: null, createdAt: stamp, updatedAt: stamp,
+      }).run();
+      const labels = tx.select({ labelId: issueLabels.labelId }).from(issueLabels)
+        .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.issueId, issue.id))).all();
+      if (labels.length) {
+        tx.insert(issueLabels).values(labels.map(({ labelId }) => ({
+          orgId: input.orgId, issueId: id, labelId,
+        }))).run();
+      }
+    }
+    return { project: toProject(row), issuesCopied: sourceIssues.length };
+  });
 }
 

+
+/** Expire only a trial that is still eligible when the update is made. */
+export async function expireTrial(
+  subscription: Subscription,
+  before: IsoTimestamp,
+): Promise<Subscription | null> {
+  const row = getDb()
+    .update(subscriptions)
+    .set({ plan: "free", status: "active", updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(
+      eq(subscriptions.id, subscription.id),
+      eq(subscriptions.orgId, subscription.orgId),
+      eq(subscriptions.status, "trialing"),
+      eq(subscriptions.plan, subscription.plan),
+      lte(subscriptions.currentPeriodEnd, before),
+    ))
+    .returning()
+    .get();
+  return row ? toSubscription(row) : null;
 }

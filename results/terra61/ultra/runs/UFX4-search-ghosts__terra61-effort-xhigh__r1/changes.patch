+/** Paginate live comments without requiring their author row for indexing. */
+export async function listCommentsForSearch(
+  orgId: OrgId,
+  issueId: IssueId,
+  cursor: string | null,
+  limit: number,
+): Promise<Page<Comment>> {
+  const sort = { sortColumn: comments.createdAt, idColumn: comments.id };
+  const filters = compact(
+    orgPredicate(comments.orgId, orgId),
+    eq(comments.issueId, issueId),
+    isNull(comments.archivedAt),
+  );
+  const rows = getDb().select().from(comments)
+    .where(and(...filters, ...compact(keysetPredicate(sort, cursor))))
+    .orderBy(desc(comments.createdAt), desc(comments.id))
+    .limit(probeLimit(limit)).all();
+  return toPage(rows, limit, 0, toComment, (row) => ({ id: row.id, sortValue: row.createdAt }));
+}
+

+/** Remove all documents for a tenant before rebuilding its index. */
+export async function clearSearchDocuments(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();
+}
+
+/** Remove an issue and all of its comments, including older index rows. */
+export async function deleteIssueDocuments(orgId: OrgId, issueId: string): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    sql`((${searchIndex.subjectKind} = 'issue' AND ${searchIndex.subjectId} = ${issueId}) OR
+      (${searchIndex.subjectKind} = 'comment' AND ${searchIndex.subjectId} IN
+        (SELECT ${comments.id} FROM ${comments} WHERE ${comments.orgId} = ${orgId} AND ${comments.issueId} = ${issueId})))`,
+  )).run();
+}
+
+/** Remove a project and its descendants, regardless of their indexed project ID. */
+export async function deleteProjectDocuments(orgId: OrgId, projectId: string): Promise<void> {
+  getDb().delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    sql`((${searchIndex.subjectKind} = 'project' AND ${searchIndex.subjectId} = ${projectId}) OR
+      (${searchIndex.subjectKind} = 'issue' AND ${searchIndex.subjectId} IN
+        (SELECT ${issues.id} FROM ${issues} WHERE ${issues.orgId} = ${orgId} AND ${issues.projectId} = ${projectId})) OR
+      (${searchIndex.subjectKind} = 'comment' AND ${searchIndex.subjectId} IN
+        (SELECT ${comments.id} FROM ${comments} INNER JOIN ${issues}
+          ON ${comments.issueId} = ${issues.id} AND ${comments.orgId} = ${issues.orgId}
+          WHERE ${comments.orgId} = ${orgId} AND ${issues.projectId} = ${projectId})))`,
+  )).run();
+}

+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import type { Issue } from "@/types/issue";
+import type { IssueId, OrgId } from "@/types/common";
+
+export async function getBlockers(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const ids = dependencyRepo.listDependencies(orgId).filter((link) => link.issueId === issueId).map((link) => link.blockerId);
+  const issues = await Promise.all(ids.map((id) => issueRepo.findIssueById(orgId, id)));
+  return issues.filter((issue): issue is Issue => issue !== null && issue.archivedAt === null).sort((a, b) => a.number - b.number);
+}
+
+export function isOpen(issue: Issue): boolean {
+  return issue.archivedAt === null && !CLOSED_ISSUE_STATUSES.includes(issue.status);
+}

+import { and, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { IssueDependency } from "@/types/issue";
+
+function mapRow(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IssueDependency["createdAt"],
+  };
+}
+
+export function listDependencies(orgId: OrgId): readonly IssueDependency[] {
+  return getDb().select().from(issueDependencies)
+    .where(eq(issueDependencies.orgId, orgId)).all().map(mapRow);
+}
+
+export function insertDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId, createdBy: UserId): IssueDependency {
+  const db = getDb();
+  db.insert(issueDependencies).values({ orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()) })
+    .onConflictDoNothing().run();
+  const row = db.select().from(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), eq(issueDependencies.blockerId, blockerId),
+  )).get();
+  if (!row) throw new Error("Could not create issue dependency");
+  return mapRow(row);
+}
+
+export function deleteDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId): boolean {
+  return getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), eq(issueDependencies.blockerId, blockerId),
+  )).run().changes > 0;
+}

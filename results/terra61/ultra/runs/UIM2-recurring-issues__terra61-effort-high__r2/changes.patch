+import { and, count, eq, sql } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import type { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import type { z } from "zod";
+
+type Row = typeof recurringIssues.$inferSelect;
+function toRule(row: Row): RecurringIssue {
+  return { ...row, orgId: row.orgId as OrgId, projectId: row.projectId as ProjectId,
+    assigneeId: row.assigneeId as UserId | null, createdBy: row.createdBy as UserId,
+    createdAt: toIsoTimestamp(row.createdAt), updatedAt: toIsoTimestamp(row.updatedAt) };
+}
+export async function insertRecurringIssue(input: z.output<typeof createRecurringIssueSchema>, createdBy: UserId): Promise<RecurringIssue> {
+  const stamp = toIsoTimestamp(new Date());
+  return toRule(getDb().insert(recurringIssues).values({ ...input, id: newId(), createdBy,
+    lastOccurrenceOn: null, paused: false, createdAt: stamp, updatedAt: stamp }).returning().get());
+}
+export async function findRecurringIssue(orgId: OrgId, id: string): Promise<RecurringIssue | null> {
+  const row = getDb().select().from(recurringIssues).where(and(eq(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).get();
+  return row ? toRule(row) : null;
+}
+export async function listRecurringIssues(orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(eq(recurringIssues.orgId, orgId)).orderBy(sql`rowid`).all().map(toRule);
+}
+export async function listActiveRecurringIssues(): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(eq(recurringIssues.paused, false)).orderBy(sql`rowid`).all().map(toRule);
+}
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  return getDb().select({ value: count() }).from(recurringIssues).where(eq(recurringIssues.orgId, orgId)).get()?.value ?? 0;
+}
+export async function updateRecurringIssue(orgId: OrgId, id: string, patch: { paused?: boolean; lastOccurrenceOn?: string }): Promise<RecurringIssue> {
+  const row = getDb().update(recurringIssues).set({ ...patch, updatedAt: toIsoTimestamp(new Date()) }).where(and(eq(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).returning().get();
+  if (!row) throw new Error(`Recurring issue ${id} not found`);
+  return toRule(row);
+}

+import { z } from "zod";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+import { issuePrioritySchema } from "./issue";
+
+function isCalendarDate(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+function isTimeZone(value: string): boolean {
+  if (/^[+-]/.test(value)) return false;
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: value });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export const createRecurringIssueSchema = z.object({
+  orgId: orgIdSchema,
+  projectId: projectIdSchema,
+  title: z.string().min(3).max(180),
+  priority: issuePrioritySchema.default("none"),
+  assigneeId: userIdSchema.nullable().default(null),
+  cadence: z.enum(["daily", "weekly"]),
+  weekday: z.number().int().min(1).max(7).nullable().default(null),
+  timezone: z.string().refine(isTimeZone, "Invalid time zone"),
+  startsOn: z.string().refine(isCalendarDate, "Invalid calendar date"),
+}).superRefine((value, ctx) => {
+  if ((value.cadence === "weekly") !== (value.weekday !== null)) {
+    ctx.addIssue({ code: "custom", path: ["weekday"], message: "Weekday must be set for weekly rules only" });
+  }
+});
+
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;

@@ -0,0 +1,50 @@
+import { can } from "@/lib/permissions";
+import { createIssueSchema } from "@/schemas/issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource } from "@/server/services/_support";
+import { createIssue } from "@/server/services/issue-service";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+function latestOccurrence(rule: RecurringIssue, now: Date): string | null {
+  const parts = new Intl.DateTimeFormat("en-US", { timeZone: rule.timezone, year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(now);
+  const part = (type: string) => parts.find((p) => p.type === type)!.value;
+  const day = `${part("year").padStart(4, "0")}-${part("month")}-${part("day")}`;
+  if (day < rule.startsOn) return null;
+  if (rule.cadence === "daily") return day;
+  const date = new Date(`${day}T00:00:00.000Z`);
+  const weekday = date.getUTCDay() || 7;
+  date.setUTCDate(date.getUTCDate() - ((weekday - rule.weekday! + 7) % 7));
+  const occurrence = date.toISOString().slice(0, 10);
+  return occurrence >= rule.startsOn ? occurrence : null;
+}
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    const rules = await recurringRepo.listActiveRecurringIssues();
+    for (const rule of rules) {
+      try {
+        const occurrence = latestOccurrence(rule, now);
+        if (!occurrence || (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn)) continue;
+        const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+        if (!project || project.archivedAt !== null) continue;
+        const creator = await memberRepo.findMember(rule.orgId, rule.createdBy);
+        if (!creator || creator.status !== "active" || !can({ userId: rule.createdBy, orgId: rule.orgId, role: creator.role }, "issue:create", projectResource(project))) {
+          await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+        const assignee = rule.assigneeId === null ? null : await memberRepo.findMember(rule.orgId, rule.assigneeId);
+        await createIssue({ userId: rule.createdBy, orgId: rule.orgId, role: creator.role }, createIssueSchema.parse({
+          orgId: rule.orgId, projectId: rule.projectId, title: `${rule.title} (${occurrence})`,
+          priority: rule.priority, assigneeId: assignee?.status === "active" ? rule.assigneeId : null,
+        }));
+        await recurringRepo.updateRecurringIssue(rule.orgId, rule.id, { lastOccurrenceOn: occurrence });
+        result.processed += 1;
+      } catch {
+        result.failed += 1;
+      }
+    }
+  });
+}

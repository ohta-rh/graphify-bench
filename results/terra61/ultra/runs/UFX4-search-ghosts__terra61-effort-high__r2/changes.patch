+export async function clearWorkspaceIndex(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();
+}
+
+export async function removeIssueDocuments(orgId: OrgId, issueId: string): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    sql`((${searchIndex.subjectKind} = 'issue' AND ${searchIndex.subjectId} = ${issueId}) OR
+      (${searchIndex.subjectKind} = 'comment' AND ${searchIndex.subjectId} IN
+        (SELECT ${comments.id} FROM ${comments} WHERE ${comments.orgId} = ${orgId} AND ${comments.issueId} = ${issueId})))`,
+  )).run();
+}
+
+export async function removeProjectDocuments(orgId: OrgId, projectId: string): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    sql`((${searchIndex.subjectKind} = 'project' AND ${searchIndex.subjectId} = ${projectId}) OR
+      (${searchIndex.subjectKind} = 'issue' AND ${searchIndex.subjectId} IN
+        (SELECT ${issues.id} FROM ${issues} WHERE ${issues.orgId} = ${orgId} AND ${issues.projectId} = ${projectId})) OR
+      (${searchIndex.subjectKind} = 'comment' AND ${searchIndex.subjectId} IN
+        (SELECT ${comments.id} FROM ${comments} INNER JOIN ${issues} ON ${comments.issueId} = ${issues.id} AND ${comments.orgId} = ${issues.orgId}
+         WHERE ${issues.orgId} = ${orgId} AND ${issues.projectId} = ${projectId})))`,
+  )).run();
+}

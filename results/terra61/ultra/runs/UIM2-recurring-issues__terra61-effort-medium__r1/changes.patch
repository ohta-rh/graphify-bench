+import { wouldExceedLimit } from "@/config/plan-limits";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as repo from "@/server/repositories/recurring-issue-repository";
+import { orgResource, projectResource, requireFound } from "./_support";
+import type { CreateRecurringIssueInput } from "@/schemas/recurring-issue";
+import type { OrgId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+
+export async function createRecurringIssue(actor: Actor, input: CreateRecurringIssueInput): Promise<RecurringIssue> {
+  const data = createRecurringIssueSchema.parse(input);
+  assertOrgScope(actor, data.orgId);
+  const project = requireFound(await projectRepo.findProjectById(data.orgId, data.projectId), "Project", data.projectId);
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+  if (data.assigneeId !== null) {
+    const member = await memberRepo.findMember(data.orgId, data.assigneeId);
+    if (!member || member.status !== "active") throw new Error("Assignee must be an active member");
+  }
+  const org = requireFound(await orgRepo.findOrgById(data.orgId), "Organization", data.orgId);
+  if (wouldExceedLimit(org.plan, "recurringIssues", await repo.countRecurringIssues(data.orgId))) throw new Error("Recurring issue limit reached");
+  return repo.insertRecurringIssue(data, actor.userId);
+}
+export async function setRecurringIssuePaused(actor: Actor, input: { orgId: OrgId; recurringIssueId: string; paused: boolean }): Promise<RecurringIssue> {
+  assertOrgScope(actor, input.orgId);
+  const rule = requireFound(await repo.findRecurringIssue(input.orgId, input.recurringIssueId), "RecurringIssue", input.recurringIssueId);
+  const project = requireFound(await projectRepo.findProjectById(input.orgId, rule.projectId), "Project", rule.projectId);
+  assertCan(actor, "issue:create", projectResource(project));
+  return repo.updateRecurringIssue(input.orgId, rule.id, { paused: input.paused });
+}
+export async function listRecurringIssues(actor: Actor, orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "issue:read", orgResource(orgId));
+  return repo.listRecurringIssues(orgId);
+}

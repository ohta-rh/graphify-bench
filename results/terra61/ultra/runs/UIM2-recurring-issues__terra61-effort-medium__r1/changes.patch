+import { z } from "zod";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+import { issuePrioritySchema } from "./issue";
+
+export const createRecurringIssueSchema = z.object({
+  orgId: orgIdSchema,
+  projectId: projectIdSchema,
+  title: z.string().min(3).max(180),
+  priority: issuePrioritySchema.default("none"),
+  assigneeId: userIdSchema.nullable().default(null),
+  cadence: z.enum(["daily", "weekly"]),
+  weekday: z.number().int().min(1).max(7).nullable().default(null),
+  timezone: z.string().refine((zone) => {
+    try { new Intl.DateTimeFormat("en", { timeZone: zone }); return true; }
+    catch { return false; }
+  }, "Invalid time zone"),
+  startsOn: z.string().refine((date) => {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return false;
+    const parsed = new Date(`${date}T00:00:00.000Z`);
+    return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === date;
+  }, "Invalid calendar date"),
+}).refine((rule) => rule.cadence === "weekly" ? rule.weekday !== null : rule.weekday === null, {
+  path: ["weekday"], message: "Weekday must match cadence",
+});
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;

@@ -0,0 +1,42 @@
+import { subscribe } from "@/lib/event-bus";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { notify } from "./notification-service";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+
+async function notifyUnblocked(orgId: OrgId, blockerIds: readonly IssueId[], actorId: UserId | null): Promise<void> {
+  const issueIds = await dependencyRepo.listBlockedIssueIds(orgId, blockerIds);
+  for (const issueId of issueIds) {
+    const issue = await issueRepo.findIssueById(orgId, issueId);
+    if (!issue || issue.archivedAt !== null || CLOSED_ISSUE_STATUSES.includes(issue.status) || issue.assigneeId === null) continue;
+    if ((await dependencyRepo.listOpenBlockers(orgId, issueId)).length > 0) continue;
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Issue unblocked",
+      body: `Issue ${issue.title} is no longer blocked`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
+}
+
+export function registerDependencyListeners(): Unsubscribe {
+  const offs = [
+    subscribe("issue.status_changed", async (event) => {
+      if (!CLOSED_ISSUE_STATUSES.includes(event.from) && CLOSED_ISSUE_STATUSES.includes(event.to)) {
+        await notifyUnblocked(event.orgId, [event.issueId], event.actorId);
+      }
+    }),
+    subscribe("issue.archived", async (event) => {
+      const issue = await issueRepo.findIssueById(event.orgId, event.issueId);
+      if (issue && !CLOSED_ISSUE_STATUSES.includes(issue.status)) {
+        await notifyUnblocked(event.orgId, [event.issueId], event.actorId);
+      }
+    }),
+    subscribe("project.archived", async (event) => {
+      await notifyUnblocked(event.orgId, event.closedIssueIds ?? [], event.actorId);
+    }),
+  ];
+  return () => { for (const off of offs) off(); };
+}

@@ -0,0 +1,69 @@
+import { and, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import * as issueRepo from "./issue-repository";
+import type { IsoTimestamp, IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+function mapDependency(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IsoTimestamp,
+  };
+}
+
+/** Check the graph and insert together so concurrent additions cannot form a cycle. */
+export async function insertDependency(
+  orgId: OrgId, issueId: IssueId, blockerId: IssueId, createdBy: UserId,
+): Promise<IssueDependency> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const rows = tx.select().from(issueDependencies)
+      .where(eq(issueDependencies.orgId, orgId)).all();
+    const existing = rows.find((row) => row.issueId === issueId && row.blockerId === blockerId);
+    if (existing) return mapDependency(existing);
+    const pending: string[] = [blockerId];
+    const seen = new Set<string>();
+    while (pending.length) {
+      const current = pending.pop()!;
+      if (current === issueId) throw new Error("Issue dependency would create a cycle");
+      if (seen.has(current)) continue;
+      seen.add(current);
+      for (const row of rows) if (row.issueId === current) pending.push(row.blockerId);
+    }
+    return mapDependency(tx.insert(issueDependencies).values({
+      orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()),
+    }).returning().get());
+  });
+}
+
+export async function deleteDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId): Promise<boolean> {
+  return getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId),
+    eq(issueDependencies.blockerId, blockerId),
+  )).run().changes > 0;
+}
+
+export async function listBlockerIssues(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const links = getDb().select().from(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId),
+  )).all();
+  const blockers = await Promise.all(links.map((link) => issueRepo.findIssueById(orgId, link.blockerId as IssueId)));
+  return blockers.filter((issue): issue is Issue => issue !== null && issue.archivedAt === null)
+    .sort((a, b) => a.number - b.number || a.id.localeCompare(b.id));
+}
+
+export async function listOpenBlockers(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  return (await listBlockerIssues(orgId, issueId)).filter((issue) => !CLOSED_ISSUE_STATUSES.includes(issue.status));
+}
+
+export async function listBlockedIssueIds(orgId: OrgId, blockerIds: readonly IssueId[]): Promise<readonly IssueId[]> {
+  if (blockerIds.length === 0) return [];
+  const links = getDb().select().from(issueDependencies).where(eq(issueDependencies.orgId, orgId)).all();
+  const ids = new Set<string>(blockerIds);
+  return [...new Set(links.filter((link) => ids.has(link.blockerId)).map((link) => link.issueId as IssueId))];
+}

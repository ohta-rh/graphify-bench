+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import * as issues from "@/server/repositories/issue-repository";
+import * as notifications from "@/server/repositories/notification-repository";
+import * as activity from "@/server/repositories/activity-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Page } from "@/types/common";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+async function checkPages<T extends { id: string; orgId: string }>(
+  list: (limit: number, cursor: string | null) => Promise<Page<T>>,
+  orgId: string,
+) {
+  const full = await list(100, null);
+  expect(full.total).toBe(7);
+  expect(full.items).toHaveLength(7);
+  expect(full.items.every((item) => item.orgId === orgId)).toBe(true);
+  for (const limit of [1, 2, 3, 7, 10]) {
+    const seen: string[] = [];
+    let cursor: string | null = null;
+    do {
+      const page = await list(limit, cursor);
+      expect(page.total).toBe(7);
+      expect(page.items.every((item) => item.orgId === orgId)).toBe(true);
+      seen.push(...page.items.map((item) => item.id));
+      expect(seen.length).toBeLessThanOrEqual(7);
+      cursor = page.nextCursor;
+    } while (cursor);
+    expect(seen).toEqual(full.items.map((item) => item.id));
+    expect(new Set(seen).size).toBe(7);
+  }
+}
+
+describe("pagination with tied timestamps", () => {
+  it("keeps issues, notifications and activity ordered and tenant scoped", async () => {
+    const tenant = await createTenant("ties-main");
+    const other = await createTenant("ties-other");
+    vi.useFakeTimers({ toFake: ["Date"] });
+    try {
+      for (let i = 0; i < 8; i++) {
+        const current = i === 7 ? other : tenant;
+        // Two timestamp groups exercise both branches of the cursor predicate.
+        const date = new Date(i < 4 ? "2026-01-02T00:00:00.000Z" : "2026-01-01T00:00:00.000Z");
+        vi.setSystemTime(date);
+        const number = await issues.nextIssueNumber(current.org.id, current.project.id);
+        await issues.insertIssue(issueInput(current.org.id, current.project.id), current.userIds.owner, number);
+        await notifications.insertNotification(current.org.id, {
+          orgId: current.org.id,
+          recipientId: tenant.userIds.owner,
+          kind: "issue_assigned",
+          title: "Assigned",
+          body: "Issue assigned",
+          href: "/issues",
+          actorId: null,
+          channels: ["in_app"],
+        });
+        await activity.insertActivity({
+          orgId: current.org.id,
+          action: "issue.created",
+          actorId: current.userIds.owner,
+          subjectKind: "project",
+          subjectId: current.project.id,
+          projectId: current.project.id,
+          summary: "Created",
+          metadata: {},
+          occurredAt: toIsoTimestamp(date),
+        });
+      }
+    } finally {
+      vi.useRealTimers();
+    }
+    await checkPages((limit, cursor) => issues.listIssues({ orgId: tenant.org.id, projectId: tenant.project.id, limit, cursor }), tenant.org.id);
+    await checkPages((limit, cursor) => notifications.listNotifications({ orgId: tenant.org.id, recipientId: tenant.userIds.owner, unreadOnly: false, limit, cursor }), tenant.org.id);
+    await checkPages((limit, cursor) => activity.listActivity({ orgId: tenant.org.id, limit, cursor }), tenant.org.id);
+  });
+});

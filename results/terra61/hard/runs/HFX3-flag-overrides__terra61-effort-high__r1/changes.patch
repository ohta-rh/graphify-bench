@@ -0,0 +1,32 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { toggleFlag } from "@/server/services/feature-flag-service";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => { cleanup(); });
+
+describe("feature flag overrides", () => {
+  it("removes only the selected override and can add it again", async () => {
+    const tenant = await createTenant("flagstoggle", "free");
+    const orgId = tenant.org.id;
+    const actor = tenant.actors.admin;
+    await toggleFlag(actor, { orgId, flag: "kanban_board", enabled: true });
+    await toggleFlag(actor, { orgId, flag: "activity_feed", enabled: true });
+    await toggleFlag(actor, { orgId, flag: "kanban_board", enabled: false });
+    expect((await orgRepo.findOrgById(orgId))?.settings.enabledFlagOverrides).toEqual(["activity_feed"]);
+    await toggleFlag(actor, { orgId, flag: "kanban_board", enabled: true });
+    expect((await orgRepo.findOrgById(orgId))?.settings.enabledFlagOverrides).toEqual(["activity_feed", "kanban_board"]);
+  });
+
+  it("rejects a non-overridable plan feature without storing it", async () => {
+    const tenant = await createTenant("flagsplan", "free");
+    await expect(toggleFlag(tenant.actors.admin, { orgId: tenant.org.id, flag: "webhooks", enabled: true })).rejects.toThrow(/cannot be overridden/);
+    expect((await orgRepo.findOrgById(tenant.org.id))?.settings.enabledFlagOverrides).toEqual([]);
+  });
+});

+/** Clears all live assignments for a departing member in this organization. */
+export async function unassignMemberIssues(orgId: OrgId, userId: UserId): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .update(issues)
+    .set({ assigneeId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.assigneeId, userId), isNull(issues.archivedAt)))
+    .returning()
+    .all();
+  return rows.map((row) => toIssue(row));

+
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | { missingId: LabelId }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const findLabel = (id: LabelId) => tx.select().from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, id)))
+      .get();
+    const source = findLabel(input.sourceLabelId);
+    if (!source) return { missingId: input.sourceLabelId };
+    const target = findLabel(input.targetLabelId);
+    if (!target) return { missingId: input.targetLabelId };
+
+    const assignments = tx.select({ issueId: issueLabels.issueId }).from(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .all();
+    for (const assignment of assignments) {
+      tx.insert(issueLabels).values({
+        orgId: input.orgId,
+        issueId: assignment.issueId,
+        labelId: input.targetLabelId,
+      }).onConflictDoNothing().run();
+    }
+    tx.delete(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+    return { label: toLabel(target), issuesRelabelled: assignments.length };
+  });
 }
 

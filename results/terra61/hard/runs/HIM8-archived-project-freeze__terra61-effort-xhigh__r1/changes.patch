@@ -0,0 +1,79 @@
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+vi.mock("@/lib/rate-limit", async () => (await import("../server/_support/doubles/misc")).rateLimitModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { runOverdueIssueJob } from "@/server/jobs/overdue-issue-job";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import * as attachments from "@/server/services/attachment-service";
+import * as comments from "@/server/services/comment-service";
+import * as issues from "@/server/services/issue-service";
+import * as projects from "@/server/services/project-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import { toIsoTimestamp } from "@/types/common";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+it("freezes issue writes and overdue events until the project is restored", async () => {
+  const tenant = await createTenant("freeze", "growth");
+  const { org, project, actors } = tenant;
+  const issue = await issues.createIssue(actors.member, issueInput(org.id, project.id, {
+    dueAt: "2020-01-01T00:00:00.000Z",
+  }));
+  const commentInput = { orgId: org.id, issueId: issue.id, body: "original", parentId: null, mentionedUserIds: [] };
+  const comment = await comments.createComment(actors.member, commentInput);
+  const attachmentInput = { orgId: org.id, issueId: issue.id, filename: "file.txt", contentType: "text/plain", sizeBytes: 12 };
+  const attachment = await attachments.addAttachment(actors.member, attachmentInput);
+  await usageRepo.recomputeUsage(org.id);
+  await projects.archiveProject(actors.admin, { orgId: org.id, projectId: project.id, archiveIssues: false });
+
+  const seen: string[] = [];
+  const off = ["issue.updated", "issue.status_changed", "issue.assigned", "issue.archived", "comment.created", "comment.deleted", "issue.overdue"].map((event) =>
+    subscribe(event as "issue.updated", () => { seen.push(event); }),
+  );
+  try {
+    const operations = [
+      () => issues.updateIssue(actors.member, { orgId: org.id, issueId: issue.id, title: "changed" }),
+      () => issues.changeIssueStatus(actors.member, { orgId: org.id, issueId: issue.id, status: issue.status }),
+      () => issues.moveIssue(actors.member, { orgId: org.id, issueId: issue.id, toStatus: "done", toIndex: 0 }),
+      () => issues.assignIssue(actors.member, { orgId: org.id, issueId: issue.id, assigneeId: tenant.userIds.member }),
+      () => issues.assignIssue(actors.member, { orgId: org.id, issueId: issue.id, assigneeId: null }),
+      () => issues.archiveIssue(actors.member, org.id, issue.id),
+      () => comments.createComment(actors.member, commentInput),
+      () => comments.updateComment(actors.member, { orgId: org.id, commentId: comment.id, body: "changed" }),
+      () => comments.deleteComment(actors.member, { orgId: org.id, commentId: comment.id }),
+      () => attachments.addAttachment(actors.member, attachmentInput),
+      () => attachments.removeAttachment(actors.member, { orgId: org.id, attachmentId: attachment.id }),
+    ];
+    for (const operation of operations) {
+      await expect(operation()).rejects.toMatchObject({ name: "AlreadyArchivedError", entity: "Project", id: project.id });
+    }
+    await expect(issues.updateIssue(actors.viewer, { orgId: org.id, issueId: issue.id, title: "denied" })).rejects.toBeInstanceOf(PermissionDeniedError);
+    expect(await issues.getIssue(actors.member, org.id, issue.id)).toMatchObject({ issue });
+    expect(await comments.getThread(actors.member, org.id, issue.id)).toHaveLength(1);
+    expect(await attachments.listAttachments(actors.member, org.id, issue.id)).toEqual([attachment]);
+    const now = new Date("2026-01-01T00:00:00.000Z");
+    await runOverdueIssueJob(now);
+    expect(seen).toEqual([]);
+    expect(await issueRepo.listOverdueIssues(org.id, toIsoTimestamp(now))).toHaveLength(0);
+    await projects.restoreProject(actors.admin, org.id, project.id);
+    await runOverdueIssueJob(now);
+    expect(seen).toContain("issue.overdue");
+    await issues.updateIssue(actors.member, { orgId: org.id, issueId: issue.id, title: "unfrozen" });
+    await comments.updateComment(actors.member, { orgId: org.id, commentId: comment.id, body: "unfrozen" });
+    await attachments.removeAttachment(actors.member, { orgId: org.id, attachmentId: attachment.id });
+    await issues.archiveIssue(actors.member, org.id, issue.id);
+    await projects.archiveProject(actors.admin, { orgId: org.id, projectId: project.id, archiveIssues: false });
+    await expect(issues.updateIssue(actors.member, { orgId: org.id, issueId: issue.id, title: "archived" })).rejects.toMatchObject({ name: "AlreadyArchivedError", entity: "Issue" });
+    await expect(comments.createComment(actors.member, commentInput)).rejects.toBeInstanceOf(AlreadyArchivedError);
+  } finally {
+    off.forEach((unsubscribe) => unsubscribe());
+  }
+});

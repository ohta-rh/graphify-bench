+
+/** Check both labels and move their assignments atomically. */
+export async function mergeLabels(input: MergeLabelsInput): Promise<{
+  source: IssueLabel | null;
+  target: IssueLabel | null;
+  issuesRelabelled: number;
+}> {
+  return getDb().transaction((tx) => {
+    const findLabel = (labelId: LabelId) => tx.select().from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, labelId)))
+      .get();
+    const sourceRow = findLabel(input.sourceLabelId);
+    const targetRow = findLabel(input.targetLabelId);
+    const source = sourceRow ? toLabel(sourceRow) : null;
+    const target = targetRow ? toLabel(targetRow) : null;
+    if (!source || !target) return { source, target, issuesRelabelled: 0 };
+
+    const assignments = tx.select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .all();
+    for (const { issueId } of assignments) {
+      tx.insert(issueLabels)
+        .values({ orgId: input.orgId, issueId, labelId: input.targetLabelId })
+        .onConflictDoNothing()
+        .run();
+    }
+    tx.delete(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+    return { source, target, issuesRelabelled: assignments.length };
+  });
 }
 

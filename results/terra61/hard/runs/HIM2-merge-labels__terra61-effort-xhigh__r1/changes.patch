+
+/** Moves all source assignments and deletes the source atomically. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | { missingLabelId: LabelId }> {
+  return getDb().transaction((tx) => {
+    const findLabel = (labelId: LabelId) => tx.select().from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, labelId)))
+      .get();
+
+    const source = findLabel(input.sourceLabelId);
+    if (!source) return { missingLabelId: input.sourceLabelId };
+    const target = findLabel(input.targetLabelId);
+    if (!target) return { missingLabelId: input.targetLabelId };
+
+    const assignments = tx.select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, input.orgId),
+        eq(issueLabels.labelId, input.sourceLabelId),
+      ))
+      .all();
+
+    for (const assignment of assignments) {
+      tx.insert(issueLabels)
+        .values({ orgId: input.orgId, issueId: assignment.issueId, labelId: input.targetLabelId })
+        .onConflictDoNothing({ target: [issueLabels.issueId, issueLabels.labelId] })
+        .run();
+    }
+    tx.delete(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, input.orgId),
+        eq(issueLabels.labelId, input.sourceLabelId),
+      ))
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+
+    return { label: toLabel(target), issuesRelabelled: assignments.length };
+  });
 }
 

@@ -0,0 +1,23 @@
+import { and, eq } from "drizzle-orm";
+import { getDb, mutedProjects } from "@/server/db";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+
+export async function mute(orgId: OrgId, userId: UserId, projectId: ProjectId): Promise<void> {
+  getDb().insert(mutedProjects).values({ orgId, userId, projectId }).onConflictDoNothing().run();
+}
+
+export async function unmute(orgId: OrgId, userId: UserId, projectId: ProjectId): Promise<void> {
+  getDb().delete(mutedProjects).where(and(orgPredicate(mutedProjects.orgId, orgId), eq(mutedProjects.userId, userId), eq(mutedProjects.projectId, projectId))).run();
+}
+
+export async function list(orgId: OrgId, userId: UserId): Promise<readonly ProjectId[]> {
+  return getDb().select({ projectId: mutedProjects.projectId }).from(mutedProjects)
+    .where(and(orgPredicate(mutedProjects.orgId, orgId), eq(mutedProjects.userId, userId)))
+    .all().map((row) => row.projectId as ProjectId);
+}
+
+export async function isMuted(orgId: OrgId, userId: UserId, projectId: ProjectId): Promise<boolean> {
+  return getDb().select({ projectId: mutedProjects.projectId }).from(mutedProjects)
+    .where(and(orgPredicate(mutedProjects.orgId, orgId), eq(mutedProjects.userId, userId), eq(mutedProjects.projectId, projectId))).get() !== undefined;
+}

+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import type { IssueId, OrgId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import type { Actor } from "@/types/member";
+import { issueResource, requireFound } from "./_support";
+
+export class IssueBlockedError extends Error {
+  readonly code = "conflict" as const;
+  constructor(readonly blockerIds: readonly IssueId[]) {
+    super("Issue has open blockers");
+    this.name = "IssueBlockedError";
+  }
+}
+
+export async function addBlocker(actor: Actor, input: { orgId: OrgId; issueId: IssueId; blockerId: IssueId }): Promise<IssueDependency> {
+  assertOrgScope(actor, input.orgId);
+  const issue = requireFound(await issueRepo.findIssueById(input.orgId, input.issueId), "Issue", input.issueId);
+  assertCan(actor, "issue:update", issueResource(issue));
+  assertNotArchived("Issue", issue.id, issue);
+  const blocker = requireFound(await issueRepo.findIssueById(input.orgId, input.blockerId), "Issue", input.blockerId);
+  assertNotArchived("Issue", blocker.id, blocker);
+  const existing = await dependencyRepo.find(input.orgId, input.issueId, input.blockerId);
+  if (existing) return existing;
+  if (input.issueId === input.blockerId) throw new Error("An issue cannot block itself");
+  const links = await dependencyRepo.listLinks(input.orgId);
+  const graph = new Map<IssueId, IssueId[]>();
+  for (const link of links) graph.set(link.issueId, [...(graph.get(link.issueId) ?? []), link.blockerId]);
+  const pending = [input.blockerId];
+  const seen = new Set<IssueId>();
+  while (pending.length) {
+    const current = pending.pop()!;
+    if (current === input.issueId) throw new Error("Issue dependency would create a cycle");
+    if (seen.has(current)) continue;
+    seen.add(current);
+    pending.push(...(graph.get(current) ?? []));
+  }
+  return dependencyRepo.insert(input.orgId, input.issueId, input.blockerId, actor.userId);
+}
+
+export async function removeBlocker(actor: Actor, input: { orgId: OrgId; issueId: IssueId; blockerId: IssueId }): Promise<boolean> {
+  assertOrgScope(actor, input.orgId);
+  const issue = requireFound(await issueRepo.findIssueById(input.orgId, input.issueId), "Issue", input.issueId);
+  assertCan(actor, "issue:update", issueResource(issue));
+  return dependencyRepo.remove(input.orgId, input.issueId, input.blockerId);
+}
+
+export async function listBlockers(actor: Actor, orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  assertOrgScope(actor, orgId);
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  assertCan(actor, "issue:read", issueResource(issue));
+  return dependencyRepo.list(orgId, issueId);
+}
+
+export async function assertIssueCanComplete(orgId: OrgId, issueId: IssueId): Promise<void> {
+  const blockerIds = await dependencyRepo.openBlockerIds(orgId, issueId);
+  if (blockerIds.length) throw new IssueBlockedError(blockerIds);
+}

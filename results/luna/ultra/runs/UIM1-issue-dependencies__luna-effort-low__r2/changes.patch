+import { and, asc, eq, isNull, ne } from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { toIssue } from "./_mappers";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+function toDependency(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IssueDependency["createdAt"],
+  };
+}
+
+export async function find(orgId: OrgId, issueId: IssueId, blockerId: IssueId): Promise<IssueDependency | null> {
+  const row = getDb().select().from(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), eq(issueDependencies.blockerId, blockerId),
+  )).get();
+  return row ? toDependency(row) : null;
+}
+
+export async function insert(orgId: OrgId, issueId: IssueId, blockerId: IssueId, createdBy: UserId): Promise<IssueDependency> {
+  const row = getDb().insert(issueDependencies).values({ orgId, issueId, blockerId, createdBy, createdAt: new Date().toISOString() }).returning().get();
+  return toDependency(row);
+}
+
+export async function remove(orgId: OrgId, issueId: IssueId, blockerId: IssueId): Promise<boolean> {
+  const row = getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), eq(issueDependencies.blockerId, blockerId),
+  )).returning({ issueId: issueDependencies.issueId }).get();
+  return row !== undefined;
+}
+
+export async function list(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ issue: issues }).from(issueDependencies)
+    .innerJoin(issues, and(eq(issues.orgId, issueDependencies.orgId), eq(issues.id, issueDependencies.blockerId)))
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), eq(issues.orgId, orgId), isNull(issues.archivedAt)))
+    .orderBy(asc(issues.number)).all();
+  return rows.map((row) => toIssue(row.issue));
+}
+
+export async function listLinks(orgId: OrgId): Promise<readonly { issueId: IssueId; blockerId: IssueId }[]> {
+  return getDb().select({ issueId: issueDependencies.issueId, blockerId: issueDependencies.blockerId })
+    .from(issueDependencies).where(eq(issueDependencies.orgId, orgId)).all()
+    .map((row) => ({ issueId: row.issueId as IssueId, blockerId: row.blockerId as IssueId }));
+}
+
+export async function openBlockerIds(orgId: OrgId, issueId: IssueId): Promise<readonly IssueId[]> {
+  return getDb().select({ id: issues.id }).from(issueDependencies)
+    .innerJoin(issues, and(eq(issues.orgId, issueDependencies.orgId), eq(issues.id, issueDependencies.blockerId)))
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId), isNull(issues.archivedAt), ne(issues.status, "done"), ne(issues.status, "canceled")))
+    .all().map((row) => row.id as IssueId);
+}
+
+export async function blockedBy(orgId: OrgId, blockerId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ issue: issues }).from(issueDependencies)
+    .innerJoin(issues, and(eq(issues.orgId, issueDependencies.orgId), eq(issues.id, issueDependencies.issueId)))
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.blockerId, blockerId)))
+    .all();
+  return rows.map((row) => toIssue(row.issue));
+}

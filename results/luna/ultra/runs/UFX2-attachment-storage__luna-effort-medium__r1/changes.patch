+
+/** Storage charges each file independently, rounded up to a whole MiB. */
+export async function sumStorageMegabytes(orgId: OrgId): Promise<number> {
+  const rows = getDb()
+    .select({ sizeBytes: attachments.sizeBytes })
+    .from(attachments)
+    .where(orgPredicate(attachments.orgId, orgId))
+    .all();
+  const bytesPerMb = 1024 * 1024;
+  return rows.reduce((total, row) => total + Math.ceil(row.sizeBytes / bytesPerMb), 0);
 }

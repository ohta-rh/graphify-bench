+/** Every workspace that has not been deleted, including newly created ones. */
+export async function listLiveOrgIds(limit: number): Promise<readonly OrgId[]> {
+  const rows = getDb()
+    .select({ id: organizations.id })
+    .from(organizations)
+    .where(isNull(organizations.archivedAt))
+    .orderBy(organizations.createdAt)
+    .limit(Math.max(1, limit))
+    .all();
+  return rows.map((row) => row.id as OrgId);
+}

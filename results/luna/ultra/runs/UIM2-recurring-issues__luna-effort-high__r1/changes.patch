+import { getPlanLimits } from "@/config/plan-limits";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import { orgResource, projectResource, requireFound } from "./_support";
+import type { CreateRecurringIssueInput } from "@/schemas/recurring-issue";
+import type { OrgId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+
+export async function createRecurringIssue(
+  actor: Actor,
+  input: CreateRecurringIssueInput,
+): Promise<RecurringIssue> {
+  const parsed = createRecurringIssueSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(parsed.orgId, parsed.projectId),
+    "Project", parsed.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  if (parsed.assigneeId !== null) {
+    const member = await memberRepo.findMember(parsed.orgId, parsed.assigneeId);
+    if (!member || member.status !== "active") {
+      throw new Error(`Assignee ${parsed.assigneeId} is not an active organization member`);
+    }
+  }
+
+  const org = requireFound(await orgRepo.findOrgById(parsed.orgId), "Organization", parsed.orgId);
+  const used = await recurringRepo.countForOrg(parsed.orgId);
+  if (used >= getPlanLimits(org.plan).recurringIssues) {
+    throw new Error(`Plan ${org.plan} allows no more recurring issues`);
+  }
+
+  return recurringRepo.insert({ ...parsed, createdBy: actor.userId });
+}
+
+export async function setRecurringIssuePaused(
+  actor: Actor,
+  input: { orgId: OrgId; recurringIssueId: string; paused: boolean },
+): Promise<RecurringIssue> {
+  assertOrgScope(actor, input.orgId);
+  const rule = requireFound(
+    await recurringRepo.findById(input.orgId, input.recurringIssueId),
+    "Recurring issue", input.recurringIssueId,
+  );
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, rule.projectId),
+    "Project", rule.projectId,
+  );
+  assertCan(actor, "issue:create", projectResource(project));
+  return recurringRepo.updateState(input.orgId, rule.id, { paused: input.paused });
+}
+
+export async function listRecurringIssues(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<readonly RecurringIssue[]> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "issue:read", orgResource(orgId));
+  const rules = await recurringRepo.listForOrg(orgId);
+  for (const rule of rules) {
+    const project = requireFound(
+      await projectRepo.findProjectById(orgId, rule.projectId), "Project", rule.projectId,
+    );
+    assertCan(actor, "issue:read", projectResource(project));
+  }
+  return rules;
+}

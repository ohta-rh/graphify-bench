+import { and, asc, count, eq } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+import type { IssuePriority } from "@/types/issue";
+import type { RecurrenceCadence, RecurringIssue } from "@/types/recurring-issue";
+
+function map(row: typeof recurringIssues.$inferSelect): RecurringIssue {
+  return {
+    id: row.id,
+    orgId: row.orgId as OrgId,
+    projectId: row.projectId as ProjectId,
+    title: row.title,
+    priority: row.priority as IssuePriority,
+    assigneeId: row.assigneeId as UserId | null,
+    cadence: row.cadence as RecurrenceCadence,
+    weekday: row.weekday,
+    timezone: row.timezone,
+    startsOn: row.startsOn,
+    lastOccurrenceOn: row.lastOccurrenceOn,
+    paused: row.paused,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as RecurringIssue["createdAt"],
+    updatedAt: row.updatedAt as RecurringIssue["updatedAt"],
+  };
+}
+
+export async function countForOrg(orgId: OrgId): Promise<number> {
+  const row = getDb().select({ value: count() }).from(recurringIssues)
+    .where(eq(recurringIssues.orgId, orgId)).get();
+  return row?.value ?? 0;
+}
+
+export async function insert(input: {
+  orgId: OrgId; projectId: ProjectId; title: string; priority: IssuePriority;
+  assigneeId: UserId | null; cadence: RecurrenceCadence; weekday: number | null;
+  timezone: string; startsOn: string; createdBy: UserId;
+}): Promise<RecurringIssue> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb().insert(recurringIssues).values({
+    id: newId(), ...input, lastOccurrenceOn: null, paused: false,
+    createdAt: stamp, updatedAt: stamp,
+  }).returning().get();
+  return map(row);
+}
+
+export async function findById(orgId: OrgId, id: string): Promise<RecurringIssue | null> {
+  const row = getDb().select().from(recurringIssues)
+    .where(and(eq(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).get();
+  return row ? map(row) : null;
+}
+
+export async function listForOrg(orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(eq(recurringIssues.orgId, orgId))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id)).all().map(map);
+}
+
+export async function listAllRunnable(): Promise<readonly RecurringIssue[]> {
+  return getDb().select().from(recurringIssues).where(eq(recurringIssues.paused, false))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id)).all().map(map);
+}
+
+export async function updateState(
+  orgId: OrgId, id: string, patch: { paused?: boolean; lastOccurrenceOn?: string },
+): Promise<RecurringIssue> {
+  const row = getDb().update(recurringIssues).set({ ...patch, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(eq(recurringIssues.orgId, orgId), eq(recurringIssues.id, id))).returning().get();
+  if (!row) throw new Error(`Recurring issue ${id} not found`);
+  return map(row);
+}

+import { can } from "@/lib/permissions";
+import { createIssue } from "@/server/services/issue-service";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { createIssueSchema } from "@/schemas/issue";
+import { projectResource } from "@/server/services/_support";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import type { Actor } from "@/types/member";
+
+function dateInTimezone(now: Date, timezone: string): string {
+  const parts = new Intl.DateTimeFormat("en-US", {
+    timeZone: timezone, year: "numeric", month: "2-digit", day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: string) => parts.find((item) => item.type === type)?.value ?? "";
+  return `${part("year")}-${part("month")}-${part("day")}`;
+}
+
+function previousDate(date: string, days: number): string {
+  const value = new Date(`${date}T00:00:00.000Z`);
+  value.setUTCDate(value.getUTCDate() - days);
+  return value.toISOString().slice(0, 10);
+}
+
+function latestStartedOccurrence(rule: RecurringIssue, now: Date): string | null {
+  const localToday = dateInTimezone(now, rule.timezone);
+  if (localToday < rule.startsOn) return null;
+  if (rule.cadence === "daily") return localToday;
+  const weekday = new Date(`${localToday}T00:00:00.000Z`).getUTCDay() || 7;
+  const difference = (weekday - (rule.weekday ?? weekday) + 7) % 7;
+  const occurrence = previousDate(localToday, difference);
+  return occurrence >= rule.startsOn ? occurrence : null;
+}
+
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    const rules = await recurringRepo.listAllRunnable();
+    for (const rule of rules) {
+      try {
+        const occurrence = latestStartedOccurrence(rule, now);
+        if (occurrence === null || (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn)) continue;
+
+        const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+        if (!project || project.archivedAt !== null) continue;
+
+        const creator = await memberRepo.findMember(rule.orgId, rule.createdBy);
+        if (!creator || creator.status !== "active") {
+          await recurringRepo.updateState(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+
+        const actor: Actor = { userId: rule.createdBy, orgId: rule.orgId, role: creator.role };
+        if (!can(actor, "issue:create", projectResource(project))) {
+          await recurringRepo.updateState(rule.orgId, rule.id, { paused: true });
+          continue;
+        }
+
+        let assigneeId = rule.assigneeId;
+        if (assigneeId !== null) {
+          const assignee = await memberRepo.findMember(rule.orgId, assigneeId);
+          if (!assignee || assignee.status !== "active") assigneeId = null;
+        }
+
+        await createIssue(actor, createIssueSchema.parse({
+          orgId: rule.orgId,
+          projectId: rule.projectId,
+          title: `${rule.title} (${occurrence})`,
+          priority: rule.priority,
+          assigneeId,
+          status: "backlog",
+          description: null,
+          dueAt: null,
+          labelIds: [],
+          parentId: null,
+          estimate: null,
+        }));
+        await recurringRepo.updateState(rule.orgId, rule.id, { lastOccurrenceOn: occurrence });
+        result.processed += 1;
+      } catch {
+        // A single invalid/stale rule or a refused issue must not stop the scan.
+        result.failed += 1;
+      }
+    }
+  });
+}

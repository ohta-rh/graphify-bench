+import { z } from "zod";
+import { issuePrioritySchema } from "./issue";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+
+const dateOnlySchema = z.string().regex(/^\d{4}-\d{2}-\d{2}$/).refine((value) => {
+  const [year, month, day] = value.split("-").map(Number);
+  const date = new Date(0);
+  date.setUTCHours(0, 0, 0, 0);
+  date.setUTCFullYear(year, month - 1, day);
+  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+}, "must be a real YYYY-MM-DD calendar date");
+
+const timezoneSchema = z.string().min(1).refine((timezone) => {
+  try {
+    new Intl.DateTimeFormat("en", { timeZone: timezone });
+    return true;
+  } catch {
+    return false;
+  }
+}, "must be a recognized IANA time zone");
+
+export const createRecurringIssueSchema = z.object({
+  orgId: orgIdSchema,
+  projectId: projectIdSchema,
+  title: z.string().min(3, "give the issue a title").max(180),
+  priority: issuePrioritySchema.default("none"),
+  assigneeId: userIdSchema.nullable().default(null),
+  cadence: z.enum(["daily", "weekly"]),
+  weekday: z.number().int().min(1).max(7).nullable().default(null),
+  timezone: timezoneSchema,
+  startsOn: dateOnlySchema,
+}).superRefine((input, context) => {
+  if (input.cadence === "weekly" && input.weekday === null) {
+    context.addIssue({ code: "custom", path: ["weekday"], message: "weekly recurrence requires a weekday" });
+  }
+  if (input.cadence === "daily" && input.weekday !== null) {
+    context.addIssue({ code: "custom", path: ["weekday"], message: "daily recurrence cannot specify a weekday" });
+  }
+});
+
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;

@@ -0,0 +1,168 @@
+/** Personal API tokens. The secret hash remains inside this repository. */
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { apiTokens, getDb } from "@/server/db";
+import { orgPredicate } from "./base-repository";
+import { toApiToken } from "./_mappers";
+import type { ApiTokenScope } from "@/types/api-token";
+import type { ApiTokenRow } from "@/server/db/schema/api-tokens";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+interface NewApiTokenRow {
+  orgId: OrgId;
+  userId: UserId;
+  name: string;
+  scope: ApiTokenScope;
+  prefix: string;
+  tokenHash: string;
+  expiresAt: IsoTimestamp;
+  createdAt: IsoTimestamp;
+}
+
+/** Atomically enforces the usable-token cap while inserting the new row. */
+export async function insertIfBelowLimit(
+  input: NewApiTokenRow,
+): Promise<ApiToken | null> {
+  const db = getDb();
+  const row = db.transaction((tx): ApiTokenRow | null => {
+    const usable = tx
+      .select({ value: count() })
+      .from(apiTokens)
+      .where(
+        and(
+          orgPredicate(apiTokens.orgId, input.orgId),
+          eq(apiTokens.userId, input.userId),
+          isNull(apiTokens.revokedAt),
+          gt(apiTokens.expiresAt, input.createdAt),
+        ),
+      )
+      .get();
+
+    if ((usable?.value ?? 0) >= 5) return null;
+
+    return tx
+      .insert(apiTokens)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        userId: input.userId,
+        name: input.name,
+        scope: input.scope,
+        prefix: input.prefix,
+        tokenHash: input.tokenHash,
+        expiresAt: input.expiresAt,
+        lastUsedAt: null,
+        revokedAt: null,
+        createdAt: input.createdAt,
+      })
+      .returning()
+      .get();
+  });
+
+  return row ? toApiToken(row) : null;
+}
+
+export async function listTokens(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  return getDb()
+    .select()
+    .from(apiTokens)
+    .where(
+      and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)),
+    )
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id))
+    .all()
+    .map(toApiToken);
+}
+
+export async function findTokenById(
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+export async function findTokenByHash(
+  tokenHash: string,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, tokenHash))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+export async function markUsed(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<boolean> {
+  const row = getDb()
+    .update(apiTokens)
+    .set({ lastUsedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, at),
+      ),
+    )
+    .returning({ id: apiTokens.id })
+    .get();
+  return row !== undefined;
+}
+
+export async function revokeToken(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; changed: boolean }> {
+  const row = getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .get();
+
+  if (row) return { apiToken: toApiToken(row), changed: true };
+  const current = await findTokenById(orgId, tokenId);
+  if (current) return { apiToken: current, changed: false };
+  throw new Error(`API token ${tokenId} not found in org ${orgId}`);
+}
+
+/** Revokes every not-yet-revoked token, including expired tokens. */
+export async function revokeAllForMember(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  const rows = getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.userId, userId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .all();
+  return rows.map(toApiToken);
+}

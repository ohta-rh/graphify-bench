@@ -0,0 +1,160 @@
+/** Personal API token lifecycle and authentication. */
+import { emit, subscribe } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { actorEnvelope, orgResource, requireFound } from "./_support";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Actor } from "@/types/member";
+
+const DAY_MS = 24 * 60 * 60 * 1_000;
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+
+  if (parsed.scope === "write") {
+    assertCan(actor, "api_token:create_write", orgResource(parsed.orgId));
+  }
+
+  const now = new Date();
+  const createdAt = toIsoTimestamp(now);
+  const expiresAt = toIsoTimestamp(
+    new Date(now.getTime() + parsed.expiresInDays * DAY_MS),
+  );
+  const token = `tfk_${randomToken()}`;
+  const apiToken = await apiTokenRepo.insertIfBelowLimit({
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    prefix: token.slice(0, 12),
+    tokenHash: hashToken(token),
+    expiresAt,
+    createdAt,
+  });
+
+  if (apiToken === null) {
+    throw new Error("A user may have at most five usable API tokens per organization");
+  }
+
+  await emit("api_token.created", {
+    ...actorEnvelope(actor),
+    tokenId: apiToken.id,
+  });
+
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) {
+    assertCan(actor, "api_token:manage_others", orgResource(orgId));
+  }
+  return apiTokenRepo.listTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const current = requireFound(
+    await apiTokenRepo.findTokenById(orgId, tokenId),
+    "API token",
+    tokenId,
+  );
+
+  if (current.userId !== actor.userId) {
+    assertCan(actor, "api_token:manage_others", orgResource(orgId));
+  }
+  if (current.revokedAt !== null) return current;
+
+  const result = await apiTokenRepo.revokeToken(
+    orgId,
+    tokenId,
+    toIsoTimestamp(new Date()),
+  );
+  if (result.changed) {
+    await emit("api_token.revoked", {
+      ...actorEnvelope(actor),
+      tokenId: result.apiToken.id,
+    });
+  }
+  return result.apiToken;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const apiToken = await apiTokenRepo.findTokenByHash(hashToken(token));
+  if (apiToken === null || apiToken.revokedAt !== null) return null;
+
+  const now = toIsoTimestamp(new Date());
+  if (apiToken.expiresAt <= now) return null;
+
+  const [member, organization] = await Promise.all([
+    memberRepo.findMember(apiToken.orgId, apiToken.userId),
+    orgRepo.findOrgById(apiToken.orgId),
+  ]);
+  if (
+    member === null ||
+    member.status !== "active" ||
+    organization === null ||
+    organization.archivedAt !== null
+  ) {
+    return null;
+  }
+
+  if (!(await apiTokenRepo.markUsed(apiToken.orgId, apiToken.id, now))) {
+    return null;
+  }
+
+  return {
+    userId: apiToken.userId,
+    orgId: apiToken.orgId,
+    role:
+      apiToken.scope === "read"
+        ? "viewer"
+        : member.role,
+  };
+}
+
+/**
+ * Handles member removal after its service event is published. The resulting
+ * token revocations are published in turn so the activity service records
+ * each one with the member remover as actor.
+ */
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const revokedAt = toIsoTimestamp(new Date());
+    const tokens = await apiTokenRepo.revokeAllForMember(
+      payload.orgId,
+      payload.userId,
+      revokedAt,
+    );
+
+    for (const apiToken of tokens) {
+      await emit("api_token.revoked", {
+        orgId: payload.orgId,
+        actorId: payload.actorId,
+        occurredAt: revokedAt,
+        tokenId: apiToken.id,
+      });
+    }
+  });
+}

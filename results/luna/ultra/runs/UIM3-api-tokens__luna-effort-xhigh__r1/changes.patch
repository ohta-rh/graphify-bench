+import type { IsoTimestamp, OrgId, UserId } from "./common";
+
+export type ApiTokenScope = "read" | "write";
+
+/** Public metadata for a personal API token. Secrets and hashes never leave the repository. */
+export interface ApiToken {
+  readonly id: string;
+  readonly orgId: OrgId;
+  readonly userId: UserId;
+  readonly name: string;
+  readonly scope: ApiTokenScope;
+  readonly prefix: string;
+  readonly expiresAt: IsoTimestamp;
+  readonly lastUsedAt: IsoTimestamp | null;
+  readonly revokedAt: IsoTimestamp | null;
+  readonly createdAt: IsoTimestamp;
+}

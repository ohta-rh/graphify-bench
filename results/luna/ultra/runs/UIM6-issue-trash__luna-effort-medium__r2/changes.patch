+/** Permanently remove an expired issue and its owned rows. Returns the comments and attachment sizes for index and quota cleanup. */
+export async function purgeIssue(orgId: OrgId, issueId: IssueId): Promise<{ commentIds: string[]; attachmentSizes: number[] }> {
+  const db = getDb();
+  const commentRows = db.select({ id: comments.id }).from(comments).where(and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId))).all();
+  const attachmentRows = db.select({ sizeBytes: attachments.sizeBytes }).from(attachments).where(and(orgPredicate(attachments.orgId, orgId), eq(attachments.issueId, issueId))).all();
+  db.delete(issueLabels).where(and(orgPredicate(issueLabels.orgId, orgId), eq(issueLabels.issueId, issueId))).run();
+  db.delete(comments).where(and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId))).run();
+  db.delete(attachments).where(and(orgPredicate(attachments.orgId, orgId), eq(attachments.issueId, issueId))).run();
+  db.delete(issues).where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId))).run();
+  return { commentIds: commentRows.map((row) => row.id), attachmentSizes: attachmentRows.map((row) => row.sizeBytes) };
+}

+export async function restoreIssue(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<Issue> {
+  assertOrgScope(actor, orgId);
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  assertCan(actor, "issue:archive", issueResource(issue));
+  if (!isArchived(issue)) throw new RestoreRefusedError("not_archived");
+
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  const retentionMs = getPlanLimits(org.plan).retentionDays * 24 * 60 * 60 * 1000;
+  if (issue.archivedAt === null || Date.now() - Date.parse(issue.archivedAt) >= retentionMs) {
+    throw new RestoreRefusedError("expired");
+  }
+  const project = requireFound(await projectRepo.findProjectById(orgId, issue.projectId), "Project", issue.projectId);
+  if (isArchived(project)) throw new RestoreRefusedError("project_archived");
+  const used = await issueRepo.countIssues(orgId, issue.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used)) throw new RestoreRefusedError("quota");
+
+  const restored = await issueRepo.restoreIssue(orgId, issueId);
+  await emit("issue.restored", { ...actorEnvelope(actor), issueId: restored.id, projectId: restored.projectId });
+  return restored;
 }
 

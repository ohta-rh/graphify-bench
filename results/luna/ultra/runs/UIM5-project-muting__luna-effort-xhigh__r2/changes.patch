+/** Per-user project mute state. */
+import { and, asc, eq } from "drizzle-orm";
+import { getDb, projectMutes } from "@/server/db";
+import { brandId } from "./_mappers";
+import { orgPredicate } from "./base-repository";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+
+export async function muteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .insert(projectMutes)
+    .values({ orgId, userId, projectId })
+    .onConflictDoNothing({
+      target: [projectMutes.orgId, projectMutes.userId, projectMutes.projectId],
+    })
+    .run();
+}
+
+export async function unmuteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .delete(projectMutes)
+    .where(
+      and(
+        orgPredicate(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+        eq(projectMutes.projectId, projectId),
+      ),
+    )
+    .run();
+}
+
+export async function listMutedProjectIds(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ProjectId[]> {
+  const rows = getDb()
+    .select({ projectId: projectMutes.projectId })
+    .from(projectMutes)
+    .where(
+      and(
+        orgPredicate(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+      ),
+    )
+    .orderBy(asc(projectMutes.projectId))
+    .all();
+
+  return rows.map((row) => brandId<ProjectId>(row.projectId));
+}

+/** Replace one tenant's index atomically so readers never see a partial rebuild. */
+export async function rebuildSearchDocuments(
+  orgId: OrgId,
+  documents: readonly { subjectKind: SearchSubjectKind; subjectId: string; projectId: ProjectId | null; content: string }[],
+): Promise<void> {
+  const db = getDb();
+  db.transaction((tx) => {
+    tx.delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();
+    for (let offset = 0; offset < documents.length; offset += 200) {
+      const batch = documents.slice(offset, offset + 200);
+      tx.insert(searchIndex).values(batch.map((document) => ({
+        id: newId(), orgId, ...document, indexedAt: toIsoTimestamp(new Date()),
+      }))).run();
+    }
+  });
+}
+
+export async function deleteProjectDocuments(orgId: OrgId, projectId: ProjectId): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex).where(and(orgPredicate(searchIndex.orgId, orgId), eq(searchIndex.projectId, projectId))).run();
+}
+

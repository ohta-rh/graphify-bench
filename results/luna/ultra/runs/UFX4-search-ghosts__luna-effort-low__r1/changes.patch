+  if (!project) return;
+  const liveIssues = db.select().from(issues).where(and(orgPredicate(issues.orgId, orgId), eq(issues.projectId, projectId), isNull(issues.archivedAt))).all();
+  const stamp = toIsoTimestamp(new Date());
+  const projectDoc = db.select({ id: searchIndex.id }).from(searchIndex).where(and(orgPredicate(searchIndex.orgId, orgId), eq(searchIndex.subjectKind, "project"), eq(searchIndex.subjectId, projectId))).get();
+  if (projectDoc) db.update(searchIndex).set({ content: [project.name, project.description ?? ""].join("\n"), projectId, indexedAt: stamp }).where(eq(searchIndex.id, projectDoc.id)).run();
+  else db.insert(searchIndex).values({ id: newId(), orgId, subjectKind: "project", subjectId: projectId, projectId, content: [project.name, project.description ?? ""].join("\n"), indexedAt: stamp }).run();
+  for (const issue of liveIssues) {
+    const issueDoc = db.select({ id: searchIndex.id }).from(searchIndex).where(and(orgPredicate(searchIndex.orgId, orgId), eq(searchIndex.subjectKind, "issue"), eq(searchIndex.subjectId, issue.id))).get();
+    if (issueDoc) db.update(searchIndex).set({ projectId, content: [issue.title, issue.description ?? ""].join("\n"), indexedAt: stamp }).where(eq(searchIndex.id, issueDoc.id)).run();
+    else db.insert(searchIndex).values({ id: newId(), orgId, subjectKind: "issue", subjectId: issue.id, projectId, content: [issue.title, issue.description ?? ""].join("\n"), indexedAt: stamp }).run();
+    const liveComments = db.select().from(comments).where(and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issue.id), isNull(comments.archivedAt))).all();

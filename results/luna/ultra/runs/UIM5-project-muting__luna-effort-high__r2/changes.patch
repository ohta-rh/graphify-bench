@@ -0,0 +1,44 @@
+import { and, eq } from "drizzle-orm";
+import { getDb, projectMutes } from "@/server/db";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+
+export async function muteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .insert(projectMutes)
+    .values({ orgId, userId, projectId })
+    .onConflictDoNothing()
+    .run();
+}
+
+export async function unmuteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .delete(projectMutes)
+    .where(
+      and(
+        eq(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+        eq(projectMutes.projectId, projectId),
+      ),
+    )
+    .run();
+}
+
+export async function listMutedProjectIds(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ProjectId[]> {
+  const rows = getDb()
+    .select({ projectId: projectMutes.projectId })
+    .from(projectMutes)
+    .where(and(eq(projectMutes.orgId, orgId), eq(projectMutes.userId, userId)))
+    .all();
+  return rows.map((row) => row.projectId as ProjectId);
+}

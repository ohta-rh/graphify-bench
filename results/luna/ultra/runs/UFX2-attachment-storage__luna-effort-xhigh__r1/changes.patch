 /**
+ * Storage is charged per file, so rounding must happen before the total is
+ * summed. The tenant predicate keeps another workspace's files out of the
+ * result.
+ */
+export async function getStorageMbUsed(orgId: OrgId): Promise<number> {
+  const row = getDb()
+    .select({
+      value: sql<number | null>`sum((${attachments.sizeBytes} + ${BYTES_PER_MB - 1}) / ${BYTES_PER_MB})`,
+    })
+    .from(attachments)
+    .where(orgPredicate(attachments.orgId, orgId))
+    .get();
+
+  return row?.value ?? 0;
+}

+/** Remove every indexed comment belonging to one issue in one workspace. */
+export async function deleteCommentDocumentsForIssue(
+  orgId: OrgId,
+  issueId: string,
+): Promise<void> {
+  const db = getDb();
+  db.delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        inArray(
+          searchIndex.subjectId,
+          db
+            .select({ id: comments.id })
+            .from(comments)
+            .where(
+              and(
+                orgPredicate(comments.orgId, orgId),
+                eq(comments.issueId, issueId),
+              ),
+            ),
+        ),
+      ),
+    )
+    .run();
+}
+
+/** Start a rebuild from an empty tenant index so stale rows cannot survive. */
+export async function clearSearchDocuments(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();
 }
 

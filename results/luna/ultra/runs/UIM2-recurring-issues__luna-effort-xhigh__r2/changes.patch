+import { z } from "zod";
+import { issuePrioritySchema } from "./issue";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+
+function isKnownTimeZone(timezone: string): boolean {
+  // Intl also accepts numeric UTC offsets in newer runtimes; those are not
+  // IANA zone identifiers, so keep the schema limited to named time zones.
+  if (/^[+-]\d{2}/.test(timezone)) return false;
+
+  try {
+    new Intl.DateTimeFormat("en", { timeZone: timezone });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function isCalendarDate(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+
+  const [year, month, day] = value.split("-").map(Number);
+  if (year < 1 || month < 1 || month > 12 || day < 1) return false;
+
+  const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
+  const daysInMonth = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+  return day <= daysInMonth[month - 1];
+}
+
+export const createRecurringIssueSchema = z
+  .object({
+    orgId: orgIdSchema,
+    projectId: projectIdSchema,
+    title: z.string().min(3, "give the issue a title").max(180),
+    priority: issuePrioritySchema.default("none"),
+    assigneeId: userIdSchema.nullable().default(null),
+    cadence: z.enum(["daily", "weekly"]),
+    weekday: z.number().int().min(1).max(7).nullable().default(null),
+    timezone: z.string().refine(isKnownTimeZone, "must be a known IANA time zone"),
+    startsOn: z.string().refine(isCalendarDate, "must be a real YYYY-MM-DD date"),
+  })
+  .superRefine((value, context) => {
+    if (value.cadence === "weekly" && value.weekday === null) {
+      context.addIssue({
+        code: "custom",
+        path: ["weekday"],
+        message: "weekly recurrence requires a weekday",
+      });
+    }
+    if (value.cadence === "daily" && value.weekday !== null) {
+      context.addIssue({
+        code: "custom",
+        path: ["weekday"],
+        message: "daily recurrence cannot have a weekday",
+      });
+    }
+  });
+
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;

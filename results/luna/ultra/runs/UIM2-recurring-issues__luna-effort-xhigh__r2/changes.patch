@@ -0,0 +1,163 @@
+/** Turns each due recurring rule into at most one ordinary issue. */
+import { can, PermissionDeniedError } from "@/lib/permissions";
+import { createLogger } from "@/lib/logger";
+import { AlreadyArchivedError, isArchived } from "@/lib/soft-delete";
+import * as issueService from "@/server/services/issue-service";
+import * as memberService from "@/server/services/member-service";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringIssueRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource } from "@/server/services/_support";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+import type { RecurringIssue } from "@/types/recurring-issue";
+
+const logger = createLogger("recurring-issue-job");
+
+/** Runs the latest started occurrence for each live rule, without backfilling. */
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    const rules = await recurringIssueRepo.listActiveRecurringIssues();
+
+    for (const rule of rules) {
+      try {
+        const occurrenceOn = latestStartedOccurrence(rule, now);
+        if (
+          occurrenceOn === null ||
+          (rule.lastOccurrenceOn !== null &&
+            occurrenceOn <= rule.lastOccurrenceOn)
+        ) {
+          continue;
+        }
+
+        const project = await projectRepo.findProjectById(
+          rule.orgId,
+          rule.projectId,
+        );
+        if (project === null) {
+          throw new Error(`Project ${rule.projectId} was not found`);
+        }
+        if (isArchived(project)) continue;
+
+        const actor = await memberService.resolveActor(rule.createdBy, rule.orgId);
+        if (actor === null) {
+          await recurringIssueRepo.setRecurringIssuePaused(
+            rule.orgId,
+            rule.id,
+            true,
+          );
+          continue;
+        }
+
+        if (!can(actor, "issue:create", projectResource(project))) {
+          await recurringIssueRepo.setRecurringIssuePaused(
+            rule.orgId,
+            rule.id,
+            true,
+          );
+          continue;
+        }
+
+        let assigneeId = rule.assigneeId;
+        if (assigneeId !== null) {
+          const member = await memberRepo.findMember(rule.orgId, assigneeId);
+          if (member === null || member.status !== "active") {
+            assigneeId = null;
+          }
+        }
+
+        try {
+          const issue = await issueService.createIssue(actor, {
+            orgId: rule.orgId,
+            projectId: rule.projectId,
+            title: `${rule.title} (${occurrenceOn})`,
+            description: null,
+            status: "backlog",
+            priority: rule.priority,
+            assigneeId,
+            parentId: null,
+            estimate: null,
+            dueAt: null,
+            labelIds: [],
+          });
+          result.processed += 1;
+          await recurringIssueRepo.setRecurringIssueLastOccurrenceOn(
+            rule.orgId,
+            rule.id,
+            occurrenceOn,
+          );
+          logger.debug("recurring issue created", {
+            recurringIssueId: rule.id,
+            issueId: issue.id,
+            occurrenceOn,
+          });
+        } catch (error) {
+          if (error instanceof AlreadyArchivedError) continue;
+          if (
+            error instanceof PermissionDeniedError &&
+            error.action === "issue:create"
+          ) {
+            await recurringIssueRepo.setRecurringIssuePaused(
+              rule.orgId,
+              rule.id,
+              true,
+            );
+            continue;
+          }
+          throw error;
+        }
+      } catch (error) {
+        result.failed += 1;
+        logger.error("recurring issue rule failed", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  });
+}
+
+function latestStartedOccurrence(
+  rule: RecurringIssue,
+  now: Date,
+): string | null {
+  const localToday = calendarDateInZone(now, rule.timezone);
+  if (localToday < rule.startsOn) return null;
+  if (rule.cadence === "daily") return localToday;
+
+  // Today in the rule's zone has started once Intl reports its local date.
+  // Walk back by at most six calendar days to the latest requested ISO weekday.
+  const daysBack =
+    (isoWeekday(localToday) - (rule.weekday as number) + 7) % 7;
+  const latest = shiftCalendarDate(localToday, -daysBack);
+  return latest < rule.startsOn ? null : latest;
+}
+
+function calendarDateInZone(now: Date, timezone: string): string {
+  const parts = new Intl.DateTimeFormat("en", {
+    timeZone: timezone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: "year" | "month" | "day") =>
+    parts.find((value) => value.type === type)?.value ?? "";
+  return `${part("year").padStart(4, "0")}-${part("month")}-${part("day")}`;
+}
+
+function isoWeekday(date: string): number {
+  const [year, month, day] = date.split("-").map(Number);
+  const value = new Date(0);
+  value.setUTCFullYear(year, month - 1, day);
+  return ((value.getUTCDay() + 6) % 7) + 1;
+}
+
+function shiftCalendarDate(date: string, days: number): string {
+  const [year, month, day] = date.split("-").map(Number);
+  const value = new Date(0);
+  value.setUTCFullYear(year, month - 1, day + days);
+  const shiftedYear = String(value.getUTCFullYear()).padStart(4, "0");
+  const shiftedMonth = String(value.getUTCMonth() + 1).padStart(2, "0");
+  const shiftedDay = String(value.getUTCDate()).padStart(2, "0");
+  return `${shiftedYear}-${shiftedMonth}-${shiftedDay}`;
+}

+/** Recurring issue rules, always scoped by organization on scoped reads/writes. */
+import { and, asc, count, eq } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { toRecurringIssue } from "./_mappers";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+import type { RecurringIssue, RecurrenceCadence } from "@/types/recurring-issue";
+import type { IssuePriority } from "@/types/issue";
+
+interface NewRecurringIssue {
+  readonly orgId: OrgId;
+  readonly projectId: ProjectId;
+  readonly title: string;
+  readonly priority: IssuePriority;
+  readonly assigneeId: UserId | null;
+  readonly cadence: RecurrenceCadence;
+  readonly weekday: number | null;
+  readonly timezone: string;
+  readonly startsOn: string;
+}
+
+export async function findRecurringIssueById(
+  orgId: OrgId,
+  recurringIssueId: string,
+): Promise<RecurringIssue | null> {
+  const row = getDb()
+    .select()
+    .from(recurringIssues)
+    .where(
+      and(
+        orgPredicate(recurringIssues.orgId, orgId),
+        eq(recurringIssues.id, recurringIssueId),
+      ),
+    )
+    .get();
+  return row ? toRecurringIssue(row) : null;
+}
+
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  const row = getDb()
+    .select({ value: count() })
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .get();
+  return row?.value ?? 0;
+}
+
+export async function listRecurringIssues(
+  orgId: OrgId,
+): Promise<readonly RecurringIssue[]> {
+  const rows = getDb()
+    .select()
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all();
+  return rows.map(toRecurringIssue);
+}
+
+export async function listActiveRecurringIssues(): Promise<readonly RecurringIssue[]> {
+  const rows = getDb()
+    .select()
+    .from(recurringIssues)
+    .where(eq(recurringIssues.paused, false))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all();
+  return rows.map(toRecurringIssue);
+}
+
+export async function insertRecurringIssue(
+  input: NewRecurringIssue,
+  createdBy: UserId,
+): Promise<RecurringIssue> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(recurringIssues)
+    .values({
+      id: newId(),
+      ...input,
+      lastOccurrenceOn: null,
+      paused: false,
+      createdBy,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .returning()
+    .get();
+  return toRecurringIssue(row);
+}
+
+export async function setRecurringIssuePaused(
+  orgId: OrgId,
+  recurringIssueId: string,
+  paused: boolean,
+): Promise<RecurringIssue> {
+  const row = getDb()
+    .update(recurringIssues)
+    .set({ paused, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        orgPredicate(recurringIssues.orgId, orgId),
+        eq(recurringIssues.id, recurringIssueId),
+      ),
+    )
+    .returning()
+    .get();
+  if (!row) throw new Error(`Recurring issue ${recurringIssueId} not found`);
+  return toRecurringIssue(row);
+}
+
+export async function setRecurringIssueLastOccurrenceOn(
+  orgId: OrgId,
+  recurringIssueId: string,
+  occurrenceOn: string,
+): Promise<RecurringIssue> {
+  const row = getDb()
+    .update(recurringIssues)
+    .set({ lastOccurrenceOn: occurrenceOn, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        orgPredicate(recurringIssues.orgId, orgId),
+        eq(recurringIssues.id, recurringIssueId),
+      ),
+    )
+    .returning()
+    .get();
+  if (!row) throw new Error(`Recurring issue ${recurringIssueId} not found`);
+  return toRecurringIssue(row);
+}

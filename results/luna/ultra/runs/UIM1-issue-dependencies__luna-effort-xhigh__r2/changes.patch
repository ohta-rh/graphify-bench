@@ -0,0 +1,174 @@
+/** Tenant-scoped persistence for "blocked by" issue links. */
+import {
+  and,
+  asc,
+  eq,
+  inArray,
+  isNull,
+  notInArray,
+} from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueDependency, Issue } from "@/types/issue";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import { brandId, toIssue, toIssueDependency } from "./_mappers";
+import { orgPredicate } from "./base-repository";
+
+export async function findDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<IssueDependency | null> {
+  const row = getDb()
+    .select()
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .get();
+  return row ? toIssueDependency(row) : null;
+}
+
+/** Inserts once; a racing duplicate resolves to the original row. */
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  const row = getDb()
+    .insert(issueDependencies)
+    .values({
+      orgId,
+      issueId,
+      blockerId,
+      createdBy,
+      createdAt: toIsoTimestamp(new Date()),
+    })
+    .onConflictDoNothing()
+    .returning()
+    .get();
+
+  if (row) return toIssueDependency(row);
+
+  const existing = await findDependency(orgId, issueId, blockerId);
+  if (existing === null) {
+    throw new Error("Issue dependency insert produced no row");
+  }
+  return existing;
+}
+
+export async function removeDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const rows = getDb()
+    .delete(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .returning({ issueId: issueDependencies.issueId })
+    .all();
+  return rows.length > 0;
+}
+
+export async function listBlockers(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ issue: issues })
+    .from(issueDependencies)
+    .innerJoin(
+      issues,
+      and(
+        eq(issues.id, issueDependencies.blockerId),
+        eq(issues.orgId, issueDependencies.orgId),
+      ),
+    )
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        isNull(issues.archivedAt),
+      ),
+    )
+    .orderBy(asc(issues.number))
+    .all();
+
+  return rows.map(({ issue }) => toIssue(issue));
+}
+
+/** All direct blocker edges, including links to closed or archived issues. */
+export async function listBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  const rows = getDb()
+    .select({ blockerId: issueDependencies.blockerId })
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+      ),
+    )
+    .all();
+  return rows.map((row) => brandId<IssueId>(row.blockerId));
+}
+
+/** Open blockers are live and have a non-terminal status. */
+export async function listOpenBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  const rows = getDb()
+    .select({ blockerId: issueDependencies.blockerId })
+    .from(issueDependencies)
+    .innerJoin(
+      issues,
+      and(
+        eq(issues.id, issueDependencies.blockerId),
+        eq(issues.orgId, issueDependencies.orgId),
+      ),
+    )
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        isNull(issues.archivedAt),
+        notInArray(issues.status, ["done", "canceled"]),
+      ),
+    )
+    .all();
+  return rows.map((row) => brandId<IssueId>(row.blockerId));
+}
+
+/** Direct dependents of one or more blockers; ids are deduplicated. */
+export async function listBlockedIssueIds(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+): Promise<readonly IssueId[]> {
+  if (blockerIds.length === 0) return [];
+
+  const rows = getDb()
+    .selectDistinct({ issueId: issueDependencies.issueId })
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        inArray(issueDependencies.blockerId, [...blockerIds]),
+      ),
+    )
+    .all();
+  return rows.map((row) => brandId<IssueId>(row.issueId));
+}

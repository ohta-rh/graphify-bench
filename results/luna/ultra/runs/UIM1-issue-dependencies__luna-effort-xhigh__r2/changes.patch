@@ -0,0 +1,121 @@
+/** Business rules for issue blocker links and completion gating. */
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as issueDependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import type { IssueId, OrgId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import type { Actor } from "@/types/member";
+import { issueResource, requireFound } from "./_support";
+
+export class IssueBlockedError extends Error {
+  readonly code = "conflict" as const;
+  readonly blockerIds: readonly IssueId[];
+
+  constructor(blockerIds: readonly IssueId[]) {
+    super(`Issue is blocked by ${blockerIds.length} open issue(s).`);
+    this.name = "IssueBlockedError";
+    this.blockerIds = [...blockerIds];
+  }
+}
+
+export async function addBlocker(
+  actor: Actor,
+  input: { orgId: OrgId; issueId: IssueId; blockerId: IssueId },
+): Promise<IssueDependency> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  const blocker = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.blockerId),
+    "Issue",
+    input.blockerId,
+  );
+
+  assertCan(actor, "issue:update", issueResource(issue));
+  assertNotArchived("Issue", issue.id, issue);
+  assertNotArchived("Issue", blocker.id, blocker);
+
+  if (input.issueId === input.blockerId) {
+    throw new Error("An issue cannot block itself");
+  }
+
+  const existing = await issueDependencyRepo.findDependency(
+    input.orgId,
+    input.issueId,
+    input.blockerId,
+  );
+  if (existing !== null) return existing;
+
+  if (await createsCycle(input.orgId, input.issueId, input.blockerId)) {
+    throw new Error("Issue dependency would create a cycle");
+  }
+
+  return issueDependencyRepo.insertDependency(
+    input.orgId,
+    input.issueId,
+    input.blockerId,
+    actor.userId,
+  );
+}
+
+export async function removeBlocker(
+  actor: Actor,
+  input: { orgId: OrgId; issueId: IssueId; blockerId: IssueId },
+): Promise<boolean> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  assertCan(actor, "issue:update", issueResource(issue));
+
+  return issueDependencyRepo.removeDependency(
+    input.orgId,
+    input.issueId,
+    input.blockerId,
+  );
+}
+
+export async function listBlockers(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "issue:read", issueResource(issue));
+
+  return issueDependencyRepo.listBlockers(orgId, issueId);
+}
+
+async function createsCycle(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const pending = [blockerId];
+  const visited = new Set<IssueId>();
+
+  while (pending.length > 0) {
+    const current = pending.pop();
+    if (current === undefined || visited.has(current)) continue;
+    if (current === issueId) return true;
+    visited.add(current);
+    pending.push(...(await issueDependencyRepo.listBlockerIds(orgId, current)));
+  }
+
+  return false;
+}

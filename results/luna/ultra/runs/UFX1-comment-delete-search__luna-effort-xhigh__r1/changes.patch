+
+/** Removes every comment document attached to one issue in this org. */
+export async function deleteCommentDocumentsForIssue(
+  orgId: OrgId,
+  issueId: string,
+): Promise<void> {
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        inArray(
+          searchIndex.subjectId,
+          getDb()
+            .select({ id: comments.id })
+            .from(comments)
+            .where(
+              and(
+                orgPredicate(comments.orgId, orgId),
+                eq(comments.issueId, issueId),
+              ),
+            ),
+        ),
+      ),
+    )
+    .run();
+}
+
+/** Drops stale documents while preserving only live source rows for this org. */
+export async function pruneStaleSearchDocuments(orgId: OrgId): Promise<void> {
+  const liveProject = getDb()
+    .select({ id: projects.id })
+    .from(projects)
+    .where(
+      and(
+        ...compact(
+          eq(projects.orgId, searchIndex.orgId),
+          eq(projects.id, searchIndex.subjectId),
+          livePredicate(projects.archivedAt, {}),
+        ),
+      ),
+    );
+
+  const liveIssue = getDb()
+    .select({ id: issues.id })
+    .from(issues)
+    .where(
+      and(
+        ...compact(
+          eq(issues.orgId, searchIndex.orgId),
+          eq(issues.id, searchIndex.subjectId),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    );
+
+  const liveComment = getDb()
+    .select({ id: comments.id })
+    .from(comments)
+    .innerJoin(issues, eq(issues.id, comments.issueId))
+    .where(
+      and(
+        ...compact(
+          eq(comments.orgId, searchIndex.orgId),
+          eq(comments.id, searchIndex.subjectId),
+          livePredicate(comments.archivedAt, {}),
+          eq(issues.orgId, comments.orgId),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    );
+
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "project"),
+        notExists(liveProject),
+      ),
+    )
+    .run();
+
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "issue"),
+        notExists(liveIssue),
+      ),
+    )
+    .run();
+
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        notExists(liveComment),
       ),
     )
     .run();

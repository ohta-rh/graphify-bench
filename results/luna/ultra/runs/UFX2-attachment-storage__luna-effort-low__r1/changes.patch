+
+/** Sum each attachment's individually rounded-up megabyte charge. */
+export async function sumStorageMegabytes(orgId: OrgId): Promise<number> {
+  const rows = getDb()
+    .select({ sizeBytes: attachments.sizeBytes })
+    .from(attachments)
+    .where(orgPredicate(attachments.orgId, orgId))
+    .all();
+  return rows.reduce(
+    (total, row) => total + Math.ceil(row.sizeBytes / (1024 * 1024)),
+    0,
+  );
 }

+/**
+ * Returns a keyset page of workspaces that have not been deleted. Background
+ * jobs use this list so their coverage does not depend on usage rows or a
+ * fixed first-page limit.
+ */
+export async function listActiveOrgIds(
+  limit: number,
+  after?: OrgId,
+): Promise<readonly OrgId[]> {
+  const rows = getDb()
+    .select({ id: organizations.id })
+    .from(organizations)
+    .where(
+      after === undefined
+        ? isNull(organizations.archivedAt)
+        : and(
+            isNull(organizations.archivedAt),
+            gt(organizations.id, after),
+          ),
+    )
+    .orderBy(asc(organizations.id))
+    .limit(Math.max(1, limit))
+    .all();
+
+  return rows.map((row) => brandId<OrgId>(row.id));
 }
 

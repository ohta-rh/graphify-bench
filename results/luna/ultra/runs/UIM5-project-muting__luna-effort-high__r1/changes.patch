@@ -0,0 +1,76 @@
+/** Personal project notification mute rows. */
+import { and, eq } from "drizzle-orm";
+import { getDb, projectNotificationMutes } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import type { OrgId, ProjectId, UserId } from "@/types/common";
+
+export async function muteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .insert(projectNotificationMutes)
+    .values({
+      orgId,
+      userId,
+      projectId,
+      mutedAt: toIsoTimestamp(new Date()),
+    })
+    .onConflictDoNothing()
+    .run();
+}
+
+export async function unmuteProject(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .delete(projectNotificationMutes)
+    .where(
+      and(
+        orgPredicate(projectNotificationMutes.orgId, orgId),
+        eq(projectNotificationMutes.userId, userId),
+        eq(projectNotificationMutes.projectId, projectId),
+      ),
+    )
+    .run();
+}
+
+export async function listMutedProjectIds(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ProjectId[]> {
+  const rows = getDb()
+    .select({ projectId: projectNotificationMutes.projectId })
+    .from(projectNotificationMutes)
+    .where(
+      and(
+        orgPredicate(projectNotificationMutes.orgId, orgId),
+        eq(projectNotificationMutes.userId, userId),
+      ),
+    )
+    .all();
+  return rows.map((row) => row.projectId as ProjectId);
+}
+
+export async function isProjectMuted(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<boolean> {
+  const row = getDb()
+    .select({ projectId: projectNotificationMutes.projectId })
+    .from(projectNotificationMutes)
+    .where(
+      and(
+        orgPredicate(projectNotificationMutes.orgId, orgId),
+        eq(projectNotificationMutes.userId, userId),
+        eq(projectNotificationMutes.projectId, projectId),
+      ),
+    )
+    .get();
+  return row !== undefined;
+}

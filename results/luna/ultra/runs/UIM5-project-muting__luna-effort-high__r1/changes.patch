+
+async function requireReadableProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+) {
+  assertOrgScope(actor, orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId),
+    "Project",
+    projectId,
+  );
+  assertCan(actor, "project:read", projectResource(project));
+  return project;
+}
+
+export async function muteProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<void> {
+  await requireReadableProject(actor, orgId, projectId);
+  await projectMuteRepo.muteProject(orgId, actor.userId, projectId);
+}
+
+export async function unmuteProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<void> {
+  await requireReadableProject(actor, orgId, projectId);
+  await projectMuteRepo.unmuteProject(orgId, actor.userId, projectId);
+}
+
+export async function listMutedProjectIds(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<readonly ProjectId[]> {
+  assertOrgScope(actor, orgId);

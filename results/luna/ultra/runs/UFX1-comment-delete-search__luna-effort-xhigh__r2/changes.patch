+/** Removes every comment document belonging to one issue in one org. */
+export async function deleteCommentDocumentsForIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<void> {
+  const db = getDb();
+  const issueCommentIds = db
+    .select({ id: comments.id })
+    .from(comments)
+    .where(
+      and(
+        orgPredicate(comments.orgId, orgId),
+        eq(comments.issueId, issueId),
+      ),
+    );
+
+  db.delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        inArray(searchIndex.subjectId, issueCommentIds),
+      ),
+    )
+    .run();
+}
+
+/** Clears only this org's index before a complete rebuild. */
+export async function deleteSearchDocumentsForOrg(orgId: OrgId): Promise<void> {
+  getDb()
+    .delete(searchIndex)
+    .where(orgPredicate(searchIndex.orgId, orgId))
     .run();
 }
 

+/** Remove indexed comments belonging to one issue in this tenant. */
+export async function deleteSearchDocumentsForIssue(
+  orgId: OrgId,
+  issueId: string,
+): Promise<void> {
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, "comment"),
+        inArray(
+          searchIndex.subjectId,
+          getDb()
+            .select({ id: comments.id })
+            .from(comments)
+            .where(
+              and(
+                orgPredicate(comments.orgId, orgId),
+                eq(comments.issueId, issueId),
+              ),
+            ),
+        ),
+      ),
+    )
+    .run();
+}
+
+/** Clear one tenant's documents before a complete, idempotent rebuild. */
+export async function clearSearchDocuments(orgId: OrgId): Promise<void> {
+  getDb()
+    .delete(searchIndex)
+    .where(orgPredicate(searchIndex.orgId, orgId))
     .run();
 }
 

+/** Lists every archived issue at or before a tenant's retention cut-off. */
+export async function listExpiredIssues(
+  orgId: OrgId,
+  cutoff: IsoTimestamp,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(
+        orgPredicate(issues.orgId, orgId),
+        isNotNull(issues.archivedAt),
+        lte(issues.archivedAt, cutoff),
+      ),
+    )
+    .all();
+  return rows.map((row) => toIssue(row));
+}
+
+/**
+ * Permanently removes an issue and its dependent records. The sequence
+ * high-water mark is written in the same transaction so its number survives.
+ */
+export async function purgeIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<{ commentIds: readonly string[]; storageMb: number }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const issue = tx
+      .select()
+      .from(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .get();
+    if (!issue || issue.archivedAt === null) {
+      return { commentIds: [], storageMb: 0 };
+    }
+
+    const linkedComments = tx
+      .select({ id: comments.id })
+      .from(comments)
+      .where(and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)))
+      .all();
+    const issueAttachments = tx
+      .select({ sizeBytes: attachments.sizeBytes })
+      .from(attachments)
+      .where(and(orgPredicate(attachments.orgId, orgId), eq(attachments.issueId, issueId)))
+      .all();
+    const storageMb = issueAttachments.reduce(
+      (total, attachment) => total + Math.ceil(attachment.sizeBytes / (1024 * 1024)),
+      0,
+    );
+
+    tx.insert(projectIssueSequences)
+      .values({ orgId, projectId: issue.projectId, lastNumber: issue.number })
+      .onConflictDoUpdate({
+        target: projectIssueSequences.projectId,
+        set: {
+          lastNumber: sql`max(${projectIssueSequences.lastNumber}, excluded.last_number)`,
+        },
+      })
+      .run();
+    tx.delete(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, orgId), eq(issueLabels.issueId, issueId)))
+      .run();
+    tx.delete(comments)
+      .where(and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)))
+      .run();
+    tx.delete(attachments)
+      .where(and(orgPredicate(attachments.orgId, orgId), eq(attachments.issueId, issueId)))
+      .run();
+    tx.delete(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .run();
+
+    return { commentIds: linkedComments.map((comment) => comment.id), storageMb };
+  });
 }
 

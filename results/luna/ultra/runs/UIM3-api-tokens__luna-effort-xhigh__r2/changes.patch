@@ -0,0 +1,187 @@
+/** Hashed API-token persistence. The secret hash never leaves this repository. */
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, apiTokens, members, organizations } from "@/server/db";
+import { toApiToken } from "./_mappers";
+import type { ApiTokenScope } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import type { ApiToken } from "@/types/api-token";
+
+export async function insertApiToken(input: {
+  orgId: OrgId;
+  userId: UserId;
+  name: string;
+  scope: ApiTokenScope;
+  tokenHash: string;
+  prefix: string;
+  expiresAt: IsoTimestamp;
+  createdAt: IsoTimestamp;
+}): Promise<ApiToken> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const existing = tx
+      .select({ value: count() })
+      .from(apiTokens)
+      .where(
+        and(
+          eq(apiTokens.orgId, input.orgId),
+          eq(apiTokens.userId, input.userId),
+          isNull(apiTokens.revokedAt),
+          gt(apiTokens.expiresAt, input.createdAt),
+        ),
+      )
+      .get();
+
+    if ((existing?.value ?? 0) >= 5) {
+      throw new Error("A user may hold at most 5 usable API tokens per organization");
+    }
+
+    const row = tx
+      .insert(apiTokens)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        userId: input.userId,
+        name: input.name,
+        scope: input.scope,
+        tokenHash: input.tokenHash,
+        prefix: input.prefix,
+        expiresAt: input.expiresAt,
+        lastUsedAt: null,
+        revokedAt: null,
+        createdAt: input.createdAt,
+      })
+      .returning()
+      .get();
+
+    return toApiToken(row);
+  });
+}
+
+export async function listApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  const rows = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id))
+    .all();
+  return rows.map(toApiToken);
+}
+
+export async function findApiTokenById(
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+export async function revokeApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  revokedAt: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; changed: boolean } | null> {
+  const db = getDb();
+  const updated = db
+    .update(apiTokens)
+    .set({ revokedAt })
+    .where(
+      and(
+        eq(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .get();
+  if (updated) return { apiToken: toApiToken(updated), changed: true };
+
+  const current = db
+    .select()
+    .from(apiTokens)
+    .where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return current ? { apiToken: toApiToken(current), changed: false } : null;
+}
+
+/** Revokes every unrevoked token, including expired ones, for a removed user. */
+export async function revokeTokensForMemberRemoval(
+  orgId: OrgId,
+  userId: UserId,
+  revokedAt: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  const rows = getDb()
+    .update(apiTokens)
+    .set({ revokedAt })
+    .where(
+      and(
+        eq(apiTokens.orgId, orgId),
+        eq(apiTokens.userId, userId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .all();
+  return rows.map(toApiToken);
+}
+
+export async function findUsableApiToken(
+  tokenHash: string,
+  now: IsoTimestamp,
+): Promise<{ apiToken: ApiToken; role: Role } | null> {
+  const row = getDb()
+    .select({ apiToken: apiTokens, role: members.role })
+    .from(apiTokens)
+    .innerJoin(
+      members,
+      and(
+        eq(members.orgId, apiTokens.orgId),
+        eq(members.userId, apiTokens.userId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      ),
+    )
+    .innerJoin(
+      organizations,
+      and(eq(organizations.id, apiTokens.orgId), isNull(organizations.archivedAt)),
+    )
+    .where(
+      and(
+        eq(apiTokens.tokenHash, tokenHash),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, now),
+      ),
+    )
+    .get();
+
+  return row ? { apiToken: toApiToken(row.apiToken), role: row.role } : null;
+}
+
+export async function touchApiToken(
+  orgId: OrgId,
+  tokenId: string,
+  now: IsoTimestamp,
+): Promise<boolean> {
+  const row = getDb()
+    .update(apiTokens)
+    .set({ lastUsedAt: now })
+    .where(
+      and(
+        eq(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, now),
+      ),
+    )
+    .returning({ id: apiTokens.id })
+    .get();
+  return row !== undefined;
+}

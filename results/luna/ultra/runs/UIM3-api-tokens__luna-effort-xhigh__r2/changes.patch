@@ -0,0 +1,154 @@
+/** Personal API tokens: the cleartext is returned once and only its digest is stored. */
+import { hashToken, randomToken } from "@/lib/hash";
+import { emit, subscribe } from "@/lib/event-bus";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import { toIsoTimestamp } from "@/types/common";
+import { hasRoleAtLeast } from "@/types/member";
+import { actorEnvelope, orgResource, requireFound } from "./_support";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Actor } from "@/types/member";
+import type { ApiToken } from "@/types/api-token";
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+const TOKEN_RANDOM_BYTES = 32;
+
+export async function createApiToken(
+  actor: Actor,
+  input: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+
+  if (parsed.scope === "write" && !hasRoleAtLeast(actor.role, "member")) {
+    assertCan(
+      { ...actor, isPlatformStaff: false },
+      "project:create",
+      orgResource(parsed.orgId),
+    );
+  }
+
+  const createdAt = toIsoTimestamp(new Date());
+  const expiresAt = toIsoTimestamp(
+    new Date(Date.parse(createdAt) + parsed.expiresInDays * MS_PER_DAY),
+  );
+  const token = `tfk_${randomToken(TOKEN_RANDOM_BYTES)}`;
+  const apiToken = await apiTokenRepo.insertApiToken({
+    orgId: parsed.orgId,
+    userId: actor.userId,
+    name: parsed.name,
+    scope: parsed.scope,
+    tokenHash: hashToken(token),
+    prefix: token.slice(0, 12),
+    expiresAt,
+    createdAt,
+  });
+
+  await emit("api_token.created", {
+    ...actorEnvelope(actor),
+    apiTokenId: apiToken.id,
+  });
+
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) {
+    assertCan(
+      { ...actor, isPlatformStaff: false },
+      "member:update_role",
+      orgResource(orgId),
+    );
+  }
+  return apiTokenRepo.listApiTokens(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const existing = requireFound(
+    await apiTokenRepo.findApiTokenById(orgId, tokenId),
+    "API token",
+    tokenId,
+  );
+
+  if (existing.userId !== actor.userId) {
+    assertCan(
+      { ...actor, isPlatformStaff: false },
+      "member:update_role",
+      orgResource(orgId),
+    );
+  }
+
+  const result = requireFound(
+    await apiTokenRepo.revokeApiToken(
+      orgId,
+      tokenId,
+      toIsoTimestamp(new Date()),
+    ),
+    "API token",
+    tokenId,
+  );
+
+  if (result.changed) {
+    await emit("api_token.revoked", {
+      ...actorEnvelope(actor),
+      apiTokenId: result.apiToken.id,
+    });
+  }
+  return result.apiToken;
+}
+
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const now = toIsoTimestamp(new Date());
+  const found = await apiTokenRepo.findUsableApiToken(hashToken(token), now);
+  if (!found) return null;
+
+  const touched = await apiTokenRepo.touchApiToken(
+    found.apiToken.orgId,
+    found.apiToken.id,
+    now,
+  );
+  if (!touched) return null;
+
+  return {
+    userId: found.apiToken.userId,
+    orgId: found.apiToken.orgId,
+    role: found.apiToken.scope === "read" ? "viewer" : found.role,
+  };
+}
+
+/** Revokes and audits every unrevoked token after a member removal event. */
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const revokedAt = toIsoTimestamp(new Date());
+    const tokens = await apiTokenRepo.revokeTokensForMemberRemoval(
+      payload.orgId,
+      payload.userId,
+      revokedAt,
+    );
+
+    await Promise.all(
+      tokens.map((apiToken) =>
+        emit("api_token.revoked", {
+          orgId: payload.orgId,
+          actorId: payload.actorId,
+          occurredAt: revokedAt,
+          apiTokenId: apiToken.id,
+        }),
+      ),
+    );
+  });
+}

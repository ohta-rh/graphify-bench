+/** Permanently removes an expired issue and all rows owned by it. */
+export async function purgeIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<{ commentIds: readonly string[]; storageMbReleased: number }> {
+  const db = getDb();
+  const issue = db
+    .select({ projectId: issues.projectId, number: issues.number })
+    .from(issues)
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+    .get();
+  const commentRows = db
+    .select({ id: comments.id })
+    .from(comments)
+    .where(
+      and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)),
+    )
+    .all();
+  const attachmentRows = db
+    .select({ sizeBytes: attachments.sizeBytes })
+    .from(attachments)
+    .where(
+      and(
+        orgPredicate(attachments.orgId, orgId),
+        eq(attachments.issueId, issueId),
+      ),
+    )
+    .all();
+
+  db.transaction((tx) => {
+    if (issue) {
+      tx.insert(issueNumberCounters)
+        .values({ orgId, projectId: issue.projectId, highestNumber: issue.number })
+        .onConflictDoUpdate({
+          target: issueNumberCounters.projectId,
+          set: {
+            highestNumber: sql`max(${issueNumberCounters.highestNumber}, excluded.highest_number)`,
+          },
+        })
+        .run();
+    }
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          eq(issueLabels.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(comments)
+      .where(
+        and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)),
+      )
+      .run();
+    tx.delete(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          eq(attachments.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .run();
+  });
+
+  return {
+    commentIds: commentRows.map((row) => row.id),
+    storageMbReleased: attachmentRows.reduce(
+      (total, row) => total + Math.ceil(row.sizeBytes / (1024 * 1024)),
+      0,
+    ),
+  };
 }
 

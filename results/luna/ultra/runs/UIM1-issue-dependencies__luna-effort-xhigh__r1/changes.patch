+/** Persistence and graph queries for issue dependency links. */
+import {
+  and,
+  asc,
+  eq,
+  isNull,
+  notInArray,
+} from "drizzle-orm";
+import { getDb, issueDependencies, issues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { brandId, brandStamp, toIssue } from "./_mappers";
+import { listLabelsForIssues } from "./label-repository";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+function toIssueDependency(
+  row: typeof issueDependencies.$inferSelect,
+): IssueDependency {
+  return {
+    orgId: brandId<OrgId>(row.orgId),
+    issueId: brandId<IssueId>(row.issueId),
+    blockerId: brandId<IssueId>(row.blockerId),
+    createdBy: brandId<UserId>(row.createdBy),
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+export async function addDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  return getDb().transaction((tx) => {
+    const whereLink = and(
+      orgPredicate(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      eq(issueDependencies.blockerId, blockerId),
+    );
+    const existing = tx
+      .select()
+      .from(issueDependencies)
+      .where(whereLink)
+      .get();
+    if (existing) return toIssueDependency(existing);
+
+    const rows = tx
+      .select({
+        issueId: issueDependencies.issueId,
+        blockerId: issueDependencies.blockerId,
+      })
+      .from(issueDependencies)
+      .where(orgPredicate(issueDependencies.orgId, orgId))
+      .all();
+    if (wouldCreateCycle(rows, issueId, blockerId)) {
+      throw new Error("Issue dependency would create a cycle");
+    }
+
+    const row = tx
+      .insert(issueDependencies)
+      .values({
+        orgId,
+        issueId,
+        blockerId,
+        createdBy,
+        createdAt: toIsoTimestamp(new Date()),
+      })
+      .returning()
+      .get();
+    return toIssueDependency(row);
+  });
+}
+
+/** Follows existing blocked-by links from `blockerId` to detect a cycle. */
+function wouldCreateCycle(
+  rows: readonly { issueId: string; blockerId: string }[],
+  issueId: IssueId,
+  blockerId: IssueId,
+): boolean {
+  const blockersByIssue = new Map<IssueId, IssueId[]>();
+  for (const row of rows) {
+    const dependentId = brandId<IssueId>(row.issueId);
+    const linkedBlockerId = brandId<IssueId>(row.blockerId);
+    const linked = blockersByIssue.get(dependentId) ?? [];
+    linked.push(linkedBlockerId);
+    blockersByIssue.set(dependentId, linked);
+  }
+
+  const visited = new Set<IssueId>();
+  const pending = [blockerId];
+  while (pending.length > 0) {
+    const current = pending.pop()!;
+    if (current === issueId) return true;
+    if (visited.has(current)) continue;
+    visited.add(current);
+    pending.push(...(blockersByIssue.get(current) ?? []));
+  }
+  return false;
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const deleted = getDb()
+    .delete(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .returning({ issueId: issueDependencies.issueId })
+    .get();
+  return deleted !== undefined;
+}
+
+/** Includes closed blockers but excludes archived blockers, ordered by issue number. */
+export async function listBlockers(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ blocker: issues })
+    .from(issueDependencies)
+    .innerJoin(
+      issues,
+      and(
+        eq(issues.id, issueDependencies.blockerId),
+        eq(issues.orgId, issueDependencies.orgId),
+      ),
+    )
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        isNull(issues.archivedAt),
+      ),
+    )
+    .orderBy(asc(issues.number))
+    .all();
+  const labels = await listLabelsForIssues(
+    orgId,
+    rows.map(({ blocker }) => brandId<IssueId>(blocker.id)),
+  );
+  return rows.map(({ blocker }) =>
+    toIssue(
+      blocker,
+      (labels[blocker.id] ?? []).map((label) => label.id),
+    ),
+  );
+}
+
+export async function listOpenBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  const rows = getDb()
+    .select({ blockerId: issueDependencies.blockerId })
+    .from(issueDependencies)
+    .innerJoin(
+      issues,
+      and(
+        eq(issues.id, issueDependencies.blockerId),
+        eq(issues.orgId, issueDependencies.orgId),
+      ),
+    )
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        isNull(issues.archivedAt),
+        notInArray(issues.status, ["done", "canceled"]),
+      ),
+    )
+    .all();
+  return rows.map(({ blockerId }) => brandId<IssueId>(blockerId));
+}
+
+/** All issues linked to this blocker, including archived or closed dependents. */
+export async function listDependents(
+  orgId: OrgId,
+  blockerId: IssueId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select({ dependent: issues })
+    .from(issueDependencies)
+    .innerJoin(
+      issues,
+      and(
+        eq(issues.id, issueDependencies.issueId),
+        eq(issues.orgId, issueDependencies.orgId),
+      ),
+    )
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .all();
+  return rows.map(({ dependent }) => toIssue(dependent));
+}

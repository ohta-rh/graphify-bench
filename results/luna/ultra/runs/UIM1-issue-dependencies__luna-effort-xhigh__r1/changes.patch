+
+  return () => {
+    for (const off of offs) off();
+  };
+}
+
+/** Dedupes dependents when one operation closes multiple blockers at once. */
+async function notifyUnblockedDependents(
+  orgId: OrgId,
+  blockerIds: readonly IssueId[],
+  actorId: UserId | null,
+): Promise<void> {
+  const dependentIds = new Set<IssueId>();
+  for (const blockerId of blockerIds) {
+    const dependents = await issueDependencyRepo.listDependents(
+      orgId,
+      blockerId,
+    );
+    for (const dependent of dependents) dependentIds.add(dependent.id);
+  }
+
+  for (const issueId of dependentIds) {
+    const issue = await issueRepo.findIssueById(orgId, issueId);
+    if (
+      !issue ||
+      issue.archivedAt !== null ||
+      issue.status === "done" ||
+      issue.status === "canceled" ||
+      issue.assigneeId === null
+    ) {
+      continue;
+    }
+
+    const openBlockerIds = await issueDependencyRepo.listOpenBlockerIds(
+      orgId,
+      issue.id,
+    );
+    if (openBlockerIds.length > 0) continue;
+
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Issue unblocked",
+      body: `Issue ${issue.id} has no open blockers remaining`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
 }

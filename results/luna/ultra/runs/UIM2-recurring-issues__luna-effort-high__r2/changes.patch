@@ -0,0 +1,109 @@
+import { assertCan, PermissionDeniedError } from "@/lib/permissions";
+import { createLogger } from "@/lib/logger";
+import { isArchived } from "@/lib/soft-delete";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringIssueRepo from "@/server/repositories/recurring-issue-repository";
+import { createIssue } from "@/server/services/issue-service";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import type { Actor } from "@/types/member";
+import { projectResource } from "@/server/services/_support";
+
+const logger = createLogger("recurring-issue-job");
+
+/** Creates at most the most recent started occurrence for each runnable rule. */
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    const rules = await recurringIssueRepo.listRunnableRecurringIssues();
+
+    for (const rule of rules) {
+      try {
+        await processRule(rule, now, result);
+      } catch (error) {
+        result.failed += 1;
+        logger.error("failed to process recurring issue", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  });
+}
+
+async function processRule(
+  rule: RecurringIssue,
+  now: Date,
+  result: JobResult,
+): Promise<void> {
+  const occurrence = latestStartedOccurrence(rule, now);
+  if (occurrence === null) return;
+  if (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn) return;
+
+  const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+  if (!project || isArchived(project)) return;
+
+  const member = await memberRepo.findMember(rule.orgId, rule.createdBy);
+  if (!member || member.status !== "active") {
+    await recurringIssueRepo.updateRecurringIssueState(rule.orgId, rule.id, { paused: true });
+    return;
+  }
+  const actor: Actor = { userId: rule.createdBy, orgId: rule.orgId, role: member.role };
+
+  try {
+    assertCan(actor, "issue:create", projectResource(project));
+  } catch (error) {
+    if (error instanceof PermissionDeniedError) {
+      await recurringIssueRepo.updateRecurringIssueState(rule.orgId, rule.id, { paused: true });
+      return;
+    }
+    throw error;
+  }
+
+  let assigneeId = rule.assigneeId;
+  if (assigneeId !== null) {
+    const assignee = await memberRepo.findMember(rule.orgId, assigneeId);
+    if (!assignee || assignee.status !== "active") assigneeId = null;
+  }
+
+  await createIssue(actor, {
+    orgId: rule.orgId,
+    projectId: rule.projectId,
+    title: `${rule.title} (${occurrence})`,
+    description: null,
+    status: "backlog",
+    priority: rule.priority,
+    assigneeId,
+    parentId: null,
+    estimate: null,
+    dueAt: null,
+    labelIds: [],
+  });
+
+  await recurringIssueRepo.updateRecurringIssueState(rule.orgId, rule.id, {
+    lastOccurrenceOn: occurrence,
+  });
+  result.processed += 1;
+}
+
+function latestStartedOccurrence(rule: RecurringIssue, now: Date): string | null {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: rule.timezone,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  const part = (type: string) => parts.find((value) => value.type === type)?.value;
+  const today = `${part("year")}-${part("month")}-${part("day")}`;
+  if (today < rule.startsOn) return null;
+  if (rule.cadence === "daily") return today;
+
+  const [year, month, day] = today.split("-").map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  const isoWeekday = date.getUTCDay() || 7;
+  const daysBack = (isoWeekday - (rule.weekday ?? isoWeekday) + 7) % 7;
+  date.setUTCDate(date.getUTCDate() - daysBack);
+  const latest = `${date.getUTCFullYear().toString().padStart(4, "0")}-${(date.getUTCMonth() + 1).toString().padStart(2, "0")}-${date.getUTCDate().toString().padStart(2, "0")}`;
+  return latest >= rule.startsOn ? latest : null;
+}

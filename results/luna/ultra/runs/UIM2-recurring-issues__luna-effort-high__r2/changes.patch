+import { and, asc, count, eq } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import type { OrgId, UserId } from "@/types/common";
+import type { RecurringIssue } from "@/types/recurring-issue";
+import type { z } from "zod";
+import { createRecurringIssueSchema } from "@/schemas/recurring-issue";
+import { orgPredicate } from "./base-repository";
+import { toRecurringIssue } from "./_mappers";
+
+export async function insertRecurringIssue(
+  input: z.output<typeof createRecurringIssueSchema>,
+  createdBy: UserId,
+): Promise<RecurringIssue> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(recurringIssues)
+    .values({
+      id: newId(),
+      orgId: input.orgId,
+      projectId: input.projectId,
+      title: input.title,
+      priority: input.priority,
+      assigneeId: input.assigneeId,
+      cadence: input.cadence,
+      weekday: input.weekday,
+      timezone: input.timezone,
+      startsOn: input.startsOn,
+      lastOccurrenceOn: null,
+      paused: false,
+      createdBy,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .returning()
+    .get();
+  return toRecurringIssue(row);
+}
+
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  return getDb()
+    .select({ value: count() })
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .get()?.value ?? 0;
+}
+
+export async function listRecurringIssues(orgId: OrgId): Promise<readonly RecurringIssue[]> {
+  return getDb()
+    .select()
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all()
+    .map(toRecurringIssue);
+}
+
+export async function listRunnableRecurringIssues(): Promise<readonly RecurringIssue[]> {
+  return getDb()
+    .select()
+    .from(recurringIssues)
+    .where(eq(recurringIssues.paused, false))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all()
+    .map(toRecurringIssue);
+}
+
+export async function findRecurringIssue(orgId: OrgId, id: string): Promise<RecurringIssue | null> {
+  const row = getDb()
+    .select()
+    .from(recurringIssues)
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id)))
+    .get();
+  return row ? toRecurringIssue(row) : null;
+}
+
+export async function updateRecurringIssueState(
+  orgId: OrgId,
+  id: string,
+  state: { paused?: boolean; lastOccurrenceOn?: string },
+): Promise<RecurringIssue> {
+  const row = getDb()
+    .update(recurringIssues)
+    .set({ ...state, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id)))
+    .returning()
+    .get();
+  if (!row) throw new Error(`Recurring issue ${id} not found`);
+  return toRecurringIssue(row);
+}

+/** Permanently deletes one expired issue and all rows/documents owned by it. */
+export async function purgeExpiredIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+  cutoff: IsoTimestamp,
+): Promise<PurgedIssue | null> {
+  return getDb().transaction((tx) => {
+    const issue = tx
+      .select({
+        id: issues.id,
+        projectId: issues.projectId,
+        number: issues.number,
+      })
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.id, issueId),
+          isNotNull(issues.archivedAt),
+          lte(issues.archivedAt, cutoff),
+        ),
+      )
+      .get();
+    if (!issue) return null;
+
+    const maxNumber = tx
+      .select({ value: sql<number | null>`max(${issues.number})` })
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.projectId, issue.projectId),
+        ),
+      )
+      .get()?.value ?? issue.number;
+
+    // Upgrade pre-sequence data before deleting its rows, retaining the
+    // greatest number the project has ever issued.
+    tx.insert(projectIssueSequences)
+      .values({
+        orgId,
+        projectId: issue.projectId,
+        lastNumber: maxNumber,
+      })
+      .onConflictDoUpdate({
+        target: projectIssueSequences.projectId,
+        set: {
+          lastNumber: sql`max(${projectIssueSequences.lastNumber}, excluded.last_number)`,
+        },
+      })
+      .run();
+
+    const commentIds = tx
+      .select({ id: comments.id })
+      .from(comments)
+      .where(
+        and(
+          orgPredicate(comments.orgId, orgId),
+          eq(comments.issueId, issueId),
+        ),
+      )
+      .all()
+      .map((row) => row.id as CommentId);
+    const attachmentRows = tx
+      .select({ sizeBytes: attachments.sizeBytes })
+      .from(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          eq(attachments.issueId, issueId),
+        ),
+      )
+      .all();
+
+    tx.delete(searchIndex)
+      .where(
+        and(
+          orgPredicate(searchIndex.orgId, orgId),
+          eq(searchIndex.subjectKind, "issue"),
+          eq(searchIndex.subjectId, issueId),
+        ),
+      )
+      .run();
+    if (commentIds.length > 0) {
+      tx.delete(searchIndex)
+        .where(
+          and(
+            orgPredicate(searchIndex.orgId, orgId),
+            eq(searchIndex.subjectKind, "comment"),
+            inArray(searchIndex.subjectId, [...commentIds]),
+          ),
+        )
+        .run();
+    }
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          eq(issueLabels.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(comments)
+      .where(
+        and(
+          orgPredicate(comments.orgId, orgId),
+          eq(comments.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          eq(attachments.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .run();
+
+    return {
+      commentIds,
+      storageMb: attachmentRows.reduce(
+        (total, attachment) =>
+          total + Math.ceil(attachment.sizeBytes / BYTES_PER_MB),
+        0,
+      ),
+    };
+  });
 }
 

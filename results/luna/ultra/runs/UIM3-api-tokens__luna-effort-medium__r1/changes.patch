@@ -0,0 +1,61 @@
+import { hashToken, randomToken } from "@/lib/hash";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { emit } from "@/lib/event-bus";
+import { subscribe } from "@/lib/event-bus";
+import * as tokenRepo from "@/server/repositories/api-token-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import { findOrgById } from "@/server/repositories/organization-repository";
+import { requireFound } from "./_support";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import { toIsoTimestamp } from "@/types/common";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { Unsubscribe } from "@/types/event";
+
+const MS_DAY = 86_400_000;
+export async function createApiToken(actor: Actor, input: CreateApiTokenInput): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  if (parsed.scope === "write") assertCan(actor, "project:create", { kind: "organization", orgId: parsed.orgId });
+  const now = new Date();
+  const stamp = toIsoTimestamp(now);
+  if (await tokenRepo.countUsable(parsed.orgId, actor.userId, stamp) >= 5) throw new Error("At most five usable API tokens are allowed");
+  const token = `tfk_${randomToken(32)}`;
+  const apiToken = await tokenRepo.create({ orgId: parsed.orgId, userId: actor.userId, name: parsed.name, scope: parsed.scope, tokenHash: hashToken(token), prefix: token.slice(0, 12), expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * MS_DAY)), createdAt: stamp });
+  await emit("api_token.created", { orgId: actor.orgId, actorId: actor.userId, occurredAt: stamp, tokenId: apiToken.id });
+  return { token, apiToken };
+}
+export async function listApiTokens(actor: Actor, orgId: OrgId, userId: UserId = actor.userId): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) assertCan(actor, "member:remove", { kind: "organization", orgId });
+  return tokenRepo.list(orgId, userId);
+}
+export async function revokeApiToken(actor: Actor, orgId: OrgId, tokenId: string): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const token = requireFound(await tokenRepo.findInOrg(orgId, tokenId), "API token", tokenId);
+  if (token.userId !== actor.userId) assertCan(actor, "member:remove", { kind: "organization", orgId });
+  if (token.revokedAt) return token;
+  const revoked = await tokenRepo.revoke(tokenId, toIsoTimestamp(new Date()));
+  await emit("api_token.revoked", { orgId, actorId: actor.userId, occurredAt: revoked.revokedAt!, tokenId });
+  return revoked;
+}
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const found = await tokenRepo.findByHash(hashToken(token));
+  if (!found || found.token.revokedAt !== null || found.token.expiresAt <= new Date().toISOString() || found.org?.archivedAt !== null || !found.member || found.member.archivedAt !== null || found.member.status !== "active") return null;
+  const role = found.token.scope === "read" ? "viewer" : found.member.role;
+  await tokenRepo.touch(found.token.id, toIsoTimestamp(new Date()));
+  return { userId: found.member.userId as UserId, orgId: found.token.orgId as OrgId, role };
+}
+
+export function registerApiTokenListeners(): Unsubscribe {
+  return subscribe("member.removed", async (payload) => {
+    const at = toIsoTimestamp(new Date());
+    const revoked = await tokenRepo.revokeActiveForMember(payload.orgId, payload.userId, at);
+    for (const token of revoked) {
+      await emit("api_token.revoked", { orgId: payload.orgId, actorId: payload.actorId, occurredAt: at, tokenId: token.id });
+    }
+  });
+}

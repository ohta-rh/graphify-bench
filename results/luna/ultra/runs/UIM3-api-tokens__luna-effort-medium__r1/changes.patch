@@ -0,0 +1,54 @@
+import { and, desc, eq, isNull, gt } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, apiTokens, members, organizations } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { brandId, brandStamp } from "./_mappers";
+import type { ApiTokenRow } from "@/server/db/schema/api-tokens";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+function map(row: ApiTokenRow): ApiToken {
+  return {
+    id: row.id, orgId: brandId<OrgId>(row.orgId), userId: brandId<UserId>(row.userId),
+    name: row.name, scope: row.scope, prefix: row.prefix,
+    expiresAt: brandStamp(row.expiresAt),
+    lastUsedAt: row.lastUsedAt ? brandStamp(row.lastUsedAt) : null,
+    revokedAt: row.revokedAt ? brandStamp(row.revokedAt) : null,
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+export async function create(input: { orgId: OrgId; userId: UserId; name: string; scope: "read" | "write"; tokenHash: string; prefix: string; expiresAt: IsoTimestamp; createdAt: IsoTimestamp }): Promise<ApiToken> {
+  const row = getDb().insert(apiTokens).values({ id: newId(), ...input, lastUsedAt: null, revokedAt: null, updatedAt: input.createdAt }).returning().get();
+  return map(row);
+}
+export async function list(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId))).orderBy(desc(apiTokens.createdAt), desc(apiTokens.id)).all().map(map);
+}
+export async function countUsable(orgId: OrgId, userId: UserId, now: IsoTimestamp): Promise<number> {
+  return getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, now))).all().length;
+}
+export async function findInOrg(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id))).get();
+  return row ? map(row) : null;
+}
+export async function findByHash(tokenHash: string) {
+  return getDb().select({ token: apiTokens, member: members, org: organizations }).from(apiTokens)
+    .leftJoin(members, and(eq(members.orgId, apiTokens.orgId), eq(members.userId, apiTokens.userId)))
+    .leftJoin(organizations, eq(organizations.id, apiTokens.orgId))
+    .where(eq(apiTokens.tokenHash, tokenHash)).get() ?? null;
+}
+export async function touch(id: string, at: IsoTimestamp): Promise<void> {
+  getDb().update(apiTokens).set({ lastUsedAt: at, updatedAt: at }).where(eq(apiTokens.id, id)).run();
+}
+export async function revoke(id: string, at: IsoTimestamp): Promise<ApiToken> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at, updatedAt: at }).where(and(eq(apiTokens.id, id), isNull(apiTokens.revokedAt))).returning().get();
+  if (row) return map(row);
+  const existing = getDb().select().from(apiTokens).where(eq(apiTokens.id, id)).get();
+  if (!existing) throw new Error(`API token ${id} not found`);
+  return map(existing);
+}
+export async function revokeActiveForMember(orgId: OrgId, userId: UserId, at: IsoTimestamp): Promise<readonly ApiToken[]> {
+  const rows = getDb().update(apiTokens).set({ revokedAt: at, updatedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt))).returning().all();
+  return rows.map(map);
+}

+
+export type PurgedArchivedIssues = {
+  readonly issueIds: readonly IssueId[];
+  readonly commentIds: readonly CommentId[];
+  readonly attachmentStorageMb: number;
+};
+
+/** Permanently removes one batch of issues past the workspace retention cut-off. */
+export async function purgeArchivedIssuesBefore(
+  orgId: OrgId,
+  before: IsoTimestamp,
+  limit: number,
+): Promise<PurgedArchivedIssues> {
+  const db = getDb();
+
+  return db.transaction((tx) => {
+    const rows = tx
+      .select({
+        id: issues.id,
+        projectId: issues.projectId,
+        number: issues.number,
+      })
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, orgId),
+          isNotNull(issues.archivedAt),
+          lte(issues.archivedAt, before),
+        ),
+      )
+      .orderBy(issues.archivedAt, issues.createdAt, issues.id)
+      .limit(Math.max(1, Math.floor(limit)))
+      .all();
+
+    if (rows.length === 0) {
+      return { issueIds: [], commentIds: [], attachmentStorageMb: 0 };
+    }
+
+    const issueIds = rows.map((row) => row.id as IssueId);
+    const commentIds = tx
+      .select({ id: comments.id })
+      .from(comments)
+      .where(
+        and(
+          orgPredicate(comments.orgId, orgId),
+          inArray(comments.issueId, [...issueIds]),
+        ),
+      )
+      .all()
+      .map((row) => row.id as CommentId);
+    const attachmentSizes = tx
+      .select({ sizeBytes: attachments.sizeBytes })
+      .from(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          inArray(attachments.issueId, [...issueIds]),
+        ),
+      )
+      .all();
+    const attachmentStorageMb = attachmentSizes.reduce(
+      (total, attachment) =>
+        total + Math.ceil(attachment.sizeBytes / (1024 * 1024)),
+      0,
+    );
+
+    const maxNumberByProject = new Map<ProjectId, number>();
+    for (const row of rows) {
+      const projectId = row.projectId as ProjectId;
+      maxNumberByProject.set(
+        projectId,
+        Math.max(maxNumberByProject.get(projectId) ?? 0, row.number),
+      );
+    }
+    for (const [projectId, lastNumber] of maxNumberByProject) {
+      tx.insert(issueNumberSequences)
+        .values({ orgId, projectId, lastNumber })
+        .onConflictDoUpdate({
+          target: [issueNumberSequences.orgId, issueNumberSequences.projectId],
+          set: {
+            lastNumber: sql`max(${issueNumberSequences.lastNumber}, excluded.last_number)`,
+          },
+        })
+        .run();
+    }
+
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          inArray(issueLabels.issueId, [...issueIds]),
+        ),
+      )
+      .run();
+    tx.delete(comments)
+      .where(
+        and(
+          orgPredicate(comments.orgId, orgId),
+          inArray(comments.issueId, [...issueIds]),
+        ),
+      )
+      .run();
+    tx.delete(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          inArray(attachments.issueId, [...issueIds]),
+        ),
+      )
+      .run();
+    tx.delete(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, orgId),
+          inArray(issues.id, [...issueIds]),
+        ),
+      )
+      .run();
+
+    return { issueIds, commentIds, attachmentStorageMb };
+  });
 }
 

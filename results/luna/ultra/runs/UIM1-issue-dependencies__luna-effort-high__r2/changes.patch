+import { and, asc, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import { toIsoTimestamp } from "@/types/common";
+import type { IssueDependency } from "@/types/issue";
+
+function toDependency(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: toIsoTimestamp(row.createdAt),
+  };
+}
+
+export async function findDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<IssueDependency | null> {
+  const row = getDb()
+    .select()
+    .from(issueDependencies)
+    .where(and(
+      eq(issueDependencies.orgId, orgId),
+      eq(issueDependencies.issueId, issueId),
+      eq(issueDependencies.blockerId, blockerId),
+    ))
+    .get();
+  return row ? toDependency(row) : null;
+}
+
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  const db = getDb();
+  const existing = await findDependency(orgId, issueId, blockerId);
+  if (existing) return existing;
+  const createdAt = new Date().toISOString();
+  const row = db.insert(issueDependencies).values({
+    orgId,
+    issueId,
+    blockerId,
+    createdBy,
+    createdAt,
+  }).onConflictDoNothing().returning().get();
+  if (row) return toDependency(row);
+  const raced = await findDependency(orgId, issueId, blockerId);
+  if (!raced) throw new Error("Issue dependency could not be stored");
+  return raced;
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const result = getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId),
+    eq(issueDependencies.issueId, issueId),
+    eq(issueDependencies.blockerId, blockerId),
+  )).run();
+  return result.changes > 0;
+}
+
+export async function listBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb().select({ blockerId: issueDependencies.blockerId })
+    .from(issueDependencies)
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId)))
+    .orderBy(asc(issueDependencies.blockerId))
+    .all()
+    .map((row) => row.blockerId as IssueId);
+}
+
+export async function listDependenciesForBlocker(
+  orgId: OrgId,
+  blockerId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb().select({ issueId: issueDependencies.issueId })
+    .from(issueDependencies)
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.blockerId, blockerId)))
+    .orderBy(asc(issueDependencies.issueId))
+    .all()
+    .map((row) => row.issueId as IssueId);
+}

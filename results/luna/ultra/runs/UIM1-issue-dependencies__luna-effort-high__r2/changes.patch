+
+async function notifyUnblocked(
+  orgId: import("@/types/common").OrgId,
+  blockerId: import("@/types/common").IssueId,
+  actorId: UserId | null,
+): Promise<void> {
+  const dependents = await dependencyRepo.listDependenciesForBlocker(orgId, blockerId);
+  for (const issueId of dependents) {
+    const issue = await issueRepo.findIssueById(orgId, issueId);
+    if (
+      !issue || issue.archivedAt !== null || issue.assigneeId === null ||
+      issue.status === "done" || issue.status === "canceled"
+    ) continue;
+
+    let hasOpenBlocker = false;
+    for (const candidateId of await dependencyRepo.listBlockerIds(orgId, issueId)) {
+      const candidate = await issueRepo.findIssueById(orgId, candidateId);
+      if (
+        candidate && candidate.archivedAt === null &&
+        candidate.status !== "done" && candidate.status !== "canceled"
+      ) {
+        hasOpenBlocker = true;
+        break;
+      }
+    }
+    if (hasOpenBlocker) continue;
+    await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+      title: "Issue unblocked",
+      body: `Issue ${issue.id} has no open blockers`,
+      href: `/issues/${issue.id}`,
+      actorId,
+    });
+  }
 }
 

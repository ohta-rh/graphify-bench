+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import type { IssueId, OrgId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+import type { Actor } from "@/types/member";
+import { issueResource, requireFound } from "./_support";
+
+type DependencyInput = { orgId: OrgId; issueId: IssueId; blockerId: IssueId };
+
+export class IssueBlockedError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(readonly blockerIds: readonly IssueId[]) {
+    super(`Issue is blocked by ${blockerIds.join(", ")}`);
+    this.name = "IssueBlockedError";
+  }
+}
+
+export async function addBlocker(
+  actor: Actor,
+  input: DependencyInput,
+): Promise<IssueDependency> {
+  assertOrgScope(actor, input.orgId);
+  const issue = requireFound(await issueRepo.findIssueById(input.orgId, input.issueId), "Issue", input.issueId);
+  const blocker = requireFound(await issueRepo.findIssueById(input.orgId, input.blockerId), "Issue", input.blockerId);
+  assertCan(actor, "issue:update", issueResource(issue));
+  assertNotArchived("Issue", issue.id, issue);
+  assertNotArchived("Issue", blocker.id, blocker);
+
+  if (input.issueId === input.blockerId || await createsCycle(input.orgId, input.issueId, input.blockerId)) {
+    throw new Error("Issue dependency would create a cycle");
+  }
+  return dependencyRepo.insertDependency(input.orgId, input.issueId, input.blockerId, actor.userId);
+}
+
+export async function removeBlocker(
+  actor: Actor,
+  input: DependencyInput,
+): Promise<boolean> {
+  assertOrgScope(actor, input.orgId);
+  const issue = requireFound(await issueRepo.findIssueById(input.orgId, input.issueId), "Issue", input.issueId);
+  assertCan(actor, "issue:update", issueResource(issue));
+  return dependencyRepo.deleteDependency(input.orgId, input.issueId, input.blockerId);
+}
+
+export async function listBlockers(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  assertOrgScope(actor, orgId);
+  const issue = requireFound(await issueRepo.findIssueById(orgId, issueId), "Issue", issueId);
+  assertCan(actor, "issue:read", issueResource(issue));
+  const blockers: Issue[] = [];
+  for (const blockerId of await dependencyRepo.listBlockerIds(orgId, issueId)) {
+    const blocker = await issueRepo.findIssueById(orgId, blockerId);
+    if (blocker !== null && blocker.archivedAt === null) blockers.push(blocker);
+  }
+  return blockers.sort((a, b) => a.number - b.number);
+}
+
+async function createsCycle(orgId: OrgId, issueId: IssueId, blockerId: IssueId): Promise<boolean> {
+  const pending = [blockerId];
+  const visited = new Set<IssueId>();
+  while (pending.length > 0) {
+    const current = pending.pop()!;
+    if (current === issueId) return true;
+    if (visited.has(current)) continue;
+    visited.add(current);
+    pending.push(...await dependencyRepo.listBlockerIds(orgId, current));
+  }
+  return false;
+}

+/** Moves and renumbers an issue while atomically retaining both project high-water marks. */
+export async function moveIssueToProject(
+  orgId: OrgId,
+  issueId: IssueId,
+  toProjectId: ProjectId,
+): Promise<Issue> {
+  await getDb().transaction((tx) => {
+    const before = tx
+      .select()
+      .from(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .get();
+    if (!before) throw new Error(`Issue ${issueId} not found`);
+
+    const sourceCounter = tx
+      .select({ lastNumber: issueNumberCounters.lastNumber })
+      .from(issueNumberCounters)
+      .where(eq(issueNumberCounters.projectId, before.projectId))
+      .get();
+    tx.insert(issueNumberCounters)
+      .values({
+        projectId: before.projectId as ProjectId,
+        orgId,
+        lastNumber: Math.max(sourceCounter?.lastNumber ?? 0, before.number),
+      })
+      .onConflictDoUpdate({
+        target: issueNumberCounters.projectId,
+        set: {
+          orgId,
+          lastNumber: Math.max(sourceCounter?.lastNumber ?? 0, before.number),
+        },
+      })
+      .run();
+
+    const number = reserveNextIssueNumber(tx, orgId, toProjectId);
+    const row = tx
+      .update(issues)
+      .set({
+        projectId: toProjectId,
+        number,
+        updatedAt: toIsoTimestamp(new Date()),
+      })
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .returning()
+      .get();
+
+    if (!row) throw new Error(`Issue ${issueId} not found`);
+    return row;
+  });
+
+  const moved = await findIssueById(orgId, issueId);
+  if (!moved) throw new Error(`Issue ${issueId} not found`);
+  return moved;
 }
 

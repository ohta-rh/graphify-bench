  */
 export async function nextIssueNumber(
   orgId: OrgId,
   projectId: ProjectId,
 ): Promise<number> {
-  const row = getDb()
+  return getDb().transaction((tx) => reserveNextIssueNumber(tx, orgId, projectId));
+}
+
+function reserveNextIssueNumber(
+  tx: Parameters<Parameters<ReturnType<typeof getDb>["transaction"]>[0]>[0],
+  orgId: OrgId,
+  projectId: ProjectId,
+): number {
+  const row = tx
     .select({ value: sql<number | null>`max(${issues.number})` })
     .from(issues)
     .where(
       and(orgPredicate(issues.orgId, orgId), eq(issues.projectId, projectId)),
     )
     .get();
-  return (row?.value ?? 0) + 1;
+  const counter = tx
+    .select({ lastNumber: issueNumberCounters.lastNumber })
+    .from(issueNumberCounters)
+    .where(eq(issueNumberCounters.projectId, projectId))
+    .get();
+  const next = Math.max(row?.value ?? 0, counter?.lastNumber ?? 0) + 1;
+
+  tx.insert(issueNumberCounters)
+    .values({ projectId, orgId, lastNumber: next })
+    .onConflictDoUpdate({
+      target: issueNumberCounters.projectId,
+      set: { orgId, lastNumber: next },
+    })
+    .run();
+
+  return next;
+}

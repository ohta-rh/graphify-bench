+/**
+ * Changes the current slug and retires the previous one as one database
+ * transaction. A null result means another workspace currently owns or holds
+ * the requested slug.
+ */
+export async function renameOrgSlug(
+  orgId: OrgId,
+  slug: string,
+): Promise<Organization | null> {
+  const db = getDb();
+  const stamp = toIsoTimestamp(new Date());
+  const result = db.transaction((tx) => {
+    const current = tx
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    if (!current) return null;
+    if (current.slug === slug) return current;
+
+    const currentOwner = tx
+      .select({ id: organizations.id })
+      .from(organizations)
+      .where(eq(organizations.slug, slug))
+      .get();
+    const retiredOwner = tx
+      .select({ orgId: retiredOrganizationSlugs.orgId })
+      .from(retiredOrganizationSlugs)
+      .where(
+        and(
+          eq(retiredOrganizationSlugs.slug, slug),
+          gt(retiredOrganizationSlugs.retiredAt, slugHoldCutoff()),
+          ne(retiredOrganizationSlugs.orgId, orgId),
+        ),
+      )
+      .get();
+    if (currentOwner || retiredOwner) return null;
+
+    // A workspace may reclaim any slug it retired itself, even during its
+    // hold. Expired rows are removed too so the slug can be reused globally.
+    tx.delete(retiredOrganizationSlugs)
+      .where(eq(retiredOrganizationSlugs.slug, slug))
+      .run();
+    tx.delete(retiredOrganizationSlugs)
+      .where(eq(retiredOrganizationSlugs.slug, current.slug))
+      .run();
+    tx.insert(retiredOrganizationSlugs)
+      .values({ slug: current.slug, orgId, retiredAt: stamp })
+      .run();
+
+    return tx
+      .update(organizations)
+      .set({ slug, updatedAt: stamp })
+      .where(eq(organizations.id, orgId))
+      .returning()
+      .get();
+  });
+  return result ? toOrganization(result) : null;
+}

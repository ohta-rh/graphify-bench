+  const taken = await listTakenProjectSlugs(input.orgId);
+  const slug = uniqueSlug(input.slug, taken);
+
+  return db.transaction((tx) => {
+    const stamp = toIsoTimestamp(new Date());
+    const projectRow = tx
+      .insert(projects)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        name: input.name,
+        slug,
+        key: input.key,
+        description: source.description,
+        visibility: source.visibility,
+        status: "active",
+        leadId: source.leadId,
+        color: source.color,
+        startsAt: null,
+        targetDate: null,
+        createdAt: stamp,
+        updatedAt: stamp,
+      })
+      .returning()
+      .get();
+
+    const orderedIssues = [...sourceIssues].sort((a, b) => a.number - b.number);
+    for (const [index, issue] of orderedIssues.entries()) {
+      const issueId = newId();
+      tx.insert(issues)
+        .values({
+          id: issueId,
+          orgId: input.orgId,
+          projectId: projectRow.id,
+          number: index + 1,
+          title: issue.title,
+          description: issue.description,
+          status: defaultStatus,
+          priority: issue.priority,
+          authorId,
+          assigneeId: null,
+          parentId: null,
+          estimate: issue.estimate,
+          dueAt: issue.dueAt,
+          startedAt: null,
+          completedAt: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .run();
+
+      if (issue.labelIds.length > 0) {
+        tx.insert(issueLabels)
+          .values(
+            issue.labelIds.map((labelId) => ({
+              orgId: input.orgId,
+              issueId,
+              labelId,
+            })),
+          )
+          .run();
+      }
+    }
+
+    return toProject(projectRow);
+  });
 }
 

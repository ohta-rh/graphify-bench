+async function listAllLiveIssues(
+  orgId: OrgId,
+  projectId: ProjectId,
+) {
+  const issues: Issue[] = [];
+  let cursor: string | null = null;
+  do {
+    const page = await issueRepo.listIssues({
+      orgId,
+      projectId,
+      limit: 100,
+      cursor,
+    });
+    issues.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+  return issues;
 }

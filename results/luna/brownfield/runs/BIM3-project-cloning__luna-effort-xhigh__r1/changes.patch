+/** Clones a live project, optionally copying its live issues as a fresh batch. */
+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(source));
+  assertNotArchived("Project", source.id, source);
+  assertCan(actor, "project:create", orgResource(input.orgId));
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const usedProjects = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", usedProjects)) {
+    throw new Error(
+      `Plan ${org.plan} allows ${usedProjects} projects; upgrade to add another`,
+    );
+  }
+
+  const sourceIssueCount = input.includeIssues
+    ? await issueRepo.countIssues(input.orgId, source.id)
+    : 0;
+  if (wouldExceedLimit(org.plan, "issuesPerProject", 0, sourceIssueCount)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${input.key}`,
+    );
+  }
+
+  const { project, issuesCopied } = await projectRepo.cloneProjectWithIssues({
+    orgId: input.orgId,
+    sourceProjectId: source.id,
+    name: input.name,
+    slug: input.slug,
+    key: input.key,
+    actorId: actor.userId,
+    includeIssues: input.includeIssues,
+    defaultIssueStatus: org.settings.defaultIssueStatus as IssueStatus,
+    issueLimit: getPlanLimits(org.plan).issuesPerProject,
+    plan: org.plan,
+  });
+
+  await emit("project.cloned", {
+    ...actorEnvelope(actor),
+    projectId: project.id,
+    sourceProjectId: source.id,
+    issuesCopied,
   });
 
   return project;

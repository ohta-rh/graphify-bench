+/**
+ * Creates a fresh project and, when requested, copies all its live issues in
+ * one transaction. The issue rows are ordered by source number and reset to
+ * the workspace's default status, with no assignee or progress timestamps.
+ */
+export async function cloneProjectWithIssues(input: {
+  orgId: OrgId;
+  sourceProjectId: ProjectId;
+  name: string;
+  slug: string;
+  key: string;
+  actorId: UserId;
+  includeIssues: boolean;
+  defaultIssueStatus: IssueStatus;
+  issueLimit: number;
+  plan: PlanId;
+}): Promise<{ project: Project; issuesCopied: number }> {
+  const db = getDb();
+
+  return db.transaction((tx) => {
+    const source = tx
+      .select()
+      .from(projects)
+      .where(
+        and(...compact(
+          orgPredicate(projects.orgId, input.orgId),
+          eq(projects.id, input.sourceProjectId),
+          livePredicate(projects.archivedAt, {}),
+        )),
+      )
+      .get();
+    if (!source) {
+      throw new Error(`Project ${input.sourceProjectId} not found`);
+    }
+
+    const sourceIssues = input.includeIssues
+      ? tx
+          .select()
+          .from(issues)
+          .where(
+            and(...compact(
+              orgPredicate(issues.orgId, input.orgId),
+              eq(issues.projectId, input.sourceProjectId),
+              livePredicate(issues.archivedAt, {}),
+            )),
+          )
+          .orderBy(asc(issues.number))
+          .all()
+      : [];
+
+    if (sourceIssues.length > input.issueLimit) {
+      throw new Error(
+        `Plan ${input.plan} allows no more issues in project ${input.key}`,
+      );
+    }
+
+    const takenSlugs = tx
+      .select({ slug: projects.slug })
+      .from(projects)
+      .where(orgPredicate(projects.orgId, input.orgId))
+      .all()
+      .map((row) => row.slug);
+    const slug = uniqueSlug(input.slug, takenSlugs);
+    const stamp = toIsoTimestamp(new Date());
+    const projectRow = tx
+      .insert(projects)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        name: input.name,
+        slug,
+        key: input.key,
+        description: source.description,
+        visibility: source.visibility,
+        status: "active",
+        leadId: source.leadId,
+        color: source.color,
+        startsAt: null,
+        targetDate: null,
+        createdAt: stamp,
+        updatedAt: stamp,
+        archivedAt: null,
+      })
+      .returning()
+      .get();
+
+    if (sourceIssues.length > 0) {
+      const sourceLabels = tx
+        .select({ issueId: issueLabels.issueId, labelId: issueLabels.labelId })
+        .from(issueLabels)
+        .innerJoin(issues, eq(issues.id, issueLabels.issueId))
+        .where(
+          and(...compact(
+            orgPredicate(issueLabels.orgId, input.orgId),
+            orgPredicate(issues.orgId, input.orgId),
+            eq(issues.projectId, input.sourceProjectId),
+            livePredicate(issues.archivedAt, {}),
+          )),
+        )
+        .all();
+      const labelIdsByIssue = new Map<string, string[]>();
+      for (const label of sourceLabels) {
+        const labelIds = labelIdsByIssue.get(label.issueId) ?? [];
+        labelIds.push(label.labelId);
+        labelIdsByIssue.set(label.issueId, labelIds);
+      }
+
+      for (const [index, sourceIssue] of sourceIssues.entries()) {
+        const issueId = newId();
+        tx.insert(issues)
+          .values({
+            id: issueId,
+            orgId: input.orgId,
+            projectId: projectRow.id,
+            number: index + 1,
+            title: sourceIssue.title,
+            description: sourceIssue.description,
+            status: input.defaultIssueStatus,
+            priority: sourceIssue.priority,
+            authorId: input.actorId,
+            assigneeId: null,
+            parentId: null,
+            estimate: sourceIssue.estimate,
+            dueAt: sourceIssue.dueAt,
+            startedAt: null,
+            completedAt: null,
+            createdAt: stamp,
+            updatedAt: stamp,
+            archivedAt: null,
+          })
+          .run();
+
+        const labelIds = labelIdsByIssue.get(sourceIssue.id) ?? [];
+        if (labelIds.length > 0) {
+          tx.insert(issueLabels)
+            .values(
+              labelIds.map((labelId) => ({
+                orgId: input.orgId,
+                issueId,
+                labelId,
+              })),
+            )
+            .run();
+        }
+      }
+    }
+
+    return { project: toProject(projectRow), issuesCopied: sourceIssues.length };
+  });
 }
 

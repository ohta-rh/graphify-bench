+/** Changes a workspace URL and keeps its previous URL resolvable during its hold. */
+export async function renameOrganizationSlug(
+  actor: Actor,
+  input: RenameOrganizationSlugInput,
+): Promise<Organization> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "org:update", orgResource(input.orgId));
+  assertValidSlug(input.slug);
+
+  const current = requireFound(await orgRepo.findOrgById(input.orgId), "Organization", input.orgId);
+  if (current.slug === input.slug) return current;
+
+  const updated = await orgRepo.renameOrgSlug(input.orgId, input.slug);
+  await emit("organization.slug_changed", {
+    ...envelope(input.orgId, actor.userId),
+    from: current.slug,
+    to: updated.slug,
+  });
+  await record(input.orgId, "organization.slug_changed", {
+    actorId: actor.userId,
+    subjectKind: "organization",
+    subjectId: updated.id,
+    projectId: null,
+    summary: `Workspace URL changed from ${current.slug} to ${updated.slug}`,
+    metadata: { from: current.slug, to: updated.slug },
+  });
   return updated;
 }
 

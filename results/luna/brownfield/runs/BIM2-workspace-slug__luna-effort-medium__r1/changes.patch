+/** Updates the current URL while preserving the replaced URL for its hold. */
+export async function renameOrgSlug(orgId: OrgId, slug: string): Promise<Organization> {
+  const db = getDb();
+  const now = toIsoTimestamp(new Date());
+  const cutoff = holdCutoff();
+  const org = db.transaction((tx) => {
+    const current = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+    if (!current) throw new Error(`Organization ${orgId} not found`);
+    if (current.slug === slug) return current;
+
+    const currentCollision = tx.select({ id: organizations.id }).from(organizations)
+      .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId))).get();
+    const retiredCollision = tx.select({ orgId: retiredOrganizationSlugs.orgId })
+      .from(retiredOrganizationSlugs)
+      .where(and(eq(retiredOrganizationSlugs.slug, slug), gte(retiredOrganizationSlugs.retiredAt, cutoff), ne(retiredOrganizationSlugs.orgId, orgId)))
+      .get();
+    if (currentCollision || retiredCollision) {
+      throw new InvalidSlugError(slug, "is unavailable");
+    }
+
+    tx.insert(retiredOrganizationSlugs).values({ orgId, slug: current.slug, retiredAt: now })
+      .onConflictDoUpdate({ target: [retiredOrganizationSlugs.orgId, retiredOrganizationSlugs.slug], set: { retiredAt: now } })
+      .run();
+    tx.delete(retiredOrganizationSlugs).where(and(eq(retiredOrganizationSlugs.orgId, orgId), eq(retiredOrganizationSlugs.slug, slug))).run();
+    return tx.update(organizations).set({ slug, updatedAt: now }).where(eq(organizations.id, orgId)).returning().get();
+  });
+  return toOrganization(org);
+}
+
+function holdCutoff(): string {
+  return toIsoTimestamp(new Date(Date.now() - ORG_SLUG_HOLD_DAYS * 24 * 60 * 60 * 1000));
+}

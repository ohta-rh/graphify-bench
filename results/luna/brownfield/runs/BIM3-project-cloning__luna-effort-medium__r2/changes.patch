+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(source));
+  assertNotArchived("Project", source.id, source);
+  assertCan(actor, "project:create", orgResource(input.orgId));
+
+  const org = requireFound(await orgRepo.findOrgById(input.orgId), "Organization", input.orgId);
+  const projectsUsed = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", projectsUsed)) {
+    throw new Error(`Plan ${org.plan} allows ${projectsUsed} projects; upgrade to add another`);
+  }
+
+  const issuesCopied = input.includeIssues
+    ? await issueRepo.countIssues(input.orgId, source.id)
+    : 0;
+  if (issuesCopied > getPlanLimits(org.plan).issuesPerProject) {
+    throw new Error(`Plan ${org.plan} allows ${getPlanLimits(org.plan).issuesPerProject} issues per project; clone refused`);
+  }
+
+  const project = await projectRepo.insertClonedProject(input, source);
+  if (input.includeIssues) {
+    await issueRepo.cloneIssuesToProject(
+      input.orgId, source.id, project.id, actor.userId,
+      org.settings.defaultIssueStatus as IssueStatus,
+    );
+  }
+  await emit("project.cloned", {
+    ...actorEnvelope(actor), projectId: project.id, sourceProjectId: source.id, issuesCopied,
+  });
   return project;
 }
 

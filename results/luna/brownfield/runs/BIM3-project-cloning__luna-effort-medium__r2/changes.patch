+/** Copies every live source issue as a fresh issue, keeping order and labels. */
+export async function cloneIssuesToProject(
+  orgId: OrgId,
+  fromProjectId: ProjectId,
+  toProjectId: ProjectId,
+  authorId: UserId,
+  defaultStatus: IssueStatus,
+): Promise<number> {
+  const db = getDb();
+  const sourceRows = db.select().from(issues).where(and(
+    orgPredicate(issues.orgId, orgId), eq(issues.projectId, fromProjectId),
+    livePredicate(issues.archivedAt, {}),
+  )).orderBy(issues.number).all();
+  const labels = await listLabelsForIssues(orgId, sourceRows.map((row) => row.id as IssueId));
+  const stamp = toIsoTimestamp(new Date());
+  sourceRows.forEach((source, index) => {
+    const id = newId();
+    db.insert(issues).values({
+      id, orgId, projectId: toProjectId, number: index + 1,
+      title: source.title, description: source.description, status: defaultStatus,
+      priority: source.priority, authorId, assigneeId: null, parentId: null,
+      estimate: source.estimate, dueAt: source.dueAt, startedAt: null,
+      completedAt: null, createdAt: stamp, updatedAt: stamp,
+    }).run();
+    const labelIds = (labels[source.id] ?? []).map((label) => label.id);
+    if (labelIds.length > 0) db.insert(issueLabels).values(labelIds.map((labelId) => ({ orgId, issueId: id, labelId }))).run();
+  });
+  return sourceRows.length;
+}

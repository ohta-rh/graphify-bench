@@ -0,0 +1,73 @@
+import type { ProjectId } from "@/types/common";
+
+export type SearchSubjectKind = "issue" | "comment" | "project";
+
+const KINDS: readonly SearchSubjectKind[] = ["issue", "comment", "project"];
+
+export interface ParsedSearchQuery {
+  readonly text: string;
+  /** Kinds named by one or more kind:/in: tokens, or null when none were given. */
+  readonly kinds: readonly SearchSubjectKind[] | null;
+  readonly projectId: ProjectId | null;
+  readonly unknownTokens: readonly string[];
+}
+
+export function parseSearchQuery(
+  raw: string,
+  advanced: boolean,
+): ParsedSearchQuery {
+  if (!advanced) {
+    return {
+      text: raw.trim().replace(/\s+/g, " "),
+      kinds: null,
+      projectId: null,
+      unknownTokens: [],
+    };
+  }
+
+  const terms: string[] = [];
+  const kinds: SearchSubjectKind[] = [];
+  const unknown: string[] = [];
+  let projectId: ProjectId | null = null;
+
+  for (const token of raw.split(/\s+/).filter(Boolean)) {
+    const separator = token.indexOf(":");
+    if (separator <= 0) {
+      terms.push(token);
+      continue;
+    }
+
+    const field = token.slice(0, separator).toLowerCase();
+    const value = token.slice(separator + 1);
+    if (value.length === 0) {
+      unknown.push(token);
+    } else if (field === "kind" || field === "in") {
+      const kind = value.toLowerCase().replace(/s$/, "") as SearchSubjectKind;
+      if (KINDS.includes(kind)) kinds.push(kind);
+      else unknown.push(token);
+    } else if (field === "project") {
+      projectId = value as ProjectId;
+    } else {
+      unknown.push(token);
+    }
+  }
+
+  return {
+    text: terms.join(" "),
+    kinds: kinds.length > 0 ? [...new Set(kinds)] : null,
+    projectId,
+    unknownTokens: unknown,
+  };
+}
+
+export function describeQuery(
+  parsed: ParsedSearchQuery,
+  defaultKinds: readonly SearchSubjectKind[] = ["issue"],
+): string {
+  const parts = [`searching ${(parsed.kinds ?? defaultKinds).join(", ")}`];
+  if (parsed.projectId !== null) parts.push(`in project ${parsed.projectId}`);
+  if (parsed.unknownTokens.length > 0) {
+    parts.push(`ignoring ${parsed.unknownTokens.join(", ")}`);
+  }
+  return parts.join(" · ");
+}

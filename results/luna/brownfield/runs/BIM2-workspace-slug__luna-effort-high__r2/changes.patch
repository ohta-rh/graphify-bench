+/** Changes a slug and retires the previous one as a single database operation. */
+export async function renameOrgSlug(orgId: OrgId, slug: string): Promise<Organization> {
+  const now = new Date();
+  const stamp = toIsoTimestamp(now);
+  const cutoff = new Date(now.getTime() - ORG_SLUG_HOLD_DAYS * 24 * 60 * 60 * 1000).toISOString();
+
+  const row = getDb().transaction((tx) => {
+    const current = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+    if (!current) throw new Error(`Organization ${orgId} not found`);
+    if (current.slug === slug) return current;
+
+    const currentSlugConflict = tx
+      .select({ id: organizations.id })
+      .from(organizations)
+      .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId)))
+      .get();
+    const retiredConflict = tx
+      .select({ slug: retiredOrganizationSlugs.slug })
+      .from(retiredOrganizationSlugs)
+      .where(and(
+        eq(retiredOrganizationSlugs.slug, slug),
+        ne(retiredOrganizationSlugs.orgId, orgId),
+        gt(retiredOrganizationSlugs.retiredAt, cutoff),
+      ))
+      .get();
+    if (currentSlugConflict || retiredConflict) {
+      throw new InvalidSlugError(slug, "is unavailable");
+    }
+
+    // A workspace can reclaim a slug it retired itself, and expired holds
+    // are removed before the unique slug is inserted again.
+    tx.delete(retiredOrganizationSlugs).where(eq(retiredOrganizationSlugs.slug, slug)).run();
+    tx.delete(retiredOrganizationSlugs).where(eq(retiredOrganizationSlugs.slug, current.slug)).run();
+    tx.insert(retiredOrganizationSlugs).values({
+      slug: current.slug,
+      orgId,
+      retiredAt: stamp,
+    }).run();
+
+    return tx.update(organizations)
+      .set({ slug, updatedAt: stamp })
+      .where(eq(organizations.id, orgId))
+      .returning()
+      .get();
+  });
+  return toOrganization(row);
+}

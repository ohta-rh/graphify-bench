+/** Moves an issue to another live project in the same organization. */
+export async function moveIssueToProject(
+  actor: Actor,
+  input: MoveIssueToProjectInput,
+): Promise<Issue> {
+  assertOrgScope(actor, input.orgId);
+
+  const before = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  assertCan(actor, "issue:update", issueResource(before));
+  assertNotArchived("Issue", before.id, before);
+
+  const target = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.toProjectId),
+    "Project",
+    input.toProjectId,
+  );
+  assertNotArchived("Project", target.id, target);
+  assertCan(actor, "issue:create", projectResource(target));
+
+  if (before.projectId === target.id) return before;
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await issueRepo.countIssues(input.orgId, target.id);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${target.key}`,
+    );
+  }
+
+  const toNumber = await issueRepo.nextIssueNumber(input.orgId, target.id);
+  const after = await issueRepo.relocateIssue(
+    input.orgId,
+    input.issueId,
+    target.id,
+    toNumber,
+  );
+
+  await emit("issue.moved", {
+    ...actorEnvelope(actor),
+    issueId: after.id,
+    fromProjectId: before.projectId,
+    toProjectId: after.projectId,
+    fromNumber: before.number,
+    toNumber: after.number,
+  });
+
+  return after;
+}

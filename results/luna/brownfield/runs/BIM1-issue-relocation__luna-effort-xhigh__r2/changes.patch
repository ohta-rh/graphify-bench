+/** Retains an issued number after its row leaves the project. */
+function rememberIssueNumber(
+  orgId: OrgId,
+  projectId: ProjectId,
+  number: number,
+): void {
+  const db = getDb();
+  const current = db
+    .select({ lastNumber: issueNumberCounters.lastNumber })
+    .from(issueNumberCounters)
+    .where(
+      and(
+        eq(issueNumberCounters.orgId, orgId),
+        eq(issueNumberCounters.projectId, projectId),
+      ),
+    )
+    .get();
+
+  if (current === undefined) {
+    db.insert(issueNumberCounters)
+      .values({ orgId, projectId, lastNumber: number })
+      .run();
+  } else if (number > current.lastNumber) {
+    db.update(issueNumberCounters)
+      .set({ lastNumber: number })
+      .where(
+        and(
+          eq(issueNumberCounters.orgId, orgId),
+          eq(issueNumberCounters.projectId, projectId),
+        ),
+      )
+      .run();
+  }
+}

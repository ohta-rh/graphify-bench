+/** Atomically reserves the next never-reused number for a project. */
+export async function allocateIssueNumber(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<number> {
+  const row = getDb()
+    .update(projects)
+    .set({
+      issueNumberSequence: sql`max(${projects.issueNumberSequence}, coalesce((select max(${issues.number}) from ${issues} where ${issues.orgId} = ${orgId} and ${issues.projectId} = ${projectId}), 0)) + 1`,
+    })
+    .where(and(orgPredicate(projects.orgId, orgId), eq(projects.id, projectId)))
+    .returning({ value: projects.issueNumberSequence })
+    .get();
+  if (!row) throw new Error(`Project ${projectId} not found`);
+  return row.value;
+}

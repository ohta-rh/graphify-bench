+/** Creates a fresh project from a live source, optionally copying its live issues. */
+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", source.id, source);
+  assertCan(actor, "project:read", projectResource(source));
+  assertCan(actor, "project:create", orgResource(input.orgId));
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const projectsUsed = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", projectsUsed)) {
+    throw new Error(
+      `Plan ${org.plan} allows ${projectsUsed} projects; upgrade to add another`,
+    );
+  }
+
+  const issuesToCopy = input.includeIssues
+    ? await issueRepo.countIssues(input.orgId, source.id)
+    : 0;
+  if (wouldExceedLimit(org.plan, "issuesPerProject", 0, issuesToCopy)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more than ${issuesToCopy} issues in a project`,
+    );
+  }
+
+  const result = await projectRepo.cloneProjectRows(
+    input,
+    source,
+    actor.userId,
+    org.settings.defaultIssueStatus as IssueStatus,
+  );
+
+  await emit("project.cloned", {
+    ...actorEnvelope(actor),
+    projectId: result.project.id,
+    sourceProjectId: source.id,
+    issuesCopied: result.issuesCopied,
+  });
+
+  return result.project;
 }
 

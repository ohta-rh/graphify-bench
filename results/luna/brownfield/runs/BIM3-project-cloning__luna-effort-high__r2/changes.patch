+/** Atomically creates a fresh project and, when requested, its live issue copies. */
+export async function cloneProjectRows(
+  input: CloneProjectInput,
+  sourceProject: Project,
+  actorId: UserId,
+  defaultIssueStatus: IssueStatus,
+): Promise<{ project: Project; issuesCopied: number }> {
+  return getDb().transaction((tx) => {
+    const taken = tx
+      .select({ slug: projects.slug })
+      .from(projects)
+      .where(orgPredicate(projects.orgId, input.orgId))
+      .all()
+      .map((row) => row.slug);
+    const slug = uniqueSlug(input.slug, taken);
+    const stamp = toIsoTimestamp(new Date());
+    const projectRow = tx
+      .insert(projects)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        name: input.name,
+        slug,
+        key: input.key,
+        description: sourceProject.description,
+        visibility: sourceProject.visibility,
+        status: "active",
+        leadId: sourceProject.leadId,
+        color: sourceProject.color,
+        startsAt: null,
+        targetDate: null,
+        createdAt: stamp,
+        updatedAt: stamp,
+      })
+      .returning()
+      .get();
+
+    if (!input.includeIssues) {
+      return { project: toProject(projectRow), issuesCopied: 0 };
+    }
+
+    const sourceIssues = tx
+      .select()
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, input.orgId),
+          eq(issues.projectId, sourceProject.id),
+          isNull(issues.archivedAt),
+        ),
+      )
+      .orderBy(asc(issues.number))
+      .all();
+
+    for (const [index, sourceIssue] of sourceIssues.entries()) {
+      const copyId = newId();
+      tx.insert(issues)
+        .values({
+          id: copyId,
+          orgId: input.orgId,
+          projectId: projectRow.id,
+          number: index + 1,
+          title: sourceIssue.title,
+          description: sourceIssue.description,
+          status: defaultIssueStatus,
+          priority: sourceIssue.priority,
+          authorId: actorId,
+          assigneeId: null,
+          parentId: null,
+          estimate: sourceIssue.estimate,
+          dueAt: sourceIssue.dueAt,
+          startedAt: null,
+          completedAt: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .run();
+
+      const labels = tx
+        .select({ labelId: issueLabels.labelId })
+        .from(issueLabels)
+        .where(
+          and(
+            orgPredicate(issueLabels.orgId, input.orgId),
+            eq(issueLabels.issueId, sourceIssue.id),
+          ),
+        )
+        .all();
+      if (labels.length > 0) {
+        tx.insert(issueLabels)
+          .values(
+            labels.map(({ labelId }) => ({
+              orgId: input.orgId,
+              issueId: copyId,
+              labelId,
+            })),
+          )
+          .run();
+      }
+    }
+
+    return { project: toProject(projectRow), issuesCopied: sourceIssues.length };
+  });
 }
 

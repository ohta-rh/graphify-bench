+/** All live issues in source-number order, used by whole-project operations. */
+export async function listAllLiveIssuesForProject(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(
+        orgPredicate(issues.orgId, orgId),
+        eq(issues.projectId, projectId),
+        isNull(issues.archivedAt),
+      ),
+    )
+    .orderBy(asc(issues.number))
+    .all();

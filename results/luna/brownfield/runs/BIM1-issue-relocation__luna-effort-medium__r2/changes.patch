+/** Moves and renumbers an issue while retaining the old project's number reservation. */
+export async function moveIssueToProject(
+  orgId: OrgId,
+  issueId: IssueId,
+  projectId: ProjectId,
+  number: number,
+): Promise<Issue> {
+  const db = getDb();
+  const row = db.transaction((tx) => {
+    tx.insert(projectIssueNumbers)
+      .values({ orgId, projectId, number })
+      .run();
+    return tx
+      .update(issues)
+      .set({ projectId, number, updatedAt: toIsoTimestamp(new Date()) })
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .returning()
+      .get();
+  });
   if (!row) throw new Error(`Issue ${issueId} not found`);
   return toIssue(row);
 }

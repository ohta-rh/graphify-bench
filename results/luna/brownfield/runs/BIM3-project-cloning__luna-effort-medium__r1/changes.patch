+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", source.id, source);
+  assertCan(actor, "project:read", projectResource(source));
+  assertCan(actor, "project:create", orgResource(input.orgId));
+
+  const org = requireFound(await orgRepo.findOrgById(input.orgId), "Organization", input.orgId);
+  const usedProjects = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", usedProjects)) {
+    throw new Error(`Plan ${org.plan} allows ${usedProjects} projects; upgrade to add another`);
+  }
+
+  const sourceIssues = input.includeIssues
+    ? await issueRepo.listIssues({ orgId: input.orgId, projectId: source.id, limit: 100, cursor: null })
+    : { items: [], total: 0 };
+  const issuesCopied = sourceIssues.total;
+  if (input.includeIssues && wouldExceedLimit(org.plan, "issuesPerProject", 0, issuesCopied)) {
+    throw new Error(`Plan ${org.plan} allows no more issues in a project`);
+  }
+
+  const project = await projectRepo.insertClonedProject({
+    orgId: input.orgId, name: input.name, slug: input.slug, key: input.key,
+    description: source.description, visibility: source.visibility,
+    leadId: source.leadId, color: source.color, targetDate: null,
+  }, source);
+  const copied = input.includeIssues
+    ? await issueRepo.cloneIssuesToProject(input.orgId, source.id, project.id, actor.userId, org.settings.defaultIssueStatus)
+    : 0;
+  await emit("project.cloned", {
+    ...actorEnvelope(actor), projectId: project.id, sourceProjectId: source.id,
+    issuesCopied: copied,
+  });
   return project;
 }
 

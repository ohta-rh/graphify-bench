+/** Copies live issues in source number order, resetting progress and ownership. */
+export async function cloneIssuesToProject(
+  orgId: OrgId,
+  fromProjectId: ProjectId,
+  toProjectId: ProjectId,
+  authorId: UserId,
+  defaultStatus: IssueStatus,
+): Promise<number> {
+  const db = getDb();
+  const rows = db
+    .select()
+    .from(issues)
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.projectId, fromProjectId), isNull(issues.archivedAt)))
+    .orderBy(issues.number)
+    .all();
+  const labels = await listLabelsForIssues(orgId, rows.map((row) => row.id as IssueId));
+  const stamp = toIsoTimestamp(new Date());
+
+  rows.forEach((issue, index) => {
+    const id = newId();
+    db.insert(issues).values({
+      id, orgId, projectId: toProjectId, number: index + 1,
+      title: issue.title, description: issue.description, status: defaultStatus,
+      priority: issue.priority, authorId, assigneeId: null, parentId: null,
+      estimate: issue.estimate, dueAt: issue.dueAt, startedAt: null,
+      completedAt: null, createdAt: stamp, updatedAt: stamp,
+    }).run();
+    const labelIds = labels[issue.id] ?? [];
+    if (labelIds.length) db.insert(issueLabels).values(labelIds.map(({ id: labelId }) => ({ orgId, issueId: id, labelId }))).run();
+  });
+  return rows.length;
+}

+
+/** Moves every source assignment to the target and removes the source label atomically. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  if (input.sourceLabelId === input.targetLabelId) return null;
+
+  const db = getDb();
+  return db.transaction((tx) => {
+    const source = tx
+      .select()
+      .from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .get();
+    const target = tx
+      .select()
+      .from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.targetLabelId)))
+      .get();
+    if (!source || !target) return null;
+
+    const count = tx
+      .select({ count: sql<number>`count(*)` })
+      .from(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .get()?.count ?? 0;
+
+    // Delete collisions first to satisfy the issue-label unique index.
+    tx.delete(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, input.orgId),
+        eq(issueLabels.labelId, input.sourceLabelId),
+        sql`exists (
+          select 1 from issue_labels as target_assignment
+          where target_assignment.org_id = ${input.orgId}
+            and target_assignment.issue_id = ${issueLabels.issueId}
+            and target_assignment.label_id = ${input.targetLabelId}
+        )`,
+      ))
+      .run();
+    tx.update(issueLabels)
+      .set({ labelId: input.targetLabelId })
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+
+    return { label: toLabel(target), issuesRelabelled: count };
+  });
 }
 

+
+/** Moves source assignments to target and removes the source label atomically. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  if (input.sourceLabelId === input.targetLabelId) return null;
+
+  return getDb().transaction((tx) => {
+    const source = tx
+      .select()
+      .from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .get();
+    const target = tx
+      .select()
+      .from(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.targetLabelId)))
+      .get();
+    if (!source || !target) return null;
+
+    const sourceAssignments = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .all();
+
+    // Remove source rows for issues that already have target, avoiding the
+    // unique(issue_id, label_id) constraint when the remaining rows are changed.
+    const targetIssues = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.targetLabelId)));
+    tx.delete(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, input.orgId),
+        eq(issueLabels.labelId, input.sourceLabelId),
+        inArray(issueLabels.issueId, targetIssues),
+      ))
+      .run();
+
+    tx.update(issueLabels)
+      .set({ labelId: input.targetLabelId })
+      .where(and(orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId)))
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+
+    return { label: toLabel(target), issuesRelabelled: sourceAssignments.length };
+  });
 }
 

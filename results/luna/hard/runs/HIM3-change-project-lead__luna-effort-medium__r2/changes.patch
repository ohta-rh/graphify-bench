+export async function updateProjectLead(
+  orgId: OrgId,
+  projectId: ProjectId,
+  leadId: UserId | null,
+): Promise<Project> {
+  const row = getDb()
+    .update(projects)
+    .set({ leadId, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(projects.orgId, orgId), eq(projects.id, projectId)))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Project ${projectId} not found`);
   return toProject(row);
 }
 

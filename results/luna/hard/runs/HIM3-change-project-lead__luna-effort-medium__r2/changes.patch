+
+export async function changeProjectLead(
+  actor: Actor,
+  input: ChangeProjectLeadInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:change_lead", projectResource(project));
+  assertNotArchived("Project", project.id, project);
+
+  if (input.leadId !== null) {
+    const member = requireFound(
+      await memberRepo.findMember(input.orgId, input.leadId),
+      "Member",
+      input.leadId,
+    );
+    if (member.status !== "active" || member.joinedAt === null) {
+      throw new NotFoundError("Member", input.leadId);
+    }
+    assertCan(
+      { userId: member.userId, orgId: member.orgId, role: member.role },
+      "project:update",
+      projectResource(project),
+    );
+  }
+
+  return projectRepo.updateProjectLead(input.orgId, input.projectId, input.leadId);
 }
 

@@ -0,0 +1,18 @@
+/** Shared guard for writes that target an issue or one of its children. */
+import { assertNotArchived } from "@/lib/soft-delete";
+import * as projectRepo from "@/server/repositories/project-repository";
+import type { OrgId, ProjectId } from "@/types/common";
+import { requireFound } from "./_support";
+
+/** Call after permission and issue/comment archive checks have passed. */
+export async function assertIssueProjectWritable(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<void> {
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId),
+    "Project",
+    projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+}

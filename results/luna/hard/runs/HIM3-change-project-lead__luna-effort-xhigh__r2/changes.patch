+"use client";
+
+/** Dedicated editor for handing project leadership to an active member. */
+
+import { useActionState } from "react";
+import { fieldErrorsFromZod } from "@/lib/errors";
+import { changeProjectLeadSchema } from "@/schemas/project";
+import type { ActionResult } from "@/types/api";
+import type { OrgId, UserId } from "@/types/common";
+import type { MemberWithUser } from "@/types/member";
+import type { Project } from "@/types/project";
+
+export type ProjectLeadFormProps = {
+  orgId: OrgId;
+  project: Project;
+  members: readonly MemberWithUser[];
+  onSubmit: (input: unknown) => Promise<ActionResult<Project>>;
+};
+
+type LeadState = ActionResult<Project> | null;
+
+export function ProjectLeadForm(props: ProjectLeadFormProps) {
+  const { orgId, project, members, onSubmit } = props;
+
+  const [state, submit, pending] = useActionState<LeadState, FormData>(
+    async (_previous, formData) => {
+      const leadId = String(formData.get("leadId") ?? "");
+      const parsed = changeProjectLeadSchema.safeParse({
+        orgId,
+        projectId: project.id,
+        leadId: leadId.length === 0 ? null : (leadId as UserId),
+      });
+
+      if (!parsed.success) {
+        return {
+          ok: false,
+          error: {
+            code: "validation_failed",
+            message: "Check the fields below.",
+            fieldErrors: fieldErrorsFromZod(parsed.error),
+          },
+        };
+      }
+
+      return onSubmit(parsed.data);
+    },
+    null,
+  );
+
+  const fieldErrors = state?.ok === false ? (state.error.fieldErrors ?? {}) : {};
+
+  return (
+    <form action={submit} className="space-y-4">
+      {state?.ok === true ? (
+        <p className="rounded bg-emerald-50 px-3 py-2 text-sm text-emerald-700">
+          Project lead updated.
+        </p>
+      ) : null}
+      {state?.ok === false ? (
+        <p role="alert" className="text-sm text-rose-600">
+          {state.error.message}
+        </p>
+      ) : null}
+
+      <div className="space-y-1">
+        <label htmlFor="leadId" className="text-sm font-medium">
+          Lead
+        </label>
+        <select
+          id="leadId"
+          name="leadId"
+          defaultValue={project.leadId ?? ""}
+          className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
+        >
+          <option value="">No lead</option>
+          {members.map((member) => (
+            <option key={member.id} value={member.userId}>
+              {member.user.name}
+            </option>
+          ))}
+        </select>
+        {fieldErrors.leadId !== undefined ? (
+          <p className="text-xs text-rose-600">{fieldErrors.leadId[0]}</p>
+        ) : null}
+      </div>
+
+      <button
+        type="submit"
+        disabled={pending}
+        className="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white disabled:opacity-60"
+      >
+        {pending ? "Saving…" : "Save lead"}
+      </button>
+    </form>
+  );
+}

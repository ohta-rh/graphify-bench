+
+/** Whether an actor can see this project and its contents. */
+export async function canViewProject(
+  actor: Actor,
+  project: Project,
+): Promise<boolean> {
+  if (actor.orgId !== project.orgId) return false;
+  if (project.visibility !== "private") return true;
+  if (
+    actor.isPlatformStaff === true ||
+    actor.role === "admin" ||
+    actor.role === "owner" ||
+    project.leadId === actor.userId
+  ) {
+    return true;
+  }
+  return projectMemberRepo.isProjectMember(
+    project.orgId,
+    project.id,
+    actor.userId,
+  );
+}
+
+/** Hide inaccessible private projects as missing before normal RBAC checks. */
+export async function assertProjectVisible(
+  actor: Actor,
+  project: Project,
+): Promise<void> {
+  if (!(await canViewProject(actor, project))) {
+    throw new NotFoundError("Project", project.id);
+  }
 }
 

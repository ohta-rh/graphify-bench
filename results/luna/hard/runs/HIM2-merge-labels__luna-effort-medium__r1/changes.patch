+
+/** Atomically moves source assignments to target and removes the source label. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  if (input.sourceLabelId === input.targetLabelId) return null;
+
+  const db = getDb();
+  return db.transaction((tx) => {
+    const source = tx.select().from(labels).where(and(
+      orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId),
+    )).get();
+    const target = tx.select().from(labels).where(and(
+      orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.targetLabelId),
+    )).get();
+    if (!source || !target) return null;
+
+    const issuesRelabelled = tx.select({ value: count() }).from(issueLabels).where(and(
+      orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId),
+    )).get()?.value ?? 0;
+    const sharedIssues = tx.select({ issueId: issueLabels.issueId }).from(issueLabels).where(and(
+      orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId),
+      inArray(issueLabels.issueId, tx.select({ issueId: issueLabels.issueId }).from(issueLabels).where(and(
+        orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.targetLabelId),
+      ))),
+    )).all().map((row) => row.issueId);
+    if (sharedIssues.length) {
+      tx.delete(issueLabels).where(and(
+        orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.targetLabelId),
+        inArray(issueLabels.issueId, sharedIssues),
+      )).run();
+    }
+    tx.update(issueLabels).set({ labelId: input.targetLabelId }).where(and(
+      orgPredicate(issueLabels.orgId, input.orgId), eq(issueLabels.labelId, input.sourceLabelId),
+    )).run();
+    tx.delete(labels).where(and(
+      orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId),
+    )).run();
+    return { label: toLabel(target), issuesRelabelled };
+  });
 }
 

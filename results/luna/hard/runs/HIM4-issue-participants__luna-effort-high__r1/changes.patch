+export async function getIssueParticipants(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly UserId[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "comment:read", issueResource(issue));
+
+  const candidateIds = new Set<UserId>([
+    issue.authorId,
+    ...(issue.assigneeId === null ? [] : [issue.assigneeId]),
+    ...(await commentRepo.listCommentAuthorIds(orgId, issueId)),
+  ]);
+
+  const activeIds: UserId[] = [];
+  for (const userId of candidateIds) {
+    const member = await memberRepo.findMember(orgId, userId);
+    if (member?.status === "active") activeIds.push(userId);
+  }
+  return activeIds;
+}

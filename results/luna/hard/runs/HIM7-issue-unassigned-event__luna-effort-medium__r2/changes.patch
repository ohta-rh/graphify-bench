+/** Clears a member's assignment from every live issue in an organization. */
+export async function unassignLiveIssuesForUser(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly Issue[]> {
+  const db = getDb();
+  const rows = db
+    .select()
+    .from(issues)
+    .where(
+      and(
+        orgPredicate(issues.orgId, orgId),
+        eq(issues.assigneeId, userId),
+        isNull(issues.archivedAt),
+      ),
+    )
+    .all();
+  const unassigned: Issue[] = [];
+  for (const row of rows) {
+    const updated = db
+      .update(issues)
+      .set({ assigneeId: null, updatedAt: toIsoTimestamp(new Date()) })
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, row.id)))
+      .returning()
+      .get();
+    if (updated) unassigned.push(toIssue(updated));
+  }
+  return unassigned;
+}

+
+/** Moves source assignments to target, deduplicating issue-label pairs, then removes source. */
+export async function mergeLabels(
+  orgId: OrgId,
+  sourceLabelId: LabelId,
+  targetLabelId: LabelId,
+): Promise<{ label: IssueLabel | null; issuesRelabelled: number }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const [source, target] = [sourceLabelId, targetLabelId].map((labelId) =>
+      tx.select().from(labels)
+        .where(and(orgPredicate(labels.orgId, orgId), eq(labels.id, labelId)))
+        .get(),
+    );
+    if (!source || !target) return { label: null, issuesRelabelled: 0 };
+
+    const assignments = tx.select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, orgId),
+        eq(issueLabels.labelId, sourceLabelId),
+      ))
+      .all();
+    const issuesRelabelled = assignments.length;
+
+    tx.delete(issueLabels)
+      .where(and(
+        orgPredicate(issueLabels.orgId, orgId),
+        eq(issueLabels.labelId, sourceLabelId),
+      ))
+      .run();
+    for (const { issueId } of assignments) {
+      tx.insert(issueLabels)
+        .values({ orgId, issueId, labelId: targetLabelId })
+        .onConflictDoNothing()
+        .run();
+    }
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, orgId), eq(labels.id, sourceLabelId)))
+      .run();
+    return { label: toLabel(target), issuesRelabelled };
+  });
 }
 

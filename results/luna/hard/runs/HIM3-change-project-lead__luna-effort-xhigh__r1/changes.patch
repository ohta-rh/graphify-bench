+"use server";
+
+/** Changes the lead of one project through its dedicated permission. */
+
+import { withAction } from "@/actions/_lib/with-action";
+import { CACHE_PROFILES, projectTag, revalidateTagged } from "@/lib/cache";
+import {
+  changeProjectLeadSchema,
+  type ChangeProjectLeadInput,
+} from "@/schemas/project";
+import { changeProjectLead } from "@/server/services/project-service";
+import type { ActionResult } from "@/types/api";
+import type { Project } from "@/types/project";
+
+const run = withAction<typeof changeProjectLeadSchema, Project>(
+  changeProjectLeadSchema,
+  async (raw, actor) => {
+    const input = raw as ChangeProjectLeadInput;
+    const project = await changeProjectLead(actor, input);
+    revalidateTagged([projectTag(project.id)], CACHE_PROFILES.minutes);
+    return project;
+  },
+  { revalidate: ["projects"], cacheProfile: "minutes" },
+);
+
+export async function changeProjectLeadAction(
+  raw: unknown,
+): Promise<ActionResult<Project>> {
+  return run(raw);
+}

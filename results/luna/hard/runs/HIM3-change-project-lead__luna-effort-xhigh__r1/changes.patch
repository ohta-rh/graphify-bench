+export async function changeProjectLead(
+  actor: Actor,
+  input: ChangeProjectLeadInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:change_lead", projectResource(project));
+  assertNotArchived("Project", project.id, project);
+
+  if (input.leadId !== null) {
+    const currentMember = await memberRepo.findMember(input.orgId, input.leadId);
+    const member = requireFound(
+      currentMember?.status === "active" ? currentMember : null,
+      "Member",
+      input.leadId,
+    );
+
+    const candidate: Actor = {
+      userId: member.userId,
+      orgId: input.orgId,
+      role: member.role,
+    };
+    assertCan(candidate, "project:update", projectResource(project));
+  }
+
+  return projectRepo.updateProjectLead(
+    input.orgId,
+    input.projectId,
+    input.leadId,
+  );
 }
 

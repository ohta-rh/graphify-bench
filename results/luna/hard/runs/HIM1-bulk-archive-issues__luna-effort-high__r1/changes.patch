+export async function bulkArchiveIssues(
+  actor: Actor,
+  input: BulkArchiveIssuesInput,
+): Promise<{ archived: readonly IssueId[]; skipped: readonly IssueId[] }> {
+  assertOrgScope(actor, input.orgId);
+
+  const requestedIds = [...new Set(input.issueIds)];
+  const found = await issueRepo.findIssuesByIds(input.orgId, requestedIds);
+  const byId = new Map(found.map((issue) => [issue.id, issue]));
+  const archivedCandidates: Issue[] = [];
+  const skipped: IssueId[] = [];
+
+  for (const issueId of requestedIds) {
+    const issue = byId.get(issueId);
+    if (!issue || issue.archivedAt !== null) {
+      skipped.push(issueId);
+      continue;
+    }
+    // Check every live candidate before writing any row, so a denial is atomic.
+    assertCan(actor, "issue:archive", issueResource(issue));
+    archivedCandidates.push(issue);
+  }
+
+  const archived: IssueId[] = [];
+  for (const issue of archivedCandidates) {
+    const result = await issueRepo.archiveIssue(input.orgId, issue.id);
+    archived.push(result.id);
+  }
+
+  for (const issue of archivedCandidates) {
+    await emit("issue.archived", {
+      ...actorEnvelope(actor),
+      issueId: issue.id,
+      projectId: issue.projectId,
+    });
+  }
+
+  return { archived, skipped };
 }
 

+export async function bulkArchiveIssues(
+  actor: Actor,
+  input: BulkArchiveIssuesInput,
+): Promise<{ archived: readonly IssueId[]; skipped: readonly IssueId[] }> {
+  assertOrgScope(actor, input.orgId);
+
+  const requestedIds = [...new Set(input.issueIds)];
+  const foundIssues = await issueRepo.findIssuesByIds(input.orgId, requestedIds);
+  const issuesById = new Map<IssueId, Issue>(
+    foundIssues.map((issue): [IssueId, Issue] => [issue.id, issue]),
+  );
+  const archivedBefore = requestedIds.flatMap((issueId) => {
+    const issue = issuesById.get(issueId);
+    return issue !== undefined && issue.archivedAt === null
+      ? [issue]
+      : [];
+  });
+
+  // Check every live match before writing anything, so a denial is atomic.
+  for (const issue of archivedBefore) {
+    assertCan(actor, "issue:archive", issueResource(issue));
+  }
+
+  const skipped = requestedIds.filter((issueId) => {
+    const issue = issuesById.get(issueId);
+    return issue === undefined || issue.archivedAt !== null;
+  });
+  const archived: IssueId[] = [];
+
+  for (const issue of archivedBefore) {
+    const result = await issueRepo.archiveIssue(input.orgId, issue.id);
+    archived.push(result.id);
+  }
+
+  for (const issueId of archived) {
+    const issue = issuesById.get(issueId)!;
+    await emit("issue.archived", {
+      ...actorEnvelope(actor),
+      issueId,
+      projectId: issue.projectId,
+    });
+  }
+
+  return { archived, skipped };
 }
 

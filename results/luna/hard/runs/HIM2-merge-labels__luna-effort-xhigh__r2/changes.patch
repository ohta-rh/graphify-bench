+/**
+ * Repoints every source assignment to the target and removes the source label.
+ * The transaction validates both labels before changing any rows.
+ */
+export async function mergeLabels(
+  orgId: OrgId,
+  sourceLabelId: LabelId,
+  targetLabelId: LabelId,
+): Promise<
+  | { label: IssueLabel; issuesRelabelled: number }
+  | { missingLabelId: LabelId }
+> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const source = tx
+      .select({ id: labels.id })
+      .from(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, orgId),
+          eq(labels.id, sourceLabelId),
+        ),
+      )
+      .get();
+    if (!source) return { missingLabelId: sourceLabelId };
+
+    const target = tx
+      .select()
+      .from(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, orgId),
+          eq(labels.id, targetLabelId),
+        ),
+      )
+      .get();
+    if (!target) return { missingLabelId: targetLabelId };
+
+    const sourceAssignments = and(
+      orgPredicate(issueLabels.orgId, orgId),
+      eq(issueLabels.labelId, sourceLabelId),
+    );
+    const issuesRelabelled = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(sourceAssignments)
+      .all().length;
+
+    // Remove source rows for issues that already have the target, avoiding
+    // the issue_labels unique index when the remaining rows are updated.
+    tx.delete(issueLabels)
+      .where(
+        and(
+          sourceAssignments,
+          inArray(
+            issueLabels.issueId,
+            tx
+              .select({ issueId: issueLabels.issueId })
+              .from(issueLabels)
+              .where(
+                and(
+                  orgPredicate(issueLabels.orgId, orgId),
+                  eq(issueLabels.labelId, targetLabelId),
+                ),
+              ),
+          ),
+        ),
+      )
+      .run();
+
+    tx.update(issueLabels)
+      .set({ labelId: targetLabelId })
+      .where(sourceAssignments)
+      .run();
+    tx.delete(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, orgId),
+          eq(labels.id, sourceLabelId),
+        ),
+      )
+      .run();
+
+    return { label: toLabel(target), issuesRelabelled };
+  });
+}

+/** Returns the live organization members who have participated in an issue. */
+export async function getIssueParticipants(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly UserId[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "comment:read", issueResource(issue));
+
+  const participantIds = new Set<UserId>([issue.authorId]);
+  if (issue.assigneeId !== null) participantIds.add(issue.assigneeId);
+  for (const authorId of await commentRepo.listCommentAuthorIds(orgId, issueId)) {
+    participantIds.add(authorId);
+  }
+
+  const activeMembers = await memberRepo.listMembers({
+    orgId,
+    limit: 1000,
+    cursor: null,
+    status: "active",
+  });
+  const activeUserIds = new Set(activeMembers.items.map((member) => member.userId));
+  return [...participantIds].filter((userId) => activeUserIds.has(userId));
+}

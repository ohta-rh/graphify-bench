+/** Live issues owned by a member, used when their organization membership ends. */
+export async function listLiveIssuesAssignedTo(
+  orgId: OrgId,
+  assigneeId: UserId,
+): Promise<Issue[]> {
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(
+        orgPredicate(issues.orgId, orgId),
+        eq(issues.assigneeId, assigneeId),
+        isNull(issues.archivedAt),
+      ),
+    )
+    .all();
+
+  return rows.map(toIssue);
+}

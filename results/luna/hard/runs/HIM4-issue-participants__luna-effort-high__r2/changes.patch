+/** Distinct authors of comments that are still present in the issue thread. */
+export async function listCommentAuthorIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly UserId[]> {
+  const rows = getDb()
+    .selectDistinct({ authorId: comments.authorId })
+    .from(comments)
+    .where(
+      and(
+        orgPredicate(comments.orgId, orgId),
+        eq(comments.issueId, issueId),
+        isNull(comments.archivedAt),
+      ),
+    )
+    .all();
+
+  return rows.map((row) => row.authorId as UserId);
+}

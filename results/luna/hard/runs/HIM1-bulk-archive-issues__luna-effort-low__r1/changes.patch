+export async function bulkArchiveIssues(
+  actor: Actor,
+  input: BulkArchiveIssuesInput,
+): Promise<{ archived: readonly IssueId[]; skipped: readonly IssueId[] }> {
+  assertOrgScope(actor, input.orgId);
+
+  const requested = [...new Set(input.issueIds)];
+  const issues = await issueRepo.findIssuesByIds(input.orgId, requested);
+  const byId = new Map(issues.map((issue) => [issue.id, issue]));
+  const archived: IssueId[] = [];
+  const skipped: IssueId[] = [];
+
+  for (const issueId of requested) {
+    const issue = byId.get(issueId);
+    if (!issue || issue.archivedAt !== null) {
+      skipped.push(issueId);
+      continue;
+    }
+    assertCan(actor, "issue:archive", issueResource(issue));
+    archived.push(issueId);
+  }
+
+  // Permission checks finish before the first write, so a denied batch is atomic.
+  for (const issueId of archived) {
+    const issue = await issueRepo.archiveIssue(input.orgId, issueId);
+    await emit("issue.archived", {
+      ...actorEnvelope(actor),
+      issueId: issue.id,
+      projectId: issue.projectId,
+    });
+  }
+
+  return { archived, skipped };
 }
 

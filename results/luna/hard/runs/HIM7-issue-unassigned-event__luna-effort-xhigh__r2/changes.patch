+/** Unassigns every live issue assigned to a removed member and returns event data. */
+export async function unassignLiveIssuesForUser(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly { issueId: IssueId; projectId: ProjectId }[]> {
+  const rows = getDb()
+    .update(issues)
+    .set({ assigneeId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.assigneeId, userId),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    )
+    .returning({ issueId: issues.id, projectId: issues.projectId })
+    .all();
+
+  return rows.map((row) => ({
+    issueId: row.issueId as IssueId,
+    projectId: row.projectId as ProjectId,
+  }));
+}

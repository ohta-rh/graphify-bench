+/**
+ * Whether an actor may see a project, independent of the action-specific
+ * permission matrix. Private project access is granted by role, staff status,
+ * project lead, or explicit project membership.
+ */
+export async function canViewProject(
+  actor: Actor,
+  project: Project,
+): Promise<boolean> {
+  if (actor.orgId !== project.orgId) return false;
+  if (project.visibility !== "private") return true;
+  if (
+    actor.role === "admin" ||
+    actor.role === "owner" ||
+    actor.isPlatformStaff === true ||
+    project.leadId === actor.userId
+  ) {
+    return true;
+  }
+  return projectMemberRepo.isProjectMember(
+    project.orgId,
+    project.id,
+    actor.userId,
+  );
+}

+export async function mergeLabels(
+  actor: Actor,
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number }> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "project:archive", orgResource(input.orgId));
+  if (input.sourceLabelId === input.targetLabelId) {
+    throw new Error("Source and target labels must be different");
+  }
+  const result = await labelRepo.mergeLabels(input);
+  if (!result) {
+    throw new NotFoundError("Label", input.sourceLabelId);
+  }
+  return result;

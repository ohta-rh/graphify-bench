+
+/** Moves all source assignments to the target and removes the source label atomically. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  if (input.sourceLabelId === input.targetLabelId) return null;
+
+  const db = getDb();
+  return db.transaction((tx) => {
+    const found = tx
+      .select()
+      .from(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, input.orgId),
+          inArray(labels.id, [input.sourceLabelId, input.targetLabelId]),
+        ),
+      )
+      .all();
+    const source = found.find((row) => row.id === input.sourceLabelId);
+    const target = found.find((row) => row.id === input.targetLabelId);
+    if (!source || !target) return null;
+
+    const sourceAssignments = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+        ),
+      )
+      .all();
+
+    for (const { issueId } of sourceAssignments) {
+      const targetAlreadyAssigned = tx
+        .select({ issueId: issueLabels.issueId })
+        .from(issueLabels)
+        .where(
+          and(
+            orgPredicate(issueLabels.orgId, input.orgId),
+            eq(issueLabels.issueId, issueId),
+            eq(issueLabels.labelId, input.targetLabelId),
+          ),
+        )
+        .get();
+      if (targetAlreadyAssigned) {
+        tx.delete(issueLabels)
+          .where(
+            and(
+              orgPredicate(issueLabels.orgId, input.orgId),
+              eq(issueLabels.issueId, issueId),
+              eq(issueLabels.labelId, input.sourceLabelId),
+            ),
+          )
+          .run();
+      } else {
+        tx.update(issueLabels)
+          .set({ labelId: input.targetLabelId })
+          .where(
+            and(
+              orgPredicate(issueLabels.orgId, input.orgId),
+              eq(issueLabels.issueId, issueId),
+              eq(issueLabels.labelId, input.sourceLabelId),
+            ),
+          )
+          .run();
+      }
+    }
+
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, input.orgId), eq(labels.id, input.sourceLabelId)))
+      .run();
+    return { label: toLabel(target), issuesRelabelled: sourceAssignments.length };
+  });
 }
 

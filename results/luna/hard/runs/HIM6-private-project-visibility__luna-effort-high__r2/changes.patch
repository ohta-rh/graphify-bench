+/** Whether an actor may see a project under its visibility rules. */
+export async function canViewProject(actor: Actor, project: Project): Promise<boolean> {
+  if (actor.orgId !== project.orgId) return false;
+  if (project.visibility !== "private") return true;
+  if (actor.role === "admin" || actor.role === "owner" || actor.isPlatformStaff) return true;
+  if (project.leadId === actor.userId) return true;
+  return projectMemberRepo.isProjectMember(project.orgId, project.id, actor.userId);
+}
+
+/** Hide inaccessible private projects behind the same response as a missing row. */
+export async function assertProjectVisible(actor: Actor, project: Project): Promise<void> {
+  if (!(await canViewProject(actor, project))) {
+    throw new NotFoundError("Project", project.id);
+  }
+}
+
+export async function hiddenPrivateProjectIds(actor: Actor): Promise<import("@/types/common").ProjectId[]> {
+  if (actor.role === "admin" || actor.role === "owner" || actor.isPlatformStaff) return [];
+  const privateProjects = await projectRepo.listPrivateProjects(actor.orgId);
+  const memberIds = new Set(await projectMemberRepo.listProjectIdsForMember(actor.orgId, actor.userId));
+  return privateProjects
+    .filter((project) => project.leadId !== actor.userId && !memberIds.has(project.id))
+    .map((project) => project.id);
+}

+
+/** Atomically moves every source assignment and deletes the source label. */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  if (input.sourceLabelId === input.targetLabelId) return null;
+
+  const db = getDb();
+  return db.transaction((tx) => {
+    const foundLabels = tx
+      .select()
+      .from(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, input.orgId),
+          inArray(labels.id, [input.sourceLabelId, input.targetLabelId]),
+        ),
+      )
+      .all();
+    const source = foundLabels.find((label) => label.id === input.sourceLabelId);
+    const target = foundLabels.find((label) => label.id === input.targetLabelId);
+    if (!source || !target) return null;
+
+    const sourceAssignments = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+        ),
+      )
+      .all();
+
+    if (sourceAssignments.length > 0) {
+      tx.insert(issueLabels)
+        .values(
+          sourceAssignments.map(({ issueId }) => ({
+            orgId: input.orgId,
+            issueId,
+            labelId: input.targetLabelId,
+          })),
+        )
+        .onConflictDoNothing()
+        .run();
+    }
+
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+        ),
+      )
+      .run();
+    tx.delete(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, input.orgId),
+          eq(labels.id, input.sourceLabelId),
+        ),
+      )
+      .run();
+
+    return { label: toLabel(target), issuesRelabelled: sourceAssignments.length };
+  });
 }
 

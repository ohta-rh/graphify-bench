+
+/**
+ * Reassigns all source-label joins and removes the source in one transaction.
+ * Returns null before writing if either label is absent from the organization.
+ */
+export async function mergeLabels(
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number } | null> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const rows = tx
+      .select()
+      .from(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, input.orgId),
+          inArray(labels.id, [input.sourceLabelId, input.targetLabelId]),
+        ),
+      )
+      .all();
+    if (rows.length !== 2) return null;
+
+    const target = rows.find((row) => row.id === input.targetLabelId);
+    if (!target) return null;
+
+    const sourceAssignments = tx
+      .select({ value: count() })
+      .from(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+        ),
+      )
+      .get();
+
+    const targetIssueIds = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.targetLabelId),
+        ),
+      );
+
+    // Remove source joins already paired with a target join to preserve the
+    // issue/label unique constraint, then retarget every remaining source join.
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+          inArray(issueLabels.issueId, targetIssueIds),
+        ),
+      )
+      .run();
+    tx.update(issueLabels)
+      .set({ labelId: input.targetLabelId })
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, input.orgId),
+          eq(issueLabels.labelId, input.sourceLabelId),
+        ),
+      )
+      .run();
+    tx.delete(labels)
+      .where(
+        and(
+          orgPredicate(labels.orgId, input.orgId),
+          eq(labels.id, input.sourceLabelId),
+        ),
+      )
+      .run();
+
+    return {
+      label: toLabel(target),
+      issuesRelabelled: sourceAssignments?.value ?? 0,
+    };
+  });
 }
 

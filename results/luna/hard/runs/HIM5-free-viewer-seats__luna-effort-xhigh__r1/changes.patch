@@ -0,0 +1,80 @@
+/** Shared seat accounting for invitations and role promotions. */
+import { getPlanLimits, wouldExceedLimit } from "@/config/plan-limits";
+import * as invitationRepo from "@/server/repositories/invitation-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import type { OrgId } from "@/types/common";
+import type { LimitCheck } from "@/types/billing";
+import { requireFound } from "./_support";
+
+/** Billable active members plus pending invitations for billable roles. */
+export async function countSeatsInUse(orgId: OrgId): Promise<number> {
+  const [activeMembers, pendingInvitations] = await Promise.all([
+    memberRepo.countBillableActiveMembers(orgId),
+    invitationRepo.countBillablePendingInvitations(orgId),
+  ]);
+  return activeMembers + pendingInvitations;
+}
+
+/** Seat check shown on the invitation page, including billable reservations. */
+export async function getSeatReservationCheck(
+  orgId: OrgId,
+): Promise<LimitCheck> {
+  const org = requireFound(
+    await orgRepo.findOrgById(orgId),
+    "Organization",
+    orgId,
+  );
+  const limits = getPlanLimits(org.plan);
+  const used = await countSeatsInUse(orgId);
+
+  return {
+    resource: "seats",
+    plan: org.plan,
+    limit: limits.seats,
+    used,
+    remaining: Math.max(0, limits.seats - used),
+    exceeded: wouldExceedLimit(org.plan, "seats", used),
+  };
+}
+
+/** Refuses a write that would reserve more seats than the organization's plan. */
+export async function assertSeatsAvailable(
+  orgId: OrgId,
+  requestedSeats: number,
+): Promise<void> {
+  if (requestedSeats <= 0) return;
+
+  const org = requireFound(
+    await orgRepo.findOrgById(orgId),
+    "Organization",
+    orgId,
+  );
+  const seatsUsed = await countSeatsInUse(orgId);
+  const limits = getPlanLimits(org.plan);
+
+  if (wouldExceedLimit(org.plan, "seats", seatsUsed, requestedSeats)) {
+    throw new Error(
+      `Plan ${org.plan} includes ${limits.seats} seats and ${seatsUsed} are taken`,
+    );
+  }
+}
+
+/** Ensures a previously reserved billable invitation still fits after a downgrade. */
+export async function assertReservedSeatWithinLimit(
+  orgId: OrgId,
+): Promise<void> {
+  const org = requireFound(
+    await orgRepo.findOrgById(orgId),
+    "Organization",
+    orgId,
+  );
+  const seatsUsed = await countSeatsInUse(orgId);
+  const limits = getPlanLimits(org.plan);
+
+  if (wouldExceedLimit(org.plan, "seats", seatsUsed, 0)) {
+    throw new Error(
+      `Plan ${org.plan} includes ${limits.seats} seats and ${seatsUsed} are taken`,
+    );
+  }
+}

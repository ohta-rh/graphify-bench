+    { userId, orgId, role: member.role },
+    "org:restore",
+    orgResource(orgId),
+  );
+
+  const restored = await orgRepo.restoreOrg(orgId);
+  await emit("organization.restored", {
+    ...envelope(restored.id, userId),
+    slug: restored.slug,
+  });
+  return restored;
 }
 

+/** Workspace-scoped, replaceable absence records for active members. */
+import { and, eq } from "drizzle-orm";
+import { getDb, memberAbsences } from "@/server/db";
+import type { SetAbsenceInput } from "@/schemas/member";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { MemberAbsence } from "@/types/member";
+import { orgPredicate } from "./base-repository";
+import { toMemberAbsence } from "./_mappers";
+
+export async function findAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  const row = getDb()
+    .select()
+    .from(memberAbsences)
+    .where(
+      and(
+        orgPredicate(memberAbsences.orgId, orgId),
+        eq(memberAbsences.userId, userId),
+      ),
+    )
+    .get();
+  return row ? toMemberAbsence(row) : null;
+}
+
+/** Returns an absence only when `at` lies in its half-open interval. */
+export async function findAbsenceAt(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<MemberAbsence | null> {
+  const absence = await findAbsence(orgId, userId);
+  if (absence === null) return null;
+
+  const instant = new Date(at).getTime();
+  return new Date(absence.startsAt).getTime() <= instant &&
+    instant < new Date(absence.endsAt).getTime()
+    ? absence
+    : null;
+}
+
+export async function upsertAbsence(
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  const row = getDb()
+    .insert(memberAbsences)
+    .values({
+      orgId: input.orgId,
+      userId: input.userId,
+      delegateUserId: input.delegateUserId,
+      startsAt: input.startsAt,
+      endsAt: input.endsAt,
+      note: input.note,
+    })
+    .onConflictDoUpdate({
+      target: [memberAbsences.orgId, memberAbsences.userId],
+      set: {
+        delegateUserId: input.delegateUserId,
+        startsAt: input.startsAt,
+        endsAt: input.endsAt,
+        note: input.note,
+      },
+    })
+    .returning()
+    .get();
+  return toMemberAbsence(row);
+}
+
+export async function deleteAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<void> {
+  getDb()
+    .delete(memberAbsences)
+    .where(
+      and(
+        orgPredicate(memberAbsences.orgId, orgId),
+        eq(memberAbsences.userId, userId),
+      ),
+    )
+    .run();
+}

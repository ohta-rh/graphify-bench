+  assertOrgScope(actor, orgId);
+  await requireActiveMember(orgId, userId);
+
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  if (absence === null) return null;
+  return new Date(absence.endsAt).getTime() > Date.now() ? absence : null;

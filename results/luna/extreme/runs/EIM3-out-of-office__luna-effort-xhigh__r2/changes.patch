+/** Creates or replaces a member's workspace-specific absence window. */
+export async function setAbsence(
+  actor: Actor,
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+
+  const member = await requireActiveMember(input.orgId, input.userId);
+  assertMayChangeAbsence(actor, member);
+
+  const start = new Date(input.startsAt).getTime();
+  const end = new Date(input.endsAt).getTime();
+  if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) {
+    throw new Error("Absence end must be after its start");
+  }
+
+  if (input.delegateUserId !== null) {
+    if (input.delegateUserId === input.userId) {
+      throw new Error("A member cannot delegate their absence to themselves");
+    }
+    await requireActiveMember(input.orgId, input.delegateUserId);
+  }
+
+  return absenceRepo.upsertAbsence(input);
+}
+
+/** Clears the target member's absence; an already-clear member is unchanged. */
+export async function clearAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,
+): Promise<void> {
+  assertOrgScope(actor, orgId);
+
+  const member = await requireActiveMember(orgId, userId);
+  assertMayChangeAbsence(actor, member);
+  await absenceRepo.deleteAbsence(orgId, userId);
+}
+
+/** Returns a scheduled or current absence until its exclusive end instant. */
+export async function getAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,

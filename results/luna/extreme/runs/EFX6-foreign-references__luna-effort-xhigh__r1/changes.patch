+async function requireCurrentMember(
+  orgId: OrgId,
+  userId: Issue["assigneeId"],
+): Promise<void> {
+  if (userId === null) return;
+
+  const member = await memberRepo.findMember(orgId, userId);
+  if (member === null || member.status !== "active") {
+    throw new NotFoundError("Member", userId);
+  }
+}
+
+async function requireLiveParentIssue(
+  orgId: OrgId,
+  projectId: ProjectId,
+  parentId: Issue["parentId"],
+): Promise<void> {
+  if (parentId === null) return;
+
+  const parent = requireFound(
+    await issueRepo.findIssueById(orgId, parentId),
+    "Issue",
+    parentId,
+  );
+  if (parent.archivedAt !== null || parent.projectId !== projectId) {
+    throw new NotFoundError("Issue", parentId);
+  }
+}
+
+async function requireOrgLabels(
+  orgId: OrgId,
+  labelIds: CreateIssueInput["labelIds"],
+): Promise<CreateIssueInput["labelIds"]> {
+  const uniqueLabelIds = [...new Set(labelIds)];
+  if (uniqueLabelIds.length === 0) return uniqueLabelIds;
+
+  const labels = await labelRepo.listLabels(orgId);
+  const available = new Set(labels.map((label) => label.id));
+  const missing = uniqueLabelIds.find((labelId) => !available.has(labelId));
+  if (missing !== undefined) throw new NotFoundError("Label", missing);
+
+  return uniqueLabelIds;
 }

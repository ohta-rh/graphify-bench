+/** Lists a complete filtered range, walking the stable keyset in pages. */
+export async function listAllActivity(
+  input: Omit<ActivityFilterInput, "limit" | "cursor">,
+): Promise<readonly ActivityEvent[]> {
+  const items: ActivityEvent[] = [];
+  let cursor: string | null = null;
+
+  do {
+    const page = await listActivity({ ...input, limit: 100, cursor });
+    items.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+
+  return items;
 }
 

+  const labels = await labelRepo.listLabels(orgId);
+  const available = new Set(labels.map((label) => label.id));
+  const invalidId = labelIds.find((labelId) => !available.has(labelId));
+  if (invalidId !== undefined) throw new NotFoundError("Label", invalidId);
 }

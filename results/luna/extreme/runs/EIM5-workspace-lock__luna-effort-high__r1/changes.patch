@@ -0,0 +1,31 @@
+import type { OrgId } from "@/types/common";
+import type { Subscription, WorkspaceLockReason } from "@/types/billing";
+
+export class WorkspaceLockedError extends Error {
+  readonly code = "plan_limit_exceeded" as const;
+
+  constructor(
+    readonly orgId: OrgId,
+    readonly reason: WorkspaceLockReason,
+  ) {
+    super("This workspace is read-only while its subscription is not in good standing.");
+    this.name = "WorkspaceLockedError";
+  }
+}
+
+export function lockReasonFor(
+  subscription: Subscription | null,
+  now: Date = new Date(),
+): WorkspaceLockReason | null {
+  if (!subscription || subscription.status === "active") return null;
+  if (subscription.status === "past_due") return "past_due";
+  if (subscription.status === "trialing") {
+    return now.getTime() >= Date.parse(subscription.currentPeriodEnd)
+      ? "trial_ended"
+      : null;
+  }
+  if (subscription.cancelAt === null || now.getTime() >= Date.parse(subscription.cancelAt)) {
+    return "canceled";
+  }
+  return null;
+}

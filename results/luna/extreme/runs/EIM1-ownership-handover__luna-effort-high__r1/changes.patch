--- /private/tmp/luna-scratch-20261008/e413f1f0-221d-4f3a-ad12-20bb59a44003/src/server/repositories/ownership-handover-repository.ts	1970-01-01 09:00:00
+++ /private/tmp/luna-scratch-20261008/b3e7b1c5-c851-4987-ba74-263fcb0730d1/src/server/repositories/ownership-handover-repository.ts	2026-10-08 15:45:25
@@ -0,0 +1,144 @@
+import { and, desc, eq, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { OwnershipHandoverError } from "@/lib/errors";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toMember, toOrganization, toOwnershipHandover } from "./_mappers";
+import type { OrgId, UserId } from "@/types/common";
+import type { Member, Role } from "@/types/member";
+import type { Organization, OwnershipHandover } from "@/types/organization";
+
+export async function findLatest(orgId: OrgId): Promise<OwnershipHandover | null> {
+  const row = getDb().select().from(ownershipHandovers)
+    .where(and(eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending")))
+    .orderBy(desc(ownershipHandovers.createdAt)).get();
+  if (!row) return null;
+  if (row.expiresAt <= toIsoTimestamp(new Date())) {
+    const expired = getDb().update(ownershipHandovers)
+      .set({ status: "expired", resolvedAt: row.expiresAt })
+      .where(eq(ownershipHandovers.id, row.id)).returning().get();
+    return expired ? toOwnershipHandover(expired) : null;
+  }
+  return toOwnershipHandover(row);
+}
+
+export async function findLatestRecord(orgId: OrgId): Promise<OwnershipHandover | null> {
+  const row = getDb().select().from(ownershipHandovers)
+    .where(eq(ownershipHandovers.orgId, orgId))
+    .orderBy(desc(ownershipHandovers.createdAt)).get();
+  return row ? toOwnershipHandover(row) : null;
+}
+
+export async function create(
+  orgId: OrgId,
+  fromUserId: UserId,
+  toUserId: UserId,
+): Promise<OwnershipHandover> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const now = toIsoTimestamp(new Date());
+    const pending = tx.select().from(ownershipHandovers).where(and(
+      eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+    )).get();
+    if (pending && pending.expiresAt > now) throw new OwnershipHandoverError("pending_exists");
+    if (pending) tx.update(ownershipHandovers).set({ status: "expired", resolvedAt: pending.expiresAt })
+      .where(eq(ownershipHandovers.id, pending.id)).run();
+    const row = tx.insert(ownershipHandovers).values({
+      id: newId(), orgId, fromUserId, toUserId, status: "pending",
+      createdAt: now, expiresAt: toIsoTimestamp(new Date(Date.parse(now) + 7 * 24 * 60 * 60 * 1000)), resolvedAt: null,
+    }).returning().get();
+    return toOwnershipHandover(row);
+  });
+}
+
+export async function resolve(
+  id: string,
+  status: "accepted" | "declined" | "canceled",
+): Promise<{ expired: true } | { expired: false; handover: OwnershipHandover }> {
+  return getDb().transaction((tx) => {
+    const offer = tx.select().from(ownershipHandovers).where(and(
+      eq(ownershipHandovers.id, id), eq(ownershipHandovers.status, "pending"),
+    )).get();
+    if (!offer) throw new Error(`Pending ownership handover ${id} not found`);
+    const now = toIsoTimestamp(new Date());
+    if (offer.expiresAt <= now) {
+      tx.update(ownershipHandovers).set({ status: "expired", resolvedAt: offer.expiresAt })
+        .where(eq(ownershipHandovers.id, id)).run();
+      return { expired: true as const };
+    }
+    const row = tx.update(ownershipHandovers).set({ status, resolvedAt: now })
+      .where(and(eq(ownershipHandovers.id, id), eq(ownershipHandovers.status, "pending")))
+      .returning().get();
+    if (!row) throw new Error(`Pending ownership handover ${id} not found`);
+    return { expired: false as const, handover: toOwnershipHandover(row) };
+  });
+}
+
+export async function cancelForLeaving(orgId: OrgId, userId: UserId): Promise<void> {
+  const pending = getDb().select().from(ownershipHandovers)
+    .where(and(eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"))).all();
+  const stamp = toIsoTimestamp(new Date());
+  for (const row of pending) {
+    if (row.expiresAt <= stamp) {
+      getDb().update(ownershipHandovers).set({ status: "expired", resolvedAt: row.expiresAt })
+        .where(and(eq(ownershipHandovers.id, row.id), eq(ownershipHandovers.status, "pending"))).run();
+      continue;
+    }
+    if (row.fromUserId === userId || row.toUserId === userId) {
+      getDb().update(ownershipHandovers).set({ status: "canceled", resolvedAt: stamp })
+        .where(and(eq(ownershipHandovers.id, row.id), eq(ownershipHandovers.status, "pending"))).run();
+    }
+  }
+}
+
+export async function accept(
+  handoverId: string,
+  orgId: OrgId,
+  fromUserId: UserId,
+  toUserId: UserId,
+): Promise<{ expired: true } | { expired: false; organization: Organization; fromMember: Member | null; toMember: Member; fromRoleBefore: Role | null; toRoleBefore: Role }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const offer = tx.select().from(ownershipHandovers).where(and(
+      eq(ownershipHandovers.id, handoverId), eq(ownershipHandovers.orgId, orgId),
+      eq(ownershipHandovers.status, "pending"),
+    )).get();
+    if (!offer) throw new Error(`Pending ownership handover ${handoverId} not found`);
+    const now = toIsoTimestamp(new Date());
+    if (offer.expiresAt <= now) {
+      tx.update(ownershipHandovers).set({ status: "expired", resolvedAt: offer.expiresAt })
+        .where(eq(ownershipHandovers.id, handoverId)).run();
+      return { expired: true as const };
+    }
+    const toRow = tx.select().from(members).where(and(
+      eq(members.orgId, orgId), eq(members.userId, toUserId), eq(members.status, "active"),
+    )).get();
+    if (!toRow) throw new Error(`Active recipient member ${toUserId} disappeared`);
+    const fromRow = tx.select().from(members).where(and(
+      eq(members.orgId, orgId), eq(members.userId, fromUserId), isNull(members.archivedAt),
+    )).get();
+    let updatedTo = toRow;
+    let updatedFrom = fromRow;
+    // Promote first so the workspace never passes through an ownerless state.
+    if (toRow.role !== "owner") {
+      updatedTo = tx.update(members).set({ role: "owner", updatedAt: now }).where(eq(members.id, toRow.id)).returning().get();
+    }
+    const orgRow = tx.update(organizations).set({ ownerId: toUserId, updatedAt: now })
+      .where(eq(organizations.id, orgId)).returning().get();
+    if (!orgRow) throw new Error(`Organization ${orgId} not found`);
+    if (fromRow?.role === "owner") {
+      updatedFrom = tx.update(members).set({ role: "admin", updatedAt: now }).where(eq(members.id, fromRow.id)).returning().get();
+    }
+    const handover = tx.update(ownershipHandovers).set({ status: "accepted", resolvedAt: now })
+      .where(and(eq(ownershipHandovers.id, handoverId), eq(ownershipHandovers.status, "pending"))).returning().get();
+    if (!handover) throw new Error(`Pending ownership handover ${handoverId} not found`);
+    return {
+      expired: false as const,
+      organization: toOrganization(orgRow),
+      fromMember: updatedFrom ? toMember(updatedFrom) : null,
+      toMember: toMember(updatedTo),
+      fromRoleBefore: fromRow?.role ?? null,
+      toRoleBefore: toRow.role,
+    };
+  });
+}

+
+export async function initiateOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+  toUserId: UserId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  assertRecordedOwner(actor, org.ownerId);
+  if (toUserId === actor.userId) throw new OwnershipHandoverError("self");
+  const recipient = await memberRepo.findMember(orgId, toUserId);
+  if (!recipient || recipient.status !== "active") throw new NotFoundError("Member", toUserId);
+
+  const pending = await handoverRepo.findLatest(orgId);
+  if (pending) throw new OwnershipHandoverError("pending_exists");
+  const offer = await handoverRepo.create(orgId, actor.userId, toUserId);
+  await notify(orgId, "ownership_handover", [toUserId], {
+    title: "Workspace ownership offered",
+    body: `${actor.userId} invited you to become the workspace owner`,
+    href: "/settings/danger",
+    actorId: actor.userId,
+  });
+  return offer;
+}
+
+export async function acceptOwnershipHandover(actor: Actor, orgId: OrgId): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+  const current = await handoverRepo.findLatest(orgId);
+  if (!current || current.status !== "pending") {
+    const latest = await handoverRepo.findLatestRecord(orgId);
+    if (latest?.status === "expired" && latest.toUserId === actor.userId) throw new OwnershipHandoverError("expired");
+    throw new OwnershipHandoverError("nothing_pending");
+  }
+  if (current.toUserId !== actor.userId) throw new OwnershipHandoverError("nothing_pending");
+  if (Date.parse(current.expiresAt) <= Date.now()) {
+    await handoverRepo.findLatest(orgId);
+    throw new OwnershipHandoverError("expired");
+  }
+  const changed = await handoverRepo.accept(current.id, orgId, current.fromUserId, current.toUserId);
+  if (changed.expired) throw new OwnershipHandoverError("expired");
+  if (changed.toRoleBefore !== "owner") {
+    await emit("member.role_changed", { ...actorEnvelope(actor), memberId: changed.toMember.id, from: changed.toRoleBefore, to: "owner" });
+  }
+  if (changed.fromMember && changed.fromRoleBefore === "owner") {
+    await emit("member.role_changed", { ...actorEnvelope(actor), memberId: changed.fromMember.id, from: "owner", to: "admin" });
+  }
+  await emit("organization.ownership_transferred", {
+    ...actorEnvelope(actor), fromUserId: current.fromUserId, toUserId: current.toUserId,
+  });
+  return changed.organization;
+}
+
+export async function declineOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const current = await actionableHandover(actor.userId, orgId);
+  const result = await handoverRepo.resolve(current.id, "declined");
+  if (result.expired) throw new OwnershipHandoverError("expired");
+  return result.handover;
+}
+
+export async function cancelOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  assertRecordedOwner(actor, org.ownerId);
+  const current = await handoverRepo.findLatest(orgId);
+  if (!current || current.status !== "pending") throw new OwnershipHandoverError("nothing_pending");
+  const result = await handoverRepo.resolve(current.id, "canceled");
+  if (result.expired) throw new OwnershipHandoverError("nothing_pending");
+  return result.handover;
+}
+
+export async function getPendingOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:read", orgResource(orgId));
+  const current = await handoverRepo.findLatest(orgId);
+  return current?.status === "pending" ? current : null;
+}
+
+async function actionableHandover(userId: UserId, orgId: OrgId): Promise<OwnershipHandover> {
+  const current = await handoverRepo.findLatest(orgId);
+  if (current?.status === "pending") {
+    if (current.toUserId !== userId) throw new OwnershipHandoverError("nothing_pending");
+    return current;
+  }
+  const latest = await handoverRepo.findLatestRecord(orgId);
+  if (latest?.status === "expired" && latest.toUserId === userId) throw new OwnershipHandoverError("expired");
+  throw new OwnershipHandoverError("nothing_pending");
+}
+
+function assertRecordedOwner(actor: Actor, ownerId: UserId): void {
+  if (actor.userId === ownerId) return;
+  const decision: PermissionDecision = {
+    action: "org:ownership_handover", resourceKind: "organization", allowed: false, reason: "denied_by_role",
+  };
+  throw new PermissionDeniedError("org:ownership_handover", decision);
 }

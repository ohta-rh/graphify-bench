+  const db = getDb();
+  return db.transaction((tx) => {
+    const org = tx
+      .select({ archivedAt: organizations.archivedAt })
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    if (!org || org.archivedAt !== null) {
+      throw new Error("That organization no longer exists");
+    }
+
+    const consumed = tx
+      .update(invitations)
+      .set({ acceptedAt, updatedAt: acceptedAt })
+      .where(
+        and(
+          orgPredicate(invitations.orgId, orgId),
+          eq(invitations.id, invitationId),
+          isNull(invitations.acceptedAt),
+          isNull(invitations.revokedAt),

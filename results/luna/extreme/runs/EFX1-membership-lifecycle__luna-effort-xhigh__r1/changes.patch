+      throw new Error("You are already a member of this organization");
+    }
+
+    if (existing) {
+      const restored = tx
+        .update(members)
+        .set({
+          role,
+          status: "active",
+          invitedBy,
+          joinedAt: acceptedAt,
+          lastSeenAt: null,
+          archivedAt: null,
+          updatedAt: acceptedAt,
+        })
+        .where(
+          and(
+            orgPredicate(members.orgId, orgId),
+            eq(members.id, existing.id),
+          ),
+        )
+        .returning()
+        .get();

+/**
+ * Restores an organization while its deleted-workspace grace period is open.
+ * A bare user id is used because deleted organizations cannot resolve Actors.
+ */
+export async function restoreOrganization(
+  userId: UserId,
+  orgId: OrgId,
+): Promise<Organization> {
+  const org = requireFound(
+    await orgRepo.findOrgById(orgId),
+    "Organization",
+    orgId,
+  );
+
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") {
+    throw new NotFoundError("Organization", orgId);
+  }
+
+  if (org.archivedAt === null) return org;
+
+  const expiresAt =
+    new Date(org.archivedAt).getTime() +
+    DELETED_WORKSPACE_RETENTION_DAYS * 24 * 60 * 60 * 1000;
+  if (Date.now() >= expiresAt) {
+    throw new NotFoundError("Organization", orgId);
+  }
+
+  const actor: Actor = { userId, orgId, role: member.role };
+  assertCan(actor, "org:restore", orgResource(orgId));
+
+  const restored = await orgRepo.restoreOrg(orgId);
+  await emit("organization.restored", {
+    ...envelope(orgId, userId),
+    slug: restored.slug,
+  });
+  return restored;
 }
 

+export type StoredIssueImport = {
+  readonly projectId: ProjectId;
+  readonly issues: readonly Issue[];
+};
+
+export async function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): Promise<StoredIssueImport | null> {
+  const row = getDb()
+    .select()
+    .from(issueImports)
+    .where(
+      and(
+        eq(issueImports.orgId, orgId),
+        eq(issueImports.importKey, importKey),
+      ),
+    )
+    .get();
+  if (!row) return null;
+  return {
+    projectId: row.projectId as ProjectId,
+    issues: JSON.parse(row.issuesJson) as Issue[],
+  };
+}
+
+/** Inserts the complete batch, labels and idempotency snapshot in one transaction. */
+export async function insertImportedIssues(
+  orgId: OrgId,
+  projectId: ProjectId,
+  importKey: string,
+  rows: readonly ImportIssueRowInput[],
+  authorId: UserId,
+  firstNumber: number,
+): Promise<StoredIssueImport> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const existing = tx
+      .select()
+      .from(issueImports)
+      .where(
+        and(
+          eq(issueImports.orgId, orgId),
+          eq(issueImports.importKey, importKey),
+        ),
+      )
+      .get();
+    if (existing) {
+      return {
+        projectId: existing.projectId as ProjectId,
+        issues: JSON.parse(existing.issuesJson) as Issue[],
+      };
+    }
+
+    const now = toIsoTimestamp(new Date());
+    const activeMembers = tx
+      .select({ email: users.email, userId: users.id })
+      .from(members)
+      .innerJoin(users, eq(users.id, members.userId))
+      .where(
+        and(
+          eq(members.orgId, orgId),
+          eq(members.status, "active"),
+          isNull(members.archivedAt),
+        ),
+      )
+      .all();
+    const userByEmail = new Map(
+      activeMembers.map((member) => [
+        member.email.toLowerCase(),
+        member.userId as UserId,
+      ]),
+    );
+
+    const labelNames = [...new Set(rows.flatMap((row) => row.labels))];
+    const existingLabels =
+      labelNames.length === 0
+        ? []
+        : tx
+            .select()
+            .from(labels)
+            .where(
+              and(eq(labels.orgId, orgId), inArray(labels.name, labelNames)),
+            )
+            .all();
+    const labelByName = new Map(
+      existingLabels.map((label) => [label.name, label.id as LabelId]),
+    );
+    for (const name of labelNames) {
+      if (labelByName.has(name)) continue;
+      const labelId = newId();
+      tx
+        .insert(labels)
+        .values({
+          id: labelId,
+          orgId,
+          name,
+          color: "#94a3b8",
+          description: null,
+          createdAt: now,
+          updatedAt: now,
+        })
+        .run();
+      labelByName.set(name, labelId as LabelId);
+    }
+
+    const imported: Issue[] = [];
+    rows.forEach((row, index) => {
+      const id = newId();
+      const labelIds = [...new Set(row.labels)].map((name) => labelByName.get(name)!);
+      const dbRow = tx
+        .insert(issues)
+        .values({
+          id,
+          orgId,
+          projectId,
+          number: firstNumber + index,
+          title: row.title,
+          description: row.description,
+          status: row.status,
+          priority: row.priority,
+          authorId,
+          assigneeId:
+            row.assigneeEmail === null
+              ? null
+              : (userByEmail.get(row.assigneeEmail.toLowerCase()) ?? null),
+          parentId: null,
+          estimate: null,
+          dueAt: row.dueAt,
+          startedAt: null,
+          completedAt: null,
+          createdAt: now,
+          updatedAt: now,
+        })
+        .returning()
+        .get();
+      if (labelIds.length > 0) {
+        tx
+          .insert(issueLabels)
+          .values(labelIds.map((labelId) => ({ orgId, issueId: id, labelId })))
+          .run();
+      }
+      imported.push(toIssue(dbRow, labelIds));
+    });
+
+    tx
+      .insert(issueImports)
+      .values({
+        orgId,
+        importKey,
+        projectId,
+        issuesJson: JSON.stringify(imported),
+        createdAt: now,
+      })
+      .run();
+    return { projectId, issues: imported };
+  });
+}
 

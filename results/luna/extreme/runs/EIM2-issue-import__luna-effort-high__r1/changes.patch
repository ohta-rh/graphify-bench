+/** Imports a file as one authorized, quota-checked, idempotent batch. */
+export async function importIssues(
+  actor: Actor,
+  input: ImportIssuesInput,
+): Promise<IssueImportResult> {
+  assertOrgScope(actor, input.orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  const replay = await issueRepo.findIssueImport(input.orgId, input.importKey);
+  if (replay) {
+    return {
+      importKey: input.importKey,
+      projectId: replay.projectId,
+      issues: replay.issues,
+      replayed: true,
+    };
+  }
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  setOrgPlan(input.orgId, org.plan);
+  const used = await issueRepo.countIssues(input.orgId, input.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used, input.rows.length)) {
+    throw new Error(`Plan ${org.plan} allows no more issues in project ${project.key}`);
+  }
+
+  const verdict = await consumeRateLimit(input.orgId, "issue:create", input.rows.length);
+  if (!verdict.allowed) {
+    throw new Error(
+      `Issue creation rate limit reached; try again after ${verdict.resetAt}`,
+    );
+  }
+
+  const firstNumber = await issueRepo.nextIssueNumber(input.orgId, input.projectId);
+  const imported = await issueRepo.insertImportedIssues(
+    input.orgId,
+    input.projectId,
+    input.importKey,
+    input.rows,
+    actor.userId,
+    firstNumber,
+  );
+  await emit("issues.imported", {
+    ...actorEnvelope(actor),
+    projectId: imported.projectId,
+    importKey: input.importKey,
+    issueIds: imported.issues.map((issue) => issue.id),
+  });
+  return { importKey: input.importKey, ...imported, replayed: false };
 }
 

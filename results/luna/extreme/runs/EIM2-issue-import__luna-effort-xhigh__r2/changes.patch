+import { and, eq, inArray, sql } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, issueImports, issueLabels, issues, labels } from "@/server/db";
+import type { ImportIssueRowInput } from "@/schemas/issue-import";
+import { toIsoTimestamp } from "@/types/common";
+import type { LabelId, OrgId, ProjectId, UserId } from "@/types/common";
+import type { Issue, IssueImportResult } from "@/types/issue";
+import { toIssue } from "./_mappers";
+
+type StoredImport = {
+  readonly projectId: ProjectId;
+  readonly issues: readonly Issue[];
+};
+
+/** Reads the persisted first result for a workspace-scoped key. */
+export function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): StoredImport | null {
+  const row = getDb()
+    .select()
+    .from(issueImports)
+    .where(
+      and(
+        eq(issueImports.orgId, orgId),
+        eq(issueImports.importKey, importKey),
+      ),
+    )
+    .get();
+
+  if (!row) return null;
+  return {
+    projectId: row.projectId as ProjectId,
+    issues: JSON.parse(row.issuesJson) as Issue[],
+  };
+}
+
+/**
+ * Writes labels, issues, their label links and the idempotency snapshot in one
+ * SQLite transaction. A failed row therefore cannot leave a partial import.
+ */
+export function insertIssueImport(input: {
+  readonly orgId: OrgId;
+  readonly projectId: ProjectId;
+  readonly importKey: string;
+  readonly rows: readonly ImportIssueRowInput[];
+  readonly authorId: UserId;
+  readonly assigneeIdsByEmail: ReadonlyMap<string, UserId>;
+}): IssueImportResult {
+  const db = getDb();
+
+  return db.transaction((tx) => {
+    const prior = tx
+      .select()
+      .from(issueImports)
+      .where(
+        and(
+          eq(issueImports.orgId, input.orgId),
+          eq(issueImports.importKey, input.importKey),
+        ),
+      )
+      .get();
+
+    if (prior) {
+      return {
+        importKey: input.importKey,
+        projectId: prior.projectId as ProjectId,
+        issues: JSON.parse(prior.issuesJson) as Issue[],
+        replayed: true,
+      };
+    }
+
+    const names = [...new Set(input.rows.flatMap((row) => row.labels))];
+    const labelsByName = new Map<string, LabelId>();
+    if (names.length > 0) {
+      const existing = tx
+        .select()
+        .from(labels)
+        .where(and(eq(labels.orgId, input.orgId), inArray(labels.name, names)))
+        .all();
+      for (const label of existing) {
+        labelsByName.set(label.name, label.id as LabelId);
+      }
+    }
+
+    const stamp = toIsoTimestamp(new Date());
+    const highestNumber = tx
+      .select({ value: sql<number | null>`max(${issues.number})` })
+      .from(issues)
+      .where(
+        and(
+          eq(issues.orgId, input.orgId),
+          eq(issues.projectId, input.projectId),
+        ),
+      )
+      .get();
+    const firstNumber = (highestNumber?.value ?? 0) + 1;
+    for (const name of names) {
+      if (labelsByName.has(name)) continue;
+      const label = tx
+        .insert(labels)
+        .values({
+          id: newId(),
+          orgId: input.orgId,
+          name,
+          color: "#94a3b8",
+          description: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .returning()
+        .get();
+      labelsByName.set(label.name, label.id as LabelId);
+    }
+
+    const rowsToInsert = input.rows.map((row, index) => ({
+      id: newId(),
+      orgId: input.orgId,
+      projectId: input.projectId,
+      number: firstNumber + index,
+      title: row.title,
+      description: row.description,
+      status: row.status,
+      priority: row.priority,
+      authorId: input.authorId,
+      assigneeId:
+        row.assigneeEmail === null
+          ? null
+          : (input.assigneeIdsByEmail.get(row.assigneeEmail.toLowerCase()) ?? null),
+      parentId: null,
+      estimate: null,
+      dueAt: row.dueAt,
+      startedAt: null,
+      completedAt: null,
+      createdAt: stamp,
+      updatedAt: stamp,
+    }));
+
+    const persistedRows = tx.insert(issues).values(rowsToInsert).returning().all();
+    const persistedById = new Map(persistedRows.map((row) => [row.id, row]));
+    const labelIdsByIssue: readonly (readonly LabelId[])[] = input.rows.map(
+      (row) => [...new Set(row.labels)].map((name) => {
+        const labelId = labelsByName.get(name);
+        if (!labelId) throw new Error(`Label ${name} was not persisted`);
+        return labelId;
+      }),
+    );
+
+    const links = rowsToInsert.flatMap((row, index) =>
+      labelIdsByIssue[index]!.map((labelId) => ({
+        orgId: input.orgId,
+        issueId: row.id,
+        labelId,
+      })),
+    );
+    for (let offset = 0; offset < links.length; offset += 300) {
+      tx.insert(issueLabels)
+        .values(links.slice(offset, offset + 300))
+        .run();
+    }
+
+    const importedIssues = rowsToInsert.map((row, index) => {
+      const persisted = persistedById.get(row.id);
+      if (!persisted) throw new Error(`Issue ${row.id} was not persisted`);
+      return toIssue(persisted, labelIdsByIssue[index]!);
+    });
+
+    tx.insert(issueImports)
+      .values({
+        orgId: input.orgId,
+        projectId: input.projectId,
+        importKey: input.importKey,
+        issuesJson: JSON.stringify(importedIssues),
+        createdAt: stamp,
+      })
+      .run();
+
+    return {
+      importKey: input.importKey,
+      projectId: input.projectId,
+      issues: importedIssues,
+      replayed: false,
+    };
+  });
+}

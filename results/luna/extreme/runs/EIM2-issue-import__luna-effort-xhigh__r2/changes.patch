+      ),
+    ),
+  ];
+  const assigneeIdsByEmail = await memberRepo.findActiveMemberUsersByEmail(
+    input.orgId,
+    emails,
+  );
+
+  setOrgPlan(input.orgId, org.plan);
+  const verdict = await consumeRateLimit(
+    input.orgId,
+    ISSUE_CREATE_RATE_BUCKET,
+    input.rows.length,
+  );
+  if (!verdict.allowed) {
+    throw new Error(
+      `Issue creation rate limit reached; try again after ${verdict.resetAt}`,
+    );
+  }
+
+  const result = issueImportRepo.insertIssueImport({
+    orgId: input.orgId,
+    projectId: input.projectId,
+    importKey: input.importKey,
+    rows: input.rows,
+    authorId: actor.userId,
+    assigneeIdsByEmail,
+  });
+
+  if (result.replayed) return result;
+
+  await emit("issues.imported", {
+    ...actorEnvelope(actor),
+    projectId: result.projectId,
+    importKey: result.importKey,
+    issueIds: result.issues.map((issue) => issue.id),
+  });
+
+  return result;
 }
 

+/** Resolves emails only through active, non-removed members of this workspace. */
+export async function findActiveMemberUsersByEmail(
+  orgId: OrgId,
+  emails: readonly string[],
+): Promise<ReadonlyMap<string, UserId>> {
+  if (emails.length === 0) return new Map();
+
+  const rows = getDb()
+    .select({ email: users.email, userId: members.userId })
+    .from(members)
+    .innerJoin(users, eq(users.id, members.userId))
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+        inArray(
+          sql<string>`lower(${users.email})`,
+          emails.map((email) => email.toLowerCase()),
+        ),
+      ),
+    )
+    .all();
+
+  return new Map(rows.map((row) => [row.email.toLowerCase(), row.userId as UserId]));
 }
 

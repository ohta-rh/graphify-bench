+import { index, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";
+import { tenantColumns } from "./_shared";
+
+/** Idempotency records for successful issue imports, scoped to a workspace. */
+export const issueImports = sqliteTable(
+  "issue_imports",
+  {
+    ...tenantColumns,
+    importKey: text("import_key").notNull(),
+    projectId: text("project_id").notNull(),
+    /** Snapshot of the original ordered IssueImportResult. */
+    issuesJson: text("issues_json").notNull(),
+    createdAt: text("created_at").notNull(),
+  },
+  (table) => [
+    uniqueIndex("issue_imports_org_key_idx").on(table.orgId, table.importKey),
+    index("issue_imports_org_project_idx").on(table.orgId, table.projectId),
+  ],
+);
+
+export type IssueImportRow = typeof issueImports.$inferSelect;

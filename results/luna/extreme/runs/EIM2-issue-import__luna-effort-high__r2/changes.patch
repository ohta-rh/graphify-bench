+/** Reads the durable first-import result, retaining the stored file order. */
+export async function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): Promise<{ projectId: ProjectId; issues: readonly Issue[] } | null> {
+  const db = getDb();
+  const record = db
+    .select()
+    .from(issueImports)
+    .where(and(orgPredicate(issueImports.orgId, orgId), eq(issueImports.importKey, importKey)))
+    .get();
+  if (!record) return null;
+
+  const ids = JSON.parse(record.issueIds) as IssueId[];
+  const rows = ids.length === 0 ? [] : db.select().from(issues)
+    .where(and(orgPredicate(issues.orgId, orgId), inArray(issues.id, ids)))
+    .all();
+  const byId = new Map(rows.map((row) => [row.id, row]));
+  const found = ids.flatMap((id) => {
+    const row = byId.get(id);
+    return row ? [toIssue(row)] : [];
+  });
+  const labelMap = await listLabelsForIssues(orgId, ids);
+  return { projectId: record.projectId as ProjectId, issues: found.map((issue) => ({
+    ...issue,
+    labelIds: (labelMap[issue.id] ?? []).map((label) => label.id),
+  })) };
+}
+
+/** Creates labels, issue rows and the idempotency record in one SQLite transaction. */
+export async function insertIssueImport(
+  input: ImportIssuesInput,
+  authorId: UserId,
+): Promise<{ issues: readonly Issue[]; replayed: boolean }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const already = tx.select().from(issueImports).where(and(
+      orgPredicate(issueImports.orgId, input.orgId),
+      eq(issueImports.importKey, input.importKey),
+    )).get();
+    if (already) {
+      const ids = JSON.parse(already.issueIds) as IssueId[];
+      const rows = ids.length === 0 ? [] : tx.select().from(issues)
+        .where(and(orgPredicate(issues.orgId, input.orgId), inArray(issues.id, ids)))
+        .all();
+      const byId = new Map(rows.map((row) => [row.id, row]));
+      const imported = ids.flatMap((id) => {
+        const row = byId.get(id);
+        return row ? [toIssue(row)] : [];
+      });
+      return { issues: imported, replayed: true };
+    }
+
+    const liveMembers = tx.select({ email: users.email, userId: users.id })
+      .from(members)
+      .innerJoin(users, eq(users.id, members.userId))
+      .where(and(
+        orgPredicate(members.orgId, input.orgId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      )).all();
+    const assigneeByEmail = new Map(liveMembers.map((member) => [member.email.toLowerCase(), member.userId as UserId]));
+
+    const labelNames = [...new Set(input.rows.flatMap((row) => row.labels))];
+    const existingLabels = tx.select().from(labels)
+      .where(orgPredicate(labels.orgId, input.orgId)).all();
+    const labelByName = new Map(existingLabels.map((label) => [label.name, label]));
+    const stamp = toIsoTimestamp(new Date());
+    for (const name of labelNames) {
+      if (labelByName.has(name)) continue;
+      const row = tx.insert(labels).values({
+        id: newId(), orgId: input.orgId, name, color: "#94a3b8", description: null,
+        createdAt: stamp, updatedAt: stamp,
+      }).returning().get();
+      labelByName.set(name, row);
+    }
+
+    const previous = tx.select({ value: sql<number | null>`max(${issues.number})` })
+      .from(issues)
+      .where(and(orgPredicate(issues.orgId, input.orgId), eq(issues.projectId, input.projectId)))
+      .get();
+    let number = (previous?.value ?? 0) + 1;
+    const created: Issue[] = [];
+    const ids: IssueId[] = [];
+    for (const rowInput of input.rows) {
+      const id = newId() as IssueId;
+      const row = tx.insert(issues).values({
+        id, orgId: input.orgId, projectId: input.projectId, number: number++,
+        title: rowInput.title, description: rowInput.description, status: rowInput.status,
+        priority: rowInput.priority, authorId, assigneeId: rowInput.assigneeEmail
+          ? assigneeByEmail.get(rowInput.assigneeEmail.toLowerCase()) ?? null
+          : null,
+        parentId: null, estimate: null, dueAt: rowInput.dueAt, startedAt: null,
+        completedAt: null, createdAt: stamp, updatedAt: stamp,
+      }).returning().get();
+      const labelIds = [...new Set(rowInput.labels)].map((name) => labelByName.get(name)!.id as LabelId);
+      if (labelIds.length > 0) tx.insert(issueLabels).values(labelIds.map((labelId) => ({ orgId: input.orgId, issueId: id, labelId }))).run();
+      ids.push(id);
+      created.push(toIssue(row, labelIds));
+    }
+    tx.insert(issueImports).values({
+      id: newId(), orgId: input.orgId, projectId: input.projectId,
+      importKey: input.importKey, issueIds: JSON.stringify(ids), createdAt: stamp, updatedAt: stamp,
+    }).run();
+    return { issues: created, replayed: false };
+  });
 }
 

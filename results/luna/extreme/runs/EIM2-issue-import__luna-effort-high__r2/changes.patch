+/** Imports a file as one authorized, quota-checked and idempotent batch. */
+export async function importIssues(
+  actor: Actor,
+  input: ImportIssuesInput,
+): Promise<IssueImportResult> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  const prior = await issueRepo.findIssueImport(input.orgId, input.importKey);
+  if (prior) {
+    return {
+      importKey: input.importKey,
+      projectId: prior.projectId,
+      issues: prior.issues,
+      replayed: true,
+    };
+  }
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await issueRepo.countIssues(input.orgId, input.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used, input.rows.length)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${project.key}`,
+    );
+  }
+
+  setOrgPlan(input.orgId, org.plan);
+  const verdict = await consumeRateLimit(input.orgId, "issue:create", input.rows.length);
+  if (!verdict.allowed) {
+    throw new Error(`Issue creation rate limit reached; try again after ${verdict.resetAt}`);
+  }
+
+  const inserted = await issueRepo.insertIssueImport(input, actor.userId);
+  if (inserted.replayed) {
+    const priorImport = await issueRepo.findIssueImport(input.orgId, input.importKey);
+    return {
+      importKey: input.importKey,
+      projectId: priorImport?.projectId ?? input.projectId,
+      issues: priorImport?.issues ?? inserted.issues,
+      replayed: true,
+    };
+  }
+
+  await emit("issues.imported", {
+    ...actorEnvelope(actor),
+    projectId: project.id,
+    importKey: input.importKey,
+    issueIds: inserted.issues.map((issue) => issue.id),
+  });
+
+  return {
+    importKey: input.importKey,
+    projectId: project.id,
+    issues: inserted.issues,
+    replayed: false,
+  };
 }
 

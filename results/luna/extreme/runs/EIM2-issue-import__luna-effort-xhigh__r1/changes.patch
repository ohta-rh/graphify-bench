+/** Imports a batch after applying the same project access and quota gates as issue creation. */
+export async function importIssues(
+  actor: Actor,
+  input: ImportIssuesInput,
+): Promise<IssueImportResult> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+
+  const previous = await issueImportRepo.findIssueImport(
+    input.orgId,
+    input.importKey,
+  );
+  if (previous) {
+    return {
+      importKey: input.importKey,
+      projectId: previous.projectId,
+      issues: previous.issues,
+      replayed: true,
+    };
+  }
+
+  const used = await issueRepo.countIssues(input.orgId, input.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used, input.rows.length)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${project.key}`,
+    );
+  }
+
+  setOrgPlan(input.orgId, org.plan);
+  const verdict = await consumeRateLimit(
+    input.orgId,
+    "issue:create",
+    input.rows.length,
+  );
+  if (!verdict.allowed) {
+    throw new Error(
+      `Issue creation rate limit reached; try again after ${verdict.resetAt}`,
+    );
+  }
+
+  const result = await issueImportRepo.createIssueImport({
+    orgId: input.orgId,
+    projectId: input.projectId,
+    projectKey: project.key,
+    importKey: input.importKey,
+    rows: input.rows,
+    authorId: actor.userId,
+    plan: org.plan,
+  });
+
+  if (result.replayed) return result;
+
+  await emit("issues.imported", {
+    ...actorEnvelope(actor),
+    projectId: result.projectId,
+    importKey: result.importKey,
+    issueIds: result.issues.map((issue) => issue.id),
+  });
+
+  return result;
 }
 

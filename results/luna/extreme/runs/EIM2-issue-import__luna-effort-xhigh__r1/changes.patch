+/** Reads issues in the order supplied by a batch event. */
+export async function findIssuesByIds(
+  orgId: OrgId,
+  issueIds: readonly IssueId[],
+): Promise<readonly Issue[]> {
+  if (issueIds.length === 0) return [];
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(orgPredicate(issues.orgId, orgId), inArray(issues.id, [...issueIds])),
+    )
+    .all();
+  const byId = new Map(rows.map((row) => [row.id, row]));
+  const labelRows = getDb()
+    .select({ issueId: issueLabels.issueId, labelId: issueLabels.labelId })
+    .from(issueLabels)
+    .where(
+      and(
+        orgPredicate(issueLabels.orgId, orgId),
+        inArray(issueLabels.issueId, [...issueIds]),
+      ),
+    )
+    .all();
+  const labelsByIssue = new Map<string, LabelId[]>();
+  for (const link of labelRows) {
+    const values = labelsByIssue.get(link.issueId) ?? [];
+    values.push(link.labelId as LabelId);
+    labelsByIssue.set(link.issueId, values);
+  }
+
+  return issueIds.flatMap((id) => {
+    const row = byId.get(id);
+    return row ? [toIssue(row, labelsByIssue.get(id) ?? [])] : [];
+  });
+}

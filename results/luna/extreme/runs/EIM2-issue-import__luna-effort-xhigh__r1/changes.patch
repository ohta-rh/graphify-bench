+import { and, count, eq, sql } from "drizzle-orm";
+import { wouldExceedLimit } from "@/config/plan-limits";
+import { newId } from "@/lib/id";
+import {
+  getDb,
+  issueImports,
+  issueLabels,
+  issues,
+  labels,
+  members,
+  users,
+} from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toIssue } from "./_mappers";
+import { livePredicate, orgPredicate } from "./base-repository";
+import type { ImportIssueRowInput } from "@/schemas/issue-import";
+import type { Issue, IssueImportResult } from "@/types/issue";
+import type { IssueId, LabelId, OrgId, ProjectId, UserId } from "@/types/common";
+import type { PlanId } from "@/types/billing";
+
+type ImportKeyRecord = {
+  readonly projectId: ProjectId;
+  readonly issues: readonly Issue[];
+};
+
+export async function findIssueImport(
+  orgId: OrgId,
+  importKey: string,
+): Promise<ImportKeyRecord | null> {
+  const row = getDb()
+    .select({ projectId: issueImports.projectId, issuesJson: issueImports.issuesJson })
+    .from(issueImports)
+    .where(
+      and(
+        orgPredicate(issueImports.orgId, orgId),
+        eq(issueImports.importKey, importKey),
+      ),
+    )
+    .get();
+
+  if (!row) return null;
+  return {
+    projectId: row.projectId as ProjectId,
+    issues: JSON.parse(row.issuesJson) as readonly Issue[],
+  };
+}
+
+/** Writes all issue, label and idempotency rows in one SQLite transaction. */
+export async function createIssueImport(input: {
+  orgId: OrgId;
+  projectId: ProjectId;
+  projectKey: string;
+  importKey: string;
+  rows: readonly ImportIssueRowInput[];
+  authorId: UserId;
+  plan: PlanId;
+}): Promise<IssueImportResult> {
+  return getDb().transaction((tx) => {
+    const existing = tx
+      .select()
+      .from(issueImports)
+      .where(
+        and(
+          orgPredicate(issueImports.orgId, input.orgId),
+          eq(issueImports.importKey, input.importKey),
+        ),
+      )
+      .get();
+
+    if (existing) {
+      return {
+        importKey: input.importKey,
+        projectId: existing.projectId as ProjectId,
+        issues: JSON.parse(existing.issuesJson) as readonly Issue[],
+        replayed: true,
+      };
+    }
+
+    const countRow = tx
+      .select({ value: count() })
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, input.orgId),
+          eq(issues.projectId, input.projectId),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      )
+      .get();
+    const used = countRow?.value ?? 0;
+    if (wouldExceedLimit(input.plan, "issuesPerProject", used, input.rows.length)) {
+      throw new Error(
+        `Plan ${input.plan} allows no more issues in project ${input.projectKey}`,
+      );
+    }
+
+    const stamp = toIsoTimestamp(new Date());
+    const assignees = tx
+      .select({ userId: members.userId, email: users.email })
+      .from(members)
+      .innerJoin(users, eq(users.id, members.userId))
+      .where(
+        and(
+          orgPredicate(members.orgId, input.orgId),
+          eq(members.status, "active"),
+          livePredicate(members.archivedAt, {}),
+        ),
+      )
+      .all();
+    const assigneeByEmail = new Map(
+      assignees.map((member) => [member.email.toLowerCase(), member.userId as UserId]),
+    );
+
+    const requestedLabelNames = [
+      ...new Set(input.rows.flatMap((row) => row.labels)),
+    ];
+    const labelIdsByName = new Map<string, string>();
+    if (requestedLabelNames.length > 0) {
+      const existingLabels = tx
+        .select({ id: labels.id, name: labels.name })
+        .from(labels)
+        .where(orgPredicate(labels.orgId, input.orgId))
+        .all();
+      for (const label of existingLabels) {
+        if (requestedLabelNames.includes(label.name)) {
+          labelIdsByName.set(label.name, label.id);
+        }
+      }
+
+      for (const name of requestedLabelNames) {
+        if (labelIdsByName.has(name)) continue;
+        const label = tx
+          .insert(labels)
+          .values({
+            id: newId(),
+            orgId: input.orgId,
+            name,
+            color: "#94a3b8",
+            description: null,
+            createdAt: stamp,
+            updatedAt: stamp,
+          })
+          .returning({ id: labels.id })
+          .get();
+        labelIdsByName.set(name, label.id);
+      }
+    }
+
+    const maxNumber = tx
+      .select({ value: sql<number | null>`max(${issues.number})` })
+      .from(issues)
+      .where(
+        and(
+          orgPredicate(issues.orgId, input.orgId),
+          eq(issues.projectId, input.projectId),
+        ),
+      )
+      .get()?.value;
+    let nextNumber = (maxNumber ?? 0) + 1;
+    const created: Issue[] = [];
+
+    for (const rowInput of input.rows) {
+      const labelIds = [...new Set(rowInput.labels)].map(
+        (name) => labelIdsByName.get(name) as LabelId,
+      );
+      const issueId = newId() as IssueId;
+      const row = tx
+        .insert(issues)
+        .values({
+          id: issueId,
+          orgId: input.orgId,
+          projectId: input.projectId,
+          number: nextNumber++,
+          title: rowInput.title,
+          description: rowInput.description,
+          status: rowInput.status,
+          priority: rowInput.priority,
+          authorId: input.authorId,
+          assigneeId:
+            rowInput.assigneeEmail === null
+              ? null
+              : (assigneeByEmail.get(rowInput.assigneeEmail.toLowerCase()) ?? null),
+          parentId: null,
+          estimate: null,
+          dueAt: rowInput.dueAt,
+          startedAt: null,
+          completedAt: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .returning()
+        .get();
+
+      if (labelIds.length > 0) {
+        tx.insert(issueLabels)
+          .values(labelIds.map((labelId) => ({
+            orgId: input.orgId,
+            issueId,
+            labelId,
+          })))
+          .run();
+      }
+
+      created.push(toIssue(row, labelIds));
+    }
+
+    tx.insert(issueImports)
+      .values({
+        orgId: input.orgId,
+        importKey: input.importKey,
+        projectId: input.projectId,
+        issuesJson: JSON.stringify(created),
+        createdAt: stamp,
+        updatedAt: stamp,
+      })
+      .run();
+
+    return {
+      importKey: input.importKey,
+      projectId: input.projectId,
+      issues: created,
+      replayed: false,
+    };
+  });
+}

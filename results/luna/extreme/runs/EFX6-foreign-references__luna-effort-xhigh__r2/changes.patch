+/** Reply targets must be live top-level comments on the same issue. */
+export async function findLiveTopLevelComment(
+  orgId: OrgId,
+  issueId: IssueId,
+  commentId: CommentId,
+): Promise<Comment | null> {
+  const row = getDb()
+    .select()
+    .from(comments)
+    .where(
+      and(
+        orgPredicate(comments.orgId, orgId),
+        eq(comments.issueId, issueId),
+        eq(comments.id, commentId),
+        isNull(comments.parentId),
+        isNull(comments.archivedAt),
+      ),
+    )
+    .get();
+  return row ? toComment(row) : null;
+}

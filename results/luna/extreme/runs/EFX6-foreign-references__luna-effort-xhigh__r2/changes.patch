+/** A current member is active and has not been removed from the organization. */
+export async function findActiveMember(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<Member | null> {
+  const row = getDb()
+    .select()
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.userId, userId),

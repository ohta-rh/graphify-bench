+      ),
+    )
+    .get();
+  return row ? toMember(row) : null;
+}
+
+/** Keeps notification fan-out from reaching users who are no longer members. */
+export async function listActiveMemberUserIds(
+  orgId: OrgId,
+  userIds: readonly UserId[],
+): Promise<readonly UserId[]> {
+  if (userIds.length === 0) return [];
+
+  return getDb()
+    .select({ userId: members.userId })
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        inArray(members.userId, [...new Set(userIds)]),
+        eq(members.status, "active"),
+        liveMemberPredicate(),
+      ),
+    )
+    .all()
+    .map((row) => row.userId as UserId);
+}
+
+/** Resolves only active members referenced by composer ids or body handles. */
+export async function findActiveMembersForMentions(
+  orgId: OrgId,
+  userIds: readonly UserId[],
+  handles: readonly string[],
+): Promise<readonly MemberWithUser[]> {
+  const references = [];
+  if (userIds.length > 0) {
+    references.push(inArray(members.userId, [...new Set(userIds)]));
+  }
+  if (handles.length > 0) {
+    references.push(
+      inArray(
+        sql<string>`lower(substr(${users.email}, 1, instr(${users.email}, '@') - 1))`,
+        [...new Set(handles)],
+      ),
+    );
+  }
+  if (references.length === 0) return [];
+
+  const rows = getDb()
+    .select({ member: members, user: users })
+    .from(members)
+    .innerJoin(users, eq(users.id, members.userId))
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.status, "active"),
+        liveMemberPredicate(),
+        or(...references),
+      ),
+    )
+    .all();
+
+  return rows.map((row) => ({
+    ...toMember(row.member),
+    user: toUser(row.user),
+  }));
 }
 

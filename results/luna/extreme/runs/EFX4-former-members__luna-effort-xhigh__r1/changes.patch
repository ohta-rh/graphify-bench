+/**
+ * Consumes an invitation and joins or reactivates its existing membership in
+ * one transaction. A current member consumes the token without changing their
+ * membership row or taking another seat.
+ */
+export async function acceptInvitation(
+  orgId: OrgId,
+  invitationId: InvitationId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<{ readonly member: Member; readonly joined: boolean }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const invitation = tx
+      .select()
+      .from(invitations)
+      .where(
+        and(
+          orgPredicate(invitations.orgId, orgId),
+          eq(invitations.id, invitationId),
+        ),
+      )
+      .get();
+
+    if (!invitation) throw new Error(`Invitation ${invitationId} not found`);
+    if (invitation.revokedAt !== null) {
+      throw new Error("That invitation has been revoked");
+    }
+    if (invitation.acceptedAt !== null) {
+      throw new Error("That invitation has already been accepted");
+    }
+    if (invitation.expiresAt <= at) {
+      throw new Error("That invitation has expired");
+    }
+
+    const existing = tx
+      .select()
+      .from(members)
+      .where(
+        and(
+          orgPredicate(members.orgId, orgId),
+          eq(members.userId, userId),
+        ),
+      )
+      .get();
+    let memberRow: MemberRow;
+    let joined: boolean;
+    if (existing && existing.status === "active" && existing.archivedAt === null) {
+      memberRow = existing;
+      joined = false;
+    } else if (existing) {
+      memberRow = tx
+        .update(members)
+        .set({
+          role: invitation.role,
+          status: "active",
+          invitedBy: invitation.invitedBy,
+          joinedAt: at,
+          archivedAt: null,
+          updatedAt: at,
+        })
+        .where(
+          and(
+            orgPredicate(members.orgId, orgId),
+            eq(members.id, existing.id),
+          ),
+        )
+        .returning()
+        .get();
+      joined = true;
+    } else {
+      memberRow = tx
+        .insert(members)
+        .values({
+          id: newId(),
+          orgId,
+          userId,
+          role: invitation.role,
+          status: "active",
+          invitedBy: invitation.invitedBy,
+          joinedAt: at,
+          lastSeenAt: null,
+          createdAt: at,
+          updatedAt: at,
+          archivedAt: null,
+        })
+        .returning()
+        .get();
+      joined = true;
+    }
+
+    tx.update(invitations)
+      .set({ acceptedAt: at, updatedAt: at })
+      .where(
+        and(
+          orgPredicate(invitations.orgId, orgId),
+          eq(invitations.id, invitationId),
+          isNull(invitations.acceptedAt),
+          isNull(invitations.revokedAt),
+        ),
+      )
+      .run();
+
+    return { member: toMember(memberRow), joined };
+  });
 }
 

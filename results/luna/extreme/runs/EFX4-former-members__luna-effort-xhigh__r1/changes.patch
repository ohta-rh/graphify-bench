+/** Whether a user currently holds an active membership in this org. */
+export async function isActiveMember(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<boolean> {
+  const row = getDb()
+    .select({ id: members.id })
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.userId, userId),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      ),
+    )
+    .get();
+  return row !== undefined;
+}
+
+/** Restricts a fan-out batch to current members in this tenant. */
+export async function listActiveMemberUserIds(
+  orgId: OrgId,
+  userIds: readonly UserId[],
+): Promise<readonly UserId[]> {
+  if (userIds.length === 0) return [];
+  const rows = getDb()
+    .select({ userId: members.userId })
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        inArray(members.userId, [...userIds]),
+        eq(members.status, "active"),
+        isNull(members.archivedAt),
+      ),
+    )
+    .all();
+  return rows.map((row) => row.userId as UserId);

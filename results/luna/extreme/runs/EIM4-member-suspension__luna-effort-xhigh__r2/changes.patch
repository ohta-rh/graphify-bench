+  const member = requireFound(
+    found && found.archivedAt === null ? found : null,
+    "Member",
+    input.memberId,
+  );
+  assertCan(actor, "member:remove", memberResource(member));
+  assertCanManageMember(actor, member);
+
+  if (member.status !== "suspended") return member;
+
+  const reinstated = await memberRepo.setMemberStatus(
+    input.orgId,

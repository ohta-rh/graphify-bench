+
+/** Suspends a live member without changing their role or seat. */
+export async function suspendMember(
+  actor: Actor,
+  input: { orgId: OrgId; memberId: MemberId },
+): Promise<Member> {
+  assertOrgScope(actor, input.orgId);
+
+  const found = await memberRepo.findMemberById(input.orgId, input.memberId);
+  const member = requireFound(
+    found && found.archivedAt === null ? found : null,
+    "Member",
+    input.memberId,
+  );
+  assertCan(actor, "member:remove", memberResource(member));
+  assertCanManageMember(actor, member);
+
+  if (member.status === "suspended") return member;
+
+  if (member.status === "active" && member.role === "owner") {
+    await assertLastOwnerRetained(input.orgId, member.id, "member");
+  }
+
+  const suspended = await memberRepo.setMemberStatus(
+    input.orgId,
+    member.id,
+    "suspended",
+  );
+
+  await emit("member.suspended", {
+    ...actorEnvelope(actor),
+    memberId: suspended.id,
+    userId: suspended.userId,
+  });
+
+  return suspended;
+}
+

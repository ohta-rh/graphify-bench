+        .where(
+          and(
+            orgPredicate(members.orgId, input.orgId),
+            eq(members.id, existing.id),
+            isNotNull(members.archivedAt),
+          ),
+        )
+        .returning()
+        .get();
+
+      if (!row) throw new Error("That membership changed while accepting the invitation");
+      return { member: toMember(row), admitted: true };
+    }
+
+    if (existing) return { member: toMember(existing), admitted: false };
+
+    const row = tx

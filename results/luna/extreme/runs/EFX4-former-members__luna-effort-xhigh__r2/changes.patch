+    }
+
+    const existing = tx
+      .select()
+      .from(members)
+      .where(
+        and(
+          orgPredicate(members.orgId, input.orgId),
+          eq(members.userId, input.userId),
+        ),
+      )
+      .get();
+
+    if (existing && existing.archivedAt !== null) {
+      const row = tx

+export class MemberSuspendedError extends Error {
+  readonly code = "conflict" as const;
+  constructor(readonly memberId: MemberId) {
+    super(`Member ${memberId} is suspended`);
+    this.name = "MemberSuspendedError";
+  }
+}
+
+export async function suspendMember(actor: Actor, input: { orgId: OrgId; memberId: MemberId }): Promise<Member> {
+  return changeSuspension(actor, input, "suspended");
+}
+
+export async function reinstateMember(actor: Actor, input: { orgId: OrgId; memberId: MemberId }): Promise<Member> {
+  return changeSuspension(actor, input, "active");
+}
+
+async function changeSuspension(actor: Actor, input: { orgId: OrgId; memberId: MemberId }, status: "active" | "suspended"): Promise<Member> {
+  assertOrgScope(actor, input.orgId);
+  const member = requireFound(await memberRepo.findMemberById(input.orgId, input.memberId), "Member", input.memberId);
+  if (member.archivedAt !== null) throw new NotFoundError("Member", input.memberId);
+  assertCan(actor, "member:remove", memberResource(member));
+  if (member.userId === actor.userId) throw new Error("Members cannot change their own suspension");
+  if (!hasRoleAtLeast(actor.role, member.role)) throw new Error(`A ${actor.role} cannot change a ${member.role}`);
+  if (member.status === status) return member;
+  if (status === "suspended") await assertLastOwnerRetained(input.orgId, input.memberId, "member");
+  const updated = await memberRepo.setMemberStatus(input.orgId, input.memberId, status);
+  await emit(status === "suspended" ? "member.suspended" : "member.reinstated", {
+    ...actorEnvelope(actor), memberId: updated.id, userId: updated.userId,
+  });
+  return updated;
+}

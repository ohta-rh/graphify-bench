+export async function setAbsence(
+  actor: Actor,
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+
+  const member = await requireActiveMember(input.orgId, input.userId);
+  if (input.userId !== actor.userId) {
+    assertCan(actor, "member:update_role", memberResource(member));
+  }
+  if (Date.parse(input.endsAt) <= Date.parse(input.startsAt)) {
+    throw new Error("Absence end must be after its start");
+  }
+  if (input.delegateUserId === input.userId) {
+    throw new Error("A member cannot delegate to themselves");
+  }
+  if (input.delegateUserId !== null) {
+    await requireActiveMember(input.orgId, input.delegateUserId);
+  }
+
+  return memberRepo.saveAbsence({
+    orgId: input.orgId,
+    userId: input.userId,
+    delegateUserId: input.delegateUserId,
+    startsAt: input.startsAt,
+    endsAt: input.endsAt,
+    note: input.note,
+  });

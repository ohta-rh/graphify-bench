+
+function toMemberAbsence(row: typeof memberAbsences.$inferSelect): MemberAbsence {
+  return {
+    orgId: row.orgId as OrgId,
+    userId: row.userId as UserId,
+    delegateUserId: row.delegateUserId as UserId | null,
+    startsAt: row.startsAt as IsoTimestamp,
+    endsAt: row.endsAt as IsoTimestamp,
+    note: row.note,
+  };
+}
+
+export async function findAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  const row = getDb()
+    .select()
+    .from(memberAbsences)
+    .where(and(eq(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .get();
+  return row ? toMemberAbsence(row) : null;
+}
+
+export async function saveAbsence(
+  absence: MemberAbsence,
+): Promise<MemberAbsence> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(memberAbsences)
+    .values({ ...absence, createdAt: stamp, updatedAt: stamp })
+    .onConflictDoUpdate({
+      target: [memberAbsences.orgId, memberAbsences.userId],
+      set: {
+        delegateUserId: absence.delegateUserId,
+        startsAt: absence.startsAt,
+        endsAt: absence.endsAt,
+        note: absence.note,
+        updatedAt: stamp,
+      },
+    })
+    .returning()
+    .get();
+  return toMemberAbsence(row);
+}
+
+export async function deleteAbsence(orgId: OrgId, userId: UserId): Promise<void> {
+  getDb()
+    .delete(memberAbsences)
+    .where(and(eq(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId)))
+    .run();
+}
+
+export async function dropDelegate(orgId: OrgId, userId: UserId): Promise<void> {
+  getDb()
+    .update(memberAbsences)
+    .set({ delegateUserId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(eq(memberAbsences.orgId, orgId), eq(memberAbsences.delegateUserId, userId)))
+    .run();
+}
+
+export async function findActiveDelegate(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<UserId | null> {
+  const row = getDb()
+    .select({ delegateUserId: memberAbsences.delegateUserId })
+    .from(memberAbsences)
+    .where(
+      and(
+        eq(memberAbsences.orgId, orgId),
+        eq(memberAbsences.userId, userId),
+        lte(memberAbsences.startsAt, at),
+        gt(memberAbsences.endsAt, at),
+      ),
+    )
+    .get();
+  return (row?.delegateUserId as UserId | null | undefined) ?? null;
 }

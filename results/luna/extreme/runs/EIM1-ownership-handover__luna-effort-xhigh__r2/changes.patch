@@ -0,0 +1,30 @@
+import { index, sqliteTable, text, uniqueIndex } from "drizzle-orm/sqlite-core";
+import { sql } from "drizzle-orm";
+import { idColumn, tenantColumns, timestampColumns } from "./_shared";
+
+export const ownershipHandovers = sqliteTable(
+  "ownership_handovers",
+  {
+    id: idColumn(),
+    ...tenantColumns,
+    fromUserId: text("from_user_id").notNull(),
+    toUserId: text("to_user_id").notNull(),
+    status: text("status", {
+      enum: ["pending", "accepted", "declined", "canceled", "expired"],
+    })
+      .notNull()
+      .default("pending"),
+    expiresAt: text("expires_at").notNull(),
+    resolvedAt: text("resolved_at"),
+    ...timestampColumns,
+  },
+  (table) => [
+    index("ownership_handovers_org_idx").on(table.orgId),
+    uniqueIndex("ownership_handovers_one_pending_idx")
+      .on(table.orgId)
+      .where(sql`${table.status} = 'pending'`),
+  ],
+);
+
+export type OwnershipHandoverRow = typeof ownershipHandovers.$inferSelect;
+export type NewOwnershipHandoverRow = typeof ownershipHandovers.$inferInsert;

+      .where(
+        and(
+          eq(ownershipHandovers.orgId, orgId),
+          eq(ownershipHandovers.id, handoverId),
+          eq(ownershipHandovers.status, "pending"),
+        ),
+      )
+      .returning()
+      .get();
+    return updated ? toOwnershipHandover(updated) : null;
+  });
+  return resolve.immediate();
+}
+
+/** Atomically transfers the owner id, membership roles and offer status. */
+export async function acceptOwnershipHandover(
+  orgId: OrgId,
+  handoverId: string,
+  acceptingUserId: UserId,
+  now: string,
+): Promise<AcceptedOwnershipHandover | "expired" | null> {
+  const db = getDb();
+  const accept = db.$client.transaction(() => {
+    const row = db
+      .select()
+      .from(ownershipHandovers)
+      .where(
+        and(
+          eq(ownershipHandovers.orgId, orgId),
+          eq(ownershipHandovers.id, handoverId),
+          eq(ownershipHandovers.status, "pending"),
+        ),
+      )
+      .get();
+    if (!row || row.toUserId !== acceptingUserId) return null;
+    if (row.expiresAt <= now) {
+      db.update(ownershipHandovers)
+        .set({ status: "expired", resolvedAt: row.expiresAt, updatedAt: now })
+        .where(eq(ownershipHandovers.id, handoverId))
+        .run();
+      return "expired" as const;
+    }
+
+    const orgRow = db
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    const targetRow = db
+      .select()
+      .from(members)
+      .where(
+        and(
+          eq(members.orgId, orgId),
+          eq(members.userId, acceptingUserId),
+          eq(members.status, "active"),
+          isNull(members.archivedAt),
+        ),
+      )
+      .get();
+
+    if (!orgRow || !targetRow) {
+      db.update(ownershipHandovers)
+        .set({ status: "canceled", resolvedAt: now, updatedAt: now })
+        .where(eq(ownershipHandovers.id, handoverId))
+        .run();
+      return null;
+    }
+
+    const roleChanges: { memberId: string; from: Role; to: Role }[] = [];
+    if (targetRow.role !== "owner") {
+      const promoted = db
+        .update(members)
+        .set({ role: "owner", updatedAt: now })
+        .where(eq(members.id, targetRow.id))
+        .returning()
+        .get();
+      if (promoted) {
+        roleChanges.push({
+          memberId: brandId<MemberId>(promoted.id),
+          from: targetRow.role,
+          to: "owner",
+        });
+      }
+    }
+
+    // Promote the recipient before changing the recorded owner, then demote
+    // the previous owner after the new recorded owner already holds owner.
+    db.update(organizations)
+      .set({ ownerId: acceptingUserId, updatedAt: now })
+      .where(eq(organizations.id, orgId))
+      .run();
+
+    const previousOwnerRow = db
+      .select()
+      .from(members)
+      .where(
+        and(
+          eq(members.orgId, orgId),
+          eq(members.userId, row.fromUserId),
+          eq(members.status, "active"),
+          isNull(members.archivedAt),
+        ),
+      )
+      .get();
+    if (previousOwnerRow?.role === "owner") {
+      const demoted = db
+        .update(members)
+        .set({ role: "admin", updatedAt: now })
+        .where(eq(members.id, previousOwnerRow.id))
+        .returning()
+        .get();
+      if (demoted) {
+        roleChanges.push({
+          memberId: brandId<MemberId>(demoted.id),
+          from: "owner",
+          to: "admin",
+        });
+      }
+    }
+
+    const updatedHandover = db
+      .update(ownershipHandovers)
+      .set({ status: "accepted", resolvedAt: now, updatedAt: now })
+      .where(
+        and(
+          eq(ownershipHandovers.id, handoverId),
+          eq(ownershipHandovers.status, "pending"),
+        ),
+      )
+      .returning()
+      .get();
+    const updatedOrg = db
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    if (!updatedHandover || !updatedOrg) throw new Error("Handover transaction failed");
+
+    return {
+      handover: toOwnershipHandover(updatedHandover),
+      organization: toOrganization(updatedOrg),
+      roleChanges,
+    };
+  });
+  return accept.immediate();
+}
+
+/** Withdraw an open offer when either participant leaves the workspace. */
+export async function cancelForParticipantLeaving(
+  orgId: OrgId,
+  userId: UserId,
+  now: string,
+): Promise<void> {
+  getDb()
+    .update(ownershipHandovers)
+    .set({ status: "canceled", resolvedAt: now, updatedAt: now })
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.status, "pending"),
+        gt(ownershipHandovers.expiresAt, now),
+        sql`(${ownershipHandovers.fromUserId} = ${userId} OR ${ownershipHandovers.toUserId} = ${userId})`,
+      ),
+    )
+    .run();
+}

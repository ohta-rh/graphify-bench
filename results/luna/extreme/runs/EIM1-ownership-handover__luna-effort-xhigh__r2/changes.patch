+++ /private/tmp/luna-scratch-20261008/305844f5-e013-4f27-b58c-8499dd2a20d3/src/server/repositories/ownership-handover-repository.ts	2026-10-08 16:32:45
@@ -0,0 +1,390 @@
+import { and, desc, eq, gt, isNull, lte, sql } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import { brandId, toOrganization, toOwnershipHandover } from "./_mappers";
+import type { MemberId, OrgId, UserId } from "@/types/common";
+import type { Role } from "@/types/member";
+import type { OwnershipHandover } from "@/types/organization";
+
+export interface AcceptedOwnershipHandover {
+  readonly handover: OwnershipHandover;
+  readonly organization: ReturnType<typeof toOrganization>;
+  readonly roleChanges: readonly {
+    readonly memberId: MemberId;
+    readonly from: Role;
+    readonly to: Role;
+  }[];
+}
+
+/** Return the current pending row, including one that has just lapsed. */
+export async function findPendingOwnershipHandover(
+  orgId: OrgId,
+): Promise<OwnershipHandover | null> {
+  const row = getDb()
+    .select()
+    .from(ownershipHandovers)
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.status, "pending"),
+      ),
+    )
+    .get();
+  return row ? toOwnershipHandover(row) : null;
+}
+
+export async function findLatestOwnershipHandoverForRecipient(
+  orgId: OrgId,
+  toUserId: UserId,
+): Promise<OwnershipHandover | null> {
+  const row = getDb()
+    .select()
+    .from(ownershipHandovers)
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.toUserId, toUserId),
+      ),
+    )
+    .orderBy(desc(ownershipHandovers.createdAt), desc(ownershipHandovers.id))
+    .get();
+  return row ? toOwnershipHandover(row) : null;
+}
+
+/** Move lapsed pending rows out of the partial unique index. */
+export async function expireLapsedOwnershipHandovers(
+  orgId: OrgId,
+  now: string,
+): Promise<void> {
+  getDb()
+    .update(ownershipHandovers)
+    .set({
+      status: "expired",
+      resolvedAt: sql`${ownershipHandovers.expiresAt}`,
+      updatedAt: now,
+    })
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.status, "pending"),
+        lte(ownershipHandovers.expiresAt, now),
+      ),
+    )
+    .run();
+}
+
+export async function markOwnershipHandoverExpired(
+  orgId: OrgId,
+  handoverId: string,
+  now: string,
+): Promise<OwnershipHandover | null> {
+  const db = getDb();
+  db.update(ownershipHandovers)
+    .set({
+      status: "expired",
+      resolvedAt: sql`${ownershipHandovers.expiresAt}`,
+      updatedAt: now,
+    })
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.id, handoverId),
+        eq(ownershipHandovers.status, "pending"),
+        lte(ownershipHandovers.expiresAt, now),
+      ),
+    )
+    .run();
+  const row = db
+    .select()
+    .from(ownershipHandovers)
+    .where(
+      and(
+        eq(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.id, handoverId),
+      ),
+    )
+    .get();
+  return row ? toOwnershipHandover(row) : null;
+}
+
+/** A transaction serializes competing offers and closes expired ones first. */
+export async function createOwnershipHandover(
+  input: {
+    readonly orgId: OrgId;
+    readonly fromUserId: UserId;
+    readonly toUserId: UserId;
+    readonly createdAt: string;
+    readonly expiresAt: string;
+  },
+): Promise<OwnershipHandover | null | "not_found" | "not_owner"> {
+  const db = getDb();
+  const create = db.$client.transaction(() => {
+    const org = db
+      .select({ ownerId: organizations.ownerId })
+      .from(organizations)
+      .where(eq(organizations.id, input.orgId))
+      .get();
+    if (!org || org.ownerId !== input.fromUserId) return "not_owner" as const;
+
+    db.update(ownershipHandovers)
+      .set({
+        status: "expired",
+        resolvedAt: sql`${ownershipHandovers.expiresAt}`,
+        updatedAt: input.createdAt,
+      })
+      .where(
+        and(
+          eq(ownershipHandovers.orgId, input.orgId),
+          eq(ownershipHandovers.status, "pending"),
+          lte(ownershipHandovers.expiresAt, input.createdAt),
+        ),
+      )
+      .run();
+
+    const pending = db
+      .select({ id: ownershipHandovers.id })
+      .from(ownershipHandovers)
+      .where(
+        and(
+          eq(ownershipHandovers.orgId, input.orgId),
+          eq(ownershipHandovers.status, "pending"),
+          gt(ownershipHandovers.expiresAt, input.createdAt),
+        ),
+      )
+      .get();
+    if (pending) return null;
+
+    const recipient = db
+      .select({ id: members.id })
+      .from(members)
+      .where(
+        and(
+          eq(members.orgId, input.orgId),
+          eq(members.userId, input.toUserId),
+          eq(members.status, "active"),
+          isNull(members.archivedAt),
+        ),
+      )
+      .get();
+    if (!recipient) return "not_found" as const;
+
+    const row = db
+      .insert(ownershipHandovers)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        fromUserId: input.fromUserId,
+        toUserId: input.toUserId,
+        status: "pending",
+        expiresAt: input.expiresAt,
+        resolvedAt: null,
+        createdAt: input.createdAt,
+        updatedAt: input.createdAt,
+      })
+      .returning()
+      .get();
+    return toOwnershipHandover(row);
+  });
+
+  return create.immediate();
+}
+
+/** Resolves a pending offer if it is still live; null means it was consumed. */
+export async function resolveOwnershipHandover(
+  orgId: OrgId,
+  handoverId: string,
+  status: "declined" | "canceled",
+  now: string,
+): Promise<OwnershipHandover | null> {
+  const db = getDb();
+  const resolve = db.$client.transaction(() => {
+    const row = db
+      .select()
+      .from(ownershipHandovers)
+      .where(
+        and(
+          eq(ownershipHandovers.orgId, orgId),
+          eq(ownershipHandovers.id, handoverId),
+          eq(ownershipHandovers.status, "pending"),
+        ),
+      )
+      .get();
+    if (!row) return null;
+    if (row.expiresAt <= now) {
+      db.update(ownershipHandovers)
+        .set({ status: "expired", resolvedAt: row.expiresAt, updatedAt: now })
+        .where(eq(ownershipHandovers.id, handoverId))
+        .run();
+      return null;
+    }
+
+    const updated = db

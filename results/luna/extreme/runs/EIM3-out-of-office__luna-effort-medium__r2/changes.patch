 /** How many members are scanned when counting the remaining owners. */
 const OWNER_SCAN_LIMIT = 100;
+
+export async function setAbsence(actor: Actor, input: SetAbsenceInput): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+  if (Date.parse(input.endsAt) <= Date.parse(input.startsAt)) throw new Error("Absence end must be after start");
+  const member = await memberRepo.findMember(input.orgId, input.userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", input.userId);
+  if (actor.userId !== input.userId) assertCan(actor, "member:update_role", memberResource(member));
+  if (input.delegateUserId !== null) {
+    if (input.delegateUserId === input.userId) throw new Error("A member cannot delegate to themselves");
+    const delegate = await memberRepo.findMember(input.orgId, input.delegateUserId);
+    if (!delegate || delegate.status !== "active") throw new NotFoundError("Member", input.delegateUserId);
+  }
+  return memberRepo.upsertAbsence({ orgId: input.orgId, userId: input.userId, delegateUserId: input.delegateUserId, startsAt: input.startsAt, endsAt: input.endsAt, note: input.note });
+}
+
+export async function clearAbsence(actor: Actor, orgId: OrgId, userId: UserId): Promise<void> {
+  assertOrgScope(actor, orgId);
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", userId);
+  if (actor.userId !== userId) assertCan(actor, "member:update_role", memberResource(member));
+  await memberRepo.clearAbsence(orgId, userId);
+}
+
+export async function getAbsence(actor: Actor, orgId: OrgId, userId: UserId): Promise<MemberAbsence | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "member:read", { kind: "organization", orgId });
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") throw new NotFoundError("Member", userId);
+  const absence = await memberRepo.findAbsence(orgId, userId);
+  return absence && Date.parse(absence.endsAt) > Date.now() ? absence : null;
+}
+
+export async function resolveAssignment(orgId: OrgId, userId: UserId, actorId: UserId): Promise<UserId> {
+  if (userId === actorId) return userId;
+  const absence = await memberRepo.findAbsence(orgId, userId);
+  if (!absence || Date.parse(absence.startsAt) > Date.now() || Date.parse(absence.endsAt) <= Date.now() || !absence.delegateUserId) return userId;
+  const delegate = await memberRepo.findMember(orgId, absence.delegateUserId);
+  return delegate?.status === "active" ? absence.delegateUserId : userId;
+}
+
+export async function getActiveDelegate(orgId: OrgId, userId: UserId, now = new Date()): Promise<UserId | null> {
+  const absence = await memberRepo.findAbsence(orgId, userId);
+  if (!absence || Date.parse(absence.startsAt) > now.getTime() || Date.parse(absence.endsAt) <= now.getTime() || !absence.delegateUserId) return null;
+  const delegate = await memberRepo.findMember(orgId, absence.delegateUserId);
+  return delegate?.status === "active" ? absence.delegateUserId : null;
+}
 

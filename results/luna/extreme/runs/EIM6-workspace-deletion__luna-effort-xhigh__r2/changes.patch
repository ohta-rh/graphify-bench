+/** Permanently removes every tenant row whose workspace passed its grace period. */
+export async function purgeArchivedOrgsBefore(
+  cutoff: string,
+): Promise<number> {
+  const db = getDb();
+
+  return db.transaction((tx) => {
+    const expired = tx
+      .select({ id: organizations.id })
+      .from(organizations)
+      .where(
+        and(
+          isNotNull(organizations.archivedAt),
+          lte(organizations.archivedAt, cutoff),
+        ),
+      )
+      .all();
+
+    for (const { id } of expired) {
+      // Sessions and user accounts are global. Clear only the workspace
+      // pointer, preserving the account and its ability to use other orgs.
+      tx.update(sessions)
+        .set({ activeOrgId: null })
+        .where(eq(sessions.activeOrgId, id))
+        .run();
+
+      tx.delete(issueLabels).where(eq(issueLabels.orgId, id)).run();
+      tx.delete(attachments).where(eq(attachments.orgId, id)).run();
+      tx.delete(comments).where(eq(comments.orgId, id)).run();
+      tx.delete(issues).where(eq(issues.orgId, id)).run();
+      tx.delete(projectMembers).where(eq(projectMembers.orgId, id)).run();
+      tx.delete(projects).where(eq(projects.orgId, id)).run();
+      tx.delete(labels).where(eq(labels.orgId, id)).run();
+      tx.delete(invitations).where(eq(invitations.orgId, id)).run();
+      tx.delete(members).where(eq(members.orgId, id)).run();
+      tx.delete(notifications).where(eq(notifications.orgId, id)).run();
+      tx.delete(notificationPreferences)
+        .where(eq(notificationPreferences.orgId, id))
+        .run();
+      tx.delete(activityEvents).where(eq(activityEvents.orgId, id)).run();
+      tx.delete(invoices).where(eq(invoices.orgId, id)).run();
+      tx.delete(subscriptions).where(eq(subscriptions.orgId, id)).run();
+      tx.delete(webhookDeliveries)
+        .where(eq(webhookDeliveries.orgId, id))
+        .run();
+      tx.delete(webhookEndpoints)
+        .where(eq(webhookEndpoints.orgId, id))
+        .run();
+      tx.delete(searchIndex).where(eq(searchIndex.orgId, id)).run();
+      tx.delete(rateLimitBuckets)
+        .where(eq(rateLimitBuckets.orgId, id))
+        .run();
+      tx.delete(organizationUsage)
+        .where(eq(organizationUsage.orgId, id))
+        .run();
+
+      // Recheck the retention predicate in the same transaction. A workspace
+      // restored before this sweep began is never removed.
+      tx.delete(organizations)
+        .where(

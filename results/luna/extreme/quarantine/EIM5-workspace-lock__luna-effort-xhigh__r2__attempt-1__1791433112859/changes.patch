@@ -0,0 +1,39 @@
+import type {
+  Subscription,
+  WorkspaceLockReason,
+} from "@/types/billing";
+import type { OrgId } from "@/types/common";
+
+export class WorkspaceLockedError extends Error {
+  readonly code = "plan_limit_exceeded" as const;
+
+  constructor(
+    readonly orgId: OrgId,
+    readonly reason: WorkspaceLockReason,
+  ) {
+    super(`Workspace is read-only because its subscription is ${reason}`);
+    this.name = "WorkspaceLockedError";
+  }
+}
+
+/** Returns the lock reason for a subscription at the supplied instant. */
+export function lockReasonFor(
+  subscription: Subscription | null,
+  now = new Date(),
+): WorkspaceLockReason | null {
+  if (subscription === null || subscription.status === "active") return null;
+
+  switch (subscription.status) {
+    case "past_due":
+      return "past_due";
+    case "trialing":
+      return new Date(subscription.currentPeriodEnd).getTime() <= now.getTime()
+        ? "trial_ended"
+        : null;
+    case "canceled":
+      return subscription.cancelAt === null ||
+        new Date(subscription.cancelAt).getTime() <= now.getTime()
+        ? "canceled"
+        : null;
+  }
+}

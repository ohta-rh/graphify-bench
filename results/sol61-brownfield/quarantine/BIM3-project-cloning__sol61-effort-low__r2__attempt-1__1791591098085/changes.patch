+
+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(source));
+  assertCan(actor, "project:create", orgResource(input.orgId));
+  assertNotArchived("Project", source.id, source);
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId), "Organization", input.orgId,
+  );
+  const used = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", used)) {
+    throw new Error(
+      `Plan ${org.plan} allows ${used} projects; upgrade to add another`,
+    );
+  }
+
+  const copies: Issue[] = [];
+  if (input.includeIssues) {
+    let cursor = null;
+    do {
+      const page = await issueRepo.listIssues({
+        orgId: input.orgId, projectId: source.id,
+        includeArchived: false, limit: 100, cursor,
+      });
+      copies.push(...page.items);
+      cursor = page.nextCursor;
+    } while (cursor !== null);
+  }
+  if (wouldExceedLimit(org.plan, "issuesPerProject", 0, copies.length)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${source.key}`,
+    );
+  }
+  const status = issueStatusSchema.parse(org.settings.defaultIssueStatus);
+  const project = await projectRepo.insertProject({
+    orgId: input.orgId, name: input.name, slug: input.slug, key: input.key,
+    description: source.description, visibility: source.visibility,
+    leadId: source.leadId, color: source.color, targetDate: null,
+  });
+  copies.sort((a, b) => a.number - b.number);
+  for (const [index, issue] of copies.entries()) {
+    await issueRepo.insertIssue({
+      orgId: input.orgId, projectId: project.id,
+      title: issue.title, description: issue.description,
+      priority: issue.priority, estimate: issue.estimate, dueAt: issue.dueAt,
+      labelIds: [...issue.labelIds], status, assigneeId: null, parentId: null,
+    }, actor.userId, index + 1);
+  }
+  await emit("project.cloned", {
+    ...actorEnvelope(actor), projectId: project.id,
+    sourceProjectId: source.id, issuesCopied: copies.length,
+  });
+  return project;
 }

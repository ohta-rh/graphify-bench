+/** Checks the chosen URL and swaps its retirement atomically with the slug. */
+export async function renameOrgSlug(
+  orgId: OrgId,
+  slug: string,
+): Promise<{ organization: Organization; from: string } | null> {
+  return getDb().transaction((tx) => {
+    const current = tx
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    if (!current) return null;
+    if (current.slug === slug) {
+      return { organization: toOrganization(current), from: current.slug };
+    }
+
+    const now = new Date();
+    const taken = tx
+      .select({ id: organizations.id })
+      .from(organizations)
+      .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId)))
+      .get();
+    const held = tx
+      .select({ slug: retiredOrganizationSlugs.slug })
+      .from(retiredOrganizationSlugs)
+      .where(
+        and(
+          eq(retiredOrganizationSlugs.slug, slug),
+          ne(retiredOrganizationSlugs.orgId, orgId),
+          gt(retiredOrganizationSlugs.retiredAt, retirementCutoff(now)),
+        ),
+      )
+      .get();
+    if (taken || held) throw new InvalidSlugError(slug, "is unavailable");
+
+    const stamp = toIsoTimestamp(now);
+    // Reclaiming an old URL ends its retirement, including any expired hold.
+    tx.delete(retiredOrganizationSlugs)
+      .where(eq(retiredOrganizationSlugs.slug, slug))
+      .run();
+    tx.insert(retiredOrganizationSlugs)
+      .values({ slug: current.slug, orgId, retiredAt: stamp })
+      .onConflictDoUpdate({
+        target: retiredOrganizationSlugs.slug,
+        set: { orgId, retiredAt: stamp },
+      })
+      .run();
+
+    const row = tx
+      .update(organizations)
+      .set({ slug, updatedAt: stamp })
+      .where(eq(organizations.id, orgId))
+      .returning()
+      .get();
+
+    return { organization: toOrganization(row), from: current.slug };
+  }, { behavior: "immediate" });
+}

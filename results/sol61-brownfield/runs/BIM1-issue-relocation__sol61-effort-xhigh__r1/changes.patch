+
+let cleanup: () => void;
+let detachActivity: Unsubscribe;
+let detachSearch: Unsubscribe;
+const captures: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachActivity = registerActivityListeners();
+  detachSearch = registerSearchListeners();
+});
+
+afterEach(() => {
+  while (captures.length > 0) captures.pop()?.();
+});
+
+afterAll(() => {
+  detachActivity();
+  detachSearch();
+  cleanup();
+});
+
+async function scenario(slug: string, plan: PlanId = "growth") {
+  const tenant = await createTenant(slug, plan);
+  const target = await projectRepo.insertProject({
+    orgId: tenant.org.id,
+    name: "Target project",
+    slug: "target",
+    key: "TGT",
+    description: null,
+    visibility: "private",
+    leadId: null,
+    color: "#6366f1",
+    targetDate: null,
+  });
+  return { ...tenant, target };
+}
+
+function capture<K extends TaskflowEventType>(type: K): TaskflowEventMap[K][] {
+  const seen: TaskflowEventMap[K][] = [];
+  captures.push(subscribe(type, (payload) => { seen.push(payload); }));
+  return seen;
+}
+
+function storedState() {
+  const db = getDb();
+  return {
+    issues: db.select().from(issues).all(),
+    counters: db.select().from(issueNumberCounters).all(),
+    activity: db.select().from(activityEvents).all(),
+    search: db.select().from(searchIndex).all(),
+  };
+}
+

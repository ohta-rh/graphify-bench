+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { ORG_SLUG_HOLD_DAYS } from "@/config/constants";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { InvalidSlugError } from "@/lib/slug";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { renameOrganizationSlugSchema } from "@/schemas/organization";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import * as orgService from "@/server/services/organization-service";
+import { resolveActorForOrg } from "@/server/services/session-service";
+import { toIsoTimestamp } from "@/types/common";
+import type { SessionPrincipal } from "@/types/member";
+import type { TaskflowEventMap, Unsubscribe } from "@/types/event";
+import { createTenant, useTemporaryDatabase } from "./_support/fixtures";
+import type { Tenant } from "./_support/fixtures";
+
+const start = new Date("2026-04-01T10:30:00.000Z");
+const day = 24 * 60 * 60 * 1000;
+const hold = ORG_SLUG_HOLD_DAYS * day;
+let cleanup: () => void;
+const detachers: Unsubscribe[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+});
+
+beforeEach(() => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(start);
+  detachers.push(registerActivityListeners());
+});
+
+afterEach(() => {
+  while (detachers.length) detachers.pop()?.();
+  vi.useRealTimers();
+});
+
+afterAll(() => cleanup());
+
+function capture(): TaskflowEventMap["organization.slug_changed"][] {
+  const seen: TaskflowEventMap["organization.slug_changed"][] = [];
+  detachers.push(subscribe("organization.slug_changed", (event) => { seen.push(event); }));
+  return seen;
+}
+
+function principal(tenant: Tenant): SessionPrincipal {
+  return {
+    userId: tenant.userIds.admin,
+    email: "admin@example.test",
+    activeOrgId: tenant.org.id,
+    expiresAt: toIsoTimestamp(new Date(start.getTime() + 90 * day)),
+  };
+}
+
+describe("workspace URL renaming", () => {
+  it("updates current reads, preserves settings, and publishes and audits once as the admin", async () => {
+    const tenant = await createTenant("rename-current");
+    const before = await orgService.updateOrganization(tenant.actors.admin, {
+      orgId: tenant.org.id,
+      name: "A new name",
+      logoUrl: "https://example.test/logo.png",
+      settings: { requireTwoFactor: true, digestHourUtc: 15 },
+    });
+    const seen = capture();
+    vi.setSystemTime(start.getTime() + day);
+    const input = renameOrganizationSlugSchema.parse({ orgId: tenant.org.id, slug: "renamed-current" });
+    const renamed = await orgService.renameOrganizationSlug(tenant.actors.admin, input);
+
+    expect(renamed).toEqual({ ...before, slug: input.slug, updatedAt: new Date().toISOString() });
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(renamed);
+    expect((await orgService.getOrganizationSummary(tenant.actors.admin, tenant.org.id)).organization).toEqual(renamed);
+    expect(await orgService.listOrganizationsForUser(tenant.userIds.admin)).toEqual([renamed]);
+    expect(await orgService.resolveOrgBySlug(before.slug)).toEqual(renamed);
+    expect(await orgService.resolveOrgBySlug(renamed.slug)).toEqual(renamed);
+    expect(await resolveActorForOrg(principal(tenant), before.slug)).toEqual(tenant.actors.admin);
+    expect(await resolveActorForOrg(principal(tenant), renamed.slug)).toEqual(tenant.actors.admin);
+    expect(seen).toEqual([{
+      orgId: tenant.org.id,
+      actorId: tenant.userIds.admin,
+      occurredAt: new Date().toISOString(),
+      from: before.slug,
+      to: renamed.slug,
+    }]);
+    const filter = activityFilterSchema.parse({ orgId: tenant.org.id, action: ["organization.slug_changed"] });
+    const activity = await listActivity(tenant.actors.admin, filter);
+    expect(activity.items).toHaveLength(1);
+    expect(activity.items[0]).toMatchObject({
+      action: "organization.slug_changed",
+      actorId: tenant.userIds.admin,
+      subjectKind: "organization",
+      subjectId: tenant.org.id,
+      projectId: null,
+      metadata: { from: before.slug, to: renamed.slug },
+    });
+  });
+
+  it("leaves a no-op unchanged and silent", async () => {
+    const tenant = await createTenant("rename-noop");
+    const seen = capture();
+    vi.setSystemTime(start.getTime() + day);
+    expect(await orgService.renameOrganizationSlug(tenant.actors.owner, {
+      orgId: tenant.org.id, slug: tenant.org.slug,
+    })).toEqual(tenant.org);
+    expect(seen).toEqual([]);
+    expect((await listActivity(tenant.actors.owner, activityFilterSchema.parse({
+      orgId: tenant.org.id, action: ["organization.slug_changed"],
+    }))).total).toBe(0);
+  });
+
+  it("uses settings permissions and rejects invalid or unavailable slugs without changing anything", async () => {
+    const tenant = await createTenant("rename-refusals");
+    const other = await createTenant("rename-occupied");
+    const deleted = await createTenant("rename-deleted");
+    await orgRepo.archiveOrg(deleted.org.id);
+    const seen = capture();
+    for (const role of ["member", "viewer"] as const) {
+      await expect(orgService.renameOrganizationSlug(tenant.actors[role], {
+        orgId: tenant.org.id, slug: "rename-forbidden",
+      })).rejects.toBeInstanceOf(PermissionDeniedError);
+    }
+    await expect(orgService.renameOrganizationSlug(other.actors.owner, {
+      orgId: tenant.org.id, slug: "rename-cross-tenant",
+    })).rejects.toBeInstanceOf(TenantScopeError);
+    for (const slug of ["Uppercase", "a", "bad--slug", "x".repeat(49), "settings", other.org.slug, deleted.org.slug]) {
+      await expect(orgService.renameOrganizationSlug(tenant.actors.admin, {
+        orgId: tenant.org.id, slug,
+      })).rejects.toBeInstanceOf(InvalidSlugError);
+    }
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(tenant.org);
+    expect(seen).toEqual([]);
+    expect((await listActivity(tenant.actors.owner, activityFilterSchema.parse({
+      orgId: tenant.org.id, action: ["organization.slug_changed"],
+    }))).total).toBe(0);
+  });
+
+  it("holds old URLs through the last millisecond and releases them at the exact boundary", async () => {
+    const tenant = await createTenant("rename-expiry");
+    const other = await createTenant("rename-expiry-other");
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-expiry-new" });
+    vi.setSystemTime(start.getTime() + hold - 1);
+    expect((await orgRepo.findOrgBySlug(tenant.org.slug))?.id).toBe(tenant.org.id);
+    expect(await resolveActorForOrg(principal(tenant), tenant.org.slug)).toEqual(tenant.actors.admin);
+    await expect(orgService.renameOrganizationSlug(other.actors.owner, {
+      orgId: other.org.id, slug: tenant.org.slug,
+    })).rejects.toBeInstanceOf(InvalidSlugError);
+    const suffixed = await orgService.createOrganization(other.userIds.owner, { name: "Derived", slug: tenant.org.slug, plan: "free" });
+    expect(suffixed.slug).toBe(`${tenant.org.slug}-2`);
+
+    vi.setSystemTime(start.getTime() + hold);
+    expect(await orgRepo.findOrgBySlug(tenant.org.slug)).toBeNull();
+    expect(await orgService.resolveOrgBySlug(tenant.org.slug)).toBeNull();
+    expect(await resolveActorForOrg(principal(tenant), tenant.org.slug)).toBeNull();
+    expect(await orgRepo.listTakenOrgSlugs(tenant.org.slug)).not.toContain(tenant.org.slug);
+    const reclaimed = await orgService.renameOrganizationSlug(other.actors.owner, { orgId: other.org.id, slug: tenant.org.slug });
+    expect(await orgService.resolveOrgBySlug(tenant.org.slug)).toEqual(reclaimed);
+    expect(await resolveActorForOrg(principal(tenant), tenant.org.slug)).toBeNull();
+    expect(await resolveActorForOrg(principal(other), tenant.org.slug)).toEqual(other.actors.admin);
+  });
+
+  it("also allows creation to reclaim an expired retirement", async () => {
+    const tenant = await createTenant("rename-create-expiry");
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-create-expiry-new" });
+    vi.setSystemTime(start.getTime() + hold);
+    const created = await orgService.createOrganization(tenant.userIds.owner, { name: "Reclaimed", slug: tenant.org.slug, plan: "free" });
+    expect(created.slug).toBe(tenant.org.slug);
+    expect(await orgRepo.findOrgBySlug(tenant.org.slug)).toEqual(created);
+  });
+
+  it("keeps independent holds along a chain and ends retirement when renaming back", async () => {
+    const tenant = await createTenant("rename-chain");
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-chain-second" });
+    vi.setSystemTime(start.getTime() + 5 * day);
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-chain-third" });
+    vi.setSystemTime(start.getTime() + hold);
+    expect(await orgRepo.findOrgBySlug(tenant.org.slug)).toBeNull();
+    expect((await orgRepo.findOrgBySlug("rename-chain-second"))?.slug).toBe("rename-chain-third");
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-chain-second" });
+    vi.setSystemTime(start.getTime() + hold + 5 * day);
+    expect((await orgRepo.findOrgBySlug("rename-chain-second"))?.id).toBe(tenant.org.id);
+    expect((await orgRepo.findOrgBySlug("rename-chain-third"))?.slug).toBe("rename-chain-second");
+    vi.setSystemTime(start.getTime() + 2 * hold);
+    expect(await orgRepo.findOrgBySlug("rename-chain-third")).toBeNull();
+    expect((await orgRepo.findOrgBySlug("rename-chain-second"))?.id).toBe(tenant.org.id);
+  });
+
+  it("keeps a deleted workspace's held URLs unavailable without resolving them", async () => {
+    const tenant = await createTenant("rename-held-deleted");
+    const other = await createTenant("rename-held-live");
+    await orgService.renameOrganizationSlug(tenant.actors.owner, { orgId: tenant.org.id, slug: "rename-held-deleted-new" });
+    await orgRepo.archiveOrg(tenant.org.id);
+    expect(await orgRepo.findOrgBySlug(tenant.org.slug)).toBeNull();
+    expect(await resolveActorForOrg(principal(tenant), tenant.org.slug)).toBeNull();
+    await expect(orgService.renameOrganizationSlug(other.actors.owner, {
+      orgId: other.org.id, slug: tenant.org.slug,
+    })).rejects.toBeInstanceOf(InvalidSlugError);
+    expect((await orgRepo.insertOrg({ name: "Held", slug: tenant.org.slug, plan: "free" }, other.userIds.owner)).slug).toBe(`${tenant.org.slug}-2`);
+  });
+});

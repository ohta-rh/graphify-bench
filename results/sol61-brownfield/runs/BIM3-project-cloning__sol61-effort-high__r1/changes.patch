+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as labelRepo from "@/server/repositories/label-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import { registerActivityListeners } from "@/server/services/activity-service";
+import { cloneProject } from "@/server/services/project-service";
+import { registerSearchListeners } from "@/server/services/search-service";
+import { registerUsageListeners } from "@/server/services/usage-service";
+import { toIsoTimestamp } from "@/types/common";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+import type { CloneProjectInput } from "@/schemas/project";
+import type { Unsubscribe } from "@/types/event";
+
+let cleanup: () => void;
+let detach: Unsubscribe[];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detach = [registerActivityListeners(), registerSearchListeners(), registerUsageListeners()];
+});
+
+afterAll(() => {
+  detach.forEach((off) => off());
+  cleanup();
+});
+
+function cloneInput(tenant: Tenant, overrides: Partial<CloneProjectInput> = {}): CloneProjectInput {
+  return {
+    orgId: tenant.org.id,
+    projectId: tenant.project.id,
+    name: "Next release",
+    slug: "next-release",
+    key: "NEXT",
+    includeIssues: true,
+    ...overrides,
+  };
+}
+
+describe("cloning a project", () => {
+  it("copies work, resets progress and publishes one event with immediate audit, search and usage", async () => {
+    const tenant = await createTenant("clonefresh");
+    await orgRepo.updateOrg(tenant.org.id, {
+      orgId: tenant.org.id, settings: { defaultIssueStatus: "todo" },
+    });
+    await projectRepo.updateProject({
+      orgId: tenant.org.id,
+      projectId: tenant.project.id,
+      description: "Release template",
+      visibility: "private",
+      status: "completed",
+      color: "#123456",
+      targetDate: toIsoTimestamp("2026-12-01T00:00:00.000Z"),
+    });
+    getDb().update(projects).set({ startsAt: "2026-01-01T00:00:00.000Z" })
+      .where(eq(projects.id, tenant.project.id)).run();
+    const label = await labelRepo.insertLabel({
+      orgId: tenant.org.id, name: "release", color: "#abcdef", description: null,
+    });
+    const first = await issueRepo.insertIssue({
+      ...issueInput(tenant.org.id, tenant.project.id),
+      title: "First release task",
+      description: "Keep this description",
+      priority: "high",
+      assigneeId: tenant.userIds.admin,
+      estimate: 8,
+      dueAt: toIsoTimestamp("2026-12-01T00:00:00.000Z"),
+      labelIds: [label.id],
+    }, tenant.userIds.owner, 4);
+    await issueRepo.setIssueStatus(tenant.org.id, first.id, "in_progress");
+    await issueRepo.setIssueStatus(tenant.org.id, first.id, "done");
+    const comment = await commentRepo.insertComment({
+      orgId: tenant.org.id, issueId: first.id, body: "Original conversation",
+      parentId: null, mentionedUserIds: [],
+    }, tenant.userIds.owner);
+    const attachment = await attachmentRepo.insertAttachment({
+      orgId: tenant.org.id, issueId: first.id, filename: "release.txt",
+      contentType: "text/plain", sizeBytes: 20,
+    }, tenant.userIds.owner);
+    await issueRepo.insertIssue({
+      ...issueInput(tenant.org.id, tenant.project.id),
+      title: "Second release task",
+      parentId: first.id,
+    }, tenant.userIds.owner, 12);
+    const archived = await issueRepo.insertIssue(
+      issueInput(tenant.org.id, tenant.project.id, { title: "Archived release task" }),
+      tenant.userIds.owner, 9,
+    );
+    await issueRepo.archiveIssue(tenant.org.id, archived.id);
+
+    const source = await projectRepo.findProjectById(tenant.org.id, tenant.project.id);
+    const sourceIssue = await issueRepo.findIssueById(tenant.org.id, first.id);
+    const usage = await usageRepo.recomputeUsage(tenant.org.id);
+    const created = vi.fn();
+    const issueCreated = vi.fn();
+    const cloned = vi.fn();
+    const errors = vi.fn();
+    const offs = [
+      subscribe("project.created", created), subscribe("issue.created", issueCreated),
+      subscribe("project.cloned", cloned), onHandlerError(errors),
+    ];
+    try {
+      const project = await cloneProject(tenant.actors.member, cloneInput(tenant, { slug: "platform" }));
+      expect(project).toEqual(await projectRepo.findProjectById(tenant.org.id, project.id));
+      expect(project).toMatchObject({
+        name: "Next release", slug: "platform-2", key: "NEXT",
+        description: source?.description, visibility: source?.visibility,
+        leadId: source?.leadId, color: source?.color,
+        status: "active", startsAt: null, targetDate: null, archivedAt: null,
+      });
+      const copies = await issueRepo.listIssues({ orgId: tenant.org.id, projectId: project.id, limit: 100 });
+      expect(copies.total).toBe(2);
+      const sorted = [...copies.items].sort((a, b) => a.number - b.number);
+      expect(sorted.map((issue) => [issue.number, issue.title])).toEqual([
+        [1, "First release task"], [2, "Second release task"],
+      ]);
+      for (const issue of sorted) {
+        expect(issue).toMatchObject({
+          authorId: tenant.userIds.member, status: "todo", assigneeId: null,
+          parentId: null, startedAt: null, completedAt: null, archivedAt: null,
+        });
+        expect(await commentRepo.countComments(tenant.org.id, issue.id)).toBe(0);
+        expect(await attachmentRepo.listAttachments(tenant.org.id, issue.id)).toEqual([]);
+      }
+      expect(sorted[0]).toMatchObject({
+        description: sourceIssue?.description, priority: "high", estimate: 8,
+        dueAt: sourceIssue?.dueAt, labelIds: [label.id],
+      });
+      expect(sorted[0].id).not.toBe(first.id);
+      expect(await issueRepo.nextIssueNumber(tenant.org.id, project.id)).toBe(3);
+      expect(await projectRepo.findProjectById(tenant.org.id, tenant.project.id)).toEqual(source);
+      expect(await issueRepo.findIssueById(tenant.org.id, first.id)).toEqual(sourceIssue);
+      expect(await commentRepo.findCommentById(tenant.org.id, comment.id)).toEqual(comment);
+      expect(await attachmentRepo.listAttachments(tenant.org.id, first.id)).toEqual([attachment]);
+      expect(created).not.toHaveBeenCalled();
+      expect(issueCreated).not.toHaveBeenCalled();
+      expect(cloned).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({
+        orgId: tenant.org.id, actorId: tenant.userIds.member, projectId: project.id,
+        sourceProjectId: tenant.project.id, issuesCopied: 2,
+      }));
+      const audit = await activityRepo.listActivity(activityFilterSchema.parse({
+        orgId: tenant.org.id, projectId: project.id, action: ["project.cloned"],
+      }));
+      expect(audit.items).toHaveLength(1);
+      expect(audit.items[0]).toMatchObject({
+        actorId: tenant.userIds.member, subjectKind: "project", subjectId: project.id,
+        projectId: project.id, metadata: { sourceProjectId: tenant.project.id, issuesCopied: 2 },
+      });
+      const hits = await searchRepo.searchDocuments({
+        orgId: tenant.org.id, q: "release", kinds: ["project", "issue"], limit: 100,
+      });
+      expect(hits.items.map((hit) => hit.subjectId)).toEqual(expect.arrayContaining([
+        project.id, ...sorted.map((issue) => issue.id),
+      ]));
+      expect(await usageRepo.getUsage(tenant.org.id)).toMatchObject({
+        projectsUsed: usage.projectsUsed + 1, issuesUsed: usage.issuesUsed + 2,
+      });
+      expect(errors).not.toHaveBeenCalled();
+    } finally {
+      offs.forEach((off) => off());
+    }
+  });
+
+  it("walks past the first page, orders by source numbers and skips archived issues", async () => {
+    const tenant = await createTenant("clonepages");
+    for (let number = 1; number <= 125; number += 1) {
+      const issue = await issueRepo.insertIssue(
+        issueInput(tenant.org.id, tenant.project.id, { title: `Task ${number}` }),
+        tenant.userIds.owner, number * 2,
+      );
+      if (number === 60) await issueRepo.archiveIssue(tenant.org.id, issue.id);
+    }
+    const project = await cloneProject(tenant.actors.member, cloneInput(tenant));
+    expect(await issueRepo.countIssues(tenant.org.id, project.id)).toBe(124);
+    expect(await issueRepo.findIssueByNumber(tenant.org.id, project.id, 60)).toMatchObject({ title: "Task 61" });
+    expect(await issueRepo.findIssueByNumber(tenant.org.id, project.id, 124)).toMatchObject({ title: "Task 125" });
+    expect(await issueRepo.nextIssueNumber(tenant.org.id, project.id)).toBe(125);
+    const indexed = await searchRepo.searchDocuments({ orgId: tenant.org.id, q: "Task", kinds: ["issue"], limit: 100 });
+    expect(indexed.total).toBe(124);
+  });
+
+  it("checks the entire batch before writes, accepts the quota boundary and can omit issues", async () => {
+    const tenant = await createTenant("clonebatch", "free");
+    for (let number = 1; number <= 101; number += 1) {
+      await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, number);
+    }
+    await expect(cloneProject(tenant.actors.member, cloneInput(tenant))).rejects.toThrow(/Plan free/);
+    expect(await projectRepo.countProjects(tenant.org.id)).toBe(1);
+    expect(await projectRepo.findProjectBySlug(tenant.org.id, "next-release")).toBeNull();
+    const empty = await cloneProject(tenant.actors.member, cloneInput(tenant, { includeIssues: false }));
+    expect(await issueRepo.countIssues(tenant.org.id, empty.id)).toBe(0);
+    await expect(cloneProject(tenant.actors.member, cloneInput(tenant, { key: "LAST" }))).rejects.toThrow(/allows 2 projects/);
+    await projectRepo.archiveProject(tenant.org.id, empty.id);
+    const archived = await issueRepo.findIssueByNumber(tenant.org.id, tenant.project.id, 101);
+    await issueRepo.archiveIssue(tenant.org.id, archived!.id);
+    const full = await cloneProject(tenant.actors.member, cloneInput(tenant, { key: "FULL" }));
+    expect(await issueRepo.countIssues(tenant.org.id, full.id)).toBe(100);
+  });
+
+  it("requires the acting member's permissions, tenant scope and a live source", async () => {
+    const tenant = await createTenant("cloneguards");
+    const other = await createTenant("cloneother");
+    await expect(cloneProject(tenant.actors.viewer, cloneInput(tenant))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(cloneProject(other.actors.owner, cloneInput(tenant))).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(cloneProject(tenant.actors.member, cloneInput(tenant, { projectId: other.project.id }))).rejects.toMatchObject({ code: "not_found" });
+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(cloneProject(tenant.actors.member, cloneInput(tenant))).rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await projectRepo.countProjects(tenant.org.id, { includeArchived: true })).toBe(1);
+  });
+
+  it("rolls back the whole clone when an issue write fails", async () => {
+    const tenant = await createTenant("clonerollback");
+    await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, 1);
+    await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, 2);
+    getDb().$client.exec(`CREATE TRIGGER reject_clone_issue BEFORE INSERT ON issues
+      WHEN NEW.number = 2 BEGIN SELECT RAISE(ABORT, 'issue write failed'); END`);
+    const cloned = vi.fn();
+    const off = subscribe("project.cloned", cloned);
+    try {
+      await expect(cloneProject(tenant.actors.member, cloneInput(tenant))).rejects.toThrow(/issue write failed/);
+      expect(await projectRepo.countProjects(tenant.org.id)).toBe(1);
+      expect(await issueRepo.countIssues(tenant.org.id, tenant.project.id)).toBe(2);
+      expect(cloned).not.toHaveBeenCalled();
+    } finally {
+      getDb().$client.exec("DROP TRIGGER reject_clone_issue");
+      off();
+    }
+  });
+});

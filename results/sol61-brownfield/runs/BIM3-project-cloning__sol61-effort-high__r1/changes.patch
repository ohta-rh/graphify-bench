+/** Persists the fresh project and its issue batch in one synchronous transaction. */
+export async function insertProjectClone(
+  input: CreateProjectInput,
+  sourceIssues: readonly Issue[],
+  authorId: UserId,
+  status: IssueStatus,
+): Promise<Project> {
+  const taken = await listTakenProjectSlugs(input.orgId);
+  const slug = uniqueSlug(input.slug, taken);
+
+  return getDb().transaction((tx) => {
+    const project = insertProjectRow(tx, input, slug);
+    const stamp = toIsoTimestamp(new Date());
+
+    sourceIssues.forEach((issue, index) => {
+      const id = newId();
+      tx.insert(issues)
+        .values({
+          id,
+          orgId: input.orgId,
+          projectId: project.id,
+          number: index + 1,
+          title: issue.title,
+          description: issue.description,
+          status,
+          priority: issue.priority,
+          authorId,
+          assigneeId: null,
+          parentId: null,
+          estimate: issue.estimate,
+          dueAt: issue.dueAt,
+          startedAt: null,
+          completedAt: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .run();
+
+      if (issue.labelIds.length > 0) {
+        tx.insert(issueLabels)
+          .values(
+            issue.labelIds.map((labelId) => ({
+              orgId: input.orgId,
+              issueId: id,
+              labelId,
+            })),
+          )
+          .run();
+      }
+    });
+
+    return project;
+  });
 }
 

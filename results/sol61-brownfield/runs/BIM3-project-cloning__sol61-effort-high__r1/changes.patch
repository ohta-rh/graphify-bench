+/** A fresh project and optionally every live source issue, announced as one batch. */
+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(source));
+  assertCan(actor, "project:create", orgResource(input.orgId));
+  assertNotArchived("Project", source.id, source);
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", used)) {
+    throw new Error(
+      `Plan ${org.plan} allows ${used} projects; upgrade to add another`,
+    );
+  }
+
+  const sourceIssues: Issue[] = [];
+  if (input.includeIssues) {
+    let cursor: string | null = null;
+    do {
+      const page = await issueRepo.listIssues({
+        orgId: input.orgId,
+        projectId: source.id,
+        limit: 100,
+        cursor,
+      });
+      sourceIssues.push(...page.items);
+      cursor = page.nextCursor;
+    } while (cursor !== null);
+    sourceIssues.sort((a, b) => a.number - b.number);
+  }
+
+  if (wouldExceedLimit(org.plan, "issuesPerProject", 0, sourceIssues.length)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${input.key}`,
+    );
+  }
+
+  const defaultStatus = issueStatusSchema.safeParse(org.settings.defaultIssueStatus);
+  const project = await projectRepo.insertProjectClone(
+    {
+      orgId: input.orgId,
+      name: input.name,
+      slug: input.slug,
+      key: input.key,
+      description: source.description,
+      visibility: source.visibility,
+      leadId: source.leadId,
+      color: source.color,
+      targetDate: null,
+    },
+    sourceIssues,
+    actor.userId,
+    defaultStatus.success ? defaultStatus.data : "backlog",
+  );
+
+  await emit("project.cloned", {
+    ...actorEnvelope(actor),
+    projectId: project.id,
+    sourceProjectId: source.id,
+    issuesCopied: sourceIssues.length,
   });
 
   return project;

+
+function cloneInput(tenant: Tenant, includeIssues = true) {
+  return cloneProjectSchema.parse({
+    orgId: tenant.org.id,
+    projectId: tenant.project.id,
+    name: "Next release",
+    slug: "next-release",
+    key: "NEXT",
+    includeIssues,
+  });
+}
+
+describe("project cloning", () => {
+  it("copies every live issue in number order, resets progress, and announces one clone", async () => {
+    const tenant = await createTenant("clonebatch");
+    await orgRepo.updateOrg(tenant.org.id, {
+      orgId: tenant.org.id,
+      settings: { defaultIssueStatus: "todo" },
+    });
+    await projectRepo.updateProject({
+      orgId: tenant.org.id,
+      projectId: tenant.project.id,
+      status: "completed",
+      description: "Reusable release checklist",
+      visibility: "private",
+      color: "#abcdef",
+      targetDate: toIsoTimestamp("2026-06-01"),
+    });
+    getDb().update(projects).set({ startsAt: "2026-05-01T00:00:00.000Z" })
+      .where(eq(projects.id, tenant.project.id)).run();
+    const label = await labelRepo.insertLabel({
+      orgId: tenant.org.id, name: "release", color: "#abcdef", description: null,
+    });
+    const originals: Issue[] = [];
+    for (let number = 1; number <= 106; number++) {
+      originals.push(await issueRepo.insertIssue({
+        ...issueInput(tenant.org.id, tenant.project.id),
+        title: `Checklist item ${number}`,
+        description: "Keep this detail",
+        priority: "high",
+        estimate: 3,
+        dueAt: toIsoTimestamp("2026-07-01"),
+        assigneeId: tenant.userIds.admin,
+        parentId: originals[0]?.id ?? null,
+        labelIds: [label.id],
+      }, tenant.userIds.owner, number * 10));
+    }
+    await issueRepo.setIssueStatus(tenant.org.id, originals[0].id, "in_progress");
+    await issueRepo.setIssueStatus(tenant.org.id, originals[0].id, "done");
+    await issueRepo.archiveIssue(tenant.org.id, originals[1].id);
+    const sourceProject = await projectRepo.findProjectById(tenant.org.id, tenant.project.id);
+    const sourceIssue = await issueRepo.findIssueById(tenant.org.id, originals[0].id);
+    await commentRepo.insertComment({
+      orgId: tenant.org.id, issueId: originals[0].id, body: "A conversation",
+      parentId: null, mentionedUserIds: [],
+    }, tenant.userIds.owner);
+    getDb().insert(attachments).values({
+      id: newId(), orgId: tenant.org.id, issueId: originals[0].id,
+      filename: "notes.txt", contentType: "text/plain", sizeBytes: 12,
+      uploadedBy: tenant.userIds.owner,
+    }).run();
+    const beforeUsage = await usageRepo.recomputeUsage(tenant.org.id);
+    const events: TaskflowEventMap["project.cloned"][] = [];
+    const created: unknown[] = [];
+    const offs = [
+      subscribe("project.cloned", (event) => { events.push(event); }),
+      subscribe("project.created", (event) => { created.push(event); }),
+      subscribe("issue.created", (event) => { created.push(event); }),
+    ];
+    try {
+      const cloned = await cloneProject(tenant.actors.member, {
+        ...cloneInput(tenant), slug: tenant.project.slug,
+      });
+      expect(cloned).toMatchObject({
+        name: "Next release", slug: "platform-2", key: "NEXT", status: "active",
+        description: sourceProject?.description, visibility: "private",
+        leadId: sourceProject?.leadId, color: "#abcdef", startsAt: null,
+        targetDate: null, archivedAt: null,
+      });
+      expect(cloned).toEqual(await projectRepo.findProjectById(tenant.org.id, cloned.id));
+      const columns = await issueRepo.listBoardColumns(tenant.org.id, cloned.id);
+      const copies = columns.flatMap((column) => column.issues).sort((a, b) => a.number - b.number);
+      expect(copies).toHaveLength(105);
+      const live = originals.filter((_, index) => index !== 1);
+      for (const [index, copy] of copies.entries()) {
+        expect(copy.id).not.toBe(live[index].id);
+        expect(copy).toMatchObject({
+          number: index + 1, title: live[index].title, description: live[index].description,
+          priority: "high", estimate: 3, dueAt: live[index].dueAt, labelIds: [label.id],
+          status: "todo", authorId: tenant.userIds.member, assigneeId: null,
+          parentId: null, startedAt: null, completedAt: null, archivedAt: null,
+        });
+      }
+      expect(await commentRepo.countComments(tenant.org.id, copies[0].id)).toBe(0);
+      expect(getDb().select().from(attachments).where(eq(attachments.issueId, copies[0].id)).all()).toEqual([]);
+      expect(await projectRepo.findProjectById(tenant.org.id, tenant.project.id)).toEqual(sourceProject);
+      expect(await issueRepo.findIssueById(tenant.org.id, originals[0].id)).toEqual(sourceIssue);
+      expect(events).toHaveLength(1);
+      expect(events[0]).toMatchObject({
+        orgId: tenant.org.id, actorId: tenant.userIds.member, projectId: cloned.id,
+        sourceProjectId: tenant.project.id, issuesCopied: 105,
+      });
+      expect(created).toEqual([]);
+      const audit = await activityRepo.listActivity(activityFilterSchema.parse({
+        orgId: tenant.org.id, projectId: cloned.id, action: ["project.cloned"],
+      }));
+      expect(audit.items).toHaveLength(1);
+      expect(audit.items[0]).toMatchObject({
+        actorId: tenant.userIds.member, subjectKind: "project", subjectId: cloned.id,
+        projectId: cloned.id, metadata: { sourceProjectId: tenant.project.id, issuesCopied: 105 },
+      });
+      const indexed = await searchRepo.searchDocuments({
+        orgId: tenant.org.id, projectId: cloned.id, q: "Checklist", kinds: ["issue"], limit: 100,
+      });
+      expect(indexed.total).toBe(105);
+      const indexedProject = await searchRepo.searchDocuments({
+        orgId: tenant.org.id, projectId: cloned.id, q: "Next release", kinds: ["project"], limit: 25,
+      });
+      expect(indexedProject.items[0]?.subjectId).toBe(cloned.id);
+      expect(await usageRepo.getUsage(tenant.org.id)).toMatchObject({
+        projectsUsed: beforeUsage.projectsUsed + 1, issuesUsed: beforeUsage.issuesUsed + 105,
+      });
+      expect((await createIssue(tenant.actors.member, issueInput(tenant.org.id, cloned.id))).number).toBe(106);
+    } finally {
+      offs.forEach((off) => off());
+    }
+  });
+
+  it("rejects an oversized batch without writing, and allows a project-only clone", async () => {
+    const tenant = await createTenant("clonequota", "free");
+    for (let number = 1; number <= 101; number++) {
+      await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, number);

+    await expect(cloneProject(tenant.actors.viewer, cloneInput(tenant))).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(cloneProject(other.actors.member, cloneInput(tenant))).rejects.toBeInstanceOf(TenantScopeError);
+    await expect(cloneProject(tenant.actors.member, { ...cloneInput(tenant), projectId: other.project.id }))

+    await projectRepo.archiveProject(tenant.org.id, tenant.project.id);
+    await expect(cloneProject(tenant.actors.member, cloneInput(tenant))).rejects.toThrow(/archived/i);
+    expect(await projectRepo.countProjects(tenant.org.id, { includeArchived: true })).toBe(1);

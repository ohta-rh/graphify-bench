+/** Writes a preflighted clone and its issues atomically, without announcements. */
+async function insertProjectClone(
+  input: Pick<CloneProjectInput, "orgId" | "name" | "slug" | "key">,
+  source: Project,
+  copies: readonly Issue[],
+  authorId: UserId,
+  status: IssueStatus,
+): Promise<Project> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const taken = tx
+      .select({ slug: projects.slug })
+      .from(projects)
+      .where(orgPredicate(projects.orgId, input.orgId))
+      .all();
+    const stamp = toIsoTimestamp(new Date());
+    const row = tx
+      .insert(projects)
+      .values({
+        id: newId(),
+        orgId: input.orgId,
+        name: input.name,
+        slug: uniqueSlug(input.slug, taken.map((project) => project.slug)),
+        key: input.key,
+        description: source.description,
+        visibility: source.visibility,
+        leadId: source.leadId,
+        color: source.color,
+        status: "active",
+        startsAt: null,
+        targetDate: null,
+        archivedAt: null,
+        createdAt: stamp,
+        updatedAt: stamp,
+      })
+      .returning()
+      .get();
+
+    for (const [index, issue] of copies.entries()) {
+      const id = newId();
+      tx.insert(issues)
+        .values({
+          id,
+          orgId: input.orgId,
+          projectId: row.id,
+          number: index + 1,
+          title: issue.title,
+          description: issue.description,
+          priority: issue.priority,
+          estimate: issue.estimate,
+          dueAt: issue.dueAt,
+          status,
+          authorId,
+          assigneeId: null,
+          parentId: null,
+          startedAt: null,
+          completedAt: null,
+          archivedAt: null,
+          createdAt: stamp,
+          updatedAt: stamp,
+        })
+        .run();
+      if (issue.labelIds.length > 0) {
+        tx.insert(issueLabels)
+          .values(issue.labelIds.map((labelId) => ({
+            orgId: input.orgId,
+            issueId: id,
+            labelId,
+          })))
+          .run();
+      }
+    }
+    return toProject(row);
+  });

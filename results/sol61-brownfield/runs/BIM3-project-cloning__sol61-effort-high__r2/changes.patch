+
+  it("excludes archived issues from the batch quota and accepts the exact limit", async () => {
+    const tenant = await createTenant("cloneexact", "free");
+    for (let number = 1; number <= 101; number++) {
+      const issue = await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, number);
+      if (number === 1) await issueRepo.archiveIssue(tenant.org.id, issue.id);
+    }
+    const cloned = await cloneProject(tenant.actors.member, cloneInput(tenant));
+    expect(await issueRepo.countIssues(tenant.org.id, cloned.id)).toBe(100);

+
+  it("rolls back the entire clone if an issue write fails", async () => {
+    const tenant = await createTenant("clonerollback");
+    for (const number of [10, 20]) {
+      await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id), tenant.userIds.owner, number);
+    }
+    getDb().$client.exec(`
+      CREATE TRIGGER fail_clone_issue BEFORE INSERT ON issues
+      WHEN NEW.number = 2
+      BEGIN SELECT RAISE(ABORT, 'copy write failed'); END;
+    `);
+    const events: unknown[] = [];
+    const off = subscribe("project.cloned", (event) => { events.push(event); });
+    try {
+      await expect(cloneProject(tenant.actors.member, cloneInput(tenant))).rejects.toThrow("copy write failed");
+      expect(await projectRepo.countProjects(tenant.org.id, { includeArchived: true })).toBe(1);

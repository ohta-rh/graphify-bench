+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { AlreadyArchivedError } from "@/lib/soft-delete";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { moveIssueToProjectSchema } from "@/schemas/issue";
+import * as attachmentRepo from "@/server/repositories/attachment-repository";
+import * as commentRepo from "@/server/repositories/comment-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as labelRepo from "@/server/repositories/label-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as searchRepo from "@/server/repositories/search-repository";
+import * as activityService from "@/server/services/activity-service";
+import * as issueService from "@/server/services/issue-service";
+import { NotFoundError } from "@/server/services/_support";
+import { registerSearchListeners } from "@/server/services/search-service";
+import { toIsoTimestamp } from "@/types/common";
+import type { TaskflowEventMap, Unsubscribe } from "@/types/event";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+let detachActivity: Unsubscribe;
+let detachSearch: Unsubscribe;
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detachActivity = activityService.registerActivityListeners();
+  detachSearch = registerSearchListeners();
+});
+
+afterAll(() => {
+  detachActivity();
+  detachSearch();
+  cleanup();
+});
+
+function targetProject(tenant: Tenant) {
+  return projectRepo.insertProject({
+    orgId: tenant.org.id,
+    name: "Target project",
+    slug: "target",
+    key: "TARGET",
+    description: null,
+    visibility: "org",
+    leadId: null,
+    color: "#6366f1",
+    targetDate: null,
+  });
+}
+
+describe("services/issue-service — move to project", () => {
+  it("moves only the issue, returns stored labels, and updates audit, search, lists and boards", async () => {
+    const tenant = await createTenant("move-relations");
+    const target = await targetProject(tenant);
+    const actor = tenant.actors.member;
+    const orgId = tenant.org.id;
+    const parent = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    const label = await labelRepo.insertLabel({ orgId, name: "bug", color: "#ff0000", description: null });
+    const original = await issueService.createIssue(actor, {
+      ...issueInput(orgId, tenant.project.id, { title: "Move search marker" }),
+      description: "Keep this description",
+      priority: "urgent",
+      assigneeId: tenant.userIds.owner,
+      parentId: parent.id,
+      estimate: 8,
+      dueAt: toIsoTimestamp(new Date("2027-01-01T00:00:00Z")),
+      labelIds: [label.id],
+    });
+    const child = await issueService.createIssue(actor, {
+      ...issueInput(orgId, tenant.project.id),
+      parentId: original.id,
+    });
+    await issueService.changeIssueStatus(actor, { orgId, issueId: original.id, status: "in_progress" });
+    await issueService.changeIssueStatus(actor, { orgId, issueId: original.id, status: "done" });
+    const before = (await issueRepo.findIssueById(orgId, original.id))!;
+    const comment = await commentRepo.insertComment({
+      orgId, issueId: before.id, body: "Keep this comment", parentId: null, mentionedUserIds: [],
+    }, actor.userId);
+    const attachment = await attachmentRepo.insertAttachment({
+      orgId, issueId: before.id, filename: "file.txt", contentType: "text/plain", sizeBytes: 12,
+    }, actor.userId);
+    const existing = await issueService.createIssue(actor, issueInput(orgId, target.id));
+    await issueService.archiveIssue(actor, orgId, existing.id);
+    const history = await activityService.listActivity(actor, { orgId, projectId: tenant.project.id, limit: 100 });
+
+    const events: TaskflowEventMap["issue.moved"][] = [];
+    const otherEvents = vi.fn();
+    const offs = [
+      subscribe("issue.moved", (event) => { events.push(event); }),
+      subscribe("issue.created", otherEvents),
+      subscribe("issue.updated", otherEvents),
+      subscribe("issue.archived", otherEvents),
+      subscribe("issue.status_changed", otherEvents),
+    ];
+    try {
+      const input = moveIssueToProjectSchema.parse({ orgId, issueId: before.id, toProjectId: target.id });
+      const after = await issueService.moveIssueToProject(actor, input);
+      expect(after).toEqual({ ...before, projectId: target.id, number: 2, updatedAt: after.updatedAt });
+      expect(await issueRepo.findIssueById(orgId, before.id)).toEqual(after);
+      expect(await issueRepo.findIssueById(orgId, parent.id)).toEqual(parent);
+      expect(await issueRepo.findIssueById(orgId, child.id)).toEqual(child);
+      expect(await commentRepo.findCommentById(orgId, comment.id)).toEqual(comment);
+      expect(await attachmentRepo.listAttachments(orgId, before.id)).toEqual([attachment]);
+      expect(events).toEqual([{
+        orgId, actorId: actor.userId, occurredAt: expect.any(String), issueId: before.id,
+        fromProjectId: before.projectId, toProjectId: target.id, fromNumber: before.number, toNumber: 2,
+      }]);
+      expect(otherEvents).not.toHaveBeenCalled();
+
+      const auditInput = activityFilterSchema.parse({ orgId, action: ["issue.moved"] });
+      const audit = await activityService.listActivity(actor, auditInput);
+      expect(audit.items).toHaveLength(1);
+      expect(audit.items[0]).toMatchObject({
+        action: "issue.moved", actorId: actor.userId, subjectKind: "issue", subjectId: before.id,
+        projectId: target.id,
+        metadata: { fromProjectId: before.projectId, toProjectId: target.id, fromNumber: before.number, toNumber: 2 },
+      });
+      expect(await activityService.listActivity(actor, { orgId, projectId: tenant.project.id, limit: 100 })).toEqual(history);
+      for (const projectId of [tenant.project.id, target.id]) {
+        const found = projectId === target.id;
+        const search = await searchRepo.searchDocuments({ orgId, projectId, q: "Move search marker", kinds: ["issue"], limit: 25 });
+        expect(search.items.map((row) => row.subjectId)).toEqual(found ? [before.id] : []);
+        const list = await issueService.listIssues(actor, { orgId, projectId, limit: 100 });
+        expect(list.items.some((issue) => issue.id === before.id)).toBe(found);
+        const board = await issueService.getBoard(actor, orgId, projectId);
+        expect(board.flatMap((column) => column.issues).some((issue) => issue.id === before.id)).toBe(found);
+      }
+    } finally {
+      offs.forEach((off) => off());
+    }
+  });
+
+  it("never reuses numbers after moving away or moving back", async () => {
+    const tenant = await createTenant("move-numbers");
+    const target = await targetProject(tenant);
+    const actor = tenant.actors.member;
+    const orgId = tenant.org.id;
+    const issue = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    const moved = await issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: target.id });
+    expect(moved.number).toBe(1);
+    const nextSource = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    expect(nextSource.number).toBe(2);
+    const returned = await issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: tenant.project.id });
+    expect(returned.number).toBe(3);
+    const nextTarget = await issueService.createIssue(actor, issueInput(orgId, target.id));
+    expect(nextTarget.number).toBe(2);
+    expect(await issueRepo.findIssueByNumber(orgId, target.id, 1)).toBeNull();
+    expect(await issueRepo.findIssueByNumber(orgId, tenant.project.id, 1)).toBeNull();
+  });
+
+  it("checks both edit permission and create permission, including ownership escalation", async () => {
+    const tenant = await createTenant("move-permissions");
+    const target = await targetProject(tenant);
+    const orgId = tenant.org.id;
+    const issue = await issueService.createIssue(tenant.actors.member, issueInput(orgId, tenant.project.id));
+    const owned = await issueRepo.insertIssue(issueInput(orgId, tenant.project.id), tenant.userIds.viewer, 2);
+    const events = vi.fn();
+    const off = subscribe("issue.moved", events);
+    try {
+      for (const [before, action] of [[issue, "issue:update"], [owned, "issue:create"]] as const) {
+        await expect(issueService.moveIssueToProject(tenant.actors.viewer, {
+          orgId, issueId: before.id, toProjectId: target.id,
+        })).rejects.toMatchObject({ name: PermissionDeniedError.name, action });
+        expect(await issueRepo.findIssueById(orgId, before.id)).toEqual(before);
+      }
+      expect(events).not.toHaveBeenCalled();
+      expect(await issueRepo.nextIssueNumber(orgId, target.id)).toBe(1);
+    } finally {
+      off();
+    }
+  });
+
+  it("enforces the target quota while treating a same-project move as a silent no-op", async () => {
+    const tenant = await createTenant("move-quota", "free");
+    const target = await targetProject(tenant);
+    const actor = tenant.actors.member;
+    const orgId = tenant.org.id;
+    const issue = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    const first = await issueRepo.insertIssue(issueInput(orgId, target.id), actor.userId, 1);
+    for (let number = 2; number <= 100; number += 1) {
+      await issueRepo.insertIssue(issueInput(orgId, target.id), actor.userId, number);
+    }
+    const events = vi.fn();
+    const off = subscribe("issue.moved", events);
+    try {
+      await expect(issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: target.id }))
+        .rejects.toThrow(/allows no more issues/);
+      expect(await issueRepo.findIssueById(orgId, issue.id)).toEqual(issue);
+      expect(await issueService.moveIssueToProject(actor, { orgId, issueId: first.id, toProjectId: target.id })).toEqual(first);
+      expect(await issueRepo.findIssueById(orgId, first.id)).toEqual(first);
+      expect(events).not.toHaveBeenCalled();
+      expect(await issueRepo.nextIssueNumber(orgId, target.id)).toBe(101);
+      await issueService.archiveIssue(actor, orgId, first.id);
+      const moved = await issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: target.id });
+      expect(moved.number).toBe(101);
+      expect(events).toHaveBeenCalledTimes(1);
+    } finally {
+      off();
+    }
+  });
+
+  it("refuses cross-workspace and archived targets without changing the issue", async () => {
+    const tenant = await createTenant("move-scope");
+    const other = await createTenant("move-other");
+    const target = await targetProject(tenant);
+    const orgId = tenant.org.id;
+    const actor = tenant.actors.member;
+    const issue = await issueService.createIssue(actor, issueInput(orgId, tenant.project.id));
+    await expect(issueService.moveIssueToProject(other.actors.owner, { orgId, issueId: issue.id, toProjectId: target.id }))
+      .rejects.toBeInstanceOf(TenantScopeError);
+    await expect(issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: other.project.id }))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await expect(issueService.moveIssueToProject(actor, { orgId, issueId: (await issueService.createIssue(other.actors.member, issueInput(other.org.id, other.project.id))).id, toProjectId: target.id }))
+      .rejects.toBeInstanceOf(NotFoundError);
+    await projectRepo.archiveProject(orgId, target.id);
+    await expect(issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: target.id }))
+      .rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await issueRepo.findIssueById(orgId, issue.id)).toEqual(issue);
+    const archived = await issueService.archiveIssue(actor, orgId, issue.id);
+    await expect(issueService.moveIssueToProject(actor, { orgId, issueId: issue.id, toProjectId: tenant.project.id }))
+      .rejects.toBeInstanceOf(AlreadyArchivedError);
+    expect(await issueRepo.findIssueById(orgId, issue.id)).toEqual(archived);
+  });
+});

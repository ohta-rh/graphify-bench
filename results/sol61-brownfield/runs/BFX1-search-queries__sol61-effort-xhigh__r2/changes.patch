+/** Query syntax shared by search execution and the dialog's hint line. */
+import type { ProjectId } from "@/types/common";
+
+export type SearchSubjectKind = "issue" | "comment" | "project";
+
+export const ALL_SEARCH_KINDS: readonly SearchSubjectKind[] = [
+  "issue",
+  "comment",
+  "project",
+];
+
+export interface ParsedSearchQuery {
+  readonly text: string;
+  readonly kinds: readonly SearchSubjectKind[];
+  readonly projectId: ProjectId | null;
+  readonly unknownTokens: readonly string[];
+}
+
+export const DEFAULT_SEARCH_KINDS: readonly SearchSubjectKind[] = ["issue"];
+
+export function parseSearchQuery(
+  raw: string,
+  advanced: boolean,
+  requestedKinds: readonly SearchSubjectKind[] = DEFAULT_SEARCH_KINDS,
+): ParsedSearchQuery {
+  if (!advanced) {
+    return {
+      text: raw.trim(),
+      kinds: DEFAULT_SEARCH_KINDS,
+      projectId: null,
+      unknownTokens: [],
+    };
+  }
+
+  let text = "";
+  let previousEnd = 0;
+  let removedToken = false;
+  const kinds: SearchSubjectKind[] = [];
+  const unknownTokens: string[] = [];
+  let projectId: ProjectId | null = null;
+
+  for (const match of raw.matchAll(/\S+/g)) {
+    const token = match[0];
+    const separator = token.indexOf(":");
+    if (separator <= 0) {
+      // Keep literal whitespace between free-text terms. Across a removed
+      // field token, retain a single separator between the remaining terms.
+      if (text.length > 0) {
+        text += removedToken ? " " : raw.slice(previousEnd, match.index);
+      }
+      text += token;
+      previousEnd = match.index + token.length;
+      removedToken = false;
+      continue;
+    }
+
+    removedToken = true;
+    const field = token.slice(0, separator).toLowerCase();
+    const value = token.slice(separator + 1);
+    if (value.length === 0) {
+      unknownTokens.push(token);
+    } else if (field === "kind" || field === "in") {
+      const kind = value.toLowerCase().replace(/s$/, "") as SearchSubjectKind;
+      if (ALL_SEARCH_KINDS.includes(kind)) kinds.push(kind);
+      else unknownTokens.push(token);
+    } else if (field === "project") {
+      projectId = value as ProjectId;
+    } else {
+      unknownTokens.push(token);
+    }
+  }
+
+  return {
+    text,
+    kinds: kinds.length > 0 ? kinds : requestedKinds,
+    projectId,
+    unknownTokens,
+  };
+}
+
+export function describeQuery(parsed: ParsedSearchQuery): string {
+  const parts = [`searching ${parsed.kinds.join(", ")}`];
+  if (parsed.projectId !== null) parts.push(`in project ${parsed.projectId}`);
+  if (parsed.unknownTokens.length > 0) {
+    parts.push(`ignoring ${parsed.unknownTokens.join(", ")}`);
+  }
+  return parts.join(" · ");
+}

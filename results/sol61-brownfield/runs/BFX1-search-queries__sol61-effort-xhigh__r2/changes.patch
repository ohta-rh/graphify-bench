+async function reindexSubject(
+  orgId: OrgId,
+  kind: SearchSubjectKind,
+  subjectId: string,
+): Promise<void> {
+  switch (kind) {
+    case "issue": {
+      const issue = await issueRepo.findIssueById(orgId, subjectId as Issue["id"]);
+      if (issue) return indexIssue(orgId, issue);
+      break;
+    }
+    case "comment": {
+      const comment = await commentRepo.findCommentById(
+        orgId,
+        subjectId as Comment["id"],
+      );
+      if (comment) return indexComment(orgId, comment);
+      break;
+    }
+    case "project": {
+      const project = await projectRepo.findProjectById(
+        orgId,
+        subjectId as Project["id"],
+      );
+      if (project) return indexProject(orgId, project);
+      break;
+    }
+  }
+  await removeFromIndex(orgId, kind, subjectId);
+}

@@ -0,0 +1,30 @@
+import {
+  CLOSED_ISSUE_STATUSES,
+  ISSUE_STATUSES,
+  type IssueStatus,
+} from "@/types/issue";
+
+/** Expand groups, discard unknown URL values, and keep each status once. */
+export function expandIssueStatuses(values: readonly string[]): IssueStatus[] {
+  const statuses = new Set<IssueStatus>();
+  for (const value of values) {
+    if (value === "open") {
+      for (const status of ISSUE_STATUSES) {
+        if (!CLOSED_ISSUE_STATUSES.includes(status)) statuses.add(status);
+      }
+    } else if (value === "closed") {
+      for (const status of CLOSED_ISSUE_STATUSES) statuses.add(status);
+    } else if (ISSUE_STATUSES.includes(value as IssueStatus)) {
+      statuses.add(value as IssueStatus);
+    }
+  }
+  return [...statuses];
+}
+
+/** Dates include the whole UTC day by using the next midnight exclusively. */
+export function issueDueBeforeCutoff(value: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
+  const cutoff = new Date(`${value}T00:00:00.000Z`);
+  cutoff.setUTCDate(cutoff.getUTCDate() + 1);
+  return cutoff.toISOString();
+}

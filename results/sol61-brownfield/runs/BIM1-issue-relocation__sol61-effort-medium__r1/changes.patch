+import type { Project } from "@/types/project";
+
+let cleanup: () => void;
+let tenant: Tenant;
+let target: Project;
+
+async function anotherProject(tenant: Tenant) {
+  return projectRepo.insertProject({
+    orgId: tenant.org.id,
+    name: "Destination",
+    slug: "destination",
+    key: "DEST",
+    description: null,
+    visibility: "private",
+    leadId: null,
+    color: "#6366f1",
+    targetDate: null,
+  });
+}
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  tenant = await createTenant("issue-move");
+  target = await anotherProject(tenant);
+});
+afterAll(() => cleanup());
+
+describe("moving issues between projects", () => {
+  it("renumbers, preserves fields and labels, updates search and boards, and appends target history", async () => {
+    const detach = [registerActivityListeners(), registerSearchListeners()];
+    try {
+      const label = await labelRepo.insertLabel({
+        orgId: tenant.org.id, name: "Kept label", color: "#6366f1", description: null,
+      });
+      const parent = await issueService.createIssue(tenant.actors.member,
+        issueInput(tenant.org.id, tenant.project.id));
+      const before = await issueService.createIssue(tenant.actors.member, {
+        ...issueInput(tenant.org.id, tenant.project.id),
+        title: "Movable searchable issue",
+        description: "Keep this description",
+        status: "in_review",
+        priority: "urgent",
+        assigneeId: tenant.userIds.admin,
+        parentId: parent.id,
+        estimate: 8,
+        labelIds: [label.id],
+      });
+      const existing = await issueService.createIssue(tenant.actors.member,
+        issueInput(tenant.org.id, target.id));
+      await issueService.archiveIssue(tenant.actors.member, tenant.org.id, existing.id);
+
+      const events: unknown[] = [];
+      const otherEvents: unknown[] = [];
+      detach.push(subscribe("issue.moved", (payload) => { events.push(payload); }));
+      for (const event of ["issue.created", "issue.updated", "issue.archived"] as const) {
+        detach.push(subscribe(event, (payload) => { otherEvents.push(payload); }));
+      }
+      const input = moveIssueToProjectSchema.parse({
+        orgId: tenant.org.id, issueId: before.id, toProjectId: target.id,
+      });
+      const moved = await issueService.moveIssueToProject(tenant.actors.admin, input);
+      expect(moved).toEqual({
+        ...before, projectId: target.id, number: existing.number + 1,
+        updatedAt: expect.any(String),
+      });
+      expect(await issueRepo.findIssueById(tenant.org.id, before.id)).toEqual(moved);
+      expect(events).toEqual([expect.objectContaining({
+        actorId: tenant.userIds.admin, issueId: before.id,
+        fromProjectId: before.projectId, toProjectId: target.id,
+        fromNumber: before.number, toNumber: moved.number,
+      })]);
+      expect(otherEvents).toEqual([]);
+      expect(await issueRepo.findIssueByNumber(tenant.org.id, before.projectId, before.number)).toBeNull();
+      const history = await activityRepo.listActivityForSubject(tenant.org.id, "issue", before.id);
+      expect(history.find((entry) => entry.action === "issue.created")?.projectId).toBe(before.projectId);
+      expect(history.filter((entry) => entry.action === "issue.moved")).toEqual([
+        expect.objectContaining({
+          projectId: target.id, actorId: tenant.userIds.admin,
+          metadata: { fromProjectId: before.projectId, toProjectId: target.id,
+            fromNumber: before.number, toNumber: moved.number },
+        }),
+      ]);
+      const filtered = await activityRepo.listActivity(activityFilterSchema.parse({
+        orgId: tenant.org.id, action: ["issue.moved"],
+      }));
+      expect(filtered.items.map((entry) => entry.subjectId)).toEqual([before.id]);
+      for (const project of [tenant.project, target]) {
+        const search = await searchRepo.searchDocuments({
+          orgId: tenant.org.id, projectId: project.id, q: "Movable", kinds: ["issue"],
+          limit: 25, cursor: null,
+        });
+        expect(search.items.map((hit) => hit.subjectId)).toEqual(project.id === target.id ? [before.id] : []);
+        const board = await issueRepo.listBoardColumns(tenant.org.id, project.id);
+        expect(board.flatMap((column) => column.issues).some((issue) => issue.id === before.id))
+          .toBe(project.id === target.id);
+      }
+      const next = await issueService.createIssue(tenant.actors.member,
+        issueInput(tenant.org.id, tenant.project.id));
+      expect(next.number).toBe(before.number + 1);

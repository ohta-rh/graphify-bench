+      await issueRepo.insertIssue(issueInput(free.org.id, fullTarget.id), free.userIds.member, number);
+    }
+    const before = await issueService.createIssue(free.actors.member,
+      issueInput(free.org.id, free.project.id));
+    const seen: unknown[] = [];
+    const off = subscribe("issue.moved", (payload) => { seen.push(payload); });
+    try {
+      await expect(issueService.moveIssueToProject(free.actors.member, {
+        orgId: free.org.id, issueId: before.id, toProjectId: target.id,
+      })).rejects.toMatchObject({ code: "not_found" });
+      await expect(issueService.moveIssueToProject(free.actors.member, {
+        orgId: free.org.id, issueId: before.id, toProjectId: fullTarget.id,

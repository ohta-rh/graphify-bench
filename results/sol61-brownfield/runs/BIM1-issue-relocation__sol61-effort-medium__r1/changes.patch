+    .values({ orgId, projectId, lastNumber })
+    .onConflictDoUpdate({
+      target: [issueNumberCounters.orgId, issueNumberCounters.projectId],
+      set: { lastNumber: sql`max(${issueNumberCounters.lastNumber}, ${lastNumber})` },
+    })
+    .run();
+}
+
+function allocateIssueNumber(orgId: OrgId, projectId: ProjectId): number {
+  const db = getDb();
+  return db.transaction(() => {
+    rememberIssueNumbers(orgId, projectId);
+    const row = db.update(issueNumberCounters)
+      .set({ lastNumber: sql`${issueNumberCounters.lastNumber} + 1` })
+      .where(and(
+        eq(issueNumberCounters.orgId, orgId),
+        eq(issueNumberCounters.projectId, projectId),
+      ))
+      .returning()
+      .get();
+    return row.lastNumber;
+  });

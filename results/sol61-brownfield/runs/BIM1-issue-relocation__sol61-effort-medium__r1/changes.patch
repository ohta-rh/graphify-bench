+      const noOpEvents = events.length;
+      expect(await issueService.moveIssueToProject(tenant.actors.member, {
+        ...input, toProjectId: before.projectId,
+      })).toEqual(returned);
+      expect(events).toHaveLength(noOpEvents);
+    } finally {
+      for (const off of detach) off();
+    }
+  });
+
+  it("requires target creation permission even when ownership grants issue editing", async () => {
+    const before = await issueRepo.insertIssue(issueInput(tenant.org.id, tenant.project.id),

+      .set({ slug, updatedAt: toIsoTimestamp(new Date(now)) })
+      .where(eq(organizations.id, orgId)).returning().get();
+    return { organization: toOrganization(updated), from: current.slug };
+  }, { behavior: "immediate" });
 }

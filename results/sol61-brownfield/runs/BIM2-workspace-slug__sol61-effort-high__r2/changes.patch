+/** Atomically claim the chosen URL and retire the replaced URL. */
+export async function renameOrgSlug(
+  orgId: OrgId,
+  slug: string,
+): Promise<{ organization: Organization; from: string }> {
+  assertValidSlug(slug);
+  return getDb().transaction((tx) => {
+    const current = tx.select().from(organizations)
+      .where(eq(organizations.id, orgId)).get();
+    if (!current) throw new Error(`Organization ${orgId} not found`);
+    if (current.slug === slug) {
+      return { organization: toOrganization(current), from: current.slug };
+    }
+
+    const now = Date.now();
+    const occupied = tx.select({ id: organizations.id }).from(organizations)
+      .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId))).get();
+    const held = tx.select().from(organizationRetiredSlugs)
+      .where(and(
+        eq(organizationRetiredSlugs.slug, slug),
+        ne(organizationRetiredSlugs.orgId, orgId),
+        gt(organizationRetiredSlugs.retiredAt, retirementCutoff(now)),
+      )).get();
+    if (occupied || held) throw new InvalidSlugError(slug, "is unavailable");
+
+    tx.delete(organizationRetiredSlugs)
+      .where(eq(organizationRetiredSlugs.slug, slug)).run();
+    const retired = { slug: current.slug, orgId, retiredAt: toIsoTimestamp(new Date(now)) };

+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { ORG_SLUG_HOLD_DAYS } from "@/config/constants";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { InvalidSlugError } from "@/lib/slug";
+import { TenantScopeError } from "@/lib/tenant";
+import { activityFilterSchema } from "@/schemas/activity";
+import { renameOrganizationSlugSchema } from "@/schemas/organization";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import {
+  createOrganization,
+  getOrganizationSummary,
+  listOrganizationsForUser,
+  renameOrganizationSlug,
+  resolveOrgBySlug,
+} from "@/server/services/organization-service";
+import { resolveActorForOrg } from "@/server/services/session-service";
+import { toIsoTimestamp } from "@/types/common";
+import type { TaskflowEventMap, Unsubscribe } from "@/types/event";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+import type { Tenant } from "../server/_support/fixtures";
+
+const start = Date.UTC(2026, 0, 1);
+const day = 24 * 60 * 60 * 1000;
+let sequence = 0;
+let tenant: Tenant;
+let cleanup: () => void;
+let events: TaskflowEventMap["organization.slug_changed"][];
+let offs: Unsubscribe[];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+});
+
+beforeEach(async () => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(start);
+  tenant = await createTenant(`rename-${++sequence}`);
+  events = [];
+  offs = [
+    registerActivityListeners(),
+    subscribe("organization.slug_changed", (event) => { events.push(event); }),
+  ];
+});
+
+afterEach(() => {
+  offs.forEach((off) => off());
+  vi.useRealTimers();
+});
+
+afterAll(() => cleanup());
+
+function rename(slug: string) {
+  return renameOrganizationSlug(tenant.actors.admin, { orgId: tenant.org.id, slug });
+}
+
+async function resolveActor(slug: string) {
+  return resolveActorForOrg({
+    userId: tenant.userIds.admin,
+    email: "admin@example.test",
+    activeOrgId: tenant.org.id,
+    expiresAt: toIsoTimestamp(new Date(start + 90 * day)),
+  }, slug);
+}
+
+async function audit() {
+  return listActivity(tenant.actors.admin, activityFilterSchema.parse({
+    orgId: tenant.org.id,
+    action: ["organization.slug_changed"],
+  }));
+}
+
+describe("workspace slug renaming", () => {
+  it("updates the stored slug in every reader and announces the admin once", async () => {
+    const input = renameOrganizationSlugSchema.parse({ orgId: tenant.org.id, slug: "chosen-url" });
+    vi.setSystemTime(start + day);
+    const updated = await renameOrganizationSlug(tenant.actors.admin, input);
+    expect(updated).toEqual({
+      ...tenant.org, slug: input.slug, updatedAt: toIsoTimestamp(new Date(start + day)),
+    });
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(updated);
+    expect((await getOrganizationSummary(tenant.actors.admin, tenant.org.id)).organization).toEqual(updated);
+    expect(await listOrganizationsForUser(tenant.userIds.admin)).toEqual([updated]);
+    for (const slug of [input.slug, tenant.org.slug]) {
+      expect(await resolveOrgBySlug(slug)).toEqual(updated);
+      expect(await orgRepo.findOrgBySlug(slug)).toEqual(updated);
+      expect(await resolveActor(slug)).toEqual(tenant.actors.admin);
+    }
+    expect(events).toEqual([{
+      orgId: tenant.org.id, actorId: tenant.userIds.admin,
+      occurredAt: updated.updatedAt, from: tenant.org.slug, to: input.slug,
+    }]);
+    const page = await audit();
+    expect(page.items).toHaveLength(1);
+    expect(page.items[0]).toMatchObject({
+      action: "organization.slug_changed", actorId: tenant.userIds.admin,
+      subjectKind: "organization", subjectId: tenant.org.id,
+      projectId: null, metadata: { from: tenant.org.slug, to: input.slug },
+    });
+  });
+
+  it("does not write or publish when given the current slug", async () => {
+    vi.setSystemTime(start + day);
+    expect(await rename(tenant.org.slug)).toEqual(tenant.org);
+    expect(events).toEqual([]);
+    expect((await audit()).items).toEqual([]);
+    vi.setSystemTime(start + 2 * day);
+    await rename("actual-change");
+    vi.setSystemTime(start + (2 + ORG_SLUG_HOLD_DAYS) * day - 1);
+    expect(await resolveOrgBySlug(tenant.org.slug)).not.toBeNull();
+  });
+
+  it("rejects invalid slugs, other tenants and roles without settings permission without changes", async () => {
+    for (const slug of ["Bad Slug", "a", "ab--cd", "billing", "x".repeat(49)]) {
+      await expect(rename(slug)).rejects.toBeInstanceOf(InvalidSlugError);
+    }
+    for (const role of ["member", "viewer"] as const) {
+      await expect(renameOrganizationSlug(tenant.actors[role], {
+        orgId: tenant.org.id, slug: "forbidden-url",
+      })).rejects.toBeInstanceOf(PermissionDeniedError);
+    }
+    const other = await createTenant(`other-${sequence}`);
+    await expect(renameOrganizationSlug(other.actors.owner, {
+      orgId: tenant.org.id, slug: "foreign-url",
+    })).rejects.toBeInstanceOf(TenantScopeError);
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(tenant.org);
+    expect(events).toEqual([]);
+    expect((await audit()).items).toEqual([]);
+  });
+
+  it("refuses current slugs held by live or deleted workspaces without suffixing", async () => {
+    const other = await createTenant(`occupied-${sequence}`);
+    await expect(rename(other.org.slug)).rejects.toBeInstanceOf(InvalidSlugError);
+    await orgRepo.archiveOrg(other.org.id);
+    await expect(rename(other.org.slug)).rejects.toBeInstanceOf(InvalidSlugError);
+    expect(await orgRepo.findOrgById(tenant.org.id)).toEqual(tenant.org);
+    expect(events).toEqual([]);
+    expect((await audit()).items).toEqual([]);
+  });
+
+  it("holds retired URLs until the exact expiry and releases them for rename", async () => {
+    const old = tenant.org.slug;
+    const other = await createTenant(`expiry-${sequence}`);
+    await rename("expiry-new-url");
+    const claim = () => renameOrganizationSlug(other.actors.admin, { orgId: other.org.id, slug: old });
+    vi.setSystemTime(start + ORG_SLUG_HOLD_DAYS * day - 1);
+    expect(await orgRepo.findOrgBySlug(old)).toMatchObject({ id: tenant.org.id, slug: "expiry-new-url" });
+    expect(await resolveActor(old)).toEqual(tenant.actors.admin);
+    await expect(claim()).rejects.toBeInstanceOf(InvalidSlugError);
+    vi.setSystemTime(start + ORG_SLUG_HOLD_DAYS * day);
+    expect(await resolveOrgBySlug(old)).toBeNull();
+    expect(await orgRepo.findOrgBySlug(old)).toBeNull();
+    expect(await resolveActor(old)).toBeNull();
+    expect((await claim()).slug).toBe(old);
+    expect(await resolveOrgBySlug(old)).toMatchObject({ id: other.org.id });
+  });
+
+  it("suffixes held slugs at creation but reuses them at expiry", async () => {
+    const old = tenant.org.slug;
+    await rename("creation-new-url");
+    const create = () => createOrganization(tenant.userIds.owner, { name: "New workspace", slug: old, plan: "free" });
+    expect((await create()).slug).toBe(`${old}-2`);
+    vi.setSystemTime(start + ORG_SLUG_HOLD_DAYS * day);
+    const claimed = await create();
+    expect(claimed.slug).toBe(old);
+    expect(await resolveOrgBySlug(old)).toEqual(claimed);
+  });
+
+  it("gives every slug in a rename chain its own hold", async () => {
+    const old = tenant.org.slug;
+    await rename("chain-middle");
+    vi.setSystemTime(start + 5 * day);
+    await rename("chain-latest");
+    vi.setSystemTime(start + ORG_SLUG_HOLD_DAYS * day);
+    expect(await resolveOrgBySlug(old)).toBeNull();
+    expect(await resolveOrgBySlug("chain-middle")).toMatchObject({ id: tenant.org.id, slug: "chain-latest" });
+    vi.setSystemTime(start + (5 + ORG_SLUG_HOLD_DAYS) * day);
+    expect(await resolveOrgBySlug("chain-middle")).toBeNull();
+    expect(await resolveOrgBySlug("chain-latest")).not.toBeNull();
+  });
+
+  it("ends a slug's retirement on rename back and starts a fresh hold when replaced again", async () => {
+    const old = tenant.org.slug;
+    await rename("back-middle");
+    vi.setSystemTime(start + 5 * day);
+    await rename(old);
+    vi.setSystemTime(start + ORG_SLUG_HOLD_DAYS * day);
+    expect(await resolveOrgBySlug(old)).toMatchObject({ slug: old });
+    await rename("back-latest");
+    vi.setSystemTime(start + (5 + ORG_SLUG_HOLD_DAYS) * day);
+    expect(await resolveOrgBySlug("back-middle")).toBeNull();
+    expect(await resolveOrgBySlug(old)).toMatchObject({ slug: "back-latest" });
+    vi.setSystemTime(start + 2 * ORG_SLUG_HOLD_DAYS * day);
+    expect(await resolveOrgBySlug(old)).toBeNull();
+  });
+
+  it("keeps deleted workspaces' retired URLs reserved without resolving them", async () => {
+    const old = tenant.org.slug;
+    await rename("deleted-new-url");
+    await orgRepo.archiveOrg(tenant.org.id);
+    const other = await createTenant(`deleted-${sequence}`);
+    expect(await resolveOrgBySlug(old)).toBeNull();
+    expect(await resolveActor(old)).toBeNull();
+    await expect(renameOrganizationSlug(other.actors.owner, {
+      orgId: other.org.id, slug: old,
+    })).rejects.toBeInstanceOf(InvalidSlugError);
+    expect((await createOrganization(other.userIds.owner, {
+      name: "Another workspace", slug: old, plan: "free",
+    })).slug).toBe(`${old}-2`);
+  });
+
+  it("allows only one of two competing renames to claim a slug", async () => {
+    const other = await createTenant(`competing-${sequence}`);
+    const results = await Promise.allSettled([
+      rename("contested-url"),
+      renameOrganizationSlug(other.actors.owner, { orgId: other.org.id, slug: "contested-url" }),
+    ]);
+    expect(results.filter((result) => result.status === "fulfilled")).toHaveLength(1);
+    expect(results.filter((result) => result.status === "rejected")).toEqual([
+      expect.objectContaining({ reason: expect.any(InvalidSlugError) }),
+    ]);
+    expect(events).toHaveLength(1);
+  });
+});

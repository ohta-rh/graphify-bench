+import type { IssueId, ProjectId } from "@/types/common";
+import type { TaskflowEventType, Unsubscribe } from "@/types/event";
+import type { Project } from "@/types/project";
+
+let cleanup: () => void;
+let detach: Unsubscribe[];
+let tenant: Tenant;
+let target: Project;
+let sequence = 0;
+const testDetachers: Unsubscribe[] = [];
+const handlerErrors: unknown[] = [];
+
+beforeAll(async () => {
+  cleanup = await useTemporaryDatabase();
+  detach = [
+    registerActivityListeners(),
+    registerSearchListeners(),
+    onHandlerError((_type, error) => handlerErrors.push(error)),
+  ];
+});
+
+beforeEach(async () => {
+  tenant = await createTenant(`issue-move-${++sequence}`, "free");
+  target = await projectRepo.insertProject({
+    orgId: tenant.org.id,
+    name: "Destination",
+    slug: "destination",
+    key: "DEST",
+    description: null,
+    visibility: "org",
+    leadId: null,
+    color: "#6366f1",
+    targetDate: null,
+  });
+});
+
+afterEach(() => {
+  testDetachers.splice(0).forEach((off) => off());
+  expect(handlerErrors.splice(0)).toEqual([]);
+});
+
+afterAll(() => {
+  detach.forEach((off) => off());
+  cleanup();
+});
+
+function captureIssueEvents() {
+  const seen: { type: TaskflowEventType; payload: unknown }[] = [];
+  for (const type of [
+    "issue.created", "issue.updated", "issue.archived", "issue.moved",
+    "issue.status_changed", "issue.assigned",
+  ] as const) {
+    testDetachers.push(subscribe(type, (payload) => {
+      seen.push({ type, payload });
+    }));
+  }
+  return seen;
+}
+
+async function createIssue(projectId = tenant.project.id) {
+  return issueService.createIssue(
+    tenant.actors.owner,
+    issueInput(tenant.org.id, projectId),
+  );
+}
+
+describe("moving issues between projects", () => {

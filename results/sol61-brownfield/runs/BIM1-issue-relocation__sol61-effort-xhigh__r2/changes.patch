+      ...issueInput(tenant.org.id, tenant.project.id),
+      title: "RelocationSearchMarker",
+      description: "Keep this description",
+      priority: "urgent",
+      assigneeId: tenant.userIds.admin,
+      estimate: 8,
+      dueAt: toIsoTimestamp(new Date("2026-08-01T00:00:00.000Z")),
+      labelIds: [label.id],
+      parentId: parent.id,
+    });
+    await issueService.changeIssueStatus(tenant.actors.owner, {
+      orgId: tenant.org.id, issueId: issue.id, status: "in_progress",
+    });
+    await issueService.changeIssueStatus(tenant.actors.owner, {
+      orgId: tenant.org.id, issueId: issue.id, status: "done",
+    });
+    issue = (await issueRepo.findIssueById(tenant.org.id, issue.id))!;
+    const child = await issueService.createIssue(tenant.actors.owner, {
+      ...issueInput(tenant.org.id, tenant.project.id),
+      parentId: issue.id,
+    });
+    const comment = await commentRepo.insertComment({
+      orgId: tenant.org.id,
+      issueId: issue.id,
+      body: "Keep this discussion",
+      parentId: null,
+      mentionedUserIds: [],
+    }, tenant.userIds.member);
+    const attachment = await attachmentRepo.insertAttachment({
+      orgId: tenant.org.id,
+      issueId: issue.id,
+      filename: "design.png",
+      contentType: "image/png",
+      sizeBytes: 100,
+    }, tenant.userIds.member);
+    const existing = await createIssue(target.id);
+    await issueService.archiveIssue(tenant.actors.owner, tenant.org.id, existing.id);
+
+    const sourceAudit = await activityRepo.listActivity({
+      orgId: tenant.org.id, projectId: tenant.project.id, limit: 100,
+    });
+    const events = captureIssueEvents();
+    const moved = await issueService.moveIssueToProject(tenant.actors.member, {
+      orgId: tenant.org.id, issueId: issue.id, toProjectId: target.id,
+    });
+
+    expect(moved).toEqual({
+      ...issue, projectId: target.id, number: existing.number + 1,
+      updatedAt: expect.any(String),
+    });
+    expect(await issueRepo.findIssueById(tenant.org.id, issue.id)).toEqual(moved);
+    expect(await issueRepo.findIssueById(tenant.org.id, parent.id)).toEqual(parent);
+    expect(await issueRepo.findIssueById(tenant.org.id, child.id)).toEqual(child);
+    expect(await commentRepo.findCommentById(tenant.org.id, comment.id)).toEqual(comment);
+    expect(await attachmentRepo.listAttachments(tenant.org.id, issue.id)).toEqual([attachment]);
+    expect(events).toEqual([{
+      type: "issue.moved",
+      payload: {
+        orgId: tenant.org.id,
+        actorId: tenant.userIds.member,
+        occurredAt: expect.any(String),
+        issueId: issue.id,
+        fromProjectId: issue.projectId,
+        toProjectId: target.id,
+        fromNumber: issue.number,
+        toNumber: moved.number,
+      },
+    }]);
+
+    expect(await activityRepo.listActivity({
+      orgId: tenant.org.id, projectId: tenant.project.id, limit: 100,
+    })).toEqual(sourceAudit);
+    const moveAudit = await activityRepo.listActivity(activityFilterSchema.parse({
+      orgId: tenant.org.id, projectId: target.id, action: ["issue.moved"],
+    }));
+    expect(moveAudit.total).toBe(1);
+    expect(moveAudit.items[0]).toMatchObject({
+      action: "issue.moved",
+      actorId: tenant.userIds.member,
+      subjectKind: "issue",
+      subjectId: issue.id,
+      projectId: target.id,
+      metadata: {
+        fromProjectId: issue.projectId, toProjectId: target.id,
+        fromNumber: issue.number, toNumber: moved.number,
+      },
+    });
+
+    for (const projectId of [tenant.project.id, target.id]) {
+      const ids = (await issueRepo.listIssues({
+        orgId: tenant.org.id, projectId, limit: 100, labelIds: [label.id],
+      })).items.map((row) => row.id);
+      const boardIds = (await issueRepo.listBoardColumns(tenant.org.id, projectId))
+        .flatMap((column) => column.issues.map((row) => row.id));
+      const searchIds = (await searchRepo.searchDocuments({
+        orgId: tenant.org.id, projectId, q: issue.title, kinds: ["issue"], limit: 100,
+      })).items.map((row) => row.subjectId);
+      for (const result of [ids, boardIds, searchIds]) {
+        if (projectId === target.id) expect(result).toContain(issue.id);
+        else expect(result).not.toContain(issue.id);
+      }
+    }
+    expect(await issueRepo.findIssueByNumber(tenant.org.id, issue.projectId, issue.number)).toBeNull();
+    expect((await issueRepo.findIssueByNumber(tenant.org.id, target.id, moved.number))?.id).toBe(issue.id);
+  });
+
+  it("never reuses numbers when the highest issue moves away and back", async () => {
+    await createIssue();
+    const issue = await createIssue();
+    const seeded = await issueRepo.insertIssue(
+      issueInput(tenant.org.id, target.id), tenant.userIds.owner, 40,
+    );
+    await issueRepo.archiveIssue(tenant.org.id, seeded.id);
+
+    const moved = await issueService.moveIssueToProject(tenant.actors.member, {
+      orgId: tenant.org.id, issueId: issue.id, toProjectId: target.id,

+/** Checks availability, retires the old URL and claims the new URL atomically. */
+export async function renameOrgSlug(
+  orgId: OrgId,
+  slug: string,
+): Promise<{ organization: Organization; from: string } | null> {
+  return getDb().transaction((tx) => {
+    const current = tx
+      .select()
+      .from(organizations)
+      .where(eq(organizations.id, orgId))
+      .get();
+    if (!current) return null;
+    if (current.slug === slug) {
+      return { organization: toOrganization(current), from: current.slug };
+    }
+
+    const now = new Date();
+    const taken = tx
+      .select({ id: organizations.id })
+      .from(organizations)
+      .where(eq(organizations.slug, slug))
+      .get();
+    const held = tx
+      .select({ slug: organizationSlugRetirements.slug })
+      .from(organizationSlugRetirements)
+      .where(
+        and(
+          eq(organizationSlugRetirements.slug, slug),
+          ne(organizationSlugRetirements.orgId, orgId),
+          gt(organizationSlugRetirements.retiredAt, slugHoldCutoff(now)),
+        ),
+      )
+      .get();
+    if (taken || held) throw new InvalidSlugError(slug, "is already taken or held");
+
+    // Reclaiming a retired URL ends its retirement. Any other row here has
+    // already expired, and can likewise be removed before claiming the slug.
+    tx.delete(organizationSlugRetirements)
+      .where(eq(organizationSlugRetirements.slug, slug))
+      .run();
+
+    const stamp = toIsoTimestamp(now);
+    tx.insert(organizationSlugRetirements)
+      .values({ slug: current.slug, orgId, retiredAt: stamp })
+      .onConflictDoUpdate({
+        target: organizationSlugRetirements.slug,
+        set: { orgId, retiredAt: stamp },
+      })
+      .run();
+
+    const row = tx
+      .update(organizations)
+      .set({ slug, updatedAt: stamp })
+      .where(eq(organizations.id, orgId))
+      .returning()
+      .get();
+
+    return { organization: toOrganization(row), from: current.slug };
+  }, { behavior: "immediate" });
+}

+function principal(target = tenant): SessionPrincipal {
+  return {
+    userId: target.userIds.admin,
+    email: `admin@${target.org.slug}.test`,
+    activeOrgId: target.org.id,
+    expiresAt: toIsoTimestamp(new Date(START + 100 * DAY)),
+  };
+}
+
+function audit(target = tenant) {
+  return activityRepo.listActivity(activityFilterSchema.parse({
+    orgId: target.org.id,
+    action: ["organization.slug_changed"],
+  }));
+}

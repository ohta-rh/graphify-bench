+
+/** Pages through live comments independently of their thread ancestry. */
+export async function listLiveCommentsForIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+  limit: number,
+  cursor: string | null,
+): Promise<Page<Comment>> {
+  const sort = { sortColumn: comments.createdAt, idColumn: comments.id };
+  const filters = and(
+    orgPredicate(comments.orgId, orgId),
+    eq(comments.issueId, issueId),
+    isNull(comments.archivedAt),
+  );
+  const db = getDb();
+  const total = db.select({ value: count() }).from(comments).where(filters).get();
+  const rows = db
+    .select()
+    .from(comments)
+    .where(and(filters, ...compact(keysetPredicate(sort, cursor))))
+    .orderBy(desc(comments.createdAt), desc(comments.id))
+    .limit(probeLimit(limit))
+    .all();
+  return toPage(rows, limit, total?.value ?? 0, toComment, (row) => ({
+    id: row.id,
+    sortValue: row.createdAt,
+  }));
 }
 

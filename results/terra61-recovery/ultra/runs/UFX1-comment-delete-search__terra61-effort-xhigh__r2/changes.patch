+/** Remove all indexed comments belonging to one issue, including deleted ones. */
+export async function deleteIssueComments(orgId: OrgId, issueId: IssueId): Promise<void> {
+  const db = getDb();
+  const commentIds = db.select({ id: comments.id }).from(comments).where(and(
+    orgPredicate(comments.orgId, orgId),
+    eq(comments.issueId, issueId),
+  ));
+  db.delete(searchIndex).where(and(
+    orgPredicate(searchIndex.orgId, orgId),
+    eq(searchIndex.subjectKind, "comment"),
+    inArray(searchIndex.subjectId, commentIds),
+  )).run();
+}
+
+/** Discard stale documents before rebuilding one workspace's index. */
+export async function clearSearchDocuments(orgId: OrgId): Promise<void> {
+  getDb().delete(searchIndex).where(orgPredicate(searchIndex.orgId, orgId)).run();

@@ -0,0 +1,21 @@
+import { and, eq, inArray, ne, or } from "drizzle-orm";
+import { getDb, projectMembers, projects } from "@/server/db";
+import { hasRoleAtLeast } from "@/types/member";
+import type { Actor } from "@/types/member";
+import type { SQL } from "drizzle-orm";
+
+/** Predicate for queries already scoped to the actor's organization. */
+export function projectVisibilityPredicate(actor: Actor): SQL | undefined {
+  if (actor.isPlatformStaff || hasRoleAtLeast(actor.role, "admin")) return undefined;
+
+  return or(
+    ne(projects.visibility, "private"),
+    eq(projects.leadId, actor.userId),
+    inArray(
+      projects.id,
+      getDb().select({ id: projectMembers.projectId }).from(projectMembers).where(
+        and(eq(projectMembers.orgId, actor.orgId), eq(projectMembers.userId, actor.userId)),
+      ),
+    ),
+  );
+}

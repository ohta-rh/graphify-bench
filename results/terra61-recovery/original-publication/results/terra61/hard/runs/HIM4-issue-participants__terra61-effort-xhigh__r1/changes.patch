+export async function getIssueParticipants(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly UserId[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "comment:read", issueResource(issue));
+
+  const commentAuthorIds = await commentRepo.listCommentAuthorIds(orgId, issueId);
+  const candidates = new Set<UserId>([issue.authorId, ...commentAuthorIds]);
+  if (issue.assigneeId !== null) candidates.add(issue.assigneeId);
+
+  const ids = [...candidates];
+  const members = await Promise.all(ids.map((id) => memberRepo.findMember(orgId, id)));
+  return ids.filter((_, index) => members[index]?.status === "active");
+}

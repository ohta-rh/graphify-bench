@@ -0,0 +1,53 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/actor", () => ({ getActor: vi.fn(), requireActorFor: vi.fn() }));
+vi.mock("@/lib/cache", () => ({
+  CACHE_PROFILES: { minutes: "minutes" },
+  orgTag: (id: string) => `org:${id}`,
+  revalidateTagged: vi.fn(),
+}));
+
+import { toggleFeatureFlagAction } from "@/actions/flags/toggle-flag";
+import { requireActorFor } from "@/lib/actor";
+import { isEnabled } from "@/lib/feature-flags";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { buildFlagContext, toggleFlag } from "@/server/services/feature-flag-service";
+import { resetTestDb, seedTwoTenants } from "../helpers/db";
+import { makeActor } from "../helpers/factories";
+
+beforeEach(async () => {
+  await resetTestDb();
+});
+
+describe("workspace feature overrides", () => {
+  it("removes only the selected override and can add it again", async () => {
+    const { orgA } = await seedTwoTenants();
+    const actor = makeActor({ orgId: orgA.id, role: "admin" });
+    vi.mocked(requireActorFor).mockResolvedValue(actor);
+    const toggle = (flag: string, enabled: boolean) =>
+      toggleFeatureFlagAction({ orgId: orgA.id, flag, enabled });
+
+    expect((await toggle("kanban_board", true)).ok).toBe(true);
+    expect((await toggle("csv_export", true)).ok).toBe(true);
+    expect((await toggle("kanban_board", false)).ok).toBe(true);
+    let stored = (await orgRepo.findOrgById(orgA.id))!;
+    expect(stored.settings.enabledFlagOverrides).toEqual(["csv_export"]);
+    expect(isEnabled("kanban_board", buildFlagContext(actor, stored))).toBe(false);
+
+    expect((await toggle("kanban_board", true)).ok).toBe(true);
+    stored = (await orgRepo.findOrgById(orgA.id))!;
+    expect(stored.settings.enabledFlagOverrides).toEqual(["csv_export", "kanban_board"]);
+    expect(isEnabled("kanban_board", buildFlagContext(actor, stored))).toBe(true);
+  });
+
+  it("rejects non-overridable flags even when their own rule enables them", async () => {
+    const { orgA } = await seedTwoTenants();
+    const actor = makeActor({ orgId: orgA.id, role: "admin" });
+    vi.mocked(requireActorFor).mockResolvedValue(actor);
+    for (const flag of ["webhooks", "command_palette"] as const) {
+      expect((await toggleFeatureFlagAction({ orgId: orgA.id, flag, enabled: true })).ok).toBe(false);
+      await expect(toggleFlag(actor, { orgId: orgA.id, flag, enabled: true })).rejects.toThrow(/cannot be overridden/);
+    }
+    expect((await orgRepo.findOrgById(orgA.id))?.settings.enabledFlagOverrides).toEqual([]);
+  });
+});

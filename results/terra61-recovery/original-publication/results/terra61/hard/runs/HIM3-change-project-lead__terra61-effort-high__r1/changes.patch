+export async function changeProjectLead(
+  actor: Actor,
+  input: ChangeProjectLeadInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  const resource = projectResource(project);
+  assertCan(actor, "project:change_lead", resource);
+  assertNotArchived("Project", project.id, project);
+
+  if (input.leadId !== null) {
+    const member = await memberRepo.findMember(input.orgId, input.leadId);
+    const activeMember = requireFound(
+      member?.status === "active" ? member : null,
+      "Member",
+      input.leadId,
+    );
+    assertCan(
+      { userId: activeMember.userId, orgId: activeMember.orgId, role: activeMember.role },
+      "project:update",
+      resource,
+    );
+  }
+
+  return projectRepo.changeProjectLead(input.orgId, input.projectId, input.leadId);
 }
 

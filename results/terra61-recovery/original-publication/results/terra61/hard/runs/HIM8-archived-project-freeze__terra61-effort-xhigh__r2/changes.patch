@@ -0,0 +1,79 @@
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+vi.mock("@/lib/rate-limit", async () => (await import("../server/_support/doubles/misc")).rateLimitModule);
+
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { resetOverdueTracking, runOverdueIssueJob } from "@/server/jobs/overdue-issue-job";
+import * as commentRepo from "@/server/repositories/comment-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as usageRepo from "@/server/repositories/usage-repository";
+import * as attachments from "@/server/services/attachment-service";
+import * as comments from "@/server/services/comment-service";
+import * as issues from "@/server/services/issue-service";
+import * as projects from "@/server/services/project-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+it("freezes issue writes and overdue announcements until the project is restored", async () => {
+  const tenant = await createTenant("project-freeze");
+  const { org, project, actors } = tenant;
+  const issue = await issues.createIssue(actors.member, issueInput(org.id, project.id, { dueAt: "2020-01-01T00:00:00.000Z" }));
+  const comment = await comments.createComment(actors.member, { orgId: org.id, issueId: issue.id, body: "Original", parentId: null, mentionedUserIds: [] });
+  const upload = { orgId: org.id, issueId: issue.id, filename: "file.txt", contentType: "text/plain", sizeBytes: 100 };
+  const attachment = await attachments.addAttachment(actors.member, upload);
+  await usageRepo.recomputeUsage(org.id);
+  await projects.archiveProject(actors.admin, { orgId: org.id, projectId: project.id, archiveIssues: false });
+
+  const emitted: string[] = [];
+  const off = [
+    subscribe("issue.updated", () => { emitted.push("updated"); }),
+    subscribe("issue.status_changed", () => { emitted.push("status"); }),
+    subscribe("issue.assigned", () => { emitted.push("assigned"); }),
+    subscribe("issue.archived", () => { emitted.push("archived"); }),
+    subscribe("comment.created", () => { emitted.push("comment created"); }),
+    subscribe("comment.deleted", () => { emitted.push("comment deleted"); }),
+    subscribe("issue.overdue", () => { emitted.push("overdue"); }),
+  ];
+  try {
+    const target = { orgId: org.id, issueId: issue.id };
+    const writes = [
+      () => issues.updateIssue(actors.member, { ...target, title: "Changed" }),
+      () => issues.changeIssueStatus(actors.member, { ...target, status: "todo" }),
+      () => issues.moveIssue(actors.member, { ...target, toStatus: "backlog", toIndex: 0 }),
+      () => issues.assignIssue(actors.member, { ...target, assigneeId: tenant.userIds.member }),
+      () => issues.assignIssue(actors.member, { ...target, assigneeId: null }),
+      () => issues.archiveIssue(actors.admin, org.id, issue.id),
+      () => comments.createComment(actors.member, { ...target, body: "New", parentId: null, mentionedUserIds: [] }),
+      () => comments.updateComment(actors.member, { orgId: org.id, commentId: comment.id, body: "Changed" }),
+      () => comments.deleteComment(actors.member, { orgId: org.id, commentId: comment.id }),
+      () => attachments.addAttachment(actors.member, upload),
+      () => attachments.removeAttachment(actors.member, { orgId: org.id, attachmentId: attachment.id }),
+    ];
+    for (const write of writes) await expect(write()).rejects.toMatchObject({ name: "AlreadyArchivedError", entity: "Project", id: project.id });
+    await expect(issues.updateIssue(actors.viewer, { ...target, title: "Denied" })).rejects.toBeInstanceOf(PermissionDeniedError);
+    expect((await issues.getIssue(actors.member, org.id, issue.id)).issue).toEqual(issue);
+    expect(await comments.getThread(actors.member, org.id, issue.id)).toHaveLength(1);
+    expect(await attachments.listAttachments(actors.member, org.id, issue.id)).toHaveLength(1);
+    resetOverdueTracking();
+    await runOverdueIssueJob(new Date("2026-01-01T00:00:00Z"));
+    expect(emitted).toEqual([]);
+
+    await commentRepo.archiveComment(org.id, comment.id);
+    await expect(comments.deleteComment(actors.member, { orgId: org.id, commentId: comment.id })).rejects.toMatchObject({ name: "AlreadyArchivedError", entity: "Comment" });
+    await issueRepo.archiveIssue(org.id, issue.id);
+    await expect(issues.updateIssue(actors.member, { ...target, title: "Denied" })).rejects.toMatchObject({ name: "AlreadyArchivedError", entity: "Issue" });
+    await issueRepo.restoreIssue(org.id, issue.id);
+    await projects.restoreProject(actors.admin, org.id, project.id);
+    await issues.updateIssue(actors.member, { ...target, title: "Unfrozen" });
+    await runOverdueIssueJob(new Date("2026-01-01T00:00:00Z"));
+    expect(emitted).toEqual(["updated", "overdue"]);
+  } finally {
+    off.forEach((unsubscribe) => unsubscribe());
+  }
+});

+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import { subscribe } from "@/lib/event-bus";
+import { activityActionSchema } from "@/schemas/activity";
+import { notificationKindSchema } from "@/schemas/notification";
+import { webhookEventTypeSchema } from "@/schemas/webhook";
+import { getDb, webhookDeliveries } from "@/server/db";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as webhookRepo from "@/server/repositories/webhook-repository";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import * as issueService from "@/server/services/issue-service";
+import * as memberService from "@/server/services/member-service";
+import { listNotifications } from "@/server/services/notification-service";
+import { registerWebhookListeners } from "@/server/services/webhook-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "./_support/fixtures";
+import type { TaskflowEventMap } from "@/types/event";
+import type { WebhookId } from "@/types/common";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+describe("issue.unassigned", () => {
+  it("removes all live assignments when a member leaves, preserving archived and other assignments", async () => {
+    const tenant = await createTenant("unassign-removal", "growth");
+    const other = await createTenant("unassign-other", "growth");
+    const target = await memberRepo.findMember(tenant.org.id, tenant.userIds.member);
+    if (!target) throw new Error("fixture member missing");
+    const make = (assigneeId: typeof tenant.userIds.member) => issueService.createIssue(
+      tenant.actors.owner, issueInput(tenant.org.id, tenant.project.id, { assigneeId }),
+    );
+    const live = [await make(target.userId), await make(target.userId)];
+    const archived = await make(target.userId);
+    await issueService.archiveIssue(tenant.actors.owner, tenant.org.id, archived.id);
+    const retained = await make(tenant.userIds.admin);
+    const otherIssue = await issueService.createIssue(other.actors.owner,
+      issueInput(other.org.id, other.project.id, { assigneeId: target.userId }));
+    const seen: TaskflowEventMap["issue.unassigned"][] = [];
+    const off = subscribe("issue.unassigned", (event) => { seen.push(event); });
+    try {
+      await memberService.removeMember(tenant.actors.owner, { orgId: tenant.org.id, memberId: target.id });
+    } finally { off(); }
+    expect(seen).toHaveLength(2);
+    expect(seen.map((event) => event.issueId).sort()).toEqual(live.map((issue) => issue.id).sort());
+    for (const event of seen) expect(event).toMatchObject({
+      orgId: tenant.org.id, projectId: tenant.project.id,
+      actorId: tenant.userIds.owner, previousAssigneeId: target.userId,
+    });
+    for (const issue of live) expect((await issueRepo.findIssueById(tenant.org.id, issue.id))?.assigneeId).toBeNull();
+    expect((await issueRepo.findIssueById(tenant.org.id, archived.id))?.assigneeId).toBe(target.userId);
+    expect((await issueRepo.findIssueById(tenant.org.id, retained.id))?.assigneeId).toBe(tenant.userIds.admin);
+    expect((await issueRepo.findIssueById(other.org.id, otherIssue.id))?.assigneeId).toBe(target.userId);
+  });
+
+  it("records activity, notifies the former assignee, and queues only subscribed enabled webhooks", async () => {
+    const tenant = await createTenant("unassign-consumers", "growth");
+    const issue = await issueService.createIssue(tenant.actors.owner,
+      issueInput(tenant.org.id, tenant.project.id, { assigneeId: tenant.userIds.member }));
+    const subscribed = await webhookRepo.insertEndpoint({ orgId: tenant.org.id, url: "https://example.com/yes", eventTypes: ["issue.unassigned"] }, "secret");
+    await webhookRepo.insertEndpoint({ orgId: tenant.org.id, url: "https://example.com/no", eventTypes: ["issue.created"] }, "secret");
+    const disabled = await webhookRepo.insertEndpoint({ orgId: tenant.org.id, url: "https://example.com/disabled", eventTypes: ["issue.unassigned"] }, "secret");
+    await webhookRepo.updateEndpoint({ orgId: tenant.org.id, webhookId: disabled.id as WebhookId, enabled: false });
+    const offActivity = registerActivityListeners();
+    const offWebhook = registerWebhookListeners();
+    const seen: TaskflowEventMap["issue.unassigned"][] = [];
+    const offCapture = subscribe("issue.unassigned", (event) => { seen.push(event); });
+    try {

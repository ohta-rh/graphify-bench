+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import { subscribe } from "@/lib/event-bus";
+import { importIssuesSchema } from "@/schemas/issue-import";
+import { activityEvents, getDb, issueLabels, labels, notifications, webhookDeliveries } from "@/server/db";
+import { registerEventHandlers, unregisterEventHandlers } from "@/server/services/event-registry";
+import { createIssue, importIssues } from "@/server/services/issue-service";
+import { search } from "@/server/services/search-service";
+import { getUsage, recomputeUsage } from "@/server/services/usage-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "./_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); registerEventHandlers(); });
+afterAll(() => { unregisterEventHandlers(); cleanup(); });
+
+describe("issue imports", () => {
+  it("imports in order, indexes and audits once, and replays the persisted result", async () => {
+    const tenant = await createTenant("imports");
+    const actor = tenant.actors.owner;
+    const input = importIssuesSchema.parse({

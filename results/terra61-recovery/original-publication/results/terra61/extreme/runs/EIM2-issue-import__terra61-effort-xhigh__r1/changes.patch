+import { and, count, eq, isNull, sql } from "drizzle-orm";
+import { wouldExceedLimit } from "@/config/plan-limits";
+import { newId } from "@/lib/id";
+import { getDb, issueImports, issueLabels, issues, labels, members, users } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toIssue } from "./_mappers";
+import type { ImportIssuesInput } from "@/schemas/issue-import";
+import type { PlanId } from "@/types/billing";
+import type { LabelId, OrgId, ProjectId, UserId } from "@/types/common";
+import type { Issue, IssueImportResult } from "@/types/issue";
+
+export function findImport(orgId: OrgId, importKey: string): IssueImportResult | null {
+  const row = getDb().select().from(issueImports).where(and(
+    eq(issueImports.orgId, orgId), eq(issueImports.importKey, importKey),
+  )).get();
+  if (!row) return null;
+  return {
+    importKey: row.importKey,
+    projectId: row.projectId as ProjectId,
+    issues: JSON.parse(row.issuesJson) as Issue[],
+    replayed: true,
+  };
+}
+
+/** All issue, label and idempotency writes commit together. */
+export function insertImport(
+  input: ImportIssuesInput,
+  authorId: UserId,
+  plan: PlanId,
+  projectKey: string,
+): IssueImportResult {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const existing = tx.select().from(issueImports).where(and(
+      eq(issueImports.orgId, input.orgId), eq(issueImports.importKey, input.importKey),
+    )).get();
+    if (existing) return {
+      importKey: existing.importKey,
+      projectId: existing.projectId as ProjectId,
+      issues: JSON.parse(existing.issuesJson) as Issue[],
+      replayed: true,
+    };
+
+    const totals = tx.select({
+      used: count(sql`CASE WHEN ${issues.archivedAt} IS NULL THEN 1 END`),
+      highest: sql<number | null>`max(${issues.number})`,
+    }).from(issues).where(and(eq(issues.orgId, input.orgId), eq(issues.projectId, input.projectId))).get();
+    if (wouldExceedLimit(plan, "issuesPerProject", totals?.used ?? 0, input.rows.length)) {
+      throw new Error(`Plan ${plan} allows no more issues in project ${projectKey}`);
+    }
+
+    const activeMembers = tx.select({ email: users.email, userId: users.id })
+      .from(members).innerJoin(users, eq(members.userId, users.id))
+      .where(and(eq(members.orgId, input.orgId), eq(members.status, "active"), isNull(members.archivedAt))).all();
+    const byEmail = new Map(activeMembers.map((member) => [member.email.toLowerCase(), member.userId as UserId]));
+    const existingLabels = tx.select().from(labels).where(eq(labels.orgId, input.orgId)).all();
+    const byName = new Map(existingLabels.map((label) => [label.name, label.id as LabelId]));
+    const stamp = toIsoTimestamp(new Date());
+    const created: Issue[] = [];
+    let number = (totals?.highest ?? 0) + 1;
+    for (const row of input.rows) {
+      const labelIds: LabelId[] = [];
+      for (const name of new Set(row.labels)) {
+        let labelId = byName.get(name);
+        if (!labelId) {
+          labelId = newId() as LabelId;
+          tx.insert(labels).values({ id: labelId, orgId: input.orgId, name, createdAt: stamp, updatedAt: stamp }).run();
+          byName.set(name, labelId);
+        }
+        labelIds.push(labelId);
+      }
+      const issue = tx.insert(issues).values({
+        id: newId(), orgId: input.orgId, projectId: input.projectId, number: number++,
+        title: row.title, description: row.description, status: row.status, priority: row.priority,
+        authorId, assigneeId: row.assigneeEmail ? byEmail.get(row.assigneeEmail.toLowerCase()) ?? null : null,
+        parentId: null, estimate: null, dueAt: row.dueAt, startedAt: null, completedAt: null,
+        createdAt: stamp, updatedAt: stamp,
+      }).returning().get();
+      if (labelIds.length) tx.insert(issueLabels).values(labelIds.map((labelId) => ({
+        orgId: input.orgId, issueId: issue.id, labelId,
+      }))).run();
+      created.push(toIssue(issue, labelIds));
+    }
+    tx.insert(issueImports).values({
+      orgId: input.orgId, importKey: input.importKey, projectId: input.projectId,
+      issuesJson: JSON.stringify(created),
+    }).run();
+    return { importKey: input.importKey, projectId: input.projectId, issues: created, replayed: false };
+  });
+}

+
+/** Consume a live token, change the password, and revoke that user's sessions atomically. */
+export async function resetPassword(tokenHash: string, passwordHash: string): Promise<UserId | null> {
+  const stamp = toIsoTimestamp(new Date());
+  return getDb().transaction((tx) => {
+    const token = tx.update(passwordResetTokens)
+      .set({ usedAt: stamp, updatedAt: stamp })
+      .where(and(
+        eq(passwordResetTokens.tokenHash, tokenHash),
+        isNull(passwordResetTokens.usedAt),
+        gt(passwordResetTokens.expiresAt, stamp),
+      ))
+      .returning({ userId: passwordResetTokens.userId })
+      .get();
+    if (!token) return null;
+    tx.update(users).set({ passwordHash, updatedAt: stamp })
+      .where(eq(users.id, token.userId)).run();
+    tx.delete(sessions).where(eq(sessions.userId, token.userId)).run();
+    return brandId<UserId>(token.userId);
+  });
 }

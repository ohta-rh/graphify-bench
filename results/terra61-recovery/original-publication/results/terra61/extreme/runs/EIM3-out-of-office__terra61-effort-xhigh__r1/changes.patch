+    vi.useFakeTimers();
+    vi.setSystemTime(new Date(start));
+    await members.setAbsence(tenant.actors.member, input(tenant.userIds.member));
+    await members.setAbsence(tenant.actors.admin, input(tenant.userIds.admin, tenant.userIds.viewer));
+    const events: UserId[] = [];

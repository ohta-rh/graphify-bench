+import { and, eq } from "drizzle-orm";
+import { getDb, memberAbsences } from "@/server/db";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { MemberAbsence } from "@/types/member";
+import { findMember } from "./member-repository";
+
+export async function findAbsence(orgId: OrgId, userId: UserId): Promise<MemberAbsence | null> {
+  const row = getDb().select().from(memberAbsences).where(and(
+    eq(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId),
+  )).get();
+  return row ? {
+    orgId: row.orgId as OrgId,
+    userId: row.userId as UserId,
+    delegateUserId: row.delegateUserId as UserId | null,
+    startsAt: row.startsAt as IsoTimestamp,
+    endsAt: row.endsAt as IsoTimestamp,
+    note: row.note,
+  } : null;
+}
+
+export async function upsertAbsence(absence: MemberAbsence): Promise<MemberAbsence> {
+  getDb().insert(memberAbsences).values(absence).onConflictDoUpdate({
+    target: [memberAbsences.orgId, memberAbsences.userId],
+    set: {
+      delegateUserId: absence.delegateUserId,
+      startsAt: absence.startsAt,
+      endsAt: absence.endsAt,
+      note: absence.note,
+    },
+  }).run();
+  return (await findAbsence(absence.orgId, absence.userId))!;
+}
+
+export async function deleteAbsence(orgId: OrgId, userId: UserId): Promise<void> {
+  getDb().delete(memberAbsences).where(and(
+    eq(memberAbsences.orgId, orgId), eq(memberAbsences.userId, userId),
+  )).run();
+}
+
+/** Resolve a single delegation at the action's instant, without chaining. */
+export async function activeDelegate(orgId: OrgId, userId: UserId, at: Date): Promise<UserId | null> {
+  const absence = await findAbsence(orgId, userId);
+  const time = at.getTime();
+  if (!absence?.delegateUserId || time < Date.parse(absence.startsAt) || time >= Date.parse(absence.endsAt)) return null;
+  const delegate = await findMember(orgId, absence.delegateUserId);
+  return delegate?.status === "active" ? absence.delegateUserId : null;
+}

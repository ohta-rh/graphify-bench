+    const absence = input(tenant.userIds.member);
+    await expect(members.setAbsence(tenant.actors.viewer, absence)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(members.setAbsence(tenant.actors.member, { ...absence, delegateUserId: absence.userId })).rejects.toThrow();
+    await expect(members.setAbsence(tenant.actors.member, { ...absence, endsAt: start })).rejects.toThrow();
+    await expect(members.setAbsence(tenant.actors.member, { ...absence, delegateUserId: "ZZZZZZZZZZZZZZZZZZZZZZZZZZ" as UserId })).rejects.toBeInstanceOf(NotFoundError);
+    await expect(members.getAbsence({ ...tenant.actors.member, orgId: "other" as Tenant["org"]["id"] }, tenant.org.id, absence.userId)).rejects.toBeInstanceOf(TenantScopeError);
+    expect(await members.setAbsence(tenant.actors.member, absence)).toEqual(absence);
+    expect(await members.getAbsence(tenant.actors.viewer, tenant.org.id, absence.userId)).toEqual(absence);

+      expect(events).toEqual([tenant.userIds.admin]);
+      expect((await alerts(tenant.userIds.admin, "issue_assigned")).some((n) => n.href.endsWith(issue.id))).toBe(true);
+      expect((await alerts(tenant.userIds.member, "issue_assigned")).some((n) => n.href.endsWith(issue.id))).toBe(false);

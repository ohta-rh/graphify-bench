+
+async function requireActiveMember(orgId: OrgId, userId: UserId): Promise<Member> {
+  const member = await memberRepo.findMember(orgId, userId);
+  return requireFound(member?.status === "active" ? member : null, "Member", userId);
+}
+
+export async function setAbsence(actor: Actor, input: SetAbsenceInput): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+  const member = await requireActiveMember(input.orgId, input.userId);
+  if (actor.userId !== input.userId) assertCan(actor, "member:update_role", memberResource(member));
+  if (!Number.isFinite(Date.parse(input.startsAt)) || !Number.isFinite(Date.parse(input.endsAt)) || Date.parse(input.endsAt) <= Date.parse(input.startsAt)) {
+    throw new Error("Absence end must be after its start");
+  }
+  if (input.delegateUserId !== null) {
+    if (input.delegateUserId === input.userId) throw new Error("A member cannot delegate to themselves");
+    await requireActiveMember(input.orgId, input.delegateUserId);
+  }
+  return absenceRepo.upsertAbsence(input);
+}
+
+export async function clearAbsence(actor: Actor, orgId: OrgId, userId: UserId): Promise<void> {
+  assertOrgScope(actor, orgId);
+  const member = await requireActiveMember(orgId, userId);
+  if (actor.userId !== userId) assertCan(actor, "member:update_role", memberResource(member));
+  await absenceRepo.deleteAbsence(orgId, userId);
+}
+
+export async function getAbsence(actor: Actor, orgId: OrgId, userId: UserId): Promise<MemberAbsence | null> {
+  assertOrgScope(actor, orgId);
+  await requireActiveMember(orgId, userId);
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  return absence && Date.now() < Date.parse(absence.endsAt) ? absence : null;
 }

+  if (!member || member.status !== "active" ||
+      (org.archivedAt !== null && Date.now() - new Date(org.archivedAt).getTime() >= DELETED_WORKSPACE_RETENTION_DAYS * 24 * 60 * 60 * 1000)) {
+    throw new NotFoundError("Organization", orgId);
+  }
+  assertCan({ userId, orgId, role: member.role }, "org:restore", orgResource(orgId));
+  if (org.archivedAt === null) return org;
+  const restored = await orgRepo.restoreOrg(orgId);
+  await emit("organization.restored", { ...envelope(orgId, userId), slug: org.slug });
+  return restored;
 }
 

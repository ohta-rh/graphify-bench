+/** Consume an invitation and admit its recipient in one transaction. */
+export async function acceptInvitationMembership(
+  invitation: Invitation,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<{ member: Member; joined: boolean }> {
+  return getDb().transaction((tx) => {
+    const currentInvite = tx.select().from(invitations).where(and(
+      eq(invitations.orgId, invitation.orgId), eq(invitations.id, invitation.id),
+    )).get();
+    if (!currentInvite) throw new Error("Invitation not found");
+    if (currentInvite.revokedAt !== null) throw new Error("That invitation has been revoked");
+    if (currentInvite.acceptedAt !== null) throw new Error("That invitation has already been accepted");
+    if (currentInvite.expiresAt <= at) throw new Error("That invitation has expired");
+
+    const existing = tx.select().from(members).where(and(
+      eq(members.orgId, invitation.orgId), eq(members.userId, userId),
+    )).get();
+    const joined = !existing || existing.archivedAt !== null || existing.status !== "active";
+    let row = existing;
+    if (existing && joined) {
+      row = tx.update(members).set({
+        archivedAt: null, status: "active", role: currentInvite.role,
+        invitedBy: currentInvite.invitedBy, joinedAt: at, updatedAt: at,
+      }).where(eq(members.id, existing.id)).returning().get();
+    } else if (!existing) {
+      row = tx.insert(members).values({
+        id: newId(), orgId: invitation.orgId, userId, role: currentInvite.role,
+        status: "active", invitedBy: currentInvite.invitedBy, joinedAt: at,
+        lastSeenAt: null, createdAt: at, updatedAt: at,
+      }).returning().get();
+    }
+    tx.update(invitations).set({ acceptedAt: at, updatedAt: at })
+      .where(and(eq(invitations.orgId, invitation.orgId), eq(invitations.id, invitation.id))).run();
+    if (!row) throw new Error("Membership could not be created");
+    return { member: toMember(row), joined };
+  });
 }

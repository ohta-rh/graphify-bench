+/** Reads the complete, tenant-scoped range using the feed's stable keyset order. */
+export async function listActivityForExport(
+  actor: Actor,
+  input: Pick<ExportActivityInput, "orgId" | "since" | "until">,
+): Promise<readonly ActivityEvent[]> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "activity:export", activityResource(input.orgId));
+  if (Date.parse(input.until) < Date.parse(input.since)) {
+    throw new Error("until must not be before since");
+  }
+  const items: ActivityEvent[] = [];
+  let cursor: string | null = null;
+  do {
+    const page: Page<ActivityEvent> = await activityRepo.listActivity({
+      orgId: input.orgId, since: input.since, until: input.until,
+      limit: 100, cursor,
+    });
+    items.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+  return items;
+}

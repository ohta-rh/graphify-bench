@@ -0,0 +1,81 @@
+import { and, eq, isNull } from "drizzle-orm";
+import { OwnershipHandoverError } from "@/lib/errors";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { newId } from "@/lib/id";
+import { getDb, members, organizations, ownershipHandovers } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toMember, toOrganization } from "./_mappers";
+import { NotFoundError } from "@/server/services/_support";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { OwnershipHandover } from "@/types/organization";
+
+function map(row: typeof ownershipHandovers.$inferSelect): OwnershipHandover {
+  return { ...row, orgId: row.orgId as OrgId, fromUserId: row.fromUserId as UserId,
+    toUserId: row.toUserId as UserId, createdAt: row.createdAt as IsoTimestamp,
+    expiresAt: row.expiresAt as IsoTimestamp, resolvedAt: row.resolvedAt as IsoTimestamp | null };
+}
+
+function pending(orgId: OrgId) {
+  return getDb().select().from(ownershipHandovers).where(and(
+    eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"),
+  )).get();
+}
+
+export function findPending(orgId: OrgId): OwnershipHandover | null {
+  const row = pending(orgId);
+  return row && row.expiresAt > toIsoTimestamp(new Date()) ? map(row) : null;
+}
+
+export function initiate(orgId: OrgId, fromUserId: UserId, toUserId: UserId): OwnershipHandover {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const now = toIsoTimestamp(new Date());
+    const org = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+    if (!org || org.ownerId !== fromUserId) throw new PermissionDeniedError("org:manage_billing", { action: "org:manage_billing", resourceKind: "organization", allowed: false, reason: "denied_by_role" });
+    const existing = tx.select().from(ownershipHandovers).where(and(eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"))).get();
+    if (existing && existing.expiresAt > now) throw new OwnershipHandoverError("pending_exists");
+    if (toUserId === fromUserId) throw new OwnershipHandoverError("self");
+    const target = tx.select().from(members).where(and(eq(members.orgId, orgId), eq(members.userId, toUserId), eq(members.status, "active"), isNull(members.archivedAt))).get();
+    if (!target) throw new NotFoundError("Member", toUserId);
+    if (existing) tx.update(ownershipHandovers).set({ status: "expired", resolvedAt: existing.expiresAt }).where(eq(ownershipHandovers.id, existing.id)).run();
+    const row = tx.insert(ownershipHandovers).values({ id: newId(), orgId, fromUserId, toUserId,
+      status: "pending", createdAt: now, expiresAt: toIsoTimestamp(new Date(new Date(now).getTime() + 7 * 24 * 60 * 60 * 1000)), resolvedAt: null }).returning().get();
+    return map(row);
+  });
+}
+
+export function resolve(orgId: OrgId, actorId: UserId, action: "accepted" | "declined" | "canceled") {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const now = toIsoTimestamp(new Date());
+    if (action === "canceled") {
+      const org = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+      if (!org || org.ownerId !== actorId) throw new PermissionDeniedError("org:manage_billing", { action: "org:manage_billing", resourceKind: "organization", allowed: false, reason: "denied_by_role" });
+    }
+    const offer = tx.select().from(ownershipHandovers).where(and(eq(ownershipHandovers.orgId, orgId), eq(ownershipHandovers.status, "pending"))).get();
+    if (!offer || (action !== "canceled" && offer.toUserId !== actorId)) throw new OwnershipHandoverError("nothing_pending");
+    if (offer.expiresAt <= now) throw new OwnershipHandoverError(action === "canceled" ? "nothing_pending" : "expired");
+    let organization: ReturnType<typeof toOrganization> | null = null;
+    const changes: { memberId: ReturnType<typeof toMember>["id"]; from: ReturnType<typeof toMember>["role"]; to: ReturnType<typeof toMember>["role"] }[] = [];
+    if (action === "accepted") {
+      const active = (userId: string) => tx.select().from(members).where(and(eq(members.orgId, orgId), eq(members.userId, userId), eq(members.status, "active"), isNull(members.archivedAt))).get();
+      const recipient = active(offer.toUserId);
+      const sender = active(offer.fromUserId);
+      if (!recipient || !sender) throw new OwnershipHandoverError("nothing_pending");
+      const org = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+      if (!org || org.ownerId !== offer.fromUserId) throw new OwnershipHandoverError("nothing_pending");
+      if (recipient.role !== "owner") {
+        tx.update(members).set({ role: "owner", updatedAt: now }).where(eq(members.id, recipient.id)).run();
+        changes.push({ memberId: toMember(recipient).id, from: recipient.role, to: "owner" });
+      }
+      organization = toOrganization(tx.update(organizations).set({ ownerId: offer.toUserId, updatedAt: now }).where(eq(organizations.id, orgId)).returning().get());
+      if (sender.role === "owner") {
+        tx.update(members).set({ role: "admin", updatedAt: now }).where(eq(members.id, sender.id)).run();
+        changes.push({ memberId: toMember(sender).id, from: "owner", to: "admin" });
+      }
+    }
+    const updated = tx.update(ownershipHandovers).set({ status: action, resolvedAt: now }).where(eq(ownershipHandovers.id, offer.id)).returning().get();
+    return { offer: map(updated), organization, changes };
+  });
+}
+

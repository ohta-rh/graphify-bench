@@ -0,0 +1,53 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import * as members from "@/server/repositories/member-repository";
+import * as notifications from "@/server/repositories/notification-repository";
+import * as orgs from "@/server/services/organization-service";
+import * as billing from "@/server/services/billing-service";
+import { registerActivityListeners } from "@/server/services/activity-service";
+import { getDb, activityEvents } from "@/server/db";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+describe("ownership handover", () => {
+  it("transfers ownership, emits and audits changes, and moves billing authority", async () => {
+    const t = await createTenant("handover-accept");
+    const changes: unknown[] = [];
+    const offChange = subscribe("member.role_changed", event => { changes.push(event); });
+    const offAudit = registerActivityListeners();
+    try {
+      const offer = await orgs.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.viewer);
+      expect(Date.parse(offer.expiresAt) - Date.parse(offer.createdAt)).toBe(7 * 86400000);
+      expect((await notifications.listNotifications({ orgId: t.org.id, recipientId: t.userIds.viewer, unreadOnly: false, limit: 10, cursor: null })).items).toMatchObject([{ kind: "ownership_handover", actorId: t.userIds.owner }]);
+      const result = await orgs.acceptOwnershipHandover(t.actors.viewer, t.org.id);
+      expect(result.ownerId).toBe(t.userIds.viewer);
+      expect((await members.findMember(t.org.id, t.userIds.viewer))?.role).toBe("owner");
+      expect((await members.findMember(t.org.id, t.userIds.owner))?.role).toBe("admin");
+      expect(changes).toMatchObject([{ actorId: t.userIds.viewer, from: "viewer", to: "owner" }, { actorId: t.userIds.viewer, from: "owner", to: "admin" }]);
+      const audit = getDb().select().from(activityEvents).all().find(row => row.action === "organization.ownership_transferred");
+      expect(audit).toMatchObject({ actorId: t.userIds.viewer, subjectKind: "organization", subjectId: t.org.id });
+      expect(JSON.parse(audit!.metadata)).toEqual({ fromUserId: t.userIds.owner, toUserId: t.userIds.viewer });
+      await billing.changePlan(t.actors.viewer, { orgId: t.org.id, plan: "enterprise", interval: "monthly" });
+      await expect(billing.changePlan(t.actors.owner, { orgId: t.org.id, plan: "enterprise", interval: "monthly" })).rejects.toBeInstanceOf(PermissionDeniedError);
+    } finally { offChange(); offAudit(); }
+  });
+
+  it("expires exactly at seven days and can be replaced", async () => {
+    const t = await createTenant("handover-expire");
+    vi.useFakeTimers();
+    try {
+      const offer = await orgs.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.member);
+      vi.setSystemTime(new Date(Date.parse(offer.expiresAt) - 1));
+      expect(await orgs.getPendingOwnershipHandover(t.actors.member, t.org.id)).not.toBeNull();
+      vi.setSystemTime(new Date(offer.expiresAt));
+      expect(await orgs.getPendingOwnershipHandover(t.actors.member, t.org.id)).toBeNull();
+      await expect(orgs.acceptOwnershipHandover(t.actors.member, t.org.id)).rejects.toMatchObject({ reason: "expired" });
+      await expect(orgs.declineOwnershipHandover(t.actors.viewer, t.org.id)).rejects.toMatchObject({ reason: "nothing_pending" });
+      expect((await orgs.initiateOwnershipHandover(t.actors.owner, t.org.id, t.userIds.viewer)).toUserId).toBe(t.userIds.viewer);
+    } finally { vi.useRealTimers(); }
+  });
+});

+
+export async function initiateOwnershipHandover(actor: Actor, orgId: OrgId, toUserId: UserId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  await assertRecordedOwner(actor, orgId);
+  const offer = handoverRepo.initiate(orgId, actor.userId, toUserId);
+  await notificationRepo.insertNotification(orgId, {
+    orgId, recipientId: toUserId, kind: "ownership_handover", channels: ["in_app"],
+    title: "Workspace ownership offer", body: "You have been invited to accept workspace ownership.",
+    href: "/settings/members", actorId: actor.userId,
+  });
+  return offer;
+}
+
+export async function acceptOwnershipHandover(actor: Actor, orgId: OrgId): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+  const result = handoverRepo.resolve(orgId, actor.userId, "accepted");
+  for (const change of result.changes) {
+    await emit("member.role_changed", { ...actorEnvelope(actor), ...change });
+  }
+  await emit("organization.ownership_transferred", {
+    ...actorEnvelope(actor), fromUserId: result.offer.fromUserId, toUserId: result.offer.toUserId,
+  });
+  return result.organization!;
+}
+
+export async function declineOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  return handoverRepo.resolve(orgId, actor.userId, "declined").offer;
+}
+
+export async function cancelOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  await assertRecordedOwner(actor, orgId);
+  return handoverRepo.resolve(orgId, actor.userId, "canceled").offer;
+}
+
+export async function getPendingOwnershipHandover(actor: Actor, orgId: OrgId): Promise<OwnershipHandover | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:read", orgResource(orgId));
+  return handoverRepo.findPending(orgId);
 }

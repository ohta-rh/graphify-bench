@@ -0,0 +1,75 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { eq } from "drizzle-orm";
+
+vi.mock("@/lib/id", () => import("../server/_support/doubles/id"));
+vi.mock("@/lib/logger", async () => (await import("../server/_support/doubles/misc")).loggerModule);
+
+import { WorkspaceLockedError, lockReasonFor } from "@/lib/billing-lock";
+import { isDomainError, toAppError } from "@/lib/errors";
+import { subscribe } from "@/lib/event-bus";
+import { hashToken } from "@/lib/hash";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { getDb, subscriptions } from "@/server/db";
+import * as invitationRepo from "@/server/repositories/invitation-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as subscriptionRepo from "@/server/repositories/subscription-repository";
+import * as userRepo from "@/server/repositories/user-repository";
+import * as billing from "@/server/services/billing-service";
+import * as invitations from "@/server/services/invitation-service";
+import * as issues from "@/server/services/issue-service";
+import * as organizations from "@/server/services/organization-service";
+import { createTenant, issueInput, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+
+describe("workspace billing lock", () => {
+  it("applies trial and cancellation boundaries exactly", async () => {
+    const tenant = await createTenant("lock-boundaries");
+    const subscription = (await subscriptionRepo.findSubscription(tenant.org.id))!;
+    const end = new Date(subscription.currentPeriodEnd);
+    const before = new Date(end.getTime() - 1);
+    expect(lockReasonFor(null, end)).toBeNull();
+    expect(lockReasonFor({ ...subscription, status: "active" }, end)).toBeNull();
+    expect(lockReasonFor({ ...subscription, status: "past_due" }, before)).toBe("past_due");
+    expect(lockReasonFor({ ...subscription, status: "trialing" }, before)).toBeNull();
+    expect(lockReasonFor({ ...subscription, status: "trialing" }, end)).toBe("trial_ended");
+    expect(lockReasonFor({ ...subscription, status: "canceled", cancelAt: subscription.currentPeriodEnd }, before)).toBeNull();
+    expect(lockReasonFor({ ...subscription, status: "canceled", cancelAt: subscription.currentPeriodEnd }, end)).toBe("canceled");
+    expect(lockReasonFor({ ...subscription, status: "canceled", cancelAt: null }, before)).toBe("canceled");
+  });
+
+  it("preserves permissions and reads, blocks writes and events, and unlocks on plan change", async () => {
+    const tenant = await createTenant("lock-writes");
+    getDb().update(subscriptions).set({ status: "past_due" }).where(eq(subscriptions.orgId, tenant.org.id)).run();
+    const input = issueInput(tenant.org.id, tenant.project.id);
+    let events = 0;
+    const off = subscribe("issue.created", () => { events += 1; });
+    await expect(issues.createIssue(tenant.actors.viewer, input)).rejects.toBeInstanceOf(PermissionDeniedError);
+    await expect(issues.createIssue(tenant.actors.member, input)).rejects.toMatchObject({ code: "plan_limit_exceeded", orgId: tenant.org.id, reason: "past_due" });

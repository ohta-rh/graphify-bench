 import type { IssueId, OrgId, Page, ProjectId } from "@/types/common";
 import type { Issue, IssueBoardColumn, IssueWithRelations } from "@/types/issue";
 import type { Actor } from "@/types/member";
+import type { ImportIssuesInput } from "@/schemas/issue-import";
+import type { IssueImportResult } from "@/types/issue";
+
+// Serialize imports in a workspace so simultaneous uploads of the same key
+// neither spend the allowance twice nor race the idempotency record.
+const importQueues = new Map<OrgId, Promise<void>>();
+
+export async function importIssues(actor: Actor, input: ImportIssuesInput): Promise<IssueImportResult> {
+  assertOrgScope(actor, input.orgId);
+  const project = requireFound(await projectRepo.findProjectById(input.orgId, input.projectId), "Project", input.projectId);
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  const previous = importQueues.get(input.orgId) ?? Promise.resolve();
+  let release!: () => void;
+  const current = new Promise<void>((resolve) => { release = resolve; });
+  importQueues.set(input.orgId, current);
+  await previous;
+  try {
+    const replay = importRepo.findImport(input.orgId, input.importKey);
+    if (replay) {
+      if (replay.projectId !== project.id) {
+        const original = requireFound(await projectRepo.findProjectById(input.orgId, replay.projectId), "Project", replay.projectId);
+        assertCan(actor, "issue:create", projectResource(original));
+      }
+      return replay;
+    }
+    const org = requireFound(await orgRepo.findOrgById(input.orgId), "Organization", input.orgId);
+    const used = await issueRepo.countIssues(input.orgId, input.projectId);
+    if (wouldExceedLimit(org.plan, "issuesPerProject", used, input.rows.length)) {
+      throw new Error(`Plan ${org.plan} allows no more issues in project ${project.key}`);
+    }
+    setOrgPlan(input.orgId, org.plan);
+    const verdict = await consumeRateLimit(input.orgId, "issue:create", input.rows.length);
+    if (!verdict.allowed) throw new Error(`Issue creation rate limit reached; try again after ${verdict.resetAt}`);
+
+    const result = importRepo.insertImport(input, actor.userId, org.plan, project.key);
+    await emit("issues.imported", {
+      ...actorEnvelope(actor), projectId: result.projectId, importKey: result.importKey,
+      issueIds: result.issues.map((issue) => issue.id),
+    });
+    return result;
+  } finally {
+    release();
+    if (importQueues.get(input.orgId) === current) importQueues.delete(input.orgId);
+  }
+}
 

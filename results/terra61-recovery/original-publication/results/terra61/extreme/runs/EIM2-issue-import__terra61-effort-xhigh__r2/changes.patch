+import { and, count, eq, isNull, sql } from "drizzle-orm";
+import { wouldExceedLimit } from "@/config/plan-limits";
+import { newId } from "@/lib/id";
+import { getDb, issueImports, issueLabels, issues, labels, members, users } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { toIssue } from "./_mappers";
+import type { ImportIssuesInput } from "@/schemas/issue-import";
+import type { PlanId } from "@/types/billing";
+import type { LabelId, OrgId, ProjectId, UserId } from "@/types/common";
+import type { Issue, IssueImportResult } from "@/types/issue";
+
+export function findImport(orgId: OrgId, importKey: string): IssueImportResult | null {
+  const row = getDb().select().from(issueImports).where(and(
+    eq(issueImports.orgId, orgId), eq(issueImports.importKey, importKey),
+  )).get();
+  return row ? {
+    importKey,
+    projectId: row.projectId as ProjectId,
+    issues: JSON.parse(row.issuesJson) as Issue[],
+    replayed: true,
+  } : null;
+}
+
+/** All labels, issues and the idempotency record commit or roll back together. */
+export function insertImport(input: ImportIssuesInput, authorId: UserId, plan: PlanId, projectKey: string): IssueImportResult {
+  return getDb().transaction((tx) => {
+    const used = tx.select({ value: count() }).from(issues).where(and(
+      eq(issues.orgId, input.orgId), eq(issues.projectId, input.projectId), isNull(issues.archivedAt),
+    )).get()?.value ?? 0;
+    if (wouldExceedLimit(plan, "issuesPerProject", used, input.rows.length)) {
+      throw new Error(`Plan ${plan} allows no more issues in project ${projectKey}`);
+    }
+
+    const max = tx.select({ value: sql<number | null>`max(${issues.number})` }).from(issues).where(and(
+      eq(issues.orgId, input.orgId), eq(issues.projectId, input.projectId),
+    )).get()?.value ?? 0;
+    const activeMembers = tx.select({ email: users.email, userId: users.id }).from(members)
+      .innerJoin(users, eq(users.id, members.userId)).where(and(
+        eq(members.orgId, input.orgId), eq(members.status, "active"), isNull(members.archivedAt),
+      )).all();
+    const assignees = new Map(activeMembers.map((member) => [member.email.toLowerCase(), member.userId]));
+    const existingLabels = tx.select().from(labels).where(eq(labels.orgId, input.orgId)).all();
+    const labelIds = new Map(existingLabels.map((label) => [label.name, label.id as LabelId]));
+    const stamp = toIsoTimestamp(new Date());
+    const imported = input.rows.map((item, index) => {
+      const rowLabelIds = [...new Set(item.labels)].map((name) => {
+        let id = labelIds.get(name);
+        if (!id) {
+          id = newId() as LabelId;
+          tx.insert(labels).values({ id, orgId: input.orgId, name, createdAt: stamp, updatedAt: stamp }).run();
+          labelIds.set(name, id);
+        }
+        return id;
+      });
+      const row = tx.insert(issues).values({
+        id: newId(), orgId: input.orgId, projectId: input.projectId, number: max + index + 1,
+        title: item.title, description: item.description, status: item.status, priority: item.priority,
+        authorId, assigneeId: item.assigneeEmail === null ? null : assignees.get(item.assigneeEmail.toLowerCase()) ?? null,
+        parentId: null, estimate: null, dueAt: item.dueAt, startedAt: null, completedAt: null,
+        createdAt: stamp, updatedAt: stamp,
+      }).returning().get();
+      if (rowLabelIds.length) {
+        tx.insert(issueLabels).values(rowLabelIds.map((labelId) => ({ orgId: input.orgId, issueId: row.id, labelId }))).run();
+      }
+      return toIssue(row, rowLabelIds);
+    });
+    tx.insert(issueImports).values({ orgId: input.orgId, importKey: input.importKey, projectId: input.projectId, issuesJson: JSON.stringify(imported) }).run();
+    return { importKey: input.importKey, projectId: input.projectId, issues: imported, replayed: false };
+  });
+}

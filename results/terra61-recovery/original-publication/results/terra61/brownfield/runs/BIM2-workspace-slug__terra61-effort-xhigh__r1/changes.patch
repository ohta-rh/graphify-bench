+
+function holdCutoff(now: Date): string {
+  return new Date(now.getTime() - ORG_SLUG_HOLD_DAYS * 24 * 60 * 60 * 1000).toISOString();
+}
+
+/** Atomically checks availability, switches the current slug, and retires the old one. */
+export async function renameOrgSlug(
+  orgId: OrgId,
+  slug: string,
+): Promise<{ organization: Organization; from: string; changed: boolean }> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const current = tx.select().from(organizations).where(eq(organizations.id, orgId)).get();
+    if (!current) throw new Error(`Organization ${orgId} not found`);
+    if (current.slug === slug) {
+      return { organization: toOrganization(current), from: current.slug, changed: false };
+    }
+
+    const now = new Date();
+    const occupied = tx.select({ id: organizations.id }).from(organizations)
+      .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId))).get();
+    const held = tx.select({ orgId: retiredOrganizationSlugs.orgId })
+      .from(retiredOrganizationSlugs)
+      .where(and(eq(retiredOrganizationSlugs.slug, slug),
+        ne(retiredOrganizationSlugs.orgId, orgId),
+        gt(retiredOrganizationSlugs.retiredAt, holdCutoff(now)))).get();
+    if (occupied || held) throw new InvalidSlugError(slug, "is already taken");
+
+    tx.delete(retiredOrganizationSlugs).where(eq(retiredOrganizationSlugs.slug, slug)).run();
+    const row = tx.update(organizations).set({ slug })
+      .where(eq(organizations.id, orgId)).returning().get();
+    tx.insert(retiredOrganizationSlugs)
+      .values({ slug: current.slug, orgId, retiredAt: toIsoTimestamp(now) })
+      .onConflictDoUpdate({
+        target: retiredOrganizationSlugs.slug,
+        set: { orgId, retiredAt: toIsoTimestamp(now) },
+      }).run();
+    return { organization: toOrganization(row), from: current.slug, changed: true };
+  });
 }

+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { ORG_SLUG_HOLD_DAYS } from "@/config/constants";
+import { subscribe } from "@/lib/event-bus";
+import { PermissionDeniedError } from "@/lib/permissions";
+import { InvalidSlugError } from "@/lib/slug";
+import { activityFilterSchema } from "@/schemas/activity";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { listActivity, registerActivityListeners } from "@/server/services/activity-service";
+import { listOrganizationsForUser, renameOrganizationSlug, resolveOrgBySlug } from "@/server/services/organization-service";
+import { resolveActorForOrg } from "@/server/services/session-service";
+import { createTenant, useTemporaryDatabase } from "../server/_support/fixtures";
+
+let cleanup: () => void;
+beforeAll(async () => { cleanup = await useTemporaryDatabase(); });
+afterAll(() => cleanup());
+afterEach(() => vi.useRealTimers());
+
+describe("workspace slug changes", () => {
+  it("holds each retired URL until its deadline and resolves it for sessions", async () => {
+    const tenant = await createTenant("old-workspace");
+    const other = await createTenant("another-workspace");
+    vi.useFakeTimers();
+    const start = new Date("2026-03-01T12:00:00.000Z");
+    vi.setSystemTime(start);
+    const detachAudit = registerActivityListeners();
+    const listener = vi.fn();
+    const detachEvent = subscribe("organization.slug_changed", listener);
+    try {
+      const input = { orgId: tenant.org.id, slug: "new-workspace" };
+      await expect(renameOrganizationSlug(tenant.actors.member, input)).rejects.toBeInstanceOf(PermissionDeniedError);
+      const updated = await renameOrganizationSlug(tenant.actors.admin, input);
+      expect(updated).toEqual({ ...tenant.org, slug: input.slug });
+      expect((await listOrganizationsForUser(tenant.userIds.owner))[0]?.slug).toBe(input.slug);
+      expect(await resolveOrgBySlug("old-workspace")).toEqual(updated);
+      const principal = { userId: tenant.userIds.owner, email: "owner@example.com", activeOrgId: tenant.org.id, expiresAt: tenant.org.createdAt };
+      expect(await resolveActorForOrg(principal, "old-workspace")).toMatchObject({ orgId: tenant.org.id });
+      await expect(renameOrganizationSlug(other.actors.owner, { orgId: other.org.id, slug: "old-workspace" })).rejects.toBeInstanceOf(InvalidSlugError);
+      expect((await orgRepo.insertOrg({ name: "Third", slug: "old-workspace", plan: "free" }, other.userIds.owner)).slug).toBe("old-workspace-2");
+      await renameOrganizationSlug(tenant.actors.admin, input);
+      expect(listener).toHaveBeenCalledTimes(1);
+      expect(listener).toHaveBeenCalledWith(expect.objectContaining({ actorId: tenant.userIds.admin, from: "old-workspace", to: "new-workspace" }));
+      const filter = activityFilterSchema.parse({ orgId: tenant.org.id, action: ["organization.slug_changed"] });
+      const activity = await listActivity(tenant.actors.admin, filter);
+      expect(activity.items).toHaveLength(1);
+      expect(activity.items[0]).toMatchObject({ actorId: tenant.userIds.admin, subjectKind: "organization", subjectId: tenant.org.id, metadata: { from: "old-workspace", to: "new-workspace" } });
+
+      vi.setSystemTime(start.getTime() + 24 * 60 * 60 * 1000);
+      await renameOrganizationSlug(tenant.actors.admin, { orgId: tenant.org.id, slug: "third-workspace" });
+      vi.setSystemTime(start.getTime() + ORG_SLUG_HOLD_DAYS * 24 * 60 * 60 * 1000);
+      expect(await resolveOrgBySlug("old-workspace")).toBeNull();
+      expect((await resolveOrgBySlug("new-workspace"))?.id).toBe(tenant.org.id);
+      expect((await renameOrganizationSlug(other.actors.owner, { orgId: other.org.id, slug: "old-workspace" })).slug).toBe("old-workspace");
+      await renameOrganizationSlug(tenant.actors.admin, { orgId: tenant.org.id, slug: "new-workspace" });
+      expect((await resolveOrgBySlug("third-workspace"))?.slug).toBe("new-workspace");
+    } finally {
+      detachEvent();
+      detachAudit();
+    }
+  });
+});

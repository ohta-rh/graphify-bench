+import { consumeRateLimit } from "@/lib/rate-limit";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import type { OrgId } from "@/types/common";
+
+/** Resolve the current tenant plan on each request, including existing mismatches. */
+export async function consumePlanRateLimit(orgId: OrgId, bucketKey: string, cost = 1) {
+  const org = await orgRepo.findOrgById(orgId);
+  return consumeRateLimit(orgId, bucketKey, cost, org?.plan ?? "free");
+}

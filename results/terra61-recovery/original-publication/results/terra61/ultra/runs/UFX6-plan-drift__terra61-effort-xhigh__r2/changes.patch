+    .select({ value: count() })
+    .from(issues)
+    .where(and(eq(issues.orgId, orgId), isNull(issues.archivedAt)))
+    .groupBy(issues.projectId)
+    .all();
+  return rows.reduce((max, row) => Math.max(max, row.value), 0);

+import type { IsoTimestamp, OrgId, UserId } from "./common";
+
+export type ApiTokenScope = "read" | "write";
+export interface ApiToken {
+  id: string;
+  orgId: OrgId;
+  userId: UserId;
+  name: string;
+  scope: ApiTokenScope;
+  prefix: string;
+  expiresAt: IsoTimestamp;

@@ -0,0 +1,67 @@
+import { and, count, desc, eq, gt, isNull, sql } from "drizzle-orm";
+import { apiTokens, getDb, members, organizations } from "@/server/db";
+import { brandId, brandStamp } from "./_mappers";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+
+type TokenRow = typeof apiTokens.$inferSelect;
+function toToken(row: TokenRow): ApiToken {
+  return {
+    id: row.id, orgId: brandId<OrgId>(row.orgId), userId: brandId<UserId>(row.userId),
+    name: row.name, scope: row.scope, prefix: row.prefix,
+    expiresAt: brandStamp(row.expiresAt),
+    lastUsedAt: row.lastUsedAt === null ? null : brandStamp(row.lastUsedAt),
+    revokedAt: row.revokedAt === null ? null : brandStamp(row.revokedAt),
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+export async function insertToken(token: ApiToken, tokenHash: string): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const existing = tx.select({ value: count() }).from(apiTokens).where(and(
+      eq(apiTokens.orgId, token.orgId), eq(apiTokens.userId, token.userId),
+      isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, token.createdAt),
+    )).get();
+    if ((existing?.value ?? 0) >= 5) throw new Error("API token limit reached");
+    return toToken(tx.insert(apiTokens).values({ ...token, tokenHash }).returning().get());
+  });
+}
+
+export async function listTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), sql`rowid desc`).all().map(toToken);
+}
+
+export async function findToken(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id))).get();
+  return row ? toToken(row) : null;
+}
+
+export async function revokeToken(orgId: OrgId, id: string, now: IsoTimestamp): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: now }).where(and(
+    eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt),
+  )).returning().get();
+  return row ? toToken(row) : null;
+}
+
+export async function revokeUserTokens(orgId: OrgId, userId: UserId, now: IsoTimestamp): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: now }).where(and(
+    eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt),
+  )).returning().all().map(toToken);
+}
+
+export async function authenticate(tokenHash: string, now: IsoTimestamp): Promise<Actor | null> {
+  return getDb().transaction((tx) => {
+    const row = tx.select({ token: apiTokens, role: members.role }).from(apiTokens)
+      .innerJoin(members, and(eq(members.orgId, apiTokens.orgId), eq(members.userId, apiTokens.userId)))
+      .innerJoin(organizations, eq(organizations.id, apiTokens.orgId))
+      .where(and(eq(apiTokens.tokenHash, tokenHash), isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, now), eq(members.status, "active"), isNull(members.archivedAt),
+        isNull(organizations.archivedAt))).get();
+    if (!row) return null;
+    tx.update(apiTokens).set({ lastUsedAt: now }).where(eq(apiTokens.id, row.token.id)).run();
+    return { userId: brandId<UserId>(row.token.userId), orgId: brandId<OrgId>(row.token.orgId),
+      role: row.token.scope === "read" ? "viewer" : row.role };
+  });
+}

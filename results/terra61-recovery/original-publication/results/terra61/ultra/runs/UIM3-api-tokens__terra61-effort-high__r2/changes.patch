diff -ruN --exclude=node_modules --exclude=.next --exclude=.git /private/tmp/bench-scratch/41cfbab0-c31c-4237-ac7c-f1cd173c39d3/src/server/services/api-token-service.ts /private/tmp/bench-scratch/d505a248-5c81-4bcc-8de1-9c31ef3cc27f/src/server/services/api-token-service.ts

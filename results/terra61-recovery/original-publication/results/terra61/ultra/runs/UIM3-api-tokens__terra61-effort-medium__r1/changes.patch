@@ -0,0 +1,45 @@
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { apiTokens, getDb } from "@/server/db";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+type Row = typeof apiTokens.$inferSelect;
+function publicToken(row: Row): ApiToken {
+  return { id: row.id, orgId: row.orgId as OrgId, userId: row.userId as UserId,
+    name: row.name, scope: row.scope, prefix: row.prefix,
+    expiresAt: row.expiresAt as IsoTimestamp, lastUsedAt: row.lastUsedAt as IsoTimestamp | null,
+    revokedAt: row.revokedAt as IsoTimestamp | null, createdAt: row.createdAt as IsoTimestamp };
+}
+
+export async function insertToken(token: ApiToken, tokenHash: string): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const total = tx.select({ value: count() }).from(apiTokens).where(and(
+      eq(apiTokens.orgId, token.orgId), eq(apiTokens.userId, token.userId),
+      isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, token.createdAt),
+    )).get()?.value ?? 0;
+    if (total >= 5) throw new Error("API token limit reached");
+    return publicToken(tx.insert(apiTokens).values({ ...token, tokenHash }).returning().get());
+  });
+}
+export async function listTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id)).all().map(publicToken);
+}
+export async function findToken(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id))).get();
+  return row ? publicToken(row) : null;
+}
+export async function findByHash(hash: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(eq(apiTokens.tokenHash, hash)).get();
+  return row ? publicToken(row) : null;
+}
+export async function revokeToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt))).returning().get();
+  return row ? publicToken(row) : null;
+}
+export async function revokeUserTokens(orgId: OrgId, userId: UserId, at: IsoTimestamp): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt))).returning().all().map(publicToken);
+}
+export async function touchToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<void> {
+  getDb().update(apiTokens).set({ lastUsedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, at))).run();
+}

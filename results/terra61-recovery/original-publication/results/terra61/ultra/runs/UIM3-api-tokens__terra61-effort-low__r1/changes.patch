@@ -0,0 +1,51 @@
+import { emit } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { newId } from "@/lib/id";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import * as tokens from "@/server/repositories/api-token-repository";
+import { findMember } from "@/server/repositories/member-repository";
+import { findOrgById } from "@/server/repositories/organization-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { actorEnvelope, requireFound } from "./_support";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Actor } from "@/types/member";
+export async function createApiToken(actor: Actor, input: CreateApiTokenInput): Promise<{ token: string; apiToken: ApiToken }> {
+  const parsed = createApiTokenSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  if (parsed.scope === "write") assertCan(actor, "api_token:create_write", { kind: "organization", orgId: parsed.orgId });
+  const now = new Date();
+  const token = "tfk_" + randomToken();
+  const apiToken = await tokens.insertToken({ id: newId(), orgId: parsed.orgId, userId: actor.userId, name: parsed.name, scope: parsed.scope, prefix: token.slice(0, 12), expiresAt: toIsoTimestamp(new Date(now.getTime() + parsed.expiresInDays * 86400000)), lastUsedAt: null, revokedAt: null, createdAt: toIsoTimestamp(now) }, hashToken(token));
+  await emit("api_token.created", { ...actorEnvelope(actor), tokenId: apiToken.id });
+  return { token, apiToken };
+}
+export async function listApiTokens(actor: Actor, orgId: OrgId, userId: UserId = actor.userId): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) assertCan(actor, "api_token:manage_others", { kind: "organization", orgId });
+  return tokens.listTokens(orgId, userId);
+}
+export async function revokeApiToken(actor: Actor, orgId: OrgId, tokenId: string): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+  const token = requireFound(await tokens.findToken(orgId, tokenId), "ApiToken", tokenId);
+  if (token.userId !== actor.userId) assertCan(actor, "api_token:manage_others", { kind: "organization", orgId });
+  if (token.revokedAt !== null) return token;
+  const revoked = await tokens.revokeToken(orgId, tokenId, toIsoTimestamp(new Date()));
+  if (!revoked) return requireFound(await tokens.findToken(orgId, tokenId), "ApiToken", tokenId);
+  await emit("api_token.revoked", { ...actorEnvelope(actor), tokenId });
+  return revoked;
+}
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  const found = await tokens.findByHash(hashToken(token));
+  const now = toIsoTimestamp(new Date());
+  if (!found || found.revokedAt !== null || found.expiresAt <= now) return null;
+  const org = await findOrgById(found.orgId);
+  if (!org || org.archivedAt !== null) return null;
+  const member = await findMember(found.orgId, found.userId);
+  if (!member || member.status !== "active") return null;
+  if (!await tokens.touchToken(found.orgId, found.id, now)) return null;
+  return { userId: found.userId, orgId: found.orgId, role: found.scope === "read" ? "viewer" : member.role };
+}

@@ -0,0 +1,34 @@
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { getDb, apiTokens } from "@/server/db";
+import { brandId, brandStamp } from "./_mappers";
+import type { ApiToken } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+type Row = typeof apiTokens.$inferSelect;
+function publicToken(row: Row): ApiToken {
+  return { id: row.id, orgId: brandId<OrgId>(row.orgId), userId: brandId<UserId>(row.userId), name: row.name, scope: row.scope, prefix: row.prefix, expiresAt: brandStamp(row.expiresAt), lastUsedAt: row.lastUsedAt === null ? null : brandStamp(row.lastUsedAt), revokedAt: row.revokedAt === null ? null : brandStamp(row.revokedAt), createdAt: brandStamp(row.createdAt) };
+}
+export async function insertToken(token: ApiToken, tokenHash: string): Promise<ApiToken> {
+  return getDb().transaction((tx) => {
+    const n = tx.select({ value: count() }).from(apiTokens).where(and(eq(apiTokens.orgId, token.orgId), eq(apiTokens.userId, token.userId), isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, token.createdAt))).get()?.value ?? 0;
+    if (n >= 5) throw new Error("API token limit reached");
+    return publicToken(tx.insert(apiTokens).values({ ...token, tokenHash }).returning().get());
+  });
+}
+export async function listTokens(orgId: OrgId, userId: UserId): Promise<readonly ApiToken[]> {
+  return getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId))).orderBy(desc(apiTokens.createdAt), desc(apiTokens.id)).all().map(publicToken);
+}
+export async function findToken(orgId: OrgId, id: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id))).get(); return row ? publicToken(row) : null;
+}
+export async function findByHash(hash: string): Promise<ApiToken | null> {
+  const row = getDb().select().from(apiTokens).where(eq(apiTokens.tokenHash, hash)).get(); return row ? publicToken(row) : null;
+}
+export async function revokeToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<ApiToken | null> {
+  const row = getDb().update(apiTokens).set({ revokedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt))).returning().get(); return row ? publicToken(row) : null;
+}
+export async function revokeUserTokens(orgId: OrgId, userId: UserId, at: IsoTimestamp): Promise<readonly ApiToken[]> {
+  return getDb().update(apiTokens).set({ revokedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.userId, userId), isNull(apiTokens.revokedAt))).returning().all().map(publicToken);
+}
+export async function touchToken(orgId: OrgId, id: string, at: IsoTimestamp): Promise<boolean> {
+  return !!getDb().update(apiTokens).set({ lastUsedAt: at }).where(and(eq(apiTokens.orgId, orgId), eq(apiTokens.id, id), isNull(apiTokens.revokedAt), gt(apiTokens.expiresAt, at))).returning({ id: apiTokens.id }).get();
+}

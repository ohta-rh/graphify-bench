@@ -0,0 +1,62 @@
+import { and, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import * as issueRepo from "./issue-repository";
+import type { IsoTimestamp, IssueId, OrgId, UserId } from "@/types/common";
+import type { Issue, IssueDependency } from "@/types/issue";
+
+function mapDependency(row: typeof issueDependencies.$inferSelect): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IsoTimestamp,
+  };
+}
+
+/** Check and insert in one SQLite transaction so competing links cannot form a cycle. */
+export function insertDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId, createdBy: UserId): IssueDependency {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const rows = tx.select().from(issueDependencies)
+      .where(eq(issueDependencies.orgId, orgId)).all();
+    const existing = rows.find((row) => row.issueId === issueId && row.blockerId === blockerId);
+    if (existing) return mapDependency(existing);
+    const visited = new Set<string>();
+    const pending: string[] = [blockerId];
+    while (pending.length > 0) {
+      const current = pending.pop()!;
+      if (current === issueId) throw new Error("Issue dependency would create a cycle");
+      if (visited.has(current)) continue;
+      visited.add(current);
+      for (const row of rows) if (row.issueId === current) pending.push(row.blockerId);
+    }
+    const row = tx.insert(issueDependencies).values({
+      orgId, issueId, blockerId, createdBy, createdAt: toIsoTimestamp(new Date()),
+    }).returning().get();
+    return mapDependency(row);
+  });
+}
+
+export function deleteDependency(orgId: OrgId, issueId: IssueId, blockerId: IssueId): boolean {
+  return getDb().delete(issueDependencies).where(and(
+    eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId),
+    eq(issueDependencies.blockerId, blockerId),
+  )).run().changes > 0;
+}
+
+export async function findBlockers(orgId: OrgId, issueId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ blockerId: issueDependencies.blockerId }).from(issueDependencies)
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.issueId, issueId))).all();
+  const issues = await Promise.all(rows.map((row) => issueRepo.findIssueById(orgId, row.blockerId as IssueId)));
+  return issues.filter((issue): issue is Issue => issue !== null && issue.archivedAt === null)
+    .sort((a, b) => a.number - b.number || a.id.localeCompare(b.id));
+}
+
+export async function findBlockedIssues(orgId: OrgId, blockerId: IssueId): Promise<readonly Issue[]> {
+  const rows = getDb().select({ issueId: issueDependencies.issueId }).from(issueDependencies)
+    .where(and(eq(issueDependencies.orgId, orgId), eq(issueDependencies.blockerId, blockerId))).all();
+  const issues = await Promise.all(rows.map((row) => issueRepo.findIssueById(orgId, row.issueId as IssueId)));
+  return issues.filter((issue): issue is Issue => issue !== null);
+}

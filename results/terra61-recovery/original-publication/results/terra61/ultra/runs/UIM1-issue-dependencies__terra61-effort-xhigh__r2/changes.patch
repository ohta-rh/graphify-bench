+
+/** Notify each still-open dependent once its last open blocker has closed. */
+function registerUnblockedListeners(): Unsubscribe {
+  async function deliver(orgId: OrgId, blockerId: IssueId, actorId: UserId | null): Promise<void> {
+    const dependents = await dependencyRepo.findBlockedIssues(orgId, blockerId);
+    for (const issue of dependents) {
+      if (issue.archivedAt !== null || issue.status === "done" || issue.status === "canceled" || issue.assigneeId === null) continue;
+      const blockers = await dependencyRepo.findBlockers(orgId, issue.id);
+      if (blockers.some((blocker) => blocker.status !== "done" && blocker.status !== "canceled")) continue;
+      await notify(orgId, "issue_unblocked", [issue.assigneeId], {
+        title: "Issue unblocked",
+        body: `Issue ${issue.id} is no longer blocked`,
+        href: `/issues/${issue.id}`,
+        actorId,
+      });
+    }
+  }
+
+  const offStatus = subscribe("issue.status_changed", async (payload) => {
+    if (payload.from === "done" || payload.from === "canceled") return;
+    if (payload.to !== "done" && payload.to !== "canceled") return;
+    await deliver(payload.orgId, payload.issueId, payload.actorId);
+  });
+  const offArchive = subscribe("issue.archived", async (payload) => {
+    const issue = await issueRepo.findIssueById(payload.orgId, payload.issueId);
+    if (!issue || issue.status === "done" || issue.status === "canceled") return;
+    await deliver(payload.orgId, payload.issueId, payload.actorId);
+  });
+  return () => { offStatus(); offArchive(); };
 }

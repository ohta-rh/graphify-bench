+
+/** Insert at most one unread plan alert for each resource and recipient. */
+export async function insertPlanLimitNotification(
+  orgId: OrgId,
+  input: NewNotification,
+): Promise<Notification | null> {
+  const db = getDb();
+  const existing = db.select({ id: notifications.id }).from(notifications).where(and(
+    orgPredicate(notifications.orgId, orgId),
+    eq(notifications.recipientId, input.recipientId),
+    eq(notifications.kind, "plan_limit_reached"),
+    eq(notifications.title, input.title),
+    isNull(notifications.readAt),
+  )).get();
+  if (existing) return null;
+  return insertNotification(orgId, input);
 }

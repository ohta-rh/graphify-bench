diff --git a/src/server/services/link-service.ts b/src/server/services/link-service.ts
new file mode 100644
--- /dev/null
+++ b/src/server/services/link-service.ts
@@ -0,0 +1,56 @@
+/**
+ * Turns ids into the addresses the app actually serves.
+ *
+ * Alerts, digest entries and search hits all carry an `href`; the route shape
+ * lives in `@/lib/url`, and the slugs and numbers those helpers need live in
+ * the repositories. This module is the only place the two meet, so a link
+ * produced by a background handler is the same link the pages render.
+ *
+ * Must call (do not reimplement): issuePath, projectPath, settingsPath
+ */
+import { issuePath, orgPath, projectPath, settingsPath } from "@/lib/url";
+import * as commentRepo from "@/server/repositories/comment-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import type { CommentId, IssueId, OrgId, ProjectId } from "@/types/common";
+
+/** The issue's own page; the workspace root when the row cannot be found. */
+export async function linkToIssue(orgId: OrgId, issueId: IssueId): Promise<string> {
+  const org = await orgRepo.findOrgById(orgId);
+  if (!org) return "/";
+
+  const issue = await issueRepo.findIssueById(orgId, issueId);
+  if (!issue) return orgPath(org.slug);
+
+  const project = await projectRepo.findProjectById(orgId, issue.projectId);
+  if (!project) return orgPath(org.slug);
+
+  return issuePath(org.slug, project.slug, issue.number);
+}
+
+export async function linkToProject(orgId: OrgId, projectId: ProjectId): Promise<string> {
+  const org = await orgRepo.findOrgById(orgId);
+  if (!org) return "/";
+
+  const project = await projectRepo.findProjectById(orgId, projectId);
+  if (!project) return orgPath(org.slug);
+
+  return projectPath(org.slug, project.slug);
+}
+
+/** A comment has no page of its own: its link is the page of its issue. */
+export async function linkToComment(orgId: OrgId, commentId: CommentId): Promise<string> {
+  const comment = await commentRepo.findCommentById(orgId, commentId);
+  if (!comment) {
+    const org = await orgRepo.findOrgById(orgId);
+    return org ? orgPath(org.slug) : "/";
+  }
+  return linkToIssue(orgId, comment.issueId);
+}
+
+export async function linkToSettings(orgId: OrgId, section?: string): Promise<string> {
+  const org = await orgRepo.findOrgById(orgId);
+  if (!org) return "/";
+  return settingsPath(org.slug, section);
+}

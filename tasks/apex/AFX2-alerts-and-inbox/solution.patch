+/**
+ * True while an unread alert of this kind and link exists for the recipient —
+ * the de-duplication the plan-limit alert relies on.
+ */
+export async function hasUnread(
+  orgId: OrgId,
+  recipientId: UserId,
+  kind: Notification["kind"],
+  href: string,
+): Promise<boolean> {
+  const row = getDb()
+    .select({ id: notifications.id })
+    .from(notifications)
+    .where(
+      and(
+        orgPredicate(notifications.orgId, orgId),
+        eq(notifications.recipientId, recipientId),
+        eq(notifications.kind, kind),
+        eq(notifications.href, href),
+        isNull(notifications.readAt),
+      ),
+    )
+    .get();
+  return row !== undefined;
+}

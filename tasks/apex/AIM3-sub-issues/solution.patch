new file mode 100644
--- /dev/null
+++ b/src/lib/issue-hierarchy.ts
@@ -0,0 +1,38 @@
+/**
+ * Sub-issue rules: an issue may sit under a parent of the same project, the
+ * tree never loops, and it never grows deeper than `MAX_SUB_ISSUE_DEPTH`
+ * levels below a root. Pure, so the issue service and any UI gate agree.
+ */
+import { MAX_SUB_ISSUE_DEPTH } from "@/config/constants";
+
+export type IssueHierarchyReason =
+  /** The parent is the issue itself or one of its descendants. */
+  | "cycle"
+  /** The resulting tree would be deeper than `MAX_SUB_ISSUE_DEPTH`. */
+  | "too_deep";
+
+/** Thrown by the hierarchy guards; mapped to `conflict`, like double-archiving. */
+export class IssueHierarchyError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(
+    readonly issueId: string,
+    readonly reason: IssueHierarchyReason,
+  ) {
+    super(
+      reason === "cycle"
+        ? `Issue ${issueId} cannot be its own ancestor`
+        : `Issue ${issueId} would sit deeper than ${MAX_SUB_ISSUE_DEPTH} levels`,
+    );
+    this.name = "IssueHierarchyError";
+  }
+}
+
+/**
+ * True when an issue whose subtree is `subtreeHeight` levels tall (0 for a
+ * leaf) may be placed under a parent that sits `parentDepth` levels below a
+ * root (0 for a root).
+ */
+export function fitsDepth(parentDepth: number, subtreeHeight: number): boolean {
+  return parentDepth + 1 + subtreeHeight <= MAX_SUB_ISSUE_DEPTH;
+}

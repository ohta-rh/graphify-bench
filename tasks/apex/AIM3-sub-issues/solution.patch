+
+/**
+ * The parent must be a live issue of the same project, not the issue itself
+ * nor anything below it, and the tree must stay within the depth limit once
+ * a subtree `height` levels tall hangs under it.
+ */
+async function requireUsableParent(
+  orgId: OrgId,
+  projectId: ProjectId,
+  parentId: IssueId,
+  issueId: IssueId | null,
+  height: number,
+): Promise<void> {
+  const parent = await issueRepo.findIssueById(orgId, parentId);
+  if (!parent || parent.projectId !== projectId) {
+    throw new NotFoundError("Issue", parentId);
+  }
+  assertNotArchived("Issue", parent.id, parent);

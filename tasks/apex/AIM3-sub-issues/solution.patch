+/**
+ * Puts an issue under a parent of its own project, or makes it a root again.
+ * The subtree below the issue moves with it, so the depth check looks at the
+ * deepest descendant, not just the issue.
+ */
+export async function setIssueParent(
+  actor: Actor,
+  input: SetIssueParentInput,
+): Promise<Issue> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  assertCan(actor, "issue:update", issueResource(issue));
+  assertNotArchived("Issue", issue.id, issue);
+
+  if (input.parentId !== null) {
+    const subtree = await issueRepo.listDescendants(input.orgId, [issue.id]);
+    const height = subtree.reduce((max, row) => Math.max(max, row.depth), 0);
+    await requireUsableParent(input.orgId, issue.projectId, input.parentId, issue.id, height);
+  }
+
+  const after = await issueRepo.setIssueParent(input.orgId, issue.id, input.parentId);
+
+  await emit("issue.updated", {
+    ...actorEnvelope(actor),
+    issueId: after.id,
+    projectId: after.projectId,
+    changedFields: ["parentId"],
+  });
+
+  return after;
+}

+/**
+ * Every live descendant of the given issues, level by level, with the depth
+ * (1 for a direct child) and status of each — read whole, never paged, so a
+ * parent with hundreds of children is counted in full.
+ */
+export async function listDescendants(
+  orgId: OrgId,
+  rootIds: readonly IssueId[],
+): Promise<readonly { id: IssueId; parentId: IssueId; depth: number; status: IssueStatus }[]> {
+  const out: { id: IssueId; parentId: IssueId; depth: number; status: IssueStatus }[] = [];
+  let frontier = [...rootIds];
+  let depth = 0;
+
+  while (frontier.length > 0) {
+    depth += 1;
+    const rows = getDb()
+      .select({ id: issues.id, parentId: issues.parentId, status: issues.status })
+      .from(issues)
+      .where(
+        and(
+          ...compact(
+            orgPredicate(issues.orgId, orgId),
+            inArray(issues.parentId, frontier),
+            livePredicate(issues.archivedAt, {}),
+          ),
+        ),
+      )
+      .all();
+
+    frontier = [];
+    for (const row of rows) {
+      const id = row.id as IssueId;
+      out.push({ id, parentId: row.parentId as IssueId, depth, status: row.status });
+      frontier.push(id);
+    }
+  }
+
+  return out;
+}
+
+/** Counts over every live descendant of one issue, at any depth. */
+export async function countDescendants(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<{ total: number; open: number; closed: number }> {
+  const rows = await listDescendants(orgId, [issueId]);
+  const closed = rows.filter((row) => CLOSED_ISSUE_STATUSES.includes(row.status)).length;
+  return { total: rows.length, closed, open: rows.length - closed };
+}
+
+/** How many levels lie between the issue and its root (0 for a root). */
+export async function depthOf(orgId: OrgId, issueId: IssueId): Promise<number> {
+  let depth = 0;
+  let current = issueId;
+  const seen = new Set<string>([issueId]);
+
+  for (;;) {
+    const row = getDb()
+      .select({ parentId: issues.parentId })
+      .from(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, current)))
+      .get();
+    if (!row || row.parentId === null || seen.has(row.parentId)) return depth;
+    seen.add(row.parentId);
+    current = row.parentId as IssueId;
+    depth += 1;
+  }
+}
+
+/** Archives the given live issues in one statement; returns the ids actually archived. */
+export async function archiveIssues(
+  orgId: OrgId,
+  issueIds: readonly IssueId[],
+): Promise<readonly IssueId[]> {
+  if (issueIds.length === 0) return [];
+  const rows = getDb()
+    .update(issues)
+    .set(archivePatch())
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          inArray(issues.id, [...issueIds]),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    )
+    .returning({ id: issues.id })
+    .all();
+  return rows.map((row) => row.id as IssueId);
+}

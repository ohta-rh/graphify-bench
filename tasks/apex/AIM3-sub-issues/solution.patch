+  if (issueId !== null) {
+    if (parent.id === issueId) throw new IssueHierarchyError(issueId, "cycle");
+    const below = await issueRepo.listDescendants(orgId, [issueId]);
+    if (below.some((row) => row.id === parent.id)) {

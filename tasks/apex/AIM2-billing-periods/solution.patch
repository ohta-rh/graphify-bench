+/**
+ * Subscriptions the renewal job must look at: active ones whose period has
+ * ended, and canceled ones whose cancellation date has arrived. Cross-tenant
+ * by design; the job skips deleted workspaces itself.
+ */
+export async function listSubscriptionsDue(
+  now: IsoTimestamp,
+): Promise<readonly Subscription[]> {
+  const rows = getDb()
+    .select()
+    .from(subscriptions)
+    .where(
+      or(
+        and(eq(subscriptions.status, "active"), lte(subscriptions.currentPeriodEnd, now)),
+        and(
+          eq(subscriptions.status, "canceled"),
+          isNotNull(subscriptions.cancelAt),
+          lte(subscriptions.cancelAt, now),
+        ),
+      ),
+    )
+    .all();
+
+  return rows.map(toSubscription);
+}
+
+/** Moves the subscription to its next period. */
+export async function advanceSubscriptionPeriod(
+  orgId: OrgId,
+  periodStart: IsoTimestamp,
+  periodEnd: IsoTimestamp,
+): Promise<Subscription> {
+  const row = getDb()
+    .update(subscriptions)
+    .set({
+      currentPeriodStart: periodStart,
+      currentPeriodEnd: periodEnd,
+      updatedAt: toIsoTimestamp(new Date()),
+    })
+    .where(orgPredicate(subscriptions.orgId, orgId))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Subscription for org ${orgId} not found`);
+  return toSubscription(row);
+}
+
+/** A cancellation that has arrived: back on `plan`, active, fresh period. */
+export async function endSubscription(
+  orgId: OrgId,
+  plan: PlanId,
+  periodStart: IsoTimestamp,
+  periodEnd: IsoTimestamp,
+): Promise<Subscription> {
+  const row = getDb()
+    .update(subscriptions)
+    .set({
+      plan,
+      interval: "monthly",
+      status: "active",
+      cancelAt: null,
+      currentPeriodStart: periodStart,
+      currentPeriodEnd: periodEnd,
+      updatedAt: toIsoTimestamp(new Date()),
+    })
+    .where(orgPredicate(subscriptions.orgId, orgId))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Subscription for org ${orgId} not found`);
+  return toSubscription(row);
+}

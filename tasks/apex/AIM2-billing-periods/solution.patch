+/**
+ * Issues a mid-period invoice for `fullPeriodCents` worth of change, scaled to
+ * the days left in the subscription's current period. Nothing is issued when
+ * nothing is owed.
+ */
+async function chargeForRestOfPeriod(
+  orgId: OrgId,
+  orgSlug: string,
+  fullPeriodCents: number,
+  subscription: Subscription,
+  now: Date,
+  actorId: UserId | null,
+): Promise<Invoice | null> {
+  const amount = proratedCents(
+    fullPeriodCents,
+    subscription.currentPeriodStart,
+    subscription.currentPeriodEnd,
+    now,
+  );
+  if (amount <= 0) return null;
+
+  return issueInvoice(
+    orgId,
+    orgSlug,
+    subscription.plan,
+    subscription.seats,
+    subscription.interval,
+    subscription.currentPeriodStart,
+    subscription.currentPeriodEnd,
+    actorId,
+    amount,
+  );
+}

+ */
+export async function issueInvoice(
+  orgId: OrgId,
+  orgSlug: string,
+  plan: PlanId,
+  seats: number,
+  interval: BillingInterval,
+  periodStart: IsoTimestamp,
+  periodEnd: IsoTimestamp,
+  actorId: UserId | null,
+  amountCents: number = periodChargeCents(plan, seats, interval),
+): Promise<Invoice> {
+  const sequence = (await invoiceRepo.countInvoices(orgId)) + 1;
+  const invoice = await invoiceRepo.insertInvoice(orgId, {
+    orgId,
+    number: `INV-${orgSlug}-${String(sequence).padStart(4, "0")}`,
+    amountCents,
+    currency: "usd",
+    periodStart,
+    periodEnd,
+    paidAt: null,
+  });
+
+  await emit("billing.invoice_issued", {
+    orgId,
+    actorId,
+    occurredAt: toIsoTimestamp(new Date()),
+    invoiceId: invoice.id,
+    invoiceNumber: invoice.number,
+    amountCents: invoice.amountCents,
+    periodStart,
+    periodEnd,
+  });
+
+  return invoice;
+}
+
 /** Cancels at period end by default; `cancelImmediately` ends it now. */

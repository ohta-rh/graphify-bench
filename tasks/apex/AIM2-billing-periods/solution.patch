diff --git a/src/server/jobs/billing-renewal-job.ts b/src/server/jobs/billing-renewal-job.ts
new file mode 100644
--- /dev/null
+++ b/src/server/jobs/billing-renewal-job.ts
@@ -0,0 +1,90 @@
+/**
+ * Renews subscriptions whose period has ended and ends the ones whose
+ * cancellation date has arrived; every paid period renewed is invoiced.
+ *
+ * Must call (do not reimplement): emit, nextPeriodEnd, issueInvoice
+ */
+import { emit } from "@/lib/event-bus";
+import { createLogger } from "@/lib/logger";
+import { nextPeriodEnd } from "@/lib/billing-periods";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as subscriptionRepo from "@/server/repositories/subscription-repository";
+import { issueInvoice } from "@/server/services/billing-service";
+import { toIsoTimestamp } from "@/types/common";
+import { runJob } from "./types";
+import type { JobResult } from "@/server/jobs/types";
+import type { Subscription } from "@/types/billing";
+import type { IsoTimestamp, OrgId } from "@/types/common";
+
+const logger = createLogger("billing-renewal-job");
+
+/** Where a subscription lands once its cancellation date has arrived. */
+const FALLBACK_PLAN = "free" as const;
+
+/**
+ * One pass over every due subscription, deleted workspaces excluded. Idempotent
+ * for a given instant: a subscription is only due while its period end (or
+ * cancellation date) lies at or before `now`, and each renewal moves it past.
+ */
+export async function runBillingRenewalJob(now: Date): Promise<JobResult> {
+  return runJob("billing-renewal", async (result) => {
+    const stamp = toIsoTimestamp(now);
+    const due = await subscriptionRepo.listSubscriptionsDue(stamp);
+
+    for (const subscription of due) {
+      const orgId = subscription.orgId as OrgId;
+      const org = await orgRepo.findOrgById(orgId);
+      if (!org || org.archivedAt !== null) continue;
+
+      try {
+        if (subscription.status === "canceled") {
+          await endSubscription(subscription, stamp);
+        } else if (subscription.status === "active") {
+          await renew(subscription, org.slug, stamp);
+        }
+        result.processed += 1;
+      } catch (error) {
+        result.failed += 1;
+        logger.error("renewal failed", {
+          orgId,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  });
+}
+
+/** Advances period by period until the end lies after `now`; paid periods are invoiced. */
+async function renew(subscription: Subscription, orgSlug: string, now: IsoTimestamp): Promise<void> {
+  let current = subscription;
+
+  while (current.currentPeriodEnd <= now) {
+    const start = current.currentPeriodEnd;
+    const end = nextPeriodEnd(start, current.interval);
+
+    current = await subscriptionRepo.advanceSubscriptionPeriod(current.orgId, start, end);
+
+    if (current.plan !== FALLBACK_PLAN) {
+      await issueInvoice(current.orgId, orgSlug, current.plan, current.seats, current.interval, start, end, null);
+    }
+  }
+}
+
+/** The cancellation date has arrived: back to the free plan from that instant. */
+async function endSubscription(subscription: Subscription, now: IsoTimestamp): Promise<void> {
+  const at = subscription.cancelAt ?? now;
+  await subscriptionRepo.endSubscription(
+    subscription.orgId,
+    FALLBACK_PLAN,
+    at,
+    nextPeriodEnd(at, "monthly"),
+  );
+
+  await emit("billing.plan_changed", {
+    orgId: subscription.orgId,
+    actorId: null,
+    occurredAt: at,
+    from: subscription.plan,
+    to: FALLBACK_PLAN,
+  });
+}

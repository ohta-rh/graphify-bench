diff --git a/src/lib/billing-periods.ts b/src/lib/billing-periods.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/billing-periods.ts
@@ -0,0 +1,85 @@
+/**
+ * Billing-period arithmetic, pure so the renewal job, the plan change and the
+ * seat change all charge the same way.
+ *
+ * A period is `[start, end)`. A monthly period ends on the same day of the
+ * following month at the same time of day — or on that month's last day when
+ * it has no such day; an annual period ends on the same day and month of the
+ * following year (29 February becomes 28 February). Each new period starts
+ * where the previous one ended, so a clamped end date carries forward.
+ */
+import { parseIso } from "@/lib/date";
+import { getPlanLimits } from "@/config/plan-limits";
+import type { BillingInterval, PlanId } from "@/types/billing";
+import type { IsoTimestamp } from "@/types/common";
+import { toIsoTimestamp } from "@/types/common";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function daysInMonth(year: number, monthIndex: number): number {
+  return new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
+}
+
+/** The instant one interval after `start`, with the day clamped as described above. */
+export function nextPeriodEnd(start: IsoTimestamp, interval: BillingInterval): IsoTimestamp {
+  const from = parseIso(start);
+  const months = interval === "annual" ? 12 : 1;
+
+  const year = from.getUTCFullYear();
+  const month = from.getUTCMonth() + months;
+  const targetYear = year + Math.floor(month / 12);
+  const targetMonth = month % 12;
+  const day = Math.min(from.getUTCDate(), daysInMonth(targetYear, targetMonth));
+
+  return toIsoTimestamp(
+    new Date(
+      Date.UTC(
+        targetYear,
+        targetMonth,
+        day,
+        from.getUTCHours(),
+        from.getUTCMinutes(),
+        from.getUTCSeconds(),
+        from.getUTCMilliseconds(),
+      ),
+    ),
+  );
+}
+
+/** Months a period of this interval covers, for price arithmetic. */
+export function monthsPerPeriod(interval: BillingInterval): number {
+  return interval === "annual" ? 12 : 1;
+}
+
+/** The full charge for one period: per-seat monthly price × seats × months. */
+export function periodChargeCents(plan: PlanId, seats: number, interval: BillingInterval): number {
+  return getPlanLimits(plan).priceCentsPerSeatMonthly * seats * monthsPerPeriod(interval);
+}
+
+/** Whole days the period spans, at least one. */
+export function periodDays(start: IsoTimestamp, end: IsoTimestamp): number {
+  const span = parseIso(end).getTime() - parseIso(start).getTime();
+  return Math.max(1, Math.round(span / DAY_MS));
+}
+
+/** Days — whole or started — left until the end; none once the end is reached. */
+export function remainingDays(end: IsoTimestamp, now: Date): number {
+  const left = parseIso(end).getTime() - now.getTime();
+  return left <= 0 ? 0 : Math.ceil(left / DAY_MS);
+}
+
+/**
+ * A mid-period charge: the full-period amount of the change, scaled by the
+ * days left over the days in the period, rounded down to whole cents.
+ */
+export function proratedCents(
+  fullPeriodCents: number,
+  start: IsoTimestamp,
+  end: IsoTimestamp,
+  now: Date,
+): number {
+  if (fullPeriodCents <= 0) return 0;
+  const left = remainingDays(end, now);
+  if (left === 0) return 0;
+  return Math.floor((fullPeriodCents * left) / periodDays(start, end));
+}

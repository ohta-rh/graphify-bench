+/**
+ * Every active member with their user record, oldest membership first and
+ * without a page cap. Mention resolution needs the whole organization: a
+ * paged read would quietly drop everyone beyond the first page.
+ */
+export async function listActiveMembers(
+  orgId: OrgId,
+): Promise<readonly MemberWithUser[]> {
+  const rows = getDb()
+    .select({ member: members, user: users })
+    .from(members)
+    .innerJoin(users, eq(users.id, members.userId))
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.status, "active"),
+        liveMemberPredicate(),
+      ),
+    )
+    .orderBy(asc(members.createdAt), asc(members.id))
+    .all();
+
+  return rows.map((row) => ({ ...toMember(row.member), user: toUser(row.user) }));
+}

--- a/src/lib/slug.ts
+++ b/src/lib/slug.ts
@@ -100,3 +100,24 @@
       : (words[0] ?? "task").slice(0, 3);
   return letters.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 4) || "TASK";
 }
+
+export const PROJECT_KEY_MAX_LENGTH = 4;
+
+/**
+ * Derives a key that collides with nothing in `taken`, the way `uniqueSlug`
+ * does for addresses: the key itself, then `KEY2`, `KEY3`, …, trimmed so the
+ * result never exceeds `PROJECT_KEY_MAX_LENGTH`. Keys of archived projects
+ * are expected in `taken` — their issue numbers still carry them.
+ */
+export function uniqueProjectKey(key: string, taken: Iterable<string>): string {
+  const base = key.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, PROJECT_KEY_MAX_LENGTH) || "TASK";
+  const used = new Set(taken);
+  if (!used.has(base)) return base;
+
+  for (let suffix = 2; suffix < 1_000; suffix += 1) {
+    const digits = String(suffix);
+    const candidate = `${base.slice(0, PROJECT_KEY_MAX_LENGTH - digits.length)}${digits}`;
+    if (!used.has(candidate)) return candidate;
+  }
+  throw new InvalidSlugError(base, "exhausted unique key suffixes");
+}

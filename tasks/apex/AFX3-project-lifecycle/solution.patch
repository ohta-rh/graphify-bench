diff --git a/src/lib/project-lifecycle.ts b/src/lib/project-lifecycle.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/project-lifecycle.ts
@@ -0,0 +1,54 @@
+/**
+ * Project lifecycle rules: which projects take new work, when a project may
+ * be marked completed, and when a restore makes sense.
+ *
+ * A project is `active`, `paused` or `completed` while it is live, and may be
+ * archived on top of that. Only an active, live project accepts new issues;
+ * existing issues stay editable whatever the project's status. The decisions
+ * are pure so the service layer, the actions and the UI gates agree.
+ */
+import type { Project, ProjectStatus } from "@/types/project";
+
+export type ProjectLifecycleReason =
+  /** The project is paused or completed and takes no new issues. */
+  | "not_active"
+  /** The project still has open issues and cannot be marked completed. */
+  | "open_issues"
+  /** The project is live, so there is nothing to restore. */
+  | "not_archived";
+
+/** Thrown by the lifecycle guards; mapped to `conflict`, like double-archiving. */
+export class ProjectLifecycleError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(
+    readonly projectId: string,
+    readonly reason: ProjectLifecycleReason,
+    readonly status: ProjectStatus,
+  ) {
+    super(`Project ${projectId} (${status}): ${describe(reason)}`);
+    this.name = "ProjectLifecycleError";
+  }
+}
+
+function describe(reason: ProjectLifecycleReason): string {
+  switch (reason) {
+    case "not_active":
+      return "takes no new issues while paused or completed";
+    case "open_issues":
+      return "cannot be completed while it has open issues";
+    case "not_archived":
+      return "is not archived";
+  }
+}
+
+/** True when a new issue may be filed in the project. */
+export function acceptsNewIssues(project: Project): boolean {
+  return project.archivedAt === null && project.status === "active";
+}
+
+export function assertAcceptsNewIssues(project: Project): void {
+  if (!acceptsNewIssues(project) && project.archivedAt === null) {
+    throw new ProjectLifecycleError(project.id, "not_active", project.status);
+  }
+}

+/**
+ * Live issues of the project that are still open (neither done nor canceled).
+ * A count rather than a listing: the completion gate must see every issue,
+ * not the first page of them.
+ */
+export async function countOpenIssues(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<number> {
+  const row = getDb()
+    .select({ value: count() })
+    .from(issues)
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.projectId, projectId),
+          livePredicate(issues.archivedAt, {}),
+          notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+        ),
+      ),
+    )
+    .get();
+  return row?.value ?? 0;
+}

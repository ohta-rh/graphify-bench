diff --git a/src/server/repositories/milestone-repository.ts b/src/server/repositories/milestone-repository.ts
new file mode 100644
--- /dev/null
+++ b/src/server/repositories/milestone-repository.ts
@@ -0,0 +1,122 @@
+/**
+ * Milestone rows: per-project groups of issues with an open/closed state.
+ */
+import { and, asc, count, eq, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, milestones } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { toMilestone } from "./_mappers";
+import type { CreateMilestoneInput, UpdateMilestoneInput } from "@/schemas/milestone";
+import type { IsoTimestamp, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Milestone } from "@/types/milestone";
+
+export async function findMilestoneById(
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<Milestone | null> {
+  const row = getDb()
+    .select()
+    .from(milestones)
+    .where(and(orgPredicate(milestones.orgId, orgId), eq(milestones.id, milestoneId)))
+    .get();
+  return row ? toMilestone(row) : null;
+}
+
+/** Every milestone of a project, oldest first; the service orders for display. */
+export async function listMilestones(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<readonly Milestone[]> {
+  const rows = getDb()
+    .select()
+    .from(milestones)
+    .where(
+      and(
+        orgPredicate(milestones.orgId, orgId),
+        eq(milestones.projectId, projectId),
+      ),
+    )
+    .orderBy(asc(milestones.createdAt), asc(milestones.id))
+    .all();
+  return rows.map(toMilestone);
+}
+
+export async function countOpenMilestones(
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<number> {
+  const row = getDb()
+    .select({ value: count() })
+    .from(milestones)
+    .where(
+      and(
+        orgPredicate(milestones.orgId, orgId),
+        eq(milestones.projectId, projectId),
+        isNull(milestones.closedAt),
+      ),
+    )
+    .get();
+  return row?.value ?? 0;
+}
+
+export async function insertMilestone(
+  input: CreateMilestoneInput,
+): Promise<Milestone> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(milestones)
+    .values({
+      id: newId(),
+      orgId: input.orgId,
+      projectId: input.projectId,
+      name: input.name,
+      targetDate: input.targetDate,
+      closedAt: null,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .returning()
+    .get();
+  return toMilestone(row);
+}
+
+export async function updateMilestone(
+  input: UpdateMilestoneInput,
+): Promise<Milestone> {
+  const row = getDb()
+    .update(milestones)
+    .set({
+      ...(input.name === undefined ? {} : { name: input.name }),
+      ...(input.targetDate === undefined ? {} : { targetDate: input.targetDate }),
+      updatedAt: toIsoTimestamp(new Date()),
+    })
+    .where(
+      and(
+        orgPredicate(milestones.orgId, input.orgId),
+        eq(milestones.id, input.milestoneId),
+      ),
+    )
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Milestone ${input.milestoneId} not found`);
+  return toMilestone(row);
+}
+
+/** `closedAt === null` reopens the milestone. */
+export async function setMilestoneClosedAt(
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+  closedAt: IsoTimestamp | null,
+): Promise<Milestone> {
+  const row = getDb()
+    .update(milestones)
+    .set({ closedAt, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(milestones.orgId, orgId), eq(milestones.id, milestoneId)))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Milestone ${milestoneId} not found`);
+  return toMilestone(row);
+}

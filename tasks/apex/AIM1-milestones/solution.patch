+export async function setIssueMilestone(
+  orgId: OrgId,
+  issueId: IssueId,
+  milestoneId: MilestoneId | null,
+): Promise<Issue> {
+  const row = getDb()
+    .update(issues)
+    .set({ milestoneId, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))

+++ b/src/types/milestone.ts
@@ -0,0 +1,34 @@
+import type {
+  IsoTimestamp,
+  MilestoneId,
+  ProjectId,
+  TenantScoped,
+  Timestamps,
+} from "./common";
+
+/**
+ * A milestone groups a project's issues toward a target. It is open from its
+ * creation until it is closed; closing moves whatever was still open out of
+ * it, so a closed milestone only ever holds finished (or archived) work.
+ */
+export interface Milestone extends Timestamps, TenantScoped {
+  readonly id: MilestoneId;
+  readonly projectId: ProjectId;
+  readonly name: string;
+  readonly targetDate: IsoTimestamp | null;
+  readonly closedAt: IsoTimestamp | null;
+}
+
+/** Counts over the milestone's live (non-archived) issues. */
+export interface MilestoneProgress {
+  readonly total: number;
+  readonly open: number;
+  readonly closed: number;
+}
+
+export interface MilestoneWithProgress {
+  readonly milestone: Milestone;
+  readonly progress: MilestoneProgress;
+  /** Open, past its target date, and still holding open issues. */
+  readonly overdue: boolean;
+}

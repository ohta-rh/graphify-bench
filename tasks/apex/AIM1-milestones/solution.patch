+
+/**
+ * Counts over the milestone's live issues — every one of them, never a page.
+ * Closed means done or canceled.
+ */
+export async function countMilestoneProgress(
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<{ total: number; open: number; closed: number }> {
+  const db = getDb();
+  const scope = and(
+    ...compact(
+      orgPredicate(issues.orgId, orgId),
+      eq(issues.milestoneId, milestoneId),
+      livePredicate(issues.archivedAt, {}),
+    ),
+  );
+
+  const total = db.select({ value: count() }).from(issues).where(scope).get();
+  const closed = db
+    .select({ value: count() })
+    .from(issues)
+    .where(and(scope, inArray(issues.status, [...CLOSED_ISSUE_STATUSES])))
+    .get();
+
+  const totalCount = total?.value ?? 0;
+  const closedCount = closed?.value ?? 0;
+  return { total: totalCount, closed: closedCount, open: totalCount - closedCount };
+}
+
+/**
+ * Moves every open, live issue of `from` to `to` (or out of any milestone)
+ * in one statement, and returns the ids that moved. Closed and archived
+ * issues keep their milestone.
+ */
+export async function moveOpenIssuesBetweenMilestones(
+  orgId: OrgId,
+  from: MilestoneId,
+  to: MilestoneId | null,
+): Promise<readonly IssueId[]> {
+  const rows = getDb()
+    .update(issues)
+    .set({ milestoneId: to, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.milestoneId, from),
+          livePredicate(issues.archivedAt, {}),
+          notInArray(issues.status, [...CLOSED_ISSUE_STATUSES]),
+        ),
+      ),
+    )
+    .returning({ id: issues.id })
+    .all();
+
+  return rows.map((row) => row.id as IssueId);
+}

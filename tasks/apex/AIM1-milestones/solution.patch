@@ -0,0 +1,72 @@
+/**
+ * Milestone state rules, shared by the milestone service, the issue service
+ * and the UI gates.
+ */
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { parseIso } from "@/lib/date";
+import type { Milestone, MilestoneProgress } from "@/types/milestone";
+
+export type MilestoneStateReason =
+  /** The milestone is closed and the operation needs an open one. */
+  | "closed"
+  /** The milestone is already open. */
+  | "already_open"
+  /** The project already has the maximum number of open milestones. */
+  | "too_many_open"
+  /** Another milestone of the project already carries this name. */
+  | "name_taken";
+
+/** Thrown by the milestone guards; mapped to `conflict`, like double-archiving. */
+export class MilestoneStateError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(
+    readonly milestoneId: string | null,
+    readonly reason: MilestoneStateReason,
+  ) {
+    super(`Milestone ${milestoneId ?? "(new)"}: ${describe(reason)}`);
+    this.name = "MilestoneStateError";
+  }
+}
+
+function describe(reason: MilestoneStateReason): string {
+  switch (reason) {
+    case "closed":
+      return "is closed";
+    case "already_open":
+      return "is already open";
+    case "too_many_open":
+      return `the project already has ${MAX_OPEN_MILESTONES_PER_PROJECT} open milestones`;
+    case "name_taken":
+      return "the name is already used in this project";
+  }
+}
+
+export function isMilestoneOpen(milestone: Milestone): boolean {
+  return milestone.closedAt === null;
+}
+
+export function assertMilestoneOpen(milestone: Milestone): void {
+  if (!isMilestoneOpen(milestone)) {
+    throw new MilestoneStateError(milestone.id, "closed");
+  }
+}
+
+/** Names collide without regard to letter case. */
+export function normaliseMilestoneName(name: string): string {
+  return name.trim().toLowerCase();
+}
+
+/**
+ * Open, past its target date (strictly), and still holding open issues. A
+ * milestone with no target date is never overdue.
+ */
+export function isMilestoneOverdue(
+  milestone: Milestone,
+  progress: MilestoneProgress,
+  now: Date = new Date(),
+): boolean {
+  if (milestone.closedAt !== null || milestone.targetDate === null) return false;
+  if (progress.open === 0) return false;
+  return parseIso(milestone.targetDate).getTime() < now.getTime();
+}

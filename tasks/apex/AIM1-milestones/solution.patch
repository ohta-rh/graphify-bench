diff --git a/src/server/services/milestone-service.ts b/src/server/services/milestone-service.ts
new file mode 100644
--- /dev/null
+++ b/src/server/services/milestone-service.ts
@@ -0,0 +1,246 @@
+/**
+ * Milestones: per-project groups of issues with a target date, open until
+ * closed. Closing moves the open work out, so a closed milestone only holds
+ * what was finished (or archived) inside it.
+ *
+ * Must call (do not reimplement): assertCan, assertOrgScope, emit, assertNotArchived
+ */
+import { MAX_OPEN_MILESTONES_PER_PROJECT } from "@/config/constants";
+import { emit } from "@/lib/event-bus";
+import {
+  MilestoneStateError,
+  assertMilestoneOpen,
+  isMilestoneOpen,
+  isMilestoneOverdue,
+  normaliseMilestoneName,
+} from "@/lib/milestones";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import * as milestoneRepo from "@/server/repositories/milestone-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { NotFoundError, actorEnvelope, projectResource, requireFound } from "./_support";
+import type {
+  CloseMilestoneInput,
+  CreateMilestoneInput,
+  UpdateMilestoneInput,
+} from "@/schemas/milestone";
+import type { IssueId, MilestoneId, OrgId, ProjectId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { Milestone, MilestoneProgress, MilestoneWithProgress } from "@/types/milestone";
+import type { Project } from "@/types/project";
+
+export async function createMilestone(
+  actor: Actor,
+  input: CreateMilestoneInput,
+): Promise<Milestone> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:update", projectResource(project));
+  assertNotArchived("Project", project.id, project);
+
+  await assertNameFree(input.orgId, project.id, input.name, null);
+  await assertRoomForOpenMilestone(input.orgId, project.id);
+
+  const milestone = await milestoneRepo.insertMilestone(input);
+
+  await emit("milestone.created", {
+    ...actorEnvelope(actor),
+    milestoneId: milestone.id,
+    projectId: milestone.projectId,
+  });
+
+  return milestone;
+}
+
+export async function updateMilestone(
+  actor: Actor,
+  input: UpdateMilestoneInput,
+): Promise<Milestone> {
+  assertOrgScope(actor, input.orgId);
+
+  const { milestone, project } = await loadForWrite(actor, input.orgId, input.milestoneId);
+
+  if (input.name !== undefined) {
+    await assertNameFree(input.orgId, project.id, input.name, milestone.id);
+  }
+
+  return milestoneRepo.updateMilestone(input);
+}
+
+/**
+ * Closes the milestone and moves its open live issues to `moveOpenIssuesTo`
+ * (another open milestone of the same project) or out of any milestone.
+ * Closed and archived issues stay where they are. Published once, with the
+ * ids that moved, so the assignees can be told.
+ */
+export async function closeMilestone(
+  actor: Actor,
+  input: CloseMilestoneInput,
+): Promise<{ milestone: Milestone; movedIssueIds: readonly IssueId[] }> {
+  assertOrgScope(actor, input.orgId);
+
+  const { milestone, project } = await loadForWrite(actor, input.orgId, input.milestoneId);
+  assertMilestoneOpen(milestone);
+
+  if (input.moveOpenIssuesTo !== null) {
+    const target = await milestoneRepo.findMilestoneById(input.orgId, input.moveOpenIssuesTo);
+    if (!target || target.projectId !== project.id || target.id === milestone.id) {
+      throw new NotFoundError("Milestone", input.moveOpenIssuesTo);
+    }
+    assertMilestoneOpen(target);
+  }
+
+  const movedIssueIds = await issueRepo.moveOpenIssuesBetweenMilestones(
+    input.orgId,
+    milestone.id,
+    input.moveOpenIssuesTo,
+  );
+
+  const closed = await milestoneRepo.setMilestoneClosedAt(
+    input.orgId,
+    milestone.id,
+    toIsoTimestamp(new Date()),
+  );
+
+  await emit("milestone.closed", {
+    ...actorEnvelope(actor),
+    milestoneId: closed.id,
+    projectId: closed.projectId,
+    movedToMilestoneId: input.moveOpenIssuesTo,
+    movedIssueIds,
+  });
+
+  return { milestone: closed, movedIssueIds };
+}
+
+export async function reopenMilestone(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<Milestone> {
+  assertOrgScope(actor, orgId);
+
+  const { milestone, project } = await loadForWrite(actor, orgId, milestoneId);
+  if (isMilestoneOpen(milestone)) {
+    throw new MilestoneStateError(milestone.id, "already_open");
+  }
+  await assertRoomForOpenMilestone(orgId, project.id);
+
+  const reopened = await milestoneRepo.setMilestoneClosedAt(orgId, milestone.id, null);
+
+  await emit("milestone.reopened", {
+    ...actorEnvelope(actor),
+    milestoneId: reopened.id,
+    projectId: reopened.projectId,
+  });
+
+  return reopened;
+}
+
+/**
+ * Open milestones first, then closed ones; inside each group by target date
+ * (earliest first, no date last), then by creation.
+ */
+export async function listMilestones(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<readonly MilestoneWithProgress[]> {
+  assertOrgScope(actor, orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId),
+    "Project",
+    projectId,
+  );
+  assertCan(actor, "project:read", projectResource(project));
+
+  const rows = await milestoneRepo.listMilestones(orgId, projectId);
+  const decorated = await Promise.all(rows.map((milestone) => decorate(orgId, milestone)));
+
+  return [...decorated].sort((a, b) => {
+    const openA = a.milestone.closedAt === null ? 0 : 1;
+    const openB = b.milestone.closedAt === null ? 0 : 1;
+    if (openA !== openB) return openA - openB;
+    const dateA = a.milestone.targetDate ?? "~";
+    const dateB = b.milestone.targetDate ?? "~";
+    if (dateA !== dateB) return dateA < dateB ? -1 : 1;
+    return a.milestone.createdAt < b.milestone.createdAt ? -1 : 1;
+  });
+}
+
+export async function getMilestone(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<MilestoneWithProgress> {
+  assertOrgScope(actor, orgId);
+
+  const milestone = requireFound(
+    await milestoneRepo.findMilestoneById(orgId, milestoneId),
+    "Milestone",
+    milestoneId,
+  );
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, milestone.projectId),
+    "Project",
+    milestone.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(project));
+
+  return decorate(orgId, milestone);
+}
+
+async function decorate(orgId: OrgId, milestone: Milestone): Promise<MilestoneWithProgress> {
+  const progress: MilestoneProgress = await issueRepo.countMilestoneProgress(orgId, milestone.id);
+  return { milestone, progress, overdue: isMilestoneOverdue(milestone, progress) };
+}
+
+async function loadForWrite(
+  actor: Actor,
+  orgId: OrgId,
+  milestoneId: MilestoneId,
+): Promise<{ milestone: Milestone; project: Project }> {
+  const milestone = requireFound(
+    await milestoneRepo.findMilestoneById(orgId, milestoneId),
+    "Milestone",
+    milestoneId,
+  );
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, milestone.projectId),
+    "Project",
+    milestone.projectId,
+  );
+  assertCan(actor, "project:update", projectResource(project));
+  assertNotArchived("Project", project.id, project);
+  return { milestone, project };
+}
+
+async function assertNameFree(
+  orgId: OrgId,
+  projectId: ProjectId,
+  name: string,
+  exceptId: MilestoneId | null,
+): Promise<void> {
+  const wanted = normaliseMilestoneName(name);
+  const siblings = await milestoneRepo.listMilestones(orgId, projectId);
+  const taken = siblings.some(
+    (row) => row.id !== exceptId && normaliseMilestoneName(row.name) === wanted,
+  );
+  if (taken) throw new MilestoneStateError(exceptId, "name_taken");
+}
+
+async function assertRoomForOpenMilestone(orgId: OrgId, projectId: ProjectId): Promise<void> {
+  const open = await milestoneRepo.countOpenMilestones(orgId, projectId);
+  if (open >= MAX_OPEN_MILESTONES_PER_PROJECT) {
+    throw new MilestoneStateError(null, "too_many_open");
+  }
+}

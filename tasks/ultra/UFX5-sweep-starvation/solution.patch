+/**
+ * One keyset page of live (not deleted) organization ids in id order, after
+ * `afterId`. The background sweeps walk every tenant with this; unlike the
+ * usage rollup's list it is neither bounded nor ordered by activity.
+ */
+export async function listLiveOrgIds(
+  afterId: OrgId | null,
+  limit: number,
+): Promise<readonly OrgId[]> {
+  const rows = getDb()
+    .select({ id: organizations.id })
+    .from(organizations)
+    .where(
+      and(
+        isNull(organizations.archivedAt),
+        afterId === null ? undefined : gt(organizations.id, afterId),
+      ),
+    )
+    .orderBy(asc(organizations.id))
+    .limit(Math.max(1, limit))
+    .all();
+
+  return rows.map((row) => row.id as OrgId);
+}

--- a/src/server/jobs/types.ts
+++ b/src/server/jobs/types.ts
@@ -1,8 +1,30 @@
 /**
  * Result envelope every job returns to the scheduler.
  */
+import * as orgRepo from "@/server/repositories/organization-repository";
 import { toIsoTimestamp } from "@/types/common";
-import type { IsoTimestamp } from "@/types/common";
+import type { IsoTimestamp, OrgId } from "@/types/common";
+
+/** Page size used while walking the tenant list. */
+const ORG_PAGE = 100;
+
+/**
+ * Visits every live organization once, in a stable order. The sweeps
+ * (overdue alerts, digests, retention) must reach every tenant on every run;
+ * only the usage rollup is deliberately bounded, and it has its own list.
+ */
+export async function forEachLiveOrg(
+  visit: (orgId: OrgId) => Promise<void>,
+): Promise<void> {
+  let after: OrgId | null = null;
+
+  for (;;) {
+    const page: readonly OrgId[] = await orgRepo.listLiveOrgIds(after, ORG_PAGE);
+    for (const orgId of page) await visit(orgId);
+    if (page.length < ORG_PAGE) return;
+    after = page[page.length - 1] ?? null;
+  }
+}
 

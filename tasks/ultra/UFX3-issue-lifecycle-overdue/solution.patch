+/**
+ * Every organization that has not been deleted, oldest first. Cross-tenant by
+ * design: background sweeps walk this list, whether or not the org has ever
+ * had its usage measured.
+ */
+export async function listActiveOrgIds(): Promise<readonly OrgId[]> {
+  const rows = getDb()
+    .select({ id: organizations.id })
+    .from(organizations)
+    .where(isNull(organizations.archivedAt))
+    .orderBy(asc(organizations.createdAt), asc(organizations.id))
+    .all();
+  return rows.map((row) => row.id as OrgId);
+}

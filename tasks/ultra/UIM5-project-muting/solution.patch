 /**
+ * Mutes one project for the acting member. Personal: it only changes what
+ * the actor receives. Idempotent.
+ */
+export async function muteProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<void> {
+  assertOrgScope(actor, orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId),
+    "Project",
+    projectId,
+  );
+  assertCan(actor, "project:read", projectResource(project));
+  await preferenceRepo.insertProjectMute(
+    orgId,
+    actor.userId,
+    project.id,
+    toIsoTimestamp(new Date()),
+  );
+}
+
+/** Lifts the actor's mute of one project. Idempotent. */
+export async function unmuteProject(
+  actor: Actor,
+  orgId: OrgId,
+  projectId: ProjectId,
+): Promise<void> {
+  assertOrgScope(actor, orgId);
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, projectId),
+    "Project",
+    projectId,
+  );
+  assertCan(actor, "project:read", projectResource(project));
+  await preferenceRepo.deleteProjectMute(orgId, actor.userId, project.id);
+}
+
+/** The projects the actor has muted in this org. */
+export async function listMutedProjectIds(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<readonly ProjectId[]> {
+  assertOrgScope(actor, orgId);
+  return preferenceRepo.listMutedProjectIds(orgId, actor.userId);
+}

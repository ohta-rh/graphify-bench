+
+/** Idempotent: muting an already-muted project keeps the original row. */
+export async function insertProjectMute(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+  at: IsoTimestamp,
+): Promise<void> {
+  getDb()
+    .insert(projectMutes)
+    .values({ orgId, userId, projectId, mutedAt: at })
+    .onConflictDoNothing()
+    .run();
+}
+
+export async function deleteProjectMute(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<void> {
+  getDb()
+    .delete(projectMutes)
+    .where(
+      and(
+        orgPredicate(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+        eq(projectMutes.projectId, projectId),
+      ),
+    )
+    .run();
+}
+
+/** The projects one member has muted in this org. */
+export async function listMutedProjectIds(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ProjectId[]> {
+  const rows = getDb()
+    .select({ projectId: projectMutes.projectId })
+    .from(projectMutes)
+    .where(
+      and(
+        orgPredicate(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+      ),
+    )
+    .all();
+  return rows.map((row) => brandId<ProjectId>(row.projectId));
+}
+
+export async function isProjectMuted(
+  orgId: OrgId,
+  userId: UserId,
+  projectId: ProjectId,
+): Promise<boolean> {
+  const row = getDb()
+    .select({ projectId: projectMutes.projectId })
+    .from(projectMutes)
+    .where(
+      and(
+        orgPredicate(projectMutes.orgId, orgId),
+        eq(projectMutes.userId, userId),
+        eq(projectMutes.projectId, projectId),
+      ),
+    )
+    .get();
+  return row !== undefined;
+}

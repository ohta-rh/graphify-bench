diff --git a/src/server/repositories/api-token-repository.ts b/src/server/repositories/api-token-repository.ts
new file mode 100644
index 0000000..be9a5e1
--- /dev/null
+++ b/src/server/repositories/api-token-repository.ts
@@ -0,0 +1,165 @@
+/**
+ * Personal API tokens. Everything is org-scoped except the lookup by hash,
+ * which is how an incoming request finds its token in the first place.
+ */
+import { and, count, desc, eq, gt, isNull } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { apiTokens, getDb } from "@/server/db";
+import { orgPredicate } from "./base-repository";
+import type { ApiTokenRow } from "@/server/db/schema/api-tokens";
+import type { ApiToken, ApiTokenScope } from "@/types/api-token";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+
+/** A stored token plus its hash, for the authentication path only. */
+export type StoredApiToken = ApiToken & { readonly tokenHash: string };
+
+function toApiToken(row: ApiTokenRow): ApiToken {
+  return {
+    id: row.id,
+    orgId: row.orgId as OrgId,
+    userId: row.userId as UserId,
+    name: row.name,
+    scope: row.scope,
+    prefix: row.prefix,
+    expiresAt: row.expiresAt as IsoTimestamp,
+    lastUsedAt: row.lastUsedAt as IsoTimestamp | null,
+    revokedAt: row.revokedAt as IsoTimestamp | null,
+    createdAt: row.createdAt as IsoTimestamp,
+  };
+}
+
+export async function insertApiToken(input: {
+  orgId: OrgId;
+  userId: UserId;
+  name: string;
+  scope: ApiTokenScope;
+  tokenHash: string;
+  prefix: string;
+  expiresAt: IsoTimestamp;
+  createdAt: IsoTimestamp;
+}): Promise<ApiToken> {
+  const row = getDb()
+    .insert(apiTokens)
+    .values({
+      id: newId(),
+      ...input,
+      lastUsedAt: null,
+      revokedAt: null,
+      updatedAt: input.createdAt,
+    })
+    .returning()
+    .get();
+  return toApiToken(row);
+}
+
+export async function findApiTokenById(
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .get();
+  return row ? toApiToken(row) : null;
+}
+
+export async function findApiTokenByHash(
+  tokenHash: string,
+): Promise<StoredApiToken | null> {
+  const row = getDb()
+    .select()
+    .from(apiTokens)
+    .where(eq(apiTokens.tokenHash, tokenHash))
+    .get();
+  return row ? { ...toApiToken(row), tokenHash: row.tokenHash } : null;
+}
+
+/** Newest first; ties on `created_at` fall back to the id. */
+export async function listApiTokensForUser(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly ApiToken[]> {
+  return getDb()
+    .select()
+    .from(apiTokens)
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.userId, userId)))
+    .orderBy(desc(apiTokens.createdAt), desc(apiTokens.id))
+    .all()
+    .map(toApiToken);
+}
+
+/** Tokens that could still authenticate at `now`: not revoked, not expired. */
+export async function countUsableApiTokens(
+  orgId: OrgId,
+  userId: UserId,
+  now: IsoTimestamp,
+): Promise<number> {
+  const row = getDb()
+    .select({ value: count() })
+    .from(apiTokens)
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.userId, userId),
+        isNull(apiTokens.revokedAt),
+        gt(apiTokens.expiresAt, now),
+      ),
+    )
+    .get();
+  return row?.value ?? 0;
+}
+
+export async function markRevoked(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<ApiToken> {
+  const row = getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at, updatedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.id, tokenId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .get();
+  if (!row) throw new Error(`API token ${tokenId} is not revocable`);
+  return toApiToken(row);
+}
+
+/** Revokes every not-yet-revoked token of `userId` in `orgId`. */
+export async function revokeAllForUser(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<readonly ApiToken[]> {
+  return getDb()
+    .update(apiTokens)
+    .set({ revokedAt: at, updatedAt: at })
+    .where(
+      and(
+        orgPredicate(apiTokens.orgId, orgId),
+        eq(apiTokens.userId, userId),
+        isNull(apiTokens.revokedAt),
+      ),
+    )
+    .returning()
+    .all()
+    .map(toApiToken);
+}
+
+export async function touchLastUsed(
+  orgId: OrgId,
+  tokenId: string,
+  at: IsoTimestamp,
+): Promise<void> {
+  getDb()
+    .update(apiTokens)
+    .set({ lastUsedAt: at, updatedAt: at })
+    .where(and(orgPredicate(apiTokens.orgId, orgId), eq(apiTokens.id, tokenId)))
+    .run();
+}

diff --git a/src/server/services/api-token-service.ts b/src/server/services/api-token-service.ts
new file mode 100644
index 0000000..116a079
--- /dev/null
+++ b/src/server/services/api-token-service.ts
@@ -0,0 +1,168 @@
+/**
+ * Personal API tokens: minting (shown once, stored hashed), listing,
+ * revocation, and turning a presented token back into an `Actor`.
+ *
+ * Must call (do not reimplement): assertCan, assertOrgScope, emit, subscribe, hashToken, resolveActor
+ */
+import { emit, subscribe } from "@/lib/event-bus";
+import { hashToken, randomToken } from "@/lib/hash";
+import { assertCan } from "@/lib/permissions";
+import { assertOrgScope } from "@/lib/tenant";
+import { createApiTokenSchema } from "@/schemas/api-token";
+import * as apiTokenRepo from "@/server/repositories/api-token-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import { toIsoTimestamp } from "@/types/common";
+import { actorEnvelope, envelope, orgResource, requireFound } from "./_support";
+import { resolveActor } from "./member-service";
+import type { CreateApiTokenInput } from "@/schemas/api-token";
+import type { ApiToken } from "@/types/api-token";
+import type { OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Actor } from "@/types/member";
+
+/** Tokens one user may hold per organization that can still authenticate. */
+export const MAX_USABLE_TOKENS = 5;
+
+const TOKEN_PREFIX = "tfk_";
+const DISPLAY_PREFIX_LENGTH = 12;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export async function createApiToken(
+  actor: Actor,
+  raw: CreateApiTokenInput,
+): Promise<{ token: string; apiToken: ApiToken }> {
+  const input = createApiTokenSchema.parse(raw);
+  assertOrgScope(actor, input.orgId);
+  if (input.scope === "write") {
+    assertCan(actor, "api_token:create_write", orgResource(input.orgId));
+  }
+
+  const now = new Date();
+  const stamp = toIsoTimestamp(now);
+  const usable = await apiTokenRepo.countUsableApiTokens(
+    input.orgId,
+    actor.userId,
+    stamp,
+  );
+  if (usable >= MAX_USABLE_TOKENS) {
+    throw new Error(
+      `At most ${MAX_USABLE_TOKENS} active API tokens per member; revoke one first`,
+    );
+  }
+
+  const token = `${TOKEN_PREFIX}${randomToken(24)}`;
+  const apiToken = await apiTokenRepo.insertApiToken({
+    orgId: input.orgId,
+    userId: actor.userId,
+    name: input.name,
+    scope: input.scope,
+    tokenHash: hashToken(token),
+    prefix: token.slice(0, DISPLAY_PREFIX_LENGTH),
+    expiresAt: toIsoTimestamp(new Date(now.getTime() + input.expiresInDays * DAY_MS)),
+    createdAt: stamp,
+  });
+
+  await emit("api_token.created", {
+    ...actorEnvelope(actor),
+    tokenId: apiToken.id,
+    userId: apiToken.userId,
+    name: apiToken.name,
+    scope: apiToken.scope,
+  });
+
+  return { token, apiToken };
+}
+
+export async function listApiTokens(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId = actor.userId,
+): Promise<readonly ApiToken[]> {
+  assertOrgScope(actor, orgId);
+  if (userId !== actor.userId) {
+    assertCan(actor, "api_token:manage", orgResource(orgId));
+  }
+  return apiTokenRepo.listApiTokensForUser(orgId, userId);
+}
+
+export async function revokeApiToken(
+  actor: Actor,
+  orgId: OrgId,
+  tokenId: string,
+): Promise<ApiToken> {
+  assertOrgScope(actor, orgId);
+
+  const token = requireFound(
+    await apiTokenRepo.findApiTokenById(orgId, tokenId),
+    "ApiToken",
+    tokenId,
+  );
+  if (token.userId !== actor.userId) {
+    assertCan(actor, "api_token:manage", orgResource(orgId));
+  }
+  if (token.revokedAt !== null) return token;
+
+  const revoked = await apiTokenRepo.markRevoked(
+    orgId,
+    token.id,
+    toIsoTimestamp(new Date()),
+  );
+
+  await emit("api_token.revoked", {
+    ...actorEnvelope(actor),
+    tokenId: revoked.id,
+    userId: revoked.userId,
+  });
+
+  return revoked;
+}
+
+/**
+ * The credential check for API requests. `null` for anything that must not
+ * authenticate; otherwise the actor the request runs as — read tokens are
+ * capped at `viewer`, write tokens carry the member's role as of now.
+ */
+export async function authenticateApiToken(token: string): Promise<Actor | null> {
+  if (!token.startsWith(TOKEN_PREFIX)) return null;
+
+  const stored = await apiTokenRepo.findApiTokenByHash(hashToken(token));
+  if (!stored) return null;
+
+  const now = toIsoTimestamp(new Date());
+  if (stored.revokedAt !== null || stored.expiresAt <= now) return null;
+
+  const org = await orgRepo.findOrgById(stored.orgId);
+  if (!org || org.archivedAt !== null) return null;
+
+  const member = await resolveActor(stored.userId, stored.orgId);
+  if (!member) return null;
+
+  await apiTokenRepo.touchLastUsed(stored.orgId, stored.id, now);
+
+  return {
+    userId: stored.userId,
+    orgId: stored.orgId,
+    role: stored.scope === "read" ? "viewer" : member.role,
+  };
+}
+
+/** A removed member's tokens die with the membership, in that org only. */
+export function registerApiTokenListeners(): Unsubscribe {
+  const off = subscribe("member.removed", async (payload) => {
+    const revoked = await apiTokenRepo.revokeAllForUser(
+      payload.orgId,
+      payload.userId,
+      toIsoTimestamp(new Date()),
+    );
+
+    for (const token of revoked) {
+      await emit("api_token.revoked", {
+        ...envelope(payload.orgId, payload.actorId),
+        tokenId: token.id,
+        userId: token.userId,
+      });
+    }
+  });
+
+  return off;
+}

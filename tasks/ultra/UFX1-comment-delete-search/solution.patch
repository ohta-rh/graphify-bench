+/** Calls `visit` for every row of a cursor-paged listing, page by page. */
+async function forEachRow<T>(
+  fetchPage: (cursor: string | null) => Promise<Page<T>>,
+  visit: (row: T) => Promise<void>,
+): Promise<void> {
+  let cursor: string | null = null;
+  do {
+    const page = await fetchPage(cursor);
+    for (const row of page.items) await visit(row);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+}
 

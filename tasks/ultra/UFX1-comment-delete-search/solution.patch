+/** Bulk form of `deleteSearchDocument` for one subject kind. */
+export async function deleteSearchDocuments(
+  orgId: OrgId,
+  subjectKind: SearchSubjectKind,
+  subjectIds: readonly string[],
+): Promise<void> {
+  if (subjectIds.length === 0) return;
+  getDb()
+    .delete(searchIndex)
+    .where(
+      and(
+        orgPredicate(searchIndex.orgId, orgId),
+        eq(searchIndex.subjectKind, subjectKind),
+        inArray(searchIndex.subjectId, [...subjectIds]),
+      ),
+    )
+    .run();
+}

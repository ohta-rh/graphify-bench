+/**
+ * Every comment id on one issue, deleted ones included — the search index
+ * keeps one document per comment and has to drop all of them when the issue
+ * leaves the index.
+ */
+export async function listCommentIdsForIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly CommentId[]> {
+  const rows = getDb()
+    .select({ id: comments.id })
+    .from(comments)
+    .where(
+      and(
+        orgPredicate(comments.orgId, orgId),
+        eq(comments.issueId, issueId),
+      ),
+    )
+    .all();
+  return rows.map((row) => row.id as CommentId);
 }
 

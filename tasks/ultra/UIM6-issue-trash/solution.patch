+
+/**
+ * Every issue archived at or before `cutoff`, across all projects. Unpaged on
+ * purpose: the retention sweep must see all of them, not the first page.
+ */
+export async function listArchivedIssuesBefore(
+  orgId: OrgId,
+  cutoff: IsoTimestamp,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(
+        orgPredicate(issues.orgId, orgId),
+        isNotNull(issues.archivedAt),
+        lte(issues.archivedAt, cutoff),
+      ),
+    )
+    .orderBy(issues.archivedAt)
+    .all();
+
+  return rows.map((row) => toIssue(row));
+}
+
+/** What a purge removed, so the caller can tidy the index and the counters. */
+export interface PurgedIssue {
+  readonly issueId: IssueId;
+  readonly commentIds: readonly string[];
+  readonly attachmentSizes: readonly number[];
+}
+
+/**
+ * Permanently deletes one issue with its label links, comments and
+ * attachments. The number it held is written to the project's sequence first
+ * so `nextIssueNumber` never hands it out again.
+ */
+export async function purgeIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<PurgedIssue | null> {
+  const db = getDb();
+  const row = db
+    .select()
+    .from(issues)
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+    .get();
+  if (!row) return null;
+
+  const commentRows = db
+    .select({ id: comments.id })
+    .from(comments)
+    .where(
+      and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)),
+    )
+    .all();
+  const attachmentRows = db
+    .select({ sizeBytes: attachments.sizeBytes })
+    .from(attachments)
+    .where(
+      and(
+        orgPredicate(attachments.orgId, orgId),
+        eq(attachments.issueId, issueId),
+      ),
+    )
+    .all();
+
+  db.transaction((tx) => {
+    tx.update(projects)
+      .set({
+        issueSequence: sql`max(${projects.issueSequence}, ${row.number})`,
+      })
+      .where(
+        and(
+          orgPredicate(projects.orgId, orgId),
+          eq(projects.id, row.projectId),
+        ),
+      )
+      .run();
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          eq(issueLabels.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(comments)
+      .where(
+        and(orgPredicate(comments.orgId, orgId), eq(comments.issueId, issueId)),
+      )
+      .run();
+    tx.delete(attachments)
+      .where(
+        and(
+          orgPredicate(attachments.orgId, orgId),
+          eq(attachments.issueId, issueId),
+        ),
+      )
+      .run();
+    tx.delete(issues)
+      .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+      .run();
+  });
+
+  return {
+    issueId,
+    commentIds: commentRows.map((comment) => comment.id),
+    attachmentSizes: attachmentRows.map((attachment) => attachment.sizeBytes),
+  };
+}

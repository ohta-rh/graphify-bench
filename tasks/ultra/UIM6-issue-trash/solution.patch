+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Takes an issue back out of the trash. Same permission as archiving it; the
+ * refusals are checked after `can()`: the issue must be archived, still
+ * inside the plan's retention window, in a live project, and the project must
+ * have room for it under the per-project issue quota.
+ */
+export async function restoreIssue(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<Issue> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "issue:archive", issueResource(issue));
+
+  if (issue.archivedAt === null) {
+    throw new RestoreRefusedError("Issue", issue.id, "not_archived");
+  }
+
+  const org = requireFound(
+    await orgRepo.findOrgById(orgId),
+    "Organization",
+    orgId,
+  );
+
+  const { retentionDays } = getPlanLimits(org.plan);
+  const archivedFor = Date.now() - new Date(issue.archivedAt).getTime();
+  if (archivedFor >= retentionDays * MS_PER_DAY) {
+    throw new RestoreRefusedError("Issue", issue.id, "expired");
+  }
+
+  const project = requireFound(
+    await projectRepo.findProjectById(orgId, issue.projectId),
+    "Project",
+    issue.projectId,
+  );
+  if (project.archivedAt !== null) {
+    throw new RestoreRefusedError("Issue", issue.id, "project_archived");
+  }
+
+  const used = await issueRepo.countIssues(orgId, issue.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used)) {
+    throw new RestoreRefusedError("Issue", issue.id, "quota");
+  }
+
+  const restored = await issueRepo.restoreIssue(orgId, issueId);
+
+  await emit("issue.restored", {
+    ...actorEnvelope(actor),
+    issueId: restored.id,
+    projectId: restored.projectId,
+  });
+
+  return restored;
+}

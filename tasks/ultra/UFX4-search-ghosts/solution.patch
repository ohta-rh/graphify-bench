+/** Rows read per page while walking an issue's comments or a project's issues. */
+const WALK_PAGE = 100;
+
+/*
+ * The searchability rule, applied by every writer below so that no caller —
+ * an event handler, the rebuild job, a reindex request — can put something
+ * into the index that the rule forbids:
+ *
+ *   a project is searchable while it is live;
+ *   an issue while it and its project are live;
+ *   a comment while it, its issue and that issue's project are live.
+ *
+ * Each writer upserts when the rule holds and removes the document when it
+ * does not, so calling one is always safe and always idempotent.
+ */
+
+async function isProjectLive(orgId: OrgId, projectId: Project["id"]): Promise<boolean> {
+  const project = await projectRepo.findProjectById(orgId, projectId);
+  return project !== null && project.archivedAt === null;
+}
+
+async function isIssueSearchable(orgId: OrgId, issue: Issue): Promise<boolean> {
+  return issue.archivedAt === null && (await isProjectLive(orgId, issue.projectId));
+}
+
+/** Every comment on an issue, deleted ones included, walking all pages. */
+async function commentsOf(
+  orgId: OrgId,
+  issueId: Issue["id"],
+  includeArchived: boolean,
+): Promise<readonly Comment[]> {
+  const out: Comment[] = [];
+  let cursor: string | null = null;
+  for (;;) {
+    const page = await commentRepo.listComments({
+      orgId,
+      issueId,
+      includeArchived,
+      limit: WALK_PAGE,
+      cursor,
+    });
+    out.push(...page.items);
+    if (page.nextCursor === null) return out;
+    cursor = page.nextCursor;
+  }
+}
+
+/** Every issue of a project, archived ones included, walking all pages. */
+async function issuesOf(orgId: OrgId, projectId: Project["id"]): Promise<readonly Issue[]> {
+  const out: Issue[] = [];
+  let cursor: string | null = null;
+  for (;;) {
+    const page = await issueRepo.listIssues({
+      orgId,
+      projectId,
+      includeArchived: true,
+      limit: WALK_PAGE,
+      cursor,
+    });
+    out.push(...page.items);
+    if (page.nextCursor === null) return out;
+    cursor = page.nextCursor;
+  }
+}

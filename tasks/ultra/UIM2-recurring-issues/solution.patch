diff --git a/src/server/jobs/recurring-issue-job.ts b/src/server/jobs/recurring-issue-job.ts
new file mode 100644
index 0000000..08e94dc
--- /dev/null
+++ b/src/server/jobs/recurring-issue-job.ts
@@ -0,0 +1,71 @@
+/**
+ * Files the issue for each recurring-issue rule's latest started occurrence.
+ * Missed occurrences are never back-filled; re-running is a no-op.
+ *
+ * Must call (do not reimplement): createIssue, resolveActor, can
+ */
+import { createLogger } from "@/lib/logger";
+import { can } from "@/lib/permissions";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { projectResource } from "@/server/services/_support";
+import { createIssue } from "@/server/services/issue-service";
+import { resolveActor } from "@/server/services/member-service";
+import { latestOccurrenceOn } from "@/server/services/recurring-issue-service";
+import { runJob } from "./types";
+import type { JobResult } from "./types";
+
+const logger = createLogger("recurring-issue-job");
+
+export async function runRecurringIssueJob(now: Date): Promise<JobResult> {
+  return runJob("recurring-issues", async (result) => {
+    for (const rule of await recurringRepo.listRunnableRecurringIssues()) {
+      const occurrence = latestOccurrenceOn(rule, now);
+      if (occurrence === null) continue;
+      if (rule.lastOccurrenceOn !== null && occurrence <= rule.lastOccurrenceOn) {
+        continue;
+      }
+
+      const project = await projectRepo.findProjectById(rule.orgId, rule.projectId);
+      if (!project || project.archivedAt !== null) continue;
+
+      const actor = await resolveActor(rule.createdBy, rule.orgId);
+      if (!actor || !can(actor, "issue:create", projectResource(project))) {
+        await recurringRepo.setRecurringIssuePaused(rule.orgId, rule.id, true);
+        continue;
+      }
+
+      const assignee =
+        rule.assigneeId === null
+          ? null
+          : await memberRepo.findMember(rule.orgId, rule.assigneeId);
+
+      try {
+        await createIssue(actor, {
+          orgId: rule.orgId,
+          projectId: rule.projectId,
+          title: `${rule.title} (${occurrence})`,
+          description: null,
+          status: "backlog",
+          priority: rule.priority,
+          assigneeId: assignee && assignee.status === "active" ? assignee.userId : null,
+          parentId: null,
+          estimate: null,
+          dueAt: null,
+          labelIds: [],
+        });
+      } catch (error) {
+        result.failed += 1;
+        logger.warn("recurring issue not created", {
+          recurringIssueId: rule.id,
+          reason: error instanceof Error ? error.message : String(error),
+        });
+        continue;
+      }
+
+      await recurringRepo.markOccurrence(rule.orgId, rule.id, occurrence);
+      result.processed += 1;
+    }
+  });
+}

+import { z } from "zod";
+import { isCalendarDate, isValidTimeZone } from "@/lib/date";
+import { issuePrioritySchema } from "./issue";
+import { orgIdSchema, projectIdSchema, userIdSchema } from "./common";
+
+export const recurrenceCadenceSchema = z.enum(["daily", "weekly"]);
+
+export const createRecurringIssueSchema = z
+  .object({
+    orgId: orgIdSchema,
+    projectId: projectIdSchema,
+    title: z.string().min(3).max(180),
+    priority: issuePrioritySchema.default("none"),
+    assigneeId: userIdSchema.nullable().default(null),
+    cadence: recurrenceCadenceSchema,
+    weekday: z.number().int().min(1).max(7).nullable().default(null),
+    timezone: z.string().refine(isValidTimeZone, "must be an IANA time zone"),
+    startsOn: z.string().refine(isCalendarDate, "must be a YYYY-MM-DD date"),
+  })
+  .refine(
+    (input) => (input.cadence === "weekly") === (input.weekday !== null),
+    { message: "weekday is required for weekly rules and only for them", path: ["weekday"] },
+  );
+
+export const setRecurringIssuePausedSchema = z.object({
+  orgId: orgIdSchema,
+  recurringIssueId: z.string().min(1),
+  paused: z.boolean(),
+});
+
+export type CreateRecurringIssueInput = z.input<typeof createRecurringIssueSchema>;
+export type SetRecurringIssuePausedInput = z.infer<typeof setRecurringIssuePausedSchema>;

+import type {
+  OrgId,
+  ProjectId,
+  TenantScoped,
+  Timestamps,
+  UserId,
+} from "./common";
+import type { IssuePriority } from "./issue";
+
+export type RecurrenceCadence = "daily" | "weekly";
+
+/**
+ * A rule that files one issue per occurrence. Occurrences are calendar days
+ * (`YYYY-MM-DD`) in the rule's own IANA time zone.
+ */
+export interface RecurringIssue extends Timestamps, TenantScoped {
+  readonly id: string;
+  readonly orgId: OrgId;
+  readonly projectId: ProjectId;
+  readonly title: string;
+  readonly priority: IssuePriority;
+  readonly assigneeId: UserId | null;
+  readonly cadence: RecurrenceCadence;
+  /** ISO weekday, 1 = Monday … 7 = Sunday; `null` for daily rules. */
+  readonly weekday: number | null;
+  readonly timezone: string;
+  readonly startsOn: string;
+  readonly lastOccurrenceOn: string | null;
+  readonly paused: boolean;
+  readonly createdBy: UserId;
+}

diff --git a/src/server/repositories/recurring-issue-repository.ts b/src/server/repositories/recurring-issue-repository.ts
new file mode 100644
index 0000000..cb3adb1
--- /dev/null
+++ b/src/server/repositories/recurring-issue-repository.ts
@@ -0,0 +1,139 @@
+/**
+ * Recurring-issue rules. Reads are org-scoped except the job's sweep, which
+ * walks every organization's runnable rules.
+ */
+import { and, asc, count, eq } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, recurringIssues } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import type { RecurringIssueRow } from "@/server/db/schema/recurring-issues";
+import type { IsoTimestamp, OrgId, ProjectId, UserId } from "@/types/common";
+import type { IssuePriority } from "@/types/issue";
+import type { RecurrenceCadence, RecurringIssue } from "@/types/recurring-issue";
+
+export type NewRecurringIssue = {
+  orgId: OrgId;
+  projectId: ProjectId;
+  title: string;
+  priority: IssuePriority;
+  assigneeId: UserId | null;
+  cadence: RecurrenceCadence;
+  weekday: number | null;
+  timezone: string;
+  startsOn: string;
+};
+
+function toRecurringIssue(row: RecurringIssueRow): RecurringIssue {
+  return {
+    id: row.id,
+    orgId: row.orgId as OrgId,
+    projectId: row.projectId as ProjectId,
+    title: row.title,
+    priority: row.priority,
+    assigneeId: row.assigneeId === null ? null : (row.assigneeId as UserId),
+    cadence: row.cadence,
+    weekday: row.weekday,
+    timezone: row.timezone,
+    startsOn: row.startsOn,
+    lastOccurrenceOn: row.lastOccurrenceOn,
+    paused: row.paused,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IsoTimestamp,
+    updatedAt: row.updatedAt as IsoTimestamp,
+  };
+}
+
+export async function insertRecurringIssue(
+  input: NewRecurringIssue,
+  createdBy: UserId,
+): Promise<RecurringIssue> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(recurringIssues)
+    .values({
+      id: newId(),
+      ...input,
+      lastOccurrenceOn: null,
+      paused: false,
+      createdBy,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .returning()
+    .get();
+  return toRecurringIssue(row);
+}
+
+export async function findRecurringIssueById(
+  orgId: OrgId,
+  id: string,
+): Promise<RecurringIssue | null> {
+  const row = getDb()
+    .select()
+    .from(recurringIssues)
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id)))
+    .get();
+  return row ? toRecurringIssue(row) : null;
+}
+
+export async function listRecurringIssues(
+  orgId: OrgId,
+): Promise<readonly RecurringIssue[]> {
+  return getDb()
+    .select()
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all()
+    .map(toRecurringIssue);
+}
+
+export async function countRecurringIssues(orgId: OrgId): Promise<number> {
+  const row = getDb()
+    .select({ value: count() })
+    .from(recurringIssues)
+    .where(orgPredicate(recurringIssues.orgId, orgId))
+    .get();
+  return row?.value ?? 0;
+}
+
+/** Every rule that is not paused, across organizations — the job's sweep. */
+export async function listRunnableRecurringIssues(): Promise<
+  readonly RecurringIssue[]
+> {
+  return getDb()
+    .select()
+    .from(recurringIssues)
+    .where(eq(recurringIssues.paused, false))
+    .orderBy(asc(recurringIssues.createdAt), asc(recurringIssues.id))
+    .all()
+    .map(toRecurringIssue);
+}
+
+export async function setRecurringIssuePaused(
+  orgId: OrgId,
+  id: string,
+  paused: boolean,
+): Promise<RecurringIssue> {
+  const row = getDb()
+    .update(recurringIssues)
+    .set({ paused, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id)))
+    .returning()
+    .get();
+  if (!row) throw new Error(`Recurring issue ${id} not found`);
+  return toRecurringIssue(row);
+}
+
+export async function markOccurrence(
+  orgId: OrgId,
+  id: string,
+  occurrence: string,
+): Promise<void> {
+  getDb()
+    .update(recurringIssues)
+    .set({ lastOccurrenceOn: occurrence, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(recurringIssues.orgId, orgId), eq(recurringIssues.id, id)))
+    .run();
+}
diff --git a/src/server/services/recurring-issue-service.ts b/src/server/services/recurring-issue-service.ts
new file mode 100644
index 0000000..d31eb35
--- /dev/null
+++ b/src/server/services/recurring-issue-service.ts
@@ -0,0 +1,124 @@
+/**
+ * Recurring-issue rules: creation under the plan's rule quota, pausing, and
+ * the occurrence arithmetic the recurring-issue job runs on.
+ *
+ * Must call (do not reimplement): assertCan, assertOrgScope, assertNotArchived, getPlanLimits
+ */
+import { getPlanLimits } from "@/config/plan-limits";
+import { addCalendarDays, calendarDateIn, isoWeekday } from "@/lib/date";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import {
+  createRecurringIssueSchema,
+  setRecurringIssuePausedSchema,
+} from "@/schemas/recurring-issue";
+import * as memberRepo from "@/server/repositories/member-repository";
+import * as orgRepo from "@/server/repositories/organization-repository";
+import * as projectRepo from "@/server/repositories/project-repository";
+import * as recurringRepo from "@/server/repositories/recurring-issue-repository";
+import { orgResource, projectResource, requireFound } from "./_support";
+import type {
+  CreateRecurringIssueInput,
+  SetRecurringIssuePausedInput,
+} from "@/schemas/recurring-issue";
+import type { OrgId } from "@/types/common";
+import type { Actor } from "@/types/member";
+import type { RecurringIssue } from "@/types/recurring-issue";
+
+export async function createRecurringIssue(
+  actor: Actor,
+  raw: CreateRecurringIssueInput,
+): Promise<RecurringIssue> {
+  const input = createRecurringIssueSchema.parse(raw);
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  if (input.assigneeId !== null) {
+    const assignee = await memberRepo.findMember(input.orgId, input.assigneeId);
+    if (!assignee || assignee.status !== "active") {
+      throw new Error("The assignee must be an active member of the organization");
+    }
+  }
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await recurringRepo.countRecurringIssues(input.orgId);
+  if (used + 1 > getPlanLimits(org.plan).recurringIssues) {
+    throw new Error(`Plan ${org.plan} allows no more recurring issues`);
+  }
+
+  return recurringRepo.insertRecurringIssue(
+    {
+      orgId: input.orgId,
+      projectId: input.projectId,
+      title: input.title,
+      priority: input.priority,
+      assigneeId: input.assigneeId,
+      cadence: input.cadence,
+      weekday: input.weekday,
+      timezone: input.timezone,
+      startsOn: input.startsOn,
+    },
+    actor.userId,
+  );
+}
+
+export async function setRecurringIssuePaused(
+  actor: Actor,
+  raw: SetRecurringIssuePausedInput,
+): Promise<RecurringIssue> {
+  const input = setRecurringIssuePausedSchema.parse(raw);
+  assertOrgScope(actor, input.orgId);
+
+  const rule = requireFound(
+    await recurringRepo.findRecurringIssueById(input.orgId, input.recurringIssueId),
+    "RecurringIssue",
+    input.recurringIssueId,
+  );
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, rule.projectId),
+    "Project",
+    rule.projectId,
+  );
+  assertCan(actor, "issue:create", projectResource(project));
+
+  return recurringRepo.setRecurringIssuePaused(input.orgId, rule.id, input.paused);
+}
+
+export async function listRecurringIssues(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<readonly RecurringIssue[]> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "issue:read", orgResource(orgId));
+  return recurringRepo.listRecurringIssues(orgId);
+}
+
+/**
+ * The most recent occurrence day that has started by `now` in the rule's
+ * time zone, or `null` when the rule has no started occurrence yet.
+ */
+export function latestOccurrenceOn(
+  rule: Pick<RecurringIssue, "cadence" | "weekday" | "timezone" | "startsOn">,
+  now: Date,
+): string | null {
+  const today = calendarDateIn(rule.timezone, now);
+  if (today < rule.startsOn) return null;
+  if (rule.cadence === "daily") return today;
+
+  const weekday = rule.weekday ?? 1;
+  const back = (isoWeekday(today) - weekday + 7) % 7;
+  const occurrence = addCalendarDays(today, -back);
+  return occurrence < rule.startsOn ? null : occurrence;
+}

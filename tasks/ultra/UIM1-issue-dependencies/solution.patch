diff --git a/src/server/services/issue-dependency-service.ts b/src/server/services/issue-dependency-service.ts
new file mode 100644
index 0000000..d0f0bef
--- /dev/null
+++ b/src/server/services/issue-dependency-service.ts
@@ -0,0 +1,214 @@
+/**
+ * "Blocked by" links between issues: who may add them, the no-cycle rule,
+ * the completion gate and the "your issue is unblocked" notification.
+ *
+ * Must call (do not reimplement): assertCan, assertOrgScope, assertNotArchived, subscribe, notify
+ */
+import { subscribe } from "@/lib/event-bus";
+import { assertCan } from "@/lib/permissions";
+import { assertNotArchived, isArchived } from "@/lib/soft-delete";
+import { assertOrgScope } from "@/lib/tenant";
+import * as dependencyRepo from "@/server/repositories/issue-dependency-repository";
+import * as issueRepo from "@/server/repositories/issue-repository";
+import { CLOSED_ISSUE_STATUSES } from "@/types/issue";
+import { issueResource, requireFound } from "./_support";
+import { notify } from "./notification-service";
+import type { IssueId, OrgId, UserId } from "@/types/common";
+import type { Unsubscribe } from "@/types/event";
+import type { Issue, IssueDependency, IssueStatus } from "@/types/issue";
+import type { Actor } from "@/types/member";
+
+export type IssueDependencyInput = {
+  orgId: OrgId;
+  issueId: IssueId;
+  blockerId: IssueId;
+};
+
+/** Raised when an issue is moved to `done` while open blockers remain. */
+export class IssueBlockedError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(
+    readonly issueId: IssueId,
+    readonly blockerIds: readonly IssueId[],
+  ) {
+    super(`Issue ${issueId} is blocked by ${blockerIds.length} open issue(s)`);
+    this.name = "IssueBlockedError";
+  }
+}
+
+function isClosedStatus(status: IssueStatus): boolean {
+  return CLOSED_ISSUE_STATUSES.includes(status);
+}
+
+/** A blocker holds its dependants back while it is live and not closed. */
+function isOpen(issue: Issue): boolean {
+  return !isArchived(issue) && !isClosedStatus(issue.status);
+}
+
+/** The blockers of `issueId` that are still open. */
+export async function openBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  const open: IssueId[] = [];
+  for (const blockerId of await dependencyRepo.listBlockerIds(orgId, issueId)) {
+    const blocker = await issueRepo.findIssueById(orgId, blockerId);
+    if (blocker && isOpen(blocker)) open.push(blocker.id);
+  }
+  return open;
+}
+
+/** Throws `IssueBlockedError` when `issueId` still has open blockers. */
+export async function assertNotBlocked(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<void> {
+  const open = await openBlockerIds(orgId, issueId);
+  if (open.length > 0) throw new IssueBlockedError(issueId, open);
+}
+
+export async function addBlocker(
+  actor: Actor,
+  input: IssueDependencyInput,
+): Promise<IssueDependency> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  const blocker = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.blockerId),
+    "Issue",
+    input.blockerId,
+  );
+  assertCan(actor, "issue:update", issueResource(issue));
+
+  if (issue.id === blocker.id) {
+    throw new Error("An issue cannot block itself");
+  }
+  assertNotArchived("Issue", issue.id, issue);
+  assertNotArchived("Issue", blocker.id, blocker);
+
+  const existing = await dependencyRepo.findDependency(
+    input.orgId,
+    issue.id,
+    blocker.id,
+  );
+  if (existing) return existing;
+
+  if (await isBlockedTransitively(input.orgId, blocker.id, issue.id)) {
+    throw new Error("Adding this blocker would create a dependency cycle");
+  }
+
+  return dependencyRepo.insertDependency(
+    input.orgId,
+    issue.id,
+    blocker.id,
+    actor.userId,
+  );
+}
+
+export async function removeBlocker(
+  actor: Actor,
+  input: IssueDependencyInput,
+): Promise<boolean> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  assertCan(actor, "issue:update", issueResource(issue));
+
+  return dependencyRepo.deleteDependency(input.orgId, issue.id, input.blockerId);
+}
+
+export async function listBlockers(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly Issue[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "issue:read", issueResource(issue));
+
+  const blockers: Issue[] = [];
+  for (const blockerId of await dependencyRepo.listBlockerIds(orgId, issue.id)) {
+    const blocker = await issueRepo.findIssueById(orgId, blockerId);
+    if (blocker && !isArchived(blocker)) blockers.push(blocker);
+  }
+
+  return blockers.sort((a, b) =>
+    a.number !== b.number ? a.number - b.number : a.id < b.id ? -1 : 1,
+  );
+}
+
+/** True when `from` is blocked, directly or through a chain, by `target`. */
+async function isBlockedTransitively(
+  orgId: OrgId,
+  from: IssueId,
+  target: IssueId,
+): Promise<boolean> {
+  const seen = new Set<IssueId>();
+  const queue: IssueId[] = [from];
+
+  while (queue.length > 0) {
+    const current = queue.shift() as IssueId;
+    if (current === target) return true;
+    if (seen.has(current)) continue;
+    seen.add(current);
+    queue.push(...(await dependencyRepo.listBlockerIds(orgId, current)));
+  }
+
+  return false;
+}
+
+/**
+ * `blockerId` just went from open to closed: tell the assignee of every
+ * dependant that has no open blocker left.
+ */
+async function announceUnblocked(
+  orgId: OrgId,
+  blockerId: IssueId,
+  actorId: UserId | null,
+): Promise<void> {
+  for (const blockedId of await dependencyRepo.listBlockedIds(orgId, blockerId)) {
+    const blocked = await issueRepo.findIssueById(orgId, blockedId);
+    if (!blocked || !isOpen(blocked) || blocked.assigneeId === null) continue;
+    if ((await openBlockerIds(orgId, blocked.id)).length > 0) continue;
+
+    await notify(orgId, "issue_unblocked", [blocked.assigneeId], {
+      title: "An issue you are assigned to is unblocked",
+      body: `Issue ${blocked.id} has no open blockers left`,
+      href: `/issues/${blocked.id}`,
+      actorId,
+    });
+  }
+}
+
+export function registerDependencyListeners(): Unsubscribe {
+  const offs: Unsubscribe[] = [
+    subscribe("issue.status_changed", async (payload) => {
+      if (isClosedStatus(payload.from) || !isClosedStatus(payload.to)) return;
+      await announceUnblocked(payload.orgId, payload.issueId, payload.actorId);
+    }),
+    subscribe("issue.archived", async (payload) => {
+      const issue = await issueRepo.findIssueById(payload.orgId, payload.issueId);
+      if (!issue || isClosedStatus(issue.status)) return;
+      await announceUnblocked(payload.orgId, payload.issueId, payload.actorId);
+    }),
+  ];
+
+  return () => {
+    for (const off of offs) off();
+  };
+}

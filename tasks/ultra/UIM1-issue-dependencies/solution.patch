diff --git a/src/server/repositories/issue-dependency-repository.ts b/src/server/repositories/issue-dependency-repository.ts
new file mode 100644
index 0000000..bd88bb8
--- /dev/null
+++ b/src/server/repositories/issue-dependency-repository.ts
@@ -0,0 +1,117 @@
+/**
+ * "Blocked by" links between issues. Every read and write is org-scoped.
+ */
+import { and, eq } from "drizzle-orm";
+import { getDb, issueDependencies } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import type { IssueDependencyRow } from "@/server/db/schema/issues";
+import type { IsoTimestamp, IssueId, OrgId, UserId } from "@/types/common";
+import type { IssueDependency } from "@/types/issue";
+
+function toDependency(row: IssueDependencyRow): IssueDependency {
+  return {
+    orgId: row.orgId as OrgId,
+    issueId: row.issueId as IssueId,
+    blockerId: row.blockerId as IssueId,
+    createdBy: row.createdBy as UserId,
+    createdAt: row.createdAt as IsoTimestamp,
+  };
+}
+
+export async function findDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<IssueDependency | null> {
+  const row = getDb()
+    .select()
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .get();
+  return row ? toDependency(row) : null;
+}
+
+export async function insertDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+  createdBy: UserId,
+): Promise<IssueDependency> {
+  getDb()
+    .insert(issueDependencies)
+    .values({
+      orgId,
+      issueId,
+      blockerId,
+      createdBy,
+      createdAt: toIsoTimestamp(new Date()),
+    })
+    .onConflictDoNothing()
+    .run();
+
+  const row = await findDependency(orgId, issueId, blockerId);
+  if (!row) throw new Error(`Dependency ${issueId} <- ${blockerId} not stored`);
+  return row;
+}
+
+export async function deleteDependency(
+  orgId: OrgId,
+  issueId: IssueId,
+  blockerId: IssueId,
+): Promise<boolean> {
+  const rows = getDb()
+    .delete(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .returning({ issueId: issueDependencies.issueId })
+    .all();
+  return rows.length > 0;
+}
+
+/** Ids of the issues that block `issueId`. */
+export async function listBlockerIds(
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb()
+    .select({ id: issueDependencies.blockerId })
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.issueId, issueId),
+      ),
+    )
+    .all()
+    .map((row) => row.id as IssueId);
+}
+
+/** Ids of the issues that `blockerId` blocks. */
+export async function listBlockedIds(
+  orgId: OrgId,
+  blockerId: IssueId,
+): Promise<readonly IssueId[]> {
+  return getDb()
+    .select({ id: issueDependencies.issueId })
+    .from(issueDependencies)
+    .where(
+      and(
+        orgPredicate(issueDependencies.orgId, orgId),
+        eq(issueDependencies.blockerId, blockerId),
+      ),
+    )
+    .all()
+    .map((row) => row.id as IssueId);
+}

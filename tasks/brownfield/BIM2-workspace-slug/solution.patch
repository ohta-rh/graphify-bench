+/**
+ * The one rule for turning a slug into a workspace (ADR 0005 §3): the current
+ * slug of a live workspace, or a slug a live workspace retired less than
+ * `ORG_SLUG_HOLD_DAYS` ago. Every lookup by slug — the session layer included
+ * — goes through here.
+ */
+export async function resolveOrgSlug(
+  slug: string,
+  now: IsoTimestamp = toIsoTimestamp(new Date()),
+): Promise<Organization | null> {
+  const current = await findOrgBySlug(slug);
+  if (current) return current;
+
+  const retired = getDb()
+    .select({ org: organizations, retiredAt: organizationSlugHistory.retiredAt })
+    .from(organizationSlugHistory)
+    .innerJoin(organizations, eq(organizations.id, organizationSlugHistory.orgId))
+    .where(
+      and(eq(organizationSlugHistory.slug, slug), isNull(organizations.archivedAt)),
+    )
+    .all();
+
+  const held = retired.find((row) => stillHeld(row.retiredAt as IsoTimestamp, now));
+  return held ? toOrganization(held.org) : null;
+}
+
+/**
+ * Whether `orgId` may take `slug` (ADR 0005 §2): no other workspace, live or
+ * deleted, holds it now, and no other workspace retired it within the hold.
+ * A workspace's own retired slugs are available to it.
+ */
+export async function isSlugAvailableFor(
+  orgId: OrgId,
+  slug: string,
+  now: IsoTimestamp = toIsoTimestamp(new Date()),
+): Promise<boolean> {
+  const db = getDb();
+
+  const current = db
+    .select({ id: organizations.id })
+    .from(organizations)
+    .where(and(eq(organizations.slug, slug), ne(organizations.id, orgId)))
+    .get();
+  if (current) return false;
+
+  const retired = db
+    .select({ orgId: organizationSlugHistory.orgId, retiredAt: organizationSlugHistory.retiredAt })
+    .from(organizationSlugHistory)
+    .where(and(eq(organizationSlugHistory.slug, slug), ne(organizationSlugHistory.orgId, orgId)))
+    .all();
+
+  return !retired.some((row) => stillHeld(row.retiredAt as IsoTimestamp, now));
+}

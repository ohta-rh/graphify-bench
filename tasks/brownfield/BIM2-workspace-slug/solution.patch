 /**
+ * Changes the workspace's URL slug (ADR 0005). The slug is chosen, so it is
+ * validated and must be available — refused, never suffixed. The old slug is
+ * retired for `ORG_SLUG_HOLD_DAYS`: it keeps resolving to this workspace and
+ * nobody else can take it. One event and one audit entry; nothing else on the
+ * workspace changes.
+ */
+export async function renameOrganizationSlug(
+  actor: Actor,
+  input: RenameOrganizationSlugInput,
+): Promise<Organization> {
+  assertOrgScope(actor, input.orgId);
+  assertCan(actor, "org:update", orgResource(input.orgId));
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+
+  assertValidSlug(input.slug);
+  if (org.slug === input.slug) return org;
+
+  const now = toIsoTimestamp(new Date());
+  if (!(await orgRepo.isSlugAvailableFor(org.id, input.slug, now))) {
+    throw new InvalidSlugError(input.slug, "is not available");
+  }
+
+  const renamed = await orgRepo.renameOrgSlug(org.id, input.slug, now);
+
+  await emit("organization.slug_changed", {
+    ...actorEnvelope(actor),
+    from: org.slug,
+    to: renamed.slug,
+  });
+
+  return renamed;
+}

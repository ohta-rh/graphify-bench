+/**
+ * Account-creation rules shared by sign-up and the user repository (ADR 0003).
+ *
+ * Email addresses are case-insensitive; the first workspace's name and URL
+ * slug are derived from the display name, and the derivation never fails.
+ */
+import { WORKSPACE_NAME_MAX_LENGTH } from "@/config/constants";
+import { SLUG_MIN_LENGTH, slugify, uniqueSlug } from "@/lib/slug";
+
+/** The slug used when nothing usable can be derived from a display name. */
+export const WORKSPACE_SLUG_FALLBACK = "workspace";
+
+/** The suffix every first workspace's name ends in. */
+export const WORKSPACE_NAME_SUFFIX = "'s workspace";
+
+/** Addresses are stored and compared lowercased, whatever was typed. */
+export function normaliseEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+/** Thrown by sign-up when the address already has an account. */
+export class EmailAlreadyRegisteredError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(readonly email: string) {
+    super("An account with that email already exists.");
+    this.name = "EmailAlreadyRegisteredError";
+  }
+}
+
+/**
+ * `<name>'s workspace`, shortened from the display-name side until the whole
+ * name fits the limit the workspace schema enforces, so the result always
+ * ends in the suffix.
+ */
+export function workspaceNameFor(displayName: string): string {
+  const trimmed = displayName.trim();
+  const room = Math.max(1, WORKSPACE_NAME_MAX_LENGTH - WORKSPACE_NAME_SUFFIX.length);
+  const head = trimmed.length > room ? trimmed.slice(0, room).trimEnd() : trimmed;
+  return `${head}${WORKSPACE_NAME_SUFFIX}`;
+}
+
+/**
+ * Derives the first workspace's slug from the display name: slugified, then
+ * made unique and non-reserved the way every derived slug is. A result
+ * shorter than the minimum length, or empty, falls back to `workspace`.
+ * Never throws, so a name can never refuse a sign-up.
+ */
+export function deriveWorkspaceSlug(
+  displayName: string,
+  taken: Iterable<string>,
+): string {
+  return uniqueSlug(workspaceSlugBase(displayName), taken);
+}
+
+/**
+ * The slug a display name derives before uniqueness is applied — what a
+ * repository should list taken slugs for.
+ */
+export function workspaceSlugBase(displayName: string): string {
+  const base = slugify(displayName);
+  return base.length >= SLUG_MIN_LENGTH ? base : WORKSPACE_SLUG_FALLBACK;
+}

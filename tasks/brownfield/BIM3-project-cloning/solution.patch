+/**
+ * Clones a project (ADR 0012): a new project with the chosen name, slug and
+ * key, the source's description, visibility, colour and lead, and — when asked
+ * — a fresh-start copy of every live issue, numbered from 1 in source order.
+ * Gated like a creation, as a batch: nothing is written unless the project
+ * quota and the per-project issue quota admit the whole clone. One
+ * `project.cloned` is published; the clone is indexed and metered directly.
+ */
+export async function cloneProject(
+  actor: Actor,
+  input: CloneProjectInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const source = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:read", projectResource(source));
+  assertCan(actor, "project:create", orgResource(input.orgId));
+  assertNotArchived("Project", source.id, source);
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+
+  const usedProjects = await projectRepo.countProjects(input.orgId);
+  if (wouldExceedLimit(org.plan, "projects", usedProjects)) {
+    throw new Error(
+      `Plan ${org.plan} allows ${usedProjects} projects; upgrade to add another`,
+    );
+  }
+
+  const originals: readonly Issue[] = input.includeIssues
+    ? await issueRepo.listLiveIssuesForProject(input.orgId, source.id)
+    : [];
+  if (
+    originals.length > 0 &&
+    wouldExceedLimit(org.plan, "issuesPerProject", 0, originals.length)
+  ) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${input.key}`,
+    );
+  }
+
+  const slug = await suggestProjectSlug(input.orgId, input.slug);
+  const project = await projectRepo.insertProject({
+    orgId: input.orgId,
+    name: input.name,
+    slug,
+    key: input.key,
+    description: source.description,
+    visibility: source.visibility,
+    leadId: source.leadId,
+    color: source.color,
+    targetDate: null,
+  });
+
+  const status = defaultIssueStatusOf(org.settings.defaultIssueStatus);
+  const copies: Issue[] = [];
+  for (const original of originals) {
+    const copy = await issueRepo.insertIssue(
+      {
+        orgId: input.orgId,
+        projectId: project.id,
+        title: original.title,
+        description: original.description,
+        status,
+        priority: original.priority,
+        assigneeId: null,
+        parentId: null,
+        estimate: original.estimate,
+        dueAt: original.dueAt,
+        labelIds: [...original.labelIds],
+      },
+      actor.userId,
+      copies.length + 1,
+    );
+    copies.push(copy);
+  }
+
+  // No per-issue announcements for a batch (ADR 0012 §6): index and meter
+  // the clone directly instead of through the event listeners.
+  await indexProject(input.orgId, project);
+  for (const copy of copies) await indexIssue(input.orgId, copy);
+  await recomputeUsage(input.orgId);
+
+  await emit("project.cloned", {
+    ...actorEnvelope(actor),
+    projectId: project.id,
+    sourceProjectId: source.id,
+    issuesCopied: copies.length,
+  });
+
+  return project;
+}
+
+/** The workspace setting is stored as text; fall back to the schema default. */
+function defaultIssueStatusOf(value: string): IssueStatus {
+  return ISSUE_STATUSES.includes(value as IssueStatus) ? (value as IssueStatus) : "backlog";
+}

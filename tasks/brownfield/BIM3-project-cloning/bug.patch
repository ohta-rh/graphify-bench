+/**
+ * Row-level duplicate used by the ops console's "duplicate project" action.
+ * Copies the project exactly as it is — status, dates, archive state — under
+ * the new name, slug and key; the console renumbers nothing.
+ */
+export async function duplicateProject(
+  orgId: OrgId,
+  projectId: ProjectId,
+  name: string,
+  slug: string,
+  key: string,
+): Promise<Project> {
+  const source = getDb()
+    .select()
+    .from(projects)
+    .where(and(orgPredicate(projects.orgId, orgId), eq(projects.id, projectId)))
+    .get();
+  if (!source) throw new Error(`Project ${projectId} not found`);
+
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(projects)
+    .values({
+      ...source,
+      id: newId(),
+      name,
+      slug,
+      key,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .returning()
+    .get();
+
+  return toProject(row);
+}

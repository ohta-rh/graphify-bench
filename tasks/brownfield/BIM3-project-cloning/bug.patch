+/**
+ * Copies a project's issues into another project, row for row, for the ops
+ * console's "duplicate project" action: status, assignee and number come
+ * along so the duplicate's board matches the original. Labels are copied too.
+ */
+export async function copyIssuesToProject(
+  orgId: OrgId,
+  fromProjectId: ProjectId,
+  toProjectId: ProjectId,
+): Promise<number> {
+  const db = getDb();
+  const page = await listIssues({
+    orgId,
+    projectId: fromProjectId,
+    limit: 100,
+    cursor: null,
+  });
+
+  const stamp = toIsoTimestamp(new Date());
+  for (const issue of page.items) {
+    const id = newId();
+    db.insert(issues)
+      .values({
+        id,
+        orgId,
+        projectId: toProjectId,
+        number: issue.number,
+        title: issue.title,
+        description: issue.description,
+        status: issue.status,
+        priority: issue.priority,
+        authorId: issue.authorId,
+        assigneeId: issue.assigneeId,
+        parentId: null,
+        estimate: issue.estimate,
+        dueAt: issue.dueAt,
+        startedAt: issue.startedAt,
+        completedAt: issue.completedAt,
+        createdAt: stamp,
+        updatedAt: stamp,
+      })
+      .run();
+
+    if (issue.labelIds.length > 0) {
+      db.insert(issueLabels)
+        .values(
+          issue.labelIds.map((labelId) => ({ orgId, issueId: id, labelId })),
+        )
+        .run();
+    }
+  }
+
+  return page.items.length;
+}

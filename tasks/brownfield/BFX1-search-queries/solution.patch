@@ -0,0 +1,112 @@
+/**
+ * The search query language, shared verbatim by the dialog and the service.
+ *
+ * ADR 0007: the dialog's hint line and the server's execution must come from
+ * one parser, matching is a literal substring, and field tokens exist only
+ * for workspaces that have `advanced_search`.
+ */
+import type { ProjectId } from "@/types/common";
+
+export type SearchSubjectKind = "issue" | "comment" | "project";
+
+export const SEARCH_SUBJECT_KINDS: readonly SearchSubjectKind[] = [
+  "issue",
+  "comment",
+  "project",
+];
+
+export const DEFAULT_SEARCH_KINDS: readonly SearchSubjectKind[] = ["issue"];
+
+export interface ParsedSearchQuery {
+  /** The free-text remainder, with every recognised token removed. */
+  readonly text: string;
+  /** Kinds to search: the `kind:` tokens, or the default when there are none. */
+  readonly kinds: readonly SearchSubjectKind[];
+  /** The `kind:` / `in:` tokens exactly as given — empty when the query named none. */
+  readonly kindTokens: readonly SearchSubjectKind[];
+  readonly projectId: ProjectId | null;
+  /** Tokens that looked like syntax but named nothing we know. */
+  readonly unknownTokens: readonly string[];
+}
+
+/**
+ * @param raw      what the user typed
+ * @param advanced whether the `advanced_search` flag is on for this org; when
+ *                 false the whole string is free text, so a colon in a title
+ *                 still finds the title and nothing is ever refused.
+ */
+export function parseSearchQuery(
+  raw: string,
+  advanced: boolean,
+): ParsedSearchQuery {
+  if (!advanced) {
+    return {
+      text: raw.trim(),
+      kinds: DEFAULT_SEARCH_KINDS,
+      kindTokens: [],
+      projectId: null,
+      unknownTokens: [],
+    };
+  }
+
+  const terms: string[] = [];
+  const kinds: SearchSubjectKind[] = [];
+  const unknown: string[] = [];
+  let projectId: ProjectId | null = null;
+
+  for (const token of raw.split(/\s+/).filter((part) => part.length > 0)) {
+    const separator = token.indexOf(":");
+    if (separator <= 0) {
+      terms.push(token);
+      continue;
+    }
+
+    const field = token.slice(0, separator).toLowerCase();
+    const value = token.slice(separator + 1);
+    if (value.length === 0) {
+      unknown.push(token);
+      continue;
+    }
+
+    if (field === "kind" || field === "in") {
+      const kind = value.toLowerCase().replace(/s$/, "") as SearchSubjectKind;
+      if (SEARCH_SUBJECT_KINDS.includes(kind)) kinds.push(kind);
+      else unknown.push(token);
+    } else if (field === "project") {
+      projectId = value as ProjectId;
+    } else {
+      unknown.push(token);
+    }
+  }
+
+  return {
+    text: terms.join(" "),
+    kinds: kinds.length > 0 ? kinds : DEFAULT_SEARCH_KINDS,
+    kindTokens: kinds,
+    projectId,
+    unknownTokens: unknown,
+  };
+}
+
+/** A one-line explanation of what the parser understood, for the dialog. */
+export function describeQuery(parsed: ParsedSearchQuery): string {
+  const parts = [`searching ${parsed.kinds.join(", ")}`];
+  if (parsed.projectId !== null) parts.push(`in project ${parsed.projectId}`);
+  if (parsed.unknownTokens.length > 0) {
+    parts.push(`ignoring ${parsed.unknownTokens.join(", ")}`);
+  }
+  return parts.join(" · ");
+}
+
+/** The escape character the repository declares on its `LIKE … ESCAPE` clause. */
+export const LIKE_ESCAPE_CHAR = "\\";
+
+/**
+ * Turns free text into a `LIKE` pattern that matches it as a literal
+ * substring: `%`, `_` and the escape character itself are escaped, so a query
+ * such as `100%` finds `100%` and nothing else.
+ */
+export function likeContainsPattern(text: string): string {
+  const escaped = text.replace(/[\\%_]/g, (char) => `${LIKE_ESCAPE_CHAR}${char}`);
+  return `%${escaped}%`;
+}

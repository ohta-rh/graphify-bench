diff --git a/src/lib/issue-filters.ts b/src/lib/issue-filters.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/issue-filters.ts
@@ -0,0 +1,74 @@
+/**
+ * The issue list filter vocabulary (ADR 0009), shared by the URL codec, the
+ * filter schema, the service and the repository so the four never drift.
+ *
+ * Status groups, the `me` token for the acting user, the `none` token for
+ * "unassigned", the two forms of `due_before` and the `archived` tokens are
+ * all defined here and nowhere else.
+ */
+import type { IsoTimestamp } from "@/types/common";
+import { toIsoTimestamp } from "@/types/common";
+import {
+  ISSUE_STATUS_GROUPS,
+  type IssueStatus,
+  type IssueStatusFilterValue,
+  type IssueStatusGroup,
+} from "@/types/issue";
+
+/** `assignee=me` / `author=me`: the signed-in user, resolved by the service. */
+export const ME_TOKEN = "me";
+
+/** `assignee=none`: the sanctioned spelling of "unassigned". */
+export const UNASSIGNED_TOKEN = "none";
+
+/** `archived=1` mixes archived issues in; `archived=only` lists only them. */
+export const ARCHIVED_INCLUDE_TOKEN = "1";
+export const ARCHIVED_ONLY_TOKEN = "only";
+
+export function isStatusGroup(value: string): value is IssueStatusGroup {
+  return Object.prototype.hasOwnProperty.call(ISSUE_STATUS_GROUPS, value);
+}
+
+/**
+ * Expands `open` / `closed` into their member statuses, in first-appearance
+ * order and without duplicates. Plain statuses pass through unchanged.
+ */
+export function expandStatusFilter(
+  values: readonly IssueStatusFilterValue[],
+): readonly IssueStatus[] {
+  const seen = new Set<IssueStatus>();
+  const out: IssueStatus[] = [];
+  for (const value of values) {
+    const members = isStatusGroup(value) ? ISSUE_STATUS_GROUPS[value] : [value];
+    for (const status of members) {
+      if (seen.has(status)) continue;
+      seen.add(status);
+      out.push(status);
+    }
+  }
+  return out;
+}
+
+/** `YYYY-MM-DD`, the calendar-date form of `due_before`. */
+export const DATE_ONLY_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
+
+export function isDateOnly(value: string): boolean {
+  return DATE_ONLY_PATTERN.test(value);
+}
+
+/**
+ * The comparison `due_before` turns into (ADR 0009 §5): a calendar date is
+ * the whole UTC day, inclusive; a full timestamp is strictly before.
+ */
+export function dueBeforeBound(value: string): {
+  readonly bound: IsoTimestamp;
+  readonly inclusive: boolean;
+} {
+  if (isDateOnly(value)) {
+    return {
+      bound: toIsoTimestamp(new Date(`${value}T23:59:59.999Z`)),
+      inclusive: true,
+    };
+  }
+  return { bound: toIsoTimestamp(new Date(value)), inclusive: false };
+}

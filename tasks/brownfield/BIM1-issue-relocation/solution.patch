+/**
+ * Moves an issue into another project of the same workspace (ADR 0011).
+ *
+ * Guards, in the spirit of an edit plus a creation: tenant scope, a live
+ * issue the actor may edit, a live target project the actor may create issues
+ * in, and the target's per-project quota. The issue takes the target's next
+ * number; its old number is retired. A move within the same project changes
+ * nothing and publishes nothing. One `issue.moved` is published; nothing else.
+ */
+export async function moveIssueToProject(
+  actor: Actor,
+  input: MoveIssueToProjectInput,
+): Promise<Issue> {
+  assertOrgScope(actor, input.orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(input.orgId, input.issueId),
+    "Issue",
+    input.issueId,
+  );
+  assertCan(actor, "issue:update", issueResource(issue));
+  assertNotArchived("Issue", issue.id, issue);
+
+  const target = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.toProjectId),
+    "Project",
+    input.toProjectId,
+  );
+  assertCan(actor, "issue:create", projectResource(target));
+  assertNotArchived("Project", target.id, target);
+
+  if (issue.projectId === target.id) return issue;
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await issueRepo.countIssues(input.orgId, target.id);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${target.key}`,
+    );
+  }
+
+  const number = await issueRepo.nextIssueNumber(input.orgId, target.id);
+  const moved = await issueRepo.moveIssueToProject(
+    input.orgId,
+    issue.id,
+    target.id,
+    number,
+  );
+
+  await emit("issue.moved", {
+    ...actorEnvelope(actor),
+    issueId: moved.id,
+    fromProjectId: issue.projectId,
+    toProjectId: moved.projectId,
+    fromNumber: issue.number,
+    toNumber: moved.number,
+  });
+
+  return moved;
 }
 

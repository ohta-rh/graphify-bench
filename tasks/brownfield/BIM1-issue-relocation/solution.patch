 export async function nextIssueNumber(
   orgId: OrgId,
   projectId: ProjectId,
 ): Promise<number> {
-  const row = getDb()
+  const db = getDb();
+
+  const sequence = db
+    .select({ lastNumber: issueNumberSequences.lastNumber })
+    .from(issueNumberSequences)
+    .where(
+      and(
+        orgPredicate(issueNumberSequences.orgId, orgId),
+        eq(issueNumberSequences.projectId, projectId),
+      ),
+    )
+    .get();
+
+  const highestRow = db
     .select({ value: sql<number | null>`max(${issues.number})` })

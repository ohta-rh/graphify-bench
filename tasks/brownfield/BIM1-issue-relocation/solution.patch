+  db.insert(issueNumberSequences)
+    .values({ projectId, orgId, lastNumber: next })
+    .onConflictDoUpdate({
+      target: issueNumberSequences.projectId,
+      set: { lastNumber: next },
+    })
+    .run();
+
+  return next;
 }
 

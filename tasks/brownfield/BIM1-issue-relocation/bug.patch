+/**
+ * Re-points an issue at another project. Kept for the import tool's
+ * "merge projects" step, which renumbers in a second pass; the row keeps its
+ * number here so the pass can match it up again.
+ */
+export async function relocateIssue(
+  orgId: OrgId,
+  issueId: IssueId,
+  projectId: ProjectId,
+): Promise<Issue> {
+  const row = getDb()
+    .update(issues)
+    .set({ projectId, updatedAt: toIsoTimestamp(new Date()) })
+    .where(and(orgPredicate(issues.orgId, orgId), eq(issues.id, issueId)))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Issue ${issueId} not found`);
+  return toIssue(row);
+}
+

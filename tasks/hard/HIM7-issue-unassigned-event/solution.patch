+/** Live issues currently assigned to `userId`, oldest first. */
+export async function listLiveIssuesAssignedTo(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<readonly Issue[]> {
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          livePredicate(issues.archivedAt, {}),
+          eq(issues.assigneeId, userId),
+        ),
+      ),
+    )
+    .orderBy(issues.createdAt, issues.id)
+    .all();
+
+  return rows.map((row) => toIssue(row));
+}

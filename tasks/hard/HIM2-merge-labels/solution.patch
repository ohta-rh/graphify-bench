+/**
+ * Merges the source label into the target: every issue (archived ones
+ * included) that carried the source now carries the target exactly once, and
+ * the source label is gone. Same blast radius as a delete, so same permission.
+ */
+export async function mergeLabels(
+  actor: Actor,
+  input: MergeLabelsInput,
+): Promise<{ label: IssueLabel; issuesRelabelled: number }> {
+  const parsed = mergeLabelsSchema.parse(input);
+  assertOrgScope(actor, parsed.orgId);
+  assertCan(actor, "project:archive", orgResource(parsed.orgId));
+
+  requireFound(
+    await labelRepo.findLabelById(parsed.orgId, parsed.sourceLabelId),
+    "Label",
+    parsed.sourceLabelId,
+  );
+  const target = requireFound(
+    await labelRepo.findLabelById(parsed.orgId, parsed.targetLabelId),
+    "Label",
+    parsed.targetLabelId,
+  );
+
+  const issuesRelabelled = await labelRepo.mergeLabelInto(
+    parsed.orgId,
+    parsed.sourceLabelId,
+    parsed.targetLabelId,
+  );
+
+  return { label: target, issuesRelabelled };
+}

+export async function findLabelById(
+  orgId: OrgId,
+  labelId: LabelId,
+): Promise<IssueLabel | null> {
+  const row = getDb()
+    .select()
+    .from(labels)
+    .where(and(orgPredicate(labels.orgId, orgId), eq(labels.id, labelId)))
+    .get();
+  return row ? toLabel(row) : null;
+}
+
+/**
+ * Moves every issue carrying `sourceId` onto `targetId` (issues that already
+ * carry both keep a single target row), then removes the source label. Works
+ * on the join table directly, so archived issues are relabelled too. Returns
+ * the number of issues that carried the source label.
+ */
+export async function mergeLabelInto(
+  orgId: OrgId,
+  sourceId: LabelId,
+  targetId: LabelId,
+): Promise<number> {
+  const db = getDb();
+  return db.transaction((tx) => {
+    const carrying = tx
+      .select({ issueId: issueLabels.issueId })
+      .from(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          eq(issueLabels.labelId, sourceId),
+        ),
+      )
+      .all()
+      .map((row) => row.issueId);
+
+    if (carrying.length > 0) {
+      tx.insert(issueLabels)
+        .values(carrying.map((issueId) => ({ orgId, issueId, labelId: targetId })))
+        .onConflictDoNothing()
+        .run();
+    }
+
+    tx.delete(issueLabels)
+      .where(
+        and(
+          orgPredicate(issueLabels.orgId, orgId),
+          eq(issueLabels.labelId, sourceId),
+        ),
+      )
+      .run();
+    tx.delete(labels)
+      .where(and(orgPredicate(labels.orgId, orgId), eq(labels.id, sourceId)))
+      .run();
+
+    return carrying.length;
+  });
+}

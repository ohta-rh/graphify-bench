 /**
+ * Hands the project lead to someone else. Admins may always do it; the
+ * current lead may hand over their own project. The new lead must be a live,
+ * active member who would themselves be allowed to update the project.
+ */
+export async function changeProjectLead(
+  actor: Actor,
+  input: ChangeProjectLeadInput,
+): Promise<Project> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertCan(actor, "project:change_lead", projectResource(project));
+  assertNotArchived("Project", project.id, project);
+
+  if (input.leadId !== null) {
+    const member = await memberRepo.findMember(input.orgId, input.leadId);
+    const lead = requireFound(
+      member !== null && member.status === "active" ? member : null,
+      "Member",
+      input.leadId,
+    );
+    assertCan(
+      { userId: lead.userId, orgId: lead.orgId, role: lead.role },
+      "project:update",
+      projectResource(project),
+    );
+  }
+
+  return projectRepo.updateProject({
+    orgId: input.orgId,
+    projectId: input.projectId,
+    leadId: input.leadId,
+  });
+}
+
+/**
  * Archiving a project cascades to its issues by default — leaving live issues
  * behind an archived project is the drift this flag exists to prevent.
  */

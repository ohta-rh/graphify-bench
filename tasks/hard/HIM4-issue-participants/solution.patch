+/** The live, active memberships among `userIds` in one org. */
+export async function listActiveMembersByUserIds(
+  orgId: OrgId,
+  userIds: readonly UserId[],
+): Promise<readonly Member[]> {
+  if (userIds.length === 0) return [];
+  const rows = getDb()
+    .select()
+    .from(members)
+    .where(
+      and(
+        ...compact(
+          orgPredicate(members.orgId, orgId),
+          inArray(members.userId, [...userIds]),
+          eq(members.status, "active"),
+          liveMemberPredicate(),
+        ),
+      ),
+    )
+    .all();
+  return rows.map(toMember);
+}

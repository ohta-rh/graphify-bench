+/**
+ * Everyone who has taken part in an issue: its author, its current assignee
+ * and the authors of its live comments — limited to people who are still
+ * active members of the organization. Readable by anyone who can read the
+ * thread.
+ */
+export async function getIssueParticipants(
+  actor: Actor,
+  orgId: OrgId,
+  issueId: IssueId,
+): Promise<readonly UserId[]> {
+  assertOrgScope(actor, orgId);
+
+  const issue = requireFound(
+    await issueRepo.findIssueById(orgId, issueId),
+    "Issue",
+    issueId,
+  );
+  assertCan(actor, "comment:read", issueResource(issue));
+
+  const candidates = new Set<UserId>([issue.authorId]);
+  if (issue.assigneeId !== null) candidates.add(issue.assigneeId);
+  for (const authorId of await commentRepo.listCommentAuthorIds(orgId, issueId)) {
+    candidates.add(authorId);
+  }
+
+  const active = await memberRepo.listActiveMembersByUserIds(orgId, [
+    ...candidates,
+  ]);
+  const activeIds = new Set(active.map((member) => member.userId));
+  return [...candidates].filter((userId) => activeIds.has(userId));
+}

+/**
+ * Batched lookup by id within one org. Archived rows are included — callers
+ * decide what an archived row means for them. Ids from another org simply do
+ * not match.
+ */
+export async function findIssuesByIds(
+  orgId: OrgId,
+  issueIds: readonly IssueId[],
+): Promise<readonly Issue[]> {
+  if (issueIds.length === 0) return [];
+
+  const rows = getDb()
+    .select()
+    .from(issues)
+    .where(
+      and(orgPredicate(issues.orgId, orgId), inArray(issues.id, [...issueIds])),
+    )
+    .all();
+
+  const labels = await listLabelsForIssues(
+    orgId,
+    rows.map((row) => row.id as IssueId),
+  );
+  return rows.map((row) =>
+    toIssue(row, (labels[row.id] ?? []).map((label) => label.id)),
+  );
+}
+
+/** Archives the given live issues of one org in a single statement. */
+export async function archiveIssuesByIds(
+  orgId: OrgId,
+  issueIds: readonly IssueId[],
+): Promise<readonly Issue[]> {
+  if (issueIds.length === 0) return [];
+
+  const rows = getDb()
+    .update(issues)
+    .set(archivePatch())
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          inArray(issues.id, [...issueIds]),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    )
+    .returning()
+    .all();
+
+  return rows.map((row) => toIssue(row));
+}

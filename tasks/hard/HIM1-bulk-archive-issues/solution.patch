 /**
+ * Archives many issues at once. Ids that are unknown in the org or already
+ * archived are skipped; every remaining issue must pass the same permission
+ * check as a single archive, otherwise nothing is archived at all.
+ */
+export async function bulkArchiveIssues(
+  actor: Actor,
+  input: BulkArchiveIssuesInput,
+): Promise<{ archived: readonly IssueId[]; skipped: readonly IssueId[] }> {
+  assertOrgScope(actor, input.orgId);
+
+  const requested = [...new Set(input.issueIds)];
+  const found = await issueRepo.findIssuesByIds(input.orgId, requested);
+  const byId = new Map(found.map((issue) => [issue.id, issue]));
+
+  const toArchive: Issue[] = [];
+  const skipped: IssueId[] = [];
+  for (const id of requested) {
+    const issue = byId.get(id);
+    if (issue === undefined || isArchived(issue)) {
+      skipped.push(id);
+      continue;
+    }
+    toArchive.push(issue);
+  }
+
+  for (const issue of toArchive) {
+    assertCan(actor, "issue:archive", issueResource(issue));
+  }
+
+  await issueRepo.archiveIssuesByIds(
+    input.orgId,
+    toArchive.map((issue) => issue.id),
+  );
+
+  for (const issue of toArchive) {
+    await emit("issue.archived", {
+      ...actorEnvelope(actor),
+      issueId: issue.id,
+      projectId: issue.projectId,
+    });
+  }
+
+  return { archived: toArchive.map((issue) => issue.id), skipped };
+}

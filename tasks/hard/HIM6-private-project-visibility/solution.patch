+import type { Issue } from "@/types/issue";
 import type { Project, ProjectWithStats } from "@/types/project";
+
+/**
+ * Private-project visibility. A `private` project is seen only by admins and
+ * owners, its lead, and users explicitly added to it; to everyone else it does
+ * not exist. `org` and `public` projects are visible to the whole org.
+ */
+export async function canViewProject(
+  actor: Actor,
+  project: Project,
+): Promise<boolean> {
+  if (project.visibility !== "private") return true;
+  if (actor.isPlatformStaff === true) return true;
+  if (hasRoleAtLeast(actor.role, "admin")) return true;
+  if (project.leadId !== null && project.leadId === actor.userId) return true;
+  return projectMemberRepo.isProjectMember(
+    project.orgId,
+    project.id,
+    actor.userId,
+  );
+}
+
+/** Throws `NotFoundError` — not a 403 — for a project the actor may not see. */
+export async function assertCanViewProject(
+  actor: Actor,
+  project: Project,
+): Promise<void> {
+  if (!(await canViewProject(actor, project))) {
+    throw new NotFoundError("Project", project.id);
+  }
+}
+
+/** Resolves an issue's project and applies the same visibility rule. */
+export async function assertCanViewIssueProject(
+  actor: Actor,
+  issue: Issue,
+): Promise<void> {
+  const project = await projectRepo.findProjectById(issue.orgId, issue.projectId);
+  if (project === null || !(await canViewProject(actor, project))) {
+    throw new NotFoundError("Issue", issue.id);
+  }
+}
+
+/** Private projects the actor may not see, for listing filters. */
+export async function hiddenProjectIdsFor(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<readonly ProjectId[]> {
+  const hidden: ProjectId[] = [];
+  for (const project of await projectRepo.listPrivateProjects(orgId)) {
+    if (!(await canViewProject(actor, project))) hidden.push(project.id);
+  }
+  return hidden;
+}
 

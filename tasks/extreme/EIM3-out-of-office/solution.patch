 /**
+ * Records an out-of-office window. Members set their own; the
+ * `member:set_absence` action covers everyone else's and, through the usual
+ * ownership escalation, the member's own row.
+ */
+export async function setAbsence(
+  actor: Actor,
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  assertOrgScope(actor, input.orgId);
+
+  const member = await requireActiveMember(input.orgId, input.userId);
+  assertCan(actor, "member:set_absence", memberResource(member));
+
+  if (input.endsAt <= input.startsAt) {
+    throw new Error("An absence must end after it starts");
+  }
+
+  if (input.delegateUserId !== null) {
+    if (input.delegateUserId === input.userId) {
+      throw new Error("A member cannot be their own delegate");
+    }
+    await requireActiveMember(input.orgId, input.delegateUserId);
+  }
+
+  return absenceRepo.upsertAbsence(input);
+}
+
+export async function clearAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,
+): Promise<void> {
+  assertOrgScope(actor, orgId);
+
+  const member = await requireActiveMember(orgId, userId);
+  assertCan(actor, "member:set_absence", memberResource(member));
+
+  await absenceRepo.deleteAbsence(orgId, userId);
+}
+
+/** The member's absence while it has not ended yet; scheduled ones included. */
+export async function getAbsence(
+  actor: Actor,
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  assertOrgScope(actor, orgId);
+
+  const member = await requireActiveMember(orgId, userId);
+  assertCan(actor, "member:read", memberResource(member));
+
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  if (!absence) return null;
+  return absence.endsAt > toIsoTimestamp(new Date()) ? absence : null;
+}
+
+/**
+ * The stand-in for `userId` at instant `at`, or `null` when the member is not
+ * away then, named nobody, or the delegate is no longer an active member.
+ * Not chained: a delegate's own absence is never followed.
+ */
+export async function activeDelegateFor(
+  orgId: OrgId,
+  userId: UserId,
+  at: Date,
+): Promise<UserId | null> {
+  const absence = await absenceRepo.findAbsence(orgId, userId);
+  if (!absence || absence.delegateUserId === null) return null;
+
+  const instant = toIsoTimestamp(at);
+  if (instant < absence.startsAt || instant >= absence.endsAt) return null;
+
+  const delegate = await memberRepo.findMember(orgId, absence.delegateUserId);
+  if (!delegate || delegate.status !== "active") return null;
+
+  return absence.delegateUserId;
+}
+
+async function requireActiveMember(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<Member> {
+  const member = await memberRepo.findMember(orgId, userId);
+  if (!member || member.status !== "active") {
+    throw new NotFoundError("Member", userId);
+  }
+  return member;
+}

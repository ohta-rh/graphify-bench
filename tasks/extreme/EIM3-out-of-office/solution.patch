diff --git a/src/server/repositories/member-absence-repository.ts b/src/server/repositories/member-absence-repository.ts
new file mode 100644
--- /dev/null
+++ b/src/server/repositories/member-absence-repository.ts
@@ -0,0 +1,108 @@
+/**
+ * Out-of-office windows, one per (org, member).
+ */
+import { and, eq } from "drizzle-orm";
+import { getDb, memberAbsences } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { brandId, brandStamp } from "./_mappers";
+import type { MemberAbsenceRow } from "@/server/db/schema/members";
+import type { SetAbsenceInput } from "@/schemas/member";
+import type { OrgId, UserId } from "@/types/common";
+import type { MemberAbsence } from "@/types/member";
+
+function toAbsence(row: MemberAbsenceRow): MemberAbsence {
+  return {
+    orgId: brandId<OrgId>(row.orgId),
+    userId: brandId<UserId>(row.userId),
+    delegateUserId:
+      row.delegateUserId === null ? null : brandId<UserId>(row.delegateUserId),
+    startsAt: brandStamp(row.startsAt),
+    endsAt: brandStamp(row.endsAt),
+    note: row.note,
+  };
+}
+
+export async function findAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<MemberAbsence | null> {
+  const row = getDb()
+    .select()
+    .from(memberAbsences)
+    .where(
+      and(
+        orgPredicate(memberAbsences.orgId, orgId),
+        eq(memberAbsences.userId, userId),
+      ),
+    )
+    .get();
+  return row ? toAbsence(row) : null;
+}
+
+/** Setting an absence again replaces the previous window wholesale. */
+export async function upsertAbsence(
+  input: SetAbsenceInput,
+): Promise<MemberAbsence> {
+  const stamp = toIsoTimestamp(new Date());
+  const row = getDb()
+    .insert(memberAbsences)
+    .values({
+      orgId: input.orgId,
+      userId: input.userId,
+      delegateUserId: input.delegateUserId,
+      startsAt: input.startsAt,
+      endsAt: input.endsAt,
+      note: input.note,
+      createdAt: stamp,
+      updatedAt: stamp,
+    })
+    .onConflictDoUpdate({
+      target: [memberAbsences.orgId, memberAbsences.userId],
+      set: {
+        delegateUserId: input.delegateUserId,
+        startsAt: input.startsAt,
+        endsAt: input.endsAt,
+        note: input.note,
+        updatedAt: stamp,
+      },
+    })
+    .returning()
+    .get();
+
+  return toAbsence(row);
+}
+
+export async function deleteAbsence(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<void> {
+  getDb()
+    .delete(memberAbsences)
+    .where(
+      and(
+        orgPredicate(memberAbsences.orgId, orgId),
+        eq(memberAbsences.userId, userId),
+      ),
+    )
+    .run();
+}
+
+/** Drops `delegateUserId` wherever it names a member who has left. */
+export async function clearDelegate(
+  orgId: OrgId,
+  delegateUserId: UserId,
+): Promise<number> {
+  const rows = getDb()
+    .update(memberAbsences)
+    .set({ delegateUserId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        orgPredicate(memberAbsences.orgId, orgId),
+        eq(memberAbsences.delegateUserId, delegateUserId),
+      ),
+    )
+    .returning({ userId: memberAbsences.userId })
+    .all();
+  return rows.length;
+}

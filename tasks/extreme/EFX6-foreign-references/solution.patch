+/** True when `userId` currently holds an active, live membership in the org. */
+export async function isActiveMember(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<boolean> {
+  const row = getDb()
+    .select({ id: members.id })
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        eq(members.userId, userId),
+        eq(members.status, "active"),
+        liveMemberPredicate(),
+      ),
+    )
+    .get();
+  return row !== undefined;
+}

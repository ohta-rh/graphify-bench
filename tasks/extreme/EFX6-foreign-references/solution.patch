+/**
+ * Resolves a row that a write in `orgId` points at. Missing is `not_found`;
+ * another workspace is a scope violation, checked before anything else so a
+ * foreign row is never reported as merely missing.
+ */
+export function requireReference<T extends TenantScoped>(
+  orgId: OrgId,
+  row: T | null | undefined,
+  entity: string,
+  id: string,
+): T {
+  const found = requireFound(row, entity, id);
+  assertReferenceInOrg(orgId, found);
+  return found;
+}
+
+/** `requireReference` for soft-deletable rows: an archived one is not found. */
+export function requireLiveReference<T extends TenantScoped & SoftDeletable>(
+  orgId: OrgId,
+  row: T | null | undefined,
+  entity: string,
+  id: string,
+): T {
+  const found = requireReference(orgId, row, entity, id);
+  if (isArchived(found)) {
+    throw new NotFoundError(entity, id);
+  }
+  return found;
 }
 

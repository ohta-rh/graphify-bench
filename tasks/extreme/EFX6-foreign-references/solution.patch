+/**
+ * Reference lookup: the rows for `labelIds` whatever organization they belong
+ * to. Deliberately not tenant-scoped — the caller uses the row's `orgId` to
+ * refuse a foreign label as a scope violation rather than as "missing".
+ */
+export async function findLabelsByIds(
+  labelIds: readonly LabelId[],
+): Promise<readonly IssueLabel[]> {
+  if (labelIds.length === 0) return [];
+  const rows = getDb()
+    .select()
+    .from(labels)
+    .where(inArray(labels.id, [...labelIds]))
+    .all();
+  return rows.map(toLabel);
+}

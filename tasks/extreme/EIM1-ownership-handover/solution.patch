diff --git a/src/server/repositories/ownership-handover-repository.ts b/src/server/repositories/ownership-handover-repository.ts
new file mode 100644
--- /dev/null
+++ b/src/server/repositories/ownership-handover-repository.ts
@@ -0,0 +1,117 @@
+/**
+ * Workspace ownership handovers. At most one row per organization is
+ * `pending`; the service resolves it before it opens another.
+ */
+import { and, eq, or } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, ownershipHandovers } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { brandId, brandStamp, brandStampOrNull } from "./_mappers";
+import type { OwnershipHandoverRow } from "@/server/db/schema/organizations";
+import type { IsoTimestamp, OrgId, UserId } from "@/types/common";
+import type {
+  OwnershipHandover,
+  OwnershipHandoverStatus,
+} from "@/types/organization";
+
+function toHandover(row: OwnershipHandoverRow): OwnershipHandover {
+  return {
+    id: row.id,
+    orgId: brandId<OrgId>(row.orgId),
+    fromUserId: brandId<UserId>(row.fromUserId),
+    toUserId: brandId<UserId>(row.toUserId),
+    status: row.status,
+    expiresAt: brandStamp(row.expiresAt),
+    createdAt: brandStamp(row.createdAt),
+    resolvedAt: brandStampOrNull(row.resolvedAt),
+  };
+}
+
+export async function insertHandover(
+  orgId: OrgId,
+  fromUserId: UserId,
+  toUserId: UserId,
+  expiresAt: IsoTimestamp,
+): Promise<OwnershipHandover> {
+  const row = getDb()
+    .insert(ownershipHandovers)
+    .values({
+      id: newId(),
+      orgId,
+      fromUserId,
+      toUserId,
+      status: "pending",
+      expiresAt,
+      resolvedAt: null,
+      createdAt: toIsoTimestamp(new Date()),
+    })
+    .returning()
+    .get();
+
+  return toHandover(row);
+}
+
+/** The row still marked pending, expired or not; the service decides which. */
+export async function findPendingHandover(
+  orgId: OrgId,
+): Promise<OwnershipHandover | null> {
+  const row = getDb()
+    .select()
+    .from(ownershipHandovers)
+    .where(
+      and(
+        orgPredicate(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.status, "pending"),
+      ),
+    )
+    .get();
+  return row ? toHandover(row) : null;
+}
+
+export async function resolveHandover(
+  orgId: OrgId,
+  handoverId: string,
+  status: Exclude<OwnershipHandoverStatus, "pending">,
+  at: IsoTimestamp,
+): Promise<OwnershipHandover> {
+  const row = getDb()
+    .update(ownershipHandovers)
+    .set({ status, resolvedAt: at })
+    .where(
+      and(
+        orgPredicate(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.id, handoverId),
+      ),
+    )
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Ownership handover ${handoverId} not found`);
+  return toHandover(row);
+}
+
+/** Cancels every pending handover the user is either side of. */
+export async function cancelHandoversInvolving(
+  orgId: OrgId,
+  userId: UserId,
+  at: IsoTimestamp,
+): Promise<number> {
+  const rows = getDb()
+    .update(ownershipHandovers)
+    .set({ status: "canceled", resolvedAt: at })
+    .where(
+      and(
+        orgPredicate(ownershipHandovers.orgId, orgId),
+        eq(ownershipHandovers.status, "pending"),
+        or(
+          eq(ownershipHandovers.fromUserId, userId),
+          eq(ownershipHandovers.toUserId, userId),
+        ),
+      ),
+    )
+    .returning({ id: ownershipHandovers.id })
+    .all();
+
+  return rows.length;
+}

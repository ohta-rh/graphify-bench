+/**
+ * Offers the workspace to another member. Only the recorded owner may do
+ * this — holding the owner role is necessary but not sufficient, because the
+ * recorded owner is who the product treats as "the owner" (new-member alerts,
+ * billing contact) and that is what moves on acceptance.
+ */
+export async function initiateOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+  toUserId: UserId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:transfer", orgResource(orgId));
+  const org = await assertRecordedOwner(actor, orgId);
+
+  if (toUserId === actor.userId) throw new OwnershipHandoverError("self");
+
+  const target = await memberRepo.findMember(orgId, toUserId);
+  if (!target || target.status !== "active") {
+    throw new NotFoundError("Member", toUserId);
+  }
+
+  const now = new Date();
+  const existing = await livePendingHandover(orgId, now);
+  if (existing) throw new OwnershipHandoverError("pending_exists");
+
+  const handover = await handoverRepo.insertHandover(
+    orgId,
+    actor.userId,
+    toUserId,
+    toIsoTimestamp(new Date(now.getTime() + HANDOVER_TTL_MS)),
+  );
+
+  await notify(orgId, "ownership_handover", [toUserId], {
+    title: "You have been offered ownership of a workspace",
+    body: `${org.name} can be yours once you accept`,
+    href: "/settings/members",
+    actorId: actor.userId,
+  });
+
+  return handover;
+}
+
+/**
+ * The offered member takes the workspace. The promotion happens before the
+ * demotion: the workspace must keep an owner at every point, and the former
+ * owner steps down to admin only once the new one is in place.
+ */
+export async function acceptOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<Organization> {
+  assertOrgScope(actor, orgId);
+
+  const now = new Date();
+  const handover = await requireLivePending(orgId, now);
+  if (handover.toUserId !== actor.userId) {
+    throw new OwnershipHandoverError("nothing_pending");
+  }
+
+  const target = requireFound(
+    await memberRepo.findMember(orgId, handover.toUserId),
+    "Member",
+    handover.toUserId,
+  );
+  const previous = await memberRepo.findMember(orgId, handover.fromUserId);
+
+  if (target.role !== "owner") {
+    const promoted = await memberRepo.updateMemberRole(orgId, target.id, "owner");
+    await emit("member.role_changed", {
+      ...actorEnvelope(actor),
+      memberId: promoted.id,
+      from: target.role,
+      to: promoted.role,
+    });
+  }
+
+  const org = await orgRepo.updateOwner(orgId, handover.toUserId);
+
+  if (previous && previous.role === "owner") {
+    const demoted = await memberRepo.updateMemberRole(orgId, previous.id, "admin");
+    await emit("member.role_changed", {
+      ...actorEnvelope(actor),
+      memberId: demoted.id,
+      from: previous.role,
+      to: demoted.role,
+    });
+  }
+
+  await handoverRepo.resolveHandover(orgId, handover.id, "accepted", toIsoTimestamp(now));
+
+  await emit("organization.ownership_transferred", {
+    ...actorEnvelope(actor),
+    fromUserId: handover.fromUserId,
+    toUserId: handover.toUserId,
+  });
+
+  return org;
+}
+
+export async function declineOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+
+  const now = new Date();
+  const handover = await requireLivePending(orgId, now);
+  if (handover.toUserId !== actor.userId) {
+    throw new OwnershipHandoverError("nothing_pending");
+  }
+
+  return handoverRepo.resolveHandover(orgId, handover.id, "declined", toIsoTimestamp(now));
+}
+
+export async function cancelOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<OwnershipHandover> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:transfer", orgResource(orgId));
+  await assertRecordedOwner(actor, orgId);
+
+  const now = new Date();
+  const handover = await requireLivePending(orgId, now);
+
+  return handoverRepo.resolveHandover(orgId, handover.id, "canceled", toIsoTimestamp(now));
+}
+
+/** The open offer for this workspace, if there is one that has not expired. */
+export async function getPendingOwnershipHandover(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<OwnershipHandover | null> {
+  assertOrgScope(actor, orgId);
+  assertCan(actor, "org:read", orgResource(orgId));
+  return livePendingHandover(orgId, new Date());
+}
+
+/**
+ * Holding the owner role is necessary but not sufficient: the recorded owner
+ * is who the product treats as "the owner", and only they offer or withdraw.
+ */
+async function assertRecordedOwner(
+  actor: Actor,
+  orgId: OrgId,
+): Promise<Organization> {
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  if (org.ownerId !== actor.userId) {
+    throw new PermissionDeniedError("org:transfer", {
+      allowed: false,
+      action: "org:transfer",
+      resourceKind: "organization",
+      reason: "denied_by_role",
+    });
+  }
+  return org;
+}
+
+/**
+ * The pending row, or `null` once it has expired — an expired offer is
+ * rewritten as such on the way past, so it never blocks a new one.
+ */
+async function livePendingHandover(
+  orgId: OrgId,
+  now: Date,
+): Promise<OwnershipHandover | null> {
+  const pending = await handoverRepo.findPendingHandover(orgId);
+  if (!pending) return null;
+
+  if (pending.expiresAt <= toIsoTimestamp(now)) {
+    await handoverRepo.resolveHandover(orgId, pending.id, "expired", toIsoTimestamp(now));
+    return null;
+  }
+
+  return pending;
+}
+
+async function requireLivePending(
+  orgId: OrgId,
+  now: Date,
+): Promise<OwnershipHandover> {
+  const pending = await handoverRepo.findPendingHandover(orgId);
+  if (!pending) throw new OwnershipHandoverError("nothing_pending");
+
+  if (pending.expiresAt <= toIsoTimestamp(now)) {
+    await handoverRepo.resolveHandover(orgId, pending.id, "expired", toIsoTimestamp(now));
+    throw new OwnershipHandoverError("expired");
+  }
+
+  return pending;
+}

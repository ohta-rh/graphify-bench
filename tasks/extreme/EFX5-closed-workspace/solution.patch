+/**
+ * Fails every delivery of the org that is still pending. Used when a
+ * workspace is closed: nothing queued before the closing may still go out,
+ * and a failed row is never claimed again.
+ */
+export async function failPendingDeliveries(
+  orgId: OrgId,
+  error: string,
+): Promise<number> {
+  const rows = getDb()
+    .update(webhookDeliveries)
+    .set({
+      status: "failed",
+      lastError: error.slice(0, 500),
+      updatedAt: toIsoTimestamp(new Date()),
+    })
+    .where(
+      and(
+        orgPredicate(webhookDeliveries.orgId, orgId),
+        eq(webhookDeliveries.status, "pending"),
+      ),
+    )
+    .returning({ id: webhookDeliveries.id })
+    .all();
+
+  return rows.length;
+}

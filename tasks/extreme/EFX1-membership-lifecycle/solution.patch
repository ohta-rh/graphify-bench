+/** The membership row for a user whether or not it has been archived. */
+export async function findMemberIncludingArchived(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<Member | null> {
+  const row = getDb()
+    .select()
+    .from(members)
+    .where(and(orgPredicate(members.orgId, orgId), eq(members.userId, userId)))
+    .get();
+  return row ? toMember(row) : null;
+}
+
+/**
+ * Brings a removed member back on the same row: the invitation's role, a
+ * fresh join date and inviter, and the archive marker cleared.
+ */
+export async function reactivateMember(
+  orgId: OrgId,
+  memberId: MemberId,
+  role: Role,
+  invitedBy: UserId | null,
+): Promise<Member> {
+  const now = new Date();
+  const row = getDb()
+    .update(members)
+    .set({
+      ...restorePatch(now),
+      role,
+      status: "active",
+      invitedBy,
+      joinedAt: toIsoTimestamp(now),
+      lastSeenAt: null,
+    })
+    .where(and(orgPredicate(members.orgId, orgId), eq(members.id, memberId)))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Member ${memberId} not found in org ${orgId}`);
+  return toMember(row);
+}
+
+/** Narrows a set of user ids to those holding a live, active membership. */
+export async function filterActiveMemberUserIds(
+  orgId: OrgId,
+  userIds: readonly UserId[],
+): Promise<readonly UserId[]> {
+  if (userIds.length === 0) return [];
+
+  const rows = getDb()
+    .select({ userId: members.userId })
+    .from(members)
+    .where(
+      and(
+        orgPredicate(members.orgId, orgId),
+        inArray(members.userId, [...userIds]),
+        eq(members.status, "active"),
+        liveMemberPredicate(),
+      ),
+    )
+    .all();
+
+  const active = new Set(rows.map((row) => row.userId));
+  return userIds.filter((userId) => active.has(userId));
+}

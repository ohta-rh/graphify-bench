+/**
+ * Un-pins every session of `userId` that defaults to `orgId` — run when the
+ * user leaves that organization, so their next request lands on a workspace
+ * they still belong to. Pass `null` for `userId` to un-pin everyone's.
+ */
+export async function clearActiveOrg(
+  orgId: OrgId,
+  userId: UserId | null,
+): Promise<number> {
+  const rows = getDb()
+    .update(sessions)
+    .set({ activeOrgId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        eq(sessions.activeOrgId, orgId),
+        userId === null ? undefined : eq(sessions.userId, userId),
+      ),
+    )
+    .returning({ id: sessions.id })
+    .all();
+  return rows.length;
+}

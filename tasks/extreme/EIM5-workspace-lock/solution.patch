new file mode 100644
--- /dev/null
+++ b/src/lib/billing-lock.ts
@@ -0,0 +1,58 @@
+/**
+ * Workspace lock: the rule that turns a subscription row into "may this
+ * workspace be written to right now?".
+ *
+ * A workspace is read-only while it is not in good standing. The decision is
+ * pure and instant-based so services, route handlers and the billing page all
+ * answer the same way; `BillingService.assertWorkspaceWritable()` is the
+ * throwing form the write paths call.
+ */
+import { parseIso } from "@/lib/date";
+import type { Subscription, WorkspaceLockReason } from "@/types/billing";
+import type { OrgId } from "@/types/common";
+
+/** Thrown by a write on a locked workspace; mapped to `plan_limit_exceeded`. */
+export class WorkspaceLockedError extends Error {
+  readonly code = "plan_limit_exceeded" as const;
+
+  constructor(
+    readonly orgId: OrgId,
+    readonly reason: WorkspaceLockReason,
+  ) {
+    super(`Workspace ${orgId} is read-only (${reason})`);
+    this.name = "WorkspaceLockedError";
+  }
+}
+
+/**
+ * Why the workspace is locked at `now`, or `null` when it may be written to.
+ *
+ * - no subscription row, or an `active` one: writable
+ * - `past_due`: locked
+ * - `trialing`: locked once the trial's period end has been reached
+ * - `canceled`: locked once `cancelAt` has been reached; a cancellation
+ *   scheduled for the end of the paid period keeps the workspace writable
+ *   until then. A canceled row without a `cancelAt` counts as canceled now.
+ */
+export function lockReasonFor(
+  subscription: Subscription | null,
+  now: Date = new Date(),
+): WorkspaceLockReason | null {
+  if (subscription === null) return null;
+
+  switch (subscription.status) {
+    case "active":
+      return null;
+    case "past_due":
+      return "past_due";
+    case "trialing":
+      return parseIso(subscription.currentPeriodEnd).getTime() <= now.getTime()
+        ? "trial_ended"
+        : null;
+    case "canceled":
+      if (subscription.cancelAt === null) return "canceled";
+      return parseIso(subscription.cancelAt).getTime() <= now.getTime()
+        ? "canceled"
+        : null;
+  }
+}

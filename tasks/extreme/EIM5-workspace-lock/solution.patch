 /**
+ * The write gate every user-initiated mutation passes after its permission
+ * check. Billing itself is exempt — it is the way out of the lock — as are
+ * reads and a member's own notification housekeeping.
+ */
+export async function assertWorkspaceWritable(
+  orgId: OrgId,
+  now: Date = new Date(),
+): Promise<void> {
+  const reason = lockReasonFor(await subscriptionRepo.findSubscription(orgId), now);
+  if (reason !== null) {
+    throw new WorkspaceLockedError(orgId, reason);
+  }
+}

+/**
+ * Thrown when work is handed to a suspended member. A suspension is a
+ * temporary state, so this is a `conflict` rather than a permission problem.
+ */
+export class MemberSuspendedError extends Error {
+  readonly code = "conflict" as const;
+
+  constructor(readonly userId: UserId) {
+    super(`Member ${userId} is suspended`);
+    this.name = "MemberSuspendedError";
+  }
+}
+
+/** Input shared by suspension and reinstatement. */
+export type SuspendMemberInput = { orgId: OrgId; memberId: MemberId };
+
+/**
+ * Suspends a member: they keep their row, role and seat but cannot act, be
+ * notified, be mentioned or be assigned work until reinstated. Guarded like a
+ * removal, with the same self/rank/last-owner rules a removal implies.
+ */
+export async function suspendMember(
+  actor: Actor,
+  input: SuspendMemberInput,
+): Promise<Member> {
+  const member = await loadSuspendable(actor, input);
+  if (member.status === "suspended") return member;
+
+  if (member.role === "owner") {
+    await assertAnotherActiveOwner(input.orgId, member.id);
+  }
+
+  const suspended = await memberRepo.setMemberStatus(
+    input.orgId,
+    member.id,
+    "suspended",
+  );
+
+  await emit("member.suspended", {
+    ...actorEnvelope(actor),
+    memberId: suspended.id,
+    userId: suspended.userId,
+  });
+
+  return suspended;
+}
+
+/** Lifts a suspension. Idempotent on an already-active member. */
+export async function reinstateMember(
+  actor: Actor,
+  input: SuspendMemberInput,
+): Promise<Member> {
+  const member = await loadSuspendable(actor, input);
+  if (member.status === "active") return member;
+
+  const reinstated = await memberRepo.setMemberStatus(
+    input.orgId,
+    member.id,
+    "active",
+  );
+
+  await emit("member.reinstated", {
+    ...actorEnvelope(actor),
+    memberId: reinstated.id,
+    userId: reinstated.userId,
+  });
+
+  return reinstated;
+}
+
+/**
+ * The guards suspension and reinstatement share: tenant scope, a live (not
+ * removed) membership, the `member:remove` permission, never oneself, and
+ * never someone whose role outranks the actor's.
+ */
+async function loadSuspendable(
+  actor: Actor,
+  input: SuspendMemberInput,
+): Promise<Member> {
+  assertOrgScope(actor, input.orgId);
+
+  const found = await memberRepo.findMemberById(input.orgId, input.memberId);
+  const member = requireFound(
+    found !== null && found.archivedAt === null ? found : null,
+    "Member",
+    input.memberId,
+  );
+  assertCan(actor, "member:remove", memberResource(member));
+
+  if (member.userId === actor.userId) {
+    throw new Error("You cannot suspend or reinstate yourself");
+  }
+  if (!hasRoleAtLeast(actor.role, member.role)) {
+    throw new Error(`A ${actor.role} cannot suspend or reinstate a ${member.role}`);
+  }
+
+  return member;
+}
+
+/** Throws `MemberSuspendedError` when the user's membership is suspended. */
+export async function assertNotSuspended(

+/** Brings a deleted organization back; the row keeps everything else. */
+export async function restoreOrg(orgId: OrgId): Promise<Organization> {
+  const row = getDb()
+    .update(organizations)
+    .set(restorePatch())
+    .where(eq(organizations.id, orgId))
+    .returning()
+    .get();
+
+  if (!row) throw new Error(`Organization ${orgId} not found`);
+  return toOrganization(row);
+}
+
+/**
+ * The purge's own work list: workspaces deleted at or before `cutoff`. Kept
+ * apart from the usage-driven job list on purpose — a deleted workspace is
+ * skipped by every other job, so it must be found some other way.
+ */
+export async function listDeletedOrgsBefore(
+  cutoff: IsoTimestamp,
+): Promise<readonly Organization[]> {
+  const rows = getDb()
+    .select()
+    .from(organizations)
+    .where(
+      and(
+        isNotNull(organizations.archivedAt),
+        lte(organizations.archivedAt, cutoff),
+      ),
+    )
+    .all();
+  return rows.map(toOrganization);
+}
+
+/**
+ * Removes every trace of one workspace. Users are global and stay; a session
+ * pinned to the purged workspace merely loses its active org. Runs in one
+ * transaction so a crash cannot leave a half-purged tenant behind.
+ */
+export async function purgeOrg(orgId: OrgId): Promise<void> {
+  const db = getDb();
+  db.transaction((tx) => {
+    tx.delete(webhookDeliveries).where(eq(webhookDeliveries.orgId, orgId)).run();
+    tx.delete(webhookEndpoints).where(eq(webhookEndpoints.orgId, orgId)).run();
+    tx.delete(searchIndex).where(eq(searchIndex.orgId, orgId)).run();
+    tx.delete(rateLimitBuckets).where(eq(rateLimitBuckets.orgId, orgId)).run();
+    tx.delete(activityEvents).where(eq(activityEvents.orgId, orgId)).run();
+    tx.delete(notificationPreferences)
+      .where(eq(notificationPreferences.orgId, orgId))
+      .run();
+    tx.delete(notifications).where(eq(notifications.orgId, orgId)).run();
+    tx.delete(attachments).where(eq(attachments.orgId, orgId)).run();
+    tx.delete(comments).where(eq(comments.orgId, orgId)).run();
+    tx.delete(issueLabels).where(eq(issueLabels.orgId, orgId)).run();
+    tx.delete(labels).where(eq(labels.orgId, orgId)).run();
+    tx.delete(issues).where(eq(issues.orgId, orgId)).run();
+    tx.delete(projectMembers).where(eq(projectMembers.orgId, orgId)).run();
+    tx.delete(projects).where(eq(projects.orgId, orgId)).run();
+    tx.delete(invitations).where(eq(invitations.orgId, orgId)).run();
+    tx.delete(members).where(eq(members.orgId, orgId)).run();
+    tx.delete(invoices).where(eq(invoices.orgId, orgId)).run();
+    tx.delete(subscriptions).where(eq(subscriptions.orgId, orgId)).run();
+    tx.delete(organizationUsage).where(eq(organizationUsage.orgId, orgId)).run();
+    tx.update(sessions)
+      .set({ activeOrgId: null, updatedAt: toIsoTimestamp(new Date()) })
+      .where(eq(sessions.activeOrgId, orgId))
+      .run();
+    tx.delete(organizations).where(eq(organizations.id, orgId)).run();
+  });
+}

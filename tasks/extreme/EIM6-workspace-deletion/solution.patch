+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/** True once the restore window after `archivedAt` has closed. */
+export function isDeletionExpired(
+  org: Organization,
+  now: Date = new Date(),
+): boolean {
+  if (org.archivedAt === null) return false;
+  return (
+    parseIso(org.archivedAt).getTime() +
+      DELETED_WORKSPACE_RETENTION_DAYS * MS_PER_DAY <=
+    now.getTime()
+  );
+}
+
+/**
+ * Brings a deleted workspace back inside its restore window. No `Actor` can
+ * be resolved for a deleted workspace, so the caller is identified by user
+ * id and the decision is taken against their stored membership.
+ */
+export async function restoreOrganization(
+  userId: UserId,
+  orgId: OrgId,
+): Promise<Organization> {
+  const org = requireFound(await orgRepo.findOrgById(orgId), "Organization", orgId);
+  if (!isArchived(org)) return org;
+
+  // Past the window the workspace is gone, whether or not the purge has run.
+  if (isDeletionExpired(org)) throw new NotFoundError("Organization", orgId);
+
+  const member = requireFound(
+    await memberRepo.findMember(orgId, userId),
+    "Organization",
+    orgId,
+  );
+  const actor: Actor = { userId, orgId, role: member.role };
+  assertCan(actor, "org:restore", orgResource(orgId));
+
+  const restored = await orgRepo.restoreOrg(orgId);
+
+  await emit("organization.restored", {
+    ...actorEnvelope(actor),
+    slug: restored.slug,
+  });
+
+  return restored;
+}

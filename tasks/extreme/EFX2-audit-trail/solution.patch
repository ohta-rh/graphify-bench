 /**
+ * Walks every page of a filter, newest first. The cursor (not the timestamp)
+ * is what advances the walk, so rows that share an `occurredAt` — common, as
+ * one action fans out into several events — are neither skipped nor repeated.
+ */
+export async function listAllActivity(
+  filter: Omit<ActivityFilterInput, "limit" | "cursor">,
+): Promise<readonly ActivityEvent[]> {
+  const items: ActivityEvent[] = [];
+  let cursor: string | null = null;
+
+  do {
+    const page: Page<ActivityEvent> = await activityRepo.listActivity({
+      ...filter,
+      limit: EXPORT_PAGE_SIZE,
+      cursor,
+    });
+    items.push(...page.items);
+    cursor = page.nextCursor;
+  } while (cursor !== null);
+
+  return items;
+}

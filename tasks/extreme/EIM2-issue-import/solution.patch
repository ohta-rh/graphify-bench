+/**
+ * Bulk import: the same gates as `createIssue`, applied once to the whole
+ * batch, then one row per input row and a single `issues.imported` event.
+ * Per-issue events are deliberately not published — an upload of hundreds of
+ * rows must not fan out into hundreds of alerts and webhook deliveries — so
+ * the concerns that normally hang off `issue.created` subscribe to the batch
+ * event instead.
+ */
+export async function importIssues(
+  actor: Actor,
+  input: ImportIssuesInput,
+): Promise<IssueImportResult> {
+  assertOrgScope(actor, input.orgId);
+
+  const project = requireFound(
+    await projectRepo.findProjectById(input.orgId, input.projectId),
+    "Project",
+    input.projectId,
+  );
+  assertNotArchived("Project", project.id, project);
+  assertCan(actor, "issue:create", projectResource(project));
+
+  const previous = await importRepo.findImportByKey(input.orgId, input.importKey);
+  if (previous) {
+    const issues: Issue[] = [];
+    for (const issueId of previous.issueIds) {
+      const issue = await issueRepo.findIssueById(input.orgId, issueId);
+      if (issue) issues.push(issue);
+    }
+    return {
+      importKey: input.importKey,
+      projectId: previous.projectId,
+      issues,
+      replayed: true,
+    };
+  }
+
+  const org = requireFound(
+    await orgRepo.findOrgById(input.orgId),
+    "Organization",
+    input.orgId,
+  );
+  const used = await issueRepo.countIssues(input.orgId, input.projectId);
+  if (wouldExceedLimit(org.plan, "issuesPerProject", used, input.rows.length)) {
+    throw new Error(
+      `Plan ${org.plan} allows no more issues in project ${project.key}`,
+    );
+  }
+
+  const verdict = await consumeRateLimit(
+    input.orgId,
+    ISSUE_CREATE_BUCKET,
+    input.rows.length,
+  );
+  if (!verdict.allowed) {
+    throw new Error(
+      `Issue creation rate limit reached; try again after ${verdict.resetAt}`,
+    );
+  }
+
+  const labelIdsByName = new Map(
+    (await labelRepo.listLabels(input.orgId)).map((label) => [label.name, label.id]),
+  );
+  const assigneeByEmail = new Map<string, UserId | null>();
+
+  let number = await issueRepo.nextIssueNumber(input.orgId, input.projectId);
+  const issues: Issue[] = [];
+
+  for (const row of input.rows) {
+    const labelIds: LabelId[] = [];
+    for (const name of new Set(row.labels)) {
+      let labelId = labelIdsByName.get(name);
+      if (labelId === undefined) {
+        const created = await labelRepo.insertLabel({
+          orgId: input.orgId,
+          name,
+          color: "#94a3b8",
+          description: null,
+        });
+        labelId = created.id;
+        labelIdsByName.set(name, labelId);
+      }
+      labelIds.push(labelId);
+    }
+
+    let assigneeId: UserId | null = null;
+    if (row.assigneeEmail !== null) {
+      const email = row.assigneeEmail.toLowerCase();
+      if (!assigneeByEmail.has(email)) {
+        assigneeByEmail.set(email, await resolveActiveMemberByEmail(input.orgId, email));
+      }
+      assigneeId = assigneeByEmail.get(email) ?? null;
+    }
+
+    const issue = await issueRepo.insertIssue(
+      {
+        orgId: input.orgId,
+        projectId: input.projectId,
+        title: row.title,
+        description: row.description,
+        status: row.status,
+        priority: row.priority,
+        assigneeId,
+        parentId: null,
+        estimate: null,
+        dueAt: row.dueAt,
+        labelIds,
+      },
+      actor.userId,
+      number,
+    );
+    number += 1;
+    issues.push(issue);
+  }
+
+  await importRepo.insertImport(
+    input.orgId,
+    input.projectId,
+    input.importKey,
+    issues.map((issue) => issue.id),
+  );
+
+  await emit("issues.imported", {
+    ...actorEnvelope(actor),
+    projectId: input.projectId,
+    importKey: input.importKey,
+    issueIds: issues.map((issue) => issue.id),
+  });
+
+  return { importKey: input.importKey, projectId: input.projectId, issues, replayed: false };
+}
+
+/** The user id behind an email address, if it is a current active member. */
+async function resolveActiveMemberByEmail(
+  orgId: OrgId,
+  email: string,
+): Promise<UserId | null> {
+  const user = await userRepo.findUserByEmail(email);
+  if (!user) return null;
+  const member = await memberRepo.findMember(orgId, user.id);
+  if (!member || member.status !== "active") return null;
+  return user.id;
+}

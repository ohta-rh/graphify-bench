+/**
+ * The bulk-import ledger: one row per (org, import key), so a replayed upload
+ * can be answered from what the first run created.
+ */
+import { and, eq } from "drizzle-orm";
+import { newId } from "@/lib/id";
+import { getDb, issueImports } from "@/server/db";
+import { toIsoTimestamp } from "@/types/common";
+import { orgPredicate } from "./base-repository";
+import { brandId, brandStamp, parseJsonArray } from "./_mappers";
+import type { IssueImportRow } from "@/server/db/schema/issues";
+import type { IsoTimestamp, IssueId, OrgId, ProjectId } from "@/types/common";
+
+export interface IssueImportRecord {
+  readonly id: string;
+  readonly orgId: OrgId;
+  readonly projectId: ProjectId;
+  readonly importKey: string;
+  readonly issueIds: readonly IssueId[];
+  readonly createdAt: IsoTimestamp;
+}
+
+function toRecord(row: IssueImportRow): IssueImportRecord {
+  return {
+    id: row.id,
+    orgId: brandId<OrgId>(row.orgId),
+    projectId: brandId<ProjectId>(row.projectId),
+    importKey: row.importKey,
+    issueIds: parseJsonArray<IssueId>(row.issueIds),
+    createdAt: brandStamp(row.createdAt),
+  };
+}
+
+export async function findImportByKey(
+  orgId: OrgId,
+  importKey: string,
+): Promise<IssueImportRecord | null> {
+  const row = getDb()
+    .select()
+    .from(issueImports)
+    .where(
+      and(
+        orgPredicate(issueImports.orgId, orgId),
+        eq(issueImports.importKey, importKey),
+      ),
+    )
+    .get();
+  return row ? toRecord(row) : null;
+}
+
+export async function insertImport(
+  orgId: OrgId,
+  projectId: ProjectId,
+  importKey: string,
+  issueIds: readonly IssueId[],
+): Promise<IssueImportRecord> {
+  const row = getDb()
+    .insert(issueImports)
+    .values({
+      id: newId(),
+      orgId,
+      projectId,
+      importKey,
+      issueIds: JSON.stringify(issueIds),
+      createdAt: toIsoTimestamp(new Date()),
+    })
+    .returning()
+    .get();
+  return toRecord(row);
+}

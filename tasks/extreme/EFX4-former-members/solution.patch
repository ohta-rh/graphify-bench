+/**
+ * The one definition of "is this person currently a member": the row is live
+ * and its status is `active`. A removed membership fails both halves; every
+ * check that asks "may this person be notified / assigned / act" goes through
+ * here rather than reading one column.
+ */
+export function isActiveMembership(
+  member: Pick<Member, "status" | "archivedAt">,
+): boolean {
+  return member.status === "active" && member.archivedAt === null;
+}

+/**
+ * Cascade behind `MemberService.removeMember`: live issues assigned to the
+ * person who left become unassigned. Returns the row count.
+ */
+export async function unassignIssuesForUser(
+  orgId: OrgId,
+  userId: UserId,
+): Promise<number> {
+  const rows = getDb()
+    .update(issues)
+    .set({ assigneeId: null, updatedAt: toIsoTimestamp(new Date()) })
+    .where(
+      and(
+        ...compact(
+          orgPredicate(issues.orgId, orgId),
+          eq(issues.assigneeId, userId),
+          livePredicate(issues.archivedAt, {}),
+        ),
+      ),
+    )
+    .returning({ id: issues.id })
+    .all();
+
+  return rows.length;
+}
